<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.Core</RootNamespace>
    <Title>CrestApps Core Hosting Abstractions</Title>
    <Description>
      $(CrestAppsDescription)

      The host seams the Contact Center Suite depends on: distributed locking, tenant identity,
      scoped execution, after-commit work, and a user directory. A host implements these; the
      suite never reaches for a specific web framework.
    </Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
