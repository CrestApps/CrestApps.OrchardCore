<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.Core</RootNamespace>
    <Title>CrestApps Core Hosting Abstractions</Title>
    <Description>
      $(CrestAppsDescription)

      The host seams the Contact Center Suite depends on: distributed locking, tenant identity,
      scoped execution, after-commit work, and a user directory. A host implements these; the
      suite never reaches for a specific web framework.
    </Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The seams in this project are the ones CrestApps.Core.Abstractions does not already have, and the
      property bag here is serialized with that package's extensible-entity settings rather than with a
      second set of its own. This project folds into CrestApps.Core.Abstractions in Phase 2, so the
      reference is the shape it ends up in.
    -->
    <PackageReference Include="CrestApps.Core.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Compliance.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
