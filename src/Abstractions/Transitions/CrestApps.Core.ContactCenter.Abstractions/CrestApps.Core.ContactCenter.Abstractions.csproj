<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.Core.ContactCenter</RootNamespace>
    <Title>CrestApps Core Contact Center Abstractions</Title>
    <Description>
      $(CrestAppsDescription)

      The Contact Center contracts that do not depend on a host. Currently the authorization
      operations a Contact Center service asks about, which a host maps to whatever it calls a
      permission.
    </Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="CrestApps.Core.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The contact centre orchestrates work recorded against a customer record, so its work-state and
      report models are typed in terms of the omnichannel activity. That is the layer boundary the plan
      draws, not a leak: CRM owns the work item, the contact centre owns what happens to it.
    -->
    <ProjectReference Include="..\CrestApps.Core.Omnichannel.Abstractions\CrestApps.Core.Omnichannel.Abstractions.csproj" />
    <ProjectReference Include="..\CrestApps.Core.Telephony.Abstractions\CrestApps.Core.Telephony.Abstractions.csproj" />
  </ItemGroup>

</Project>
