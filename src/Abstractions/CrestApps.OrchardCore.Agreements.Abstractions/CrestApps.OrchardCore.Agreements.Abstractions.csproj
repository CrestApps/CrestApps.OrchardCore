<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.OrchardCore.Agreements</RootNamespace>
    <Title>CrestApps OrchardCore Agreements Abstractions</Title>
    <Description>
      $(CrestAppsDescription)

      Public contracts for agreements with an account: the agreement record with its dates, status and covered hours
      (a block of hours or an allowance each month, with rounding), the usage providers other modules register to
      count the time spent under an agreement, the balance of its hours, and the observers told when an agreement is
      about to end or passes a share of its hours.
    </Description>
    <PackageTags>$(PackageTags) Agreements Contracts SupportAgreements Abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CrestApps.Core.Abstractions" />
    <PackageReference Include="OrchardCore.Abstractions" />
    <PackageReference Include="OrchardCore.Infrastructure.Abstractions" />
  </ItemGroup>

</Project>
