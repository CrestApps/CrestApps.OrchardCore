<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.OrchardCore.ContentFields</RootNamespace>
    <Title>CrestApps OrchardCore Content Fields Abstractions</Title>
    <Description>
      $(CrestAppsDescription)

      The content fields of the CrestApps Content Fields module (PhoneField, AddressField) and their settings, so other
      projects can read and write them without referencing the module.
    </Description>
    <PackageTags>$(PackageTags) OrchardCoreCMS Content Fields Abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OrchardCore.ContentManagement.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../CrestApps.OrchardCore.Addresses.Abstractions/CrestApps.OrchardCore.Addresses.Abstractions.csproj" />
  </ItemGroup>

</Project>
