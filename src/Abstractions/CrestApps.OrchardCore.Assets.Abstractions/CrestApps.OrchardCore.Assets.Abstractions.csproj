<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.OrchardCore.Assets</RootNamespace>
    <Title>CrestApps OrchardCore Assets Abstractions</Title>
    <Description>
      $(CrestAppsDescription)

      Public contracts for assets: types with attributes and meters, assets owned by the business or its customers,
      their hierarchy, warranty, meter readings, and fleet data for vehicles and equipment.
    </Description>
    <PackageTags>$(PackageTags) Assets Equipment Fleet Abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CrestApps.Core.Abstractions" />
    <PackageReference Include="OrchardCore.Abstractions" />
    <PackageReference Include="OrchardCore.Infrastructure.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CrestApps.OrchardCore.Addresses.Abstractions\CrestApps.OrchardCore.Addresses.Abstractions.csproj" />
  </ItemGroup>

</Project>
