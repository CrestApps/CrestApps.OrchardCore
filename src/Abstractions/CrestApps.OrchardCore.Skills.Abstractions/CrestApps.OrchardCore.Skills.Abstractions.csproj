<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.OrchardCore.Skills</RootNamespace>
    <Title>CrestApps OrchardCore Skills Abstractions</Title>
    <Description>
      $(CrestAppsDescription)

      Public contracts for the shared skill catalog: skills, the proficiency a person holds them at, certifications
      and the certification records that prove them, with expiry.
    </Description>
    <PackageTags>$(PackageTags) Skills Certifications Workforce Abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CrestApps.Core.Abstractions" />
    <PackageReference Include="OrchardCore.Abstractions" />
    <PackageReference Include="OrchardCore.Infrastructure.Abstractions" />
  </ItemGroup>

</Project>
