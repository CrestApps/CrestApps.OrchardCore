<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.OrchardCore.Dispatch</RootNamespace>
    <Title>CrestApps OrchardCore Dispatch Abstractions</Title>
    <Description>
      $(CrestAppsDescription)

      Public contracts for dispatch: service visits and their statuses, dispatch settings and objective weights,
      candidates for a visit, and the dispatch service, candidate finder and visit observer seams.
    </Description>
    <PackageTags>$(PackageTags) Dispatch FieldService Abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CrestApps.Core.Abstractions" />
    <PackageReference Include="OrchardCore.Abstractions" />
    <PackageReference Include="OrchardCore.Infrastructure.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CrestApps.OrchardCore.Staff.Abstractions\CrestApps.OrchardCore.Staff.Abstractions.csproj" />
    <ProjectReference Include="..\CrestApps.OrchardCore.Geo.Abstractions\CrestApps.OrchardCore.Geo.Abstractions.csproj" />
    <ProjectReference Include="..\CrestApps.OrchardCore.WorkOrders.Abstractions\CrestApps.OrchardCore.WorkOrders.Abstractions.csproj" />
  </ItemGroup>

</Project>
