<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.OrchardCore.Staff</RootNamespace>
    <Title>CrestApps OrchardCore Staff Abstractions</Title>
    <Description>
      $(CrestAppsDescription)

      Public contracts for the people who work for the business: the staff member record (with or without a user
      account), employment details, the reporting line, dated team memberships, capabilities other modules register,
      the staff directory, the hierarchy, badges and pay rates.
    </Description>
    <PackageTags>$(PackageTags) Staff Employees HR Abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CrestApps.Core.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="OrchardCore.Abstractions" />
    <PackageReference Include="OrchardCore.Infrastructure.Abstractions" />
  </ItemGroup>

</Project>
