<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.OrchardCore.Learning.Assessments</RootNamespace>
    <Title>CrestApps OrchardCore Learning Assessments Abstractions</Title>
    <Description>
      $(CrestAppsDescription)

      Public contracts of Learning assessments: the quiz course item part, which names the Surveys survey the quiz owns and
      how attempts combine into the quiz grade, grade scales, the grading list extension point and the permissions.
    </Description>
    <PackageTags>$(PackageTags) Learning LMS Assessments Quiz Exam Abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CrestApps.Core.Abstractions" />
    <PackageReference Include="OrchardCore.Abstractions" />
    <PackageReference Include="OrchardCore.ContentManagement.Abstractions" />
    <PackageReference Include="OrchardCore.Infrastructure.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CrestApps.OrchardCore.Abstractions\CrestApps.OrchardCore.Abstractions.csproj" />
    <ProjectReference Include="..\CrestApps.OrchardCore.Learning.Abstractions\CrestApps.OrchardCore.Learning.Abstractions.csproj" />
  </ItemGroup>

</Project>
