<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>$(MSBuildProjectName.Replace(" ", "_").Replace(".Abstractions",""))</RootNamespace>
    <Title>CrestApps OrchardCore Checkout Abstractions</Title>
    <Description>
      $(OCCMSDescription)

      Abstractions project for the provider-agnostic checkout and payment framework.
    </Description>
    <PackageTags>$(PackageTags) CrestApps OrchardCoreCMS Checkout Payments Abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OrchardCore.ContentManagement.Abstractions" />
    <PackageReference Include="OrchardCore.DisplayManagement" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CrestApps.OrchardCore.Payments.Abstractions\CrestApps.OrchardCore.Payments.Abstractions.csproj" />
    <ProjectReference Include="..\CrestApps.OrchardCore.Taxation.Abstractions\CrestApps.OrchardCore.Taxation.Abstractions.csproj" />
  </ItemGroup>

</Project>
