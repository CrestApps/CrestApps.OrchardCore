<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.OrchardCore.Attachments</RootNamespace>
    <Title>CrestApps OrchardCore Attachments Abstractions</Title>
    <Description>
      $(CrestAppsDescription)

      Public contracts for record attachments: the file formats recognized by their own bytes, the attachment record,
      the attachment service and its upload policy, scanners, and the access providers that say who may read and attach
      the files of a record.
    </Description>
    <PackageTags>$(PackageTags) Attachments Files Uploads Abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CrestApps.Core.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CrestApps.OrchardCore.Abstractions\CrestApps.OrchardCore.Abstractions.csproj" />
    <ProjectReference Include="..\CrestApps.OrchardCore.Parties.Abstractions\CrestApps.OrchardCore.Parties.Abstractions.csproj" />
  </ItemGroup>

</Project>
