<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.OrchardCore.TimeTracker</RootNamespace>
    <Title>CrestApps OrchardCore Time Tracker Abstractions</Title>
    <Description>
      $(CrestAppsDescription)

      Public contracts for time tracking: stages, the categories their time is totalled by, time entries, and the time
      tracker service and observer seams.
    </Description>
    <PackageTags>$(PackageTags) TimeTracker Timesheets Abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CrestApps.Core.Abstractions" />
    <PackageReference Include="OrchardCore.Abstractions" />
    <PackageReference Include="OrchardCore.Infrastructure.Abstractions" />
  </ItemGroup>

</Project>
