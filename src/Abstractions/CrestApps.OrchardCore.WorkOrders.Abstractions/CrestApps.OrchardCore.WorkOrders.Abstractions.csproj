<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.OrchardCore.WorkOrders</RootNamespace>
    <Title>CrestApps OrchardCore Work Orders Abstractions</Title>
    <Description>
      $(CrestAppsDescription)

      Public contracts for work orders: types, the work order and its lines, checklists, service level policies and
      sub-statuses, and the seams for service hours, parts and billing.
    </Description>
    <PackageTags>$(PackageTags) WorkOrders FieldService Abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CrestApps.Core.Abstractions" />
    <PackageReference Include="OrchardCore.Abstractions" />
    <PackageReference Include="OrchardCore.Infrastructure.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CrestApps.OrchardCore.Addresses.Abstractions\CrestApps.OrchardCore.Addresses.Abstractions.csproj" />
  </ItemGroup>

</Project>
