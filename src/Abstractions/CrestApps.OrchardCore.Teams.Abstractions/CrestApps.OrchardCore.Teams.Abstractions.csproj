<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.OrchardCore.Teams</RootNamespace>
    <Title>CrestApps OrchardCore Teams Abstractions</Title>
    <Description>
      $(CrestAppsDescription)

      Public contracts for the shared team hierarchy: teams that nest into regions, sites, departments and crews, the
      team manager, and the checks other modules add before a team is deleted.
    </Description>
    <PackageTags>$(PackageTags) Teams Organization Abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CrestApps.Core.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="OrchardCore.Abstractions" />
    <PackageReference Include="OrchardCore.Infrastructure.Abstractions" />
  </ItemGroup>

</Project>
