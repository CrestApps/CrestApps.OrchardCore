<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.OrchardCore.Learning.Xapi</RootNamespace>
    <Title>CrestApps OrchardCore Learning Xapi Abstractions</Title>
    <Description>
      $(CrestAppsDescription)

      Public contracts of the Learning Record Store: the xAPI 1.0.3 statement record and documents, the credential an
      LRS request was made with, the LRS permissions, and the filter and observer extension points other modules (cmi5)
      use to check statements and react to them.
    </Description>
    <PackageTags>$(PackageTags) Learning LMS xAPI LRS Abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CrestApps.Core.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Localization.Abstractions" />
    <PackageReference Include="OrchardCore.Infrastructure.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CrestApps.OrchardCore.Learning.Abstractions\CrestApps.OrchardCore.Learning.Abstractions.csproj" />
  </ItemGroup>

</Project>
