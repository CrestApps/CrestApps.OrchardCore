<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.OrchardCore.AgenticCommerce</RootNamespace>
    <Title>CrestApps OrchardCore Agentic Commerce Abstractions</Title>
    <Description>
      $(CrestAppsDescription)

      Contracts for selling through AI agents: the protocol-neutral agent checkout, the payment handlers an agent pays
      through, and the feature IDs of the Universal Commerce Protocol (UCP), Agentic Commerce Protocol (ACP) and Agent
      Payments Protocol (AP2) features.
    </Description>
    <PackageTags>$(PackageTags) Commerce AgenticCommerce UCP ACP AP2 Abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OrchardCore.Infrastructure.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CrestApps.OrchardCore.Addresses.Abstractions\CrestApps.OrchardCore.Addresses.Abstractions.csproj" />
    <ProjectReference Include="..\CrestApps.OrchardCore.Checkout.Abstractions\CrestApps.OrchardCore.Checkout.Abstractions.csproj" />
  </ItemGroup>

</Project>
