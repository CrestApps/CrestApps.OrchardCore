<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.OrchardCore.Calendars</RootNamespace>
    <Title>CrestApps OrchardCore Calendars Abstractions</Title>
    <Description>
      $(CrestAppsDescription)

      Public contracts for the shared calendar: calendars, events, attendees, recurrence, calendar type
      descriptors, and the services and extension points other modules use to add calendar types, own
      events, contribute busy time and react to calendar changes.
    </Description>
    <PackageTags>$(PackageTags) Calendars Calendar Scheduling Abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CrestApps.Core.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="OrchardCore.Abstractions" />
    <PackageReference Include="OrchardCore.Infrastructure.Abstractions" />
  </ItemGroup>

</Project>
