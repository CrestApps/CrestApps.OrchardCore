<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.OrchardCore.MailingLists</RootNamespace>
    <Title>CrestApps OrchardCore Mailing Lists Abstractions</Title>
    <Description>
      $(CrestAppsDescription)

      Contracts for mailing lists: lists and members, newsletter sign-up with optional e-mail verification, member life
      cycle observers, and the provider seam that keeps a list at an outside e-mail marketing service.
    </Description>
    <PackageTags>$(PackageTags) MailingLists Newsletter Subscribers DoubleOptIn Abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CrestApps.Core.Abstractions" />
    <PackageReference Include="OrchardCore.Abstractions" />
    <PackageReference Include="OrchardCore.Infrastructure.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CrestApps.OrchardCore.Abstractions\CrestApps.OrchardCore.Abstractions.csproj" />
    <ProjectReference Include="..\CrestApps.OrchardCore.Addresses.Abstractions\CrestApps.OrchardCore.Addresses.Abstractions.csproj" />
  </ItemGroup>

</Project>
