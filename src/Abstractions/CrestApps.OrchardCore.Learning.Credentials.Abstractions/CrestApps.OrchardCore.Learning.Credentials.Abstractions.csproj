<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.OrchardCore.Learning.Credentials</RootNamespace>
    <Title>CrestApps OrchardCore Learning Credentials Abstractions</Title>
    <Description>
      $(CrestAppsDescription)

      Public contracts of Digital Credentials (Open Badges 3.0 on the W3C Verifiable Credentials Data Model 2.0): the
      credential definition part, the credential award record with the achievement copied into it, the award rule kinds,
      the award service and observer, the Digital Credentials permissions and constants.
    </Description>
    <PackageTags>$(PackageTags) Learning LMS OpenBadges VerifiableCredentials Abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CrestApps.Core.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Localization.Abstractions" />
    <PackageReference Include="OrchardCore.ContentManagement.Abstractions" />
    <PackageReference Include="OrchardCore.Infrastructure.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CrestApps.OrchardCore.Learning.Abstractions\CrestApps.OrchardCore.Learning.Abstractions.csproj" />
  </ItemGroup>

</Project>
