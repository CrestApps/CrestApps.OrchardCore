<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.OrchardCore.Omnichannel.Messaging</RootNamespace>
    <Title>CrestApps OrchardCore Omnichannel Messaging Abstractions</Title>
    <Description>
      $(CrestAppsDescription)

      Channel-agnostic abstractions and shared vocabulary for the CrestApps OrchardCore Omnichannel Messaging
      workspace: conversation, routing, and delivery enumerations, the provider dispatch result, and the
      real-time messaging notification contracts.
    </Description>
    <PackageTags>$(PackageTags) Omnichannel Messaging Abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OrchardCore.Infrastructure.Abstractions" />
  </ItemGroup>

</Project>
