<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.OrchardCore.BusinessDocuments</RootNamespace>
    <Title>CrestApps OrchardCore Business Documents Abstractions</Title>
    <Description>
      $(CrestAppsDescription)

      Contracts for printable business documents such as receipts, payment requests, invoices, estimates and credit
      notes: one neutral document model, document templates, the HTML and PDF renderers, and the registration of the
      document kinds other modules print.
    </Description>
    <PackageTags>$(PackageTags) BusinessDocuments Documents Invoices Receipts PDF Abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CrestApps.Core.Abstractions" />
    <PackageReference Include="OrchardCore.Abstractions" />
    <PackageReference Include="OrchardCore.Infrastructure.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CrestApps.OrchardCore.Abstractions\CrestApps.OrchardCore.Abstractions.csproj" />
  </ItemGroup>

</Project>
