<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.OrchardCore.Timeline</RootNamespace>
    <Title>CrestApps OrchardCore Timeline Abstractions</Title>
    <Description>
      $(CrestAppsDescription)

      Public contracts for the timeline: comments, internal notes and events on any record, with their author, their
      visibility, the field changes they record and their attachments; the timeline service, entry handlers and the
      access providers that say who may read and write the timeline of a record.
    </Description>
    <PackageTags>$(PackageTags) Timeline Comments Notes History Abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CrestApps.Core.Abstractions" />
    <PackageReference Include="OrchardCore.Abstractions" />
    <PackageReference Include="OrchardCore.Infrastructure.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CrestApps.OrchardCore.Abstractions\CrestApps.OrchardCore.Abstractions.csproj" />
    <ProjectReference Include="..\CrestApps.OrchardCore.Parties.Abstractions\CrestApps.OrchardCore.Parties.Abstractions.csproj" />
  </ItemGroup>

</Project>
