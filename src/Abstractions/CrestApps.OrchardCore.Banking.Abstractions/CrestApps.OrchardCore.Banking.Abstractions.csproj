<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.OrchardCore.Banking</RootNamespace>
    <Title>CrestApps OrchardCore Banking Abstractions</Title>
    <Description>
      $(CrestAppsDescription)

      Public contracts for bank accounts: one record for the business's own accounts and for the accounts of the people
      and organizations it pays, with the account number protected at rest, routing number checks per country,
      verification providers and observers of changes.
    </Description>
    <PackageTags>$(PackageTags) Banking BankAccounts ACH Abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CrestApps.Core.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="OrchardCore.Abstractions" />
    <PackageReference Include="OrchardCore.Infrastructure.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CrestApps.OrchardCore.Abstractions\CrestApps.OrchardCore.Abstractions.csproj" />
    <ProjectReference Include="..\CrestApps.OrchardCore.Parties.Abstractions\CrestApps.OrchardCore.Parties.Abstractions.csproj" />
  </ItemGroup>

</Project>
