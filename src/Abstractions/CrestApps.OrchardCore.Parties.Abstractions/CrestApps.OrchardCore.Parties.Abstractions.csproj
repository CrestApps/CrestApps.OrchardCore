<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.OrchardCore.Parties</RootNamespace>
    <Title>CrestApps OrchardCore Parties Abstractions</Title>
    <Description>
      $(CrestAppsDescription)

      Public contracts for parties, the people and organizations a record belongs to: a party reference of an open
      kind (user, customer, account, contact, guest) and an id, the party sources that find and name parties of a kind,
      and the directory that reads them all.
    </Description>
    <PackageTags>$(PackageTags) Parties Owners Customers Accounts Abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
