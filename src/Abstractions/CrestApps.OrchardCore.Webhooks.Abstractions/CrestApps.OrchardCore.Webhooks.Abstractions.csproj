<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.OrchardCore.Webhooks</RootNamespace>
    <Title>CrestApps OrchardCore Webhooks Abstractions</Title>
    <Description>
      $(CrestAppsDescription)

      Public contracts for webhooks, both ways: the durable provider webhook inbox that inbound provider callbacks
      are accepted into, with its handler contract, ingress limiter and signature validators, and the outbound
      side, where modules declare the events they publish, publish them, and sign them.
    </Description>
    <PackageTags>$(PackageTags) Webhooks Inbox Outbox Abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="OrchardCore.Infrastructure.Abstractions" />
  </ItemGroup>

</Project>
