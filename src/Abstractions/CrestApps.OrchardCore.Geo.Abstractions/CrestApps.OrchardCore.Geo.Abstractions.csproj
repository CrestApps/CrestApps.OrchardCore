<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.OrchardCore.Geo</RootNamespace>
    <Title>CrestApps OrchardCore Geo Abstractions</Title>
    <Description>
      $(CrestAppsDescription)

      Public contracts for geography: points, geocoding, travel times and routes with pluggable providers, service
      territories, and geocoding addresses in the background.
    </Description>
    <PackageTags>$(PackageTags) Geo Maps Geocoding Territories Abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CrestApps.Core.Abstractions" />
    <PackageReference Include="OrchardCore.Abstractions" />
    <PackageReference Include="OrchardCore.Infrastructure.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CrestApps.OrchardCore.Addresses.Abstractions\CrestApps.OrchardCore.Addresses.Abstractions.csproj" />
  </ItemGroup>

</Project>
