<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.OrchardCore.Fulfillment</RootNamespace>
    <Title>CrestApps OrchardCore Fulfillment Abstractions</Title>
    <Description>
      $(CrestAppsDescription)

      Public contracts for fulfillment partners: the outside companies that make and ship a store's products, each
      connected through a pluggable provider.
    </Description>
    <PackageTags>$(PackageTags) Commerce Fulfillment PrintOnDemand Abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OrchardCore.Abstractions" />
    <PackageReference Include="OrchardCore.Infrastructure.Abstractions" />
  </ItemGroup>

</Project>
