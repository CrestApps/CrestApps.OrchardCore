<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.OrchardCore.Learning.Surveys</RootNamespace>
    <Title>CrestApps OrchardCore Learning Surveys Abstractions</Title>
    <Description>
      $(CrestAppsDescription)

      Public contracts of Learning surveys: the survey course item (a feedback survey or a choice) with its questions,
      a learner's response, the totals staff see, and the response service.
    </Description>
    <PackageTags>$(PackageTags) Learning LMS Surveys Feedback Choice Polls Abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CrestApps.Core.Abstractions" />
    <PackageReference Include="OrchardCore.ContentManagement.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CrestApps.OrchardCore.Learning.Abstractions\CrestApps.OrchardCore.Learning.Abstractions.csproj" />
  </ItemGroup>

</Project>
