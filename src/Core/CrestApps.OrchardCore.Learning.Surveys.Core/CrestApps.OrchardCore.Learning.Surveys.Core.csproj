<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.OrchardCore.Learning.Surveys.Core</RootNamespace>
    <Title>CrestApps OrchardCore Learning Surveys Core</Title>
    <Description>
      $(CrestAppsDescription)

      Core services of Learning surveys: the survey a feedback survey or choice owns, created on the item's first save,
      and the item's result recorded when the learner answers.
    </Description>
    <PackageTags>$(PackageTags) Learning LMS Surveys Feedback Choice Polls Core</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrestApps.OrchardCore.Learning.Surveys" />
    <InternalsVisibleTo Include="CrestApps.OrchardCore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OrchardCore.Abstractions" />
    <PackageReference Include="OrchardCore.ContentManagement" />
    <PackageReference Include="OrchardCore.Infrastructure.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Abstractions\CrestApps.OrchardCore.Learning.Surveys.Abstractions\CrestApps.OrchardCore.Learning.Surveys.Abstractions.csproj" />
    <ProjectReference Include="..\CrestApps.OrchardCore.Learning.Core\CrestApps.OrchardCore.Learning.Core.csproj" />
    <ProjectReference Include="..\CrestApps.OrchardCore.Surveys.Core\CrestApps.OrchardCore.Surveys.Core.csproj" />
  </ItemGroup>

</Project>
