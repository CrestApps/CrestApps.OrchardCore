<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.OrchardCore.Pdf</RootNamespace>
    <Title>CrestApps OrchardCore PDF Core</Title>
    <Description>
      $(CrestAppsDescription)

      Writes PDF files with PdfPig (Apache-2.0): the renderer of the PDF layout model, the drawing canvas, TrueType fonts
      found on the host and embedded as subsets, text cleaning and wrapping, JPEG and PNG images, and vector QR codes
      drawn with QRCoder (MIT).
    </Description>
    <PackageTags>$(PackageTags) PDF PdfPig QRCode Core</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrestApps.OrchardCore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="PdfPig" />
    <PackageReference Include="QRCoder" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Abstractions\CrestApps.OrchardCore.Pdf.Abstractions\CrestApps.OrchardCore.Pdf.Abstractions.csproj" />
  </ItemGroup>

</Project>
