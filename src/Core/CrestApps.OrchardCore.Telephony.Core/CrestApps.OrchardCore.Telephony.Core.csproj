<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>CrestApps OrchardCore Telephony Core</Title>
    <Description>
      $(CrestAppsDescription)

      Provider-neutral voice ingress mechanics shared by every telephony consumer: canonical provider
      identity, ingestion keying, normalized-event ordering, and the normalized-event handler contract.
      This project deliberately references no Contact Center assembly so telephony can ingest provider
      events while Contact Center features are disabled.
    </Description>
    <PackageTags>$(PackageTags) Telephony Voice</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="OrchardCore.Infrastructure.Abstractions" />
    <PackageReference Include="YesSql.Abstractions" />
    <PackageReference Include="CrestApps.Core.Data.YesSql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Abstractions/CrestApps.OrchardCore.Abstractions/CrestApps.OrchardCore.Abstractions.csproj" />
    <ProjectReference Include="../../Abstractions/CrestApps.OrchardCore.Telephony.Abstractions/CrestApps.OrchardCore.Telephony.Abstractions.csproj" />
    <ProjectReference Include="../CrestApps.OrchardCore.YesSql.Core/CrestApps.OrchardCore.YesSql.Core.csproj" />
  </ItemGroup>

</Project>
