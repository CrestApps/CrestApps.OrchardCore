<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.OrchardCore.Fulfillment.Core</RootNamespace>
    <Title>CrestApps OrchardCore Fulfillment Core</Title>
    <Description>
      $(CrestAppsDescription)

      Core services for fulfillment partners: describing a paid order for a partner, a record of each order sent to
      each partner, and sending it once, with a person asked whenever the outcome is unclear.
    </Description>
    <PackageTags>$(PackageTags) Commerce Fulfillment PrintOnDemand Core</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrestApps.OrchardCore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OrchardCore.Abstractions" />
    <PackageReference Include="OrchardCore.Infrastructure.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Abstractions\CrestApps.OrchardCore.Fulfillment.Abstractions\CrestApps.OrchardCore.Fulfillment.Abstractions.csproj" />
    <ProjectReference Include="..\CrestApps.OrchardCore.Core\CrestApps.OrchardCore.Core.csproj" />
    <ProjectReference Include="..\CrestApps.OrchardCore.Orders.Core\CrestApps.OrchardCore.Orders.Core.csproj" />
    <ProjectReference Include="..\CrestApps.OrchardCore.YesSql.Core\CrestApps.OrchardCore.YesSql.Core.csproj" />
  </ItemGroup>

</Project>
