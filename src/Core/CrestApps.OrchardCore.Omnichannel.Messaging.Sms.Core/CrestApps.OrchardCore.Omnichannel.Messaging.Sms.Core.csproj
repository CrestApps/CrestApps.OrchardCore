<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.OrchardCore.Omnichannel.Messaging.Sms</RootNamespace>
    <Title>CrestApps OrchardCore Omnichannel Messaging SMS Core</Title>
    <Description>
      $(CrestAppsDescription)

      The SMS channel of the CrestApps OrchardCore Omnichannel Messaging workspace: the SMS messaging channel,
      the per-number provider dispatcher and its provider contract, the inbound SMS receiver, and the carrier
      keyword policy.
    </Description>
    <PackageTags>$(PackageTags) Omnichannel Messaging SMS</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrestApps.OrchardCore.Tests" />
    <InternalsVisibleTo Include="CrestApps.OrchardCore.Omnichannel.Messaging.Sms" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="OrchardCore.Infrastructure.Abstractions" />
    <PackageReference Include="OrchardCore.Sms.Abstractions" />
    <PackageReference Include="OrchardCore.Sms.Core" />
    <PackageReference Include="OrchardCore.Flows.Core" />
    <PackageReference Include="YesSql.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Abstractions/CrestApps.OrchardCore.Omnichannel.Messaging.Abstractions/CrestApps.OrchardCore.Omnichannel.Messaging.Abstractions.csproj" />
    <ProjectReference Include="../CrestApps.OrchardCore.Omnichannel.Messaging.Core/CrestApps.OrchardCore.Omnichannel.Messaging.Core.csproj" />
    <ProjectReference Include="../CrestApps.OrchardCore.Omnichannel.Core/CrestApps.OrchardCore.Omnichannel.Core.csproj" />
    <ProjectReference Include="../CrestApps.OrchardCore.ContactCenter.Core/CrestApps.OrchardCore.ContactCenter.Core.csproj" />
  </ItemGroup>

</Project>
