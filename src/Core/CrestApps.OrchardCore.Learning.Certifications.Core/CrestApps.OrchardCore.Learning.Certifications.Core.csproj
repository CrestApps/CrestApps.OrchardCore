<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.OrchardCore.Learning.Certifications.Core</RootNamespace>
    <Title>CrestApps OrchardCore Learning Certifications Core</Title>
    <Description>
      $(CrestAppsDescription)

      Core services of Learning certification paths: path and progress stores, the course and assessment requirements,
      issuing and renewing Skills certificates idempotently, the renewal window queue and the upkeep that catches up on
      lost events.
    </Description>
    <PackageTags>$(PackageTags) Learning LMS Certification Core</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrestApps.OrchardCore.Learning.Certifications" />
    <InternalsVisibleTo Include="CrestApps.OrchardCore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OrchardCore.Abstractions" />
    <PackageReference Include="OrchardCore.ContentManagement" />
    <PackageReference Include="OrchardCore.Data.Abstractions" />
    <PackageReference Include="OrchardCore.Infrastructure.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Abstractions\CrestApps.OrchardCore.Learning.Certifications.Abstractions\CrestApps.OrchardCore.Learning.Certifications.Abstractions.csproj" />
    <ProjectReference Include="..\..\Abstractions\CrestApps.OrchardCore.Skills.Abstractions\CrestApps.OrchardCore.Skills.Abstractions.csproj" />
    <ProjectReference Include="..\..\Abstractions\CrestApps.OrchardCore.Staff.Abstractions\CrestApps.OrchardCore.Staff.Abstractions.csproj" />
    <ProjectReference Include="..\CrestApps.OrchardCore.Learning.Assessments.Core\CrestApps.OrchardCore.Learning.Assessments.Core.csproj" />
    <ProjectReference Include="..\CrestApps.OrchardCore.Learning.Core\CrestApps.OrchardCore.Learning.Core.csproj" />
    <ProjectReference Include="..\CrestApps.OrchardCore.YesSql.Core\CrestApps.OrchardCore.YesSql.Core.csproj" />
  </ItemGroup>

</Project>
