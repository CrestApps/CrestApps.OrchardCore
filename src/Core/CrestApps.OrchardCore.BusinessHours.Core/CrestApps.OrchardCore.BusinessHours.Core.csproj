<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
    <Title>CrestApps OrchardCore Business Hours Core</Title>
    <Description>
      $(CrestAppsDescription)

      Core services for business hours: the open-hours service that answers from the registered schedule sources, the
      store and rules of the schedules the Business Hours module keeps, the editor helpers for weekly hours and date
      exceptions, and their registration helpers.
    </Description>
    <PackageTags>$(PackageTags) BusinessHours Hours Holidays Schedule Core</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrestApps.OrchardCore.Tests" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Abstractions\CrestApps.OrchardCore.BusinessHours.Abstractions\CrestApps.OrchardCore.BusinessHours.Abstractions.csproj" />
    <ProjectReference Include="..\CrestApps.OrchardCore.Core\CrestApps.OrchardCore.Core.csproj" />
  </ItemGroup>

</Project>
