<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.OrchardCore.Commerce.Core</RootNamespace>
    <Title>CrestApps OrchardCore Commerce Core</Title>
    <Description>
      $(CrestAppsDescription)

      Services every commerce module shares: the store's e-mail sender, which renders each kind of e-mail through the
      store's own Liquid template and layout, and the store profile and locations.
    </Description>
    <PackageTags>$(PackageTags) Commerce Emails Store</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrestApps.OrchardCore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OrchardCore.Email.Abstractions" />
    <PackageReference Include="OrchardCore.Infrastructure.Abstractions" />
    <PackageReference Include="OrchardCore.Liquid.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Abstractions\CrestApps.OrchardCore.Commerce.Abstractions\CrestApps.OrchardCore.Commerce.Abstractions.csproj" />
    <ProjectReference Include="..\CrestApps.OrchardCore.Core\CrestApps.OrchardCore.Core.csproj" />
  </ItemGroup>

</Project>
