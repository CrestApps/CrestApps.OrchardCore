<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
    <Title>CrestApps OrchardCore Invoicing Core</Title>
    <Description>
      $(OCCMSDescription)

      Core services for the CrestApps OrchardCore Invoicing module: the document calculator, the life cycle rules of
      invoices and credit notes, and the stores and managers of the documents.
    </Description>
    <PackageTags>$(PackageTags) CrestApps OrchardCoreCMS Invoicing Billing Commerce Core</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OrchardCore.Infrastructure.Abstractions" />
    <PackageReference Include="YesSql.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Abstractions\CrestApps.OrchardCore.Abstractions\CrestApps.OrchardCore.Abstractions.csproj" />
    <ProjectReference Include="..\..\Abstractions\CrestApps.OrchardCore.Invoicing.Abstractions\CrestApps.OrchardCore.Invoicing.Abstractions.csproj" />
    <ProjectReference Include="..\..\Abstractions\CrestApps.OrchardCore.Transactions.Abstractions\CrestApps.OrchardCore.Transactions.Abstractions.csproj" />
    <ProjectReference Include="..\CrestApps.OrchardCore.Core\CrestApps.OrchardCore.Core.csproj" />
    <ProjectReference Include="..\CrestApps.OrchardCore.YesSql.Core\CrestApps.OrchardCore.YesSql.Core.csproj" />
  </ItemGroup>

</Project>
