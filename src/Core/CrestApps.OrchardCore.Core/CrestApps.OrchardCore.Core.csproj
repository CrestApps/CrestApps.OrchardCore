<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>CrestApps OrchardCore Core</Title>
    <Description>
      $(CrestAppsDescription)

      OrchardCore-specific core services that extend the framework-independent CrestApps.Core.
    </Description>
    <PackageTags>$(PackageTags)</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrestApps.OrchardCore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Written inline at the foot of every page by AddInvariantNumberInputs(); see ModelBinding. -->
    <EmbeddedResource Include="Assets\js\invariant-number-inputs.js" LogicalName="CrestApps.OrchardCore.Core.invariant-number-inputs.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Abstractions/CrestApps.OrchardCore.Abstractions/CrestApps.OrchardCore.Abstractions.csproj" />
    <PackageReference Include="CrestApps.Core" />
    <PackageReference Include="OrchardCore.Admin.Abstractions" />
    <PackageReference Include="OrchardCore.Deployment.Abstractions" />
    <PackageReference Include="OrchardCore.DisplayManagement" />
    <PackageReference Include="OrchardCore.Email.Abstractions" />
    <PackageReference Include="OrchardCore.FileStorage.Abstractions" />
    <PackageReference Include="OrchardCore.Liquid.Abstractions" />
    <PackageReference Include="OrchardCore.Navigation.Core" />
    <PackageReference Include="OrchardCore.Recipes.Abstractions" />
    <PackageReference Include="OrchardCore.Roles.Abstractions" />
  </ItemGroup>

</Project>
