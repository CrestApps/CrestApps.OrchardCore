<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.OrchardCore.NLWeb</RootNamespace>
    <Title>CrestApps OrchardCore NLWeb Core</Title>
    <Description>
      $(CrestAppsDescription)

      The NLWeb protocol without a host: the ask request and response models, the readers of the protocol versions,
      the JSON and server-sent event response builders, and the ask pipeline with its extension points (query
      processors, retrievers, result resolvers, rankers and response generators).
    </Description>
    <PackageTags>$(PackageTags) NLWeb SchemaOrg Search AI Agents</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrestApps.OrchardCore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
