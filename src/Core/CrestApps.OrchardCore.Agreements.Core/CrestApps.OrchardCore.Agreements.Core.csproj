<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CrestApps.OrchardCore.Agreements.Core</RootNamespace>
    <Title>CrestApps OrchardCore Agreements Core</Title>
    <Description>
      $(CrestAppsDescription)

      Core services for agreements with accounts: the YesSql store and index, the numbering and the rules of an
      agreement, the balance of its covered hours from every usage provider with its rounding, and the life cycle that
      expires agreements past their end and tells observers when one is about to end or passes 80% and 100% of its
      hours.
    </Description>
    <PackageTags>$(PackageTags) Agreements Contracts SupportAgreements Core</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrestApps.OrchardCore.Tests" />
    <InternalsVisibleTo Include="CrestApps.OrchardCore.Agreements" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NodaTime" />
    <PackageReference Include="OrchardCore.Abstractions" />
    <PackageReference Include="OrchardCore.Infrastructure.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Abstractions\CrestApps.OrchardCore.Agreements.Abstractions\CrestApps.OrchardCore.Agreements.Abstractions.csproj" />
    <ProjectReference Include="..\CrestApps.OrchardCore.Core\CrestApps.OrchardCore.Core.csproj" />
    <ProjectReference Include="..\CrestApps.OrchardCore.YesSql.Core\CrestApps.OrchardCore.YesSql.Core.csproj" />
  </ItemGroup>

</Project>
