@using CrestApps.OrchardCore.AdminTheme
@using CrestApps.OrchardCore.AdminTheme.Services

@inject AdminColorSchemeService ColorSchemes

@*
    TheAdmin's light / dark toggle, with the color schemes of the theme under it. The mode buttons keep TheAdmin's
    markup (#bd-theme, .theme-icon-active, data-bs-theme-value), which its theme manager script drives. The scheme
    buttons are driven by color-scheme.js, which stores the choice in the cookie the layouts read. 'Site default'
    clears that cookie, so the user follows the scheme picked in Settings → Admin again.
*@

@{
    var userScheme = await ColorSchemes.GetUserSchemeAsync();
    var siteScheme = await ColorSchemes.GetSiteSchemeAsync();
    var schemes = await ColorSchemes.ListAsync();
}

<script asp-name="crestapps-admin-theme-scheme" at="Foot"></script>

<li class="nav-item">
    <div class="dropdown">
        <button class="btn btn-link nav-link dropdown-toggle" id="bd-theme" type="button" aria-expanded="false" data-bs-toggle="dropdown" data-bs-display="static" aria-label="@T["Toggle theme"]">
            <span class="theme-icon-active"><i class="fa-solid fa-circle-half-stroke"></i></span>
            <span class="d-none" id="bd-theme-text">@T["Toggle theme"]</span>
        </button>
        <div class="dropdown-menu dropdown-menu-end position-absolute ca-theme-menu">
            <h6 class="dropdown-header">@T["Mode"]</h6>
            <button type="button" class="dropdown-item" data-bs-theme-value="auto" aria-pressed="false">
                <span class="theme-icon">
                    <i class="fa-solid fa-circle-half-stroke"></i>
                </span>
                <span class="ps-2">@T["Auto"]</span>
            </button>
            <button type="button" class="dropdown-item active" data-bs-theme-value="light" aria-pressed="true">
                <span class="theme-icon">
                    <i class="fa-solid fa-sun"></i>
                </span>
                <span class="ps-2">@T["Light"]</span>
            </button>
            <button type="button" class="dropdown-item" data-bs-theme-value="dark" aria-pressed="false">
                <span class="theme-icon">
                    <i class="fa-solid fa-moon"></i>
                </span>
                <span class="ps-2">@T["Dark"]</span>
            </button>
            @await RenderSectionAsync("ToggleThemeItems", required: false)

            <div class="dropdown-divider"></div>
            <h6 class="dropdown-header">@T["Color scheme"]</h6>
            <div class="ca-scheme-list" role="group" aria-label="@T["Color scheme"]" data-cookie-name="@ColorSchemes.CookieName" data-site-scheme="@siteScheme">
                <button type="button" class="dropdown-item ca-scheme-option@(userScheme is null ? " active" : string.Empty)" data-ca-scheme-value="" aria-pressed="@(userScheme is null ? "true" : "false")">
                    <span class="ca-scheme-name">@T["Site default"]</span>
                    <span class="ca-scheme-swatch" data-scheme="@siteScheme" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
                </button>
                @foreach (var scheme in schemes)
                {
                    var isPicked = scheme.Id == userScheme;
                    <button type="button" class="dropdown-item ca-scheme-option@(isPicked ? " active" : string.Empty)" data-ca-scheme-value="@scheme.Id" aria-pressed="@(isPicked ? "true" : "false")">
                        <span class="ca-scheme-name">@scheme.Name</span>
                        <span class="ca-scheme-swatch" data-scheme="@scheme.Id" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
                    </button>
                }
            </div>
        </div>
    </div>
</li>
