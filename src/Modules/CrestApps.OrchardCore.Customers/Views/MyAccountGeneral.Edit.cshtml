@model MyAccountViewModel

<div class="ocat-wrapper" asp-validation-class-for="Kind">
    <label asp-for="Kind" class="ocat-label">@T["I buy for"]</label>
    <div class="ocat-end">
        <select asp-for="Kind" asp-items="Model.Kinds" class="form-select" data-customer-kind></select>
    </div>
</div>
<div class="ocat-wrapper">
    <label class="ocat-label" for="account-email">@T["Email"]</label>
    <div class="ocat-end">
        <input id="account-email" value="@Model.Email" class="form-control" readonly />
        <span class="hint">@T["The email of your account, where your orders and receipts are sent."]</span>
    </div>
</div>
<div class="ocat-wrapper" asp-validation-class-for="FirstName">
    <label asp-for="FirstName" class="ocat-label">@T["First name"]</label>
    <div class="ocat-end">
        <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
    </div>
</div>
<div class="ocat-wrapper" asp-validation-class-for="LastName">
    <label asp-for="LastName" class="ocat-label">@T["Last name"]</label>
    <div class="ocat-end">
        <input asp-for="LastName" class="form-control" autocomplete="family-name" />
    </div>
</div>
<div class="ocat-wrapper" asp-validation-class-for="DisplayName">
    <label asp-for="DisplayName" class="ocat-label">@T["Name we call you by"]</label>
    <div class="ocat-end">
        <input asp-for="DisplayName" class="form-control" autocomplete="nickname" />
        <span class="hint">@T["Optional. Your name is used when it is empty."]</span>
    </div>
</div>
<div class="ocat-wrapper" asp-validation-class-for="Phone">
    <label asp-for="Phone" class="ocat-label">@T["Phone"]</label>
    <div class="ocat-end">
        <input asp-for="Phone" type="tel" class="form-control" autocomplete="tel" />
    </div>
</div>

<script at="Foot">
    // Company and tax id are for businesses.
    (function () {
        var kind = document.querySelector('[data-customer-kind]');

        if (!kind) {
            return;
        }

        function sync() {
            document.querySelectorAll('[data-customer-business]').forEach(function (field) {
                field.hidden = kind.value !== 'Business';
            });
        }

        kind.addEventListener('change', sync);
        sync();
    })();
</script>
