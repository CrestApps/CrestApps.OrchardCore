@using CrestApps.OrchardCore.Customers.Models
@model ReferralSettingsViewModel

<p class="text-muted">@T["Each signed-in customer has a referral link on their account. A friend who opens it can get a discount on their first order, and the customer is rewarded when that order is placed."]</p>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="FriendCouponId" class="form-label">@T["What a friend gets"]</label>
        <select asp-for="FriendCouponId" asp-items="Model.Coupons" class="form-select">
            <option value="">@T["Nothing"]</option>
        </select>
        <span class="hint">@T["A friend gets a single-use code of this coupon, taken off at checkout. Tick Only the generated codes work on the coupon so its own code isn't shared."]</span>
    </div>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="RewardKind" class="form-label">@T["What the customer gets"]</label>
        <select asp-for="RewardKind" class="form-select">
            <option value="@ReferralRewardKind.None">@T["Nothing"]</option>
            <option value="@ReferralRewardKind.StoreCredit">@T["Store credit"]</option>
            <option value="@ReferralRewardKind.Points">@T["Loyalty points"]</option>
        </select>
        <span class="hint">@T["Store credit and points need the Store Credit or Loyalty Points feature."]</span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="RewardAmount" class="form-label">@T["Store credit"]</label>
        <input asp-for="RewardAmount" type="number" step="0.01" min="0" class="form-control" />
        <span asp-validation-for="RewardAmount"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="RewardPoints" class="form-label">@T["Points"]</label>
        <input asp-for="RewardPoints" type="number" min="0" class="form-control" />
        <span asp-validation-for="RewardPoints"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="MinimumOrderAmount" class="form-label">@T["Least a friend's first order spends"]</label>
        <input asp-for="MinimumOrderAmount" type="number" step="0.01" min="0" class="form-control" />
        <span asp-validation-for="MinimumOrderAmount"></span>
        <span class="hint">@T["On goods, after discounts. 0 rewards any first order."]</span>
    </div>
</div>

<p class="text-muted small">@T["A customer is rewarded once per friend, only for the friend's first order, never for their own, and the reward is taken back if that order is canceled."]</p>
