@model CustomerContactStepViewModel

<div class="customer-contact-step">
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label asp-for="Name" class="form-label ocat-label-required">@T["Full name"]</label>
            <input asp-for="Name" class="form-control" autocomplete="name" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Email" class="form-label ocat-label-required">@T["Email"]</label>
            <input asp-for="Email" type="email" class="form-control" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
            @if (!Model.IsSignedIn)
            {
                <div class="form-text">@T["We send the order's details here."]</div>
            }
        </div>
        <div class="col-md-6">
            <label asp-for="Phone" class="form-label">@T["Phone (optional)"]</label>
            <input asp-for="Phone" type="tel" class="form-control" autocomplete="tel" />
        </div>
    </div>

    @if (Model.Requirement != BillingAddressRequirement.Off)
    {
        <h5 class="mt-4">
            @T["Billing address"]
            @if (Model.Requirement == BillingAddressRequirement.Optional)
            {
                <small class="text-muted fw-normal">@T["(optional)"]</small>
            }
        </h5>

        @if (Model.Requirement == BillingAddressRequirement.Optional)
        {
            <p class="form-text mt-n2">@T["Leave it blank, or fill in the starred fields."]</p>
        }

        @if (Model.SavedAddresses.Count > 0)
        {
            <div class="mb-3" data-address-choice>
                @foreach (var address in Model.SavedAddresses)
                {
                    <div class="form-check">
                        <input type="radio" class="form-check-input" asp-for="BillingAddressId" value="@address.AddressId" id="@Html.IdFor(m => m.BillingAddressId)_@address.AddressId" />
                        <label class="form-check-label" for="@Html.IdFor(m => m.BillingAddressId)_@address.AddressId">
                            @if (!string.IsNullOrEmpty(address.Label))
                            {
                                <strong>@address.Label</strong>
                                <span>—</span>
                            }
                            @string.Join(", ", address.Lines)
                        </label>
                    </div>
                }
                <div class="form-check">
                    <input type="radio" class="form-check-input" asp-for="BillingAddressId" value="" id="@Html.IdFor(m => m.BillingAddressId)_New" />
                    <label class="form-check-label" for="@Html.IdFor(m => m.BillingAddressId)_New">@T["A new address, entered below"]</label>
                </div>
            </div>
        }

        <fieldset data-new-address>
            @await DisplayAsync(Model.BillingAddressEditor)

            @if (Model.CanSaveAddress)
            {
                <div class="form-check mb-3">
                    <input asp-for="SaveBillingAddress" type="checkbox" class="form-check-input" />
                    <label asp-for="SaveBillingAddress" class="form-check-label">@T["Save a new address to my address book"]</label>
                </div>
            }
        </fieldset>
    }
</div>

@* With saved addresses to pick from, the new address form shows only when "A new address" is chosen. Without script
   it stays in view, and the server reads it only for a new address. *@
<script at="Foot">
    (function () {
        if (window.crestAppsAddressChoice) {
            return;
        }

        window.crestAppsAddressChoice = true;

        document.querySelectorAll('[data-address-choice]').forEach(function (choice) {
            var form = choice.parentElement.querySelector('[data-new-address]');

            if (!form) {
                return;
            }

            function sync() {
                var checked = choice.querySelector('input[type=radio]:checked');
                var isNew = !checked || checked.value === '';

                form.hidden = !isNew;
                form.disabled = !isNew;
            }

            choice.addEventListener('change', sync);
            sync();
        });
    })();
</script>
