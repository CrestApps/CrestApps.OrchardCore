@model MyAccountViewModel

@* The signed-in customer's details on the storefront account, as a form that posts back to the page. *@

<form asp-route="AccountDetails" method="post" class="card">
    <div class="card-body">
        <partial name="_CustomerProfileFields" model="Model" />
    </div>
    <div class="card-footer d-flex flex-wrap align-items-center justify-content-between gap-2">
        <button type="submit" class="btn btn-primary px-4">@T["Save"]</button>
        <a href="@Url.Action("ChangePassword", "Account", new { area = "OrchardCore.Users" })">@T["Change your password"]</a>
    </div>
</form>
