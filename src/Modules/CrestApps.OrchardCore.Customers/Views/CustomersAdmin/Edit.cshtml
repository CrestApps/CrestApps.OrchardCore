@model CustomerEditViewModel

@{
    var readOnly = !Model.CanManage || Model.Status == CustomerStatus.Anonymized;
    var hasAccount = !string.IsNullOrEmpty(Model.UserId);
}

<zone Name="Title">
    <breadcrumb name="@(Model.IsNew ? "CustomersCreate" : "CustomersEdit")" title="@(Model.IsNew ? T["Add customer"] : T["Customer"])">
        <breadcrumb-item id="CustomersIndex" action="Index" controller="CustomersAdmin" area="CrestApps.OrchardCore.Customers" permission="@CustomerPermissions.ViewCustomers.Name">@T["Customers"]</breadcrumb-item>
    </breadcrumb>
</zone>

@if (Model.Status == CustomerStatus.Anonymized)
{
    <div class="alert alert-secondary">@T["This customer's personal data was erased. Their orders stay, without it."]</div>
}

<form asp-action="@(Model.IsNew ? "Create" : "Edit")" asp-route-customerId="@Model.CustomerId" method="post" class="no-multisubmit">
    <div asp-validation-summary="ModelOnly"></div>

    <fieldset disabled="@readOnly">
        <div class="row g-3">
            <div class="col-md-6" asp-validation-class-for="Kind">
                <label asp-for="Kind" class="form-label">@T["Kind"]</label>
                <select asp-for="Kind" asp-items="Model.Kinds" class="form-select" data-customer-kind></select>
            </div>
            @if (!Model.IsNew && Model.Status != CustomerStatus.Anonymized)
            {
                <div class="col-md-6" asp-validation-class-for="Status">
                    <label asp-for="Status" class="form-label">@T["Status"]</label>
                    <select asp-for="Status" asp-items="Model.Statuses" class="form-select"></select>
                    <span class="hint">@T["A disabled customer keeps their orders and history."]</span>
                    <span asp-validation-for="Status"></span>
                </div>
            }

            <div class="col-md-6" asp-validation-class-for="FirstName">
                <label asp-for="FirstName" class="form-label">@T["First name"]</label>
                <input asp-for="FirstName" class="form-control" autocomplete="off" />
            </div>
            <div class="col-md-6" asp-validation-class-for="LastName">
                <label asp-for="LastName" class="form-label">@T["Last name"]</label>
                <input asp-for="LastName" class="form-control" autocomplete="off" />
            </div>
            <div class="col-md-6" asp-validation-class-for="DisplayName">
                <label asp-for="DisplayName" class="form-label">@T["Display name"]</label>
                <input asp-for="DisplayName" class="form-control" autocomplete="off" />
                <span class="hint">@T["How the store addresses the customer. Leave it empty to use their name or company."]</span>
            </div>

            <div class="col-md-6" data-customer-business asp-validation-class-for="CompanyName">
                <label asp-for="CompanyName" class="form-label">@T["Company"]</label>
                <input asp-for="CompanyName" class="form-control" autocomplete="off" />
                <span asp-validation-for="CompanyName"></span>
            </div>
            <div class="col-md-6" data-customer-business asp-validation-class-for="TaxId">
                <label asp-for="TaxId" class="form-label">@T["Tax id"]</label>
                <input asp-for="TaxId" class="form-control" autocomplete="off" />
                <span class="hint">@T["Such as a VAT number. It is shown on invoices."]</span>
            </div>

            <div class="col-md-6" asp-validation-class-for="Email">
                <label asp-for="Email" class="form-label">@T["Email"]</label>
                @if (hasAccount)
                {
                    <input asp-for="Email" class="form-control" readonly />
                    <span class="hint">@T["The account's email. It is changed on the account."]</span>
                }
                else
                {
                    <input asp-for="Email" type="email" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Email"></span>
                }
            </div>
            <div class="col-md-6" asp-validation-class-for="Phone">
                <label asp-for="Phone" class="form-label">@T["Phone"]</label>
                <input asp-for="Phone" type="tel" class="form-control" autocomplete="off" />
            </div>

            <div class="col-12">
                <div class="form-check">
                    <input asp-for="AcceptsMarketing" type="checkbox" class="form-check-input" />
                    <label asp-for="AcceptsMarketing" class="form-check-label">@T["Accepts marketing"]</label>
                    <span class="hint dashed">@T["The customer agreed to news and offers. Order and payment messages are always sent."]</span>
                </div>
            </div>
        </div>
    </fieldset>

    @if (!Model.IsNew)
    {
        <dl class="row mt-4 mb-0">
            <dt class="col-sm-3">@T["Account"]</dt>
            <dd class="col-sm-9">
                @if (hasAccount)
                {
                    <a href="@Url.Action("Edit", "Admin", new { area = "OrchardCore.Users", id = Model.UserId })">@(Model.UserName ?? Model.UserId)</a>
                }
                else
                {
                    @T["None (a guest)"]
                }
            </dd>
            <dt class="col-sm-3">@T["Customer since"]</dt>
            <dd class="col-sm-9">@Model.CreatedUtc?.ToString("g")</dd>
            <dt class="col-sm-3">@T["Last activity"]</dt>
            <dd class="col-sm-9">@Model.LastActivityUtc?.ToString("g")</dd>
        </dl>
    }

    @if (!readOnly)
    {
        <div class="mt-4">
            <button type="submit" class="btn btn-primary save">@T["Save"]</button>
            <a class="btn btn-secondary" asp-action="Index">@T["Cancel"]</a>
        </div>
    }
</form>

<script at="Foot">
    // Company and tax id are for businesses.
    (function () {
        var kind = document.querySelector('[data-customer-kind]');

        if (!kind) {
            return;
        }

        function sync() {
            document.querySelectorAll('[data-customer-business]').forEach(function (field) {
                field.hidden = kind.value !== 'Business';
            });
        }

        kind.addEventListener('change', sync);
        sync();
    })();
</script>
