@model CustomerEditViewModel
@inject OrchardCore.Modules.ILocalClock LocalClock
@functions {
    // Stored times are UTC; people read them in the site's time zone.
    private async Task<DateTime> LocalAsync(DateTime utc)
        => (await LocalClock.ConvertToLocalAsync(DateTime.SpecifyKind(utc, DateTimeKind.Utc))).DateTime;
}

@{
    var readOnly = !Model.CanManage || Model.Status is CustomerStatus.Anonymized or CustomerStatus.Merged;
    var hasAccount = !string.IsNullOrEmpty(Model.UserId);
}

<zone Name="Title">
    <breadcrumb name="@(Model.IsNew ? "CustomersCreate" : "CustomersEdit")" title="@(Model.IsNew ? T["Add customer"] : T["Customer"])">
        <breadcrumb-item id="CustomersIndex" action="Index" controller="CustomersAdmin" area="CrestApps.OrchardCore.Customers" permission="@CustomerPermissions.ViewCustomers.Name">@T["Customers"]</breadcrumb-item>
    </breadcrumb>
</zone>

@if (Model.Status == CustomerStatus.Anonymized)
{
    <div class="alert alert-secondary">@T["This customer's personal data was erased. Their orders stay, without it."]</div>
}

<form asp-action="@(Model.IsNew ? "Create" : "Edit")" asp-route-customerId="@Model.CustomerId" method="post" class="no-multisubmit">
    <div asp-validation-summary="ModelOnly"></div>

    <fieldset disabled="@readOnly">
        <div class="ocat-wrapper" asp-validation-class-for="Kind">
            <label asp-for="Kind" class="ocat-label">@T["Kind"]</label>
            <div class="ocat-end">
                <select asp-for="Kind" asp-items="Model.Kinds" class="form-select" data-customer-kind></select>
            </div>
        </div>
        @if (!Model.IsNew && Model.Status != CustomerStatus.Anonymized)
        {
            <div class="ocat-wrapper" asp-validation-class-for="Status">
                <label asp-for="Status" class="ocat-label">@T["Status"]</label>
                <div class="ocat-end">
                    <select asp-for="Status" asp-items="Model.Statuses" class="form-select"></select>
                    <span class="hint">@T["A disabled customer keeps their orders and history."]</span>
                    <span asp-validation-for="Status"></span>
                </div>
            </div>
        }

        <div class="ocat-wrapper" asp-validation-class-for="FirstName">
            <label asp-for="FirstName" class="ocat-label">@T["First name"]</label>
            <div class="ocat-end">
                <input asp-for="FirstName" class="form-control" autocomplete="off" />
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="LastName">
            <label asp-for="LastName" class="ocat-label">@T["Last name"]</label>
            <div class="ocat-end">
                <input asp-for="LastName" class="form-control" autocomplete="off" />
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="DisplayName">
            <label asp-for="DisplayName" class="ocat-label">@T["Display name"]</label>
            <div class="ocat-end">
                <input asp-for="DisplayName" class="form-control" autocomplete="off" />
                <span class="hint">@T["How the store addresses the customer. Leave it empty to use their name or company."]</span>
            </div>
        </div>

        <div class="ocat-wrapper" data-customer-business asp-validation-class-for="CompanyName">
            <label asp-for="CompanyName" class="ocat-label">@T["Company"]</label>
            <div class="ocat-end">
                <input asp-for="CompanyName" class="form-control" autocomplete="off" />
                <span asp-validation-for="CompanyName"></span>
            </div>
        </div>
        <div class="ocat-wrapper" data-customer-business asp-validation-class-for="TaxId">
            <label asp-for="TaxId" class="ocat-label">@T["Tax id"]</label>
            <div class="ocat-end">
                <input asp-for="TaxId" class="form-control" autocomplete="off" />
                <span class="hint">@T["Such as a VAT number. It is shown on invoices."]</span>
            </div>
        </div>
        <div class="ocat-wrapper" data-customer-business>
            <div class="ocat-end-offset">
                <div class="form-check">
                    <input asp-for="IsTaxExempt" type="checkbox" class="form-check-input" />
                    <label asp-for="IsTaxExempt" class="form-check-label">@T["Exempt from tax"]</label>
                </div>
                <span class="hint dashed">@T["The customer pays no tax when they check out signed in, such as a reseller or a charity you hold a certificate for."]</span>
            </div>
        </div>
        <div class="ocat-wrapper" data-customer-business>
            <label asp-for="TaxExemptionReason" class="ocat-label">@T["Why they are exempt"]</label>
            <div class="ocat-end">
                <input asp-for="TaxExemptionReason" class="form-control" autocomplete="off" />
                <span class="hint">@T["Such as the resale certificate number, for your records."]</span>
            </div>
        </div>

        <div class="ocat-wrapper" asp-validation-class-for="Email">
            <label asp-for="Email" class="ocat-label">@T["Email"]</label>
            <div class="ocat-end">
                @if (hasAccount)
                {
                    <input asp-for="Email" class="form-control" readonly />
                    <span class="hint">@T["The account's email. It is changed on the account."]</span>
                }
                else
                {
                    <input asp-for="Email" type="email" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Email"></span>
                }
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="Phone">
            <label asp-for="Phone" class="ocat-label">@T["Phone"]</label>
            <div class="ocat-end">
                <input asp-for="Phone" type="tel" class="form-control" autocomplete="off" />
            </div>
        </div>

        <div class="ocat-wrapper">
            <div class="ocat-end-offset">
                <div class="form-check">
                    <input asp-for="AcceptsMarketing" type="checkbox" class="form-check-input" />
                    <label asp-for="AcceptsMarketing" class="form-check-label">@T["Accepts marketing"]</label>
                </div>
                <span class="hint dashed">@T["The customer agreed to news and offers. Order and payment messages are always sent."]</span>
            </div>
        </div>
    </fieldset>

    @if (!Model.IsNew)
    {
        <dl class="row mt-4 mb-0">
            <dt class="col-sm-3">@T["Account"]</dt>
            <dd class="col-sm-9">
                @if (hasAccount)
                {
                    <a href="@Url.Action("Edit", "Admin", new { area = "OrchardCore.Users", id = Model.UserId })">@(Model.UserName ?? Model.UserId)</a>
                }
                else
                {
                    @T["None (a guest)"]
                }
            </dd>
            <dt class="col-sm-3">@T["Customer since"]</dt>
            <dd class="col-sm-9">@(Model.CreatedUtc is { } createdUtc ? (await LocalAsync(createdUtc)).ToString("g") : null)</dd>
            <dt class="col-sm-3">@T["Last activity"]</dt>
            <dd class="col-sm-9">@(Model.LastActivityUtc is { } lastActivityUtc ? (await LocalAsync(lastActivityUtc)).ToString("g") : null)</dd>
        </dl>
    }

    @if (!readOnly)
    {
        <div class="ocat-wrapper mt-4">
            <div class="ocat-end-offset">
                <button type="submit" class="btn btn-primary save">@T["Save"]</button>
                <a class="btn btn-secondary" asp-action="Index">@T["Cancel"]</a>
            </div>
        </div>
    }
</form>

@if (Model.MergedInto is not null)
{
    <div class="alert alert-info mt-4">
        @T["This guest's orders and addresses moved to"]
        <a asp-action="Edit" asp-route-customerId="@Model.MergedInto.CustomerId">@Model.MergedInto.Name</a>
        @if (Model.MergedUtc.HasValue)
        {
            @T[" on {0:d}, when that account's email was verified.", await LocalAsync(Model.MergedUtc.Value)]
        }
    </div>
}

@if (!Model.IsNew && Model.HasOrders)
{
    <div class="mt-5">
        <h2 class="h5">@T["Orders"]</h2>
        @if (Model.Orders.Count == 0)
        {
            <p class="text-muted">@T["No orders yet."]</p>
        }
        else
        {
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th scope="col">@T["Order"]</th>
                        <th scope="col">@T["Placed"]</th>
                        <th scope="col">@T["Status"]</th>
                        <th scope="col" class="text-end">@T["Total"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Orders)
                    {
                        <tr>
                            <td><a asp-route="OrdersDetail" asp-route-orderId="@order.OrderId" class="font-monospace">@order.OrderNumber</a></td>
                            <td>@((await LocalAsync(order.CreatedUtc)).ToString("d"))</td>
                            <td>@order.Status</td>
                            <td class="text-end">@order.Total</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@if (Model.MergedCustomers.Count > 0)
{
    <div class="mt-4">
        <h2 class="h6">@T["Merged guest checkouts"]</h2>
        <ul class="list-unstyled small">
            @foreach (var merged in Model.MergedCustomers)
            {
                <li><a asp-action="Edit" asp-route-customerId="@merged.CustomerId">@merged.Name</a></li>
            }
        </ul>
    </div>
}

@if (Model.Sections is not null)
{
    @await DisplayAsync(Model.Sections)
}

@if (!Model.IsNew)
{
    <div class="mt-5">
        <partial name="_CustomerAddressList" model="new CustomerAddressListViewModel { Addresses = Model.Addresses, CustomerId = Model.CustomerId, CanManage = Model.CanManage && Model.Status != CustomerStatus.Anonymized }" />
    </div>
}

@if (!Model.IsNew && Model.CanManage)
{
    <div class="mt-5">
        <h2 class="h5">@T["Privacy"]</h2>
        @if (Model.Status != CustomerStatus.Anonymized)
        {
            <p class="text-muted small">@T["For an access request, download everything the store holds on this customer. For an erasure request, erase their name, email, phone, addresses and the personal details of their orders; the orders stay for your accounts, and an account itself is deleted under Users."]</p>
            <div class="d-flex gap-2">
                <a class="btn btn-sm btn-secondary" asp-action="Export" asp-route-customerId="@Model.CustomerId">@T["Download data"]</a>
                <form asp-action="Erase" asp-route-customerId="@Model.CustomerId" method="post" class="no-multisubmit">
                    <button type="submit" class="btn btn-sm btn-danger" data-url-af="RemoveUrl" data-title="@T["Erase personal data"]" data-message="@T["Erase this customer's name, email, phone, addresses and the personal details of their orders? This cannot be undone."]">@T["Erase personal data"]</button>
                </form>
            </div>
        }
        @if (Model.PrivacyLog.Count > 0)
        {
            <ul class="list-unstyled small mt-3 mb-0">
                @foreach (var entry in Model.PrivacyLog)
                {
                    var by = string.IsNullOrEmpty(entry.By) ? T["the retention task"].Value : entry.By;
                    <li>
                        @switch (entry.Action)
                        {
                            case CustomerPrivacyAction.Exported:
                                @T["{0:g}: data downloaded by {1}", await LocalAsync(entry.Utc), by]
                                break;
                            case CustomerPrivacyAction.Erased:
                                @T["{0:g}: personal data erased by {1}", await LocalAsync(entry.Utc), by]
                                break;
                            default:
                                @T["{0:g}: personal data erased after the retention window", await LocalAsync(entry.Utc)]
                                break;
                        }
                    </li>
                }
            </ul>
        }
    </div>
}

<script at="Foot">
    // Company and tax id are for businesses.
    (function () {
        var kind = document.querySelector('[data-customer-kind]');

        if (!kind) {
            return;
        }

        function sync() {
            document.querySelectorAll('[data-customer-business]').forEach(function (field) {
                field.hidden = kind.value !== 'Business';
            });
        }

        kind.addEventListener('change', sync);
        sync();
    })();
</script>
