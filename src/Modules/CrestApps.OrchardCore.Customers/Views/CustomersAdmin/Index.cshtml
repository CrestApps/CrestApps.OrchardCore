@model CustomersIndexViewModel

<zone Name="Title">
    <breadcrumb name="CustomersIndex" title="@T["Customers"]" />
</zone>

<form asp-action="Index" asp-route-pageSize="@Context.Request.Query["pageSize"]" method="post" id="customers-filter" class="no-multisubmit">
    <input type="submit" name="submit.Filter" id="submitFilter" class="visually-hidden" />

    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-3">
                <div class="col">
                    <div class="has-search">
                        <i class="fa-solid fa-search form-control-feedback" aria-hidden="true"></i>
                        <input asp-for="Options.Search" class="form-control" placeholder="@T["Search by name, company or email"]" type="search" autocomplete="off" />
                    </div>
                </div>
                @if (Model.CanManage)
                {
                    <div class="col-auto">
                        <a class="btn btn-secondary" asp-action="Create">@T["Add customer"]</a>
                    </div>
                }
            </div>
        </div>
    </div>
</form>

<ul class="list-group">
    <li class="list-group-item text-bg-theme">
        <div class="row gx-3 align-items-center">
            <div class="col text-nowrap">
                @T.Plural(Model.TotalCount, "1 customer", "{0} customers")
            </div>
            <div class="col col-md-auto text-end">
                <div class="btn-group filter">
                    <select asp-for="Options.Filter" asp-items="Model.Options.Filters" form="customers-filter" class="selectpicker show-tick" data-style="btn-sm" data-width="fit" data-header="@T["Show"]" data-dropdown-align-right="auto" data-commerce-list-filter aria-label="@T["Show"]"></select>
                </div>
            </div>
        </div>
    </li>
    @if (Model.Customers.Count > 0)
    {
        @foreach (var customer in Model.Customers)
        {
            <li class="list-group-item">
                <div class="row g-0">
                    <div class="col-lg col-12 title d-flex align-items-center">
                        <div class="summary">
                            <div class="d-flex flex-column flex-md-row align-items-md-center">
                                <div class="me-2">
                                    <h5 class="mb-1 mb-md-0"><a asp-action="Edit" asp-route-customerId="@customer.ItemId">@(customer.GetName() ?? T["(no name)"].Value)</a></h5>
                                </div>
                                <div class="tags me-1">
                                    @if (string.IsNullOrEmpty(customer.UserId))
                                    {
                                        <span class="badge text-bg-secondary">@T["Guest"]</span>
                                    }
                                    @if (customer.Kind == CustomerKind.Business)
                                    {
                                        <span class="badge text-bg-info">@T["Business"]</span>
                                    }
                                    @if (customer.Status == CustomerStatus.Disabled)
                                    {
                                        <span class="badge text-bg-warning">@T["Disabled"]</span>
                                    }
                                    else if (customer.Status == CustomerStatus.Anonymized)
                                    {
                                        <span class="badge text-bg-dark">@T["Anonymized"]</span>
                                    }
                                </div>
                            </div>
                            <div class="metadata mt-1">
                                @if (!string.IsNullOrEmpty(customer.Email))
                                {
                                    <span class="badge ta-badge font-weight-normal" data-bs-toggle="tooltip" title="@T["Email"]">
                                        <i class="fa-regular fa-envelope text-secondary" aria-hidden="true"></i><span class="visually-hidden">@T["Email"]</span>
                                        @customer.Email
                                    </span>
                                }
                                @if (customer.Kind == CustomerKind.Business && !string.IsNullOrEmpty(customer.CompanyName) && customer.CompanyName != customer.GetName())
                                {
                                    <span class="badge ta-badge font-weight-normal" data-bs-toggle="tooltip" title="@T["Company"]">
                                        <i class="fa-regular fa-building text-secondary" aria-hidden="true"></i><span class="visually-hidden">@T["Company"]</span>
                                        @customer.CompanyName
                                    </span>
                                }
                                <span class="badge ta-badge font-weight-normal" data-bs-toggle="tooltip" title="@T["Last activity"]">
                                    <i class="fa-regular fa-clock text-secondary" aria-hidden="true"></i><span class="visually-hidden">@T["Last activity"]</span>
                                    @customer.LastActivityUtc.ToString("g")
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-auto col-12 d-flex justify-content-end align-items-center">
                        <a class="btn btn-primary btn-sm" asp-action="Edit" asp-route-customerId="@customer.ItemId">@(Model.CanManage ? T["Edit"] : T["View"])</a>
                    </div>
                </div>
            </li>
        }
    }
    else
    {
        <li class="list-group-item">
            <div class="alert alert-info mb-0" role="alert">
                @T["<strong>Nothing here!</strong> There are no customers that match the current filter."]
            </div>
        </li>
    }
</ul>

@await DisplayAsync(Model.Pager)

<style asp-name="bootstrap-select"></style>
<script asp-name="commerce-admin-list" at="Foot"></script>
