@model MyAccountViewModel

<zone Name="Title">
    <breadcrumb name="MyAccount" title="@T["My Account"]" />
</zone>

<form asp-action="Index" method="post" class="no-multisubmit mb-5">
    <partial name="_CustomerProfileFields" model="Model" />

    <div class="mt-4">
        <button type="submit" class="btn btn-primary save">@T["Save"]</button>
    </div>
</form>

<partial name="_CustomerAddressList" model="new CustomerAddressListViewModel { Addresses = Model.Addresses, IsOwn = true, CanManage = true }" />
