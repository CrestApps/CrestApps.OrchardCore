@model IShape

<zone Name="Title">
    <breadcrumb name="AccountDetails" title="@T["Account details"]">
        <breadcrumb-item id="CommerceAccount" url="@Url.RouteUrl(CommerceConstants.Account.HomeRouteName)">@T["Your account"]</breadcrumb-item>
    </breadcrumb>
</zone>

@await DisplayAsync(await New.CommerceAccountPage(Title: T["Account details"], Content: Model))
