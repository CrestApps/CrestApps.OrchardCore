@model IShape

@{
    var address = (CustomerAddressViewModel)Model;
}

<zone Name="Title">
    <breadcrumb name="@(address.IsNew ? "AccountAddressCreate" : "AccountAddressEdit")" title="@(address.IsNew ? T["Add address"] : T["Edit address"])">
        <breadcrumb-item id="CommerceAccount" url="@Url.RouteUrl(CommerceConstants.Account.HomeRouteName)">@T["Your account"]</breadcrumb-item>
        <breadcrumb-item id="AccountAddresses" url="@Url.RouteUrl("AccountAddresses")">@T["Addresses"]</breadcrumb-item>
    </breadcrumb>
</zone>

@await DisplayAsync(await New.CommerceAccountPage(Title: address.IsNew ? T["Add address"] : T["Edit address"], Content: Model))
