@using Microsoft.AspNetCore.Html
@model IShape

<zone Name="Title">
    <breadcrumb name="AccountAddresses" title="@T["Addresses"]">
        <breadcrumb-item id="CommerceAccount" url="@Url.RouteUrl(CommerceConstants.Account.HomeRouteName)">@T["Your account"]</breadcrumb-item>
    </breadcrumb>
</zone>

@{
    Func<object, IHtmlContent> addAddress = @<a class="btn btn-primary" href="@Url.RouteUrl("AccountAddressCreate")">
        <span class="fa-solid fa-plus me-1" aria-hidden="true"></span>@T["Add address"]
    </a>;
}

@await DisplayAsync(await New.CommerceAccountPage(Title: T["Addresses"], Actions: addAddress(null), Content: Model))
