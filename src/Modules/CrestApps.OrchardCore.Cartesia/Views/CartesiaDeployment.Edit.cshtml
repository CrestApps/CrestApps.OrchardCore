@using CrestApps.OrchardCore.Cartesia.ViewModels
@using OrchardCore

@model CartesiaDeploymentViewModel

<div class="ocat-wrapper">
    <label asp-for="Endpoint" class="ocat-label">@T["Endpoint"]</label>
    <div class="ocat-end">
        <input type="url" asp-for="Endpoint" class="form-control" placeholder="https://api.cartesia.ai" />
        <span asp-validation-for="Endpoint" class="text-danger"></span>
        <span class="hint">@T["The Cartesia API endpoint. Leave empty to use the default endpoint."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="ApiKey" class="ocat-label">@T["API key"]</label>
    <div class="ocat-end">
        <input asp-for="ApiKey" class="form-control" autocomplete="new-password" placeholder="@(Model.HasApiKey ? T["A key is securely stored. Provide a new one to replace it or leave it blank."] : T["The API key"])" />
        <span asp-validation-for="ApiKey" class="text-danger"></span>
        <span class="hint">@T["The Cartesia API key."]</span>
    </div>
</div>
