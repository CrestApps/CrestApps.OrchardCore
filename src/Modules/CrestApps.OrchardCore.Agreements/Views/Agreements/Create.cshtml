@using CrestApps.OrchardCore.Core.Models

@model EditCatalogEntryViewModel

<zone Name="Title">
    <breadcrumb name="AgreementsCreate" title="@T["New Agreement"]">
        <breadcrumb-item id="AgreementsIndex" action="Index" controller="Agreements" area="CrestApps.OrchardCore.Agreements" permission="@AgreementsPermissions.ViewAgreements.Name">@T["Agreements"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form method="post" asp-route-cloneId="@ViewContext.HttpContext.Request.Query["cloneId"]" asp-route-accountId="@ViewContext.HttpContext.Request.Query["accountId"]" class="no-multisubmit">
    @Html.ValidationSummary()
    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <button class="btn btn-primary" type="submit">@T["Save"]</button>
        <a class="btn btn-secondary cancel" role="button" asp-route-action="Index">@T["Cancel"]</a>
    </div>
</form>
