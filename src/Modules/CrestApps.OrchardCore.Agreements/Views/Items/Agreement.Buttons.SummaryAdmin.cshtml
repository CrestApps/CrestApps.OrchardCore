@model ShapeViewModel<Agreement>

<a asp-action="Edit"
   asp-route-id="@Model.Value.ItemId"
   class="btn btn-primary btn-sm">@T["Edit"]</a>

@if (Model.Value.Status == AgreementStatus.Draft)
{
    <a asp-action="Delete"
       asp-route-id="@Model.Value.ItemId"
       class="btn btn-danger btn-sm"
       data-title="@T["Delete"]"
       data-message="@T["Are you sure you want to delete this draft agreement?"]"
       data-url-af="RemoveUrl UnsafeUrl">@T["Delete"]</a>
}
