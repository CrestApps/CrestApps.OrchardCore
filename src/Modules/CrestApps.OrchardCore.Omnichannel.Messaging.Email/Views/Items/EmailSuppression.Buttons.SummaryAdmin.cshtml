@model ShapeViewModel<EmailSuppression>

<a asp-action="Remove"
   asp-controller="Suppressions"
   asp-route-address="@Model.Value.Address"
   asp-route-returnUrl="@FullRequestPath"
   class="btn btn-danger btn-sm"
   title="@T["Take this address off the list so it can be emailed again."]"
   data-title="@T["Remove From the List"]"
   data-message="@T["Send to {0} again? Only take an address off when you know it works.", Model.Value.Address]"
   data-ok-text="@T["Remove"]"
   data-cancel-text="@T["Cancel"]"
   data-url-af="RemoveUrl UnsafeUrl">@T["Remove"]</a>
