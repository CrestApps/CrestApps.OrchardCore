@model SurveyQuestionRowModel

@{
    var prefix = ViewData["SurveyPrefix"] as string;
    var name = $"{prefix}[{Model.Index}]";
    var row = Model.Row;
}

<div class="card mb-2" data-survey-question>
    <div class="card-body">
        <input type="hidden" name="@(name).Id" value="@row.Id" />
        <div class="row g-2 align-items-start">
            <div class="col-12 col-md-7">
                <label class="form-label">@T["Question"]</label>
                <input type="text" name="@(name).Text" value="@row.Text" class="form-control" maxlength="1000" />
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label">@T["Answer"]</label>
                <select name="@(name).Type" class="form-select" data-survey-type>
                    @foreach (var option in Model.TypeOptions)
                    {
                        <option value="@option.Value" selected="@(option.Value == row.Type.ToString())">@option.Text</option>
                    }
                </select>
            </div>
            @if (!Model.SingleQuestion)
            {
                <div class="col-12 col-md-1 text-md-end">
                    <button type="button" class="btn btn-sm btn-outline-danger mt-md-4" data-survey-remove-question title="@T["Remove the question"]" aria-label="@T["Remove the question"]"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
                </div>
            }
        </div>
        <div class="mt-2" data-survey-options>
            <label class="form-label">@T["Choices, one a line"]</label>
            <textarea name="@(name).Options" rows="4" class="form-control">@row.Options</textarea>
        </div>
        <div class="form-check mt-2">
            <input type="checkbox" name="@(name).Required" value="true" class="form-check-input" id="@(name.Replace('[', '_').Replace(']', '_').Replace('.', '_'))_Required" checked="@row.Required" />
            <label class="form-check-label" for="@(name.Replace('[', '_').Replace(']', '_').Replace('.', '_'))_Required">@T["Learners must answer it"]</label>
        </div>
    </div>
</div>
