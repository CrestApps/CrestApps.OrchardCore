@model SurveySummary

@{
    var named = ViewData["SurveyNamedTextAnswers"] as IDictionary<string, IList<(string Learner, string Answer)>>;
}

<p class="text-secondary small mb-3">@T.Plural(Model.ResponseCount, "1 learner answered.", "{0} learners answered.")</p>

@foreach (var question in Model.Questions)
{
    <div class="mb-3" data-survey-totals="@question.QuestionId">
        <h3 class="h6 mb-2">@question.Text</h3>
        @if (question.Type == SurveyQuestionType.Text)
        {
            IList<(string Learner, string Answer)> answers = named is not null && named.TryGetValue(question.QuestionId, out var withNames) ? withNames : question.TextAnswers.Select(answer => ((string)null, answer)).ToList();

            if (answers.Count == 0)
            {
                <p class="text-secondary small mb-0">@T["No written answers yet."]</p>
            }
            else
            {
                <ul class="list-group">
                    @foreach (var (learner, answer) in answers)
                    {
                        <li class="list-group-item text-break">
                            @if (!string.IsNullOrEmpty(learner))
                            {
                                <strong class="d-block small">@learner</strong>
                            }
                            <span style="white-space: pre-line">@answer</span>
                        </li>
                    }
                </ul>
            }
        }
        else
        {
            if (question.Average is { } average)
            {
                <p class="small mb-1">@T["Average {0} of 5", average.ToString("0.##")]</p>
            }

            foreach (var (choice, count) in question.Counts)
            {
                var percent = question.AnswerCount == 0 ? 0 : (int)Math.Round(count * 100m / question.AnswerCount, MidpointRounding.AwayFromZero);

                <div class="mb-1">
                    <div class="d-flex justify-content-between small"><span>@choice</span><span>@T["{0} ({1}%)", count, percent]</span></div>
                    <div class="progress" role="progressbar" aria-label="@choice" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100" style="height: .5rem">
                        <div class="progress-bar" style="width: @(percent)%"></div>
                    </div>
                </div>
            }
        }
    </div>
}
