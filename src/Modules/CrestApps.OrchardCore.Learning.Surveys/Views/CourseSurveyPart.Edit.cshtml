@model CourseSurveyPartViewModel

@{
    var survey = Model.Survey;
}

<div class="card text-bg-theme mb-3">
    <div class="card-header">@(Model.SingleQuestion ? T["Choice"] : T["Survey"])</div>
    <div class="card-body">
        @if (survey is null)
        {
            <div class="ocat-wrapper">
                <div class="ocat-end-offset">
                    <span class="hint">@T["Save the item first: saving creates its survey, which you then design."]</span>
                </div>
            </div>
        }
        else
        {
            <div class="ocat-wrapper">
                <span class="ocat-label">@T["Survey"]</span>
                <div class="ocat-end">
                    <span class="badge ta-badge fw-normal" title="@T["Status"]"><i class="fa-solid fa-circle-info me-1" aria-hidden="true"></i>@survey.Status</span>
                    <span class="badge ta-badge fw-normal" title="@T["Questions in the draft"]"><i class="fa-solid fa-list-ol me-1" aria-hidden="true"></i>@T["{0} questions", Model.QuestionCount]</span>
                    @if (survey.PublishedVersionNumber > 0)
                    {
                        <span class="badge ta-badge fw-normal" title="@T["Published version"]"><i class="fa-solid fa-code-branch me-1" aria-hidden="true"></i>@T["Version {0}", survey.PublishedVersionNumber]</span>
                    }
                    @if (survey.HasUnpublishedChanges)
                    {
                        <span class="badge text-bg-warning fw-normal">@T["Unpublished changes"]</span>
                    }
                </div>
            </div>
            @if (survey.PublishedVersionNumber == 0)
            {
                <div class="ocat-wrapper">
                    <div class="ocat-end-offset">
                        <div class="alert alert-warning mb-0">@T["Learners can answer once the survey is published. Add the questions, then publish them in the designer."]</div>
                    </div>
                </div>
            }
            <div class="ocat-wrapper">
                <div class="ocat-end-offset">
                    <a class="btn btn-secondary btn-sm" href="@Url.Content("~/Admin/surveys/" + survey.ItemId + "/design")"><i class="fa-solid fa-pen-ruler me-1" aria-hidden="true"></i>@T["Edit questions"]</a>
                    <a class="btn btn-outline-secondary btn-sm" href="@Url.Content("~/Admin/surveys/" + survey.ItemId + "/access")"><i class="fa-solid fa-sliders me-1" aria-hidden="true"></i>@T["Access and settings"]</a>
                    <a class="btn btn-outline-secondary btn-sm" href="@(Url.RouteUrl("ReportsDisplay", new { id = "survey-results" }) + "?SurveyReport.SurveyId=" + Uri.EscapeDataString(survey.ItemId))"><i class="fa-solid fa-square-poll-vertical me-1" aria-hidden="true"></i>@T["Totals"]</a>
                    <span class="hint">@T["The close date, anonymity and when learners see the totals are the survey's own settings."]</span>
                </div>
            </div>
        }
    </div>
</div>
