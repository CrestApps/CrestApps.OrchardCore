@using CrestApps.Core.AI.Models
@using OrchardCore.DisplayManagement.Views

@model ShapeViewModel<FileSource>

<span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Connector"]">
    <i class="fa-solid fa-plug text-secondary me-1" aria-hidden="true"></i>@Model.Value.Source
</span>

@if (!Model.Value.Enabled)
{
    <span class="badge ta-badge bg-secondary-subtle fw-normal" data-bs-toggle="tooltip" title="@T["Status"]">
        <i class="fa-solid fa-ban text-secondary me-1" aria-hidden="true"></i>@T["Disabled"]
    </span>
}
