@using CrestApps.OrchardCore.AI.FileSources.Cloud

@model CloudFileSourceViewModel

<div class="ocat-wrapper" asp-validation-class-for="ConnectionId">
    <label asp-for="ConnectionId" class="ocat-label ocat-label-required">@T["Connection"]</label>
    <div class="ocat-end">
        <select asp-for="ConnectionId" asp-items="Model.Connections" class="form-select">
            <option value="">@T["Choose a connection"]</option>
        </select>
        <span asp-validation-for="ConnectionId" class="text-danger"></span>
        <span class="hint">@T["Add one under Artificial Intelligence, Integrations, and connect it."]</span>
    </div>
</div>

@if (Model.Connector == CloudFileSourceConnectors.SharePoint)
{
    <div class="ocat-wrapper">
        <label asp-for="DriveId" class="ocat-label">@T["Document library"]</label>
        <div class="ocat-end">
            <input asp-for="DriveId" class="form-control" />
            <span class="hint">@T["The library's drive id from Microsoft Graph. Empty reads the connected user's OneDrive."]</span>
        </div>
    </div>
}

<div class="ocat-wrapper" asp-validation-class-for="RootPath">
    <label asp-for="RootPath" class="ocat-label @(Model.Connector == CloudFileSourceConnectors.Notion ? "ocat-label-required" : "")">
        @(Model.Connector switch
        {
            CloudFileSourceConnectors.GoogleDrive => T["Folder id"],
            CloudFileSourceConnectors.SharePoint => T["Folder"],
            _ => T["Database or page id"],
        })
    </label>
    <div class="ocat-end">
        <input asp-for="RootPath" class="form-control" />
        <span asp-validation-for="RootPath" class="text-danger"></span>
        <span class="hint">
            @(Model.Connector switch
            {
                CloudFileSourceConnectors.GoogleDrive => T["The id at the end of the folder's address in Drive. Empty reads My Drive."],
                CloudFileSourceConnectors.SharePoint => T["A path in the library, such as Policies/Current. Empty reads the whole library."],
                _ => T["The id at the end of the database's or page's address. Share it with the integration first."],
            })
        </span>
    </div>
</div>

@if (Model.Connector != CloudFileSourceConnectors.Notion)
{
    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <div class="form-check">
                <input asp-for="Recursive" class="form-check-input" />
                <label asp-for="Recursive" class="form-check-label">@T["Read sub-folders"]</label>
            </div>
        </div>
    </div>
}

<div class="ocat-wrapper">
    <label asp-for="MaxItems" class="ocat-label">@T["Most files"]</label>
    <div class="ocat-end">
        <input asp-for="MaxItems" type="number" min="1" class="form-control" style="max-width: 10rem;" />
        <span class="hint">@T["Empty reads them all."]</span>
    </div>
</div>
