@model CalendarSubscriptionViewModel

<div data-calendar-subscription data-address-providers="@string.Join(',', Model.AddressProviders)" data-writable-providers="@string.Join(',', Model.WritableProviders)">
    @if (Model.NeedsReconnect)
    {
        <div class="alert alert-warning">@T["The external calendar refused access, so synchronization is paused. Reconnect the account if the provider needs it, then save the calendar to start again."]</div>
    }

    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <div class="form-check">
                <input asp-for="SubscriptionEnabled" class="form-check-input" />
                <label asp-for="SubscriptionEnabled" class="form-check-label">@T["Keep this calendar in step with an external calendar"]</label>
                <span class="hint dashed">@T["The external calendar's events are copied here and kept up to date."]</span>
            </div>
        </div>
    </div>

    <div class="ocat-wrapper">
        <label asp-for="SubscriptionProvider" class="ocat-label">@T["Provider"]</label>
        <div class="ocat-end">
            <select asp-for="SubscriptionProvider" asp-items="Model.ProviderOptions" class="form-select" style="max-width: 24rem" data-subscription-provider></select>
            <span asp-validation-for="SubscriptionProvider" class="text-danger"></span>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="SubscriptionUrl" data-subscription-address>
        <label asp-for="SubscriptionUrl" class="ocat-label">@T["Address"]</label>
        <div class="ocat-end">
            <input asp-for="SubscriptionUrl" class="form-control" placeholder="https://calendar.example.com/feed.ics" />
            <span asp-validation-for="SubscriptionUrl" class="text-danger"></span>
            <span class="hint">@T["The secret iCalendar address of the external calendar, such as the one Google Calendar or Outlook shows under the calendar's settings."]</span>
        </div>
    </div>

    <div class="ocat-wrapper">
        <label asp-for="SubscriptionInterval" class="ocat-label">@T["Every (minutes)"]</label>
        <div class="ocat-end">
            <input asp-for="SubscriptionInterval" type="number" min="5" max="10080" class="form-control" style="max-width: 10rem" />
        </div>
    </div>

    <div data-subscription-writable>
        <div class="ocat-wrapper">
            <div class="ocat-end-offset">
                <div class="form-check">
                    <input asp-for="TwoWay" class="form-check-input" />
                    <label asp-for="TwoWay" class="form-check-label">@T["Write changes made here back to the external calendar"]</label>
                    <span class="hint dashed">@T["Events added, changed or deleted here are added, changed or deleted in the external calendar too. Otherwise the copied events can't be changed here."]</span>
                </div>
            </div>
        </div>

        <div class="ocat-wrapper">
            <label asp-for="ConflictPolicy" class="ocat-label">@T["When both copies changed"]</label>
            <div class="ocat-end">
                <select asp-for="ConflictPolicy" asp-items="Model.ConflictPolicyOptions" class="form-select" style="max-width: 24rem"></select>
                <span class="hint">@T["Which copy to keep when an event was changed both here and in the external calendar since they were last synchronized."]</span>
            </div>
        </div>
    </div>

    @if (Model.LastSyncedUtc.HasValue || !string.IsNullOrEmpty(Model.LastError))
    {
        <div class="ocat-wrapper">
            <span class="ocat-label">@T["Last synchronized"]</span>
            <div class="ocat-end">
                @if (Model.LastSyncedUtc.HasValue)
                {
                    <p class="mb-1">@await DisplayAsync(await New.DateTime(Utc: Model.LastSyncedUtc.Value, Format: "g")) <span class="text-muted">@Model.LastResult</span></p>
                }
                @if (!string.IsNullOrEmpty(Model.LastError))
                {
                    <p class="text-danger mb-0">@Model.LastError</p>
                }
            </div>
        </div>
    }
</div>

<script at="Foot">
    (function () {
        document.querySelectorAll('[data-calendar-subscription]').forEach(function (root) {
            const provider = root.querySelector('[data-subscription-provider]');
            const addressProviders = (root.dataset.addressProviders || '').split(',');
            const writableProviders = (root.dataset.writableProviders || '').split(',');
            const sync = function () {
                root.querySelector('[data-subscription-address]').classList.toggle('d-none', !addressProviders.includes(provider.value));
                root.querySelector('[data-subscription-writable]').classList.toggle('d-none', !writableProviders.includes(provider.value));
            };

            provider.addEventListener('change', sync);
            sync();
        });
    })();
</script>
