@model CalendarGeneralViewModel

<style asp-name="bootstrap-select"></style>
<script asp-name="bootstrap-select" depends-on="bootstrap" at="Foot"></script>

<div class="ocat-wrapper">
    <span class="ocat-label">@T["Type"]</span>
    <div class="ocat-end">
        <p class="form-control-plaintext mb-0"><i class="@Model.TypeIcon text-secondary me-1" aria-hidden="true"></i>@Model.TypeName</p>
        @if (!string.IsNullOrEmpty(Model.TypeDescription))
        {
            <span class="hint">@Model.TypeDescription</span>
        }
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="Name">
    <label asp-for="Name" class="ocat-label ocat-label-required">@T["Name"]</label>
    <div class="ocat-end">
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="Description">
    <label asp-for="Description" class="ocat-label">@T["Description"]</label>
    <div class="ocat-end">
        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="Color">
    <label asp-for="Color" class="ocat-label">@T["Color"]</label>
    <div class="ocat-end">
        <input asp-for="Color" type="color" class="form-control form-control-color" />
        <span class="hint">@T["The color the calendar's events are drawn in, unless their type has its own."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="TimeZoneId">
    <label asp-for="TimeZoneId" class="ocat-label">@T["Time zone"]</label>
    <div class="ocat-end">
        <select asp-for="TimeZoneId" asp-items="Model.TimeZoneOptions" class="selectpicker show-tick" data-live-search="true" title="@T["The site's time zone"]">
            <option value="">@T["The site's time zone"]</option>
        </select>
        <span class="hint">@T["The time zone new events of this calendar use."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="Visibility">
    <label asp-for="Visibility" class="ocat-label">@T["Visibility"]</label>
    <div class="ocat-end">
        <select asp-for="Visibility" asp-items="Model.VisibilityOptions" class="form-select"></select>
        <span class="hint">@T["Who can see the calendar besides its owner and the people it is shared with."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input asp-for="Enabled" class="form-check-input" />
            <label asp-for="Enabled" class="form-check-label">@T["Enabled"]</label>
            <span class="hint dashed">@T["A disabled calendar keeps its events but takes no new ones."]</span>
        </div>
    </div>
</div>
