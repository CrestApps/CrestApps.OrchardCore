@using CrestApps.OrchardCore.Calendars.Deployments
@model CalendarsDeploymentStepViewModel

<h5>@T["Calendars"]</h5>
<div class="mb-3">
    <div class="form-check">
        <input asp-for="IncludeEvents" class="form-check-input" />
        <label asp-for="IncludeEvents" class="form-check-label">@T["Include events"]</label>
        <span class="hint dashed">@T["Export the events of each calendar too, up to 10,000 per calendar."]</span>
    </div>
</div>
