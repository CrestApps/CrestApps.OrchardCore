@model CalendarCategoryListViewModel

<zone Name="Title">
    <breadcrumb name="CalendarCategories" title="@T["Categories"]">
        <breadcrumb-item id="CalendarView" action="Index" controller="Calendar" area="CrestApps.OrchardCore.Calendars">@T["Calendar"]</breadcrumb-item>
    </breadcrumb>
</zone>

<style asp-name="@CrestApps.OrchardCore.Calendars.Services.CalendarResourceConfiguration.ViewStyle"></style>

<form asp-action="Index" method="get" class="no-multisubmit">
    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <div class="input-group">
                        <input name="search" value="@Model.Search" class="form-control" placeholder="@T["Search"]" type="search" autocomplete="off" />
                        <button type="submit" class="btn btn-outline-secondary" title="@T["Search"]" aria-label="@T["Search"]"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
                    </div>
                </div>
                <div class="col-auto"><a asp-action="Edit" class="btn btn-secondary create">@T["Add category"]</a></div>
            </div>
        </div>
    </div>
</form>

<admin-list name="CalendarCategories" context="Model.List" show-select-all="false"
            empty-message="@T["<strong>Nothing here!</strong> Add a category, give it a color, and put events in it to color-code your calendar."]">
    <admin-list-list item-css-class="list-group-item" />
    <admin-list-grid>
        <admin-list-column name="Name" position="20" title="@T["Name"]" />
        <admin-list-column name="Details" position="30" title="@T["Who can use it"]" width="auto" />
        <admin-list-column type="Actions" title="@T["Actions"]" />
    </admin-list-grid>
</admin-list>
