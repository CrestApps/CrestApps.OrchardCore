@model EditCalendarEventViewModel
@{
    var modal = ViewData["CalendarModal"] is true;
    string modalRoute = modal ? "true" : null;
}

<form method="post" asp-action="Create" asp-route-modal="@modalRoute" class="no-multisubmit" data-calendar-editor-form>
    <input type="hidden" asp-for="CalendarId" />
    <p class="text-muted"><i class="fa-solid fa-calendar me-1" aria-hidden="true"></i>@Model.CalendarName</p>
    @Html.ValidationSummary()
    @await DisplayAsync(Model.Editor)

    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <button class="btn btn-primary" type="submit">@T["Save"]</button>
            @if (modal)
            {
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@T["Cancel"]</button>
            }
            else
            {
                <a class="btn btn-secondary cancel" role="button" asp-controller="Calendar" asp-action="Index">@T["Cancel"]</a>
            }
        </div>
    </div>
</form>
