@model EditCalendarViewModel

<zone Name="Title">
    <breadcrumb name="CalendarsCreate" title="@(new Microsoft.AspNetCore.Html.HtmlContentBuilder().Append(Model.Title))">
        <breadcrumb-item id="CalendarsIndex" action="Index" controller="Calendars" area="CrestApps.OrchardCore.Calendars">@T["Calendars"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form method="post" asp-route-type="@Model.Type" class="no-multisubmit">
    @Html.ValidationSummary()
    @await DisplayAsync(Model.Editor)

    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <button class="btn btn-primary" type="submit">@T["Save"]</button>
            <a class="btn btn-secondary cancel" role="button" asp-action="Index">@T["Cancel"]</a>
        </div>
    </div>
</form>
