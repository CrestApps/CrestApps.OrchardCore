<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
    <Title>CrestApps OrchardCore Learning</Title>
    <Description>
      $(CrestAppsDescription)

      A learning management system built from Orchard Core content and the CrestApps building blocks: courses with an
      outline of lessons (pages, videos, files, links and acknowledgements), enrollment with grants, approval and
      enrollment keys, server-side progress and completion with a self-contained completion snapshot, release rules,
      the learner pages, and lesson access that Orchard Core's display route, content API, GraphQL and Secure Media all
      follow.
    </Description>
    <PackageTags>$(PackageTags) CrestApps OrchardCoreCMS Learning LMS Courses Enrollment Training</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrestApps.OrchardCore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

