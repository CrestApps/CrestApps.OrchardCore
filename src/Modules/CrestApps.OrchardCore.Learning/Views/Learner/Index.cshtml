@model MyLearningViewModel
@using Microsoft.AspNetCore.Html

@{
    // Inside the storefront account the page is framed by the account menu; without it, it stands alone.
    var accountUrl = Url.RouteUrl(CrestApps.OrchardCore.Commerce.CommerceConstants.Account.HomeRouteName);
    Func<object, IHtmlContent> actions = @<text><a class="btn btn-outline-secondary btn-sm" href="@Url.RouteUrl("LearningCatalog")">@T["Course catalog"]</a> <a class="btn btn-outline-secondary btn-sm" href="@Url.RouteUrl("LearningTranscript")">@T["My transcript"]</a></text>;
    Func<object, IHtmlContent> content = @<text>
    @if (Model.Current.Count == 0 && Model.Past.Count == 0 && Model.Completed.Count == 0 && Model.Other.Count == 0)
    {
        @await DisplayAsync(await New.CommerceAccountEmptyState(Icon: "fa-solid fa-book-open", Title: T["You are not enrolled in any course yet."], Hint: T["Courses you enroll in, or that your organization enrolls you in, appear here with your progress."], Actions: new HtmlString($"<a class=\"btn btn-primary btn-sm\" href=\"{Url.RouteUrl("LearningCatalog")}\">{System.Net.WebUtility.HtmlEncode(T["Browse the course catalog"].Value)}</a>")))
    }
    else if (Model.Current.Count == 0)
    {
        <h2 class="h5">@T["In progress"]</h2>
        <p class="text-muted">@T["You are not enrolled in any course right now."]</p>
    }
    else
    {
        <h2 class="h5">@T["In progress"]</h2>
        <div class="row row-cols-1 row-cols-md-2 g-3 mb-4">
            @foreach (var row in Model.Current)
            {
                var enrollment = row.Enrollment;
                <div class="col">
                    <div class="card h-100">
                        <div class="card-body">
                            <h3 class="h6 card-title">@row.Title</h3>
                            @if (!string.IsNullOrEmpty(row.Code))
                            {
                                <p class="small text-muted mb-2">@row.Code</p>
                            }
                            @if (enrollment.Status == EnrollmentStatus.Pending)
                            {
                                <p class="mb-0"><i class="fa-solid fa-hourglass-half me-1" aria-hidden="true"></i>@T["Waiting for approval"]</p>
                            }
                            else if (enrollment.Status == EnrollmentStatus.Suspended)
                            {
                                <p class="mb-0">@T["Paused by the course staff"]</p>
                            }
                            else if (row.Schedule == CourseSchedule.NotStarted && row.StartsUtc is { } starts)
                            {
                                <p class="mb-2" data-course-starts><i class="fa-regular fa-calendar me-1" aria-hidden="true"></i>@T["Starts on"] @await DisplayAsync(await New.DateTime(Utc: DateTime.SpecifyKind(starts, DateTimeKind.Utc), Format: "g"))</p>
                            }
                            else
                            {
                                <div class="progress mb-2" role="progressbar" aria-label="@T["Progress of {0}", row.Title]" aria-valuenow="@enrollment.ProgressPercent" aria-valuemin="0" aria-valuemax="100">
                                    <div class="progress-bar" style="width: @(enrollment.ProgressPercent)%">@(enrollment.ProgressPercent)%</div>
                                </div>
                                @if (enrollment.DueUtc is { } due)
                                {
                                    <p class="small mb-2">@T["Due"] @await DisplayAsync(await New.DateTime(Utc: DateTime.SpecifyKind(due, DateTimeKind.Utc), Format: "g"))</p>
                                }
                                @if (row.CourseAvailable)
                                {
                                    <a class="btn btn-primary btn-sm" href="@Url.RouteUrl("LearningPlayer", new { courseId = enrollment.CourseId })">@(enrollment.StartedUtc is null ? T["Start"] : T["Continue"])</a>
                                }
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (Model.Past.Count > 0)
    {
        <h2 class="h5">@T["Past courses"]</h2>
        <p class="small text-muted">@T["These courses have ended. They stay open, so you can still finish them."]</p>
        <ul class="list-group mb-4">
            @foreach (var row in Model.Past)
            {
                <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <span>@row.Title <span class="badge text-bg-light border ms-1">@(row.Enrollment.ProgressPercent)%</span></span>
                    <span class="small text-muted" data-course-ends>@T["Ended on"] @await DisplayAsync(await New.DateTime(Utc: DateTime.SpecifyKind(row.EndsUtc ?? row.Enrollment.CreatedUtc, DateTimeKind.Utc), Format: "d"))</span>
                    @if (row.CourseAvailable)
                    {
                        <a class="btn btn-outline-primary btn-sm" href="@Url.RouteUrl("LearningPlayer", new { courseId = row.Enrollment.CourseId })">@T["Continue"]</a>
                    }
                </li>
            }
        </ul>
    }

    @if (Model.Completed.Count > 0)
    {
        <h2 class="h5">@T["Completed"]</h2>
        <ul class="list-group mb-4">
            @foreach (var row in Model.Completed)
            {
                <li class="list-group-item d-flex flex-wrap justify-content-between gap-2">
                    <span><i class="fa-solid fa-circle-check text-success me-1" aria-hidden="true"></i>@row.Title</span>
                    <span class="small text-muted">@await DisplayAsync(await New.DateTime(Utc: DateTime.SpecifyKind(row.Enrollment.CompletedUtc ?? row.Enrollment.CreatedUtc, DateTimeKind.Utc), Format: "d"))</span>
                </li>
            }
        </ul>
    }

    @if (Model.Other.Count > 0)
    {
        <h2 class="h5">@T["Access ended"]</h2>
        <ul class="list-group">
            @foreach (var row in Model.Other)
            {
                <li class="list-group-item">@row.Title</li>
            }
        </ul>
    }
    </text>;
}

@if (accountUrl is not null)
{
    <zone Name="Title">
        <breadcrumb name="LearningMyLearning" title="@T["My learning"]">
            <breadcrumb-item id="CommerceAccount" url="@accountUrl">@T["Your account"]</breadcrumb-item>
        </breadcrumb>
    </zone>

    @await DisplayAsync(await New.CommerceAccountPage(Title: T["My learning"], Actions: actions(null), Content: content(null)))
}
else
{
    <div class="container my-4">
        <div class="product-breadcrumb">
            <breadcrumb name="LearningMyLearning" title="@T["My learning"]">
                <breadcrumb-item id="Home" url="@Url.Content("~/")">@T["Home"]</breadcrumb-item>
            </breadcrumb>
        </div>
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
            <h1 class="h3 mb-0">@T["My learning"]</h1>
            @actions(null)
        </div>
        @content(null)
    </div>
}
