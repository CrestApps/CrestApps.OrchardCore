@using CrestApps.OrchardCore.Learning.Pipelines
@model EnrollLearnersStepViewModel

<div class="mb-3">
    <label asp-for="UserIdField" class="form-label">@T["User id field"]</label>
    <input asp-for="UserIdField" class="form-control" />
    <span asp-validation-for="UserIdField"></span>
    <span class="hint">@T["The input field that holds the user id of each learner, for example one joined from the Users data set by e-mail."]</span>
</div>
<div class="mb-3">
    <label asp-for="CourseId" class="form-label">@T["Course"]</label>
    <select asp-for="CourseId" asp-items="Model.CourseOptions" class="form-select">
        <option value="">@T["Use the course field"]</option>
    </select>
    <span asp-validation-for="CourseId"></span>
</div>
<div class="mb-3">
    <label asp-for="CourseIdField" class="form-label">@T["Course field"]</label>
    <input asp-for="CourseIdField" class="form-control" />
    <span class="hint">@T["Optional. The input field that holds the content item id of each row's course, instead of one course for every row."]</span>
</div>
