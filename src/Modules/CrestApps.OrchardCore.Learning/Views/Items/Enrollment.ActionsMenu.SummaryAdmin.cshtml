@model EnrollmentRowViewModel

@if (Model.Enrollment.Status == EnrollmentStatus.Pending)
{
    <a asp-controller="Enrollments" asp-action="Approve" asp-route-id="@Model.Enrollment.ItemId" class="dropdown-item" data-title="@T["Approve"]" data-message="@T["Approve this enrollment? The learner can start at once."]" data-url-af="RemoveUrl UnsafeUrl">@T["Approve"]</a>
}
<a asp-controller="Enrollments" asp-action="Detail" asp-route-id="@Model.Enrollment.ItemId" class="dropdown-item">@T["Progress and History"]</a>
