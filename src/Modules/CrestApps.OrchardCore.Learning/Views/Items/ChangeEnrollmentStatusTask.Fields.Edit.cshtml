@using CrestApps.OrchardCore.Learning.Workflows

@model LearningTaskViewModel

<div class="mb-3">
    <label asp-for="EnrollmentId" class="form-label">@T["Enrollment id"]</label>
    <input asp-for="EnrollmentId" class="form-control code" />
    <span class="hint">@T["The id of the enrollment, a Liquid expression such as Workflow.Input.EnrollmentId between double braces."]</span>
</div>

<div class="mb-3">
    <label asp-for="Status" class="form-label">@T["Status"]</label>
    <input asp-for="Status" class="form-control code" />
    <span class="hint">@T["Active, Suspended, Completed or Withdrawn."]</span>
</div>

<div class="mb-3">
    <label asp-for="Reason" class="form-label">@T["Reason"]</label>
    <input asp-for="Reason" class="form-control code" />
    <span class="hint">@T["Why. Kept on the enrollment."]</span>
</div>

<div class="mb-3">
    <label asp-for="OutputName" class="form-label">@T["Output name"]</label>
    <input asp-for="OutputName" class="form-control" />
    <span class="hint">@T["The name the result is saved under in the workflow output. Leave empty for Enrollment."]</span>
</div>
