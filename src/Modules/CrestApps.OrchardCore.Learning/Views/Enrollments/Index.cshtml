@model EnrollmentListViewModel

<zone Name="Title"><breadcrumb name="LearningEnrollments" title="@T["Enrollments"]" /></zone>

<style asp-name="bootstrap-select"></style>
<script asp-name="bootstrap-select" depends-on="bootstrap" at="Foot"></script>

<form asp-action="Index" method="get" id="enrollments-filter">
    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <div class="input-group">
                        <input name="search" value="@Model.Search" class="form-control" placeholder="@T["Find an enrollment number"]" type="search" aria-label="@T["Find an enrollment number"]" />
                        <button type="submit" class="btn btn-outline-secondary" title="@T["Search"]" aria-label="@T["Search"]"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
                    </div>
                </div>
                @if (Model.CanManage)
                {
                    <div class="col-auto"><a asp-action="Create" asp-route-courseId="@Model.CourseId" class="btn btn-secondary create">@T["Enroll a Learner"]</a></div>
                }
            </div>
        </div>
    </div>
</form>

<admin-list name="LearningEnrollments" context="Model.List" show-select-all="false" empty-message="@T["<strong>Nothing here!</strong> No enrollment matches."]">
    <admin-list-list item-css-class="list-group-item" />
    <admin-list-grid>
        <admin-list-column name="Learner" position="20" title="@T["Learner"]" />
        <admin-list-column name="Course" position="30" title="@T["Course"]" width="auto" />
        <admin-list-column name="Status" position="40" title="@T["Status"]" width="auto" />
        <admin-list-column type="Actions" title="@T["Actions"]" />
    </admin-list-grid>
</admin-list>

<script at="Foot">
    document.querySelectorAll('[data-learning-filter]').forEach(select => select.addEventListener('change', () => document.getElementById('enrollments-filter').submit()));
</script>
