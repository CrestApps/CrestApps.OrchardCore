@model EnrollViewModel

<zone Name="Title">
    <breadcrumb name="LearningEnrollmentsCreate" title="@T["Enroll a Learner"]">
        <breadcrumb-item id="LearningEnrollments" action="Index" controller="Enrollments" area="CrestApps.OrchardCore.Learning" permission="@LearningPermissions.ViewEnrollments.Name">@T["Enrollments"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form asp-action="Create" method="post" class="no-multisubmit">
    @Html.ValidationSummary()
    @await DisplayAsync(Model.Editor)
    <div class="action-bar-bottom">
        <button class="btn btn-primary" type="submit">@T["Enroll"]</button>
        <a class="btn btn-secondary cancel" role="button" asp-action="Index">@T["Cancel"]</a>
    </div>
</form>
