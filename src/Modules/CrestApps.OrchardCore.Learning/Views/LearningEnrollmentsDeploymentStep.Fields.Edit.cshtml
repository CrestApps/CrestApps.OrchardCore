@using CrestApps.OrchardCore.Learning.Deployments
@model LearningEnrollmentsDeploymentStepViewModel

<h5>@T["Learning enrollments (learner records)"]</h5>
<p class="hint">@T["Exports enrollments with their progress, naming people by user name. Learner records hold personal data: the export needs the Export learner records permission and is recorded."]</p>
<div class="mb-3">
    <label asp-for="CourseId" class="form-label">@T["Course"]</label>
    <select asp-for="CourseId" asp-items="Model.CourseOptions" class="form-select">
        <option value="">@T["Every course"]</option>
    </select>
</div>
<div class="mb-3">
    <label asp-for="From" class="form-label">@T["Enrolled from"]</label>
    <input asp-for="From" type="datetime-local" class="form-control" />
</div>
<div class="mb-3">
    <label asp-for="To" class="form-label">@T["Enrolled until"]</label>
    <input asp-for="To" type="datetime-local" class="form-control" />
    <span class="hint">@T["In your time zone. Leave both empty for every enrollment."]</span>
</div>
<div class="mb-3 form-check">
    <input asp-for="IncludeProgress" class="form-check-input" />
    <label asp-for="IncludeProgress" class="form-check-label">@T["Include the progress on each course item"]</label>
</div>
