@model CourseLearnerViewModel

@{
    var enrollment = Model.Enrollment;
    var part = Model.Part;
}

<section class="learning-course card my-4" aria-labelledby="learning-course-@Model.CourseId">
    <div class="card-body">
        <h2 class="h5" id="learning-course-@Model.CourseId">@T["Your learning"]</h2>
        <div class="d-flex flex-wrap gap-2 mb-3">
            @if (!string.IsNullOrEmpty(part.Code))
            {
                <span class="badge text-bg-light border">@part.Code</span>
            }
            @if (!string.IsNullOrEmpty(part.Level))
            {
                <span class="badge text-bg-light border">@part.Level</span>
            }
            @if (part.EstimatedMinutes is { } minutes)
            {
                <span class="badge text-bg-light border"><i class="fa-regular fa-clock me-1" aria-hidden="true"></i>@T["About {0} minutes", minutes]</span>
            }
            @foreach (var category in Model.Categories)
            {
                <span class="badge bg-light text-dark border" data-course-category><i class="fa-regular fa-folder me-1" aria-hidden="true"></i>@category</span>
            }
            <partial name="_CourseDates" model="(part.StartsUtc, part.EndsUtc, Model.Schedule)" />
        </div>

        @if (Model.Schedule == CourseSchedule.NotStarted && !Model.IsStaff)
        {
            <p class="small"><i class="fa-solid fa-hourglass-start me-1" aria-hidden="true"></i>@T["The course has not started yet. You can enroll now and open its items once it starts."]</p>
        }

        @if (Model.IsStaff)
        {
            <p>@T["You teach or author this course."] <a href="@Url.RouteUrl("LearningPlayer", new { courseId = Model.CourseId })">@T["Open the player"]</a></p>
        }
        else if (enrollment is null)
        {
            if (!Model.SignedIn)
            {
                <p class="mb-0"><a class="btn btn-primary" href="@Url.Content("~/Login")?ReturnUrl=@Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString)">@T["Sign in to enroll"]</a></p>
            }
            else if (Model.CanSelfEnroll)
            {
                <form method="post" action="@Url.RouteUrl("LearningEnroll", new { courseId = Model.CourseId })" class="row g-2 align-items-end">
                    @Html.AntiForgeryToken()
                    @if (part.EnrollmentMode == EnrollmentMode.Key)
                    {
                        <div class="col-sm-6">
                            <label class="form-label" for="enrollment-key-@Model.CourseId">@T["Enrollment key"]</label>
                            <input class="form-control" id="enrollment-key-@Model.CourseId" name="enrollmentKey" type="password" autocomplete="new-password" data-1p-ignore data-lpignore="true" data-bwignore required />
                        </div>
                    }
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary">@(part.EnrollmentMode == EnrollmentMode.Approval ? T["Ask to enroll"] : T["Enroll"])</button>
                    </div>
                </form>
            }
            else
            {
                <p class="mb-0">@T["Enrollment in this course is arranged by your organization."]</p>
            }
        }
        else if (enrollment.Status == EnrollmentStatus.Pending)
        {
            <p class="mb-0"><i class="fa-solid fa-hourglass-half me-1" aria-hidden="true"></i>@T["Your request to enroll waits for approval."]</p>
        }
        else if (enrollment.Status == EnrollmentStatus.Suspended)
        {
            <p class="mb-0">@T["Your enrollment is paused. Contact the course staff."]</p>
        }
        else if (enrollment.Status == EnrollmentStatus.Completed)
        {
            <partial name="_CourseCompletedPanel" model="(enrollment, Model.CompletionLinks, Model.CourseId, false)" />
        }
        else
        {
            <div class="progress mb-2" role="progressbar" aria-label="@T["Course progress"]" aria-valuenow="@enrollment.ProgressPercent" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar" style="width: @(enrollment.ProgressPercent)%">@(enrollment.ProgressPercent)%</div>
            </div>
            @if (enrollment.DueUtc is { } due)
            {
                <p class="small text-muted">@T["Due"] @await DisplayAsync(await New.DateTime(Utc: DateTime.SpecifyKind(due, DateTimeKind.Utc), Format: "g"))</p>
            }
            <a class="btn btn-primary" href="@Url.RouteUrl("LearningPlayer", new { courseId = Model.CourseId })">@(enrollment.StartedUtc is null ? T["Start the course"] : T["Continue"])</a>
        }
    </div>
</section>

@if (Model.Outline is not null && Model.Outline.Entries.Count > 0)
{
    <section class="learning-outline my-4" aria-label="@T["Course outline"]">
        <h2 class="h5">@T["Course outline"]</h2>
        <partial name="_LearnerOutline" model="new LearnerOutlineViewModel { Outline = Model.Outline, Progress = Model.Progress, KindIcons = Model.KindIcons, KindNames = Model.KindNames, CanOpen = enrollment is not null || Model.IsStaff, LockedItems = Model.LockedItems, Tracked = enrollment is { Status: EnrollmentStatus.Active or EnrollmentStatus.Completed } }" />
    </section>
}
