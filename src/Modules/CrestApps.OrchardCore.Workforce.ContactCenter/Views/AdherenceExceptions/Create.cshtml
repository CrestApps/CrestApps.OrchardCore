@model AdherenceExceptionEditViewModel

<zone Name="Title"><breadcrumb name="WorkforceAdherenceExceptionsAdd" title="@T["Add an Adherence Exception"]" /></zone>

<form asp-action="Create" method="post" class="no-multisubmit">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="ReturnUrl" />
    @await DisplayAsync(Model.Editor)
    <div class="action-bar-bottom">
        <button type="submit" class="btn btn-primary save">@T["Add"]</button>
        <a href="@(string.IsNullOrEmpty(Model.ReturnUrl) ? Url.Action("Index") : Model.ReturnUrl)" class="btn btn-secondary cancel">@T["Cancel"]</a>
    </div>
</form>
