@model AdherenceExceptionListViewModel

<zone Name="Title"><breadcrumb name="WorkforceAdherenceExceptions" title="@T["Adherence Exceptions"]" /></zone>

<form asp-action="Index" method="get" id="adherence-exceptions-filter"></form>

<div class="card text-bg-theme mb-3 position-sticky action-bar">
    <div class="card-body">
        <div class="row gx-2 gy-2 align-items-center">
            <div class="col">
                <p class="mb-0 text-muted small">@T["Stretches of a worker's schedule left out of their adherence, such as coaching or a system outage."]</p>
            </div>
            @if (Model.CanManage)
            {
                <div class="col-auto"><a asp-action="Create" class="btn btn-secondary create">@T["Add exception"]</a></div>
            }
        </div>
    </div>
</div>

@{
    Model.List.ToolbarActions = await New.AdherenceExceptionsFilter(ViewModel: Model, FormId: "adherence-exceptions-filter");
}

<admin-list name="WorkforceAdherenceExceptions" context="Model.List" show-select-all="false" empty-message="@T["<strong>Nothing here!</strong> There are no exceptions."]">
    <admin-list-list item-css-class="list-group-item" />
    <admin-list-grid>
        <admin-list-column name="Name" position="20" title="@T["Exception"]" />
        <admin-list-column name="Details" position="30" title="@T["Details"]" width="auto" />
        <admin-list-column type="Actions" title="@T["Actions"]" />
    </admin-list-grid>
</admin-list>
