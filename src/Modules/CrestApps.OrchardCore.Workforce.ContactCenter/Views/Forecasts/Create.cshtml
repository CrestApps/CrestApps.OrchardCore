@model ForecastCreateViewModel

<zone Name="Title"><breadcrumb name="WorkforceForecastsCreate" title="@T["Make a Forecast"]" /></zone>

<form asp-action="Create" method="post" class="no-multisubmit">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="card text-bg-theme mb-3">
        <div class="card-header">@T["Details"]</div>
        <div class="card-body">
            <div class="ocat-wrapper">
                <label asp-for="PlanningGroupId" class="ocat-label">@T["Planning group"]</label>
                <div class="ocat-end">
                    <select asp-for="PlanningGroupId" asp-items="Model.PlanningGroupOptions" class="form-select" required>
                        <option value="">@T["Choose a planning group"]</option>
                    </select>
                </div>
            </div>
            <div class="ocat-wrapper">
                <label asp-for="FromDate" class="ocat-label">@T["First day"]</label>
                <div class="ocat-end">
                    <input asp-for="FromDate" type="date" class="form-control" style="max-width: 12rem" />
                </div>
            </div>
            <div class="ocat-wrapper">
                <label asp-for="Weeks" class="ocat-label">@T["Weeks"]</label>
                <div class="ocat-end">
                    <input asp-for="Weeks" type="number" min="1" max="13" class="form-control" style="max-width: 12rem" />
                </div>
            </div>
            <div class="ocat-wrapper">
                <label asp-for="Model" class="ocat-label">@T["Model"]</label>
                <div class="ocat-end">
                    <select asp-for="Model" class="form-select">
                        <option value="@ForecastModelKind.Auto">@T["The best on the last two weeks"]</option>
                        <option value="@ForecastModelKind.WeightedHistory">@T["Weighted history"]</option>
                        <option value="@ForecastModelKind.HoltWinters">@T["Holt-Winters"]</option>
                    </select>
                </div>
            </div>
            <span class="hint d-block mb-3">@T["The forecast reads the planning group's interval statistics before the first day. Weighted history repeats the same weekday of the last weeks, the latest weighing most; Holt-Winters follows a trend and the weekly pattern."]</span>
        </div>
    </div>
    <div class="action-bar-bottom">
        <button type="submit" class="btn btn-primary save">@T["Make forecast"]</button>
        <a asp-action="Index" class="btn btn-secondary">@T["Cancel"]</a>
    </div>
</form>
