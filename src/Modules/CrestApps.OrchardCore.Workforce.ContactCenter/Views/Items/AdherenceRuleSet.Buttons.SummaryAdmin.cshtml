@model ShapeViewModel<AdherenceRuleSet>

<a asp-controller="AdherenceRuleSets" asp-action="Edit" asp-route-id="@Model.Value.ItemId" class="btn btn-primary btn-sm">@T["Edit"]</a>
<a asp-controller="AdherenceRuleSets" asp-action="Delete" asp-route-id="@Model.Value.ItemId" class="btn btn-danger btn-sm" data-title="@T["Delete"]" data-message="@T["Delete this rule set? Its teams use the default rules until they get another one."]" data-url-af="RemoveUrl UnsafeUrl">@T["Delete"]</a>
