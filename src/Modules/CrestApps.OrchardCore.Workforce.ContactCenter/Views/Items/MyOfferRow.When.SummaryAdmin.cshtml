@model ShapeViewModel<MyOfferRow>

@{
    var row = Model.Value;
    var offer = row.Offer;

    // In the worker's own time zone: the offer changes their shift, which they read in that zone.
    var local = CalendarTime.ToLocal(offer.StartUtc, row.TimeZoneId);
    string Clock(DateTime utc) => CalendarTime.ToLocal(utc, row.TimeZoneId).ToString("t", CultureInfo.CurrentCulture);
}

<span class="badge ta-badge fw-normal text-nowrap" title="@T["When"]"><i class="fa-regular fa-calendar text-info" aria-hidden="true"></i> @local.ToString("ddd d MMM", CultureInfo.CurrentCulture), @Clock(offer.StartUtc)–@Clock(offer.EndUtc)</span>
