@model AdherenceRuleSetEditViewModel

<div class="ocat-wrapper">
    <label asp-for="Name" class="ocat-label ocat-label-required">@T["Name"]</label>
    <div class="ocat-end">
        <input asp-for="Name" class="form-control" required />
    </div>
</div>
<div class="ocat-wrapper">
    <label asp-for="TeamIds" class="ocat-label">@T["Teams"]</label>
    <div class="ocat-end">
        <select asp-for="TeamIds" asp-items="Model.TeamOptions" class="selectpicker show-tick" multiple data-live-search="true" data-actions-box="true" data-width="100%" data-selected-text-format="count > 3"></select>
        <span class="hint">@T["Their sub-teams use it too, unless they have their own."]</span>
    </div>
</div>
<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <span class="hint">@T["For each scheduled activity, the agent states that are in adherence. Grace lets an agent finish one activity late or start the next early; a slip shorter than the minimum is forgiven."]</span>
    </div>
</div>
