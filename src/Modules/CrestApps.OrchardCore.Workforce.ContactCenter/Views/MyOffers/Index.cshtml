@model MyOffersViewModel
<zone Name="Title">
    <breadcrumb name="MyWorkOffers" title="@T["Offers"]">
        <breadcrumb-item id="MyWork" action="Index" controller="MyWork" area="CrestApps.OrchardCore.Workforce">@T["My Work"]</breadcrumb-item>
    </breadcrumb>
</zone>
<partial name="~/Areas/CrestApps.OrchardCore.Workforce/Views/Shared/_MyWorkAssets.cshtml" />

<p class="text-muted">@T["Extra hours and time off your team offers today and in the coming days, first come, first served. Overtime is added to a shift that ends when it starts, or starts when it ends; time off comes off the start or the end of a shift."]</p>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="@(Model.IsError ? "message-error" : "message-success") mb-3" role="status">@Model.Message</div>
}

@* The offers, their count and the layout selector are rendered by the AdminList shape, in the layout (List or Grid)
   the site or the user picked. Each row's "Take it" button posts its own form. *@
<admin-list name="WorkforceMyOffers" context="Model.List" show-select-all="false"
            empty-message="@T["There are no offers for you right now."]">
    <admin-list-list item-css-class="list-group-item" />
    <admin-list-grid>
        <admin-list-column name="Name" position="20" title="@T["Offer"]" />
        <admin-list-column name="When" position="30" title="@T["When"]" width="auto" no-wrap="true" />
        <admin-list-column name="Places" position="40" title="@T["Places"]" width="auto" />
        <admin-list-column type="Actions" title="@T["Actions"]" />
    </admin-list-grid>
</admin-list>
