@model CrestApps.OrchardCore.Workforce.ContactCenter.Controllers.MyAdherenceViewModel
<zone Name="Title">
    <breadcrumb name="MyWorkAdherence" title="@T["Adherence"]">
        <breadcrumb-item id="MyWork" action="Index" controller="MyWork" area="CrestApps.OrchardCore.Workforce">@T["My Work"]</breadcrumb-item>
    </breadcrumb>
</zone>
<partial name="~/Areas/CrestApps.OrchardCore.Workforce/Views/Shared/_MyWorkAssets.cshtml" />

<p class="text-muted">@T["How closely you kept to your schedule on your latest days: adherence is the share of your scheduled time you were in the state the schedule asked for, not counting approved exceptions; conformance is the time you worked against the time you were scheduled to work."]</p>

@* The days, their count and the layout selector are rendered by the AdminList shape, in the layout (List or Grid) the
   site or the user picked. *@
<admin-list name="WorkforceMyAdherence" context="Model.List" show-select-all="false"
            empty-message="@T["No days have been saved for you yet."]">
    <admin-list-list item-css-class="list-group-item" />
    <admin-list-grid>
        <admin-list-column name="Name" position="20" title="@T["Day"]" />
        <admin-list-column name="Adherence" position="30" title="@T["Adherence"]" width="auto" />
        <admin-list-column name="Conformance" position="40" title="@T["Conformance"]" width="auto" />
        <admin-list-column name="OutOfAdherence" position="50" title="@T["Out of adherence"]" width="auto" />
    </admin-list-grid>
</admin-list>
