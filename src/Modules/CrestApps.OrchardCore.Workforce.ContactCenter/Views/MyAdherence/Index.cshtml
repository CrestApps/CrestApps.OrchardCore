@model CrestApps.OrchardCore.Workforce.ContactCenter.Controllers.MyAdherenceViewModel
@{
    Layout = null;
    ViewData["MyWorkNav"] = Model.Nav;
    ViewData["Title"] = T["Adherence"].Value;
    string Percent(double? share) => share is { } value ? value.ToString("P0", CultureInfo.CurrentCulture) : "–";
}
<partial name="~/Areas/CrestApps.OrchardCore.Workforce/Views/Shared/_MyWorkHead.cshtml" />

<h1 class="h4 mb-3">@T["Adherence"]</h1>
<p class="text-muted">@T["How closely you kept to your schedule on your latest days: adherence is the share of your scheduled time you were in the state the schedule asked for, not counting approved exceptions; conformance is the time you worked against the time you were scheduled to work."]</p>

@if (Model.Days.Count == 0)
{
    <div class="alert alert-info">@T["No days have been saved for you yet."]</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th scope="col">@T["Day"]</th>
                    <th scope="col" class="text-end">@T["Adherence"]</th>
                    <th scope="col" class="text-end">@T["Conformance"]</th>
                    <th scope="col" class="text-end">@T["Out of adherence"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var day in Model.Days)
                {
                    var outMinutes = Math.Max(0, Math.Round((day.ScheduledSeconds - day.ExceptionSeconds - day.InAdherenceSeconds) / 60));
                    <tr>
                        <td>@day.Date.ToString("ddd d MMM", CultureInfo.CurrentCulture)</td>
                        <td class="text-end"><span class="badge @(day.Adherence is >= 0.9 ? "text-bg-success" : day.Adherence is >= 0.8 ? "text-bg-warning" : "text-bg-danger")">@Percent(day.Adherence)</span></td>
                        <td class="text-end">@Percent(day.Conformance)</td>
                        <td class="text-end">@T["{0} min", outMinutes]</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
