@model ForecastEventEditViewModel

<style asp-name="bootstrap-select"></style>
<script asp-name="bootstrap-select" depends-on="bootstrap" at="Foot"></script>
<zone Name="Title"><breadcrumb name="WorkforceForecastEventsEdit" title="@(string.IsNullOrEmpty(Model.Id) ? T["Add a Forecast Event"] : T["Edit {0}", Model.Name])" /></zone>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="no-multisubmit">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <div class="card text-bg-theme mb-3">
        <div class="card-header">@T["Details"]</div>
        <div class="card-body">
            <div class="ocat-wrapper">
                <label asp-for="Name" class="ocat-label">@T["Name"]</label>
                <div class="ocat-end">
                    <input asp-for="Name" class="form-control" required />
                </div>
            </div>
            <div class="ocat-wrapper">
                <label asp-for="Kind" class="ocat-label">@T["Kind"]</label>
                <div class="ocat-end">
                    <select asp-for="Kind" class="form-select">
                        <option value="@ForecastEventKind.Holiday">@T["Holiday"]</option>
                        <option value="@ForecastEventKind.Closure">@T["Closure"]</option>
                        <option value="@ForecastEventKind.Promotion">@T["Promotion"]</option>
                        <option value="@ForecastEventKind.Outage">@T["Outage"]</option>
                        <option value="@ForecastEventKind.Custom">@T["Other"]</option>
                    </select>
                </div>
            </div>
            <div class="ocat-wrapper">
                <label asp-for="StartDate" class="ocat-label">@T["First day"]</label>
                <div class="ocat-end">
                    <input asp-for="StartDate" type="date" class="form-control" style="max-width: 12rem" />
                </div>
            </div>
            <div class="ocat-wrapper">
                <label asp-for="EndDate" class="ocat-label">@T["Last day"]</label>
                <div class="ocat-end">
                    <input asp-for="EndDate" type="date" class="form-control" style="max-width: 12rem" />
                </div>
            </div>
            <div class="ocat-wrapper">
                <label asp-for="ChangePercent" class="ocat-label">@T["Change in work %"]</label>
                <div class="ocat-end">
                    <input asp-for="ChangePercent" type="number" min="-100" step="any" class="form-control" style="max-width: 12rem" />
                </div>
            </div>
            <span class="hint d-block mb-3">@T["-100 for no work at all, such as a closure; 50 for half as much again."]</span>
            <div class="mb-3 form-check">
                <input asp-for="RecursYearly" class="form-check-input" />
                <label asp-for="RecursYearly" class="form-check-label">@T["Every year on the same dates"]</label>
            </div>
            <div class="ocat-wrapper">
                <label asp-for="PlanningGroupIds" class="ocat-label">@T["Planning groups"]</label>
                <div class="ocat-end">
                    <select asp-for="PlanningGroupIds" asp-items="Model.PlanningGroupOptions" class="selectpicker show-tick" multiple data-live-search="true" data-actions-box="true" data-width="100%" data-selected-text-format="count > 3"></select>
                    <span class="hint">@T["Choose none for every planning group."]</span>
                </div>
            </div>
        </div>
    </div>
    <div class="action-bar-bottom">
        <button type="submit" class="btn btn-primary save">@T["Save"]</button>
        <a asp-action="Index" class="btn btn-secondary">@T["Cancel"]</a>
    </div>
</form>
