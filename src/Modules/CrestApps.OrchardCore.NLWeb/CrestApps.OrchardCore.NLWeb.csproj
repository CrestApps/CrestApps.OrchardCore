<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <Title>CrestApps OrchardCore NLWeb Module</Title>
    <Description>
      $(CrestAppsDescription)

      Answers natural language questions about the site with the NLWeb protocol: the /ask and /await endpoints (JSON
      and server-sent events), results described as schema.org objects, keyword search through Orchard Core's search
      providers, and, when AI is enabled, query rewriting, ranking, summaries, answers, vector search and an ask tool
      for MCP clients and AI agents.
    </Description>
    <PackageTags>$(PackageTags) OrchardCoreCMS NLWeb SchemaOrg Search AI Agents MCP</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OrchardCore.Module.Targets" />
    <PackageReference Include="OrchardCore.Admin.Abstractions" />
    <PackageReference Include="OrchardCore.ContentManagement" />
    <PackageReference Include="OrchardCore.ContentTypes.Abstractions" />
    <PackageReference Include="OrchardCore.Contents.Core" />
    <PackageReference Include="OrchardCore.DisplayManagement" />
    <PackageReference Include="OrchardCore.Indexing.Abstractions" />
    <PackageReference Include="OrchardCore.Indexing.Core" />
    <PackageReference Include="OrchardCore.Navigation.Core" />
    <PackageReference Include="OrchardCore.RateLimits.Core" />
    <PackageReference Include="OrchardCore.Search.Abstractions" />
    <PackageReference Include="OrchardCore.Settings.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Abstractions/CrestApps.OrchardCore.Abstractions/CrestApps.OrchardCore.Abstractions.csproj" />
    <ProjectReference Include="../../Abstractions/CrestApps.OrchardCore.Seo.Abstractions/CrestApps.OrchardCore.Seo.Abstractions.csproj" />
    <ProjectReference Include="../../Core/CrestApps.OrchardCore.NLWeb.Core/CrestApps.OrchardCore.NLWeb.Core.csproj" />
    <ProjectReference Include="../../Core/CrestApps.OrchardCore.AI.Core/CrestApps.OrchardCore.AI.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Reference the module this one depends on directly, so installing this package brings the feature it needs and the
      feature dependency resolves.
    -->
    <ProjectReference Include="../CrestApps.OrchardCore.Seo/CrestApps.OrchardCore.Seo.csproj" PrivateAssets="none" />
  </ItemGroup>

</Project>
