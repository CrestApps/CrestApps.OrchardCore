@model TimeOffTypeEditViewModel

<zone Name="Title">
    <breadcrumb name="WorkforceTimeOffTypesEdit" title="@(string.IsNullOrEmpty(Model.Id) ? T["New Time-Off Type"] : T["Edit '{0}' Time-Off Type", Model.Name])">
        <breadcrumb-item id="WorkforceTimeOffTypes" action="Index" controller="TimeOffTypes" area="CrestApps.OrchardCore.Workforce">@T["Time-Off Types"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form method="post" asp-action="Edit" asp-route-id="@Model.Id" class="no-multisubmit">
    <input type="hidden" asp-for="Id" />
    @Html.ValidationSummary()
    <div class="card text-bg-theme mb-3"><div class="card-body">
        <div class="ocat-wrapper"><label asp-for="Name" class="ocat-label ocat-label-required">@T["Name"]</label><div class="ocat-end"><input asp-for="Name" class="form-control" /></div></div>
        <div class="ocat-wrapper"><label asp-for="Description" class="ocat-label">@T["Description"]</label><div class="ocat-end"><textarea asp-for="Description" class="form-control" rows="2"></textarea><span class="hint">@T["Shown to workers when they choose a type."]</span></div></div>
        <div class="ocat-wrapper">
            <label asp-for="Unit" class="ocat-label">@T["Counted in"]</label>
            <div class="ocat-end">
                <select asp-for="Unit" class="form-select" style="max-width: 12rem">
                    <option value="Hours">@T["Hours"]</option>
                    <option value="Days">@T["Days"]</option>
                </select>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="HoursPerDay" class="ocat-label ocat-label-required">@T["Hours in a day"]</label>
            <div class="ocat-end">
                <input asp-for="HoursPerDay" type="number" step="0.25" min="0.25" max="24" class="form-control" style="max-width: 8rem" />
                <span class="hint">@T["What a weekday counts when the worker has no shift that day. A day with shifts counts their paid time."]</span>
            </div>
        </div>
        <div class="ocat-wrapper"><label asp-for="Color" class="ocat-label">@T["Color"]</label><div class="ocat-end"><input asp-for="Color" type="color" class="form-control form-control-color" /></div></div>
        <div class="ocat-wrapper"><label asp-for="PayCode" class="ocat-label">@T["Pay code"]</label><div class="ocat-end"><input asp-for="PayCode" class="form-control" style="max-width: 12rem" /><span class="hint">@T["Optional. The code payroll pays this time off under."]</span></div></div>
        <div class="ocat-wrapper"><div class="ocat-end-offset"><div class="form-check"><input asp-for="IsPaid" class="form-check-input" /><label asp-for="IsPaid" class="form-check-label">@T["Paid"]</label><span class="hint dashed">@T["Paid time off is counted as paid hours."]</span></div></div></div>
        <div class="ocat-wrapper"><div class="ocat-end-offset"><div class="form-check"><input asp-for="RequiresBalance" class="form-check-input" /><label asp-for="RequiresBalance" class="form-check-label">@T["Needs a balance"]</label><span class="hint dashed">@T["A request is refused when the worker's policy for this type doesn't have enough."]</span></div></div></div>
        <div class="ocat-wrapper"><div class="ocat-end-offset"><div class="form-check"><input asp-for="AllowPartialDay" class="form-check-input" /><label asp-for="AllowPartialDay" class="form-check-label">@T["Part of a day can be requested"]</label><span class="hint dashed">@T["Workers can ask for some hours of one day."]</span></div></div></div>
        <div class="ocat-wrapper"><div class="ocat-end-offset"><div class="form-check"><input asp-for="RequiresReason" class="form-check-input" /><label asp-for="RequiresReason" class="form-check-label">@T["Needs a reason"]</label><span class="hint dashed">@T["A request must say why."]</span></div></div></div>
        <div class="ocat-wrapper"><div class="ocat-end-offset"><div class="form-check"><input asp-for="CountsAgainstAllotment" class="form-check-input" /><label asp-for="CountsAgainstAllotment" class="form-check-label">@T["Takes a place in allotments"]</label><span class="hint dashed">@T["Turn off for time off that is never limited, such as jury duty."]</span></div></div></div>
        <div class="ocat-wrapper"><div class="ocat-end-offset"><div class="form-check"><input asp-for="VisibleToWorkers" class="form-check-input" /><label asp-for="VisibleToWorkers" class="form-check-label">@T["Workers can request it"]</label><span class="hint dashed">@T["Turn off for a type only managers record."]</span></div></div></div>
        <div class="ocat-wrapper"><div class="ocat-end-offset"><div class="form-check"><input asp-for="Enabled" class="form-check-input" /><label asp-for="Enabled" class="form-check-label">@T["In use"]</label></div></div></div>
    </div></div>
    <div class="ocat-wrapper"><div class="ocat-end-offset"><button class="btn btn-primary" type="submit">@T["Save"]</button> <a class="btn btn-secondary cancel" asp-action="Index">@T["Cancel"]</a></div></div>
</form>
