@model ScheduleCreateViewModel

<zone Name="Title">
    <breadcrumb name="WorkforceSchedulesCreate" title="@T["Start a Schedule"]">
        <breadcrumb-item id="WorkforceSchedules" action="Index" controller="Schedules" area="CrestApps.OrchardCore.Workforce">@T["Shift Schedules"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form method="post" asp-action="Create" class="no-multisubmit">
    @Html.ValidationSummary()
    @await DisplayAsync(Model.Editor)
    <div class="action-bar-bottom">
        <button class="btn btn-primary" type="submit">@T["Start"]</button>
        <a class="btn btn-secondary cancel" asp-action="Index">@T["Cancel"]</a>
    </div>
</form>
