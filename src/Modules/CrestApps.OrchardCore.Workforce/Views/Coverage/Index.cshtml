@model WorkforceListViewModel

<zone Name="Title"><breadcrumb name="WorkforceCoverage" title="@T["Coverage"]" /></zone>

<form asp-action="Index" method="get" id="coverage-filter">
    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <p class="mb-0 text-muted small">@T["How many people a team needs, by weekday or date and time of day. The planner board shows where a schedule falls short."]</p>
                </div>
                @if (!string.IsNullOrEmpty(Model.TeamId))
                {
                    <div class="col-auto"><a asp-action="Edit" asp-route-teamId="@Model.TeamId" class="btn btn-secondary create">@T["Add requirement"]</a></div>
                }
            </div>
        </div>
    </div>
</form>

@{
    Model.List.ToolbarActions = await New.WorkforceTeamFilter(ViewModel: Model, FormId: "coverage-filter", AllowAll: false);
}

<admin-list name="WorkforceCoverage" context="Model.List" show-select-all="false" empty-message="@T["<strong>Nothing here!</strong> The team has no coverage requirements."]">
    <admin-list-list item-css-class="list-group-item" />
    <admin-list-grid>
        <admin-list-column name="Name" position="20" title="@T["Requirement"]" />
        <admin-list-column name="Details" position="30" title="@T["Details"]" width="auto" />
        <admin-list-column type="Actions" title="@T["Actions"]" />
    </admin-list-grid>
</admin-list>
