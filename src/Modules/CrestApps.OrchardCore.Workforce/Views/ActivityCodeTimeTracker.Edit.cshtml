@model ActivityCodeEditViewModel

<div class="ocat-wrapper"><label asp-for="StageId" class="ocat-label">@T["Stage"]</label><div class="ocat-end"><select asp-for="StageId" asp-items="Model.StageOptions" class="form-select" style="max-width: 24rem"></select><span class="hint">@T["Time clocked in this activity is kept in this stage, and counts toward its categories in Time Tracker's reports. A meal or a break is kept in the stage of the first meal or break code."]</span></div></div>
