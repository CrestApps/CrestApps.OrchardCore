@model WorkforceListViewModel

<zone Name="Title"><breadcrumb name="Rotations" title="@T["Rotations"]" /></zone>

<form asp-action="Index" method="get" id="rotations-filter">
    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <p class="mb-0 text-muted small">@T["Repeating weekly patterns of shift templates. Apply them to a schedule to fill it for everyone who follows one."]</p>
                </div>
                <div class="col-auto"><a asp-action="Edit" asp-route-teamId="@Model.TeamId" class="btn btn-secondary create">@T["Add rotation"]</a></div>
            </div>
        </div>
    </div>
</form>

@{
    Model.List.ToolbarActions = await New.WorkforceTeamFilter(ViewModel: Model, FormId: "rotations-filter");
}

<admin-list name="Rotations" context="Model.List" show-select-all="false" empty-message="@T["<strong>Nothing here!</strong> There are no rotations."]">
    <admin-list-list item-css-class="list-group-item" />
    <admin-list-grid>
        <admin-list-column name="Name" position="20" title="@T["Rotation"]" />
        <admin-list-column name="Details" position="30" title="@T["Details"]" width="auto" />
        <admin-list-column type="Actions" title="@T["Actions"]" />
    </admin-list-grid>
</admin-list>
