@model TimeClockPolicyEditViewModel

<div class="ocat-wrapper"><label asp-for="WeeklyOvertimeHours" class="ocat-label">@T["Overtime after"]</label><div class="ocat-end"><div class="input-group" style="max-width: 16rem"><input asp-for="WeeklyOvertimeHours" type="number" step="0.25" min="0" max="168" class="form-control" style="max-width: 12rem" /><span class="input-group-text">@T["hours a week"]</span></div><span class="hint">@T["Hours in a pay period&#39;s week. Leave empty for no weekly overtime."]</span></div></div>
<div class="ocat-wrapper"><label asp-for="DailyOvertimeHours" class="ocat-label">@T["Daily overtime after"]</label><div class="ocat-end"><div class="input-group" style="max-width: 16rem"><input asp-for="DailyOvertimeHours" type="number" step="0.25" min="0" max="24" class="form-control" style="max-width: 12rem" /><span class="input-group-text">@T["hours a day"]</span></div><span class="hint">@T["Optional."]</span></div></div>
<div class="ocat-wrapper"><label asp-for="DailyDoubleTimeHours" class="ocat-label">@T["Double time after"]</label><div class="ocat-end"><div class="input-group" style="max-width: 16rem"><input asp-for="DailyDoubleTimeHours" type="number" step="0.25" min="0" max="24" class="form-control" style="max-width: 12rem" /><span class="input-group-text">@T["hours a day"]</span></div><span class="hint">@T["Optional. More than the daily overtime."]</span></div></div>
<div class="ocat-wrapper">
    <div class="ocat-end">
        <div class="form-check">
            <input asp-for="SeventhDayOvertime" class="form-check-input" type="checkbox" />
            <label asp-for="SeventhDayOvertime" class="form-check-label">@T["Seventh day in a row is overtime"]</label>
            <span class="hint dashed">@T["When all seven days of a week are worked, the seventh day's first eight hours are overtime and the rest double time."]</span>
        </div>
    </div>
</div>
<div class="ocat-wrapper"><div class="ocat-end-offset"><span class="hint">@T["Overtime counts regular hours only, so hours already paid as daily overtime don't count toward the weekly overtime."]</span></div></div>
