@model TimeOffAllotmentEditViewModel

<div class="ocat-wrapper"><label asp-for="Name" class="ocat-label ocat-label-required">@T["Name"]</label><div class="ocat-end"><input asp-for="Name" class="form-control" /></div></div>
<div class="ocat-wrapper"><label asp-for="TeamId" class="ocat-label ocat-label-required">@T["Team"]</label><div class="ocat-end"><select asp-for="TeamId" asp-items="Model.TeamOptions" class="form-select" style="max-width: 24rem"><option value="">@T["Choose a team"]</option></select><span class="hint">@T["The allotment counts the time off of this team and the teams under it."]</span></div></div>
<div class="ocat-wrapper">
    <label asp-for="TypeIds" class="ocat-label">@T["Time-off types"]</label>
    <div class="ocat-end">
        <select asp-for="TypeIds" asp-items="Model.TypeOptions" class="selectpicker show-tick" multiple data-live-search="true" data-actions-box="true" data-width="100%" data-selected-text-format="count > 3"></select>
        <span class="hint">@T["Leave empty for every type that takes a place in allotments."]</span>
    </div>
</div>
<div class="ocat-wrapper"><div class="ocat-end-offset"><div class="form-check"><input asp-for="Enabled" class="form-check-input" /><label asp-for="Enabled" class="form-check-label">@T["In use"]</label></div></div></div>
