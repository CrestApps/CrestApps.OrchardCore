@model PayrollExportViewModel

<zone Name="Title"><breadcrumb name="WorkforcePayrollExport" title="@T["Past Payroll Exports"]" /></zone>

<div class="alert alert-info">
    @T["Locked timesheets are exported by a data pipeline over the Pay inputs data set: it writes the file, delivers it and marks the hours exported once it succeeds."]
    <a asp-area="OrchardCore.DataPipelines" asp-controller="Admin" asp-action="Index">@T["Open Data Pipelines"]</a>
    <div class="small mt-1">@T["No pipeline yet? Run the Payroll: export pay inputs to a CSV file recipe under Configuration > Recipes, then publish the pipeline it adds. The files below were written before and stay to download."]</div>
</div>

<admin-list name="WorkforcePayrollExports" context="Model.List" show-select-all="false" empty-message="@T["<strong>Nothing here!</strong> No file was written by the earlier export."]">
    <admin-list-list item-css-class="list-group-item" />
    <admin-list-grid>
        <admin-list-column name="Name" position="20" title="@T["File"]" />
        <admin-list-column name="Details" position="30" title="@T["Details"]" width="auto" />
        <admin-list-column type="Actions" title="@T["Actions"]" />
    </admin-list-grid>
</admin-list>
