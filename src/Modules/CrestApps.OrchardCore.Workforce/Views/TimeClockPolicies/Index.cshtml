@model WorkforceListViewModel

<zone Name="Title"><breadcrumb name="WorkforceTimeClockPolicies" title="@T["Time Clock Policies"]" /></zone>

<div class="card text-bg-theme mb-3 position-sticky action-bar">
    <div class="card-body">
        <div class="row gx-2">
            <div class="col">
                <p class="mb-0 text-muted small">@T["How teams clock time and how it is paid: rounding, grace, meals, where workers may punch from, overtime and attendance points. A team uses its own policy or its parent team&#39;s."]</p>
            </div>
            <div class="col-auto"><a asp-action="Edit" class="btn btn-secondary create">@T["Add policy"]</a></div>
        </div>
    </div>
</div>

<admin-list name="WorkforceTimeClockPolicies" context="Model.List" show-select-all="false" empty-message="@T["<strong>Nothing here!</strong> There are none yet."]">
    <admin-list-list item-css-class="list-group-item" />
    <admin-list-grid>
        <admin-list-column name="Name" position="20" title="@T["Policy"]" />
        <admin-list-column name="Details" position="30" title="@T["Details"]" width="auto" />
        <admin-list-column type="Actions" title="@T["Actions"]" />
    </admin-list-grid>
</admin-list>
