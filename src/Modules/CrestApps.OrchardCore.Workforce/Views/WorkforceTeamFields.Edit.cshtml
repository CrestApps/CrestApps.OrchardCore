@model WorkforceTeamEditViewModel

<div class="card text-bg-theme mb-3">
    <div class="card-header">@T["Workforce"]</div>
    <div class="card-body">
        <div class="ocat-wrapper"><label asp-for="Address" class="ocat-label">@T["Address"]</label><div class="ocat-end"><input asp-for="Address" class="form-control" /><span class="hint">@T["Where the team works, for a site."]</span></div></div>
        @if (Model.ShowTimeClock)
        {
            <div class="ocat-wrapper">
                <label asp-for="Latitude" class="ocat-label">@T["Site coordinates"]</label>
                <div class="ocat-end">
                    <div class="d-flex flex-wrap gap-2">
                        <input asp-for="Latitude" type="number" step="0.000001" min="-90" max="90" class="form-control" style="max-width: 12rem" placeholder="@T["Latitude"]" aria-label="@T["Latitude"]" />
                        <input asp-for="Longitude" type="number" step="0.000001" min="-180" max="180" class="form-control" style="max-width: 12rem" placeholder="@T["Longitude"]" aria-label="@T["Longitude"]" />
                    </div>
                    <span class="hint">@T["Optional. Where workers must be to clock in when their time clock policy asks for the work site. Sub-teams use their parent's."]</span>
                    <span asp-validation-for="Latitude" class="text-danger"></span>
                </div>
            </div>
            <div class="ocat-wrapper">
                <label asp-for="TimeClockPolicyId" class="ocat-label">@T["Time clock policy"]</label>
                <div class="ocat-end">
                    <select asp-for="TimeClockPolicyId" asp-items="Model.TimeClockPolicyOptions" class="form-select" style="max-width: 22rem"><option value="">@T["As the parent team"]</option></select>
                    <span class="hint">@T["How the team's time is clocked and paid. A team with none, and no parent with one, doesn't clock time."]</span>
                </div>
            </div>
        }
        @if (Model.ShowShiftPlanning)
        {
            <h5 class="mt-3">@T["Shift planning"]</h5>
            <div class="ocat-wrapper">
                <label asp-for="OpenShiftClaimPolicy" class="ocat-label">@T["Open shifts go to"]</label>
                <div class="ocat-end">
                    <select asp-for="OpenShiftClaimPolicy" class="form-select" style="max-width: 22rem">
                        <option value="">@T["As the parent team (a manager approves)"]</option>
                        <option value="ManagerApproves">@T["Whoever a manager approves"]</option>
                        <option value="FirstCome">@T["The first eligible worker to claim"]</option>
                        <option value="BySeniority">@T["The most senior claimant, after a day"]</option>
                    </select>
                    <span class="hint">@T["How the team's open shifts are given to the workers who claim them."]</span>
                </div>
            </div>
            <div class="ocat-wrapper">
                <label asp-for="ShiftTradesNeedApproval" class="ocat-label">@T["Shift trades"]</label>
                <div class="ocat-end">
                    <select asp-for="ShiftTradesNeedApproval" class="form-select" style="max-width: 22rem">
                        <option value="">@T["As the parent team (a manager approves)"]</option>
                        <option value="true">@T["A manager approves them"]</option>
                        <option value="false">@T["They apply when the colleague accepts"]</option>
                    </select>
                </div>
            </div>
            @if (Model.ShowTimeOff)
            {
                <div class="ocat-wrapper">
                    <label asp-for="TimeOffShiftHandling" class="ocat-label">@T["Shifts under approved time off"]</label>
                    <div class="ocat-end">
                        <select asp-for="TimeOffShiftHandling" class="form-select" style="max-width: 22rem">
                            <option value="">@T["As the parent team (flag them)"]</option>
                            <option value="Flag">@T["Keep them, flagged for cover"]</option>
                            <option value="Remove">@T["Take them off the schedule"]</option>
                        </select>
                        <span class="hint">@T["What happens to a worker's published shifts when time off over them is approved. Removed shifts are logged as the worker's change."]</span>
                    </div>
                </div>
            }
        }
    </div>
</div>
