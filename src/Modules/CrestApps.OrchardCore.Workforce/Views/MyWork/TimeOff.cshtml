@model MyTimeOffViewModel
@{
    var preview = Model.Preview;
}
<zone Name="Title">
    <breadcrumb name="MyWorkTimeOff" title="@T["Time off"]">
        <breadcrumb-item id="MyWork" action="Index" controller="MyWork" area="CrestApps.OrchardCore.Workforce">@T["My Work"]</breadcrumb-item>
    </breadcrumb>
</zone>
<partial name="~/Areas/CrestApps.OrchardCore.Workforce/Views/Shared/_MyWorkAssets.cshtml" />


<div class="row g-3 mb-3">
    @foreach (var balance in Model.Balances)
    {
        var unit = balance.Type?.Unit ?? TimeOffUnit.Hours;
        <div class="col-sm-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h6 text-muted">@(balance.Type?.Name ?? balance.Policy.Name)</h2>
                    <p class="fs-4 mb-0"><partial name="_TimeOffAmount" model="(balance.Available, unit)" /></p>
                    <p class="small text-muted mb-0">@T["available"]@if (balance.Upcoming + balance.Pending > 0) {<text> · </text><partial name="_TimeOffAmount" model="(balance.Upcoming + balance.Pending, unit)" /><text> </text>@T["booked or waiting"]}</p>
                    @foreach (var grant in balance.Grants)
                    {
                        <p class="small text-warning mb-0"><i class="fa-regular fa-hourglass-half" aria-hidden="true"></i> <partial name="_TimeOffAmount" model="(grant.Remaining, unit)" /> @T["to use by {0}", grant.ExpiresOn.ToString("d MMM yyyy")]</p>
                    }
                </div>
            </div>
        </div>
    }
</div>

<div class="card mb-3">
    <div class="card-body">
        <h2 class="h5">@T["Ask for time off"]</h2>
        <form method="post" asp-antiforgery="true" action="@Url.Content("~/Admin/my-work/time-off")">
            @Html.ValidationSummary()
            <div class="row g-2">
                <div class="col-md-4"><label for="TypeId" class="form-label">@T["Kind"]</label><select asp-for="TypeId" asp-items="Model.TypeOptions" class="form-select"><option value="">@T["Choose"]</option></select></div>
                <div class="col-6 col-md-4"><label for="StartDate" class="form-label">@T["From"]</label><input asp-for="StartDate" type="date" class="form-control" /></div>
                <div class="col-6 col-md-4"><label for="EndDate" class="form-label">@T["To"]</label><input asp-for="EndDate" type="date" class="form-control" /></div>
                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="PartialDay" class="form-check-input" />
                        <label asp-for="PartialDay" class="form-check-label">@T["Only part of the day"]</label>
                    </div>
                </div>
                <div class="col-12 @(Model.PartialDay ? null : "d-none")" id="my-partial-day">
                    <div class="d-flex align-items-center gap-2">
                        <input asp-for="StartTime" type="time" class="form-control" style="max-width: 9rem" aria-label="@T["From"]" />
                        <span>@T["to"]</span>
                        <input asp-for="EndTime" type="time" class="form-control" style="max-width: 9rem" aria-label="@T["To"]" />
                    </div>
                </div>
                <div class="col-12"><label for="Reason" class="form-label">@T["Reason"]</label><textarea asp-for="Reason" class="form-control" rows="2"></textarea></div>
            </div>
            @if (preview is not null)
            {
                <div class="alert @(preview.Problems.Count > 0 ? "alert-danger" : "alert-success") mt-3 mb-0">
                    @foreach (var problem in preview.Problems)
                    {
                        <div>@problem</div>
                    }
                    @if (preview.Problems.Count == 0)
                    {
                        <div>
                            @T["This asks for"] <strong><partial name="_TimeOffAmount" model="(preview.Amount, preview.Type?.Unit ?? TimeOffUnit.Hours)" /></strong>.
                            @switch (preview.Outcome)
                            {
                                case TimeOffRequestStatus.Approved:
                                    @T["It would be approved at once."]
                                    break;
                                case TimeOffRequestStatus.Waitlisted:
                                    @T["As many people as may be off already are, so it would wait for a place."]
                                    break;
                                default:
                                    @T["Your manager would decide."]
                                    break;
                            }
                        </div>
                        @if (preview.Balance is not null)
                        {
                            <div class="small">@T["Left after this:"] <partial name="_TimeOffAmount" model="(preview.Balance.Available - preview.Amount, preview.Type?.Unit ?? TimeOffUnit.Hours)" /></div>
                        }
                    }
                </div>
            }
            <div class="mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-success">@T["Send request"]</button>
                <button type="submit" name="check" value="true" class="btn btn-outline-secondary">@T["Check first"]</button>
            </div>
        </form>
    </div>
</div>

<h2 class="h5">@T["My requests"]</h2>
@if (Model.Requests.Count == 0)
{
    <p class="text-muted">@T["No requests yet."]</p>
}
<ul class="list-group mb-3">
    @foreach (var (request, type) in Model.Requests)
    {
        <li class="list-group-item d-flex flex-wrap align-items-center gap-2">
            <div class="me-auto">
                <strong>@type?.Name</strong> <span class="text-muted"><partial name="_TimeOffDates" model="request" /></span>
                <div class="small"><partial name="_TimeOffStatus" model="request.Status" /> <partial name="_TimeOffAmount" model="(request.Amount, type?.Unit ?? TimeOffUnit.Hours)" />@if (!string.IsNullOrEmpty(request.DecisionNote)) {<span class="text-muted"> · @request.DecisionNote</span>}</div>
            </div>
            @if (request.IsOpen || request.Status == TimeOffRequestStatus.Approved)
            {
                <form method="post" asp-antiforgery="true" action="@Url.Content("~/Admin/my-work/time-off/cancel/" + request.ItemId)">
                    <button type="submit" class="btn btn-outline-danger btn-sm">@(request.IsOpen ? T["Withdraw"] : T["Cancel"])</button>
                </form>
            }
        </li>
    }
</ul>

<script>
    (() => {
        const partial = document.getElementById('PartialDay');
        const times = document.getElementById('my-partial-day');
        const endDate = document.getElementById('EndDate');
        const sync = () => {
            times.classList.toggle('d-none', !partial.checked);
            endDate.disabled = partial.checked;
        };
        partial.addEventListener('change', sync);
        sync();
    })();
</script>

