@model MyScheduleViewModel
@{
    Layout = null;
    ViewData["MyWorkNav"] = Model.Nav;
    ViewData["Title"] = T["Schedule"].Value;
}
<partial name="_MyWorkHead" />

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0 me-auto">@T["My schedule"]</h1>
    <a href="@Url.Content("~/my-work/settings#calendar")" class="btn btn-outline-success btn-sm"><i class="fa-regular fa-calendar-plus me-1" aria-hidden="true"></i>@T["Add to my calendar"]</a>
</div>
<p class="text-muted small">@T["Your published shifts and approved time off for the next four weeks."]</p>

@if (Model.Days.Count == 0)
{
    <div class="alert alert-light">@T["Nothing is scheduled yet."]</div>
}
@foreach (var (date, items) in Model.Days)
{
    <h2 class="h6 mt-3">@date.ToString("dddd d MMMM")</h2>
    @foreach (var item in items)
    {
        <partial name="_MyShift" model="item" />
    }
}

<partial name="_MyWorkFoot" />
