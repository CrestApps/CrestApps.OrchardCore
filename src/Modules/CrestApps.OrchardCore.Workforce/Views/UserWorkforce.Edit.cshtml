@model UserWorkforceViewModel

<div class="card text-bg-theme mb-3">
    <div class="card-header">@T["Workforce"]</div>
    <div class="card-body">
        @if (string.IsNullOrEmpty(Model.WorkerId))
        {
            <div class="ocat-wrapper">
                <div class="ocat-end-offset">
                    <div class="form-check">
                        <input asp-for="MakeWorker" class="form-check-input" onchange="document.getElementById('user-workforce-fields').hidden = !this.checked" />
                        <label asp-for="MakeWorker" class="form-check-label">@T["Make them a worker"]</label>
                        <span class="hint dashed">@T["So they can be scheduled, take time off and clock in. Their name and email come from this account."]</span>
                    </div>
                </div>
            </div>
        }
        else
        {
            <p class="hint">@T["Their name and email come from this account. Teams, hours, availability, pay rates and certificates are on their worker page."] <a asp-area="CrestApps.OrchardCore.Workforce" asp-controller="Workers" asp-action="Edit" asp-route-id="@Model.WorkerId">@T["Open their worker page"]</a></p>
        }
        <div id="user-workforce-fields" hidden="@(string.IsNullOrEmpty(Model.WorkerId) && !Model.MakeWorker)">
            <div class="ocat-wrapper"><label asp-for="EmployeeNumber" class="ocat-label">@T["Employee number"]</label><div class="ocat-end"><input asp-for="EmployeeNumber" class="form-control" style="max-width: 14rem" /><span class="hint">@T["Also their badge number at a time clock kiosk."]</span></div></div>
            <div class="ocat-wrapper"><label asp-for="JobTitle" class="ocat-label">@T["Job title"]</label><div class="ocat-end"><input asp-for="JobTitle" class="form-control" /></div></div>
            <div class="ocat-wrapper"><label asp-for="EmploymentType" class="ocat-label">@T["Employment"]</label><div class="ocat-end"><select asp-for="EmploymentType" asp-items="Model.EmploymentTypeOptions" class="form-select" style="max-width: 18rem"></select></div></div>
            <div class="ocat-wrapper"><label asp-for="Status" class="ocat-label">@T["Status"]</label><div class="ocat-end"><select asp-for="Status" asp-items="Model.StatusOptions" class="form-select" style="max-width: 18rem"></select><span class="hint">@T["Only active workers are scheduled."]</span></div></div>
            <div class="ocat-wrapper"><label asp-for="HireDate" class="ocat-label">@T["Hire date"]</label><div class="ocat-end"><input asp-for="HireDate" type="date" class="form-control" style="max-width: 12rem" /></div></div>
            <div class="ocat-wrapper">
                <label asp-for="PrimaryTeamId" class="ocat-label">@T["Main team"]</label>
                <div class="ocat-end">
                    <select asp-for="PrimaryTeamId" asp-items="Model.TeamOptions" class="form-select" style="max-width: 24rem">
                        <option value="">@T["No team yet"]</option>
                    </select>
                    <span class="hint">@T["They join it from today when they aren't in it yet; the teams they are in stay."]</span>
                </div>
            </div>
            <div class="ocat-wrapper"><label asp-for="ContractedHoursPerWeek" class="ocat-label">@T["Contracted hours a week"]</label><div class="ocat-end"><input asp-for="ContractedHoursPerWeek" type="number" step="0.5" min="0" class="form-control" style="max-width: 10rem" /></div></div>
        </div>
    </div>
</div>
