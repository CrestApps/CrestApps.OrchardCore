@model MySettingsViewModel

<div class="ocat-wrapper">
    <label for="quiet-start" class="ocat-label">@T["From"]</label>
    <div class="ocat-end">
        <input id="quiet-start" name="quietStart" type="time" class="form-control" style="max-width: 9rem" value="@Model.QuietStart" />
    </div>
</div>
<div class="ocat-wrapper">
    <label for="quiet-end" class="ocat-label">@T["To"]</label>
    <div class="ocat-end">
        <input id="quiet-end" name="quietEnd" type="time" class="form-control" style="max-width: 9rem" value="@Model.QuietEnd" />
        <span class="hint">@T["Nothing is pushed to my phone or emailed in these hours; it all still shows here in My Work. Leave both empty for none."]</span>
    </div>
</div>
