@model WorkforceListViewModel

<zone Name="Title"><breadcrumb name="WorkforceLaborRules" title="@T["Labor Rules"]" /></zone>

<form asp-action="Index" method="get">
    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <p class="mb-0 text-muted small">@T["Rules for a team, a site or a jurisdiction, such as the most hours a week or the rest between shifts. A worker gets the set assigned to them alone, or else the nearest team's. No rule sets come built in: the law where your teams work decides what you set up."]</p>
                </div>
                <div class="col-auto"><a asp-action="Edit" class="btn btn-secondary create">@T["Add rule set"]</a></div>
            </div>
        </div>
    </div>
</form>

<admin-list name="WorkforceLaborRules" context="Model.List" show-select-all="false" empty-message="@T["<strong>Nothing here!</strong> There are no labor rule sets."]">
    <admin-list-list item-css-class="list-group-item" />
    <admin-list-grid>
        <admin-list-column name="Name" position="20" title="@T["Rule set"]" />
        <admin-list-column name="Details" position="30" title="@T["Details"]" width="auto" />
        <admin-list-column type="Actions" title="@T["Actions"]" />
    </admin-list-grid>
</admin-list>
