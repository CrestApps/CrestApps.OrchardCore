@model WorkforceListViewModel

<zone Name="Title"><breadcrumb name="Workers" title="@T["Workers"]" /></zone>

<form asp-action="Index" method="get" id="workers-filter">
    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <div class="input-group">
                        <input name="search" value="@Model.Search" class="form-control" placeholder="@T["Search by name, email or employee number"]" type="search" />
                        <button type="submit" class="btn btn-outline-secondary" title="@T["Search"]" aria-label="@T["Search"]"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
                    </div>
                </div>
                <div class="col-auto"><a asp-action="Edit" class="btn btn-secondary create">@T["Add worker"]</a></div>
            </div>
        </div>
    </div>
</form>

@{
    Model.List.ToolbarActions = await New.WorkersFilter(ViewModel: Model);
}

<admin-list name="Workers" context="Model.List" show-select-all="false" empty-message="@T["<strong>Nothing here!</strong> No workers match."]">
    <admin-list-list item-css-class="list-group-item" />
    <admin-list-grid>
        <admin-list-column name="Name" position="20" title="@T["Worker"]" />
        <admin-list-column name="Details" position="30" title="@T["Details"]" width="auto" />
        <admin-list-column type="Actions" title="@T["Actions"]" />
    </admin-list-grid>
</admin-list>
