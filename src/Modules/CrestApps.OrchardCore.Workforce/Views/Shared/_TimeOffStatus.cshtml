@model TimeOffRequestStatus
@switch (Model)
{
    case TimeOffRequestStatus.Approved:
        <span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Status"]"><i class="fa-solid fa-circle-check text-success me-1" aria-hidden="true"></i>@T["Approved"]</span>
        break;
    case TimeOffRequestStatus.Waitlisted:
        <span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Status"]"><i class="fa-solid fa-list-ol text-warning me-1" aria-hidden="true"></i>@T["Waitlisted"]</span>
        break;
    case TimeOffRequestStatus.Declined:
        <span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Status"]"><i class="fa-solid fa-circle-xmark text-danger me-1" aria-hidden="true"></i>@T["Declined"]</span>
        break;
    case TimeOffRequestStatus.Canceled:
        <span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Status"]"><i class="fa-solid fa-ban text-secondary me-1" aria-hidden="true"></i>@T["Canceled"]</span>
        break;
    case TimeOffRequestStatus.Withdrawn:
        <span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Status"]"><i class="fa-solid fa-rotate-left text-secondary me-1" aria-hidden="true"></i>@T["Withdrawn"]</span>
        break;
    default:
        <span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Status"]"><i class="fa-solid fa-hourglass-half text-warning me-1" aria-hidden="true"></i>@T["Pending"]</span>
        break;
}
