@model WorkforceListViewModel

<zone Name="Title"><breadcrumb name="ShiftTemplates" title="@T["Shift Templates"]" /></zone>

<form asp-action="Index" method="get">
    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <p class="mb-0 text-muted small">@T["Reusable shifts with their breaks, such as Day 09:00-17:00 with a meal at 13:00. Rotations and the planner board build shifts from them."]</p>
                </div>
                <div class="col-auto"><a asp-action="Edit" class="btn btn-secondary create">@T["Add shift template"]</a></div>
            </div>
        </div>
    </div>
</form>

<admin-list name="ShiftTemplates" context="Model.List" show-select-all="false" empty-message="@T["<strong>Nothing here!</strong> There are no shift templates."]">
    <admin-list-list item-css-class="list-group-item" />
    <admin-list-grid>
        <admin-list-column name="Name" position="20" title="@T["Template"]" />
        <admin-list-column name="Details" position="30" title="@T["Details"]" width="auto" />
        <admin-list-column type="Actions" title="@T["Actions"]" />
    </admin-list-grid>
</admin-list>
