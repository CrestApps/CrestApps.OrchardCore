@model ShiftTemplateEditViewModel

<zone Name="Title">
    <breadcrumb name="ShiftTemplatesEdit" title="@(string.IsNullOrEmpty(Model.Id) ? T["New Shift Template"] : T["Edit '{0}' Shift Template", Model.Name])">
        <breadcrumb-item id="ShiftTemplates" action="Index" controller="ShiftTemplates" area="CrestApps.OrchardCore.Workforce">@T["Shift Templates"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form method="post" asp-action="Edit" asp-route-id="@Model.Id" class="no-multisubmit">
    <input type="hidden" asp-for="Id" />
    @Html.ValidationSummary()
    <div class="card text-bg-theme mb-3"><div class="card-body">
        <div class="ocat-wrapper"><label asp-for="Name" class="ocat-label ocat-label-required">@T["Name"]</label><div class="ocat-end"><input asp-for="Name" class="form-control" /></div></div>
        <div class="ocat-wrapper">
            <label asp-for="Start" class="ocat-label ocat-label-required">@T["Hours"]</label>
            <div class="ocat-end">
                <div class="d-flex align-items-center gap-2">
                    <input asp-for="Start" type="time" class="form-control" style="max-width: 9rem" aria-label="@T["Starts"]" />
                    <span>@T["to"]</span>
                    <input asp-for="End" type="time" class="form-control" style="max-width: 9rem" aria-label="@T["Ends"]" />
                </div>
                <span class="hint">@T["An end at or before the start is on the next day, for a night shift."]</span>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="Segments" class="ocat-label">@T["Breaks and activities"]</label>
            <div class="ocat-end">
                <textarea asp-for="Segments" class="form-control font-monospace" rows="4" placeholder="10:30-10:45 Break&#10;13:00-13:30 Meal"></textarea>
                <span class="hint">@T["One per line: a time range, then an activity code. The codes are: {0}.", string.Join(", ", Model.ActivityNames)]</span>
            </div>
        </div>
        <div class="ocat-wrapper"><label asp-for="Color" class="ocat-label">@T["Color"]</label><div class="ocat-end"><input asp-for="Color" type="color" class="form-control form-control-color" /></div></div>
        <div class="ocat-wrapper">
            <label asp-for="TeamIds" class="ocat-label">@T["Teams"]</label>
            <div class="ocat-end">
                <select asp-for="TeamIds" asp-items="Model.TeamOptions" class="form-select" multiple size="5"></select>
                <span class="hint">@T["Leave empty for every team."]</span>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="RequiredSkillIds" class="ocat-label">@T["Skills needed"]</label>
            <div class="ocat-end">
                <select asp-for="RequiredSkillIds" asp-items="Model.SkillOptions" class="form-select" multiple size="5"></select>
                <span class="hint">@T["The skills a worker needs to work this shift."]</span>
            </div>
        </div>
        <div class="ocat-wrapper"><div class="ocat-end-offset"><div class="form-check"><input asp-for="Enabled" class="form-check-input" /><label asp-for="Enabled" class="form-check-label">@T["Enabled"]</label></div></div></div>
    </div></div>
    <div class="ocat-wrapper"><div class="ocat-end-offset"><button class="btn btn-primary" type="submit">@T["Save"]</button> <a class="btn btn-secondary cancel" asp-action="Index">@T["Cancel"]</a></div></div>
</form>
