@model WorkerTimeClockViewModel
@inject OrchardCore.Modules.ILocalClock LocalClock

<zone Name="Title">
    <breadcrumb name="WorkforceWorkerTimeClock" title="@T["{0}'s Time Clock", Model.Worker.DisplayName]">
        <breadcrumb-item id="WorkforceWorkers" action="Index" controller="Workers" area="CrestApps.OrchardCore.Workforce">@T["Workers"]</breadcrumb-item>
    </breadcrumb>
</zone>

<div class="card text-bg-theme mb-3">
    <div class="card-body d-flex flex-wrap gap-4 align-items-center">
        <div>
            <div class="text-muted small">@T["Now"]</div>
            <div class="fw-semibold">@(Model.Status.State switch { TimeClockState.Working => T["Clocked in"], TimeClockState.OnMeal => T["On a meal"], TimeClockState.OnBreak => T["On a break"], _ => T["Clocked out"] })@if (Model.Status.SinceUtc.HasValue && Model.Status.State != TimeClockState.Out) { <span class="fw-normal text-muted"> @T["since {0}", (await LocalClock.ConvertToLocalAsync(Model.Status.SinceUtc.Value)).ToString("g")]</span> }</div>
        </div>
        <div>
            <div class="text-muted small">@T["Time clock policy"]</div>
            <div class="fw-semibold">@(Model.Policy?.Name ?? T["None: their team doesn't clock time"].Value)</div>
        </div>
        @if (Model.Policy?.AttendancePoints.Count > 0)
        {
            <div>
                <div class="text-muted small">@T["Attendance points"]</div>
                <div class="fw-semibold">@Model.Points.ToString("0.##")@if (Model.Policy.PointsThreshold.HasValue) { <span class="fw-normal text-muted"> @T["of {0}", Model.Policy.PointsThreshold.Value.ToString("0.##")]</span> }</div>
            </div>
        }
        <div class="ms-auto d-flex gap-2">
            <a asp-controller="Timesheets" asp-action="Worker" asp-route-workerId="@Model.Worker.ItemId" class="btn btn-secondary">@T["Timesheet"]</a>
            <a asp-controller="Attendance" asp-action="Index" asp-route-workerId="@Model.Worker.ItemId" asp-route-status="all" class="btn btn-outline-secondary">@T["Attendance"]</a>
        </div>
    </div>
</div>

<h2 class="h5">@T["Kiosk PIN"]</h2>
<div class="card text-bg-theme mb-3">
    <div class="card-body">
        @if (string.IsNullOrEmpty(Model.Worker.EmployeeNumber))
        {
            <p class="mb-0">@T["Kiosks know workers by their employee number and a PIN. Give {0} an employee number first.", Model.Worker.DisplayName] <a asp-controller="Workers" asp-action="Edit" asp-route-id="@Model.Worker.ItemId">@T["Edit the worker"]</a></p>
        }
        else
        {
            <p class="text-muted small">@T["At a kiosk, {0} enters badge number {1} and their PIN.", Model.Worker.DisplayName, Model.Worker.EmployeeNumber] @(Model.HasPin ? T["They have a PIN."] : T["They have no PIN yet."])</p>
            @if (Model.LockedUntilUtc.HasValue && Model.LockedUntilUtc > DateTime.UtcNow)
            {
                <div class="alert alert-warning small">@T["Too many wrong PINs: the kiosk refuses theirs until {0}. Setting a new PIN unlocks it.", (await LocalClock.ConvertToLocalAsync(Model.LockedUntilUtc.Value)).ToString("t")]</div>
            }
            <form asp-action="Pin" asp-route-workerId="@Model.Worker.ItemId" method="post" class="d-flex flex-wrap gap-2 align-items-center">
                <input asp-for="Pin" type="password" inputmode="numeric" pattern="[0-9]{4,8}" minlength="4" maxlength="8" autocomplete="new-password" data-1p-ignore data-lpignore="true" data-bwignore class="form-control" style="max-width: 10rem" placeholder="@T["4 to 8 digits"]" aria-label="@T["New PIN"]" />
                <button type="submit" class="btn btn-secondary">@(Model.HasPin ? T["Change PIN"] : T["Set PIN"])</button>
                @if (Model.HasPin)
                {
                    <button type="submit" name="remove" value="true" class="btn btn-outline-danger" formnovalidate>@T["Remove PIN"]</button>
                }
            </form>
        }
    </div>
</div>

@if (Model.CanViewRates)
{
    <h2 class="h5">@T["Pay rates"]</h2>
    <div class="card text-bg-theme mb-3">
        <div class="card-body">
            @if (Model.Rates.Count == 0)
            {
                <p class="text-muted small">@T["No rates yet. Payroll files leave the rate and amount empty without one."]</p>
            }
            else
            {
                <table class="table table-sm align-middle">
                    <thead><tr><th scope="col">@T["From"]</th><th scope="col">@T["Rate an hour"]</th><th scope="col">@T["For"]</th><th scope="col"><span class="visually-hidden">@T["Actions"]</span></th></tr></thead>
                    <tbody>
                        @foreach (var rate in Model.Rates)
                        {
                            <tr>
                                <td>@rate.EffectiveFrom.ToString("d MMM yyyy")</td>
                                <td>@rate.HourlyRate.ToString("0.00##")</td>
                                <td>@(string.IsNullOrEmpty(rate.ActivityCodeId) ? T["All work"].Value : Model.ActivityNames.GetValueOrDefault(rate.ActivityCodeId, rate.ActivityCodeId))</td>
                                <td class="text-end">
                                    <form asp-action="RemoveRate" asp-route-workerId="@Model.Worker.ItemId" method="post">
                                        <input type="hidden" name="from" value="@rate.EffectiveFrom.ToString("yyyy-MM-dd")" />
                                        <input type="hidden" name="activityCodeId" value="@rate.ActivityCodeId" />
                                        <button type="submit" class="btn btn-link btn-sm text-danger p-0">@T["Remove"]</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            <form asp-action="AddRate" asp-route-workerId="@Model.Worker.ItemId" method="post" class="row g-2 align-items-end">
                <div class="col-sm-auto"><label class="form-label" for="RateFrom">@T["From"]</label><input asp-for="RateFrom" type="date" class="form-control" required /></div>
                <div class="col-sm-auto"><label class="form-label" for="HourlyRate">@T["Rate an hour"]</label><input asp-for="HourlyRate" type="number" step="0.01" min="0.01" class="form-control" style="max-width: 10rem" required /></div>
                <div class="col-sm-auto">
                    <label class="form-label" for="RateActivityCodeId">@T["For"]</label>
                    <select asp-for="RateActivityCodeId" asp-items="Model.ActivityOptions" class="form-select"><option value="">@T["All work"]</option></select>
                </div>
                <div class="col-sm-auto"><button type="submit" class="btn btn-secondary">@T["Add rate"]</button></div>
            </form>
        </div>
    </div>
}
