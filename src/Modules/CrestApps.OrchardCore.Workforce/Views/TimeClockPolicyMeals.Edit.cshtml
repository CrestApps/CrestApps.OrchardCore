@model TimeClockPolicyEditViewModel

<div class="ocat-wrapper"><label asp-for="AutoMealAfterHours" class="ocat-label">@T["Take a meal off after"]</label><div class="ocat-end"><div class="input-group" style="max-width: 12rem"><input asp-for="AutoMealAfterHours" type="number" step="0.25" min="0" max="24" class="form-control" style="max-width: 12rem" /><span class="input-group-text">@T["hours"]</span></div><span class="hint">@T["Optional. A day longer than this with no meal punched has the meal taken off."]</span></div></div>
<div class="ocat-wrapper"><label asp-for="AutoMealMinutes" class="ocat-label">@T["Meal taken off"]</label><div class="ocat-end"><div class="input-group" style="max-width: 12rem"><input asp-for="AutoMealMinutes" type="number" step="1" min="0" max="240" class="form-control" style="max-width: 12rem" /><span class="input-group-text">@T["minutes"]</span></div></div></div>
<div class="ocat-wrapper"><label asp-for="LongMealMinutes" class="ocat-label">@T["Longest meal"]</label><div class="ocat-end"><div class="input-group" style="max-width: 12rem"><input asp-for="LongMealMinutes" type="number" step="1" min="0" max="480" class="form-control" style="max-width: 12rem" /><span class="input-group-text">@T["minutes"]</span></div><span class="hint">@T["Optional. A meal longer than this is a long meal."]</span></div></div>
