@model ShiftTemplateEditViewModel

<div class="ocat-wrapper">
    <label asp-for="TeamIds" class="ocat-label">@T["Teams"]</label>
    <div class="ocat-end">
        <select asp-for="TeamIds" asp-items="Model.TeamOptions" class="selectpicker show-tick" multiple data-live-search="true" data-actions-box="true" data-width="100%" data-selected-text-format="count > 3"></select>
        <span class="hint">@T["Leave empty for every team."]</span>
    </div>
</div>
<div class="ocat-wrapper">
    <label asp-for="RequiredSkillIds" class="ocat-label">@T["Skills needed"]</label>
    <div class="ocat-end">
        <select asp-for="RequiredSkillIds" asp-items="Model.SkillOptions" class="selectpicker show-tick" multiple data-live-search="true" data-actions-box="true" data-width="100%" data-selected-text-format="count > 3"></select>
        <span class="hint">@T["The skills a worker needs to work this shift."]</span>
    </div>
</div>
