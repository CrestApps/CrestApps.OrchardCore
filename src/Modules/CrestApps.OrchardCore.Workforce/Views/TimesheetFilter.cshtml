@{
    var filters = (TimesheetListViewModel)Model.ViewModel;
    var formId = (string)Model.FormId;
}
<style asp-name="bootstrap-select"></style>
<script asp-name="bootstrap-select" depends-on="bootstrap" at="Foot"></script>
@if (filters.CalendarOptions.Count > 1)
{
    <div class="btn-group filter">
        <select name="calendarId" form="@formId" class="selectpicker show-tick" data-style="btn-sm" data-width="fit" data-header="@T["Pay periods"]" data-dropdown-align-right="auto" aria-label="@T["Pay periods"]" onchange="this.form.submit()">
            @foreach (var option in filters.CalendarOptions)
            {
                <option value="@option.Value" selected="@option.Selected">@option.Text</option>
            }
        </select>
    </div>
}
<div class="btn-group filter">
    <select name="periodStart" form="@formId" class="selectpicker show-tick" data-style="btn-sm" data-width="fit" data-header="@T["Pay period"]" data-dropdown-align-right="auto" aria-label="@T["Pay period"]" onchange="this.form.submit()">
        @foreach (var option in filters.PeriodOptions)
        {
            <option value="@option.Value" selected="@option.Selected">@option.Text</option>
        }
    </select>
</div>
<div class="btn-group filter">
    <select name="teamId" form="@formId" class="selectpicker show-tick" data-style="btn-sm" data-width="fit" data-header="@T["Team"]" data-dropdown-align-right="auto" aria-label="@T["Team"]" onchange="this.form.submit()">
        <option value="">@T["All teams"]</option>
        @foreach (var option in filters.TeamOptions)
        {
            <option value="@option.Value" selected="@option.Selected">@option.Text</option>
        }
    </select>
</div>
<div class="btn-group filter">
    <select name="status" form="@formId" class="selectpicker show-tick" data-style="btn-sm" data-width="fit" data-header="@T["Status"]" data-dropdown-align-right="auto" aria-label="@T["Status"]" onchange="this.form.submit()">
        @foreach (var option in filters.StatusOptions)
        {
            <option value="@option.Value" selected="@option.Selected">@option.Text</option>
        }
    </select>
</div>
