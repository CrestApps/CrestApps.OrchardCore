@model WorkforceListViewModel

<zone Name="Title"><breadcrumb name="WorkforceShiftTrades" title="@T["Shift Trades"]" /></zone>

<form asp-action="Index" method="get" id="shift-trades-filter">
    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <p class="mb-0 text-muted small">@T["Shifts workers give away or swap. A colleague accepts, then a manager approves when the team requires it."]</p>
                </div>
                <div class="col-auto"><a asp-action="Create" class="btn btn-secondary create">@T["Offer a trade"]</a></div>
            </div>
        </div>
    </div>
</form>

@{
    Model.List.ToolbarActions = await New.WorkforceTeamStatusFilter(ViewModel: Model, FormId: "shift-trades-filter");
}

<admin-list name="WorkforceShiftTrades" context="Model.List" show-select-all="false" empty-message="@T["<strong>Nothing here!</strong> There are no shift trades."]">
    <admin-list-list item-css-class="list-group-item" />
    <admin-list-grid>
        <admin-list-column name="Name" position="20" title="@T["Trade"]" />
        <admin-list-column name="Details" position="30" title="@T["Details"]" width="auto" />
        <admin-list-column type="Actions" title="@T["Actions"]" />
    </admin-list-grid>
</admin-list>
