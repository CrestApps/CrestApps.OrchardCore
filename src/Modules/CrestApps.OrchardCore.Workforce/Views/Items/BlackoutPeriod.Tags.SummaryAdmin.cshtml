@model ShapeViewModel<BlackoutPeriod>

@if (string.IsNullOrEmpty(Model.Value.TeamId))
{
    <span class="badge ta-badge fw-normal"><i class="fa-solid fa-globe text-secondary me-1" aria-hidden="true"></i>@T["Every team"]</span>
}
@if (Model.Value.TypeIds.Count > 0)
{
    <span class="badge ta-badge fw-normal">@T.Plural(Model.Value.TypeIds.Count, "1 type", "{0} types", Model.Value.TypeIds.Count)</span>
}
@if (!Model.Value.Enabled)
{
    <span class="badge ta-badge fw-normal"><i class="fa-solid fa-ban text-secondary me-1" aria-hidden="true"></i>@T["Not in use"]</span>
}
