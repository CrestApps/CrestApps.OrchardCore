@model ShapeViewModel<TimeOffRequestRowViewModel>
@{
    var id = Model.Value.Request.ItemId;
}
@if (Model.Value.Request.IsOpen)
{
    <div class="form-check">
        <input type="checkbox" class="form-check-input" value="@id" name="itemIds" id="itemIds-@id" aria-label="@T["Select"]">
        <label class="form-check-label" for="itemIds-@id">&nbsp;</label>
    </div>
}
