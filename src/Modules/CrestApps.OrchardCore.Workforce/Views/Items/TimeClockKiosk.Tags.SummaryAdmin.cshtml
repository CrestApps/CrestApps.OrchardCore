@model ShapeViewModel<TimeClockKiosk>
@inject OrchardCore.Modules.ILocalClock LocalClock

@if (Model.Value.LastUsedUtc.HasValue)
{
    <span class="badge ta-badge fw-normal">@T["Last used {0}", (await LocalClock.ConvertToLocalAsync(Model.Value.LastUsedUtc.Value)).ToString("g")]</span>
}
else
{
    <span class="badge ta-badge fw-normal">@T["Not used yet"]</span>
}
@if (!Model.Value.Enabled)
{
    <span class="badge ta-badge fw-normal"><i class="fa-solid fa-ban text-secondary me-1" aria-hidden="true"></i>@T["Not in use"]</span>
}
