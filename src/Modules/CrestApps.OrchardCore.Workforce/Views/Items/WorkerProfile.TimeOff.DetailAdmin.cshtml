@model ShapeViewModel<CrestApps.OrchardCore.Staff.Models.StaffMember>

<div class="card text-bg-theme mb-3">
    <div class="list-group list-group-flush">
        <a asp-area="CrestApps.OrchardCore.Workforce" asp-controller="TimeOff" asp-action="Worker" asp-route-workerId="@Model.Value.ItemId" class="list-group-item list-group-item-action">
            <i class="fa-solid fa-umbrella-beach me-2 text-secondary" aria-hidden="true"></i>@T["Time off"]
            <span class="d-block hint">@T["Their balances, requests and the policies they are on."]</span>
        </a>
    </div>
</div>
