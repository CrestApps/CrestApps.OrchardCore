@model ShapeViewModel<ActivityCode>

@if (!string.IsNullOrEmpty(Model.Value.Code))
{
    <span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Code"]"><i class="fa-solid fa-hashtag text-secondary me-1" aria-hidden="true"></i>@Model.Value.Code</span>
}
<span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Paid"]"><i class="fa-solid fa-sack-dollar text-secondary me-1" aria-hidden="true"></i>@(Model.Value.IsPaid ? T["Paid"] : T["Unpaid"])</span>
@if (Model.Value.CountsTowardCoverage)
{
    <span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["The worker counts toward staffing during it"]"><i class="fa-solid fa-users text-secondary me-1" aria-hidden="true"></i>@T["Covers"]</span>
}
@if (!Model.Value.Enabled)
{
    <span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Status"]"><i class="fa-solid fa-ban text-warning me-1" aria-hidden="true"></i>@T["Disabled"]</span>
}
