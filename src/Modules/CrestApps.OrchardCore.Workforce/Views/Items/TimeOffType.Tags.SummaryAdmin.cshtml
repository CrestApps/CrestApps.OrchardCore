@model ShapeViewModel<TimeOffType>

<span class="badge ta-badge fw-normal">@(Model.Value.Unit == TimeOffUnit.Days ? T["In days"] : T["In hours"])</span>
<span class="badge ta-badge fw-normal">@(Model.Value.IsPaid ? T["Paid"] : T["Unpaid"])</span>
@if (Model.Value.RequiresBalance)
{
    <span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["A request needs enough balance under a policy"]"><i class="fa-solid fa-scale-balanced text-secondary me-1" aria-hidden="true"></i>@T["Needs a balance"]</span>
}
@if (!Model.Value.CountsAgainstAllotment)
{
    <span class="badge ta-badge fw-normal">@T["Not in allotments"]</span>
}
@if (!Model.Value.Enabled)
{
    <span class="badge ta-badge fw-normal"><i class="fa-solid fa-ban text-secondary me-1" aria-hidden="true"></i>@T["Not in use"]</span>
}
