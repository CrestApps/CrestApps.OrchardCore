@model ShapeViewModel<ShiftTemplate>

<a asp-controller="ShiftTemplates" asp-action="Delete" asp-route-id="@Model.Value.ItemId" class="dropdown-item text-danger" data-title="@T["Delete"]" data-message="@T["Delete this shift template? Shifts made from it keep their times; rotations that use it skip those days."]" data-url-af="RemoveUrl UnsafeUrl">@T["Delete"]</a>
