@model MyTimeOffViewModel

<div class="ocat-wrapper" asp-validation-class-for="TypeId">
    <label asp-for="TypeId" class="ocat-label">@T["Kind"]</label>
    <div class="ocat-end">
        <select asp-for="TypeId" asp-items="Model.TypeOptions" class="form-select"><option value="">@T["Choose"]</option></select>
    </div>
</div>
<div class="ocat-wrapper" asp-validation-class-for="StartDate">
    <label asp-for="StartDate" class="ocat-label">@T["From"]</label>
    <div class="ocat-end">
        <input asp-for="StartDate" type="date" class="form-control" />
    </div>
</div>
<div class="ocat-wrapper" asp-validation-class-for="EndDate">
    <label asp-for="EndDate" class="ocat-label">@T["To"]</label>
    <div class="ocat-end">
        <input asp-for="EndDate" type="date" class="form-control" />
    </div>
</div>
<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input asp-for="PartialDay" class="form-check-input" />
            <label asp-for="PartialDay" class="form-check-label">@T["Only part of the day"]</label>
        </div>
    </div>
</div>
<div class="ocat-wrapper @(Model.PartialDay ? null : "d-none")" id="my-partial-day" asp-validation-class-for="StartTime">
    <label asp-for="StartTime" class="ocat-label">@T["Between"]</label>
    <div class="ocat-end">
        <div class="d-flex align-items-center gap-2">
            <input asp-for="StartTime" type="time" class="form-control" style="max-width: 9rem" aria-label="@T["From"]" />
            <span>@T["to"]</span>
            <input asp-for="EndTime" type="time" class="form-control" style="max-width: 9rem" aria-label="@T["To"]" />
        </div>
    </div>
</div>
