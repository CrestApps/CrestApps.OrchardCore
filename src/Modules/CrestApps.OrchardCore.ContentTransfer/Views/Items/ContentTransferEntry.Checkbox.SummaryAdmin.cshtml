@using OrchardCore.DisplayManagement.Views

@model ShapeViewModel<ContentTransferEntry>

<div class="form-check">
    <input type="checkbox" class="form-check-input" value="@Model.Value.EntryId" name="itemIds" id="itemIds-@Model.Value.EntryId">
    <label class="form-check-label" for="itemIds-@Model.Value.EntryId">&nbsp;</label>
</div>
