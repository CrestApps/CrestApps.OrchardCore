@model ListContentTransferEntriesViewModel

@{
    // Imports and exports are separate lists, so a user picks the layout of each on its own.
    var listName = Model.Options.Direction == ContentTransferDirection.Export
        ? "ContentTransferExports"
        : "ContentTransferImports";
}

<style asp-name="bootstrap-select" at="Head"></style>
<script asp-name="bootstrap-select" at="Foot"></script>

<div data-list-management data-selected-label="@T["selected"]" data-client-side-search="false">
    <!-- Hidden submit button do not remove -->
    <input type="submit" name="submit.Filter" id="submitFilter" class="visually-hidden" />
    <input type="submit" name="submit.BulkAction" class="visually-hidden" />
    @Html.HiddenFor(o => o.Options.BulkAction)

    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                @if (Model.Header?.Search != null)
                {
                    <div class="col">
                        @await DisplayAsync(Model.Header.Search)
                    </div>
                }

                @if (Model.Header?.Create != null)
                {
                    <div class="col-auto">
                        @await DisplayAsync(Model.Header.Create)
                    </div>
                }
            </div>
        </div>
    </div>

    @* The entries, the summary/actions bar of the options editor (Header) and the pager are rendered by the AdminList shape, in the layout (List or Grid) the site or the user picked. *@
    <admin-list name="@listName" context="Model.List"
                empty-message="@T["No items found."]">
        <admin-list-list item-css-class="list-group-item" />
        <admin-list-grid>
            <admin-list-column type="Select" />
            <admin-list-column name="Name" position="20" title="@T["File"]" />
            <admin-list-column name="Type" position="30" title="@T["Content type"]" width="auto" />
            <admin-list-column name="Status" position="40" title="@T["Status"]" width="auto" />
            <admin-list-column name="Records" position="50" title="@T["Records"]" width="auto" />
            <admin-list-column name="Created" position="60" title="@T["Created"]" width="auto" />
            <admin-list-column type="Actions" title="@T["Actions"]" />
        </admin-list-grid>
    </admin-list>
</div>

<script asp-name="list-management-ui" at="Foot"></script>
