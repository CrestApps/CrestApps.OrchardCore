@model ListContentTransferEntryOptions

<input asp-for="OriginalSearchText" type="hidden" />
<div class="input-group">
    <label for="search-box" class="visually-hidden">@T["Search"]</label>
    <input asp-for="SearchText" id="search-box" class="form-control" placeholder="@T["Search"]" inputmode="search" type="search" autofocus autocomplete="off" />
    <button type="submit" name="submit.Filter" class="btn btn-outline-secondary" title="@T["Search"]" aria-label="@T["Search"]"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
</div>
