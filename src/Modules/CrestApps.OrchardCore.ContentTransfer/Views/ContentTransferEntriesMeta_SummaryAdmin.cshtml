@model OrchardCore.DisplayManagement.Views.ShapeViewModel<ContentTransferEntryViewModel>

@using System.Globalization

@{
    var entry = Model.Value.ContentTransferEntry;
}

<span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@await DisplayAsync(await New.DateTime(Utc: entry.CreatedUtc, Format: "g"))">
    <i class="fa-solid fa-calendar text-secondary" aria-hidden="true"></i>
    <time datetime="@entry.CreatedUtc.ToString("yyyy-MM-ddTHH:mm:sszzz", CultureInfo.InvariantCulture)">
        @await DisplayAsync(await New.Timespan(Utc: entry.CreatedUtc))
    </time>
</span>

@if (!string.IsNullOrEmpty(entry.Author))
{
    <user-display-name user-name="@(entry.Author)" title="@T["Author"].Value" display-type="SummaryAdmin" cache-id="user-display-name-author" />
}
