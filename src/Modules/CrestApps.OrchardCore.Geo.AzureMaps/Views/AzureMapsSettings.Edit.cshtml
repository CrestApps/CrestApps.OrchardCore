@model AzureMapsSettingsViewModel

<h2 class="h5 mt-4">@T["Azure Maps"]</h2>

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <p class="text-muted">@T["Choose Azure Maps above for geocoding, travel times or routes. Create an Azure Maps account in the Azure portal and copy its primary key."]</p>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="Key" class="ocat-label">@T["Subscription key"]</label>
    <div class="ocat-end">
        <input asp-for="Key" type="password" class="form-control" autocomplete="new-password" data-1p-ignore data-lpignore="true" data-bwignore="true" placeholder="@(Model.HasKey ? T["Saved. Enter a new key to replace it."] : null)" />
        <span class="hint">@(Model.HasKey ? T["A key is saved. It is never shown again."] : T["Without a key, Azure Maps answers nothing and the built-in estimate is used."])</span>
    </div>
</div>

@if (Model.HasKey)
{
    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <div class="form-check">
                <input asp-for="RemoveKey" type="checkbox" class="form-check-input" />
                <label asp-for="RemoveKey" class="form-check-label">@T["Remove the key"]</label>
                <span class="hint dashed">@T["The provider stops answering until a new key is saved."]</span>
            </div>
        </div>
    </div>
}
