@using CrestApps.OrchardCore.AI.Core.Webhooks
@using OrchardCore.DisplayManagement.Views

@model ShapeViewModel<AIWebhookSubscription>

<button type="submit" class="dropdown-item" formaction="@Url.Action("Test", "AIWebhooks", new { area = "CrestApps.OrchardCore.AI", id = Model.Value.ItemId })">@T["Send a test event"]</button>
<a asp-action="Delete" asp-controller="AIWebhooks" asp-route-id="@Model.Value.ItemId" class="dropdown-item text-danger" data-url-af="RemoveUrl UnsafeUrl" data-title="@T["Delete"]" data-message="@T["Are you sure you want to delete this webhook? Its delivery log is kept."]" data-ok-text="@T["Yes"]" data-cancel-text="@T["Cancel"]">@T["Delete"]</a>
