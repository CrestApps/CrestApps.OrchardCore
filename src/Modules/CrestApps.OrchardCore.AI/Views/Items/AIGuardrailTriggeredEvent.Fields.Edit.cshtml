@using CrestApps.OrchardCore.AI.Workflows.ViewModels

@model AIGuardrailTriggeredEventViewModel

<div class="ocat-wrapper">
    <label class="ocat-label" asp-for="ProfileId">@T["Profile"]</label>
    <div class="ocat-end">
        <select class="form-select" asp-for="ProfileId" asp-items="Model.Profiles">
            <option value="">@T["Any profile"]</option>
        </select>
        <span class="hint">@T["The input has <code>Category</code>, <code>Direction</code> (<code>Customer</code> or <code>Reply</code>), <code>Reason</code>, the refused <code>Text</code>, <code>SessionId</code> and <code>ProfileId</code>, and on calls and texts the conversation's <code>Contact</code>, <code>Channel</code> and <code>Variables</code>."]</span>
    </div>
</div>
