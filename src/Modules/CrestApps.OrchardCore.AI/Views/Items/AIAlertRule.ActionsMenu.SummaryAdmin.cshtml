@using CrestApps.OrchardCore.AI.Core.Models
@using OrchardCore.DisplayManagement.Views

@model ShapeViewModel<AIAlertRule>

<a asp-action="Delete" asp-controller="AIAlertRules" asp-route-id="@Model.Value.ItemId" class="dropdown-item text-danger" data-url-af="RemoveUrl UnsafeUrl" data-title="@T["Delete"]" data-message="@T["Are you sure you want to delete this alert rule?"]" data-ok-text="@T["Yes"]" data-cancel-text="@T["Cancel"]">@T["Delete"]</a>
