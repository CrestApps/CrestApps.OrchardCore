@using CrestApps.Core.AI.Models
@using OrchardCore.DisplayManagement.Views

@model ShapeViewModel<SpeechVoice>

@if (!string.IsNullOrEmpty(Model.Value.VoiceSampleUrl))
{
    <audio controls preload="none" src="@Model.Value.VoiceSampleUrl" style="height: 2rem; max-width: 14rem;"></audio>
}
<button type="button" class="btn btn-sm btn-secondary" data-copy="@Model.Value.Id" onclick="navigator.clipboard.writeText(this.dataset.copy)">@T["Copy id"]</button>
