@using CrestApps.Core.AI.Models

@model ShapeViewModel<AIProfile>

<a asp-action="Index" asp-controller="AIProfileVersions" asp-area="CrestApps.OrchardCore.AI" asp-route-profileId="@Model.Value.ItemId" class="dropdown-item">@T["Versions"]</a>
<a asp-action="Delete"
   asp-route-id="@Model.Value.ItemId"
   class="dropdown-item text-danger"
   data-url-af="RemoveUrl UnsafeUrl"
   data-message="@T["Are you sure you want to delete this profile?"]"
   data-ok-text="@T["Yes"]"
   data-cancel-text="@T["Cancel"]">@T["Delete"]</a>
