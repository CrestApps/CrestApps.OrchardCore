@using CrestApps.OrchardCore.AI.Core.Models
@using CrestApps.OrchardCore.AI.Reports
@using CrestApps.OrchardCore.Reports
@using Microsoft.Extensions.Options
@using OrchardCore.DisplayManagement.Views
@inject IOptions<ReportOptions> ReportOptions

@model ShapeViewModel<AIQACohort>

@if (ReportOptions.Value.Reports.Any(report => report.Name == AIQualityReport.Name))
{
    <a href="@Url.Action("Display", "Reports", new { area = ReportsConstants.Feature, id = AIQualityReport.Name, QACohortId = Model.Value.ItemId })" class="btn btn-sm btn-primary">@T["Dashboard"]</a>
}
<a asp-action="Edit" asp-controller="AIQACohorts" asp-route-id="@Model.Value.ItemId" class="btn btn-sm btn-secondary">@T["Edit"]</a>
