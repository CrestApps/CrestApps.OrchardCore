@using CrestApps.OrchardCore.AI.Workflows.ViewModels

@model SimulateConversationTaskViewModel

<div class="ocat-wrapper" asp-validation-class-for="ProfileId">
    <label class="ocat-label ocat-label-required" asp-for="ProfileId">@T["Profile"]</label>
    <div class="ocat-end">
        <select class="form-select" asp-for="ProfileId" asp-items="Model.Profiles">
            <option value="">@T["Choose a profile"]</option>
        </select>
        <span asp-validation-for="ProfileId"></span>
        <span class="hint">@T["The AI profile under test."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="Scenario">
    <label class="ocat-label ocat-label-required" asp-for="Scenario">@T["Customer"]</label>
    <div class="ocat-end">
        <textarea class="form-control" asp-for="Scenario" rows="5" placeholder="@T["You are Dana, a busy parent. You want to move tomorrow's 3 pm cleaning to next week, mornings only. You are a little impatient."]"></textarea>
        <span asp-validation-for="Scenario"></span>
        <span class="hint">@T["Who the simulated customer is, what they want and how they behave. Liquid is supported, so a For Each can run one test per item."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="Criteria">
    <label class="ocat-label" asp-for="Criteria">@T["Criteria"]</label>
    <div class="ocat-end">
        <textarea class="form-control" asp-for="Criteria" rows="4" placeholder="@T["The assistant offered a morning slot next week"]"></textarea>
        <span asp-validation-for="Criteria"></span>
        <span class="hint">@T["One condition the conversation must meet per line."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="Variables">
    <label class="ocat-label" asp-for="Variables">@T["Variables"]</label>
    <div class="ocat-end">
        <textarea class="form-control font-monospace" asp-for="Variables" rows="3" placeholder="first_name: Dana"></textarea>
        <span asp-validation-for="Variables"></span>
        <span class="hint">@T["Optional. The conversation variables the test starts with, one <code>name: value</code> per line. Tool workflows see <code>Workflow.Input.Simulation</code> as true and can answer with test data instead of acting."]</span>
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="ocat-wrapper" asp-validation-class-for="MaxTurns">
            <label class="ocat-label" asp-for="MaxTurns">@T["Most customer turns"]</label>
            <div class="ocat-end">
                <input type="number" class="form-control" asp-for="MaxTurns" min="1" max="50" />
                <span asp-validation-for="MaxTurns"></span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="ocat-wrapper" asp-validation-class-for="PassingScore">
            <label class="ocat-label" asp-for="PassingScore">@T["Passing score"]</label>
            <div class="ocat-end">
                <input type="number" class="form-control" asp-for="PassingScore" min="0" max="100" />
                <span asp-validation-for="PassingScore"></span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="ocat-wrapper">
            <label class="ocat-label" asp-for="Label">@T["Label"]</label>
            <div class="ocat-end">
                <input type="text" class="form-control" asp-for="Label" placeholder="@T["Release tests"]" />
            </div>
        </div>
    </div>
</div>
<span class="hint">@T["The transcript is in <code>Workflow.Output.Transcript</code> and the score in <code>Workflow.Output.Evaluation</code>."]</span>
