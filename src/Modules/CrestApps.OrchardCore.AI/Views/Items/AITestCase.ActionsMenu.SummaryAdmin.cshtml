@using CrestApps.OrchardCore.AI.Core.Models
@using OrchardCore.DisplayManagement.Views

@model ShapeViewModel<AITestCase>

<button type="submit" class="dropdown-item" formaction="@Url.Action("Run", "AITestCases", new { area = "CrestApps.OrchardCore.AI", id = Model.Value.ItemId, repeats = 5 })">@T["Run 5 times"]</button>
<a asp-action="Runs" asp-controller="AITestCases" asp-route-testCaseId="@Model.Value.ItemId" class="dropdown-item">@T["Runs"]</a>
<a asp-action="Delete" asp-controller="AITestCases" asp-route-id="@Model.Value.ItemId" class="dropdown-item text-danger" data-url-af="RemoveUrl UnsafeUrl" data-title="@T["Delete"]" data-message="@T["Are you sure you want to delete this test case? Its runs are kept."]" data-ok-text="@T["Yes"]" data-cancel-text="@T["Cancel"]">@T["Delete"]</a>
