@using CrestApps.OrchardCore.AI.Core.Models
@using OrchardCore.DisplayManagement.Views

@model ShapeViewModel<AITestCase>

<div class="form-check">
    <input type="checkbox" class="form-check-input" value="@Model.Value.ItemId" name="itemIds" id="itemIds-@Model.Value.ItemId">
    <label class="form-check-label" for="itemIds-@Model.Value.ItemId">&nbsp;</label>
</div>
