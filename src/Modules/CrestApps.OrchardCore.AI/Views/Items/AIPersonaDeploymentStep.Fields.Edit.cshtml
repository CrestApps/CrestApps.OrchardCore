@using CrestApps.OrchardCore.AI.Deployments.ViewModels

@model AIPersonaDeploymentStepViewModel

<div class="ocat-wrapper">
    <div class="ocat-label ocat-label-required">@T["AI Personas"]</div>
    <div class="ocat-end">
        <div class="form-check mb-3">
            <label class="form-check-label">
                <input class="form-check-input" asp-for="IncludeAll" data-bs-toggle="collapse" role="button" data-bs-target="#personas-list" aria-expanded="false" aria-controls="personas-list" />
                @T["Include all saved personas"]
            </label>
        </div>

        <div id="personas-list" class="collapse@(Model.IncludeAll ? string.Empty : " show")">
            <div class="hint mb-1">@T["The saved personas to export as part of the plan. Persona files ship with the code and are not exported."]</div>

            <div class="mb-3">
                @for (var i = 0; i < Model.Personas.Length; i++)
                {
                    <div class="form-check">
                        <input type="hidden" asp-for="Personas[i].ItemId" />
                        <input asp-for="Personas[i].IsSelected" type="checkbox" class="form-check-input">
                        <label class="form-check-label" asp-for="Personas[i].IsSelected">@Model.Personas[i].DisplayText</label>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
