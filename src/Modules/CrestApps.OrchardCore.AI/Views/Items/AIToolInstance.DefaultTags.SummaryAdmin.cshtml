@using CrestApps.Core.AI
@using CrestApps.Core.AI.Tooling
@using Microsoft.Extensions.Options
@using OrchardCore.DisplayManagement.Views

@inject IOptions<AIOptions> AIOptions

@model ShapeViewModel<AIToolInstance>

@{
    AIOptions.Value.ToolInstanceSources.TryGetValue(Model.Value.Source ?? string.Empty, out var source);
}

<span class="badge ta-badge bg-warning-subtle font-weight-normal" data-bs-toggle="tooltip" title="@T["Source"]">
    <i class="text-secondary" aria-hidden="true"></i>@(source?.DisplayName?.Value ?? Model.Value.Source)
</span>

<span class="badge ta-badge bg-info-subtle font-weight-normal" data-bs-toggle="tooltip" title="@T["Function name"]">
    <i class="text-secondary" aria-hidden="true"></i>@Model.Value.GetFunctionName()
</span>
