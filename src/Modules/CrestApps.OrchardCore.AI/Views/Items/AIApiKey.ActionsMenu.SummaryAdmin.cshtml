@using CrestApps.OrchardCore.AI.Core.ApiKeys
@using OrchardCore.DisplayManagement.Views

@model ShapeViewModel<AIApiKey>

<a asp-action="Delete" asp-controller="AIApiKeys" asp-route-id="@Model.Value.ItemId" class="dropdown-item text-danger" data-url-af="RemoveUrl UnsafeUrl" data-title="@T["Delete"]" data-message="@T["Are you sure you want to delete this API key? Programs using it stop working at once."]" data-ok-text="@T["Yes"]" data-cancel-text="@T["Cancel"]">@T["Delete"]</a>
