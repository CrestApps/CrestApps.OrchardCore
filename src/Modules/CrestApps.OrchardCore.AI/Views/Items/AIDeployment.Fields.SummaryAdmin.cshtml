@using CrestApps.Core.AI.Models
@using OrchardCore.DisplayManagement.Views

@model ShapeViewModel<AIDeployment>

@* A plain link to the edit page. A deployment defined in configuration cannot be edited, so its name is plain text. *@
@if (Model.Value.IsReadOnly)
{
    @Model.Value.Name
}
else
{
    <a asp-action="Edit" asp-route-id="@Model.Value.ItemId">@Model.Value.Name</a>
}
