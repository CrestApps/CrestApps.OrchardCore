@using CrestApps.Core.AI
@using CrestApps.Core.AI.Models
@using CrestApps.OrchardCore.AI.Core
@using CrestApps.OrchardCore.AI.Core.Models
@using CrestApps.OrchardCore.AI.ViewModels

@model EditAIProfileSpeakingStyleViewModel

@{
    var selected = new HashSet<string>(Model.Styles ?? [], StringComparer.OrdinalIgnoreCase);
    var name = Html.NameFor(m => m.Styles);
    var addUrl = Url.Action("Create", "AITemplates", new { area = "CrestApps.OrchardCore.AI", source = AITemplateSources.SystemPrompt, category = AISpeakingStyles.Category });
    var templatesUrl = Url.Action("Index", "AITemplates", new { area = "CrestApps.OrchardCore.AI", category = AISpeakingStyles.Category });
}

<p class="text-muted">@T["Each style adds a tested section to the end of the system message, after the persona and instructions, on every channel."]</p>

@for (var i = 0; i < Model.AvailableStyles.Count; i++)
{
    var style = Model.AvailableStyles[i];
    var id = Html.IdFor(m => m.Styles) + "_" + i;

    <div class="ocat-wrapper">
        <div class="ocat-end">
            <div class="form-check">
                <input type="checkbox" class="form-check-input" id="@id" name="@name" value="@style.Id" checked="@selected.Contains(style.Id)" />
                <label class="form-check-label" for="@id">@style.Title</label>
                @if (!string.IsNullOrWhiteSpace(style.Description))
                {
                    <span class="hint dashed">@style.Description</span>
                }
            </div>
        </div>
    </div>
}

<div class="ocat-wrapper">
    <div class="ocat-end">
        <span class="hint">@T["<a href=\"{0}\" target=\"_blank\">Add a speaking style</a>, or change your own under <a href=\"{1}\" target=\"_blank\">Artificial Intelligence &gt; Speaking Styles</a>. They are exported with recipes and deployment plans.", addUrl, templatesUrl]</span>
    </div>
</div>
