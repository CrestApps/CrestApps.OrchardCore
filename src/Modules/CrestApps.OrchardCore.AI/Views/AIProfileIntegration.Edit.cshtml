@using CrestApps.OrchardCore.AI.Integrations

@model AIProfileIntegrationViewModel

<div class="ocat-wrapper">
    <label asp-for="CalendarConnectionId" class="ocat-label">@T["Calendar"]</label>
    <div class="ocat-end">
        <select asp-for="CalendarConnectionId" asp-items="Model.Calendars" class="form-select">
            <option value="">@T["None"]</option>
        </select>
        <span class="hint">@T["The calendar the checkCalendarAvailability and bookCalendarAppointment tools use. Add those tools to the profile too."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="AppointmentMinutes" class="ocat-label">@T["Appointment length"]</label>
    <div class="ocat-end">
        <div class="input-group" style="max-width: 12rem;">
            <input asp-for="AppointmentMinutes" type="number" min="10" max="240" class="form-control" />
            <span class="input-group-text">@T["minutes"]</span>
        </div>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="CrmConnectionId" class="ocat-label">@T["CRM"]</label>
    <div class="ocat-end">
        <select asp-for="CrmConnectionId" asp-items="Model.Crms" class="form-select">
            <option value="">@T["None"]</option>
        </select>
        <span class="hint">@T["The CRM the findCrmContact tool looks customers up in."]</span>
    </div>
</div>
