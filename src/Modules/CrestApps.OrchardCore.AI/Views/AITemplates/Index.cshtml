@using CrestApps.Core.AI
@using CrestApps.Core.AI.Models
@using CrestApps.Core.Models
@using CrestApps.OrchardCore.AI.Core
@using CrestApps.OrchardCore.AI.Core.Models
@using CrestApps.OrchardCore.Core.Models
@using Microsoft.AspNetCore.Mvc.Localization
@using OrchardCore.DisplayManagement

@model ListSourceCatalogEntryViewModel<AIProfileTemplate>

@{
    // A category of System Prompt templates, such as the speaking styles or the guardrail topics, gets a page of its own.
    var category = ViewData["Category"] as string;
    var shipped = ViewData["ShippedTemplates"] as IReadOnlyList<string> ?? [];
    var isStyles = string.Equals(category, AISpeakingStyles.Category, StringComparison.OrdinalIgnoreCase);
    var isTopics = string.Equals(category, AIGuardrailTopics.Category, StringComparison.OrdinalIgnoreCase);
    var pageTitle = isStyles ? T["Speaking Styles"] : isTopics ? T["Guardrail Topics"] : category is null ? T["AI Templates"] : T["Templates: {0}", category];
    var addLabel = isStyles ? T["Add Speaking Style"] : isTopics ? T["Add Guardrail Topic"] : T["Add Template"];
}

<zone Name="Title">
    <breadcrumb name="AITemplates" title="@pageTitle" />
</zone>

@if (category is not null)
{
    <p class="text-muted">
        @if (isStyles)
        {
            @T["A speaking style is a section added to the end of an AI profile's instructions. Choose them on each profile, under Speaking Style. The text you write is what the AI reads."]
        }
        else if (isTopics)
        {
            @T["A guardrail topic is something AI profiles refuse to discuss. Choose them on each profile, under Guardrails. The text you write tells the model what falls under the topic."]
        }
        @if (shipped.Count > 0)
        {
            <br />
            @T["Built in, and not editable here: {0}.", string.Join(", ", shipped)]
        }
    </p>
}

@* The form is necessary to generate an antiforgery token for the delete and toggle actions. *@
<form asp-action="Index" asp-route-pageSize="@Context.Request.Query["pageSize"]" method="post" class="no-multisubmit" data-list-management data-selected-label="@T["selected"]" data-client-side-search="false">
    <input type="submit" name="submit.Filter" id="submitFilter" class="visually-hidden" />
    <input asp-for="Options.BulkAction" type="hidden" />
    <input type="hidden" name="category" value="@category" />
    <input type="submit" name="submit.BulkAction" class="visually-hidden" />

    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <div class="input-group">
                        <input id="search-box" asp-for="Options.Search" class="form-control" placeholder="@T["Search"]" type="search" autofocus autocomplete="off" />
                        <button type="submit" name="submit.Filter" class="btn btn-outline-secondary" title="@T["Search"]" aria-label="@T["Search"]"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
                    </div>
                </div>
                <div class="col-auto">
                    @if (category is null)
                    {
                        <button type="button" class="btn btn-secondary create" data-bs-toggle="modal" data-bs-target="#modalAddTemplate">@addLabel</button>
                    }
                    else
                    {
                        <a class="btn btn-secondary create" asp-action="Create" asp-route-source="@AITemplateSources.SystemPrompt" asp-route-category="@category">@addLabel</a>
                    }
                </div>
            </div>
        </div>
    </div>

    @* The templates, the toolbar and the pager are rendered by the AdminList shape, in the layout (List or Grid) the site or the user picked. *@
    <admin-list name="AITemplates" context="Model.List"
                bulk-actions="Model.Options.BulkActions"
                empty-message="@(category is null ? T["<strong>Nothing here!</strong> There are no templates at the moment."] : T["<strong>None of your own yet.</strong> Click {0} to add one.", addLabel])">
        <admin-list-list item-css-class="list-group-item" />
        <admin-list-grid>
            <admin-list-column type="Select" />
            <admin-list-column name="Name" position="20" title="@T["Name"]" />
            <admin-list-column name="Details" position="30" title="@T["Details"]" width="auto" />
            <admin-list-column name="Modified" position="40" title="@T["Last modified"]" width="auto" />
            <admin-list-column type="Actions" title="@T["Actions"]" />
        </admin-list-grid>
    </admin-list>

    <div id="list-alert" class="alert alert-info my-3 d-none text-center" role="alert">
        @T["Your search returned no results."]
    </div>
</form>

<!-- Modal -->
<div class="modal fade" id="modalAddTemplate" tabindex="-1" role="dialog" aria-labelledby="available-template-types-title" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="available-template-types-title">@T["Available Sources"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @if (!Model.Sources.Any())
                {
                    <p class="p-3 mb-2 bg-warning text-white">@T["You need to enable a feature which provides an template source."]</p>
                }
                else
                {
                    <div class="row row-cols-1 row-cols-md-3 g-2">
                        @foreach (var source in Model.Sources)
                        {
                            IShape shape = await New.AIProfileTemplate_Link(Source: source);
                            shape.Metadata.Alternates.Add("AIProfileTemplate_Link__" + source);

                            @await DisplayAsync(shape)
                        }
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@T["Cancel"]</button>
            </div>
        </div>
    </div>
</div>

<script asp-name="list-management-ui" at="Foot"></script>
