@using CrestApps.OrchardCore.AI.Workflows.Tools

@model WorkflowToolInstanceViewModel

<div class="ocat-wrapper" asp-validation-class-for="WorkflowTypeId">
    <label asp-for="WorkflowTypeId" class="ocat-label ocat-label-required">@T["Workflow"]</label>
    <div class="ocat-end">
        <select asp-for="WorkflowTypeId" asp-items="Model.WorkflowTypes" class="form-select">
            <option value="">@T["Choose a workflow"]</option>
        </select>
        <span asp-validation-for="WorkflowTypeId" class="text-danger"></span>
        <span class="hint">@T["The workflow that runs when the AI calls this tool. It starts with the <strong>AI Tool Called</strong> event, reads the arguments from <code>Workflow.Input.Arguments</code> and the conversation from <code>Workflow.Input</code> (for example <code>CustomerAddress</code> or <code>Variables</code>), and answers with <strong>Set Output</strong>."]</span>
        @if (Model.WorkflowTypes.Count == 0)
        {
            <span class="hint">@T["No workflow starts with the AI Tool Called event yet. Create one under Workflows first."]</span>
        }
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="TimeoutSeconds">
    <label asp-for="TimeoutSeconds" class="ocat-label">@T["Time limit on calls"]</label>
    <div class="ocat-end">
        <div class="input-group">
            <input asp-for="TimeoutSeconds" type="number" min="0" max="300" step="1" class="form-control" placeholder="8" />
            <span class="input-group-text">@T["seconds"]</span>
        </div>
        <span asp-validation-for="TimeoutSeconds" class="text-danger"></span>
        <span class="hint">@T["How long the AI waits for this workflow on a phone call before it tells the caller it could not get an answer. The caller hears a short \"one moment\" while it runs. Leave empty for 8 seconds; 0 waits as long as the workflow takes."]</span>
    </div>
</div>
