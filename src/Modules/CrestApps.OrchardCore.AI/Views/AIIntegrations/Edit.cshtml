@using CrestApps.OrchardCore.AI.Core
@using CrestApps.OrchardCore.Core.Models

@model EditCatalogEntryViewModel

<zone Name="Title">
    <breadcrumb name="AIIntegrationsEdit" title="@T["Edit '{0}' integration", Model.DisplayName]">
        <breadcrumb-item id="AIIntegrations" action="Index" controller="AIIntegrations" area="CrestApps.OrchardCore.AI" permission="@AIPermissions.ManageAIIntegrations.Name">@T["Integrations"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form asp-route-id="@ViewContext.HttpContext.Request.RouteValues["id"]" method="post" class="no-multisubmit">
    @Html.ValidationSummary()
    @await DisplayAsync(Model.Editor)

    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <button class="btn btn-primary" type="submit">@T["Save"]</button>
            <a class="btn btn-secondary cancel" role="button" asp-action="Index">@T["Cancel"]</a>
        </div>
    </div>
</form>
