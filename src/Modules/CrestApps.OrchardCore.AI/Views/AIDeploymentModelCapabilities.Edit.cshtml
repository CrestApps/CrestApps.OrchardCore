@using CrestApps.Core.AI.Models
@using CrestApps.OrchardCore.AI.ViewModels
@model EditDeploymentModelCapabilitiesViewModel

@{
    bool FeatureEnabled(string featureName)
        => Model.SelectedFeatures?.Contains(featureName, StringComparer.OrdinalIgnoreCase) ?? false;

    var indexed = Model.ModelParameters
        .Select((parameter, index) => (Parameter: parameter, Index: index))
        .ToList();
}

@* Renders a single model parameter card. The structural fields (Index, Name, IsSupported) always post,
   even while a feature-dependent card is disabled, so the collection binder never sees a gap that would
   drop or misalign the remaining rows. *@
@{
    Func<(DeploymentModelParameterViewModel Parameter, int Index, bool Hidden), Microsoft.AspNetCore.Html.IHtmlContent> renderCard =
        @<text>
    @{
        var parameter = item.Parameter;
        var descriptor = parameter.Descriptor;
        var i = item.Index;
        var bodyId = $"{Html.IdFor(m => m.ModelParameters)}_{parameter.ElementId}_body";
    }
    <div class="border rounded p-3 mb-2 @(item.Hidden ? "d-none" : string.Empty)"
         data-model-parameter-card
         data-required-feature="@descriptor.RequiredFeature">
        <input type="hidden" name="@(Html.NameFor(m => m.ModelParameters)).Index" value="@i" data-structural="true" />
        <input type="hidden" name="@Html.NameFor(m => m.ModelParameters[i].Name)" value="@parameter.Name" data-structural="true" />
        <div class="form-check">
            <input id="@Html.IdFor(m => m.ModelParameters[i].IsSupported)"
                   name="@Html.NameFor(m => m.ModelParameters[i].IsSupported)"
                   type="checkbox"
                   value="true"
                   class="form-check-input model-parameter-toggle"
                   data-target="@bodyId"
                   checked="@parameter.IsSupported" />
            <input type="hidden" name="@Html.NameFor(m => m.ModelParameters[i].IsSupported)" value="false" data-structural="true" />
            <label class="form-check-label" for="@Html.IdFor(m => m.ModelParameters[i].IsSupported)">
                @descriptor.DisplayName
                @if (descriptor.Description is not null && !string.IsNullOrWhiteSpace(descriptor.Description.Value))
                {
                    <span class="text-muted small d-block">@descriptor.Description</span>
                }
            </label>
        </div>
        <div class="mt-3 @(parameter.IsSupported ? string.Empty : "d-none")" id="@bodyId">
            @if (descriptor.Kind == AIDeploymentParameterKind.Choice && descriptor.AllowedValues.Any())
            {
                <div class="row g-2">
                    <div class="col-md-7">
                        <label class="form-label small" for="@Html.IdFor(m => m.ModelParameters[i].SelectedAllowedValues)">@T["Supported values"]</label>
                        <select id="@Html.IdFor(m => m.ModelParameters[i].SelectedAllowedValues)"
                                name="@Html.NameFor(m => m.ModelParameters[i].SelectedAllowedValues)"
                                class="form-select"
                                data-model-allowed-values
                                multiple
                                title="@T["All registered values"]"
                                size="@Math.Min(descriptor.AllowedValues.Count, 6)">
                            @foreach (var option in descriptor.AllowedValues)
                            {
                                var isSelected = parameter.SelectedAllowedValues?.Contains(option.Value, StringComparer.OrdinalIgnoreCase) ?? false;
                                <option value="@option.Value" selected="@isSelected">@option.DisplayName</option>
                            }
                        </select>
                        <div class="form-text">@T["Leave nothing selected to support every registered value."]</div>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label small" for="@Html.IdFor(m => m.ModelParameters[i].DefaultValue)">@T["Default value"]</label>
                        <select id="@Html.IdFor(m => m.ModelParameters[i].DefaultValue)"
                                name="@Html.NameFor(m => m.ModelParameters[i].DefaultValue)"
                                class="form-select">
                            <option value="">@T["No default"]</option>
                            @foreach (var option in descriptor.AllowedValues)
                            {
                                <option value="@option.Value" selected="@(string.Equals(option.Value, parameter.DefaultValue, StringComparison.OrdinalIgnoreCase))">@option.DisplayName</option>
                            }
                        </select>
                        <div class="form-text">@T["Applied when an operator does not select a value."]</div>
                    </div>
                </div>
            }
            else
            {
                <div class="row g-2">
                    <div class="col-md-3">
                        <label class="form-label small" for="@Html.IdFor(m => m.ModelParameters[i].DefaultValue)">@T["Default value"]</label>
                        <input id="@Html.IdFor(m => m.ModelParameters[i].DefaultValue)"
                               name="@Html.NameFor(m => m.ModelParameters[i].DefaultValue)"
                               class="form-control"
                               value="@parameter.DefaultValue" />
                    </div>
                    @if (descriptor.Kind == AIDeploymentParameterKind.Number || descriptor.Kind == AIDeploymentParameterKind.Integer)
                    {
                        <div class="col-md-3">
                            <label class="form-label small" for="@Html.IdFor(m => m.ModelParameters[i].Minimum)">@T["Minimum"]</label>
                            <input id="@Html.IdFor(m => m.ModelParameters[i].Minimum)"
                                   name="@Html.NameFor(m => m.ModelParameters[i].Minimum)"
                                   type="number" step="any"
                                   class="form-control"
                                   value="@parameter.Minimum" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small" for="@Html.IdFor(m => m.ModelParameters[i].Maximum)">@T["Maximum"]</label>
                            <input id="@Html.IdFor(m => m.ModelParameters[i].Maximum)"
                                   name="@Html.NameFor(m => m.ModelParameters[i].Maximum)"
                                   type="number" step="any"
                                   class="form-control"
                                   value="@parameter.Maximum" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small" for="@Html.IdFor(m => m.ModelParameters[i].Step)">@T["Step"]</label>
                            <input id="@Html.IdFor(m => m.ModelParameters[i].Step)"
                                   name="@Html.NameFor(m => m.ModelParameters[i].Step)"
                                   type="number" step="any"
                                   class="form-control"
                                   value="@parameter.Step" />
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</text>;
}

<div class="card mb-3">
    <div class="card-header">
        <h6 class="card-title mb-0"><i class="bi bi-sliders"></i> @T["Model capabilities"]</h6>
    </div>
    <div class="card-body">
        <p class="text-muted small">
            @T["Declare what the underlying model supports. Features are capabilities the model either has or does not have. Parameters are options an operator can configure on an AI profile, profile template, or chat interaction. Anything not declared here is never rendered in those editors and is never sent to the provider."]
        </p>

        @if (Model.AvailableFeatures.Any())
        {
            <div class="mb-4">
                <label class="form-label fw-semibold">@T["Trained features"]</label>
                <p class="text-muted small mb-2">@T["Capabilities the underlying model was trained with. Only declared features are sent to the provider."]</p>
                @foreach (var group in Model.AvailableFeatures.GroupBy(feature => feature.Category ?? "Trained Features").OrderBy(group => group.Key, StringComparer.OrdinalIgnoreCase))
                {
                    <div class="mb-2">
                        <div class="text-uppercase text-muted small">@group.Key</div>
                        @foreach (var feature in group.OrderBy(feature => feature.DisplayName?.Value ?? feature.Name, StringComparer.OrdinalIgnoreCase))
                        {
                            var isChecked = FeatureEnabled(feature.Name);
                            var dependentCards = indexed
                                .Where(card => string.Equals(card.Parameter.Descriptor.RequiredFeature, feature.Name, StringComparison.OrdinalIgnoreCase))
                                .ToList();
                            <div class="form-check">
                                <input id="@(Html.IdFor(m => m.SelectedFeatures))_@feature.Name?.Replace('.', '_')"
                                       name="@Html.NameFor(m => m.SelectedFeatures)"
                                       type="checkbox"
                                       value="@feature.Name"
                                       class="form-check-input model-feature-toggle"
                                       data-feature-name="@feature.Name"
                                       checked="@isChecked" />
                                <label class="form-check-label" for="@(Html.IdFor(m => m.SelectedFeatures))_@feature.Name?.Replace('.', '_')">
                                    @(feature.DisplayName?.Value ?? feature.Name)
                                    @if (feature.Description is not null && !string.IsNullOrWhiteSpace(feature.Description.Value))
                                    {
                                        <span class="text-muted small d-block">@feature.Description</span>
                                    }
                                </label>
                            </div>
                            @if (dependentCards.Count > 0)
                            {
                                <div class="ms-4 mt-2">
                                    @foreach (var card in dependentCards)
                                    {
                                        @renderCard((card.Parameter, card.Index, !isChecked))
                                    }
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        }

        @{
            var standaloneCards = indexed
                .Where(card => string.IsNullOrWhiteSpace(card.Parameter.Descriptor.RequiredFeature))
                .ToList();
        }

        @if (standaloneCards.Count > 0)
        {
            <label class="form-label fw-semibold">@T["Model parameters"]</label>
            @foreach (var card in standaloneCards)
            {
                @renderCard((card.Parameter, card.Index, false))
            }
        }
    </div>
</div>

<script at="Foot">
    (function () {
        function init() {
            Array.prototype.forEach.call(document.querySelectorAll('.model-parameter-toggle'), function (toggle) {
                if (toggle.dataset.initialized === 'true') {
                    return;
                }

                toggle.dataset.initialized = 'true';

                toggle.addEventListener('change', function () {
                    var body = document.getElementById(toggle.getAttribute('data-target'));

                    if (body) {
                        body.classList.toggle('d-none', !toggle.checked);
                    }
                });
            });

            function applyFeatureDependencies() {
                Array.prototype.forEach.call(document.querySelectorAll('[data-model-parameter-card]'), function (card) {
                    var required = card.getAttribute('data-required-feature');

                    if (!required) {
                        return;
                    }

                    var toggle = document.querySelector('.model-feature-toggle[data-feature-name="' + required + '"]');
                    var enabled = !!(toggle && toggle.checked);
                    card.classList.toggle('d-none', !enabled);

                    Array.prototype.forEach.call(card.querySelectorAll('input, select'), function (field) {
                        // Structural fields must always post so the collection binder never sees a gap.
                        if (field.getAttribute('data-structural') === 'true') {
                            field.disabled = false;

                            return;
                        }

                        field.disabled = !enabled;
                    });
                });
            }

            Array.prototype.forEach.call(document.querySelectorAll('.model-feature-toggle'), function (toggle) {
                if (toggle.dataset.featureInitialized === 'true') {
                    return;
                }

                toggle.dataset.featureInitialized = 'true';

                toggle.addEventListener('change', applyFeatureDependencies);
            });

            applyFeatureDependencies();
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }
    })();
</script>
