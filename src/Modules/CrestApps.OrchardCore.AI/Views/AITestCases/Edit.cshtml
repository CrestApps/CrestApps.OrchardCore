@using CrestApps.OrchardCore.AI.Core
@using CrestApps.OrchardCore.Core.Models

@model EditCatalogEntryViewModel

<zone Name="Title">
    <breadcrumb name="AITestCasesEdit" title="@T["Edit '{0}' test case", Model.DisplayName]">
        <breadcrumb-item id="AITestCases" action="Index" controller="AITestCases" area="CrestApps.OrchardCore.AI" permission="@AIPermissions.ManageAIQuality.Name">@T["AI Tests"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form method="post" asp-route-id="@ViewContext.HttpContext.Request.RouteValues["id"]" class="no-multisubmit">
    @Html.ValidationSummary()
    @await DisplayAsync(Model.Editor)

    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <button class="btn btn-primary" type="submit">@T["Save"]</button>
            <button class="btn btn-success" type="submit" formaction="@Url.Action("Run", "AITestCases", new { area = "CrestApps.OrchardCore.AI", id = ViewContext.HttpContext.Request.RouteValues["id"] })">@T["Run"]</button>
            <a class="btn btn-secondary cancel" role="button" asp-action="Index">@T["Cancel"]</a>
        </div>
    </div>
</form>
