@using CrestApps.Core.AI.Models
@using CrestApps.Core.Models
@using CrestApps.OrchardCore.AI.ViewModels
@using CrestApps.OrchardCore.Core.Models
@using Microsoft.AspNetCore.Mvc.Localization
@using OrchardCore.DisplayManagement

@model ListCatalogEntryViewModel<CatalogEntryViewModel<AIProfile>>

<zone Name="Title">
    <breadcrumb name="AIProfiles" title="@T["AI Profiles"]" />
</zone>

@* The form is necessary to generate an antiforgery token for the delete and toggle actions. *@
<form asp-action="Index" asp-route-pageSize="@Context.Request.Query["pageSize"]" method="post" class="no-multisubmit" data-list-management data-selected-label="@T["selected"]" data-client-side-search="false">
    <input type="submit" name="submit.Filter" id="submitFilter" class="visually-hidden" />
    <input asp-for="Options.BulkAction" type="hidden" />
    <input type="submit" name="submit.BulkAction" class="visually-hidden" />

    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <div class="input-group">
                        <input id="search-box" asp-for="Options.Search" class="form-control" placeholder="@T["Search"]" type="search" autofocus autocomplete="off" />
                        <button type="submit" name="submit.Filter" class="btn btn-outline-secondary" title="@T["Search"]" aria-label="@T["Search"]"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
                    </div>
                </div>
                <div class="col-auto">
                    <button type="button" class="btn btn-secondary create" data-bs-toggle="modal" data-bs-target="#newProfileModal">@T["Add Profile"]</button>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Models.Count == 0 && string.IsNullOrEmpty(Model.Options?.Search))
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <div class="mb-3 text-primary" aria-hidden="true">
                    <i class="fa-solid fa-wand-magic-sparkles fa-2x"></i>
                </div>
                <h2 class="h5">@T["Create your first profile"]</h2>
                <p class="text-body-secondary mb-3">@T["A profile is an AI assistant or task with its own instructions. Pick what you want to build and it is set up for you."]</p>
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newProfileModal">@T["Choose a starting point"]</button>
            </div>
        </div>
    }
    else
    {
        @* The profiles, the toolbar and the pager are rendered by the AdminList shape, in the layout (List or Grid) the site or the user picked. *@
        <admin-list name="AIProfiles" context="Model.List"
                    bulk-actions="Model.Options.BulkActions"
                    empty-message="@T["No profiles match your search."]">
            <admin-list-list item-css-class="list-group-item" />
            <admin-list-grid>
                <admin-list-column type="Select" />
                <admin-list-column name="Name" position="20" title="@T["Name"]" />
                <admin-list-column name="Type" position="30" title="@T["Type"]" width="auto" />
                <admin-list-column name="Modified" position="40" title="@T["Last modified"]" width="auto" />
                <admin-list-column type="Actions" title="@T["Actions"]" />
            </admin-list-grid>
        </admin-list>
    }

    <div id="list-alert" class="alert alert-info my-3 d-none text-center" role="alert">
        @T["Your search returned no results."]
    </div>
</form>

@await Html.PartialAsync("_NewProfileModal", ViewData[ProfileScenarioPickerViewModel.ViewDataKey] as ProfileScenarioPickerViewModel ?? new ProfileScenarioPickerViewModel())

<script asp-name="list-management-ui" at="Foot"></script>
