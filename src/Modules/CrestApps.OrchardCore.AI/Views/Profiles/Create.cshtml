@using CrestApps.Core.Models
@model EditCatalogEntryViewModel

<zone Name="Title">
    <h1>@RenderTitleSegments(T["New '{0}' Profile", Model.DisplayName])</h1>
</zone>

@if (ViewData["IsClone"] is true)
{
    <div class="alert alert-warning" role="alert">
        <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
        @T["This is an unsaved draft cloned from an existing profile. Review the technical name and title, then save to create the new profile."]
    </div>
}

<form method="post" enctype="multipart/form-data" class="no-multisubmit">
    @Html.ValidationSummary()
    @await DisplayAsync(Model.Editor)

    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <button class="btn btn-primary" type="submit">@T["Save"]</button>
            <a class="btn btn-secondary cancel" role="button" asp-route-action="Index">@T["Cancel"]</a>
        </div>
    </div>
</form>
