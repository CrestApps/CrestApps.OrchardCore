@using CrestApps.Core.Models
@using CrestApps.OrchardCore.AI.Core
@model EditCatalogEntryViewModel

<zone Name="Title">
    <breadcrumb name="AIProfilesCreate" title="@T["New Profile"]">
        <breadcrumb-item id="AIProfiles" action="Index" controller="Profiles" area="CrestApps.OrchardCore.AI" permission="@AIPermissions.ManageAIProfiles.Name">@T["AI Profiles"]</breadcrumb-item>
    </breadcrumb>
</zone>

@if (ViewData["IsClone"] is true)
{
    <div class="alert alert-warning" role="alert">
        <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
        @T["This is an unsaved draft cloned from an existing profile. Review the technical name and title, then save to create the new profile."]
    </div>
}

<form method="post" enctype="multipart/form-data" class="no-multisubmit">
    @Html.ValidationSummary()
    @await DisplayAsync(Model.Editor)

    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <button class="btn btn-primary" type="submit">@T["Save"]</button>
            <a class="btn btn-secondary cancel" role="button" asp-route-action="Index">@T["Cancel"]</a>
        </div>
    </div>
</form>
