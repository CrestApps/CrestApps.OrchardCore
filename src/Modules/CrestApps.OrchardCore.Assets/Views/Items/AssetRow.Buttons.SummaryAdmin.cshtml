@model ShapeViewModel<AssetRow>

<a asp-controller="Assets" asp-action="Details" asp-route-id="@Model.Value.Asset.ItemId" class="btn btn-secondary btn-sm">@T["View"]</a>
<a asp-controller="Assets" asp-action="Edit" asp-route-id="@Model.Value.Asset.ItemId" class="btn btn-primary btn-sm">@T["Edit"]</a>
<a asp-controller="Assets" asp-action="Delete" asp-route-id="@Model.Value.Asset.ItemId" class="btn btn-danger btn-sm" data-title="@T["Delete"]" data-message="@T["Delete this asset? An asset with assets inside it can't be deleted."]" data-url-af="RemoveUrl UnsafeUrl">@T["Delete"]</a>
