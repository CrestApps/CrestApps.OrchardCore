@using CrestApps.OrchardCore.Core.Models
@model EditCatalogEntryViewModel

<zone Name="Title"><breadcrumb name="AssetsEdit" title="@(string.IsNullOrEmpty(Model.DisplayName) ? T["Add an Asset"] : T["Edit {0}", Model.DisplayName])" /></zone>

<form asp-action="Edit" asp-route-id="@ViewContext.HttpContext.Request.RouteValues["id"]" method="post" class="no-multisubmit">
    <div asp-validation-summary="All" class="text-danger"></div>
    @await DisplayAsync(Model.Editor)
    <div class="action-bar-bottom">
        <button type="submit" class="btn btn-primary save">@T["Save"]</button>
        <a asp-action="Index" class="btn btn-secondary cancel">@T["Cancel"]</a>
    </div>
</form>
