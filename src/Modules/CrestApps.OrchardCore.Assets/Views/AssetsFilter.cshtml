@{
    var model = (AssetsListViewModel)Model.ViewModel;
    var formId = (string)Model.FormId;
}
<style asp-name="bootstrap-select"></style>
<script asp-name="bootstrap-select" depends-on="bootstrap" at="Foot"></script>

<div class="btn-group filter">
    <select id="assets-type" name="typeId" form="@formId" class="selectpicker show-tick" data-style="btn-sm" data-width="fit" data-header="@T["Asset type"]" data-dropdown-align-right="auto" aria-label="@T["Asset type"]" onchange="this.form.submit()">
        <option value="">@T["Every type"]</option>
        @foreach (var option in model.TypeOptions)
        {
            <option value="@option.Value" selected="@option.Selected">@option.Text</option>
        }
    </select>
</div>
<div class="btn-group filter">
    <select id="assets-status" name="status" form="@formId" class="selectpicker show-tick" data-style="btn-sm" data-width="fit" data-header="@T["State"]" data-dropdown-align-right="auto" aria-label="@T["State"]" onchange="this.form.submit()">
        <option value="">@T["Every state"]</option>
        @foreach (var status in Enum.GetValues<AssetStatus>())
        {
            <option value="@status" selected="@(model.Status == status.ToString())">@status</option>
        }
    </select>
</div>
