<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
    <Title>CrestApps OrchardCore Invoicing</Title>
    <Description>
      $(OCCMSDescription)

      Invoices and credit notes for any business: drafts with line items, discounts, charges and tax, issued with a
      number and posted to the Transactions ledger as what the customer owes, then paid online or by hand, voided,
      written off or corrected with a credit note, and printed and sent as branded business documents.
    </Description>
    <PackageTags>$(PackageTags) CrestApps OrchardCoreCMS Invoicing Invoices Billing CreditNotes Commerce</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrestApps.OrchardCore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OrchardCore.Module.Targets" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="OrchardCore.Admin.Abstractions" />
    <PackageReference Include="OrchardCore.Data.Abstractions" />
    <PackageReference Include="OrchardCore.ContentManagement.Display" />
    <PackageReference Include="OrchardCore.DisplayManagement" />
    <PackageReference Include="OrchardCore.Navigation.Core" />
    <PackageReference Include="OrchardCore.ResourceManagement" />
    <PackageReference Include="OrchardCore.Settings" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Abstractions\CrestApps.OrchardCore.Abstractions\CrestApps.OrchardCore.Abstractions.csproj" />
    <ProjectReference Include="..\..\Abstractions\CrestApps.OrchardCore.Accounts.Abstractions\CrestApps.OrchardCore.Accounts.Abstractions.csproj" />
    <ProjectReference Include="..\..\Abstractions\CrestApps.OrchardCore.Invoicing.Abstractions\CrestApps.OrchardCore.Invoicing.Abstractions.csproj" />
    <ProjectReference Include="..\..\Core\CrestApps.OrchardCore.Core\CrestApps.OrchardCore.Core.csproj" />
    <ProjectReference Include="..\..\Core\CrestApps.OrchardCore.FileStorage.Core\CrestApps.OrchardCore.FileStorage.Core.csproj" />
    <ProjectReference Include="..\..\Core\CrestApps.OrchardCore.Invoicing.Core\CrestApps.OrchardCore.Invoicing.Core.csproj" />
    <ProjectReference Include="..\..\Core\CrestApps.OrchardCore.Recipes.Core\CrestApps.OrchardCore.Recipes.Core.csproj" />
    <ProjectReference Include="..\..\Core\CrestApps.OrchardCore.YesSql.Core\CrestApps.OrchardCore.YesSql.Core.csproj" />
    <!-- Carried for the feature dependencies only: Invoicing's code uses their Abstractions and Core projects. -->
    <ProjectReference Include="..\CrestApps.OrchardCore.Transactions\CrestApps.OrchardCore.Transactions.csproj" />
    <ProjectReference Include="..\CrestApps.OrchardCore.BusinessDocuments\CrestApps.OrchardCore.BusinessDocuments.csproj" />
    <ProjectReference Include="..\CrestApps.OrchardCore.Resources\CrestApps.OrchardCore.Resources.csproj" />
  </ItemGroup>

</Project>
