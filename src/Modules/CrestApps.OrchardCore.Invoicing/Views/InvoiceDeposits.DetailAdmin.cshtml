@model InvoiceDepositsViewModel
@inject CrestApps.OrchardCore.Payments.IMoneyFormatter MoneyFormatter

@if (Model.Invoice.Kind == InvoiceKind.Prepayment)
{
    @if (Model.DepositFor is { } work)
    {
        <div class="card mb-3">
            <div class="card-header">@T["Deposit"]</div>
            <div class="card-body">
                @T["A deposit asked before the work on"]
                <a asp-controller="InvoicesAdmin" asp-action="Detail" asp-route-itemId="@work.ItemId">@(string.IsNullOrEmpty(work.Number) ? T["the draft invoice"].Value : work.Number)</a>.
                @T["Once it is paid, deduct it from that invoice before issuing it."]
            </div>
        </div>
    }
}
else if (Model.Invoice.Status == InvoiceStatus.Draft && Model.CanManage)
{
    <div class="card mb-3">
        <div class="card-header">@T["Deposits"]</div>
        @if (Model.Deductible.Count > 0)
        {
            <ul class="list-group list-group-flush">
                @foreach (var deposit in Model.Deductible)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>
                            <a asp-controller="InvoicesAdmin" asp-action="Detail" asp-route-itemId="@deposit.ItemId">@deposit.Number</a>
                            <span class="text-muted">@T["{0} paid", MoneyFormatter.Format(deposit.AmountPaid, deposit.Currency)]</span>
                        </span>
                        <form asp-controller="InvoiceDeposits" asp-action="Deduct" asp-route-itemId="@Model.Invoice.ItemId" method="post">
                            <input type="hidden" name="prepaymentId" value="@deposit.ItemId" />
                            <button type="submit" class="btn btn-sm btn-primary">@T["Deduct From This Invoice"]</button>
                        </form>
                    </li>
                }
            </ul>
        }
        @if (Model.Requested.Count > 0)
        {
            <div class="card-body pb-0">
                <span class="text-muted">@T["Deposit invoices asked from this invoice:"]</span>
                @foreach (var requested in Model.Requested)
                {
                    <a class="ms-1" asp-controller="InvoicesAdmin" asp-action="Detail" asp-route-itemId="@requested.ItemId">@(string.IsNullOrEmpty(requested.Number) ? T["Draft"].Value : requested.Number)</a>
                }
            </div>
        }
        <div class="card-body">
            <form asp-controller="InvoiceDeposits" asp-action="Ask" asp-route-itemId="@Model.Invoice.ItemId" method="post" class="row g-2 align-items-end">
                <div class="col-sm-4">
                    <label class="form-label" for="deposit-percent">@T["Deposit (%)"]</label>
                    <input id="deposit-percent" name="percent" type="number" step="any" min="0" max="100" class="form-control" />
                </div>
                <div class="col-sm-4">
                    <label class="form-label" for="deposit-amount">@T["or an amount"]</label>
                    <input id="deposit-amount" name="amount" type="number" step="any" min="0" class="form-control" />
                </div>
                <div class="col-sm-4">
                    <button type="submit" class="btn btn-secondary w-100">@T["Ask for a Deposit First"]</button>
                </div>
            </form>
            <span class="hint">@T["Drafts a deposit invoice for part of this invoice, to issue and send now. When it is paid, it shows above, to deduct from this invoice before you issue it."]</span>
        </div>
    </div>
}
