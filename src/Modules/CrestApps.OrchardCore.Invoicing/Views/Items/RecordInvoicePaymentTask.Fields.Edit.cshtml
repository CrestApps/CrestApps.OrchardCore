@using CrestApps.OrchardCore.Invoicing.Workflows

@model InvoiceTaskViewModel

<div class="mb-3">
    <label asp-for="InvoiceId" class="form-label">@T["Invoice id"]</label>
    <input asp-for="InvoiceId" class="form-control code" />
    <span class="hint">@T["The id of the invoice. In a workflow started by an invoice event, write Workflow.Input.InvoiceId in Liquid."]</span>
</div>

<div class="mb-3">
    <label asp-for="Amount" class="form-label">@T["Amount"]</label>
    <input asp-for="Amount" class="form-control code" />
    <span class="hint">@T["Optional. The amount received, with a dot as the decimal separator; what is still due when empty."]</span>
</div>

<div class="mb-3">
    <label asp-for="PaymentMethod" class="form-label">@T["Payment method"]</label>
    <input asp-for="PaymentMethod" class="form-control code" />
    <span class="hint">@T["Optional. How the payment was made, such as Bank transfer."]</span>
</div>

<div class="mb-3">
    <label asp-for="Reference" class="form-label">@T["Reference"]</label>
    <input asp-for="Reference" class="form-control code" />
    <span class="hint">@T["Optional. The payment's reference, such as a check number."]</span>
</div>

<div class="mb-3">
    <label asp-for="Note" class="form-label">@T["Note"]</label>
    <input asp-for="Note" class="form-control code" />
    <span class="hint">@T["Optional. Kept on the transaction's timeline."]</span>
</div>

<div class="mb-3">
    <label asp-for="OutputName" class="form-label">@T["Output name"]</label>
    <input asp-for="OutputName" class="form-control code" />
    <span class="hint">@T["The name the invoice is saved under in the workflow output. Leave empty for Invoice."]</span>
</div>
