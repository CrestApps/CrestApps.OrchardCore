@using CrestApps.OrchardCore.Invoicing.Workflows

@model InvoiceTaskViewModel

<div class="mb-3">
    <label asp-for="InvoiceId" class="form-label">@T["Invoice id"]</label>
    <input asp-for="InvoiceId" class="form-control code" />
    <span class="hint">@T["The id of the invoice. In a workflow started by an invoice event, write Workflow.Input.InvoiceId in Liquid."]</span>
</div>

<div class="mb-3">
    <label asp-for="Reason" class="form-label">@T["Reason"]</label>
    <input asp-for="Reason" class="form-control code" />
    <span class="hint">@T["Optional. Why the invoice is credited."]</span>
</div>

<div class="mb-3">
    <label asp-for="Disposition" class="form-label">@T["Disposition"]</label>
    <input asp-for="Disposition" class="form-control code" />
    <span class="hint">@T["Optional. ReduceBalance, Refund or CustomerCredit; the invoice's default when empty."]</span>
</div>

<div class="mb-3">
    <label asp-for="OutputName" class="form-label">@T["Output name"]</label>
    <input asp-for="OutputName" class="form-control code" />
    <span class="hint">@T["The name the invoice is saved under in the workflow output. Leave empty for Invoice."]</span>
</div>
