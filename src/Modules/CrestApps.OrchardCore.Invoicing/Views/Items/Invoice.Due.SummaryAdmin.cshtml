@model ShapeViewModel<InvoiceDetailViewModel>

@* The due date is a date in the site's time zone, kept as a date: it is shown as it is. *@
@if (Model.Value.Invoice.DueDate is { } dueDate)
{
    <span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Due"]">
        <i class="fa-regular fa-calendar text-secondary" aria-hidden="true"></i><span class="visually-hidden">@T["Due"]</span>
        @dueDate.ToString("d")
    </span>
}
