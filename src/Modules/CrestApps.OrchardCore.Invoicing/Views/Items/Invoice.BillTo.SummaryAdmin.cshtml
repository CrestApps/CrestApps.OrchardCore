@model ShapeViewModel<InvoiceDetailViewModel>

@if (!string.IsNullOrEmpty(Model.Value.BillToName))
{
    <span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Billed to"]">
        <i class="fa-regular fa-user text-secondary" aria-hidden="true"></i><span class="visually-hidden">@T["Billed to"]</span>
        @Model.Value.BillToName
    </span>
}
