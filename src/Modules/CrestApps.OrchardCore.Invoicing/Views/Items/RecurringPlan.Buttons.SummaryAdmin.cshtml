@model ShapeViewModel<RecurringPlanRowViewModel>

@if (Model.Value.CanEdit)
{
    <a asp-action="Edit" asp-controller="RecurringPlansAdmin" asp-route-itemId="@Model.Value.Plan.ItemId" class="btn btn-primary btn-sm">@T["Edit"]</a>
}
<a asp-action="Detail" asp-controller="RecurringPlansAdmin" asp-route-itemId="@Model.Value.Plan.ItemId" class="btn btn-secondary btn-sm">@T["View"]</a>
