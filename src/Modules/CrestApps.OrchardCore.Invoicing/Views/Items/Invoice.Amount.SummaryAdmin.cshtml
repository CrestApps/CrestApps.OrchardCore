@model ShapeViewModel<InvoiceDetailViewModel>
@inject CrestApps.OrchardCore.Payments.IMoneyFormatter MoneyFormatter

@{
    var invoice = Model.Value.Invoice;
}

@if (!string.IsNullOrEmpty(invoice.Currency))
{
    <span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Total"]">
        <i class="fa-solid fa-sack-dollar text-secondary" aria-hidden="true"></i><span class="visually-hidden">@T["Total"]</span>
        @MoneyFormatter.Format(invoice.Totals?.Total ?? 0m, invoice.Currency)
    </span>
    @if (invoice.Status is InvoiceStatus.Open && invoice.AmountDue > 0m && invoice.AmountDue != invoice.Totals?.Total)
    {
        <span class="badge ta-badge bg-warning-subtle fw-normal" data-bs-toggle="tooltip" title="@T["Due"]">
            <i class="fa-solid fa-hourglass-half text-secondary" aria-hidden="true"></i><span class="visually-hidden">@T["Due"]</span>
            @MoneyFormatter.Format(invoice.AmountDue, invoice.Currency)
        </span>
    }
}
