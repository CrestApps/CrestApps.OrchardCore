@model ShapeViewModel<InvoiceDetailViewModel>

@if (Model.Value.CanEdit)
{
    <a asp-action="Edit" asp-controller="InvoicesAdmin" asp-route-itemId="@Model.Value.Invoice.ItemId" class="btn btn-primary btn-sm">@T["Edit"]</a>
}
<a asp-action="Detail" asp-controller="InvoicesAdmin" asp-route-itemId="@Model.Value.Invoice.ItemId" class="btn btn-secondary btn-sm">@T["View"]</a>
