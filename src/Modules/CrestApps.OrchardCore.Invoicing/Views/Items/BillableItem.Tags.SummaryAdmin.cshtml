@model ShapeViewModel<BillableItem>
@inject CrestApps.OrchardCore.Payments.IMoneyFormatter MoneyFormatter

@{
    var item = Model.Value;
}

@if (item.IsBilled)
{
    <span class="badge text-bg-success">@T["Billed"]</span>
}
else
{
    <span class="badge text-bg-warning">@T["Unbilled"]</span>
}
<span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Customer"]">
    <i class="fa-regular fa-user text-secondary" aria-hidden="true"></i><span class="visually-hidden">@T["Customer"]</span>
    @item.PartyName
</span>
@* The day is a date in the site's time zone, kept as a date: it is shown as it is. *@
<span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Day"]">
    <i class="fa-regular fa-calendar text-secondary" aria-hidden="true"></i><span class="visually-hidden">@T["Day"]</span>
    @item.Date.ToString("d")
</span>
<span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Billed at"]">
    <i class="fa-solid fa-sack-dollar text-secondary" aria-hidden="true"></i><span class="visually-hidden">@T["Billed at"]</span>
    @item.Quantity.ToString("0.##") × @MoneyFormatter.Format(item.UnitPrice, item.Currency)
</span>
