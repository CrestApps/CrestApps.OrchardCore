@model InvoiceDocumentPageViewModel

<zone Name="Title">
    <breadcrumb name="InvoicingMyInvoice" title="@T["Invoice {0}", Model.Source.Number]">
        <breadcrumb-item id="CommerceAccount" url="@Url.RouteUrl(CrestApps.OrchardCore.Commerce.CommerceConstants.Account.HomeRouteName)">@T["Your account"]</breadcrumb-item>
        <breadcrumb-item id="InvoicingMyInvoices" url="@Model.BackUrl">@T["Invoices"]</breadcrumb-item>
    </breadcrumb>
</zone>

@{
    var invoice = (Invoice)Model.Source;
    var owed = invoice.Status == InvoiceStatus.Open && invoice.AmountDue > 0m;
}

<style>
    @@media print {
        body * {
            visibility: hidden;
        }

        .business-document-print-area,
        .business-document-print-area * {
            visibility: visible;
        }

        .business-document-print-area {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
        }

        .no-print {
            display: none !important;
        }
    }
</style>

<div class="d-flex flex-wrap gap-2 mb-3 no-print">
    @if (owed)
    {
        <form asp-action="Pay" asp-controller="MyInvoices" asp-area="@InvoicingConstants.Features.Area" method="post">
            <input type="hidden" name="itemIds" value="@invoice.ItemId" />
            <button type="submit" class="btn btn-success">@T["Pay this invoice"]</button>
        </form>
    }
    <a class="btn btn-outline-secondary" href="@Model.PdfUrl">@T["Download PDF"]</a>
    <button type="button" class="btn btn-outline-secondary" onclick="window.print();">@T["Print"]</button>
</div>

<div class="business-document-print-area">
    @await DisplayAsync(await New.BusinessDocument(Document: Model.Document))
</div>
