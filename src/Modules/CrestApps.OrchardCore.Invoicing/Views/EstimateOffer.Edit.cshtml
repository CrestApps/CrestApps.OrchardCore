@model EstimateEditViewModel

<div class="ocat-limited-wrapper" asp-validation-class-for="Currency">
    <label asp-for="Currency" class="ocat-label">@T["Currency"]</label>
    <div class="ocat-limited">
        <input asp-for="Currency" class="form-control text-uppercase" maxlength="3" autocomplete="off" placeholder="USD" />
        <span class="hint">@T["Left empty, the site's default currency is used."]</span>
    </div>
</div>

<div class="ocat-limited-wrapper" asp-validation-class-for="ExpiryDate">
    <label asp-for="ExpiryDate" class="ocat-label">@T["Valid until"]</label>
    <div class="ocat-limited">
        <input asp-for="ExpiryDate" type="date" class="form-control" asp-format="{0:yyyy-MM-dd}" />
        <span class="hint">@T["The last day the customer can accept it. Left empty, it is valid for the number of days set in the invoicing settings from the day it is sent."]</span>
    </div>
</div>

<div class="ocat-limited-wrapper" asp-validation-class-for="DepositPercent">
    <label asp-for="DepositPercent" class="ocat-label">@T["Deposit (%)"]</label>
    <div class="ocat-limited">
        <input asp-for="DepositPercent" type="number" step="any" min="0" max="100" class="form-control" />
        <span class="hint">@T["Optional. The percent of the total asked when the estimate is accepted."]</span>
    </div>
</div>

<div class="ocat-limited-wrapper" asp-validation-class-for="DepositAmount">
    <label asp-for="DepositAmount" class="ocat-label">@T["Deposit (amount)"]</label>
    <div class="ocat-limited">
        <input asp-for="DepositAmount" type="number" step="any" min="0" class="form-control" />
        <span class="hint">@T["Optional. An amount asked instead of a percent."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="OnAcceptance">
    <label asp-for="OnAcceptance" class="ocat-label">@T["When accepted"]</label>
    <div class="ocat-end">
        <select asp-for="OnAcceptance" class="form-select">
            <option value="@EstimateConversion.None">@T["Do nothing; I'll invoice it"]</option>
            <option value="@EstimateConversion.Full">@T["Make a draft invoice of the whole estimate"]</option>
            <option value="@EstimateConversion.Deposit">@T["Make a draft prepayment invoice of the deposit"]</option>
        </select>
        <span class="hint">@T["What happens when the customer accepts it online."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" asp-for="PricesIncludeTax" />
            <label class="form-check-label" asp-for="PricesIncludeTax">@T["Prices include tax"]</label>
            <span class="hint dashed">@T["The prices typed are tax-inclusive, and the tax is worked out of them."]</span>
        </div>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="PurchaseOrderNumber">
    <label asp-for="PurchaseOrderNumber" class="ocat-label">@T["Purchase order"]</label>
    <div class="ocat-end">
        <input asp-for="PurchaseOrderNumber" class="form-control" maxlength="100" autocomplete="off" />
        <span class="hint">@T["The customer's purchase order number, if they gave one."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="Reference">
    <label asp-for="Reference" class="ocat-label">@T["Reference"]</label>
    <div class="ocat-end">
        <input asp-for="Reference" class="form-control" maxlength="100" autocomplete="off" />
        <span class="hint">@T["Your own reference, such as a job or project. Printed and searchable."]</span>
    </div>
</div>
