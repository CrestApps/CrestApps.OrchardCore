@model InvoiceEditViewModel

@{
    var isNew = string.IsNullOrEmpty(Model.ItemId);
    var billToJson = string.IsNullOrEmpty(Model.BillTo)
        ? "[]"
        : System.Text.Json.JsonSerializer.Serialize(new[] { new { value = Model.BillTo, text = Model.BillToName ?? Model.BillTo, selected = true } });
}

<zone Name="Title">
    <breadcrumb name="@(isNew ? "InvoicesCreate" : "InvoicesEdit")" title="@(isNew ? T["New invoice"] : T["Edit draft invoice"])">
        <breadcrumb-item id="InvoicesIndex" action="Index" controller="InvoicesAdmin" area="@InvoicingConstants.Features.Area" permission="@InvoicingPermissions.ViewInvoices.Name">@T["Invoices"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form method="post" class="no-multisubmit">
    @Html.ValidationSummary()

    <div class="card mb-3">
        <div class="card-header">@T["Billed to"]</div>
        <div class="card-body">
            <div class="ocat-wrapper" asp-validation-class-for="BillTo">
                <label class="ocat-label">@T["Customer"]</label>
                <div class="ocat-end">
                    @await Component.InvokeAsync("ItemSelector", new
                    {
                        id = "invoice-bill-to",
                        inputName = Html.NameFor(m => m.BillTo).ToString(),
                        endpoint = Model.PartySearchEndpoint,
                        initialItemsJson = billToJson,
                        multiple = false,
                        enableSearch = true,
                        buttonText = T["Find a customer"].Value,
                        searchPlaceholder = T["Search users, customers and accounts"].Value,
                        emptyResultsText = T["No one found."].Value,
                        noSelectionText = T["No one chosen."].Value,
                        selectedItemsLabel = T["Billed to"].Value,
                        availableItemsLabel = T["Found"].Value,
                        smallButton = false,
                    })
                    <span class="hint">@T["A user, customer or business account. Their billing details are copied onto the invoice when it is issued. Leave it empty to bill someone by name and e-mail only."]</span>
                </div>
            </div>

            <div class="ocat-wrapper" asp-validation-class-for="ContactName">
                <label asp-for="ContactName" class="ocat-label">@T["Name on the invoice"]</label>
                <div class="ocat-end">
                    <input asp-for="ContactName" class="form-control" autocomplete="off" maxlength="255" />
                    <span class="hint">@T["Left empty, the customer's billing name is used."]</span>
                </div>
            </div>

            <div class="ocat-wrapper" asp-validation-class-for="ContactEmail">
                <label asp-for="ContactEmail" class="ocat-label">@T["E-mail"]</label>
                <div class="ocat-end">
                    <input asp-for="ContactEmail" type="email" class="form-control" autocomplete="off" maxlength="255" />
                    <span class="hint">@T["Where the invoice is sent. Left empty, the customer's billing e-mail is used."]</span>
                </div>
            </div>
        </div>
    </div>

    <partial name="_DocumentLinesEditor" model='DocumentLinesEditorViewModel.For(Model, T["Amounts are worked out as you type. The tax is worked out again when you save, and when the invoice is issued."].Value, T["Total"].Value)' />

    @if (Model.CanSchedule)
    {
        <input type="hidden" name="CanSchedule" value="true" />
        var schedulePercent = Model.Schedule.Count > 0 && Model.Schedule.All(row => !row.Amount.HasValue) && Model.Schedule.Any(row => row.Percent.HasValue);
        var scheduleCurrency = Model.Currency ?? string.Empty;
        var scheduleDecimals = string.IsNullOrEmpty(scheduleCurrency) ? 2 : CrestApps.OrchardCore.Currencies.CurrencyScale.GetDecimalPlaces(scheduleCurrency);

        <script asp-name="invoicing-payment-schedule" at="Foot"></script>
        <div class="card mb-3"
             data-payment-schedule
             data-total="@((Model.Totals?.Total ?? 0m).ToString(System.Globalization.CultureInfo.InvariantCulture))"
             data-decimals="@scheduleDecimals"
             data-currency="@scheduleCurrency"
             data-culture="@System.Globalization.CultureInfo.CurrentCulture.Name">
            <div class="card-header">@T["Payment schedule"]</div>
            <div class="card-body">
                <p class="hint">@T["Optional. Split what the invoice totals into parts that fall due on their own dates. When the invoice is issued, each part becomes a payment of its own, with its own reminders, and is charged to the customer's saved card when the invoice is charged automatically."]</p>
                <div class="mb-2" role="radiogroup" aria-label="@T["Give the parts as"]">
                    <span class="me-2">@T["Give the parts as"]</span>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="ScheduleMode" id="ScheduleModeAmount" value="amount" data-schedule-mode checked="@(!schedulePercent)" />
                        <label class="form-check-label" for="ScheduleModeAmount">@T["Amounts"]</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="ScheduleMode" id="ScheduleModePercent" value="percent" data-schedule-mode checked="@schedulePercent" />
                        <label class="form-check-label" for="ScheduleModePercent">@T["Percents of the total"]</label>
                    </div>
                </div>
                <table class="table table-sm mb-2" style="max-width: 32rem;">
                    <thead>
                        <tr>
                            <th scope="col">@T["Due"]</th>
                            <th scope="col" class="text-end">@T["Part"]</th>
                            <th scope="col"><span class="visually-hidden">@T["Remove"]</span></th>
                        </tr>
                    </thead>
                    <tbody data-schedule-body>
                        @for (var i = 0; i < Model.Schedule.Count; i++)
                        {
                            var row = Model.Schedule[i];
                            var value = schedulePercent ? row.Percent : row.Amount ?? row.Percent;
                            <tr data-schedule-row>
                                <td><input type="date" name="Schedule[@i].DueDate" value="@row.DueDate?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" class="form-control form-control-sm" data-schedule-date aria-label="@T["Due"]" /></td>
                                <td>
                                    <div class="input-group input-group-sm">
                                        <input type="number" step="any" min="0" name="Schedule[@i].@(schedulePercent ? "Percent" : "Amount")" value="@value?.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="form-control text-end" data-schedule-value aria-label="@T["Part"]" />
                                        <span class="input-group-text" data-schedule-suffix>@(schedulePercent ? "%" : scheduleCurrency)</span>
                                    </div>
                                </td>
                                <td class="text-end"><button type="button" class="btn btn-link btn-sm text-danger" data-schedule-remove title="@T["Remove"]" aria-label="@T["Remove the part"]"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button></td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th scope="row" class="text-end">@T["Allocated"]</th>
                            <td class="text-end" data-schedule-allocated></td>
                            <td></td>
                        </tr>
                        <tr>
                            <th scope="row" class="text-end">@T["Left to allocate"]</th>
                            <td class="text-end" data-schedule-left></td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
                <template data-schedule-template>
                    <tr data-schedule-row>
                        <td><input type="date" name="Schedule[__index__].DueDate" class="form-control form-control-sm" data-schedule-date aria-label="@T["Due"]" /></td>
                        <td>
                            <div class="input-group input-group-sm">
                                <input type="number" step="any" min="0" name="Schedule[__index__].Amount" class="form-control text-end" data-schedule-value aria-label="@T["Part"]" />
                                <span class="input-group-text" data-schedule-suffix></span>
                            </div>
                        </td>
                        <td class="text-end"><button type="button" class="btn btn-link btn-sm text-danger" data-schedule-remove title="@T["Remove"]" aria-label="@T["Remove the part"]"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button></td>
                    </tr>
                </template>
                <button type="button" class="btn btn-sm btn-outline-primary" data-schedule-add>
                    <i class="fa-solid fa-plus" aria-hidden="true"></i> @T["Add payment"]
                </button>
            </div>
        </div>
    }

    <div class="card mb-3">
        <div class="card-header">@T["Payment"]</div>
        <div class="card-body">
            <div class="ocat-limited-wrapper" asp-validation-class-for="Currency">
                <label asp-for="Currency" class="ocat-label">@T["Currency"]</label>
                <div class="ocat-limited">
                    <input asp-for="Currency" class="form-control text-uppercase" maxlength="3" autocomplete="off" placeholder="USD" />
                    <span class="hint">@T["Left empty, the customer's currency is used."]</span>
                </div>
            </div>

            <div class="ocat-limited-wrapper" asp-validation-class-for="IssueDate">
                <label asp-for="IssueDate" class="ocat-label">@T["Issue date"]</label>
                <div class="ocat-limited">
                    <input asp-for="IssueDate" type="date" class="form-control" asp-format="{0:yyyy-MM-dd}" />
                    <span class="hint">@T["The date printed on the invoice. Left empty, it is dated the day it is issued. The due date is worked out from it."]</span>
                </div>
            </div>

            <div class="ocat-wrapper" asp-validation-class-for="PaymentTermId">
                <label asp-for="PaymentTermId" class="ocat-label">@T["Payment term"]</label>
                <div class="ocat-end">
                    <select asp-for="PaymentTermId" asp-items="Model.PaymentTerms" class="form-select">
                        <option value="">@T["The customer's term, else the default"]</option>
                    </select>
                    <span class="hint">@T["Sets the due date when the invoice is issued."]</span>
                </div>
            </div>

            <div class="ocat-wrapper">
                <div class="ocat-end-offset">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" asp-for="PricesIncludeTax" />
                        <label class="form-check-label" asp-for="PricesIncludeTax">@T["Prices include tax"]</label>
                        <span class="hint dashed">@T["The prices typed are tax-inclusive, and the tax is worked out of them."]</span>
                    </div>
                </div>
            </div>

            <div class="ocat-wrapper">
                <div class="ocat-end-offset">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" asp-for="AllowPartialPayment" />
                        <label class="form-check-label" asp-for="AllowPartialPayment">@T["Let the customer pay part of it"]</label>
                        <span class="hint dashed">@T["The customer can pay any amount up to what is due from the invoice's pay link."]</span>
                    </div>
                </div>
            </div>

            <div class="ocat-wrapper">
                <div class="ocat-end-offset">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" asp-for="AutoCharge" />
                        <label class="form-check-label" asp-for="AutoCharge">@T["Charge the customer's saved card"]</label>
                        <span class="hint dashed">@T["When issued, the invoice is charged to the customer's default saved card: at once when it is due, or on its due date. A declined card is tried again on the retry schedule of the transaction settings; when no card can be charged, the invoice is e-mailed to the customer to pay instead."]</span>
                    </div>
                </div>
            </div>

            <div class="ocat-wrapper">
                <div class="ocat-end-offset">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" asp-for="LateFeesExempt" />
                        <label class="form-check-label" asp-for="LateFeesExempt">@T["No late fees"]</label>
                        <span class="hint dashed">@T["No late fee is charged on this invoice when it is overdue, whatever the late-fee policies say."]</span>
                    </div>
                </div>
            </div>

            <div class="ocat-wrapper" asp-validation-class-for="PurchaseOrderNumber">
                <label asp-for="PurchaseOrderNumber" class="ocat-label">@T["Purchase order"]</label>
                <div class="ocat-end">
                    <input asp-for="PurchaseOrderNumber" class="form-control" maxlength="100" autocomplete="off" />
                    <span class="hint">@T["The customer's purchase order number, printed on the invoice."]</span>
                </div>
            </div>

            <div class="ocat-wrapper" asp-validation-class-for="Reference">
                <label asp-for="Reference" class="ocat-label">@T["Reference"]</label>
                <div class="ocat-end">
                    <input asp-for="Reference" class="form-control" maxlength="100" autocomplete="off" />
                    <span class="hint">@T["Your own reference, such as a job or project. Printed on the invoice and searchable."]</span>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">@T["Printed text"]</div>
        <div class="card-body">
            <div class="ocat-wrapper" asp-validation-class-for="Notes">
                <label asp-for="Notes" class="ocat-label">@T["Notes"]</label>
                <div class="ocat-end">
                    <textarea asp-for="Notes" rows="2" class="form-control" maxlength="4000"></textarea>
                    <span class="hint">@T["Left empty, the default notes from the invoicing settings are printed."]</span>
                </div>
            </div>

            <div class="ocat-wrapper" asp-validation-class-for="Terms">
                <label asp-for="Terms" class="ocat-label">@T["Terms"]</label>
                <div class="ocat-end">
                    <textarea asp-for="Terms" rows="2" class="form-control" maxlength="4000"></textarea>
                    <span class="hint">@T["Left empty, the default terms from the invoicing settings are printed."]</span>
                </div>
            </div>

            <div class="ocat-wrapper" asp-validation-class-for="Footer">
                <label asp-for="Footer" class="ocat-label">@T["Footer"]</label>
                <div class="ocat-end">
                    <textarea asp-for="Footer" rows="2" class="form-control" maxlength="4000"></textarea>
                    <span class="hint">@T["Left empty, the default footer from the invoicing settings is printed."]</span>
                </div>
            </div>

            <div class="ocat-wrapper" asp-validation-class-for="InternalNote">
                <label asp-for="InternalNote" class="ocat-label">@T["Internal note"]</label>
                <div class="ocat-end">
                    <textarea asp-for="InternalNote" rows="2" class="form-control" maxlength="4000"></textarea>
                    <span class="hint">@T["Seen by staff only, never printed."]</span>
                </div>
            </div>
        </div>
    </div>

    <div class="action-bar-bottom">
        <button type="submit" name="submit" value="save" class="btn btn-primary">@T["Save draft"]</button>
        <button type="submit" name="submit" value="update" class="btn btn-secondary">@T["Update"]</button>
        @if (Model.CanIssue)
        {
            <button type="submit" name="submit" value="issue" class="btn btn-success action-bar-secondary">@T["Save and issue"]</button>
        }
        <a class="btn btn-secondary cancel" role="button" href="@(isNew ? Url.Action("Index", "InvoicesAdmin") : Url.Action("Detail", "InvoicesAdmin", new { itemId = Model.ItemId }))">@T["Cancel"]</a>
    </div>
</form>

<script asp-name="item-selector" depends-on="bootstrap-select" at="Foot"></script>
