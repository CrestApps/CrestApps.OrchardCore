@model InvoicingSettingsViewModel

<div class="ocat-wrapper" asp-validation-class-for="DefaultPaymentTermId">
    <label asp-for="DefaultPaymentTermId" class="ocat-label">@T["Default payment term"]</label>
    <div class="ocat-end">
        <select asp-for="DefaultPaymentTermId" asp-items="Model.PaymentTerms" class="form-select">
            <option value="">@T["Due on issue"]</option>
        </select>
        <span asp-validation-for="DefaultPaymentTermId"></span>
        <span class="hint">@T["The term a new invoice uses when its customer has none. Payment terms are kept under Commerce > Payment terms."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="DefaultCurrency">
    <label asp-for="DefaultCurrency" class="ocat-label">@T["Default currency"]</label>
    <div class="ocat-end">
        <input asp-for="DefaultCurrency" class="form-control" maxlength="3" placeholder="USD" />
        <span asp-validation-for="DefaultCurrency"></span>
        <span class="hint">@T["The three-letter code a new invoice uses when its customer has no currency of their own."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <div class="ocat-label"></div>
    <div class="ocat-end">
        <div class="form-check">
            <input asp-for="PricesIncludeTax" class="form-check-input" />
            <label asp-for="PricesIncludeTax" class="form-check-label">@T["Prices include tax"]</label>
            <span class="hint dashed">@T["New invoices take their line prices as tax-inclusive, and the tax is worked out of them."]</span>
        </div>
    </div>
</div>

<div class="ocat-wrapper">
    <div class="ocat-label"></div>
    <div class="ocat-end">
        <div class="form-check">
            <input asp-for="AllowPartialPayment" class="form-check-input" />
            <label asp-for="AllowPartialPayment" class="form-check-label">@T["Let customers pay part of an invoice"]</label>
            <span class="hint dashed">@T["Customers can pay any amount up to what is due from the invoice's pay link."]</span>
        </div>
    </div>
</div>

<div class="ocat-wrapper">
    <div class="ocat-label"></div>
    <div class="ocat-end">
        <div class="form-check">
            <input asp-for="IssueOnSend" class="form-check-input" />
            <label asp-for="IssueOnSend" class="form-check-label">@T["Sending a draft issues it"]</label>
            <span class="hint dashed">@T["Sending a draft to the customer first issues it, so it gets its number. Otherwise only issued invoices can be sent."]</span>
        </div>
    </div>
</div>

<div class="ocat-wrapper">
    <div class="ocat-label"></div>
    <div class="ocat-end">
        <div class="form-check">
            <input asp-for="AllowFutureIssueDate" class="form-check-input" />
            <label asp-for="AllowFutureIssueDate" class="form-check-label">@T["Allow issue dates after today"]</label>
            <span class="hint dashed">@T["An invoice can be issued with a date in the future. Otherwise it is dated the day it is issued or earlier."]</span>
        </div>
    </div>
</div>

<div class="ocat-wrapper">
    <div class="ocat-label"></div>
    <div class="ocat-end">
        <div class="form-check">
            <input asp-for="ChronologicalIssueDates" class="form-check-input" />
            <label asp-for="ChronologicalIssueDates" class="form-check-label">@T["Date invoices in the order they are numbered"]</label>
            <span class="hint dashed">@T["An invoice can't be dated before the last invoice issued, so numbers and dates go up together, as some countries require."]</span>
        </div>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="CashRoundingIncrement">
    <label asp-for="CashRoundingIncrement" class="ocat-label">@T["Cash rounding"]</label>
    <div class="ocat-end">
        <input asp-for="CashRoundingIncrement" type="number" step="0.01" min="0" class="form-control" />
        <span asp-validation-for="CashRoundingIncrement"></span>
        <span class="hint">@T["Round each invoice's total to this step, such as 0.05, and print the difference as a rounding line. Leave empty for no rounding."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="ShareLinkDays">
    <label asp-for="ShareLinkDays" class="ocat-label">@T["Share links last (days)"]</label>
    <div class="ocat-end">
        <input asp-for="ShareLinkDays" type="number" min="1" max="3650" class="form-control" />
        <span asp-validation-for="ShareLinkDays"></span>
        <span class="hint">@T["How long the link that shows an invoice to the customer without signing in keeps working."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="EstimateValidDays">
    <label asp-for="EstimateValidDays" class="ocat-label">@T["Estimates are valid for (days)"]</label>
    <div class="ocat-end">
        <input asp-for="EstimateValidDays" type="number" min="1" max="3650" class="form-control" />
        <span asp-validation-for="EstimateValidDays"></span>
        <span class="hint">@T["How long the customer can accept a sent estimate that has no expiry date of its own. Used with the Estimates feature."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="DefaultNotes">
    <label asp-for="DefaultNotes" class="ocat-label">@T["Default notes"]</label>
    <div class="ocat-end">
        <textarea asp-for="DefaultNotes" rows="3" class="form-control"></textarea>
        <span class="hint">@T["Printed on every invoice that has no notes of its own, such as a thank-you."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="DefaultTerms">
    <label asp-for="DefaultTerms" class="ocat-label">@T["Default terms"]</label>
    <div class="ocat-end">
        <textarea asp-for="DefaultTerms" rows="3" class="form-control"></textarea>
        <span class="hint">@T["Printed on every invoice that has no terms of its own, such as how to pay by bank transfer."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="DefaultFooter">
    <label asp-for="DefaultFooter" class="ocat-label">@T["Default footer"]</label>
    <div class="ocat-end">
        <textarea asp-for="DefaultFooter" rows="2" class="form-control"></textarea>
        <span class="hint">@T["Printed at the bottom of every invoice that has no footer of its own."]</span>
    </div>
</div>
