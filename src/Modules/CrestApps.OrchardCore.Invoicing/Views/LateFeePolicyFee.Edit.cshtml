@model LateFeePolicyViewModel

<div class="ocat-wrapper" asp-validation-class-for="Kind">
    <label asp-for="Kind" class="ocat-label">@T["Each fee is"]</label>
    <div class="ocat-end">
        <select asp-for="Kind" class="form-select">
            <option value="@LateFeeKind.Flat">@T["A fixed amount"]</option>
            <option value="@LateFeeKind.Percent">@T["A percent of what is still due"]</option>
        </select>
    </div>
</div>
<div class="ocat-limited-wrapper" asp-validation-class-for="Amount">
    <label asp-for="Amount" class="ocat-label">@T["Amount"]</label>
    <div class="ocat-limited">
        <input asp-for="Amount" type="number" step="any" min="0" class="form-control" />
        <span asp-validation-for="Amount" class="text-danger"></span>
        <span class="hint">@T["For a fixed fee: the amount, in the invoice's currency."]</span>
    </div>
</div>
<div class="ocat-limited-wrapper" asp-validation-class-for="Percent">
    <label asp-for="Percent" class="ocat-label">@T["Percent"]</label>
    <div class="ocat-limited">
        <input asp-for="Percent" type="number" step="any" min="0" max="100" class="form-control" />
        <span asp-validation-for="Percent" class="text-danger"></span>
        <span class="hint">@T["For a percent fee: the percent of what is still due when the fee is charged."]</span>
    </div>
</div>
<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input asp-for="Taxable" class="form-check-input" />
            <label asp-for="Taxable" class="form-check-label">@T["Tax the fee"]</label>
            <span class="hint dashed">@T["Off, the fee is out of scope of tax, which is usual for late fees. On, it is taxed as the site's tax settings say."]</span>
        </div>
    </div>
</div>
