@using CrestApps.OrchardCore.Core.Models
@model EditCatalogEntryViewModel

<zone Name="Title">
    <breadcrumb name="BillableItemsEdit" title="@T["Edit charge"]">
        <breadcrumb-item id="BillableItemsIndex" action="Index" controller="BillableItems" area="@InvoicingConstants.Features.Area" permission="@InvoicingPermissions.ManageInvoices.Name">@T["Unbilled charges"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form method="post" enctype="multipart/form-data" class="no-multisubmit">
    @Html.ValidationSummary()
    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <button class="btn btn-primary" type="submit">@T["Save"]</button>
        <a class="btn btn-secondary cancel" role="button" asp-route-action="Index">@T["Cancel"]</a>
    </div>
</form>

<script asp-name="item-selector" depends-on="bootstrap-select" at="Foot"></script>
