@model CreditNoteEditViewModel
@inject CrestApps.OrchardCore.Payments.IMoneyFormatter MoneyFormatter

@{
    var currency = Model.Currency;
    var totals = Model.Totals ?? new DocumentTotals();
    string Money(decimal amount) => string.IsNullOrEmpty(currency) ? amount.ToString("0.00") : MoneyFormatter.Format(amount, currency);
}

<zone Name="Title">
    <breadcrumb name="CreditNotesEdit" title="@T["Draft credit note for invoice {0}", Model.InvoiceNumber]">
        <breadcrumb-item id="InvoicesIndex" action="Index" controller="InvoicesAdmin" area="@InvoicingConstants.Features.Area" permission="@InvoicingPermissions.ViewInvoices.Name">@T["Invoices"]</breadcrumb-item>
        <breadcrumb-item id="InvoicesDetail" action="Detail" controller="InvoicesAdmin" area="@InvoicingConstants.Features.Area" route-itemId="@Model.InvoiceId" permission="@InvoicingPermissions.ViewInvoices.Name">@T["Invoice {0}", Model.InvoiceNumber]</breadcrumb-item>
    </breadcrumb>
</zone>

<form method="post" class="no-multisubmit">
    @Html.ValidationSummary()

    <div class="card mb-3">
        <div class="card-header">@T["Credit"]</div>
        <div class="card-body">
            <div class="ocat-wrapper" asp-validation-class-for="Reason">
                <label asp-for="Reason" class="ocat-label">@T["Reason"]</label>
                <div class="ocat-end">
                    <input asp-for="Reason" class="form-control" maxlength="500" autocomplete="off" />
                    <span class="hint">@T["Why the invoice is credited, such as goods returned or a price corrected. Printed on the credit note."]</span>
                </div>
            </div>

            <div class="ocat-wrapper" asp-validation-class-for="Disposition">
                <label asp-for="Disposition" class="ocat-label">@T["Give the credit by"]</label>
                <div class="ocat-end">
                    <select asp-for="Disposition" asp-items="Model.Dispositions" class="form-select"></select>
                    <span class="hint">@T["Lowering what is owed works while the invoice is not paid in full. Once it is paid, refund the money or keep it as the customer's credit for their next purchase or invoice."]</span>
                </div>
            </div>

            <div class="ocat-wrapper" asp-validation-class-for="Notes">
                <label asp-for="Notes" class="ocat-label">@T["Notes"]</label>
                <div class="ocat-end">
                    <textarea asp-for="Notes" rows="2" class="form-control" maxlength="4000"></textarea>
                </div>
            </div>
        </div>
    </div>

    <partial name="_DocumentLinesEditor" model='DocumentLinesEditorViewModel.For(Model, string.Format(System.Globalization.CultureInfo.CurrentCulture, T["Lower a quantity or price to credit part of a line, or remove a line to leave it out. At most {0} can still be credited on this invoice."].Value, Money(Model.Creditable)), T["Total credited"].Value)' />

    <div class="action-bar-bottom">
        <button type="submit" name="submit" value="save" class="btn btn-primary">@T["Save draft"]</button>
        <button type="submit" name="submit" value="update" class="btn btn-secondary">@T["Update"]</button>
        @if (Model.CanIssue)
        {
            <button type="submit" name="submit" value="issue" class="btn btn-success action-bar-secondary">@T["Save and issue"]</button>
        }
        <a class="btn btn-secondary cancel" role="button" href="@Url.Action("Detail", "CreditNotesAdmin", new { itemId = Model.ItemId })">@T["Cancel"]</a>
    </div>
</form>
