@model UsageMeterUsageViewModel

@{
    var meter = Model.Meter;
}

<zone Name="Title">
    <breadcrumb name="UsageMetersUsage" title="@(new Microsoft.AspNetCore.Html.HtmlString(System.Net.WebUtility.HtmlEncode(meter.Name)))">
        <breadcrumb-item id="UsageMetersIndex" action="Index" controller="UsageMeters" area="@InvoicingConstants.Features.Area" permission="@InvoicingPermissions.ManageInvoices.Name">@T["Usage meters"]</breadcrumb-item>
    </breadcrumb>
</zone>

<div class="row">
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-header">@T["Latest usage"]</div>
            @if (Model.Records.Count == 0)
            {
                <div class="card-body text-muted">@T["No usage was recorded on this meter yet."]</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th scope="col">@T["When"]</th>
                                <th scope="col">@T["Customer"]</th>
                                <th scope="col" class="text-end">@T["Quantity"]</th>
                                <th scope="col">@T["Event id"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.Records)
                            {
                                <tr>
                                    <td>@row.OccurredLocal.ToString("g")</td>
                                    <td>@row.PartyName</td>
                                    <td class="text-end">@row.Record.Quantity.ToString("#,0.######") @meter.Unit</td>
                                    <td><code class="small">@row.Record.EventId</code></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header">@T["Record usage"]</div>
            <form asp-action="Record" asp-route-id="@meter.ItemId" method="post" class="card-body no-multisubmit">
                <div class="mb-3">
                    <label class="form-label">@T["Customer"]</label>
                    @await Component.InvokeAsync("ItemSelector", new
                    {
                        id = "usage-party",
                        inputName = "party",
                        endpoint = Model.PartySearchEndpoint,
                        initialItemsJson = "[]",
                        multiple = false,
                        enableSearch = true,
                        buttonText = T["Find a customer"].Value,
                        searchPlaceholder = T["Search users, customers and accounts"].Value,
                        emptyResultsText = T["No one found."].Value,
                        noSelectionText = T["No one chosen."].Value,
                        selectedItemsLabel = T["Customer"].Value,
                        availableItemsLabel = T["Found"].Value,
                        smallButton = false,
                    })
                </div>
                <div class="mb-3">
                    <label class="form-label" for="usage-quantity">@T["Quantity"]</label>
                    <div class="input-group">
                        <input id="usage-quantity" name="quantity" type="number" step="any" min="0" class="form-control" required />
                        @if (!string.IsNullOrEmpty(meter.Unit))
                        {
                            <span class="input-group-text">@meter.Unit</span>
                        }
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="usage-when">@T["When"]</label>
                    <input id="usage-when" name="occurredLocal" type="datetime-local" class="form-control" value="@Model.OccurredLocal.ToString("yyyy-MM-ddTHH:mm")" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="usage-event">@T["Event id"]</label>
                    <input id="usage-event" name="eventId" class="form-control" maxlength="52" />
                    <span class="hint">@T["Optional. Recording the same event id again does nothing, so a retry is never counted twice."]</span>
                </div>
                <button type="submit" class="btn btn-primary">@T["Record"]</button>
            </form>
        </div>
        <div class="card mb-3">
            <div class="card-body small">
                <p class="mb-1">@T["Code"]: <code>@meter.Code</code></p>
                <p class="mb-0">@T["Systems record usage through the commerce API (POST usage) with the meter's code, the customer, the quantity and an event id."]</p>
            </div>
        </div>
    </div>
</div>
