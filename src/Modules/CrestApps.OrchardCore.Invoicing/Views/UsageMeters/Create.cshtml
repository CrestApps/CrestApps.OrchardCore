@using CrestApps.OrchardCore.Core.Models
@model EditCatalogEntryViewModel

<zone Name="Title">
    <breadcrumb name="UsageMetersCreate" title="@T["New Usage Meter"]">
        <breadcrumb-item id="UsageMetersIndex" action="Index" controller="UsageMeters" area="@InvoicingConstants.Features.Area" permission="@InvoicingPermissions.ManageInvoices.Name">@T["Usage Meters"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form method="post" enctype="multipart/form-data" class="no-multisubmit">
    @Html.ValidationSummary()
    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <button class="btn btn-primary" type="submit">@T["Save"]</button>
        <a class="btn btn-secondary cancel" role="button" asp-route-action="Index">@T["Cancel"]</a>
    </div>
</form>
