@model LateFeePolicyViewModel

<div class="card mb-3">
    <div class="card-header">@T["The policy"]</div>
    <div class="card-body">
        <div class="ocat-wrapper" asp-validation-class-for="Name">
            <label asp-for="Name" class="ocat-label ocat-label-required">@T["Name"]</label>
            <div class="ocat-end">
                <input asp-for="Name" class="form-control" maxlength="255" />
                <span asp-validation-for="Name" class="text-danger"></span>
                <span class="hint">@T["Seen by staff, such as 1.5% a month or $25 after 30 days."]</span>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="Description">
            <label asp-for="Description" class="ocat-label">@T["Notes"]</label>
            <div class="ocat-end">
                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
            </div>
        </div>
        <div class="ocat-wrapper">
            <div class="ocat-end-offset">
                <div class="form-check">
                    <input asp-for="Enabled" class="form-check-input" />
                    <label asp-for="Enabled" class="form-check-label">@T["Charge late fees under this policy"]</label>
                    <span class="hint dashed">@T["Turn it off to stop charging new fees. Fees already charged stay as they are."]</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">@T["The fee"]</div>
    <div class="card-body">
        <div class="ocat-wrapper" asp-validation-class-for="Kind">
            <label asp-for="Kind" class="ocat-label">@T["Each fee is"]</label>
            <div class="ocat-end">
                <select asp-for="Kind" class="form-select">
                    <option value="@LateFeeKind.Flat">@T["A fixed amount"]</option>
                    <option value="@LateFeeKind.Percent">@T["A percent of what is still due"]</option>
                </select>
            </div>
        </div>
        <div class="ocat-limited-wrapper" asp-validation-class-for="Amount">
            <label asp-for="Amount" class="ocat-label">@T["Amount"]</label>
            <div class="ocat-limited">
                <input asp-for="Amount" type="number" step="any" min="0" class="form-control" />
                <span asp-validation-for="Amount" class="text-danger"></span>
                <span class="hint">@T["For a fixed fee: the amount, in the invoice's currency."]</span>
            </div>
        </div>
        <div class="ocat-limited-wrapper" asp-validation-class-for="Percent">
            <label asp-for="Percent" class="ocat-label">@T["Percent"]</label>
            <div class="ocat-limited">
                <input asp-for="Percent" type="number" step="any" min="0" max="100" class="form-control" />
                <span asp-validation-for="Percent" class="text-danger"></span>
                <span class="hint">@T["For a percent fee: the percent of what is still due when the fee is charged."]</span>
            </div>
        </div>
        <div class="ocat-wrapper">
            <div class="ocat-end-offset">
                <div class="form-check">
                    <input asp-for="Taxable" class="form-check-input" />
                    <label asp-for="Taxable" class="form-check-label">@T["Tax the fee"]</label>
                    <span class="hint dashed">@T["Off, the fee is out of scope of tax, which is usual for late fees. On, it is taxed as the site's tax settings say."]</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">@T["When it is charged"]</div>
    <div class="card-body">
        <div class="ocat-limited-wrapper" asp-validation-class-for="GraceDays">
            <label asp-for="GraceDays" class="ocat-label">@T["Grace days"]</label>
            <div class="ocat-limited">
                <input asp-for="GraceDays" type="number" min="0" max="365" class="form-control" />
                <span asp-validation-for="GraceDays" class="text-danger"></span>
                <span class="hint">@T["How many days after the due date pass before the first fee. 0 charges it the day after the due date."]</span>
            </div>
        </div>
        <div class="ocat-limited-wrapper" asp-validation-class-for="RepeatEveryDays">
            <label asp-for="RepeatEveryDays" class="ocat-label">@T["Repeat every (days)"]</label>
            <div class="ocat-limited">
                <input asp-for="RepeatEveryDays" type="number" min="1" class="form-control" />
                <span class="hint">@T["Optional. Charges another fee this many days after each one while the invoice is unpaid, such as 30 for a monthly fee. Empty charges one fee only."]</span>
            </div>
        </div>
        <div class="ocat-limited-wrapper" asp-validation-class-for="MaxFees">
            <label asp-for="MaxFees" class="ocat-label">@T["Most fees"]</label>
            <div class="ocat-limited">
                <input asp-for="MaxFees" type="number" min="1" class="form-control" />
                <span asp-validation-for="MaxFees" class="text-danger"></span>
                <span class="hint">@T["Optional, for a repeating fee. The most fees charged on one invoice."]</span>
            </div>
        </div>
        <div class="ocat-limited-wrapper" asp-validation-class-for="CapAmount">
            <label asp-for="CapAmount" class="ocat-label">@T["Cap"]</label>
            <div class="ocat-limited">
                <input asp-for="CapAmount" type="number" step="any" min="0" class="form-control" />
                <span asp-validation-for="CapAmount" class="text-danger"></span>
                <span class="hint">@T["Optional. The most charged in late fees on one invoice; the last fee is lowered to stay within it."]</span>
            </div>
        </div>
        <div class="ocat-limited-wrapper" asp-validation-class-for="MinimumBalance">
            <label asp-for="MinimumBalance" class="ocat-label">@T["Minimum balance"]</label>
            <div class="ocat-limited">
                <input asp-for="MinimumBalance" type="number" step="any" min="0" class="form-control" />
                <span class="hint">@T["Optional. No fee is charged while less than this is still due."]</span>
            </div>
        </div>
        <div class="ocat-wrapper">
            <div class="ocat-end-offset">
                <div class="form-check">
                    <input asp-for="SendDebitNote" class="form-check-input" />
                    <label asp-for="SendDebitNote" class="form-check-label">@T["E-mail each fee to the customer"]</label>
                    <span class="hint dashed">@T["Each fee is a debit note, numbered like an invoice and linked to the overdue invoice. On, it is e-mailed to the customer with its PDF and pay link once issued."]</span>
                </div>
            </div>
        </div>
    </div>
</div>
