<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <Title>CrestApps OrchardCore Surveys Module</Title>
    <Description>
      $(CrestAppsDescription)

      Surveys, polls, forms and quizzes: a designer with pages, logic, randomization and question pools, extensible
      question types, immutable versions, public links, invitations and embeds, access rules and limits, anonymous
      responses, scoring and grading, results reports, data sets, recipes and workflow events.
    </Description>
    <PackageTags>$(PackageTags) Surveys Forms Polls Quizzes NPS CSAT</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
