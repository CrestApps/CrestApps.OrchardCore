@model CrestApps.OrchardCore.Surveys.Core.ViewModels.SurveyControlViewModel
@using CrestApps.OrchardCore.Surveys.Core.Controls.Boolean

@{
    var settings = Model.GetSettings<BooleanSettings>();
    var yes = !string.IsNullOrWhiteSpace(settings.TrueLabel) ? settings.TrueLabel : settings.Display == BooleanDisplay.TrueFalse ? T["True"].Value : T["Yes"].Value;
    var no = !string.IsNullOrWhiteSpace(settings.FalseLabel) ? settings.FalseLabel : settings.Display == BooleanDisplay.TrueFalse ? T["False"].Value : T["No"].Value;
    var value = Model.Answer?.Values?.FirstOrDefault();
}
@if (settings.Display == BooleanDisplay.ConsentCheckbox || settings.Display == BooleanDisplay.Toggle)
{
    <input type="hidden" name="@Model.Prefix" value="@BooleanValues.False" disabled="@Model.ReadOnly" />
    <div class="form-check @(settings.Display == BooleanDisplay.Toggle ? "form-switch" : null)">
        <input class="form-check-input" type="checkbox" role="@(settings.Display == BooleanDisplay.Toggle ? "switch" : null)" name="@Model.Prefix" id="@Model.InputId" value="@BooleanValues.True" checked="@(value == BooleanValues.True)" disabled="@Model.ReadOnly" aria-required="@(Model.Question.Required ? "true" : null)" aria-describedby="@Model.DescribedBy()" aria-invalid="@(Model.HasErrors ? "true" : null)" />
        <label class="form-check-label" for="@Model.InputId">@(settings.Display == BooleanDisplay.ConsentCheckbox ? Model.Question.Title : yes)</label>
    </div>
}
else
{
    <fieldset role="radiogroup" aria-required="@(Model.Question.Required ? "true" : null)" aria-describedby="@Model.DescribedBy()">
        <legend class="visually-hidden">@Model.Question.Title</legend>
        <div class="d-flex gap-2">
            <input class="btn-check" type="radio" name="@Model.Prefix" id="@(Model.InputId)-true" value="@BooleanValues.True" checked="@(value == BooleanValues.True)" disabled="@Model.ReadOnly" autocomplete="off" />
            <label class="btn btn-outline-primary" for="@(Model.InputId)-true">@yes</label>
            <input class="btn-check" type="radio" name="@Model.Prefix" id="@(Model.InputId)-false" value="@BooleanValues.False" checked="@(value == BooleanValues.False)" disabled="@Model.ReadOnly" autocomplete="off" />
            <label class="btn btn-outline-primary" for="@(Model.InputId)-false">@no</label>
        </div>
    </fieldset>
}

@if (Model.HasErrors)
{
    <div id="@Model.ErrorId" class="invalid-feedback d-block" role="alert">
        @foreach (var error in Model.Errors)
        {
            <div>@error</div>
        }
    </div>
}
