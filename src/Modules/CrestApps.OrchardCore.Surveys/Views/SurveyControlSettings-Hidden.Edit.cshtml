@model CrestApps.OrchardCore.Surveys.Core.ViewModels.SurveyControlSettingsViewModel<CrestApps.OrchardCore.Surveys.Core.Controls.Hidden.HiddenSettings>

<div class="ocat-wrapper">
    <label asp-for="Settings.VariableName" class="ocat-label">@T["Variable"]</label>
    <div class="ocat-end">
        <input asp-for="Settings.VariableName" class="form-control" type="text" />
        <span class="hint">@T["The hidden variable this question records; empty uses the question's variable code."]</span>
    </div>
</div>
