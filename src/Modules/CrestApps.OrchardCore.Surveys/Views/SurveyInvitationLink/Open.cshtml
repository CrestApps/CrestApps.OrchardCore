@model CrestApps.OrchardCore.Surveys.ViewModels.SurveyInvitationOpenViewModel

<zone Name="Title">
    <breadcrumb name="SurveyInvitationOpen" title="@Html.Raw(Html.Encode(Model.Title))">
        <breadcrumb-item id="Home" url="@Url.Content("~/")">@T["Home"]</breadcrumb-item>
    </breadcrumb>
</zone>

<partial name="_SurveyRunnerStyles" />

<div class="container survey-runner my-4">
    <div class="survey-landing">
        <h1 class="h3 mb-3">@Model.Title</h1>

        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="alert alert-warning" role="alert">@Model.Message</div>
        }

        @{
            var autoStart = !Model.NeedsCaptcha && string.IsNullOrEmpty(Model.Statement);
        }
        <form action="@Url.Content("~/s/i/" + Uri.EscapeDataString(Model.Token))" method="post" class="no-multisubmit" data-survey-autostart="@(autoStart ? "true" : null)">
            @Html.AntiForgeryToken()

            @if (!string.IsNullOrEmpty(Model.Statement))
            {
                <div class="mb-3 survey-statement">
                    <p class="mb-2" id="survey-statement-text">@Model.Statement</p>
                    <div class="form-check">
                        <input type="checkbox" id="survey-accept-statement" name="acceptStatement" value="true" class="form-check-input" required aria-required="true" aria-describedby="survey-statement-text" />
                        <label for="survey-accept-statement" class="form-check-label">@T["I accept this statement"]</label>
                    </div>
                </div>
            }

            @if (Model.NeedsCaptcha)
            {
                <div class="mb-3">
                    <captcha mode="AlwaysShow" />
                </div>
            }

            <button type="submit" class="btn btn-primary">@T["Start"]</button>
        </form>

        @if (autoStart)
        {
            <script at="Foot">
                (function () {
                    var form = document.querySelector('[data-survey-autostart="true"]');

                    if (form) {
                        form.submit();
                    }
                })();
            </script>
        }
    </div>
</div>
