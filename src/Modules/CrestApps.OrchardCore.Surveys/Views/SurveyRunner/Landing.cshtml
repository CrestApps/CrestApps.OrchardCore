@model CrestApps.OrchardCore.Surveys.ViewModels.SurveyLandingViewModel

<zone Name="Title">
    <breadcrumb name="SurveyRunnerLanding" title="@Html.Raw(Html.Encode(Model.Title))">
        <breadcrumb-item id="Home" url="@Url.Content("~/")">@T["Home"]</breadcrumb-item>
    </breadcrumb>
</zone>

<div class="survey-landing @Model.Survey.Draft?.Presentation?.CssClass">
    <h1 class="h3 mb-3">@Model.Title</h1>

    @if (!string.IsNullOrWhiteSpace(Model.Introduction))
    {
        <div class="survey-introduction mb-4">@Html.Raw(Model.Introduction)</div>
    }

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-warning" role="alert">@Model.Message</div>
    }

    @if (Model.CanStart)
    {
        <form action="@Url.Content("~/s/" + Model.Token + "/start")@Model.QueryString" method="post" class="no-multisubmit">
            @Html.AntiForgeryToken()

            @if (Model.NeedsPassword)
            {
                <div class="mb-3">
                    <label for="survey-password" class="form-label">@T["Password"]</label>
                    <input type="password" id="survey-password" name="password" class="form-control" autocomplete="new-password" data-1p-ignore data-lpignore="true" data-bwignore required aria-required="true" />
                </div>
            }

            @if (Model.NeedsCaptcha)
            {
                <div class="mb-3">
                    <captcha mode="AlwaysShow" />
                </div>
            }

            <button type="submit" class="btn btn-primary">@T["Start"]</button>
        </form>
    }

    @if (Model.ShowResultsLink)
    {
        <p class="mt-3"><a href="@Url.Content("~/s/" + Model.Token + "/results")">@T["See the results"]</a></p>
    }
</div>
