@using CrestApps.OrchardCore.Surveys.ViewModels
@using System.Globalization
@model SurveyAccessEditViewModel

@{
    var days = CultureInfo.CurrentCulture.DateTimeFormat.DayNames;
}

<div class="card mb-3">
    <div class="card-header">@T["Who may respond"]</div>
    <div class="card-body">
        <div class="ocat-wrapper">
            <label asp-for="Audience" class="ocat-label">@T["Audience"]</label>
            <div class="ocat-end">
                <select asp-for="Audience" class="form-select">
                    <option value="@SurveyAudienceMode.Anyone">@T["Anyone with the link"]</option>
                    <option value="@SurveyAudienceMode.SignedIn">@T["Signed-in users"]</option>
                    <option value="@SurveyAudienceMode.Audiences">@T["Members of chosen audiences"]</option>
                    <option value="@SurveyAudienceMode.InvitationOnly">@T["Only invited people"]</option>
                </select>
            </div>
        </div>
        <div class="ocat-wrapper">
            <span class="ocat-label" id="survey-audiences-label">@T["Audiences"]</span>
            <div class="ocat-end" role="group" aria-labelledby="survey-audiences-label">
                @if (Model.AudienceOptions.Count == 0)
                {
                    <p class="form-text mb-1">@(Model.AudiencesAvailable ? T["No audience exists yet. Add one under Content > User Audiences."] : T["Turn on the User Audiences feature to choose audiences."])</p>
                }
                @for (var i = 0; i < Model.AudienceOptions.Count; i++)
                {
                    var option = Model.AudienceOptions[i];
                    var inputId = Html.IdFor(m => m.AudienceIds) + "_" + i;

                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="@inputId" name="@Html.NameFor(m => m.AudienceIds)" value="@option.Value" checked="@option.Selected" />
                        <label class="form-check-label" for="@inputId">@option.Text</label>
                    </div>
                }
                <span asp-validation-for="AudienceIds" class="text-danger"></span>
                <span class="hint">@T["Used when the audience is Members of chosen audiences: a person may respond when they belong to any audience checked here."]</span>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="RequireCaptcha" class="ocat-label">@T["CAPTCHA"]</label>
            <div class="ocat-end">
                <div class="form-check">
                    <input asp-for="RequireCaptcha" type="checkbox" class="form-check-input" />
                    <label asp-for="RequireCaptcha" class="form-check-label">@T["Ask respondents who are not signed in to pass a CAPTCHA"]</label>
                    <span class="hint dashed">@T["Needs the reCAPTCHA feature."]</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">@T["Anonymity"]</div>
    <div class="card-body">
        <div class="ocat-wrapper">
            <label asp-for="Anonymity" class="ocat-label">@T["Responses"]</label>
            <div class="ocat-end">
                <select asp-for="Anonymity" class="form-select">
                    <option value="@AnonymityMode.Identified">@T["Identified: record who responded"]</option>
                    <option value="@AnonymityMode.Anonymous">@T["Anonymous: record nobody"]</option>
                </select>
                <span class="hint">@(Model.AnonymityLocked ? T["This survey has responses, so its anonymity can't change any more."] : T["Choose before the first response: anonymity can't change once the survey has responses."])</span>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="CollectIpAddress" class="ocat-label">@T["IP address"]</label>
            <div class="ocat-end">
                <div class="form-check">
                    <input asp-for="CollectIpAddress" type="checkbox" class="form-check-input" />
                    <label asp-for="CollectIpAddress" class="form-check-label">@T["Record the IP address of identified responses"]</label>
                </div>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="MinimumGroupSize" class="ocat-label">@T["Minimum group size"]</label>
            <div class="ocat-end">
                <input asp-for="MinimumGroupSize" type="number" min="@Model.MinimumGroupSizeFloor" class="form-control" />
                <span class="hint">@T["Reports, lists and exports of an anonymous survey hide any group with fewer responses. The site allows no less than {0}.", Model.MinimumGroupSizeFloor]</span>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">@T["When"]</div>
    <div class="card-body">
        <div class="ocat-wrapper">
            <label asp-for="Opens" class="ocat-label">@T["Opens"]</label>
            <div class="ocat-end">
                <input asp-for="Opens" type="datetime-local" class="form-control" />
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="Closes" class="ocat-label">@T["Closes"]</label>
            <div class="ocat-end">
                <input asp-for="Closes" type="datetime-local" class="form-control" />
                <span asp-validation-for="Closes" class="text-danger"></span>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="UseSchedule" class="ocat-label">@T["Weekly schedule"]</label>
            <div class="ocat-end">
                <div class="form-check">
                    <input asp-for="UseSchedule" type="checkbox" class="form-check-input" />
                    <label asp-for="UseSchedule" class="form-check-label">@T["Allow responses to start only on some days and hours"]</label>
                </div>
            </div>
        </div>
        @for (var i = 0; i < Model.Days.Count; i++)
        {
            <div class="ocat-wrapper">
                <label class="ocat-label" for="@Html.IdFor(m => m.Days[i].Mode)">@days[(int)Model.Days[i].Day]</label>
                <div class="ocat-end">
                    <input type="hidden" asp-for="Days[i].Day" />
                    <div class="input-group">
                        <select asp-for="Days[i].Mode" class="form-select">
                            <option value="@DayScheduleMode.AllowAll">@T["All day"]</option>
                            <option value="@DayScheduleMode.PreventAll">@T["Closed"]</option>
                            <option value="@DayScheduleMode.Between">@T["Between"]</option>
                        </select>
                        <input asp-for="Days[i].From" type="time" class="form-control" aria-label="@T["From"]" />
                        <input asp-for="Days[i].To" type="time" class="form-control" aria-label="@T["To"]" />
                    </div>
                </div>
            </div>
        }
        <div class="ocat-wrapper">
            <div class="ocat-end-offset">
                <span asp-validation-for="Days" class="text-danger"></span>
                <span class="hint">@T["Times are in the site time zone."]</span>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="IncompleteExpiryHours" class="ocat-label">@T["Abandon after"]</label>
            <div class="ocat-end">
                <div class="input-group">
                    <input asp-for="IncompleteExpiryHours" type="number" min="1" class="form-control" />
                    <span class="input-group-text">@T["idle hours"]</span>
                </div>
                <span class="hint">@T["An unfinished response that nobody saves for this long is abandoned."]</span>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">@T["Limits"]</div>
    <div class="card-body">
        <div class="ocat-wrapper">
            <label asp-for="LimitCounts" class="ocat-label">@T["Count"]</label>
            <div class="ocat-end">
                <select asp-for="LimitCounts" class="form-select">
                    <option value="@LimitCount.Completed">@T["Completed responses"]</option>
                    <option value="@LimitCount.Started">@T["Started responses"]</option>
                </select>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="LimitTotal" class="ocat-label">@T["In total"]</label>
            <div class="ocat-end"><input asp-for="LimitTotal" type="number" min="1" class="form-control" /><span class="hint">@T["For quizzes, the number of attempts."]</span></div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="LimitPerDay" class="ocat-label">@T["A day"]</label>
            <div class="ocat-end"><input asp-for="LimitPerDay" type="number" min="1" class="form-control" /></div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="LimitPerWeek" class="ocat-label">@T["A week"]</label>
            <div class="ocat-end"><input asp-for="LimitPerWeek" type="number" min="1" class="form-control" /><span class="hint">@T["Weeks start on the site's first day of the week."]</span></div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="LimitPerMonth" class="ocat-label">@T["A month"]</label>
            <div class="ocat-end"><input asp-for="LimitPerMonth" type="number" min="1" class="form-control" /></div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="CooldownMinutes" class="ocat-label">@T["Wait between responses"]</label>
            <div class="ocat-end">
                <div class="input-group">
                    <input asp-for="CooldownMinutes" type="number" min="1" class="form-control" />
                    <span class="input-group-text">@T["minutes"]</span>
                </div>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="Uniqueness" class="ocat-label">@T["Recognize respondents by"]</label>
            <div class="ocat-end">
                <select asp-for="Uniqueness" class="form-select">
                    <option value="@UniquenessMode.SignedInUser">@T["Their user account"]</option>
                    <option value="@UniquenessMode.Invitation">@T["Their invitation"]</option>
                    <option value="@UniquenessMode.Cookie">@T["A browser cookie (weak)"]</option>
                    <option value="@UniquenessMode.None">@T["Not at all"]</option>
                </select>
                <span class="hint">@T["A cookie stops honest repeats only: a respondent can clear it. Use sign-in or invitations for one response per person."]</span>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="MaxResponses" class="ocat-label">@T["Most responses"]</label>
            <div class="ocat-end"><input asp-for="MaxResponses" type="number" min="1" class="form-control" /><span class="hint">@T["The survey stops accepting responses once this many are completed."]</span></div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">@T["Retention"]</div>
    <div class="card-body">
        <div class="ocat-wrapper">
            <label asp-for="RetentionDays" class="ocat-label">@T["Keep responses for"]</label>
            <div class="ocat-end">
                <div class="input-group">
                    <input asp-for="RetentionDays" type="number" min="1" class="form-control" />
                    <span class="input-group-text">@T["days"]</span>
                </div>
                <span class="hint">@T["Leave it empty to keep responses."]</span>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="RetentionAction" class="ocat-label">@T["Then"]</label>
            <div class="ocat-end">
                <select asp-for="RetentionAction" class="form-select">
                    <option value="@RetentionAction.Delete">@T["Delete them"]</option>
                    <option value="@RetentionAction.Anonymize">@T["Remove who responded and keep the answers"]</option>
                </select>
            </div>
        </div>
    </div>
</div>
