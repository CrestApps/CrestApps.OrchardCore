@using CrestApps.OrchardCore.Surveys.ViewModels

@model GradingQueueViewModel

<zone Name="Title">
    <breadcrumb name="SurveyGrading" title="@(string.IsNullOrEmpty(Model.SurveyTitle) ? T["Grading"] : T["Grading: {0}", Model.SurveyTitle])" />
</zone>

<admin-list name="SurveyGradingQueue" context="Model.List"
            show-select-all="false"
            empty-message="@T["<strong>Nothing to grade!</strong> No response is waiting for a grader."]">
    <admin-list-list item-css-class="list-group-item" />
    <admin-list-grid>
        <admin-list-column name="Name" position="20" title="@T["Response"]" />
        <admin-list-column name="Survey" position="30" title="@T["Survey"]" width="auto" />
        <admin-list-column name="Completed" position="40" title="@T["Completed"]" width="auto" />
        <admin-list-column type="Actions" title="@T["Actions"]" />
    </admin-list-grid>
</admin-list>
