@using CrestApps.OrchardCore.Surveys.ViewModels
@model SurveyTranslationsViewModel

<zone Name="Title">
    <breadcrumb name="SurveysTranslations" title="@T["Translations"]">
        <breadcrumb-item id="SurveysIndex" action="Index" controller="Surveys" area="CrestApps.OrchardCore.Surveys" permission="@SurveysPermissions.ManageOwnSurveys.Name">@T["Surveys"]</breadcrumb-item>
        <breadcrumb-item id="SurveysDesign" action="Design" controller="SurveyDesigner" area="CrestApps.OrchardCore.Surveys" route-id="@Model.Survey.ItemId">@Model.Survey.Title</breadcrumb-item>
    </breadcrumb>
</zone>

<survey-layout survey="Model.Survey">

@if (Model.Cultures.Count == 0)
{
    <div class="alert alert-info" role="alert">
        @T["The site has only one culture. Add cultures in Configuration, Settings, Localization to translate this survey."]
    </div>

    return;
}

<div class="card mb-3">
    <div class="card-header">@T["Culture"]</div>
    <div class="card-body">
        <form method="get" asp-action="Index" asp-route-id="@Model.Survey.ItemId">
            <div class="ocat-wrapper">
                <label class="ocat-label" for="translation-culture">@T["Translate into"]</label>
                <div class="ocat-end">
                    <div class="input-group">
                        <select id="translation-culture" name="culture" class="form-select" asp-items="Model.Cultures"></select>
                        <button type="submit" class="btn btn-outline-secondary">@T["Open"]</button>
                    </div>
                    <span class="hint">@T["{0} of {1} texts are translated. Respondents see a translation once the survey is published, when their language or the link's culture matches.", Model.Translated, Model.Entries.Count]</span>
                    @if (Model.Outdated > 0)
                    {
                        <span class="hint text-warning">@T["{0} translations are out of date: their original text changed after they were translated. Change each one to mark it current.", Model.Outdated]</span>
                    }
                    @if (Model.Unchecked > 0)
                    {
                        <span class="hint text-warning">@T["{0} translations were saved before changes to the original text were tracked, so they may be out of date. Check them, then save to mark them current.", Model.Unchecked]</span>
                    }
                </div>
            </div>
        </form>
        <form method="post" asp-action="Import" asp-route-id="@Model.Survey.ItemId" asp-route-culture="@Model.Culture" enctype="multipart/form-data">
            <div class="ocat-wrapper">
                <label class="ocat-label" for="translation-file">@T["Translation file"]</label>
                <div class="ocat-end">
                    <div class="input-group">
                        <input id="translation-file" name="file" type="file" accept=".json,application/json" class="form-control" />
                        <button type="submit" class="btn btn-outline-secondary">@T["Import"]</button>
                        <a class="btn btn-outline-secondary" asp-action="Export" asp-route-id="@Model.Survey.ItemId" asp-route-culture="@Model.Culture">@T["Export"]</a>
                    </div>
                    <span class="hint">@T["Export a JSON file with every original text, translate it, and import it here."]</span>
                </div>
            </div>
        </form>
    </div>
</div>

<form method="post" asp-action="Index" asp-route-id="@Model.Survey.ItemId" class="no-multisubmit">
    <input type="hidden" asp-for="Culture" />
    <input type="hidden" asp-for="DraftModifiedUtc" />

    @foreach (var group in Model.Entries.Select((entry, index) => (entry, index)).GroupBy(item => item.entry.Group))
    {
        <div class="card mb-3">
            <div class="card-header">
                @switch (group.Key)
                {
                    case "survey": @T["Survey"]; break;
                    case "page": @T["Pages"]; break;
                    case "question": @T["Questions"]; break;
                    case "choice": @T["Choices"]; break;
                    case "row": @T["Rows"]; break;
                    default: @T["Endings"]; break;
                }
            </div>
            <div class="card-body">
                @foreach (var (entry, index) in group)
                {
                    <input type="hidden" name="Entries[@index].Key" value="@entry.Key" />
                    <div class="ocat-wrapper">
                        <label class="ocat-label" for="translation-@index">@(entry.Label ?? entry.Key)</label>
                        <div class="ocat-end">
                            <div class="row gx-2">
                                <div class="col-md-6">
                                    <div class="form-control bg-body-tertiary text-break" style="white-space: pre-wrap;">@entry.Original</div>
                                </div>
                                <div class="col-md-6">
                                    @if (entry.Outdated)
                                    {
                                        <span class="badge text-bg-warning mb-1">@T["Out of date"]</span>
                                    }
                                    else if (entry.Unchecked)
                                    {
                                        <span class="badge text-bg-light border mb-1">@T["Check"]</span>
                                    }
                                    @if (entry.IsHtml || entry.Original?.Length > 80)
                                    {
                                        <textarea id="translation-@index" name="Entries[@index].Translation" rows="3" class="form-control" lang="@Model.Culture">@entry.Translation</textarea>
                                    }
                                    else
                                    {
                                        <input id="translation-@index" name="Entries[@index].Translation" value="@entry.Translation" class="form-control" lang="@Model.Culture" />
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <div class="action-bar-bottom">
        <button class="btn btn-primary" type="submit">@T["Save"]</button>
        <a class="btn btn-secondary cancel" role="button" asp-action="Design" asp-controller="SurveyDesigner" asp-route-id="@Model.Survey.ItemId">@T["Cancel"]</a>
    </div>
</form>

</survey-layout>
