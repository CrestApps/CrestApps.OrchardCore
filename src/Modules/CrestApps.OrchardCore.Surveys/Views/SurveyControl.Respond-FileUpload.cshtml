@model CrestApps.OrchardCore.Surveys.Core.ViewModels.SurveyControlViewModel
@using CrestApps.OrchardCore.Surveys.Core.Controls.FileUpload

@{
    var settings = Model.GetSettings<FileUploadSettings>();
    var accept = settings.AllowedFormats is { Count: > 0 } ? string.Join(",", settings.AllowedFormats.Select(format => "." + format.Trim().TrimStart('.'))) : null;
}
@if (Model.Answer?.AttachmentIds is { Count: > 0 } existing)
{
    <ul class="list-unstyled mb-2">
        @foreach (var id in existing)
        {
            <li class="form-check">
                <input class="form-check-input" type="checkbox" name="@(Model.Prefix).keep" id="@(Model.InputId)-keep-@id" value="@id" checked disabled="@Model.ReadOnly" />
                <label class="form-check-label" for="@(Model.InputId)-keep-@id">@T["Keep the file uploaded before"]</label>
            </li>
        }
    </ul>
}
<label class="visually-hidden" for="@Model.InputId">@Model.Question.Title</label>
<input type="file" class="form-control @(Model.HasErrors ? "is-invalid" : null)" id="@Model.InputId" name="@Model.Prefix" multiple="@(settings.MaxFiles > 1)" accept="@accept" disabled="@Model.ReadOnly" aria-required="@(Model.Question.Required ? "true" : null)" aria-describedby="@Model.DescribedBy()" aria-invalid="@(Model.HasErrors ? "true" : null)" />
<div class="form-text">@T["Up to {0} files.", Math.Max(settings.MaxFiles, 1)]</div>

@if (Model.HasErrors)
{
    <div id="@Model.ErrorId" class="invalid-feedback d-block" role="alert">
        @foreach (var error in Model.Errors)
        {
            <div>@error</div>
        }
    </div>
}
