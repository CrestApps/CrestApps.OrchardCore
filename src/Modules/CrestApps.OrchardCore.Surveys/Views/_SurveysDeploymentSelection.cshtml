@using CrestApps.OrchardCore.Surveys.ViewModels

@model SurveysDeploymentStepViewModel

<style asp-name="bootstrap-select"></style>
<script asp-name="bootstrap-select" depends-on="bootstrap" at="Foot"></script>
<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input asp-for="IncludeAll" type="checkbox" class="form-check-input" />
            <label asp-for="IncludeAll" class="form-check-label">@T["Export all"]</label>
            <span class="hint dashed">@T["Clear it to export only the records chosen below."]</span>
        </div>
    </div>
</div>
<div class="ocat-wrapper">
    <label asp-for="Names" class="ocat-label">@T["Choose"]</label>
    <div class="ocat-end">
        <select asp-for="Names" asp-items="Model.Options" class="selectpicker show-tick" multiple data-live-search="true" data-actions-box="true" data-width="100%" title="@T["None chosen"]"></select>
        <span class="hint">@T["Used only when Export all is cleared."]</span>
    </div>
</div>
