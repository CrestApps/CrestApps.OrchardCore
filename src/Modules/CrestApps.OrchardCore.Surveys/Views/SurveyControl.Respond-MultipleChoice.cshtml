@model CrestApps.OrchardCore.Surveys.Core.ViewModels.SurveyControlViewModel
@using CrestApps.OrchardCore.Surveys.Core.Controls.MultipleChoice

@{
    var settings = Model.GetSettings<MultipleChoiceSettings>();
}
<fieldset class="survey-choices" aria-describedby="@Model.DescribedBy()">
    <legend class="visually-hidden">@Model.Question.Title</legend>
    @if (settings.MinSelected is > 0 || settings.MaxSelected is > 0)
    {
        <div class="form-text mb-1">
            @if (settings.MinSelected is > 0 && settings.MaxSelected is > 0)
            {
                @T["Select from {0} to {1} options.", settings.MinSelected, settings.MaxSelected]
            }
            else if (settings.MinSelected is > 0)
            {
                @T["Select at least {0} options.", settings.MinSelected]
            }
            else
            {
                @T["Select at most {0} options.", settings.MaxSelected]
            }
        </div>
    }
    <div class="@(settings.Display == MultipleChoiceDisplay.Checkboxes ? "row row-cols-1 row-cols-md-" + Math.Clamp(settings.Columns, 1, 4) : "d-flex flex-wrap gap-2")">
        @foreach (var choice in Model.Choices)
        {
            var id = $"{Model.InputId}-{choice.Id}";
            if (settings.Display == MultipleChoiceDisplay.Checkboxes)
            {
                <div class="col">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="@Model.Prefix" id="@id" value="@choice.Id" checked="@Model.IsSelected(choice.Id)" disabled="@Model.ReadOnly" aria-invalid="@(Model.HasErrors ? "true" : null)" data-exclusive="@(choice.IsExclusive ? "true" : null)" />
                        <label class="form-check-label" for="@id">@choice.Text</label>
                    </div>

        @if (choice.IsOther)
        {
            <input type="text" class="form-control form-control-sm mt-1" name="@(Model.Prefix).other" value="@Model.Answer?.OtherText" maxlength="1000" aria-label="@T["Other answer"]" disabled="@Model.ReadOnly" />
        }

                </div>
            }
            else
            {
                <div>
                    <input class="btn-check" type="checkbox" name="@Model.Prefix" id="@id" value="@choice.Id" checked="@Model.IsSelected(choice.Id)" disabled="@Model.ReadOnly" autocomplete="off" />
                    <label class="btn btn-outline-primary @(settings.Display == MultipleChoiceDisplay.TagBox ? "btn-sm rounded-pill" : "p-1")" for="@id">
                        @if (settings.Display == MultipleChoiceDisplay.ImageTiles && !string.IsNullOrEmpty(choice.ImageUrl))
                        {
                            <img src="@choice.ImageUrl" alt="" class="d-block mb-1" style="max-width: 10rem; max-height: 8rem" />
                        }
                        @choice.Text
                    </label>

        @if (choice.IsOther)
        {
            <input type="text" class="form-control form-control-sm mt-1" name="@(Model.Prefix).other" value="@Model.Answer?.OtherText" maxlength="1000" aria-label="@T["Other answer"]" disabled="@Model.ReadOnly" />
        }

                </div>
            }
        }
    </div>
</fieldset>

@if (Model.HasErrors)
{
    <div id="@Model.ErrorId" class="invalid-feedback d-block" role="alert">
        @foreach (var error in Model.Errors)
        {
            <div>@error</div>
        }
    </div>
}
