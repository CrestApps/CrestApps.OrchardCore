@model CrestApps.OrchardCore.Surveys.Core.ViewModels.SurveyControlSettingsViewModel<CrestApps.OrchardCore.Surveys.Core.Controls.ChoiceBlanks.ChoiceBlanksSettings>

<div class="card text-bg-theme mb-3">
    <div class="card-header">@T["Choose the missing words settings"]</div>
    <div class="card-body">
        <div class="ocat-wrapper">
            <label asp-for="Settings.Text" class="ocat-label">@T["Text"]</label>
            <div class="ocat-end">
                <textarea asp-for="Settings.Text" class="form-control" rows="5"></textarea>
                <span class="hint">@T["Write each blank as [[right word]]. Respondents pick from the right words and the wrong words, sorted alphabetically."]</span>
            </div>
        </div>

        <div class="ocat-wrapper">
            <label class="ocat-label">@T["Wrong words"]</label>
            <div class="ocat-end">
                @foreach (var item in Model.Settings.Distractors.Concat(Enumerable.Repeat(string.Empty, 3)))
                {
                    <input type="text" name="@Html.NameFor(m => m.Settings.Distractors)" value="@item" class="form-control mb-1" aria-label="@T["Wrong words"]" />
                }
                <span class="hint">@T["Words added to the choices that fit no blank."]</span>
            </div>
        </div>

        <div class="ocat-wrapper">
            <label asp-for="Settings.Display" class="ocat-label">@T["Pick words with"]</label>
            <div class="ocat-end">
                <select asp-for="Settings.Display" class="form-select">
                    <option value="GapSelect">@T["A drop-down in each blank"]</option>
                    <option value="DragIntoText">@T["Words dragged into the blanks"]</option>
                </select>
            </div>
        </div>
    </div>
</div>
