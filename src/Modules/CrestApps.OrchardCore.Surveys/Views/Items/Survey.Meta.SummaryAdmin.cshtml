@model ShapeViewModel<Survey>

@{
    var modified = Model.Value.ModifiedUtc ?? Model.Value.CreatedUtc;
}

@if (modified != default)
{
    <span class="badge ta-badge fw-normal" title="@T["Last changed"]"><i class="fa-regular fa-clock" aria-hidden="true"></i> @await DisplayAsync(await New.DateTime(Utc: DateTime.SpecifyKind(modified, DateTimeKind.Utc), Format: "g"))</span>
}
