@model ShapeViewModel<SurveyCollector>

@{
    var request = ViewContext.HttpContext.Request;
    var link = $"{request.Scheme}://{request.Host}{request.PathBase}/s/{Uri.EscapeDataString(Model.Value.Token ?? string.Empty)}";
}

<div class="admin-list-secondary d-flex align-items-center gap-2">
    <code class="text-truncate">@link</code>
    <button type="button" class="btn btn-sm btn-outline-secondary" data-survey-copy="@link" title="@T["Copy the link"]" aria-label="@T["Copy the link"]"><i class="fa-regular fa-copy" aria-hidden="true"></i></button>
</div>
