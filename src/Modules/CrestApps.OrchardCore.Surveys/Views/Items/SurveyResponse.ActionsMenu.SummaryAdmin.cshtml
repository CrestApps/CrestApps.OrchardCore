@model ShapeViewModel<SurveyResponse>

@if (Model.Value.Status != SurveyResponseStatus.Voided)
{
    <a href="@Url.RouteUrl("SurveysResponseVoid", new { id = Model.Value.ItemId })"
       class="dropdown-item"
       data-url-af="RemoveUrl UnsafeUrl"
       data-title="@T["Void Response"]"
       data-message="@T["Void this response? It stays in the list but is left out of results."]"
       data-ok-text="@T["Void"]"
       data-cancel-text="@T["Cancel"]">@T["Void"]</a>
}
<a href="@Url.RouteUrl("SurveysResponseDelete", new { id = Model.Value.ItemId })"
   class="dropdown-item text-danger"
   data-url-af="RemoveUrl UnsafeUrl"
   data-title="@T["Delete Response"]"
   data-message="@T["Delete this response? This cannot be undone."]"
   data-ok-text="@T["Delete"]"
   data-cancel-text="@T["Cancel"]">@T["Delete"]</a>
