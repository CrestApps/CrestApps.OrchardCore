@using CrestApps.OrchardCore.Surveys.Deployments

@model ShapeViewModel<SurveyResponsesDeploymentStep>

<h5>@T["Survey responses"]</h5>

@if (Model.Value.IncludeAll)
{
    <span class="badge text-bg-success">@T["All surveys"]</span>
}
else
{
    foreach (var name in Model.Value.SurveyNames)
    {
        <span class="badge text-bg-secondary">@name</span>
    }
}
@if (Model.Value.IncludeInProgress)
{
    <span class="badge text-bg-info">@T["With responses in progress"]</span>
}
@if (Model.Value.IncludeTest)
{
    <span class="badge text-bg-info">@T["With test responses"]</span>
}
