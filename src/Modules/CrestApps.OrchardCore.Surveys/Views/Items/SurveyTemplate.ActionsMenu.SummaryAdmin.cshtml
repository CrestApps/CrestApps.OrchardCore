@model ShapeViewModel<SurveyTemplate>

<a asp-action="Delete" asp-controller="SurveyTemplates" asp-route-area="CrestApps.OrchardCore.Surveys" asp-route-id="@Model.Value.ItemId" class="dropdown-item text-danger" data-url-af="RemoveUrl UnsafeUrl" data-title="@T["Delete"]" data-message="@T["Remove this template? Surveys made from it keep their questions."]">@T["Delete"]</a>
