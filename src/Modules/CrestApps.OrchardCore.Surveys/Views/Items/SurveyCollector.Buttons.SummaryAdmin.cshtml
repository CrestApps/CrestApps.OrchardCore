@model ShapeViewModel<SurveyCollector>

@if (Model.Value.Kind == SurveyCollectorKinds.Invitation && Url.Action("Index", "SurveyInvitations", new { area = "CrestApps.OrchardCore.Surveys", collectorId = Model.Value.ItemId }) is { } invitationsUrl)
{
    <a href="@invitationsUrl" class="btn btn-primary btn-sm">@T["Invitations"]</a>
}
<a asp-action="Edit" asp-controller="SurveyCollectors" asp-route-collectorId="@Model.Value.ItemId" class="btn btn-primary btn-sm">@T["Edit"]</a>
<a asp-action="Qr" asp-controller="SurveyCollectors" asp-route-collectorId="@Model.Value.ItemId" class="btn btn-secondary btn-sm">@T["QR Code"]</a>
