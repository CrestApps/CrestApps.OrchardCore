@model ShapeViewModel<SurveyResponse>

@{
    var response = Model.Value;
}

<span class="badge ta-badge fw-normal" title="@T["Started"]"><i class="fa-regular fa-clock" aria-hidden="true"></i> @await DisplayAsync(await New.DateTime(Utc: DateTime.SpecifyKind(response.StartedUtc, DateTimeKind.Utc), Format: "g"))</span>
@if (response.CompletedUtc is { } completed)
{
    <span class="badge ta-badge fw-normal" title="@T["Duration"]"><i class="fa-solid fa-stopwatch" aria-hidden="true"></i> @((completed - response.StartedUtc).ToString(@"h\:mm\:ss"))</span>
}
<span class="badge ta-badge fw-normal" title="@T["Respondent"]"><i class="fa-regular fa-user" aria-hidden="true"></i> <partial name="_SurveyRespondentName" model="response" /></span>
