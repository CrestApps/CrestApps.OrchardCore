@model ShapeViewModel<QuestionBank>

<a asp-action="Edit" asp-controller="QuestionBanks" asp-route-area="CrestApps.OrchardCore.Surveys" asp-route-id="@Model.Value.ItemId" class="dropdown-item">@T["Edit"]</a>
<a asp-action="Import" asp-controller="QuestionBanks" asp-route-area="CrestApps.OrchardCore.Surveys" asp-route-id="@Model.Value.ItemId" class="dropdown-item">@T["Import Questions"]</a>
<a asp-action="Delete" asp-controller="QuestionBanks" asp-route-area="CrestApps.OrchardCore.Surveys" asp-route-id="@Model.Value.ItemId" class="dropdown-item text-danger" data-url-af="RemoveUrl UnsafeUrl" data-title="@T["Delete"]" data-message="@T["Delete this question bank and its questions? Published surveys keep the questions they drew from it."]">@T["Delete"]</a>
