@using CrestApps.OrchardCore.Surveys.ViewModels
@model SurveyLogicViewModel

<zone Name="Title">
    <breadcrumb name="SurveysLogic" title="@T["Logic overview"]">
        <breadcrumb-item id="SurveysIndex" action="Index" controller="Surveys" area="CrestApps.OrchardCore.Surveys" permission="@SurveysPermissions.ManageOwnSurveys.Name">@T["Surveys"]</breadcrumb-item>
        <breadcrumb-item id="SurveysDesign" action="Design" controller="SurveyDesigner" area="CrestApps.OrchardCore.Surveys" route-id="@Model.Survey.ItemId">@Model.Survey.Title</breadcrumb-item>
    </breadcrumb>
</zone>

<partial name="_SurveyNav" model="Model.Survey" />

<p class="text-body-secondary">@T["How the draft decides what each respondent sees, in plain words. Change it in the designer."]</p>

@if (Model.Problems.Count > 0)
{
    <div class="card mb-3 border-warning">
        <div class="card-header">@T["Problems to fix before publishing"]</div>
        <ul class="list-group list-group-flush">
            @foreach (var problem in Model.Problems)
            {
                <li class="list-group-item">
                    <i class="fa-solid @(problem.IsError ? "fa-circle-xmark text-danger" : "fa-triangle-exclamation text-warning") me-1" aria-hidden="true"></i>
                    @problem.Message
                </li>
            }
        </ul>
    </div>
}

@foreach (var surveyPage in Model.Pages)
{
    <div class="card mb-3">
        <div class="card-header">@surveyPage.Title</div>
        <ul class="list-group list-group-flush">
            @foreach (var line in surveyPage.Lines)
            {
                <li class="list-group-item">@line</li>
            }
        </ul>
    </div>
}

<div class="card mb-3">
    <div class="card-header">@T["Endings"]</div>
    <ul class="list-group list-group-flush">
        @foreach (var line in Model.Endings)
        {
            <li class="list-group-item">@line</li>
        }
    </ul>
</div>
