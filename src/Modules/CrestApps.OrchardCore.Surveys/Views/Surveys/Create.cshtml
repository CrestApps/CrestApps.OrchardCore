@using CrestApps.OrchardCore.Surveys.ViewModels
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@model SurveyCreateViewModel

<zone Name="Title">
    <breadcrumb name="SurveysCreate" title="@T["New Survey"]">
        <breadcrumb-item id="SurveysIndex" action="Index" controller="Surveys" area="CrestApps.OrchardCore.Surveys" permission="@SurveysPermissions.ManageOwnSurveys.Name">@T["Surveys"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form asp-action="Create" method="post" class="no-multisubmit">
    @Html.ValidationSummary()

    <div class="card mb-3">
        <div class="card-header">@T["Survey"]</div>
        <div class="card-body">
            <div class="ocat-wrapper">
                <label asp-for="Title" class="ocat-label">@T["Title"]</label>
                <div class="ocat-end">
                    <input asp-for="Title" class="form-control" required autofocus />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
            </div>
            <div class="ocat-wrapper">
                <label asp-for="Name" class="ocat-label">@T["Technical name"]</label>
                <div class="ocat-end">
                    <input asp-for="Name" class="form-control" pattern="[a-z0-9-]*" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                    <span class="hint">@T["Lowercase letters, digits and dashes. Leave it empty to make one from the title."]</span>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header d-flex align-items-center">
            <span class="me-auto">@T["Start from"]</span>
            @if (await AuthorizationService.AuthorizeAsync(User, SurveysPermissions.ManageSurveyTemplates))
            {
                <a asp-action="Index" asp-controller="SurveyTemplates" class="small">@T["Manage templates"]</a>
            }
        </div>
        <div class="card-body">
            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-3">
                @foreach (var template in Model.Templates)
                {
                    var id = "template-" + template.Name;

                    <div class="col">
                        <div class="form-check card h-100 p-3 ps-5">
                            <input class="form-check-input" type="radio" name="Template" id="@id" value="@template.Name" checked="@(template.Name == Model.Template)" />
                            <label class="form-check-label w-100" for="@id">
                                <i class="@template.Icon me-1" aria-hidden="true"></i>
                                <span class="fw-semibold">@(string.IsNullOrWhiteSpace(template.Title) ? template.Name : template.Title)</span>
                                @if (!string.IsNullOrWhiteSpace(template.Description))
                                {
                                    <span class="d-block hint">@template.Description</span>
                                }
                            </label>
                        </div>
                    </div>
                }
            </div>
            <span asp-validation-for="Template" class="text-danger"></span>
        </div>
    </div>

    <div class="action-bar-bottom">
        <button class="btn btn-primary" type="submit">@T["Create"]</button>
        <a class="btn btn-secondary cancel" role="button" asp-action="Index">@T["Cancel"]</a>
    </div>
</form>
