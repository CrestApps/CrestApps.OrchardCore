@using CrestApps.Core.AI.Models
@using CrestApps.Core.Models
@using CrestApps.OrchardCore.Core.Models
@using Microsoft.AspNetCore.Mvc.Localization
@using OrchardCore.DisplayManagement

@model ListSourceModelViewModel<AIDataSourceSourceDescriptor, CatalogEntryViewModel<AIDataSource>>

<zone Name="Title">
    <breadcrumb name="AIDataSources" title="@T["AI Data Sources"]" />
</zone>

@* The form is necessary to generate an antiforgery token for the delete and toggle actions. *@
<form asp-action="Index" asp-route-pageSize="@Context.Request.Query["pageSize"]" method="post" class="no-multisubmit" data-list-management data-selected-label="@T["selected"]" data-client-side-search="true">
    <input type="submit" name="submit.Filter" id="submitFilter" class="visually-hidden" />
    <input asp-for="Options.BulkAction" type="hidden" />
    <input type="submit" name="submit.BulkAction" class="visually-hidden" />

    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <div class="input-group">
                        <input id="search-box" asp-for="Options.Search" class="form-control" placeholder="@T["Search"]" type="search" autofocus autocomplete="off" />
                        <button type="submit" name="submit.Filter" class="btn btn-outline-secondary" title="@T["Search"]" aria-label="@T["Search"]"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
                    </div>
                </div>
                <div class="col-auto">
                    <button type="button" class="btn btn-secondary create" role="button" data-bs-toggle="modal" data-bs-target="#modalAddDataSource">@T["Add Data Source"]</button>
                </div>
            </div>
        </div>
    </div>

    @* The data sources, the toolbar and the pager are rendered by the AdminList shape, in the layout (List or Grid) the site or the user picked. *@
    <admin-list name="AIDataSources" context="Model.List"
                bulk-actions="Model.Options.BulkActions"
                empty-message="@T["<strong>Nothing here!</strong> There are no data sources at the moment."]">
        <admin-list-list item-css-class="list-group-item" />
        <admin-list-grid>
            <admin-list-column type="Select" />
            <admin-list-column name="Name" position="20" title="@T["Name"]" />
            <admin-list-column name="Indexes" position="30" title="@T["Indexes"]" width="auto" />
            <admin-list-column name="Modified" position="40" title="@T["Last modified"]" width="auto" />
            <admin-list-column type="Actions" title="@T["Actions"]" />
        </admin-list-grid>
    </admin-list>

    <div id="list-alert" class="alert alert-info my-3 d-none text-center" role="alert">
        @T["Your search returned no results."]
    </div>
</form>

<!-- Modal -->
<div class="modal fade" id="modalAddDataSource" tabindex="-1" role="dialog" aria-labelledby="available-source-types-title" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="available-source-types-title">@T["Available Source Types"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @if (!(Model.Sources?.Any() ?? false))
                {
                    <p class="p-3 mb-2 bg-warning text-white">@T["No available source types at the moment."]</p>
                }
                else
                {
                    <div class="row row-cols-1 row-cols-md-3 g-2">
                        @foreach (var source in Model.Sources)
                        {
                            <div class="col">
                                <div class="card h-100">
                                    <div class="card-body">
                                        <h4>@source.DisplayName</h4>
                                        <p class="hint">@source.Description</p>
                                    </div>

                                    <div class="card-footer text-muted text-sm-end">
                                        <a class="btn btn-primary btn-sm"
                                           asp-route-area="CrestApps.OrchardCore.AI.DataSources"
                                           asp-route-controller="DataSources"
                                           asp-route-action="Create"
                                           asp-route-sourceType="@source.SourceType">@T["Add"]</a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@T["Cancel"]</button>
            </div>
        </div>
    </div>
</div>

<script asp-name="list-management-ui" at="Foot"></script>
