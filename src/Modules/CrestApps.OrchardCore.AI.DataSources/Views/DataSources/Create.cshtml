@using CrestApps.Core.Models
@using CrestApps.OrchardCore.AI.Core

@model EditCatalogEntryViewModel

<zone Name="Title">
    <breadcrumb name="AIDataSourcesCreate" title="@T["New '{0}' data source", Model.DisplayName]">
        <breadcrumb-item id="AIDataSources" action="Index" controller="DataSources" area="CrestApps.OrchardCore.AI.DataSources" permission="@AIPermissions.ManageAIDataSources.Name">@T["AI Data Sources"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form method="post" enctype="multipart/form-data" class="no-multisubmit">
    @Html.ValidationSummary()

    @await DisplayAsync(Model.Editor)

    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <button class="btn btn-primary" type="submit">@T["Save"]</button>
            <a class="btn btn-secondary cancel" role="button" asp-route-action="Index">@T["Cancel"]</a>
        </div>
    </div>
</form>
