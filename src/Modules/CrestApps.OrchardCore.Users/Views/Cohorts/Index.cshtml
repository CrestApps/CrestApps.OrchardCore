@using CrestApps.OrchardCore.Users.Cohorts
@model CohortListViewModel

<zone Name="Title">
    <breadcrumb name="Cohorts" title="@T["Cohorts"]" />
</zone>

<form asp-action="Index" method="get" class="no-multisubmit">
    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <div class="input-group">
                        <input name="search" value="@Model.Search" class="form-control" placeholder="@T["Search"]" type="search" autocomplete="off" />
                        <button type="submit" class="btn btn-outline-secondary" title="@T["Search"]" aria-label="@T["Search"]"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
                    </div>
                </div>
                <div class="col-auto"><a asp-action="Edit" class="btn btn-secondary create">@T["Add Cohort"]</a></div>
            </div>
        </div>
    </div>
</form>

<admin-list name="Cohorts" context="Model.List" show-select-all="false"
            empty-message="@T["<strong>Nothing here!</strong> Add a cohort, a named group of people you keep by hand, such as this year's new hires, so courses and other features can target them."]">
    <admin-list-list item-css-class="list-group-item" />
    <admin-list-grid>
        <admin-list-column name="Name" position="20" title="@T["Name"]" />
        <admin-list-column name="Members" position="30" title="@T["People"]" width="auto" />
        <admin-list-column type="Actions" title="@T["Actions"]" />
    </admin-list-grid>
</admin-list>
