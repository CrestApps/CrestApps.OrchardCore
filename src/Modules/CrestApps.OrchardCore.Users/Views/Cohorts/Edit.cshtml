@using CrestApps.OrchardCore.Users.Cohorts
@model CohortEditViewModel

<zone Name="Title">
    <breadcrumb name="CohortsEdit" title="@(string.IsNullOrEmpty(Model.CohortId) ? T["New Cohort"] : T["Edit '{0}' Cohort", Model.Name ?? string.Empty])">
        <breadcrumb-item id="Cohorts" action="Index" controller="Cohorts" area="CrestApps.OrchardCore.Users">@T["Cohorts"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form asp-action="Edit" asp-route-id="@Model.CohortId" method="post" class="no-multisubmit">
    @Html.ValidationSummary()

    <div class="card text-bg-theme mb-3">
        <div class="card-header">@T["Cohort"]</div>
        <div class="card-body">
            <div class="ocat-limited-wrapper" asp-validation-class-for="Name">
                <label asp-for="Name" class="ocat-label">@T["Name"]</label>
                <div class="ocat-limited">
                    <input asp-for="Name" class="form-control" maxlength="255" autofocus required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                    <span class="hint">@T["Such as 2026 new hires or Warehouse supervisors. Each cohort has its own name."]</span>
                </div>
            </div>

            <div class="ocat-limited-wrapper">
                <label asp-for="Description" class="ocat-label">@T["Description"]</label>
                <div class="ocat-limited">
                    <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="action-bar-bottom">
        <button class="btn btn-primary" type="submit">@T["Save"]</button>
        <a class="btn btn-secondary cancel" role="button" asp-action="Index">@T["Cancel"]</a>
    </div>
</form>
