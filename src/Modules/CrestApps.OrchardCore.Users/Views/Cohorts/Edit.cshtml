@using CrestApps.OrchardCore.Users.Cohorts
@model CohortEditViewModel

<zone Name="Title">
    <breadcrumb name="CohortsEdit" title="@(string.IsNullOrEmpty(Model.CohortId) ? T["New Cohort"] : T["Edit '{0}' Cohort", Model.Name ?? string.Empty])">
        <breadcrumb-item id="Cohorts" action="Index" controller="Cohorts" area="CrestApps.OrchardCore.Users">@T["Cohorts"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form asp-action="Edit" asp-route-id="@Model.CohortId" method="post" class="no-multisubmit">
    @Html.ValidationSummary()

    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <button class="btn btn-primary" type="submit">@T["Save"]</button>
        <a class="btn btn-secondary cancel" role="button" asp-action="Index">@T["Cancel"]</a>
    </div>
</form>
