@using CrestApps.OrchardCore.Users.Audiences
@model UserAudienceConditionViewModel

<div class="ocat-wrapper" asp-validation-class-for="AudienceName">
    <label asp-for="AudienceName" class="ocat-label ocat-label-required">@T["Audience"]</label>
    <div class="ocat-end">
        <select asp-for="AudienceName" asp-items="Model.Audiences" class="form-select" required>
            <option value="">@T["Choose an audience"]</option>
        </select>
        <span asp-validation-for="AudienceName"></span>
        <span class="hint">@T["Met when the signed-in user is in the audience. A visitor who is not signed in is in no audience."]</span>
    </div>
</div>