@model OrchardCore.Media.ViewModels.EditMediaFieldViewModel
@using Microsoft.Extensions.DependencyInjection
@using OrchardCore.ContentManagement.Metadata.Models
@using OrchardCore.Media
@using Microsoft.AspNetCore.SignalR
@using OrchardCore.Environment.Shell
@using OrchardCore.Media.Hubs
@using OrchardCore.Media.Settings
@using OrchardCore.Mvc.Utilities
@using OrchardCore.Settings
@{
    var settings = Model.PartFieldDefinition.GetSettings<MediaFieldSettings>();
    var uniqueName = $"{Model.PartFieldDefinition.PartDefinition.Name}-{Model.PartFieldDefinition.Name}";
    // The same checks as the Media module's internal IsMediaTusEnabled and IsMediaSignalREnabled.
    var tusEnabled = (await Context.RequestServices.GetRequiredService<IShellFeaturesManager>().GetEnabledFeaturesAsync()).Any(feature => feature.Id == "OrchardCore.Media.Tus");
    var signalrEnabled = Context.RequestServices.GetService<IHubContext<MediaHub>>() is not null;
    var apiAuthScheme = Context.RequestServices.GetRequiredService<ISiteService>().GetSettings<MediaApiSettings>().AuthenticationScheme.ToString();
    var translationsJson = System.Text.Json.JsonSerializer.Serialize(Orchard.GetJSLocalizations("media-field"));
    var mediaAppTranslationsJson = System.Text.Json.JsonSerializer.Serialize(Orchard.GetJSLocalizations("media-gallery"));
}

<style asp-name="media" at="Head"></style>
<style asp-name="media-picker" at="Head"></style>

<div class="ocat-wrapper field-wrapper field-wrapper-@uniqueName.HtmlClassify()" id="@Html.IdFor(x => x.Paths)_FieldWrapper">
    <label asp-for="Paths" class="ocat-label">@Model.PartFieldDefinition.DisplayName()</label>
    <div class="ocat-end" data-for="@Html.IdFor(m => m.Paths)">
        @if (!string.IsNullOrWhiteSpace(settings.Hint))
        {
            <div class="hint mt-lg-2">@settings.Hint</div>
        }

        <div id="@Html.IdFor(m => m)"
             class="media-field-app"
             data-media-field-type="basic"
             data-input-name="@Html.NameFor(m => m.Paths)"
             data-paths="@Model.Paths"
             data-multiple="@(settings.Multiple ? "true" : "false")"
             data-allow-media-text="@(settings.AllowMediaText ? "true" : "false")"
             data-allow-anchors="@(settings.AllowAnchors ? "true" : "false")"
             data-allowed-extensions="@string.Join(',', Model.AllowedExtensions)"
             data-media-item-url="@Url.Content("~/api/media/GetMediaItem")"
             data-media-items-url="@Url.Content("~/api/media/GetMediaFieldItems")"
             data-media-gallery-translations="@mediaAppTranslationsJson"
             data-base-path="@Url.Content("~/")"
             data-api-auth-scheme="@apiAuthScheme"
             data-upload-files-url="@Url.Content("~/api/media/Upload")"
             data-tus-enabled="@(tusEnabled ? "true" : "false")"
             data-tus-endpoint-url="@Url.Content("~/api/media/tus")"
             data-tus-file-info-url="@Url.Content("~/api/media/TusFileInfo")"
             data-signalr-enabled="@(signalrEnabled ? "true" : "false")"
             data-translations="@translationsJson">
        </div>

        <span asp-validation-for="Paths"></span>
    </div>
</div>

<script asp-name="media-picker" at="Foot"></script>
