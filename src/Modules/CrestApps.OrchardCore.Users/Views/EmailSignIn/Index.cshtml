@model CrestApps.OrchardCore.Users.Controllers.EmailSignInViewModel

<zone Name="Title">
    <breadcrumb name="EmailSignIn" title="@T["Sign in with a code"]" />
</zone>

<div class="container my-5" style="max-width: 440px">
    <h1 class="h3 mb-2">@T["Sign in with a code"]</h1>
    <p class="text-muted">@T["Enter your account's email and we'll send you a six-digit code. No password needed."]</p>

    <form action="@Url.RouteUrl("EmailSignIn")" method="post" class="card">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
        <div class="card-body">
            <label for="email-sign-in-email" class="form-label ocat-label-required">@T["Email"]</label>
            <input id="email-sign-in-email" name="Email" type="email" value="@Model.Email" class="form-control" autocomplete="email" autofocus required />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="card-footer d-grid">
            <button type="submit" class="btn btn-primary">@T["Email me a code"]</button>
        </div>
    </form>

    <p class="small text-muted mt-3 text-center">
        <a href="@Url.Action("Login", "Account", new { area = "OrchardCore.Users", returnUrl = Model.ReturnUrl })">@T["Sign in with your password"]</a>
    </p>
</div>
