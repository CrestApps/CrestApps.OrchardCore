@model CrestApps.OrchardCore.Users.ViewModels.PasswordConfirmationViewModel

<zone Name="Title">
    <breadcrumb name="UsersPasswordConfirmation" title="@T["Confirm your password"]" />
</zone>

<form method="post" class="no-multisubmit">
    <input type="hidden" asp-for="ReturnUrl" />
    <div class="card mb-3">
        <div class="card-header">@T["Confirm it's you"]</div>
        <div class="card-body">
            @if (Model.HasPassword)
            {
                <p class="hint">@T["This page shows private information, such as pay. Enter your password to see it. Your own pay asks every time you open it; other private pages won't ask again for {0} minutes in this browser.", Model.Minutes]</p>
                <div class="ocat-wrapper" asp-validation-class-for="Password">
                    <label asp-for="Password" class="ocat-label ocat-label-required">@T["Your password"]</label>
                    <div class="ocat-end ocat-limited-wrapper">
                        <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" data-account-password autofocus />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning mb-0">@T["Your account signs in without a password, so it can't be confirmed this way. Set a password from your profile to see private information such as pay."]</div>
            }
        </div>
    </div>
    <div class="action-bar-bottom">
        @if (Model.HasPassword)
        {
            <button class="btn btn-primary" type="submit">@T["Confirm"]</button>
        }
        <a class="btn btn-secondary cancel" role="button" href="@Url.Content("~/Admin")">@T["Cancel"]</a>
    </div>
</form>
