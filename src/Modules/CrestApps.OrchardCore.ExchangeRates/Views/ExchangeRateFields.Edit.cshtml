@model ExchangeRateViewModel

<div class="ocat-limited-wrapper" asp-validation-class-for="Currency">
    <label asp-for="Currency" class="ocat-label ocat-label-required">@T["Currency"]</label>
    <div class="ocat-limited">
        <input asp-for="Currency" class="form-control" maxlength="3" placeholder="EUR" />
        <span asp-validation-for="Currency" class="text-danger"></span>
        <span class="hint">@T["The currency the rate converts, such as EUR."]</span>
    </div>
</div>
<div class="ocat-limited-wrapper" asp-validation-class-for="BaseCurrency">
    <label asp-for="BaseCurrency" class="ocat-label ocat-label-required">@T["Converts to"]</label>
    <div class="ocat-limited">
        <input asp-for="BaseCurrency" class="form-control" maxlength="3" placeholder="USD" />
        <span asp-validation-for="BaseCurrency" class="text-danger"></span>
        <span class="hint">@T["Usually the currency the store reports in, set under Settings > Commerce > Exchange Rates."]</span>
    </div>
</div>
<div class="ocat-limited-wrapper" asp-validation-class-for="Rate">
    <label asp-for="Rate" class="ocat-label ocat-label-required">@T["Rate"]</label>
    <div class="ocat-limited">
        <input asp-for="Rate" type="number" step="any" min="0" class="form-control" />
        <span asp-validation-for="Rate" class="text-danger"></span>
        <span class="hint">@T["What one unit of the currency is worth in the currency it converts to, such as 1.08 for one euro in dollars."]</span>
    </div>
</div>
<div class="ocat-limited-wrapper" asp-validation-class-for="Date">
    <label asp-for="Date" class="ocat-label ocat-label-required">@T["From"]</label>
    <div class="ocat-limited">
        <input asp-for="Date" type="date" class="form-control" />
        <span asp-validation-for="Date" class="text-danger"></span>
        <span class="hint">@T["The day the rate takes effect. It holds until a later rate of the same currencies."]</span>
    </div>
</div>
