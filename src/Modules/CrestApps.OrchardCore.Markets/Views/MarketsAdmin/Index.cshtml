@model MarketsIndexViewModel

<zone Name="Title">
    <breadcrumb name="Markets" title="@T["Markets"]" />
</zone>

<div class="card text-bg-theme mb-3 position-sticky action-bar">
    <div class="card-body">
        <div class="row gx-2">
            <div class="col">
                <p class="mb-0 text-body-secondary">@T["A market is a group of countries you sell to on the same terms. Its shoppers see prices in its currency, converted from your store's {0} at the rate you set unless a product has its own price there.", Model.StoreCurrency]</p>
            </div>
            <div class="col-auto">
                <a class="btn btn-secondary text-nowrap" asp-action="Create">@T["Add market"]</a>
            </div>
        </div>
    </div>
</div>

<admin-list name="Markets" context="Model.List"
            show-select-all="false"
            empty-message="@T["<strong>Nothing here!</strong> No markets yet. Every shopper sees your store's own prices until you add one."]">
    <admin-list-list item-css-class="list-group-item" />
    <admin-list-grid>
        <admin-list-column name="Name" position="20" title="@T["Market"]" />
        <admin-list-column name="Status" position="30" title="@T["Status"]" width="auto" />
        <admin-list-column type="Actions" title="@T["Actions"]" />
    </admin-list-grid>
</admin-list>
