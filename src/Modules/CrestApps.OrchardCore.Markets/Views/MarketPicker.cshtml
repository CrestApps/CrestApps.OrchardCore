@model MarketPickerViewModel

@*
    The market picker in the Navigation zone of front-end pages: the shopper's market and its currency, and the others
    to pick from. Picking one keeps it in a cookie and switches the storefront to the market's language. Override this
    shape to restyle it, or with an empty template to hide it.
*@

@{
    var label = Model.Current is null ? Model.StoreCurrency : $"{Model.Current.Name} · {Model.Current.Currency}";
}

<li class="nav-item dropdown">
    <a class="nav-link dropdown-toggle" href="#" id="market-picker" role="button" data-bs-toggle="dropdown" aria-expanded="false">
        <span class="fa-solid fa-globe" aria-hidden="true"></span>
        <span class="visually-hidden">@T["Market:"]</span>
        <span>@label</span>
    </a>
    <div class="dropdown-menu dropdown-menu-end" aria-labelledby="market-picker">
        <form asp-action="Choose" asp-controller="Market" asp-area="@MarketsConstants.Feature" method="post">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <h2 class="dropdown-header h6">@T["Shop in"]</h2>
            @foreach (var market in Model.Markets)
            {
                var isCurrent = Model.Current?.ItemId == market.ItemId;
                <button type="submit" name="marketId" value="@market.ItemId" class="dropdown-item@(isCurrent ? " active" : string.Empty)" aria-current="@(isCurrent ? "true" : null)">
                    @market.Name <span class="text-body-secondary">· @market.Currency</span>
                </button>
            }
            <div class="dropdown-divider"></div>
            <button type="submit" name="marketId" value="" class="dropdown-item@(Model.Current is null ? " active" : string.Empty)" aria-current="@(Model.Current is null ? "true" : null)">
                @T["Everywhere else"] <span class="text-body-secondary">· @Model.StoreCurrency</span>
            </button>
        </form>
    </div>
</li>
