@model ClassifiedPartSettingsViewModel

<div class="ocat-limited-wrapper" asp-validation-class-for="TermDays">
    <label asp-for="TermDays" class="ocat-label">@T["Days a listing runs"]</label>
    <div class="ocat-limited">
        <input asp-for="TermDays" type="number" min="1" max="3650" class="form-control" />
        <span asp-validation-for="TermDays"></span>
        <span class="hint">@T["From when it's approved, and again each time its poster renews it."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="RequireApproval">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input asp-for="RequireApproval" type="checkbox" class="form-check-input" />
            <label asp-for="RequireApproval" class="form-check-label">@T["A moderator approves each listing before it's shown"]</label>
        </div>
        <span class="hint dashed">@T["Also after its poster changes it."]</span>
    </div>
</div>
