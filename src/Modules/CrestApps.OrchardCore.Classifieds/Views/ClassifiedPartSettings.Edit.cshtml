@model ClassifiedPartSettingsViewModel

<div class="mb-3">
    <label asp-for="TermDays" class="form-label">@T["Days a listing runs"]</label>
    <input asp-for="TermDays" type="number" min="1" max="3650" class="form-control" style="max-width: 10rem;" />
    <span class="hint">@T["From when it's approved, and again each time its poster renews it."]</span>
</div>
<div class="mb-3">
    <div class="form-check">
        <input asp-for="RequireApproval" type="checkbox" class="form-check-input" />
        <label asp-for="RequireApproval" class="form-check-label">@T["A moderator approves each listing before it's shown"]</label>
        <span class="hint dashed">@T["Also after its poster changes it."]</span>
    </div>
</div>
