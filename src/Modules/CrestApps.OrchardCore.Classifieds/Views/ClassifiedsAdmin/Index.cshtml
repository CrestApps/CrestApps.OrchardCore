@model ClassifiedsAdminIndexViewModel

<zone Name="Title">
    <breadcrumb name="Classifieds" title="@T["Posted listings"]" />
</zone>

<form asp-action="Index" method="get" id="classifieds-filter">
    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <div class="input-group">
                        <input id="search-box" name="q" value="@Model.Search" class="form-control" placeholder="@T["Search by title"]" type="search" autocomplete="off" />
                        <button type="submit" class="btn btn-outline-secondary" title="@T["Search"]" aria-label="@T["Search"]"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

<admin-list name="Classifieds" context="Model.List"
            show-select-all="false"
            empty-message="@T["<strong>Nothing here!</strong> No posted listings match. Add the Classified part to a content type so visitors can post it."]">
    <admin-list-list item-css-class="list-group-item" />
    <admin-list-grid>
        <admin-list-column name="Name" position="20" title="@T["Listing"]" />
        <admin-list-column name="Details" position="30" title="@T["Status"]" width="auto" />
        <admin-list-column type="Actions" title="@T["Actions"]" />
    </admin-list-grid>
</admin-list>

<style asp-name="bootstrap-select"></style>
<script asp-name="commerce-admin-list" at="Foot"></script>
