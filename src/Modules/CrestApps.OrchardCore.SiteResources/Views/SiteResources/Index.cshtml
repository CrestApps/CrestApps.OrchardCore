@model ListCatalogEntryViewModel<CatalogEntryViewModel<SiteResource>>

<zone Name="Title">
    <breadcrumb name="SiteResources" title="@T["Site Resources"]" />
</zone>

@* The form is necessary to generate an antiforgery token for delete actions. *@
<form asp-action="Index" asp-route-pageSize="@Context.Request.Query["pageSize"]" method="post" class="no-multisubmit">
    <input type="submit" name="submit.Filter" id="submitFilter" class="visually-hidden" />

    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <div class="input-group">
                        <input id="search-box" asp-for="Options.Search" class="form-control" placeholder="@T["Search"]" type="search" autofocus autocomplete="off" />
                        <button type="submit" name="submit.Filter" class="btn btn-outline-secondary" title="@T["Search"]" aria-label="@T["Search"]"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
                    </div>
                </div>
                <div class="col-auto">
                    <a class="btn btn-secondary create" role="button" asp-action="Create">@T["Add resource"]</a>
                </div>
            </div>
        </div>
    </div>

    <admin-list name="SiteResources" context="Model.List"
                show-select-all="false"
                empty-message="@T["<strong>Nothing here!</strong> The site adds no stylesheet or script of its own yet."]">
        <admin-list-list item-css-class="list-group-item" />
        <admin-list-grid>
            <admin-list-column name="Name" position="20" title="@T["Name"]" />
            <admin-list-column name="Where" position="30" title="@T["Where"]" width="auto" />
            <admin-list-column name="Modified" position="90" title="@T["Last modified"]" width="auto" />
            <admin-list-column type="Actions" title="@T["Actions"]" />
        </admin-list-grid>
    </admin-list>
</form>
