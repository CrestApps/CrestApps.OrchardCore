@model EditCatalogEntryViewModel

<zone Name="Title">
    <breadcrumb name="SiteResourcesCreate" title="@T["New site resource"]">
        <breadcrumb-item id="SiteResources" action="Index" controller="SiteResources" area="CrestApps.OrchardCore.SiteResources" permission="@SiteResourcesPermissions.ManageSiteResources.Name">@T["Site Resources"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form method="post" enctype="multipart/form-data" class="no-multisubmit">
    @Html.ValidationSummary()
    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <button class="btn btn-primary" type="submit">@T["Save"]</button>
        <a class="btn btn-secondary cancel" role="button" asp-route-action="Index">@T["Cancel"]</a>
    </div>
</form>
