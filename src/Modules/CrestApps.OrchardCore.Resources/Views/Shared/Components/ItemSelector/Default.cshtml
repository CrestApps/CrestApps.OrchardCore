@model CrestApps.OrchardCore.Resources.ViewComponents.ItemSelectorViewModel

<style asp-name="bootstrap-select"></style>
<script asp-name="bootstrap-select" depends-on="bootstrap" at="Foot"></script>
<script asp-name="item-selector" depends-on="bootstrap-select" at="Foot"></script>

<select id="@Model.Id"
        name="@Model.InputName"
        class="selectpicker show-tick@(Model.SmallButton ? " btn-group-sm" : string.Empty)"
        multiple="@Model.Multiple"
        data-item-selector
        data-item-selector-config="@Model.ConfigurationJson"
        data-live-search="@(Model.SearchPlaceholder is null ? "false" : "true")"
        data-show-selected-tags="@(Model.Multiple && Model.SearchPlaceholder is not null ? "true" : "false")"
        data-live-search-placeholder="@Model.SearchPlaceholder"
        data-none-results-text="@Model.EmptyResultsText"
        data-header="@Model.MenuHeader"
        data-actions-box="@(Model.ActionsBox ? "true" : "false")"
        data-selected-text-format="count > 3"
        data-width="@(Model.SmallButton ? "auto" : "100%")"
        title="@Model.ButtonText">
    @if (!Model.Multiple)
    {
        <option value="">@Model.ButtonText</option>
    }
    @foreach (var item in Model.InitialItems)
    {
        <option value="@item.Value" selected="@item.Selected" disabled="@(!item.IsEnabled)" data-subtext="@item.SecondaryText">@item.Text</option>
    }
</select>
