@using System.Globalization
@using CrestApps.OrchardCore.PageSections
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Options
@using OrchardCore
@using OrchardCore.DisplayManagement
@using OrchardCore.DisplayManagement.Zones
@using OrchardCore.Localization
@using OrchardCore.Mvc.Utilities

@inject IOptions<PageSectionsOptions> SectionOptions
@inject IStringLocalizerFactory LocalizerFactory

@*
    The sections of a record's page (a staff profile, an account): the shapes of the page's Content zone, grouped by the
    tab of their placement (PageSectionPlacement.Location), listed down the side with the selected one on the right, so
    the list never wraps however many modules add a section. On a phone the list becomes a dropdown. The selected
    section is kept in the address's hash. Modules register a section's title, icon and position with AddPageSection.

    Shape properties: Zone (the Content zone), Page (the page name the sections are registered for), DefaultSection (the
    section of a shape placed without one), KeyPrefix (the prefix of the section ids in the hash) and PageId (the page element id).
*@
@{
    var zone = Model.Zone as IShape;
    string page = Model.Page;
    string defaultSection = Model.DefaultSection ?? "Overview";
    string keyPrefix = Model.KeyPrefix ?? "section-";
    string pageId = Model.PageId ?? "page-sections";
    var sections = new List<(string Key, string Name, double Position, List<IShape> Shapes)>();

    foreach (var item in zone?.Items ?? [])
    {
        if (item is not IShape shape)
        {
            continue;
        }

        // A tab is placed as "Name" or "Name;Position". A shape placed without a tab goes in the default section.
        var tab = shape.Metadata.Tab;
        var parts = string.IsNullOrWhiteSpace(tab) ? [] : tab.Split(';');
        var name = parts.Length == 0 ? defaultSection : parts[0].Trim();
        double position = SectionOptions.Value.Find(page, name)?.Position ?? 1000;

        if (SectionOptions.Value.Find(page, name) is null && parts.Length > 1 &&
            double.TryParse(parts[1], NumberStyles.Float, CultureInfo.InvariantCulture, out var placed))
        {
            position = placed;
        }

        var pane = sections.FindIndex(entry => string.Equals(entry.Name, name, StringComparison.OrdinalIgnoreCase));

        if (pane < 0)
        {
            sections.Add((keyPrefix + name.HtmlClassify(), name, position, [shape]));
        }
        else
        {
            sections[pane].Shapes.Add(shape);
        }
    }

    sections = [.. sections.OrderBy(pane => pane.Position).ThenBy(pane => pane.Name, StringComparer.Ordinal)];

    string Label(string name) => SectionOptions.Value.Find(page, name)?.Title is { } title ? LocalizerFactory.Localize(title).Value : name;

    string Icon(string name) => SectionOptions.Value.Find(page, name)?.Icon ?? "fa-solid fa-circle";
}

@if (sections.Count > 0)
{
    <div class="row g-3" id="@pageId" data-page-sections>
        <div class="col-12 col-md-4 col-lg-3">
            <select class="form-select d-md-none mb-2" aria-label="@T["Section"]" data-page-sections-select>
                @foreach (var pane in sections)
                {
                    <option value="@pane.Key">@Label(pane.Name)</option>
                }
            </select>
            <div class="list-group d-none d-md-flex" role="tablist" aria-orientation="vertical">
                @for (var i = 0; i < sections.Count; i++)
                {
                    var pane = sections[i];

                    <button type="button" class="list-group-item list-group-item-action d-flex align-items-center gap-2@(i == 0 ? " active" : null)"
                            id="@(pane.Key)-nav" data-bs-toggle="list" data-bs-target="#@pane.Key" role="tab"
                            aria-controls="@pane.Key" aria-selected="@(i == 0 ? "true" : "false")" data-page-sections-tab="@pane.Key">
                        <i class="@Icon(pane.Name) fa-fw text-secondary" aria-hidden="true"></i>
                        <span>@Label(pane.Name)</span>
                    </button>
                }
            </div>
        </div>
        <div class="col-12 col-md-8 col-lg-9">
            <div class="tab-content">
                @for (var i = 0; i < sections.Count; i++)
                {
                    var pane = sections[i];

                    <div class="tab-pane@(i == 0 ? " active" : null)" id="@pane.Key" role="tabpanel" aria-labelledby="@(pane.Key)-nav" tabindex="0">
                        @foreach (var shape in pane.Shapes.OrderBy(shape => shape.Metadata.Position, FlatPositionComparer.Instance))
                        {
                            @await DisplayAsync(shape)
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <script at="Foot">
        // Bootstrap's own script may come later in the page, so the sections are wired once the page has loaded.
        document.addEventListener('DOMContentLoaded', () => {
            const page = document.getElementById('@pageId');

            if (!page || !window.bootstrap) {
                return;
            }

            const select = page.querySelector('[data-page-sections-select]');
            const tabs = [...page.querySelectorAll('[data-page-sections-tab]')];

            const show = (key, updateHash) => {
                const tab = tabs.find(entry => entry.dataset.pageSectionsTab === key);

                if (!tab) {
                    return;
                }

                bootstrap.Tab.getOrCreateInstance(tab).show();

                if (select) {
                    select.value = key;
                }

                if (updateHash) {
                    history.replaceState(null, '', '#' + key);
                }
            };

            tabs.forEach(tab => tab.addEventListener('shown.bs.tab', () => {
                if (select) {
                    select.value = tab.dataset.pageSectionsTab;
                }

                history.replaceState(null, '', '#' + tab.dataset.pageSectionsTab);
            }));

            select?.addEventListener('change', () => show(select.value, true));

            // A link to a section of the page, such as the one a record's editor returns to, opens that section.
            show(location.hash.replace(/^#/, ''), false);
        });
    </script>
}
