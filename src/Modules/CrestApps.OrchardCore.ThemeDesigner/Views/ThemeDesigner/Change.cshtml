@model ThemeDesignChangeViewModel

@{
    var language = Model.Kind == ThemeDesignChangeKind.SiteResource ? "css / js" : "liquid";
}

<zone Name="Title">
    <breadcrumb name="ThemeDesignerChange" title="@T["{0}", Model.Name]">
        <breadcrumb-item id="ThemeDesigner" action="Index" controller="ThemeDesigner" area="@ThemeDesignerConstants.Features.ThemeDesigner">@T["Theme Draft"]</breadcrumb-item>
    </breadcrumb>
</zone>

<p>
    @(Model.Kind switch
    {
        ThemeDesignChangeKind.AdminTemplate => T["Admin template"],
        ThemeDesignChangeKind.SiteResource => T["Site resource"],
        _ => T["Front-end template"],
    })
    @if (Model.Status is { } status)
    {
        <span class="badge text-bg-secondary ms-1">@(status switch
        {
            ThemeDesignChangeStatus.Added => T["Added"],
            ThemeDesignChangeStatus.Removed => T["Removed"],
            _ => T["Changed"],
        })</span>
    }
</p>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">@T["Published"]</div>
            <div class="card-body">
                @if (Model.PublishedContent is null)
                {
                    <span class="text-body-secondary">@T["Not published: the theme's own template is used."]</span>
                }
                else
                {
                    <pre class="mb-0" style="max-height: 70vh; overflow: auto;" data-language="@language"><code>@Model.PublishedContent</code></pre>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">@T["Your draft"]</div>
            <div class="card-body">
                @if (Model.DraftContent is null)
                {
                    <span class="text-body-secondary">@T["Publishing removes it."]</span>
                }
                else
                {
                    <pre class="mb-0" style="max-height: 70vh; overflow: auto;" data-language="@language"><code>@Model.DraftContent</code></pre>
                }
            </div>
        </div>
    </div>
</div>

<form asp-action="Revert" method="post" class="mt-3 no-multisubmit">
    <input type="hidden" name="kind" value="@Model.Kind" />
    <input type="hidden" name="name" value="@Model.Name" />
    <a class="btn btn-secondary" asp-action="Index">@T["Back"]</a>
    <button type="submit" class="btn btn-danger" data-title="@T["Drop the change"]" data-message="@T["The published version will be left as it is. Continue?"]" data-url-af="UnsafeUrl">@T["Drop from draft"]</button>
</form>
