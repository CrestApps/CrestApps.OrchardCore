@using CrestApps.OrchardCore.Checkout
@using CrestApps.OrchardCore.Checkout.Core
@using CrestApps.OrchardCore.Checkout.ViewModels
@model CouponEditViewModel

<zone Name="Title">
    <breadcrumb name="CheckoutCouponsEdit" title="@T["Edit coupon"]">
        <breadcrumb-item id="CheckoutCoupons" action="Index" controller="CouponsAdmin" area="CrestApps.OrchardCore.Checkout" permission="@CheckoutPermissions.ManageCoupons.Name">@T["Coupons"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form asp-action="Edit" asp-route-itemId="@Model.ItemId" method="post">
    <partial name="_Editor" model="Model" />

    <div class="mb-3">
        <button type="submit" class="btn btn-primary">@T["Save"]</button>
        <a class="btn btn-secondary" asp-action="Index">@T["Cancel"]</a>
    </div>
</form>

@if (Model.Method == CrestApps.OrchardCore.Checkout.Models.CouponMethod.Code)
{
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">@T["Share and generate codes"]</h5>

            @if (!string.IsNullOrEmpty(Model.DiscountLinkUrl))
            {
                <label class="form-label" for="discount-link">@T["Discount link"]</label>
                <input id="discount-link" class="form-control mb-1" value="@Model.DiscountLinkUrl" readonly onclick="this.select()" />
                <span class="hint d-block mb-3">@T["Whoever opens it gets the code taken off at checkout, without typing it. Add ?redirect= and a page on this site, such as /products, to land somewhere other than the home page."]</span>
            }

            <p class="mb-2">
                @if (Model.GeneratedCodes > 0)
                {
                    @T["{0} unique codes generated, {1} used.", Model.GeneratedCodes, Model.UsedGeneratedCodes]
                    <a asp-action="ExportCodes" asp-route-itemId="@Model.ItemId" class="ms-1">@T["Download them (CSV)"]</a>
                }
                else
                {
                    @T["Generate unique codes to give one to each customer, such as single-use codes on cards or in emails. Each shares this coupon's discount and rules, and has its own uses."]
                }
            </p>

            <form asp-action="GenerateCodes" asp-route-itemId="@Model.ItemId" method="post" class="row g-2 align-items-end">
                <div class="col-sm-4 col-md-2">
                    <label class="form-label" for="generate-count">@T["How many"]</label>
                    <input id="generate-count" name="count" type="number" min="1" max="@CheckoutConstants.MaxGeneratedCodes" value="100" class="form-control" required />
                </div>
                <div class="col-sm-4 col-md-3">
                    <label class="form-label" for="generate-prefix">@T["Prefix"]</label>
                    <input id="generate-prefix" name="prefix" maxlength="12" class="form-control" autocomplete="off" placeholder="@T["Optional"]" />
                </div>
                <div class="col-sm-4 col-md-2">
                    <label class="form-label" for="generate-uses">@T["Uses per code"]</label>
                    <input id="generate-uses" name="usesPerCode" type="number" min="1" value="1" class="form-control" />
                </div>
                <div class="col-12 col-md-auto">
                    <button type="submit" class="btn btn-outline-primary">@T["Generate codes"]</button>
                </div>
            </form>
        </div>
    </div>
}

<partial name="_Redemptions" model="Model" />
