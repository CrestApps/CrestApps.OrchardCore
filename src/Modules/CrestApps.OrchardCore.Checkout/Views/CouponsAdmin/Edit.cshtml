@using CrestApps.OrchardCore.Checkout.Core
@using CrestApps.OrchardCore.Checkout.ViewModels
@model CouponEditViewModel

<zone Name="Title">
    <breadcrumb name="CheckoutCouponsEdit" title="@T["Edit coupon"]">
        <breadcrumb-item id="CheckoutCoupons" action="Index" controller="CouponsAdmin" area="CrestApps.OrchardCore.Checkout" permission="@CheckoutPermissions.ManageCoupons.Name">@T["Coupons"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form asp-action="Edit" asp-route-itemId="@Model.ItemId" method="post">
    <partial name="_Editor" model="Model" />

    <div class="mb-3">
        <button type="submit" class="btn btn-primary">@T["Save"]</button>
        <a class="btn btn-secondary" asp-action="Index">@T["Cancel"]</a>
    </div>
</form>
