@using CrestApps.OrchardCore.Checkout.ViewModels
@using Microsoft.AspNetCore.Mvc.Localization
@model CouponsIndexViewModel

<zone Name="Title">
    <breadcrumb name="Coupons" title="@T["Coupons"]" />
</zone>

@if (Model.HasUnboundedCoupons)
{
    <div class="alert alert-warning" role="alert">
        @T["One or more coupons have neither a usage limit nor an end date. A code that leaks will keep discounting until somebody notices."]
    </div>
}

@* The form also provides the antiforgery token used by the delete action. *@
<form asp-action="Index" asp-route-pageSize="@Context.Request.Query["pageSize"]" method="post" id="coupons-filter" class="no-multisubmit">
    <input type="submit" name="submit.Filter" id="submitFilter" class="visually-hidden" />

    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <div class="input-group">
                        <input asp-for="Options.Search" class="form-control" placeholder="@T["Search by code or description"]" type="search" autocomplete="off" />
                        <button type="submit" name="submit.Filter" class="btn btn-outline-secondary" title="@T["Search"]" aria-label="@T["Search"]"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
                    </div>
                </div>
                <div class="col-auto">
                    <a class="btn btn-secondary text-nowrap" asp-action="Create">@T["Add coupon"]</a>
                </div>
            </div>
        </div>
    </div>

    @* The coupons, the toolbar and the pager are rendered by the AdminList shape, in the layout (List or Grid) the site or the user picked. *@
    <admin-list name="Coupons" context="Model.List"
                show-select-all="false"
                empty-message="@T["<strong>Nothing here!</strong> There are no coupons that match the current filter."]">
        <admin-list-list item-css-class="list-group-item" />
        <admin-list-grid>
            <admin-list-column name="Name" position="20" title="@T["Code"]" />
            <admin-list-column name="Status" position="30" title="@T["Status"]" width="auto" />
            <admin-list-column name="Discount" position="40" title="@T["Discount"]" width="auto" />
            <admin-list-column name="Usage" position="50" title="@T["Used"]" width="auto" />
            <admin-list-column name="Ends" position="60" title="@T["Valid until"]" width="auto" />
            <admin-list-column type="Actions" title="@T["Actions"]" />
        </admin-list-grid>
    </admin-list>
</form>

<style asp-name="bootstrap-select"></style>
<script asp-name="commerce-admin-list" at="Foot"></script>
