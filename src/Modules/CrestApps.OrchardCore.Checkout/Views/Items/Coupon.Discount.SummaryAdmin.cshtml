@using CrestApps.OrchardCore.Checkout.Models
@using CrestApps.OrchardCore.Payments

@model ShapeViewModel<Coupon>

<span class="badge ta-badge bg-primary-subtle fw-normal" data-bs-toggle="tooltip" title="@T["Discount"]">
    <i class="fa-solid fa-percent text-secondary me-1" aria-hidden="true"></i>
    @if (Model.Value.Kind == CouponKind.Percentage)
    {
        @($"{Model.Value.Percentage:0.##}%")
    }
    else if (Model.Value.Kind == CouponKind.FreeShipping)
    {
        @T["Free shipping"]
    }
    else
    {
        @($"{Model.Value.Currency} {CurrencyScale.Format(Model.Value.Amount, Model.Value.Currency)}")
    }
</span>

<span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Applies to"]">
    <i class="fa-solid fa-bullseye text-secondary me-1" aria-hidden="true"></i>@(Model.Value.EffectiveTarget switch
    {
        DiscountTarget.FirstCycle => T["First cycle"],
        DiscountTarget.Shipping => T["Shipping"],
        _ => T["One-time amount"],
    })
</span>
