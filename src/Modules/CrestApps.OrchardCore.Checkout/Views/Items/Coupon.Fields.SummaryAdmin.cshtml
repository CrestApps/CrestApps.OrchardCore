@using CrestApps.OrchardCore.Checkout.Models

@model ShapeViewModel<Coupon>

@* A plain link to the edit page, like the title of a content item in the Manage Content list. *@
@if (Model.Value.IsAutomatic)
{
    <a asp-action="Edit" asp-route-itemId="@Model.Value.ItemId">@(string.IsNullOrEmpty(Model.Value.Description) ? Model.Value.Code : Model.Value.Description)</a>
    <span class="badge ta-badge bg-info-subtle fw-normal ms-1">@T["Automatic"]</span>
}
else
{
    <a asp-action="Edit" asp-route-itemId="@Model.Value.ItemId">@Model.Value.Code</a>
}
