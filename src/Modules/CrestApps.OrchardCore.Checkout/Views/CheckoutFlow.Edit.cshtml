@* The frame every checkout step is rendered inside. Zones are filled by the step drivers, so this stays
   agnostic of what any particular checkout collects. *@

@if (Model.Steps != null)
{
    @await DisplayAsync(Model.Steps)
}

<div class="row">
    <div class="col-lg-7">
        <div class="card">
            @if (Model.Header != null)
            {
                <div class="card-header">
                    @await DisplayAsync(Model.Header)
                </div>
            }

            <div class="card-body">
                @if (!ViewContext.ModelState.IsValid)
                {
                    <div class="alert alert-danger" role="alert">
                        @Html.ValidationSummary()
                    </div>
                }

                @if (Model.Content != null)
                {
                    @await DisplayAsync(Model.Content)
                }
            </div>

            @if (Model.Footer != null)
            {
                <div class="card-footer">
                    @await DisplayAsync(Model.Footer)
                </div>
            }
        </div>

        @if (Model.Actions != null)
        {
            @await DisplayAsync(Model.Actions)
        }
    </div>

    <div class="col-lg-5">
        @if (Model.Aside != null)
        {
            @await DisplayAsync(Model.Aside)
        }
    </div>
</div>

<style at="Foot">
    .alert > .validation-summary-errors > ul {
        margin-bottom: 0 !important;
    }
</style>
