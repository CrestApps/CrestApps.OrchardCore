@using CrestApps.OrchardCore.Checkout
@using CrestApps.OrchardCore.Payments

@model ShapeViewModel<CheckoutInvoice>

@{
    var invoice = Model.Value;
    var currency = invoice.Currency;

    string Format(decimal amount) => $"{currency} {CurrencyScale.Format(amount, currency)}";

    // The total is ruled off only from lines above it; with none, it sits alone.
    var hasBreakdown = (invoice.Discounts?.Count ?? 0) > 0 || invoice.TaxAmount > 0m;
}

<div class="card mb-4">
    <div class="card-header">
        <h2 class="h6 mb-0">@T["Order summary"]</h2>
    </div>
    <ul class="list-group list-group-flush">
        @foreach (var lineItem in invoice.LineItems ?? [])
        {
            <li class="list-group-item d-flex justify-content-between align-items-start">
                <div class="me-3">
                    <div>@lineItem.Description</div>
                    @if (lineItem.Quantity > 1)
                    {
                        <small class="text-body-secondary d-block">@T["{0} × {1}", lineItem.Quantity, Format(lineItem.UnitPrice)]</small>
                    }
                    @if (lineItem.Plan is not null)
                    {
                        <small class="text-body-secondary">
                            @T["Every {0} {1}", lineItem.Plan.BillingDuration, lineItem.Plan.DurationType.ToString().ToLowerInvariant()]
                        </small>
                    }
                </div>
                <span class="text-nowrap">@Format(lineItem.GetLineTotal(currency))</span>
            </li>
        }
    </ul>
    <div class="card-body">
        @* What the discounts took off, each on its own line, so the lines above and the total below add up. *@
        @foreach (var discount in invoice.Discounts ?? [])
        {
            <div class="d-flex justify-content-between text-success">
                <span>@if (string.IsNullOrEmpty(discount.Code) || discount.IsAutomatic) { @discount.Description } else { @T["Discount ({0})", discount.Code] }</span>
                <span>&minus;@Format(discount.Amount)</span>
            </div>
        }

        @* Tax is shown as its own line rather than folded into the total, so the customer can see exactly
           what they are being charged and why. *@
        @if (invoice.TaxAmount > 0m)
        {
            <div class="d-flex justify-content-between text-body-secondary">
                <span>@T["Subtotal"]</span>
                <span>@Format(invoice.DueNow)</span>
            </div>

            @foreach (var taxLine in invoice.TaxLines ?? [])
            {
                <div class="d-flex justify-content-between text-body-secondary small">
                    <span>@(string.IsNullOrEmpty(taxLine.TaxName) ? T["Tax"].Value : taxLine.TaxName)</span>
                    <span>@Format(taxLine.TaxAmount)</span>
                </div>
            }
        }

        @* A gift card or store credit pays after tax, like a second way to pay: the total stays what it is, and what is
           left to pay now is shown under the balances that pay toward it. *@
        @if (invoice.Tenders is { Count: > 0 })
        {
            <div class="d-flex justify-content-between fw-semibold@(hasBreakdown ? " border-top pt-2 mt-2" : null)">
                <span>@T["Total"]</span>
                <span>@Format(invoice.GrandTotal)</span>
            </div>

            @foreach (var tender in invoice.Tenders)
            {
                <div class="d-flex justify-content-between text-success">
                    <span>@tender.Description</span>
                    <span>&minus;@Format(tender.Amount)</span>
                </div>
            }

            <div class="d-flex justify-content-between fw-semibold border-top pt-2 mt-2">
                <span>@T["Due now"]</span>
                <span>@Format(invoice.AmountDue)</span>
            </div>
        }
        else
        {
            <div class="d-flex justify-content-between fw-semibold@(hasBreakdown ? " border-top pt-2 mt-2" : null)">
                <span>@T["Due now"]</span>
                <span>@Format(invoice.GrandTotal)</span>
            </div>
        }
    </div>
</div>
