@using CrestApps.OrchardCore.Checkout
@using CrestApps.OrchardCore.Checkout.Services

@model ShapeViewModel<CheckoutFlow>

@{
    var previousStep = Model.Value.GetPreviousStep();
    var isPaymentStep = Model.Value.CurrentStepEquals(CheckoutConstants.PaymentStepKey);

    // An order a gift card or a code covers has nothing to pay, so its button places it.
    var nothingToPay = isPaymentStep &&
        OrchardCore.Entities.EntityExtensions.TryGet<CheckoutInvoice>(Model.Value.Session, out var invoice) &&
        CheckoutObligations.GetExpectedObligationIds(invoice).Count == 0;

    // The way back to the page that started the checkout, when it named one.
    var returnLink = CheckoutReturnLinks.GetBackLink(Model.Value);
    var returnText = returnLink is null
        ? null
        : !string.IsNullOrEmpty(returnLink.ReturnText)
            ? returnLink.ReturnText
            : previousStep is null
                ? T["Back"].Value
                : T["Leave checkout"].Value;
}

@* On a phone the main button spans the width, with the way back under it. *@
<div class="d-flex flex-column-reverse flex-sm-row justify-content-between align-items-stretch align-items-sm-center gap-2 mt-4 mb-4">
    <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-sm-start gap-2">
        @if (previousStep is not null)
        {
            <a class="btn btn-link"
               asp-route="@CheckoutConstants.RouteNames.Step"
               asp-route-sessionId="@Model.Value.Session.SessionId"
               asp-route-step="@previousStep.Key">
                @T["Back"]
            </a>
        }

        @if (returnLink is not null)
        {
            <a class="btn btn-link" href="@Url.Content(returnLink.ReturnUrl)" data-checkout-return>
                @returnText
            </a>
        }
    </div>

    <button type="submit" class="btn btn-primary px-4" id="checkout-submit">
        <span class="checkout-submit-label">@(isPaymentStep ? nothingToPay ? T["Place order"] : T["Pay now"] : T["Continue"])</span>
        <span class="checkout-submit-busy d-none">
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            @T["Processing…"]
        </span>
    </button>
</div>
