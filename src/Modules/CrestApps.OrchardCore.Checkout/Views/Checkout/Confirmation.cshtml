@using CrestApps.OrchardCore.Checkout.ViewModels
@using Microsoft.AspNetCore.Html
@using OrchardCore.DisplayManagement.Html

@model CheckoutViewModel

@{
    // A checkout that is not an order (a fee, a balance) names itself, so it is not headed "Order confirmation"
    // and not thanked for a "purchase".
    var hasTitle = !string.IsNullOrEmpty(Model.Title);
    var title = hasTitle ? new HtmlContentString(Model.Title) : (IHtmlContent)T["Order confirmation"];
}

<zone Name="Title">
    <breadcrumb name="CheckoutConfirmation" title="@title" />
</zone>

@* The thanks and the way back are the CheckoutThankYou shape, so a theme can change them by overriding it. *@
@await DisplayAsync(await New.CheckoutThankYou(Title: Model.Title, PaymentDeferred: Model.PaymentDeferred, ReturnUrl: Model.ReturnUrl, ReturnText: Model.ReturnText, Part: "Header"))

<div class="row justify-content-center">
    <div class="col-lg-8">
        @await DisplayAsync(Model.Content)

        @await DisplayAsync(await New.CheckoutThankYou(Title: Model.Title, PaymentDeferred: Model.PaymentDeferred, ReturnUrl: Model.ReturnUrl, ReturnText: Model.ReturnText, Part: "Return"))
    </div>
</div>
