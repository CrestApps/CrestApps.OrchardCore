@using CrestApps.Core.Models
@using CrestApps.OrchardCore.AI.Mcp.Core

@model EditCatalogEntryViewModel

<zone Name="Title">
    <breadcrumb name="McpPromptsEdit" title="@T["Edit MCP Prompt - {0}", Model.DisplayName]">
        <breadcrumb-item id="McpPrompts" action="Index" controller="Prompts" area="CrestApps.OrchardCore.AI.Mcp" permission="@McpPermissions.ManageMcpPrompts.Name">@T["MCP Prompts"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form method="post" enctype="multipart/form-data" class="no-multisubmit">
    @Html.ValidationSummary()
    @await DisplayAsync(Model.Editor)

    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <button class="btn btn-primary" type="submit">@T["Save"]</button>
            <a class="btn btn-secondary cancel"
               role="button"
               asp-route-action="Index"
               asp-route-controller="Prompts">@T["Cancel"]</a>
        </div>
    </div>
</form>
