@using CrestApps.Core.Azure.Models
@using CrestApps.OrchardCore.OpenAI.Azure.ViewModels
@model AzureSpeechDeploymentViewModel

<div class="ocat-wrapper">
    <label asp-for="Endpoint" class="ocat-label ocat-label-required">@T["Endpoint"]</label>
    <div class="ocat-end">
        <input type="url" asp-for="Endpoint" class="form-control" />
        <span asp-validation-for="Endpoint" class="text-danger"></span>
        <span class="hint">@T["The Azure OpenAI endpoint hosting the Whisper model deployment."]</span>
    </div>
</div>

