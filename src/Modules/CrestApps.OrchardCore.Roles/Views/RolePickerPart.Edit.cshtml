@using CrestApps.OrchardCore.Roles.ViewModels

@model RolePickerViewModel

<style asp-name="bootstrap-select"></style>
<script asp-name="bootstrap-select" at="Foot"></script>

<div class="ocat-wrapper" asp-validation-class-for="Roles">
    <label asp-for="Roles" class="ocat-label">@Model.DisplayName</label>
    <div class="ocat-end">
        @if (Model.Settings.AllowSelectMultiple)
        {
            <select asp-for="Roles"
                    asp-items="Model.AvailableRoles"
                    class="selectpicker show-tick"
                    multiple
                    data-live-search="true"
                    data-actions-box="true"
                    data-header="@T["Select roles"]"
                    data-width="100%"
                    data-selected-text-format="count > 2"
                    data-count-selected-text="@T["{0} roles selected", "{0}"]"
                    data-none-selected-text="@T["No roles selected"]"
                    data-style="btn-light"
                    title="@Model.DisplayName">
            </select>
        }
        else
        {
            <select asp-for="Roles"
                    asp-items="Model.AvailableRoles"
                    class="selectpicker"
                    data-live-search="true"
                    data-width="100%"
                    data-none-selected-text="@T["No role selected"]"
                    data-style="btn-light"
                    title="@Model.DisplayName">
            </select>
        }

        <span asp-validation-for="Roles"></span>

        @if (!string.IsNullOrEmpty(Model.Settings?.Hint))
        {
            <span class="hint">@Model.Settings.Hint</span>
        }
    </div>
</div>
