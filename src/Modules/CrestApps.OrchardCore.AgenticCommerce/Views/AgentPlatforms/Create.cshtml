@model EditCatalogEntryViewModel

<zone Name="Title">
    <breadcrumb name="AgentPlatformsCreate" title="@T["New AI agent platform"]">
        <breadcrumb-item id="AgentPlatforms" action="Index" controller="AgentPlatforms" area="CrestApps.OrchardCore.AgenticCommerce" permission="@AgenticCommercePermissions.ManageAgentPlatforms.Name">@T["AI agents"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form method="post" enctype="multipart/form-data" class="no-multisubmit">
    @Html.ValidationSummary()
    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <button class="btn btn-primary" type="submit">@T["Save"]</button>
        <a class="btn btn-secondary cancel" role="button" asp-route-action="Index">@T["Cancel"]</a>
    </div>
</form>
