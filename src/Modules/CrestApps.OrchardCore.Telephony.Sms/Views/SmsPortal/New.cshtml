@model SmsComposeViewModel

<zone Name="Title"><h1>@RenderTitleSegments(T["New conversation"])</h1></zone>

<form method="post" class="no-multisubmit">
    @Html.ValidationSummary()

    <div class="mb-3">
        <label asp-for="EndpointId" class="form-label">@T["Send from (number)"]</label>
        <select asp-for="EndpointId" class="form-select" asp-items="Model.Endpoints">
            <option value="">@T["Select an SMS number"]</option>
        </select>
        <span asp-validation-for="EndpointId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="To" class="form-label">@T["To"]</label>
        <input asp-for="To" class="form-control" placeholder="@T["Recipient number (E.164)"]" />
        <span asp-validation-for="To" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Body" class="form-label">@T["Message"]</label>
        <textarea asp-for="Body" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Body" class="text-danger"></span>
    </div>

    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <button class="btn btn-primary" type="submit">@T["Send"]</button>
            <a class="btn btn-secondary cancel" role="button" asp-route-action="Index">@T["Cancel"]</a>
        </div>
    </div>
</form>
