@model SmsComposeViewModel

<zone Name="Title"><h1>@RenderTitleSegments(T["New conversation"])</h1></zone>

<form method="post" class="no-multisubmit">
    @Html.ValidationSummary()

    <div class="mb-3">
        <label asp-for="EndpointId" class="form-label">@T["Send from (number)"]</label>
        <select asp-for="EndpointId" class="form-select" asp-items="Model.Endpoints">
            <option value="">@T["Select an SMS number"]</option>
        </select>
        <span asp-validation-for="EndpointId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">@T["Find a customer"]</label>
        <input type="text" id="customer-search" class="form-control" placeholder="@T["Search customers by name…"]" autocomplete="off" />
        <div id="customer-results" class="list-group mt-1" style="max-height: 12rem; overflow-y: auto;"></div>
        <span class="hint">@T["Pick customers to add their number below; the conversation links to the customer automatically."]</span>
    </div>

    <div class="mb-3">
        <label asp-for="Recipients" class="form-label">@T["Recipients"]</label>
        <textarea asp-for="Recipients" id="recipients" class="form-control" rows="3" placeholder="@T["One number per line (E.164), or comma-separated"]"></textarea>
        <span class="hint">@T["One recipient starts a 1:1 conversation; multiple recipients start a group (each gets their own private 1:1 thread)."]</span>
        <span asp-validation-for="Recipients" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Body" class="form-label">@T["Message"]</label>
        <textarea asp-for="Body" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Body" class="text-danger"></span>
    </div>

    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <button class="btn btn-primary" type="submit">@T["Send"]</button>
            <a class="btn btn-secondary cancel" role="button" asp-route-action="Index">@T["Cancel"]</a>
        </div>
    </div>
</form>

<script at="Foot">
    (function () {
        var search = document.getElementById('customer-search');
        var results = document.getElementById('customer-results');
        var recipients = document.getElementById('recipients');
        if (!search || !results || !recipients) { return; }

        var url = '@Url.Action("SearchCustomers")';
        var timer = null;

        function addNumber(phone) {
            var current = recipients.value.split(/[\n,;]+/).map(function (s) { return s.trim(); }).filter(Boolean);
            if (current.indexOf(phone) === -1) {
                current.push(phone);
                recipients.value = current.join('\n');
            }
        }

        search.addEventListener('input', function () {
            var q = this.value.trim();
            clearTimeout(timer);
            if (q.length < 2) { results.innerHTML = ''; return; }
            timer = setTimeout(function () {
                fetch(url + '?q=' + encodeURIComponent(q), { headers: { 'Accept': 'application/json' } })
                    .then(function (r) { return r.json(); })
                    .then(function (items) {
                        results.innerHTML = '';
                        items.forEach(function (item) {
                            var a = document.createElement('a');
                            a.href = 'javascript:void(0)';
                            a.className = 'list-group-item list-group-item-action';
                            a.textContent = item.name + ' — ' + item.phone;
                            a.addEventListener('click', function () { addNumber(item.phone); results.innerHTML = ''; search.value = ''; });
                            results.appendChild(a);
                        });
                    });
            }, 250);
        });
    })();
</script>
