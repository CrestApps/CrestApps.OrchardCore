@model SmsNumberRouteViewModel

<div class="mb-3">
    <label asp-for="Name" class="form-label">@T["Name"]</label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="EndpointId" class="form-label">@T["Number (DID)"]</label>
    <select asp-for="EndpointId" class="form-select" asp-items="Model.Endpoints">
        <option value="">@T["Select an SMS number"]</option>
    </select>
    <span class="hint">@T["The SMS channel endpoint (number) inbound messages are received on. Add numbers under Omnichannel channel endpoints."]</span>
    <span asp-validation-for="EndpointId" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="TargetType" class="form-label">@T["Routes to"]</label>
    <select asp-for="TargetType" class="form-select" asp-items="Model.TargetTypes"></select>
</div>

<div class="mb-3">
    <label asp-for="TargetId" class="form-label">@T["Target"]</label>
    <input asp-for="TargetId" class="form-control" />
    <span class="hint">@T["For an agent target, the agent profile id; for a queue (department) target, the queue id."]</span>
    <span asp-validation-for="TargetId" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="DistributionMode" class="form-label">@T["Queue distribution"]</label>
    <select asp-for="DistributionMode" class="form-select" asp-items="Model.DistributionModes"></select>
    <span class="hint">@T["Only applies when routing to a queue."]</span>
</div>

<div class="mb-3">
    <label asp-for="AutoReplyMessage" class="form-label">@T["Auto-reply message"]</label>
    <textarea asp-for="AutoReplyMessage" class="form-control" rows="2"></textarea>
    <span class="hint">@T["Optional message sent to the customer on their first inbound message."]</span>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label">@T["Description"]</label>
    <textarea asp-for="Description" class="form-control" rows="2"></textarea>
</div>

<div class="form-check mb-3">
    <input asp-for="Enabled" class="form-check-input" />
    <label asp-for="Enabled" class="form-check-label">@T["Enabled"]</label>
</div>
