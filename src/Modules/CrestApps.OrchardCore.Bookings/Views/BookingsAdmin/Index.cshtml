@model BookingsIndexViewModel

<zone Name="Title">
    <breadcrumb name="Bookings" title="@T["Bookings"]" />
</zone>

<form asp-action="Index" method="get" id="bookings-filter">
    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <div class="input-group">
                        <input id="search-box" name="q" value="@Model.Search" class="form-control" placeholder="@T["Search by buyer or product"]" type="search" autocomplete="off" />
                        <button type="submit" class="btn btn-outline-secondary" title="@T["Search"]" aria-label="@T["Search"]"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
                    </div>
                </div>
                <div class="col-auto">
                    <a class="btn btn-secondary text-nowrap" asp-action="Calendar">@T["Calendar"]</a>
                </div>
            </div>
        </div>
    </div>
</form>

<admin-list name="Bookings" context="Model.List"
            show-select-all="false"
            empty-message="@T["<strong>Nothing here!</strong> No bookings match. Give a product the Booking part to sell dates, nights or times."]">
    <admin-list-list item-css-class="list-group-item" />
    <admin-list-grid>
        <admin-list-column name="Name" position="20" title="@T["Booking"]" />
        <admin-list-column name="When" position="30" title="@T["When"]" width="auto" />
        <admin-list-column name="Status" position="40" title="@T["Status"]" width="auto" />
        <admin-list-column type="Actions" title="@T["Actions"]" />
    </admin-list-grid>
</admin-list>

<style asp-name="bootstrap-select"></style>
<script asp-name="commerce-admin-list" at="Foot"></script>
