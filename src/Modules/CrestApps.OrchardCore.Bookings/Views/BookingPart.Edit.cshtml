@using CrestApps.OrchardCore.Bookings.Models
@model CrestApps.OrchardCore.Bookings.ViewModels.BookingPartViewModel

@{
    var prefix = Html.IdFor(model => model.Kind).Replace("_Kind", string.Empty);
    var currency = string.IsNullOrEmpty(Model.Currency) ? T.GetString("the product's currency").Value : Model.Currency;
}

<fieldset class="mb-3" id="@(prefix)-booking" data-booking-editor>
    <legend class="h5">@T["Booking"]</legend>

    <div class="ocat-limited-wrapper">
        <label asp-for="Kind" class="ocat-label">@T["What's booked"]</label>
        <div class="ocat-limited">
            <select asp-for="Kind" class="form-select" data-booking-kind>
                <option value="@BookingKind.Departure">@T["A date with seats, such as a tour, an event or a class"]</option>
                <option value="@BookingKind.Nightly">@T["Nights, such as a room or a rental"]</option>
                <option value="@BookingKind.TimeSlot">@T["A time, such as an appointment"]</option>
            </select>
        </div>
    </div>

    <div class="ocat-limited-wrapper">
        <label asp-for="Capacity" class="ocat-label">@T["Capacity"]</label>
        <div class="ocat-limited">
            <input asp-for="Capacity" type="number" min="0" class="form-control" />
            <span class="hint">@T["How many can be booked on each date: seats on a departure, rooms a night, or bookings in a time slot. A departure's own dates can say otherwise."]</span>
        </div>
    </div>

    <div class="ocat-wrapper" data-booking-for="@BookingKind.Departure">
        <div class="ocat-end-offset">
            @if (!string.IsNullOrEmpty(Model.ContentItemId))
            {
                <a class="btn btn-secondary btn-sm" asp-area="@CrestApps.OrchardCore.Bookings.BookingsConstants.Feature" asp-controller="BookingsAdmin" asp-action="Dates" asp-route-contentItemId="@Model.ContentItemId">@T["Manage dates"]</a>
                <span class="hint d-block">@T["The departures buyers can choose, each with its seats and, optionally, its own price."]</span>
            }
            else
            {
                <span class="hint">@T["Publish the product, then add its dates from here."]</span>
            }
        </div>
    </div>

    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <div class="form-check">
                <input asp-for="PricePerPerson" type="checkbox" class="form-check-input" />
                <label asp-for="PricePerPerson" class="form-check-label">@T["The price is per person"]</label>
            </div>
            <span class="hint dashed">@T["Such as a tour's. Untick it for a price per unit, such as a room's, whoever is in it."]</span>
        </div>
    </div>

    <div class="ocat-wrapper">
        <span class="ocat-label">@T["Options"]</span>
        <div class="ocat-end">
            <div class="row g-2 mb-1 small text-body-secondary d-none d-md-flex">
                <div class="col-md-6">@T["Option"]</div>
                <div class="col-md-2">@T["People"]</div>
                <div class="col-md-4">@T["Price change ({0})", currency]</div>
            </div>
            @for (var i = 0; i < Model.Occupancies.Count; i++)
            {
                <div class="row g-2 mb-2">
                    <input type="hidden" asp-for="Occupancies[i].Id" />
                    <div class="col-12 col-md-6"><input asp-for="Occupancies[i].Label" class="form-control" maxlength="80" placeholder="@T["Such as Double room or Child"]" aria-label="@T["Option, row {0}", i + 1]" /></div>
                    <div class="col-6 col-md-2"><input asp-for="Occupancies[i].People" type="number" min="1" max="50" class="form-control" placeholder="1" aria-label="@T["People, row {0}", i + 1]" /></div>
                    <div class="col-6 col-md-4"><input asp-for="Occupancies[i].PriceAdjustment" inputmode="decimal" class="form-control" placeholder="0" aria-label="@T["Price change, row {0}", i + 1]" /></div>
                </div>
            }
            <span class="hint">@T["Optional. What a unit can be, such as a single or a double room, with how many people it's for and what it adds to or takes off the price once, such as a single supplement (300) or a child's price (-150). Clear an option's name to remove it."]</span>
        </div>
    </div>

    <div data-booking-for="@BookingKind.Nightly">
        <div class="ocat-limited-wrapper">
            <label asp-for="MinNights" class="ocat-label">@T["Fewest nights"]</label>
            <div class="ocat-limited">
                <input asp-for="MinNights" type="number" min="1" class="form-control" />
            </div>
        </div>
        <div class="ocat-limited-wrapper">
            <label asp-for="MaxNights" class="ocat-label">@T["Most nights"]</label>
            <div class="ocat-limited">
                <input asp-for="MaxNights" type="number" min="1" class="form-control" />
            </div>
        </div>
        <div class="ocat-limited-wrapper">
            <label asp-for="WeekendPrice" class="ocat-label">@T["Friday and Saturday nights ({0})", currency]</label>
            <div class="ocat-limited">
                <input asp-for="WeekendPrice" inputmode="decimal" class="form-control" />
                <span class="hint">@T["Optional. The price of a weekend night, in place of the product's."]</span>
            </div>
        </div>
    </div>

    <div data-booking-for="@BookingKind.TimeSlot">
        <div class="ocat-wrapper">
            <span class="ocat-label">@T["Opening hours"]</span>
            <div class="ocat-end">
                @for (var i = 0; i < Model.Hours.Count; i++)
                {
                    <div class="row g-2 mb-2 align-items-center">
                        <input type="hidden" asp-for="Hours[i].Day" />
                        <div class="col-12 col-md-3">
                            <div class="form-check">
                                <input asp-for="Hours[i].Open" type="checkbox" class="form-check-input" />
                                <label asp-for="Hours[i].Open" class="form-check-label">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetDayName(Model.Hours[i].Day)</label>
                            </div>
                        </div>
                        <div class="col-6 col-md-2"><input asp-for="Hours[i].Opens" type="time" class="form-control" aria-label="@T["Opens"]" /></div>
                        <div class="col-6 col-md-2"><input asp-for="Hours[i].Closes" type="time" class="form-control" aria-label="@T["Closes"]" /></div>
                    </div>
                }
            </div>
        </div>
        <div class="ocat-limited-wrapper">
            <label asp-for="SlotMinutes" class="ocat-label">@T["Minutes a slot"]</label>
            <div class="ocat-limited">
                <input asp-for="SlotMinutes" type="number" min="5" step="5" class="form-control" />
            </div>
        </div>
    </div>

    <div class="ocat-limited-wrapper" data-booking-for="@BookingKind.Nightly @BookingKind.TimeSlot">
        <label asp-for="DaysAhead" class="ocat-label">@T["Days ahead"]</label>
        <div class="ocat-limited">
            <input asp-for="DaysAhead" type="number" min="1" max="730" class="form-control" />
            <span class="hint">@T["How far ahead it can be booked."]</span>
        </div>
    </div>

    <div class="ocat-limited-wrapper">
        <label asp-for="DepositPercent" class="ocat-label">@T["Deposit (%)"]</label>
        <div class="ocat-limited">
            <input asp-for="DepositPercent" inputmode="decimal" class="form-control" placeholder="@T["Paid in full"]" />
        </div>
    </div>

    <div class="ocat-limited-wrapper">
        <label asp-for="BalanceDueDaysBefore" class="ocat-label">@T["Rest due (days before)"]</label>
        <div class="ocat-limited">
            <input asp-for="BalanceDueDaysBefore" type="number" min="0" class="form-control" />
        </div>
    </div>

    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <span class="hint">@T["Optional. A buyer can pay this much now; the rest is charged to the same card this many days before the date. A booking closer than that is paid in full."]</span>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="CancellationTiers">
        <span class="ocat-label">@T["Cancellation policy"]</span>
        <div class="ocat-end">
            <div class="row g-2 mb-1 small text-body-secondary d-none d-md-flex">
                <div class="col-md-4">@T["Canceled at least (days before)"]</div>
                <div class="col-md-4">@T["Fee (%)"]</div>
            </div>
            @for (var i = 0; i < Model.CancellationTiers.Count; i++)
            {
                <div class="row g-2 mb-2">
                    <div class="col-6 col-md-4"><input asp-for="CancellationTiers[i].DaysBefore" type="number" min="0" class="form-control" aria-label="@T["Days before, row {0}", i + 1]" /></div>
                    <div class="col-6 col-md-4"><input asp-for="CancellationTiers[i].FeePercent" inputmode="decimal" class="form-control" aria-label="@T["Fee, row {0}", i + 1]" /></div>
                </div>
            }
            <span class="hint">@T["Optional. What canceling costs, such as 10% at least 60 days before, 50% at least 30 days before, and everything closer than the last rule. With no rules, a booking is canceled for a full refund."]</span>
            <span asp-validation-for="CancellationTiers" class="text-danger"></span>
        </div>
    </div>

    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <div class="form-check">
                <input asp-for="RequestToBook" type="checkbox" class="form-check-input" />
                <label asp-for="RequestToBook" class="form-check-label">@T["Confirm each booking before it's paid"]</label>
            </div>
            <span class="hint dashed">@T["Buyers send a request; you confirm it by sending the quote from its order, and they pay from its link."]</span>
        </div>
    </div>

    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <div class="form-check">
                <input asp-for="AskForTravelers" type="checkbox" class="form-check-input" />
                <label asp-for="AskForTravelers" class="form-check-label">@T["Ask for each traveler's details at checkout"]</label>
            </div>
            <span class="hint dashed">@T["The fields of the Traveler content type, once per person. Add them under Content definition, Content types, Traveler."]</span>
        </div>
    </div>
</fieldset>

<script at="Foot">
    (() => {
        const editor = document.getElementById('@(prefix)-booking');
        const kind = editor?.querySelector('[data-booking-kind]');

        if (!kind) {
            return;
        }

        // Only what the kind chosen uses is shown.
        const names = { '0': 'Departure', '1': 'Nightly', '2': 'TimeSlot', Departure: 'Departure', Nightly: 'Nightly', TimeSlot: 'TimeSlot' };
        const show = () => {
            const chosen = names[kind.value] || kind.value;

            editor.querySelectorAll('[data-booking-for]').forEach(section => {
                section.hidden = !section.dataset.bookingFor.split(' ').includes(chosen);
            });
        };

        kind.addEventListener('change', show);
        show();
    })();
</script>
