@model IShape

<zone Name="Title">
    <breadcrumb name="BookingRequest" title="@T["Request to book"]">
        <breadcrumb-item id="Cart" url="@Url.RouteUrl("Cart")">@T["Cart"]</breadcrumb-item>
    </breadcrumb>
</zone>

<div class="container my-4" style="max-width: 40rem;">
    @await DisplayAsync(Model)
</div>
