@using Microsoft.AspNetCore.Mvc.Rendering
@*
    The status and date filters of the bookings list, passed to the admin list as its 'ToolbarActions' so they render at
    the end of the list's toolbar. The selects name the filter form, so they submit it wherever the list is rendered; the
    commerce-admin-list script submits it when one changes.
*@
@{
    var statuses = (IEnumerable<SelectListItem>)Model.Statuses;
    var whens = (IEnumerable<SelectListItem>)Model.Whens;
}

<div class="btn-group filter">
    <select name="status" asp-items="statuses" form="bookings-filter" class="selectpicker show-tick" data-style="btn-sm" data-width="fit" data-header="@T["Filter by status"]" data-dropdown-align-right="auto" data-commerce-list-filter aria-label="@T["Status"]"></select>
    <select name="when" asp-items="whens" form="bookings-filter" class="selectpicker show-tick" data-style="btn-sm" data-width="fit" data-header="@T["Dates"]" data-dropdown-align-right="auto" data-commerce-list-filter aria-label="@T["Dates"]"></select>
</div>
