@using CrestApps.OrchardCore.Learning.Packages.Recipes
@model ShapeViewModel<LearningPackageRuntimeStatesDeploymentStep>

<h5>@T["Learning package runtime states (learner records)"]</h5>
<p class="hint">@T["Exports every learner's SCORM runtime state on the learning packages (status, score, time, suspend data and interactions), naming people by user name. The package files stay in the protected store of this site. Learner records hold personal data: the export needs the Export learner records permission and is recorded."]</p>
