@model PackageUploadViewModel

@if (!string.IsNullOrEmpty(Model.Part?.PackageFileId))
{
    <div class="ocat-wrapper">
        <span class="ocat-label">@T["Current package"]</span>
        <div class="ocat-end">
            <p class="form-control-plaintext mb-0">@Model.Part.Title (@Model.Part.FileName)</p>
            <span class="hint">@T["A new import replaces it in a draft of the item. Learners keep the current package until the draft is published."]</span>
        </div>
    </div>
}
<div class="ocat-wrapper" asp-validation-class-for="ContentItemId">
    <label for="package" class="ocat-label">@T["Package file"]</label>
    <div class="ocat-end">
        <input id="package" name="package" type="file" class="form-control" accept=".zip,application/zip" required />
        @if (Model.AcceptCmi5)
        {
            <span class="hint">@T["Or a cmi5 course: a .zip file with cmi5.xml at its root. AUs with a relative URL must be files of the package; an AU with an absolute URL must use https."]</span>
        }
        <span class="hint">@T["A .zip file of up to {0} MB with imsmanifest.xml at its root: a SCORM 1.2 or SCORM 2004 (3rd or 4th Edition) package, whose version is read from its manifest. The files are checked, kept in a private store and opened only for learners who launch the item.", Model.MaxUploadMb]</span>
    </div>
</div>
@if (!Model.HasContentHost)
{
    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <span class="hint" data-content-host-note>@T["Packages that run in several frames, such as those made with Articulate Rise and Storyline 360, need a package content host; without one they show a blank page."]
                @if (Model.CanManageSettings)
                {
                    <a href="@Url.Action("Index", "Admin", new { area = "OrchardCore.Settings", groupId = "learning-packages" })">@T["Set the package content host"]</a>
                }
            </span>
        </div>
    </div>
}
