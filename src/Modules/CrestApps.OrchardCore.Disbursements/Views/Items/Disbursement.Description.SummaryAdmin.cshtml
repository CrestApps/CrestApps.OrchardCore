@using CrestApps.OrchardCore.Currencies
@model ShapeViewModel<Disbursement>

@{
    var disbursement = Model.Value;
}

<div class="admin-list-secondary">
    @CurrencyScale.Format(disbursement.Amount, disbursement.Currency)
    @if (disbursement.EffectiveDate is { } date)
    {
        <span> · @T["arrives {0}", date.ToString("d")]</span>
    }
    @if (!string.IsNullOrEmpty(disbursement.TraceNumber))
    {
        <span> · @T["trace {0}", disbursement.TraceNumber]</span>
    }
    @if (!string.IsNullOrEmpty(disbursement.Memo))
    {
        <span> · @disbursement.Memo</span>
    }
    @if (!string.IsNullOrEmpty(disbursement.FailureReason))
    {
        <span class="text-danger"> · @disbursement.FailureCode @disbursement.FailureReason</span>
    }
</div>
