<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <Title>CrestApps OrchardCore Surveys AI Module</Title>
    <Description>
      $(CrestAppsDescription)

      AI for Surveys: AI tools that list surveys, read their results and draft a new survey, a summary of the answers to a
      written question, a translation of a survey into another culture, and scoring help for graders.
    </Description>
    <PackageTags>$(PackageTags) Surveys AI Grading Translation</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrestApps.OrchardCore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CrestApps.Core.AI" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="OrchardCore.Module.Targets" />
    <PackageReference Include="OrchardCore.Admin.Abstractions" />
    <PackageReference Include="OrchardCore.DisplayManagement" />
    <PackageReference Include="OrchardCore.Infrastructure.Abstractions" />
    <PackageReference Include="OrchardCore.Navigation.Core" />
    <PackageReference Include="OrchardCore.ResourceManagement" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Abstractions\CrestApps.OrchardCore.Abstractions\CrestApps.OrchardCore.Abstractions.csproj" />
    <ProjectReference Include="..\..\Abstractions\CrestApps.OrchardCore.Surveys.Abstractions\CrestApps.OrchardCore.Surveys.Abstractions.csproj" />
    <ProjectReference Include="..\..\Core\CrestApps.OrchardCore.AI.Core\CrestApps.OrchardCore.AI.Core.csproj" />
    <ProjectReference Include="..\..\Core\CrestApps.OrchardCore.Core\CrestApps.OrchardCore.Core.csproj" />
    <ProjectReference Include="..\..\Core\CrestApps.OrchardCore.Surveys.Core\CrestApps.OrchardCore.Surveys.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The modules this one depends on, so installing its package brings the features it needs. -->
    <ProjectReference Include="..\CrestApps.OrchardCore.Surveys\CrestApps.OrchardCore.Surveys.csproj" PrivateAssets="none" />
    <ProjectReference Include="..\CrestApps.OrchardCore.AI\CrestApps.OrchardCore.AI.csproj" PrivateAssets="none" />
  </ItemGroup>

</Project>
