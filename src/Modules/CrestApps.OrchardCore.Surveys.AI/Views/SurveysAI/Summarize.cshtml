@model SurveyAISummarizeViewModel

<zone Name="Title">
    <breadcrumb name="SurveysAISummarize" title="@T["Summarize answers"]">
        <breadcrumb-item id="SurveysIndex" action="Index" controller="Surveys" area="CrestApps.OrchardCore.Surveys" permission="@SurveysPermissions.ManageOwnSurveys.Name">@T["Surveys"]</breadcrumb-item>
        <breadcrumb-item id="SurveysDesign" action="Design" controller="SurveyDesigner" area="CrestApps.OrchardCore.Surveys" route-id="@Model.Survey.ItemId">@Model.Survey.Title</breadcrumb-item>
    </breadcrumb>
</zone>

@if (!Model.ModelAvailable)
{
    <div class="alert alert-warning" role="alert">@T["No AI model is set up for this site. Ask your administrator to add an AI deployment."]</div>
}

@if (Model.Questions.Count == 0)
{
    <div class="alert alert-info" role="alert">@T["The published version of this survey has no written questions."]</div>
}
else
{
    <form method="post" asp-action="Summarize" asp-route-id="@Model.Survey.ItemId" class="no-multisubmit">
        <div class="card mb-3">
            <div class="card-header">@T["Question"]</div>
            <div class="card-body">
                <div class="ocat-wrapper">
                    <label class="ocat-label" for="summary-question">@T["Written question"]</label>
                    <div class="ocat-end">
                        <select id="summary-question" name="questionId" class="form-select" asp-items="@(new SelectList(Model.Questions, "Value", "Text", Model.QuestionId))"></select>
                        <span class="hint">@T["The summary reads the latest {0} answers and never names a respondent.", SurveysAIConstants.MaxSummarizedAnswers]</span>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Summary))
        {
            <div class="card mb-3">
                <div class="card-header">@T["Summary of {0} answers", Model.AnswerCount]</div>
                <div class="card-body">
                    <div class="text-break" style="white-space: pre-wrap;">@Model.Summary</div>
                    <span class="hint">@T["Written by AI from the answers. Check it against the answers before you share it."]</span>
                </div>
            </div>
        }

        <div class="action-bar-bottom">
            <button type="submit" class="btn btn-primary" disabled="@(!Model.ModelAvailable)">@T["Summarize"]</button>
            <a class="btn btn-secondary cancel" role="button" asp-action="Index" asp-controller="Surveys" asp-area="CrestApps.OrchardCore.Surveys">@T["Back"]</a>
        </div>
    </form>
}
