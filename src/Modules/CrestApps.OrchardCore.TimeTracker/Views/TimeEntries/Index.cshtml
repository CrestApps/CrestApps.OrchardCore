@model TimeEntriesListViewModel

<zone Name="Title"><breadcrumb name="TimeTrackerEntries" title="@T["Time Entries"]" /></zone>

<style asp-name="bootstrap-select"></style>
<script asp-name="bootstrap-select" depends-on="bootstrap" at="Foot"></script>

<form asp-action="Index" method="get" id="time-entries-filter">
    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2 gy-2 align-items-center">
                <div class="col-12 col-md">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></span>
                        <input asp-for="Q" class="form-control" placeholder="@T["Search by user name"]" aria-label="@T["Search time entries"]" />
                    </div>
                </div>
                @if (Model.CanManage)
                {
                    <div class="col-auto">
                        <a asp-action="Edit" class="btn btn-secondary create">@T["Add time"]</a>
                    </div>
                }
            </div>
        </div>
    </div>
</form>
@{
    Model.List.ToolbarActions = await New.TimeEntriesFilter(ViewModel: Model, FormId: "time-entries-filter");
}

<admin-list name="TimeEntries" context="Model.List" show-select-all="false" empty-message="@T["<strong>Nothing here!</strong> Time shows up here as people clock in. Change the search and filters to see more."]">
    <admin-list-list item-css-class="list-group-item" />
    <admin-list-grid>
        <admin-list-column name="Name" position="20" title="@T["Time"]" />
        <admin-list-column name="Details" position="30" title="@T["Details"]" width="auto" />
        <admin-list-column type="Actions" title="@T["Actions"]" />
    </admin-list-grid>
</admin-list>
