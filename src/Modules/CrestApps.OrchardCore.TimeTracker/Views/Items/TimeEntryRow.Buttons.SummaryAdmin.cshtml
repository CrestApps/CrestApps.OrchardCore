@model ShapeViewModel<TimeEntryRow>

@if (Model.Value.CanManage)
{
    <a asp-controller="TimeEntries" asp-action="Edit" asp-route-id="@Model.Value.Entry.ItemId" class="btn @(Model.Value.KeptBy is null ? "btn-primary" : "btn-secondary") btn-sm">@(Model.Value.KeptBy is null ? T["Edit"] : T["View"])</a>
}
