@using Microsoft.AspNetCore.Mvc.Localization
@using OrchardCore.DisplayManagement
@model ListSourceModelViewModel<TaxCalculationMethodEntry, CatalogEntryViewModel<TaxRule>>

<zone Name="Title">
    <breadcrumb name="TaxRules" title="@T["Tax Rules"]" />
</zone>

@* The post form provides the antiforgery token used by the delete action. *@
<form asp-action="Index" method="post" class="no-multisubmit">
    <input type="submit" name="submit.Filter" id="submitFilter" class="visually-hidden" />

    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <div class="input-group">
                        <input id="search-box" asp-for="Options.Search" class="form-control" placeholder="@T["Search"]" type="search" autofocus autocomplete="off" />
                        <button type="submit" name="submit.Filter" class="btn btn-outline-secondary" title="@T["Search"]" aria-label="@T["Search"]"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
                    </div>
                </div>
                <div class="col-auto">
                    <button type="button" class="btn btn-secondary create" data-bs-toggle="modal" data-bs-target="#modalAddTaxRule">@T["Add Tax Rule"]</button>
                </div>
            </div>
        </div>
    </div>

    @* The tax rules, the toolbar and the pager are rendered by the AdminList shape, in the layout (List or Grid) the site or the user picked. *@
    <admin-list name="TaxRules" context="Model.List"
                show-select-all="false"
                empty-message="@T["<strong>Nothing here!</strong> There are no tax rules at the moment."]">
        <admin-list-list item-css-class="list-group-item" />
        <admin-list-grid>
            <admin-list-column name="Name" position="20" title="@T["Name"]" />
            <admin-list-column name="Details" position="30" title="@T["Details"]" width="auto" />
            <admin-list-column name="Modified" position="40" title="@T["Last modified"]" width="auto" />
            <admin-list-column type="Actions" title="@T["Actions"]" />
        </admin-list-grid>
    </admin-list>
</form>

<!-- Modal -->
<div class="modal fade" id="modalAddTaxRule" tabindex="-1" role="dialog" aria-labelledby="available-calculation-methods-title" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="available-calculation-methods-title">@T["Select a calculation method"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @if (!(Model.Sources?.Any() ?? false))
                {
                    <p class="p-3 mb-2 bg-warning text-white">@T["No calculation methods are available at the moment."]</p>
                }
                else
                {
                    <div class="row row-cols-1 row-cols-md-2 g-2">
                        @foreach (var method in Model.Sources)
                        {
                            <div class="col">
                                <div class="card h-100">
                                    <div class="card-body">
                                        <h4>@method.DisplayName</h4>
                                        <p class="hint">@method.Description</p>
                                    </div>

                                    <div class="card-footer text-muted text-sm-end">
                                        <a class="btn btn-primary btn-sm"
                                           asp-action="Create"
                                           asp-route-source="@method.Name">@T["Add"]</a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@T["Cancel"]</button>
            </div>
        </div>
    </div>
</div>
