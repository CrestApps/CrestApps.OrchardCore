@using CrestApps.OrchardCore.Taxation.Core

@model EditCatalogEntryViewModel

<zone Name="Title">
    <breadcrumb name="TaxationJurisdictionsCreate" title="@(T["Create {0}", Model.DisplayName])">
        <breadcrumb-item id="TaxationJurisdictions" action="Index" controller="TaxJurisdictions" area="CrestApps.OrchardCore.Taxation" permission="@TaxationPermissions.ManageTaxation.Name">@T["Tax Jurisdictions"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form method="post" enctype="multipart/form-data" class="no-multisubmit">
    @Html.ValidationSummary()
    @await DisplayAsync(Model.Editor)

    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <button class="btn btn-primary" type="submit">@T["Save"]</button>
            <a class="btn btn-secondary cancel" role="button" asp-action="Index">@T["Cancel"]</a>
        </div>
    </div>
</form>
