@model TaxReturnsIndexViewModel

<zone Name="Title">
    <breadcrumb name="TaxReturns" title="@T["Tax returns"]" />
</zone>

@if (!Model.HasFilingRegistrations)
{
    <div class="alert alert-info">@T["No tax registration files returns yet: give a registration a filing frequency under Commerce &gt; Taxation &gt; Tax Registrations."]</div>
}

@* The form gives the prepare buttons of the rows their antiforgery token. *@
<form asp-action="Index" method="post" class="no-multisubmit" data-list-management data-client-side-search="true">
    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <div class="input-group">
                        <input id="search-box" class="form-control" placeholder="@T["Search"]" type="search" autofocus autocomplete="off" />
                        <button type="button" class="btn btn-outline-secondary" title="@T["Search"]" aria-label="@T["Search"]"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
                    </div>
                </div>
                <div class="col-auto">
                    <a class="btn btn-secondary" role="button" asp-action="Index" asp-controller="TaxRegistrations">@T["Tax registrations"]</a>
                </div>
            </div>
        </div>
    </div>

    <admin-list name="TaxReturns" context="Model.List"
                show-select-all="false"
                empty-message="@T["<strong>Nothing here!</strong> No registration files a return for a period that ends in {0}.", Model.Year]">
        <admin-list-list item-css-class="list-group-item" />
        <admin-list-grid>
            <admin-list-column name="Name" position="20" title="@T["Return"]" />
            <admin-list-column name="Details" position="30" title="@T["Status"]" width="auto" />
            <admin-list-column type="Actions" title="@T["Actions"]" />
        </admin-list-grid>
    </admin-list>

    <div id="list-alert" class="alert alert-info my-3 d-none text-center" role="alert">@T["Your search returned no results."]</div>
</form>

<script asp-name="list-management-ui" at="Foot"></script>
