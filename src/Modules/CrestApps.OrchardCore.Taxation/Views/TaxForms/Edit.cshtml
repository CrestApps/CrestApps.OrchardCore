@model EditCatalogEntryViewModel

<zone Name="Title">
    <breadcrumb name="TaxFormsEdit" title="@T["Edit {0}", Model.DisplayName]">
        <breadcrumb-item id="TaxForms" action="Index" controller="TaxForms" area="CrestApps.OrchardCore.Taxation" permission="@CrestApps.OrchardCore.Taxation.Core.TaxationPermissions.ManageTaxForms.Name">@T["Tax Forms"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form method="post" class="no-multisubmit">
    @Html.ValidationSummary()
    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <button class="btn btn-primary" type="submit">@T["Save"]</button>
        <a class="btn btn-secondary cancel" role="button" asp-route-action="Index">@T["Cancel"]</a>
    </div>
</form>
