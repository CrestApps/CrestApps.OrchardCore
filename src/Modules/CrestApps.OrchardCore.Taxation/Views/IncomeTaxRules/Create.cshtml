@using CrestApps.OrchardCore.Taxation.Core

@model EditCatalogEntryViewModel

<zone Name="Title">
    <breadcrumb name="IncomeTaxRulesCreate" title="@T["New income tax rule"]">
        <breadcrumb-item id="IncomeTaxRules" action="Index" controller="IncomeTaxRules" area="CrestApps.OrchardCore.Taxation" permission="@TaxationPermissions.ManageIncomeTaxRules.Name">@T["Income tax rules"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form method="post" class="no-multisubmit">
    @Html.ValidationSummary()
    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <button class="btn btn-primary" type="submit">@T["Save"]</button>
        <a class="btn btn-secondary cancel" role="button" asp-route-action="Index">@T["Cancel"]</a>
    </div>
</form>
