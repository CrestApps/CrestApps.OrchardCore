@using CrestApps.OrchardCore.Taxation.Services
@using Microsoft.Extensions.Options
@using OrchardCore.DisplayManagement

@model ListCatalogEntryViewModel<CatalogEntryViewModel<IncomeTaxRule>>

@inject IOptions<IncomeTaxRuleSourceOptions> SourceOptions

@{
    var sources = SourceOptions.Value.Sources.Values.OrderBy(source => source.Position).ThenBy(source => source.Name, StringComparer.Ordinal).ToList();
}

<zone Name="Title">
    <breadcrumb name="IncomeTaxRules" title="@T["Income tax rules"]" />
</zone>

@* The form is necessary to generate an antiforgery token for delete actions. *@
<form asp-action="Index" method="post" class="no-multisubmit" data-list-management data-client-side-search="true">
    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <div class="input-group">
                        <input id="search-box" class="form-control" placeholder="@T["Search"]" type="search" autofocus autocomplete="off" />
                        <button type="button" class="btn btn-outline-secondary" title="@T["Search"]" aria-label="@T["Search"]"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
                    </div>
                </div>
                <div class="col-auto">
                    <button type="button" class="btn btn-secondary create" data-bs-toggle="modal" data-bs-target="#modalAddIncomeTaxRule">@T["Add income tax rule"]</button>
                </div>
            </div>
        </div>
    </div>

    <admin-list name="IncomeTaxRules" context="Model.List"
                show-select-all="false"
                empty-message="@T["<strong>Nothing here!</strong> No income tax rule has been added yet. A country pack (United States, Canada) adds its own with a dated recipe under Tools &gt; Recipes."]">
        <admin-list-list item-css-class="list-group-item" />
        <admin-list-grid>
            <admin-list-column name="Name" position="20" title="@T["Name"]" />
            <admin-list-column name="Details" position="30" title="@T["Details"]" width="auto" />
            <admin-list-column type="Actions" title="@T["Actions"]" />
        </admin-list-grid>
    </admin-list>

    <div id="list-alert" class="alert alert-info my-3 d-none text-center" role="alert">@T["Your search returned no results."]</div>
</form>

<div class="modal fade" id="modalAddIncomeTaxRule" tabindex="-1" aria-labelledby="income-tax-rule-sources-title" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="income-tax-rule-sources-title">@T["Which kind of income tax rule?"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Close"]"></button>
            </div>
            <div class="modal-body">
                @if (sources.Count == 0)
                {
                    <p class="alert alert-warning mb-0">@T["No kind of income tax rule is available."]</p>
                }
                else
                {
                    <div class="row row-cols-1 row-cols-md-2 g-3">
                        @foreach (var source in sources)
                        {
                            IShape shape = await New.IncomeTaxRuleSource_Link(Source: source);
                            shape.Metadata.Alternates.Add("IncomeTaxRuleSource_Link__" + source.Name);

                            @await DisplayAsync(shape)
                        }
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@T["Cancel"]</button>
            </div>
        </div>
    </div>
</div>

<script asp-name="list-management-ui" at="Foot"></script>
