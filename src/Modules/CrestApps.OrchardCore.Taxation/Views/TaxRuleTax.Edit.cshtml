@model TaxRuleViewModel

<div class="ocat-wrapper">
    <label asp-for="TaxType" class="ocat-label ocat-label-required">@T["Tax type"]</label>
    <div class="ocat-end">
        <select asp-for="TaxType" asp-items="Model.TaxTypes" class="form-select"></select>
        <span class="hint">@T["Labels the kind of tax this rule produces, such as sales tax or VAT. It is used to group and report taxes and does not change how the amount is calculated."]</span>
        <span asp-validation-for="TaxType" class="text-danger"></span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="TaxName" class="ocat-label">@T["Display name"]</label>
    <div class="ocat-end">
        <input asp-for="TaxName" class="form-control" />
        <span class="hint">@T["The name shown to customers on invoices and receipts. When left empty the rule name is used."]</span>
        <span asp-validation-for="TaxName" class="text-danger"></span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="TaxCode" class="ocat-label">@T["Tax code"]</label>
    <div class="ocat-end">
        <input asp-for="TaxCode" class="form-control" />
        <span asp-validation-for="TaxCode" class="text-danger"></span>
    </div>
</div>
