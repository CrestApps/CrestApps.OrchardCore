@using CrestApps.OrchardCore.Taxation.Core

@model EditCatalogEntryViewModel

<zone Name="Title">
    <breadcrumb name="TaxRegistrationsCreate" title="@T["New Tax Registration"]">
        <breadcrumb-item id="TaxRegistrations" action="Index" controller="TaxRegistrations" area="CrestApps.OrchardCore.Taxation" permission="@TaxationPermissions.ManageTaxation.Name">@T["Tax Registrations"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form method="post" class="no-multisubmit">
    @Html.ValidationSummary()
    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <button class="btn btn-primary" type="submit">@T["Save"]</button>
        <a class="btn btn-secondary cancel" role="button" asp-action="Index">@T["Cancel"]</a>
    </div>
</form>
