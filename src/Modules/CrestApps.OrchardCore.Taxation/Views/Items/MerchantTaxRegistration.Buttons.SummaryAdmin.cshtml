@model ShapeViewModel<MerchantTaxRegistration>

<a asp-action="Edit" asp-controller="TaxRegistrations" asp-route-id="@Model.Value.ItemId" class="btn btn-primary btn-sm">@T["Edit"]</a>
<a asp-action="Delete" asp-controller="TaxRegistrations" asp-route-id="@Model.Value.ItemId" class="btn btn-danger btn-sm" data-title="@T["Delete"]" data-message="@T["Delete the tax registration? A registration with tax returns is kept; make it inactive instead."]" data-url-af="RemoveUrl UnsafeUrl">@T["Delete"]</a>
