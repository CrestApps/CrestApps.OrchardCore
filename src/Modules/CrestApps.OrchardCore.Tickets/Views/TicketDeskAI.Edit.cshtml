@model TicketDeskAIViewModel

<div class="mb-3">
    <label asp-for="ProfileId" class="form-label">@T["AI assistant"]</label>
    <select asp-for="ProfileId" asp-items="Model.Profiles" class="form-select">
        <option value="">@T["None"]</option>
    </select>
    <span asp-validation-for="ProfileId" class="text-danger"></span>
    <span class="hint">@T["A chat AI profile that suggests replies to agents and triages tickets, with its instructions, knowledge and model. It sends the ticket's conversation, internal notes and the requester's name included, to the profile's AI provider; agents send what it writes."]</span>
</div>
<div class="mb-3 form-check">
    <input type="checkbox" class="form-check-input" asp-for="ApplyPriority" />
    <label class="form-check-label" asp-for="ApplyPriority">@T["A triage sets the priority it suggests"]</label>
    <span class="hint dashed">@T["It may lower the priority, or raise it at most one step above the ticket type's default; anything higher it only notes, for an agent to decide, so a requester's own words can't make their ticket the most urgent. Otherwise the triage only notes the priority."]</span>
</div>
