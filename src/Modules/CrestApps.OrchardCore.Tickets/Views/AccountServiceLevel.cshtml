@model AccountServiceLevelViewModel

<div class="card mb-3">
    <div class="card-body">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
            <h2 class="h6 mb-0 me-auto"><i class="fa-solid fa-stopwatch me-1" aria-hidden="true"></i>@T["Service level"]</h2>
            @if (Model.CanChange)
            {
                <a class="btn btn-sm btn-secondary" asp-area="OrchardCore.Contents" asp-controller="Admin" asp-action="Edit" asp-route-contentItemId="@Model.AccountId" asp-route-returnUrl="@(Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString)">@T["Change"]</a>
            }
        </div>

        <ul class="list-unstyled mb-2">
            @foreach (var agreement in Model.Agreements)
            {
                <li class="d-flex flex-wrap gap-2 align-items-baseline mb-1">
                    <span class="badge ta-badge fw-normal" title="@T["Agreement"]"><i class="fa-solid fa-file-signature me-1" aria-hidden="true"></i>@agreement.Number @agreement.Name</span>
                    <span>@PolicyLink(agreement.PolicyId, agreement.PolicyName)</span>
                    <span class="small text-muted">@T["for the tickets this agreement covers"]</span>
                </li>
            }
            <li class="d-flex flex-wrap gap-2 align-items-baseline">
                <span class="badge ta-badge fw-normal" title="@T["Account"]"><i class="fa-solid fa-building me-1" aria-hidden="true"></i>@T["The account"]</span>
                @if (string.IsNullOrEmpty(Model.AccountPolicyName))
                {
                    <span class="text-muted">@T["No policy of its own"]</span>
                }
                else
                {
                    <span>@PolicyLink(Model.AccountPolicyId, Model.AccountPolicyName)</span>
                }
                @if (Model.Agreements.Count > 0)
                {
                    <span class="small text-muted">@T["for its other tickets"]</span>
                }
            </li>
        </ul>

        <span class="hint">@T["A ticket gets the policy of the account's agreement that covers it, then the account's own, then its category's, ticket type's or desk's."]</span>
    </div>
</div>

@functions {
    private Microsoft.AspNetCore.Html.IHtmlContent PolicyLink(string id, string name)
    {
        if (!Model.CanOpenPolicies)
        {
            return new Microsoft.AspNetCore.Html.HtmlString(System.Net.WebUtility.HtmlEncode(name));
        }

        var url = Url.RouteUrl("ServiceLevelPoliciesEdit", new { area = "CrestApps.OrchardCore.ServiceLevels", id });

        return new Microsoft.AspNetCore.Html.HtmlString($"<a href=\"{System.Net.WebUtility.HtmlEncode(url)}\">{System.Net.WebUtility.HtmlEncode(name)}</a>");
    }
}
