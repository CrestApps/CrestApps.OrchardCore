@* The rating buttons and comment, for the request page and the rating page. *@
@model (int? Score, string Comment)

<div class="btn-group mb-3" role="radiogroup" aria-label="@T["Your rating"]">
    @for (var score = CrestApps.OrchardCore.Tickets.Models.TicketSatisfaction.MinScore; score <= CrestApps.OrchardCore.Tickets.Models.TicketSatisfaction.MaxScore; score++)
    {
        var id = "rating-" + score;
        <input type="radio" class="btn-check" name="score" id="@id" value="@score" required checked="@(Model.Score == score)" />
        <label class="btn btn-outline-primary" for="@id">@score</label>
    }
</div>
<div class="small text-body-secondary mb-3">@T["1 is poor, 5 is excellent."]</div>
<div class="mb-3">
    <label for="rating-comment" class="form-label">@T["Anything to add? (optional)"]</label>
    <textarea id="rating-comment" name="comment" class="form-control" rows="3" maxlength="2000">@Model.Comment</textarea>
</div>
