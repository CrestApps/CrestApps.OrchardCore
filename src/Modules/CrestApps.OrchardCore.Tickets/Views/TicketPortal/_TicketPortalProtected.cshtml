@using CrestApps.OrchardCore.Tickets.Portal
@model TicketPortalDisplayViewModel

@{
    var shown = Model.ProtectedValues?.ToDictionary(value => value.ItemId, value => value.Value, StringComparer.Ordinal);
}

@if (Model.ProtectedItems.Count > 0)
{
    <div class="card mb-4" id="request-protected">
        <div class="card-header d-flex align-items-center gap-2">
            <i class="fa-solid fa-lock" aria-hidden="true"></i>
            <span class="me-auto">@T["What you shared under protection"]</span>
            @if (shown is not null)
            {
                <form method="post" asp-route="TicketPortalHideProtected" asp-route-number="@Model.Number">
                    <button type="submit" class="btn btn-sm btn-outline-secondary">@T["Hide"]</button>
                </form>
            }
        </div>
        <div class="card-body">
            <p class="small text-body-secondary">@T["It's kept encrypted, and only the agents allowed to see it can show it, after confirming their password."]</p>
            <ul class="list-unstyled mb-0">
                @foreach (var item in Model.ProtectedItems)
                {
                    <li class="d-flex align-items-start gap-2 mb-2">
                        <div class="flex-grow-1">
                            <div class="fw-semibold text-break">@item.Label</div>
                            @if (shown is not null && shown.TryGetValue(item.ItemId, out var value))
                            {
                                <code class="d-block text-break user-select-all">@value</code>
                            }
                            else
                            {
                                <span class="text-body-secondary" aria-label="@T["Hidden"]">••••••••</span>
                            }
                        </div>
                        @if (Model.CanRemoveProtected)
                        {
                            <form method="post" asp-route="@(Model.IsGuest ? "TicketPortalGuestRemoveProtected" : "TicketPortalRemoveProtected")" asp-route-number="@Model.Number" asp-route-id="@Model.TicketId">
                                <input type="hidden" name="itemId" value="@item.ItemId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">@T["Remove"]</button>
                            </form>
                        }
                    </li>
                }
            </ul>
            @if (Model.CanShowProtected && shown is null)
            {
                <form method="post" asp-route="TicketPortalShowProtected" asp-route-number="@Model.Number" class="mt-3">
                    <label for="request-protected-password" class="form-label">@T["Your password, to show it"]</label>
                    <div class="input-group">
                        <input id="request-protected-password" name="password" type="password" class="form-control" autocomplete="new-password" data-1p-ignore data-lpignore="true" data-bwignore="true" required />
                        <button type="submit" class="btn btn-secondary">@T["Show"]</button>
                    </div>
                </form>
            }
        </div>
    </div>
}
