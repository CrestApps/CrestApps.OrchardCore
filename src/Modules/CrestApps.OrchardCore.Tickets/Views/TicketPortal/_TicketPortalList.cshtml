@using CrestApps.OrchardCore.Tickets.Portal
@model TicketPortalListViewModel

@{
    var pages = (int)Math.Ceiling(Model.Total / (double)Math.Max(1, Model.PageSize));
}

@if (!string.IsNullOrEmpty(Model.AccountName))
{
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <a class="nav-link@(Model.Organization ? null : " active")" href="@Url.RouteUrl("TicketPortal")" aria-current="@(Model.Organization ? null : "page")">@T["My requests"]</a>
        </li>
        <li class="nav-item">
            <a class="nav-link@(Model.Organization ? " active" : null)" href="@Url.RouteUrl("TicketPortal", new { organization = true })" aria-current="@(Model.Organization ? "page" : null)">@T["{0}'s requests", Model.AccountName]</a>
        </li>
    </ul>
}

@if (Model.Items.Count == 0)
{
    <p class="text-body-secondary">@(Model.Organization ? T["Your organization has no requests yet."] : T["You have no requests yet."])</p>
}
else
{
    <div class="list-group">
        @foreach (var item in Model.Items)
        {
            <a class="list-group-item list-group-item-action d-flex flex-wrap justify-content-between align-items-center gap-2" href="@Url.RouteUrl(TicketPortalController.DisplayRouteName, new { number = item.Number })">
                <span>
                    <span class="text-body-secondary me-2">@item.Number</span>
                    <span class="fw-semibold">@item.Subject</span>
                    @if (Model.Organization && !string.IsNullOrEmpty(item.RequesterName))
                    {
                        <span class="text-body-secondary small ms-2">@item.RequesterName</span>
                    }
                </span>
                <span class="d-flex align-items-center gap-2">
                    <span class="small text-body-secondary">@item.Created</span>
                    @if (!string.IsNullOrEmpty(item.Status))
                    {
                        <span class="badge @(item.IsOpen ? "text-bg-primary" : "text-bg-secondary")">@item.Status</span>
                    }
                </span>
            </a>
        }
    </div>

    @if (pages > 1)
    {
        <nav class="mt-3" aria-label="@T["Pages"]">
            <ul class="pagination">
                <li class="page-item@(Model.Page <= 1 ? " disabled" : null)">
                    <a class="page-link" href="@Url.RouteUrl("TicketPortal", new { organization = Model.Organization, page = Model.Page - 1 })">@T["Newer"]</a>
                </li>
                <li class="page-item@(Model.Page >= pages ? " disabled" : null)">
                    <a class="page-link" href="@Url.RouteUrl("TicketPortal", new { organization = Model.Organization, page = Model.Page + 1 })">@T["Older"]</a>
                </li>
            </ul>
        </nav>
    }
}
