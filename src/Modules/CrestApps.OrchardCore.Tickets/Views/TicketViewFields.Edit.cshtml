@model TicketViewViewModel

<style asp-name="bootstrap-select"></style>
<script asp-name="bootstrap-select" depends-on="bootstrap" at="Foot"></script>

<div class="ocat-wrapper">
    <label asp-for="Name" class="ocat-label ocat-label-required">@T["Name"]</label>
    <div class="ocat-end">
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
</div>

<div class="ocat-wrapper">
    <label class="ocat-label">@T["Shared with"]</label>
    <div class="ocat-end">
        @await Component.InvokeAsync("TeamPicker", new { name = Html.NameFor(m => m.SharedWithTeamId).ToString(), selectedValues = string.IsNullOrEmpty(Model.SharedWithTeamId) ? Array.Empty<string>() : new[] { Model.SharedWithTeamId } })
        <span class="hint">@T["Leave empty to share the view with everybody."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="Order" class="ocat-label">@T["Position"]</label>
    <div class="ocat-end">
        <input asp-for="Order" class="form-control" type="number" />
        <span class="hint">@T["Where the view is listed; lower comes first."]</span>
    </div>
</div>
