@model ShapeViewModel<TicketRow>

@{
    var row = Model.Value;
}
@if (row.Part.NextDueUtc is { } due)
{
    @if (due <= row.NowUtc)
    {
        <span class="badge text-bg-danger fw-normal" title="@T["Next service-level target"]"><i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i>@T["Past its target"]</span>
    }
    else
    {
        <span class="badge ta-badge fw-normal" title="@T["Next service-level target"]"><i class="fa-regular fa-clock me-1" aria-hidden="true"></i>@T["Due"] @await DisplayAsync(await New.DateTime(Utc: due, Format: "g"))</span>
    }
}
<span class="badge ta-badge fw-normal" title="@T["Last change"]"><i class="fa-solid fa-pen me-1" aria-hidden="true"></i>@await DisplayAsync(await New.TimeSpan(Utc: row.Ticket.ModifiedUtc ?? row.Ticket.CreatedUtc))</span>
