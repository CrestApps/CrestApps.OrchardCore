@model ShapeViewModel<TicketView>

<a asp-action="Clone"
   asp-route-id="@Model.Value.ItemId"
   class="dropdown-item"
   data-url-af="RemoveUrl UnsafeUrl"
   data-title="@T["Copy"]"
   data-message="@T["Create a copy of this ticket view?"]"
   data-ok-text="@T["Yes"]"
   data-cancel-text="@T["Cancel"]">@T["Copy"]</a>
