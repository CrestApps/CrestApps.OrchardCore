@model TicketBoardViewModel

@{
    var columnsName = Html.NameFor(m => m.Columns).ToString();
    var columnsId = Html.IdFor(m => m.Columns).ToString();
    var teamFieldId = Html.IdFor(m => m.SharedWithTeamId).ToString();
}

<style asp-name="bootstrap-select"></style>
<script asp-name="bootstrap-select" depends-on="bootstrap" at="Foot"></script>
<style asp-name="@CrestApps.OrchardCore.Tickets.Services.TicketsResourceConfiguration.BoardStyle"></style>
<script asp-name="@CrestApps.OrchardCore.Tickets.Services.TicketsResourceConfiguration.BoardEditorScript" at="Foot"></script>

<div class="ocat-wrapper">
    <label asp-for="Name" class="ocat-label ocat-label-required">@T["Name"]</label>
    <div class="ocat-end">
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="Description" class="ocat-label">@T["Description"]</label>
    <div class="ocat-end">
        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
        <span class="hint">@T["What the board is for, shown in the list of boards."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="Order" class="ocat-label">@T["Position"]</label>
    <div class="ocat-end">
        <input asp-for="Order" class="form-control" type="number" />
        <span class="hint">@T["Where the board is listed; lower comes first."]</span>
    </div>
</div>
