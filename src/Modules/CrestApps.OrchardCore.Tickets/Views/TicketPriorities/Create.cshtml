@using CrestApps.OrchardCore.Core.Models

@model EditCatalogEntryViewModel

<zone Name="Title">
    <breadcrumb name="TicketPrioritiesCreate" title="@T["New Ticket priority"]">
        <breadcrumb-item id="TicketPriorities" action="Index" controller="TicketPriorities" area="CrestApps.OrchardCore.Tickets" permission="@TicketsPermissions.ManageTicketSettings.Name">@T["Ticket priorities"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form method="post" asp-route-cloneId="@ViewContext.HttpContext.Request.Query["cloneId"]" class="no-multisubmit">
    @Html.ValidationSummary()
    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <button class="btn btn-primary" type="submit">@T["Save"]</button>
        <a class="btn btn-secondary cancel" role="button" asp-route-action="Index">@T["Cancel"]</a>
    </div>
</form>
