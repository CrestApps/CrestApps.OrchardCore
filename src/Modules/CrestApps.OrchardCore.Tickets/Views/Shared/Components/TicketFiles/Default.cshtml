@model CrestApps.OrchardCore.Tickets.ViewModels.TicketFilesViewModel

@{
    static string IconOf(string contentType, bool isImage)
    {
        var type = contentType ?? string.Empty;

        return true switch
        {
            _ when isImage || type.StartsWith("image/", StringComparison.OrdinalIgnoreCase) => "fa-regular fa-file-image",
            _ when type.Contains("pdf", StringComparison.OrdinalIgnoreCase) => "fa-regular fa-file-pdf",
            _ when type.Contains("word", StringComparison.OrdinalIgnoreCase) => "fa-regular fa-file-word",
            _ when type.Contains("sheet", StringComparison.OrdinalIgnoreCase) || type.Contains("excel", StringComparison.OrdinalIgnoreCase) || type.Contains("csv", StringComparison.OrdinalIgnoreCase) => "fa-regular fa-file-excel",
            _ when type.Contains("presentation", StringComparison.OrdinalIgnoreCase) || type.Contains("powerpoint", StringComparison.OrdinalIgnoreCase) => "fa-regular fa-file-powerpoint",
            _ when type.Contains("zip", StringComparison.OrdinalIgnoreCase) || type.Contains("compressed", StringComparison.OrdinalIgnoreCase) => "fa-regular fa-file-zipper",
            _ when type.StartsWith("audio/", StringComparison.OrdinalIgnoreCase) => "fa-regular fa-file-audio",
            _ when type.StartsWith("video/", StringComparison.OrdinalIgnoreCase) => "fa-regular fa-file-video",
            _ when type.StartsWith("text/", StringComparison.OrdinalIgnoreCase) => "fa-regular fa-file-lines",
            _ => "fa-regular fa-file",
        };
    }
}

@if (Model.ForRequester && Model.Files.Count == 0)
{
    return;
}

<div class="card mb-3" id="ticket-files">
    <div class="card-header d-flex align-items-center gap-2">
        <span class="fw-semibold">@T["Files"]</span>
        <span class="badge rounded-pill text-bg-secondary fw-normal">@Model.Total</span>
    </div>
    @if (Model.Files.Count == 0)
    {
        <div class="card-body text-body-secondary small">@T["No files yet. Files added to replies and notes show here."]</div>
    }
    else
    {
        <ul class="list-group list-group-flush">
            @foreach (var file in Model.Files)
            {
                var size = file.Length < 1024 * 1024
                    ? T.GetString("{0} KB", Math.Max(1, file.Length / 1024)).Value
                    : T.GetString("{0:0.#} MB", file.Length / 1048576d).Value;

                <li class="list-group-item d-flex gap-3 align-items-start">
                    @if (file.IsImage)
                    {
                        <a href="@file.PreviewUrl" target="_blank" rel="noopener" class="flex-shrink-0" title="@T["Open {0}", file.FileName]">
                            <img src="@file.PreviewUrl" alt="@file.FileName" loading="lazy" width="56" height="56" class="rounded border" style="object-fit: cover;" />
                        </a>
                    }
                    else
                    {
                        <span class="flex-shrink-0 d-inline-flex align-items-center justify-content-center rounded border text-body-secondary" style="width: 56px; height: 56px;" aria-hidden="true">
                            <i class="@IconOf(file.ContentType, file.IsImage) fa-xl"></i>
                        </span>
                    }
                    <div class="flex-grow-1" style="min-width: 0;">
                        <a href="@file.DownloadUrl" class="fw-semibold text-break" title="@T["Download {0}", file.FileName]"><i class="fa-solid fa-download fa-xs me-1" aria-hidden="true"></i>@file.FileName</a>
                        <div class="small text-body-secondary d-flex flex-wrap column-gap-2">
                            <span>@size</span>
                            <span>@(string.IsNullOrEmpty(file.AddedBy) ? T["Added by the site"] : T["Added by {0}", file.AddedBy])</span>
                            <span>@await DisplayAsync(await New.DateTime(Utc: DateTime.SpecifyKind(file.AddedUtc, DateTimeKind.Utc), Format: "g"))</span>
                        </div>
                        <div class="small d-flex flex-wrap align-items-center column-gap-2 mt-1">
                            <a href="@file.EntryUrl">@(file.Internal ? T["In an internal note"] : T["In a message"])</a>
                            @if (file.Internal)
                            {
                                <span class="badge ta-badge fw-normal" title="@T["Seen only by the people who work on the ticket"]"><i class="fa-solid fa-lock me-1" aria-hidden="true"></i>@T["Internal"]</span>
                            }
                            @if (!string.IsNullOrEmpty(file.FromNumber))
                            {
                                <span class="text-body-secondary">@T["From merged ticket {0}", file.FromNumber]</span>
                            }
                        </div>
                    </div>
                </li>
            }
        </ul>
        @if (!string.IsNullOrEmpty(Model.ShowAllUrl))
        {
            <div class="card-footer small">
                <a href="@Model.ShowAllUrl">@T["Show all {0} files", Model.Total]</a>
            </div>
        }
    }
</div>
