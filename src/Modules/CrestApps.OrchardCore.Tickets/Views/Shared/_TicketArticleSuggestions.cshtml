@*
    Help articles that match what is being written, from the Knowledge Base's suggestion endpoint when that feature is on
    (its route exists only then; without it nothing renders). Model: (string Source, string Target, bool Insert):
    the id of the field to read, the id of the field a chosen article's link is added to, and whether to offer that.
*@
@model (string Source, string Target, bool Insert)

@{
    var suggestUrl = Url.RouteUrl("KnowledgeBaseSuggest");
    var id = "ticket-articles-" + Model.Source;
}

@if (!string.IsNullOrEmpty(suggestUrl))
{
    <div id="@id" class="small mb-3" hidden aria-live="polite">
        <div class="text-body-secondary mb-1">@T["Help articles that may answer it:"]</div>
        <ul class="list-unstyled mb-0" data-list></ul>
    </div>

    <script at="Foot">
        (() => {
            const box = document.getElementById('@id');
            const source = document.getElementById('@Model.Source');
            const target = document.getElementById('@Model.Target');
            const list = box && box.querySelector('[data-list]');
            const insert = @(Model.Insert ? "true" : "false");
            const insertLabel = '@T["Add the link"]';
            let timer = null;
            let last = '';
            if (!box || !source || !list) {
                return;
            }
            const show = articles => {
                list.replaceChildren();
                for (const article of articles) {
                    const item = document.createElement('li');
                    const link = document.createElement('a');
                    link.href = article.url;
                    link.target = '_blank';
                    link.rel = 'noopener';
                    link.textContent = article.title;
                    item.append(link);
                    if (insert && target) {
                        const add = document.createElement('button');
                        add.type = 'button';
                        add.className = 'btn btn-link btn-sm py-0';
                        add.textContent = insertLabel;
                        add.addEventListener('click', () => {
                            const line = article.title + ': ' + new URL(article.url, window.location.origin).href;
                            target.value = target.value ? target.value + '\n\n' + line : line;
                            target.focus();
                        });
                        item.append(' ', add);
                    }
                    list.append(item);
                }
                box.hidden = articles.length === 0;
            };
            source.addEventListener('input', () => {
                clearTimeout(timer);
                timer = setTimeout(async () => {
                    const text = source.value.trim().split(/\s+/).slice(-8).join(' ');
                    if (text.length < 3 || text === last) {
                        return;
                    }
                    last = text;
                    try {
                        const response = await fetch('@suggestUrl?q=' + encodeURIComponent(text), { headers: { Accept: 'application/json' } });
                        show(response.ok ? await response.json() : []);
                    } catch {
                        show([]);
                    }
                }, 400);
            });
        })();
    </script>
}
