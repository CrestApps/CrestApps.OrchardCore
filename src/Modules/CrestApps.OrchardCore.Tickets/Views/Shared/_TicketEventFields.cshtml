@using CrestApps.OrchardCore.Tickets.Models
@using CrestApps.OrchardCore.Tickets.Workflows
@model TicketEventViewModel

<style asp-name="bootstrap-select"></style>
<script asp-name="bootstrap-select" depends-on="bootstrap" at="Foot"></script>

<div class="mb-3">
    <label asp-for="DeskIds" class="form-label">@T["Desks"]</label>
    <select asp-for="DeskIds" asp-items="Model.DeskOptions" class="selectpicker show-tick" multiple data-width="100%" title="@T["Every desk"]"></select>
    <span class="hint">@T["Leave none selected to start for every desk."]</span>
</div>

@if (Model.TicketTypeOptions.Count > 1)
{
    <div class="mb-3">
        <label asp-for="TicketTypes" class="form-label">@T["Ticket types"]</label>
        <select asp-for="TicketTypes" asp-items="Model.TicketTypeOptions" class="selectpicker show-tick" multiple data-width="100%" title="@T["Every ticket type"]"></select>
        <span class="hint">@T["Leave none selected to start for every ticket type."]</span>
    </div>
}

@if (Model.CategoryOptions.Count > 0)
{
    <div class="mb-3">
        <label asp-for="CategoryIds" class="form-label">@T["Ticket categories"]</label>
        <select asp-for="CategoryIds" asp-items="Model.CategoryOptions" class="selectpicker show-tick" multiple data-width="100%" data-live-search="true" title="@T["Any category"]"></select>
        <span class="hint">@T["A category takes the categories below it along. Leave none selected to start for any ticket, with a category or without."]</span>
    </div>
}

@if (Model.ShowActionName)
{
    <div class="mb-3">
        <label asp-for="ActionName" class="form-label ocat-label-required">@T["Action name"]</label>
        <input asp-for="ActionName" class="form-control" />
        <span asp-validation-for="ActionName" class="text-danger"></span>
        <span class="hint">@T["Shown under Actions on the ticket page, such as Escalate to tier 2."]</span>
    </div>
}

@if (Model.ShowChangedFields)
{
    <div class="mb-3">
        <label asp-for="ChangedFields" class="form-label">@T["Only when these change"]</label>
        <select asp-for="ChangedFields" class="selectpicker show-tick" multiple data-width="100%" title="@T["Any change"]">
            @foreach (var (key, label) in new[]
            {
                (TicketChangeKeys.Status, T["Status"]),
                (TicketChangeKeys.Priority, T["Priority"]),
                (TicketChangeKeys.Desk, T["Desk"]),
                (TicketChangeKeys.Team, T["Team"]),
                (TicketChangeKeys.Assignee, T["Assignee"]),
                (TicketChangeKeys.Subject, T["Subject"]),
                (TicketChangeKeys.Category, T["Category"]),
                (TicketChangeKeys.EscalationLevel, T["Escalation level"]),
                (TicketChangeKeys.Link, T["Links"]),
            })
            {
                <option value="@key" selected="@Model.ChangedFields.Contains(key)">@label</option>
            }
        </select>
        <span class="hint">@T["Leave none selected to start for any change."]</span>
    </div>
}

@if (Model.ShowTimeElapsed)
{
    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Hours" class="form-label">@T["Hours"]</label>
            <input asp-for="Hours" class="form-control" inputmode="decimal" />
            <span asp-validation-for="Hours" class="text-danger"></span>
        </div>
        <div class="col-md-8 mb-3">
            <label asp-for="Since" class="form-label">@T["Since"]</label>
            <select asp-for="Since" class="form-select">
                <option value="@TicketTimeElapsedSince.Created">@T["The ticket was created"]</option>
                <option value="@TicketTimeElapsedSince.LastCustomerReply">@T["The requester's last reply"]</option>
                <option value="@TicketTimeElapsedSince.LastAgentReply">@T["The last agent reply"]</option>
                <option value="@TicketTimeElapsedSince.StatusChanged">@T["The last status change"]</option>
            </select>
        </div>
    </div>
    <div class="mb-3">
        <div class="form-check">
            <input asp-for="BusinessHours" class="form-check-input" type="checkbox" />
            <label asp-for="BusinessHours" class="form-check-label">@T["Count the desk's business hours only"]</label>
            <span class="hint dashed">@T["Off counts every hour of the clock."]</span>
        </div>
    </div>
}

@if (Model.ShowCategories)
{
    <div class="mb-3">
        <label asp-for="Categories" class="form-label">@T["Status categories"]</label>
        <select asp-for="Categories" class="selectpicker show-tick" multiple data-width="100%" title="@T["Any status category"]">
            @foreach (var category in Enum.GetNames<TicketStatusCategory>())
            {
                <option value="@category" selected="@Model.Categories.Contains(category)">@T[category]</option>
            }
        </select>
        <span class="hint">@(Model.ShowTimeElapsed ? T["Tickets in these categories; none selected for the ones still being worked on."] : T["Moves into these categories; none selected for any move."])</span>
    </div>
}
