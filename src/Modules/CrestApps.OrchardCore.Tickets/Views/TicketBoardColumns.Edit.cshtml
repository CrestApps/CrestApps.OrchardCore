@model TicketBoardViewModel

@{
    var columnsName = Html.NameFor(m => m.Columns).ToString();
    var columnsId = Html.IdFor(m => m.Columns).ToString();
    var teamFieldId = Html.IdFor(m => m.SharedWithTeamId).ToString();
}

<style asp-name="bootstrap-select"></style>
<script asp-name="bootstrap-select" depends-on="bootstrap" at="Foot"></script>
<style asp-name="@CrestApps.OrchardCore.Tickets.Services.TicketsResourceConfiguration.BoardStyle"></style>
<script asp-name="@CrestApps.OrchardCore.Tickets.Services.TicketsResourceConfiguration.BoardEditorScript" at="Foot"></script>

<div data-board-columns-section>
    <p class="hint mt-0">@T["Columns run from left to right. Give each column one or more statuses; a status can be in one column only. When a column has several statuses, a card dropped on it gets the status chosen below, or the agent is asked which one. Tickets in a status that is in no column don't show on the board."]</p>
    <span asp-validation-for="Columns" class="text-danger"></span>

    <ol class="list-unstyled mb-2 ticket-board-editor" data-board-editor-columns data-columns-name="@columnsName" data-columns-id="@columnsId" aria-label="@T["Columns"]">
        @for (var i = 0; i < Model.Columns.Count; i++)
        {
            await Column(i.ToString(System.Globalization.CultureInfo.InvariantCulture), Model.Columns[i]);
        }
    </ol>

    <button type="button" class="btn btn-sm btn-secondary" data-board-add-column><i class="fa-solid fa-plus me-1" aria-hidden="true"></i>@T["Add Column"]</button>

    <template data-board-column-template>
        @{ await Column("__index__", new TicketBoardColumnViewModel()); }
    </template>
</div>

@{
    async Task Column(string index, TicketBoardColumnViewModel column)
    {
        var name = $"{columnsName}[{index}]";
        var id = $"{columnsId}_{index}";

        <li class="card mb-2 ticket-board-editor-column" data-board-column>
            <div class="card-header d-flex justify-content-between align-items-center py-1">
                <span class="btn btn-sm btn-link text-muted ticket-board-editor-handle" data-board-handle title="@T["Drag to move the column"]" aria-hidden="true"><i class="fa-solid fa-grip-vertical"></i></span>
                <div class="btn-group btn-group-sm" role="group" aria-label="@T["Column actions"]">
                    <button type="button" class="btn btn-outline-secondary" data-board-move="-1" title="@T["Move up, one column to the left"]" aria-label="@T["Move up, one column to the left"]"><i class="fa-solid fa-arrow-up" aria-hidden="true"></i></button>
                    <button type="button" class="btn btn-outline-secondary" data-board-move="1" title="@T["Move down, one column to the right"]" aria-label="@T["Move down, one column to the right"]"><i class="fa-solid fa-arrow-down" aria-hidden="true"></i></button>
                    <button type="button" class="btn btn-outline-danger" data-board-remove title="@T["Remove the Column"]" aria-label="@T["Remove the Column"]"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
                </div>
            </div>
            <div class="card-body">
                <input type="hidden" name="@(name).Id" value="@column.Id" />

                <div class="ocat-wrapper">
                    <label class="ocat-label" for="@(id)_Name">@T["Name"]</label>
                    <div class="ocat-end">
                        <input class="form-control" id="@(id)_Name" name="@(name).Name" value="@column.Name" data-board-column-name />
                    </div>
                </div>

                <div class="ocat-wrapper">
                    <label class="ocat-label" for="@(id)_Limit">@T["Limit"]</label>
                    <div class="ocat-end">
                        <input class="form-control" type="number" min="1" id="@(id)_Limit" name="@(name).Limit" value="@column.Limit" />
                        <span class="hint">@T["The most tickets the column should hold; the header shows when it holds more. Moves are never refused."]</span>
                    </div>
                </div>

                <div class="ocat-wrapper" role="group" aria-labelledby="@(id)_StatusesLabel">
                    <span class="ocat-label" id="@(id)_StatusesLabel">@T["Statuses"]</span>
                    <div class="ocat-end">
                        @foreach (var status in Model.Statuses)
                        {
                            <div class="form-check form-check-inline" data-board-status-option>
                                <input class="form-check-input" type="checkbox" id="@(id)_Status_@status.ItemId" name="@(name).StatusIds" value="@status.ItemId" checked="@column.StatusIds.Contains(status.ItemId)" data-board-status data-status-name="@status.Name" />
                                <label class="form-check-label" for="@(id)_Status_@status.ItemId">
                                    @if (!string.IsNullOrEmpty(status.Color))
                                    {
                                        <i class="fa-solid fa-circle me-1" style="color: @status.Color" aria-hidden="true"></i>
                                    }
                                    @status.Name
                                </label>
                            </div>
                        }
                    </div>
                </div>

                <div class="ocat-wrapper" data-board-default-row>
                    <label class="ocat-label" for="@(id)_DefaultStatusId">@T["A card dropped here gets"]</label>
                    <div class="ocat-end">
                        <select class="form-select" id="@(id)_DefaultStatusId" name="@(name).DefaultStatusId" data-board-default>
                            <option value="">@T["Ask which status"]</option>
                            @foreach (var status in Model.Statuses)
                            {
                                <option value="@status.ItemId" selected="@(column.DefaultStatusId == status.ItemId)">@status.Name</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </li>
    }
}
