@model TicketDeskViewModel

<div class="card text-bg-theme mb-3">
    <div class="card-header">@T["Desk"]</div>
    <div class="card-body">
        <div class="ocat-wrapper">
            <label asp-for="Name" class="ocat-label ocat-label-required">@T["Name"]</label>
            <div class="ocat-end">
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>

        <div class="ocat-wrapper">
            <label asp-for="Description" class="ocat-label">@T["Description"]</label>
            <div class="ocat-end">
                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
            </div>
        </div>

        <div class="ocat-wrapper">
            <label asp-for="Audience" class="ocat-label">@T["Serves"]</label>
            <div class="ocat-end">
                <select asp-for="Audience" class="form-select">
                    <option value="@TicketDeskAudience.Customers">@T["Customers"]</option>
                    <option value="@TicketDeskAudience.Internal">@T["People inside the organization"]</option>
                </select>
            </div>
        </div>

        <div class="ocat-wrapper">
            <label asp-for="TicketTypes" class="ocat-label">@T["Ticket types"]</label>
            <div class="ocat-end">
                <select asp-for="TicketTypes" asp-items="Model.TicketTypeOptions" class="form-select" multiple size="4"></select>
                <span class="hint">@T["Leave none selected to offer every ticket type."]</span>
            </div>
        </div>
    </div>
</div>

<div class="card text-bg-theme mb-3">
    <div class="card-header">@T["Routing"]</div>
    <div class="card-body">
        <div class="ocat-wrapper">
            <label class="ocat-label">@T["Default team"]</label>
            <div class="ocat-end">
                @await Component.InvokeAsync("TeamPicker", new { name = Html.NameFor(m => m.DefaultTeamId).ToString(), selectedValues = string.IsNullOrEmpty(Model.DefaultTeamId) ? Array.Empty<string>() : new[] { Model.DefaultTeamId } })
                <span class="hint">@T["New tickets go to this team when their type names none, and are assigned to its members."]</span>
            </div>
        </div>

        <div class="ocat-wrapper">
            <label asp-for="AssignmentStrategy" class="ocat-label">@T["New tickets go to"]</label>
            <div class="ocat-end">
                <select asp-for="AssignmentStrategy" class="form-select">
                    <option value="">@T["Nobody: an agent takes them"]</option>
                    <option value="LeastLoaded">@T["The team member with the fewest open tickets"]</option>
                    <option value="RoundRobin">@T["Each team member in turn"]</option>
                </select>
                <span class="hint">@T["Only members who can take work now, as the checks below say, and who hold the skills the ticket type asks for are chosen. When no one can, the ticket stays unassigned and says why."]</span>
            </div>
        </div>

        @if (Model.AvailabilitySourceOptions.Count > 0)
        {
            <div class="ocat-wrapper">
                <span class="ocat-label">@T["A team member can take tickets now when"]</span>
                <div class="ocat-end">
                    @for (var i = 0; i < Model.AvailabilitySourceOptions.Count; i++)
                    {
                        var option = Model.AvailabilitySourceOptions[i];
                        var id = Html.IdFor(m => m.AvailabilitySources) + "_" + i;
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="@id" name="@Html.NameFor(m => m.AvailabilitySources)" value="@option.Value" checked="@option.Selected" />
                            <label class="form-check-label" for="@id">@option.Text</label>
                        </div>
                    }
                    <span class="hint">@T["Leave a check off when the people of this desk don't use it, such as the Contact Center phone for people who only work tickets."]</span>
                </div>
            </div>
        }
    </div>
</div>

<div class="card text-bg-theme mb-3">
    <div class="card-header">@T["Business hours and service level"]</div>
    <div class="card-body">
        <div class="ocat-wrapper">
            <label class="ocat-label">@T["Business hours"]</label>
            <div class="ocat-end">
                @await Component.InvokeAsync("HoursSchedulePicker", new { name = Html.NameFor(m => m.HoursScheduleId).ToString(), selectedValue = Model.HoursScheduleId, emptyText = T["Around the clock"].Value })
            </div>
        </div>

        <div class="ocat-wrapper">
            <label asp-for="ServiceLevelPolicyId" class="ocat-label">@T["Service-level policy"]</label>
            <div class="ocat-end">
                <select asp-for="ServiceLevelPolicyId" asp-items="Model.Policies" class="form-select">
                    <option value="">@T["None"]</option>
                </select>
                <span class="hint">@T["Used when the ticket's type names no policy. Policies are written under Content › Service Levels, for tickets."]</span>
            </div>
        </div>
    </div>
</div>

<div class="card text-bg-theme mb-3">
    <div class="card-header">@T["Solved tickets"]</div>
    <div class="card-body">
        <div class="ocat-wrapper">
            <label asp-for="ReopenWindowDays" class="ocat-label">@T["Reopen window (days)"]</label>
            <div class="ocat-end">
                <input asp-for="ReopenWindowDays" class="form-control" type="number" min="0" />
                <span class="hint">@T["A reply from the requester inside this many days after solving reopens the ticket; a later one opens a follow-up."]</span>
            </div>
        </div>

        <div class="ocat-wrapper">
            <label asp-for="AutoCloseDays" class="ocat-label">@T["Close solved tickets after (days)"]</label>
            <div class="ocat-end">
                <input asp-for="AutoCloseDays" class="form-control" type="number" min="0" />
                <span class="hint">@T["0 keeps solved tickets until someone closes them."]</span>
            </div>
        </div>

        <div class="ocat-wrapper">
            <label asp-for="DeleteProtectedInformationDays" class="ocat-label">@T["Delete protected information after (days)"]</label>
            <div class="ocat-end">
                <input asp-for="DeleteProtectedInformationDays" class="form-control" type="number" min="0" />
                <span class="hint">@T["Days after a ticket is closed that its protected information (logins and other secrets) is deleted. 0 keeps it."]</span>
            </div>
        </div>
    </div>
</div>

<div class="card text-bg-theme mb-3">
    <div class="card-header">@T["Requesters and assignees"]</div>
    <div class="card-body">
        <div class="ocat-wrapper">
            <div class="ocat-end-offset">
                <div class="form-check">
                    <input asp-for="NotifyRequester" class="form-check-input" type="checkbox" />
                    <label asp-for="NotifyRequester" class="form-check-label">@T["Tell the requester"]</label>
                    <span class="hint dashed">@T["When their ticket is received, answered and solved: through their notifications when they have an account on the site, otherwise by e-mail. The messages are written under Settings › Service Desk."]</span>
                </div>
            </div>
        </div>

        <div class="ocat-wrapper">
            <div class="ocat-end-offset">
                <div class="form-check">
                    <input asp-for="NotifyAssignee" class="form-check-input" type="checkbox" />
                    <label asp-for="NotifyAssignee" class="form-check-label">@T["Tell the assignee"]</label>
                    <span class="hint dashed">@T["When a ticket is assigned to them, and the members of its team when it is given to their team."]</span>
                </div>
            </div>
        </div>

        <div class="ocat-wrapper">
            <label asp-for="RatingRequestDelayHours" class="ocat-label">@T["Ask requesters to rate a solved ticket after (hours)"]</label>
            <div class="ocat-end">
                <input asp-for="RatingRequestDelayHours" class="form-control" type="number" min="0" />
                <span class="hint">@T["With Tickets Portal on and requesters told, the requester gets one message with a link to rate how their request was handled. 0 never asks."]</span>
            </div>
        </div>
    </div>
</div>
