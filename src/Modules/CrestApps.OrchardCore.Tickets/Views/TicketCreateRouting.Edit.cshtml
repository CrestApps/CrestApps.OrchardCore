@model TicketCreateViewModel

@if (Model.Categories.Count > 0)
{
    <div class="ocat-wrapper">
        <label for="CategoryId" class="ocat-label @(Model.CategoryRequired ? "ocat-label-required" : null)">@T["Category"]</label>
        <div class="ocat-end">
            @await DisplayAsync(await New.TaxonomyCascadingPicker(InputName: "CategoryId", InputId: "CategoryId", Choices: Model.Categories, SelectedId: Model.CategoryId, Required: Model.CategoryRequired, EmptyText: T["Choose a category"].Value))
            <span asp-validation-for="CategoryId" class="text-danger"></span>
            <span class="hint">@T["The category decides which questions below apply and, when the desk is left to it, where the ticket goes."]</span>
        </div>
    </div>
}

<div class="ocat-wrapper">
    <label asp-for="DeskId" class="ocat-label">@T["Desk"]</label>
    <div class="ocat-end">
        <select asp-for="DeskId" asp-items="Model.Desks" class="form-select">
            @if (Model.Categories.Count > 0)
            {
                <option value="">@T["The category's desk"]</option>
            }
        </select>
        <span asp-validation-for="DeskId" class="text-danger"></span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="PriorityId" class="ocat-label">@T["Priority"]</label>
    <div class="ocat-end">
        <select asp-for="PriorityId" asp-items="Model.Priorities" class="form-select">
            <option value="">@T["The ticket type's default"]</option>
        </select>
    </div>
</div>
