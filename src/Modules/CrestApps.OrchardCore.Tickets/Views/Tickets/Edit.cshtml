@model IShape

@{
    var ticket = (OrchardCore.ContentManagement.ContentItem)ViewData["Ticket"];
    var number = ticket.GetOrCreate<TicketPart>().Number;
}

<zone Name="Title">
    <breadcrumb name="TicketsEdit" title="@T["Edit {0}", number]">
        <breadcrumb-item id="Tickets" action="Index" controller="Tickets" area="CrestApps.OrchardCore.Tickets">@T["Tickets"]</breadcrumb-item>
        <breadcrumb-item id="TicketsDisplay" action="Display" controller="Tickets" area="CrestApps.OrchardCore.Tickets" route-id="@ticket.ContentItemId">@T["{0} {1}", number, ticket.DisplayText]</breadcrumb-item>
    </breadcrumb>
</zone>

<form method="post" asp-action="Edit" asp-route-id="@ticket.ContentItemId" enctype="multipart/form-data" class="no-multisubmit">
    @Html.ValidationSummary()
    @await DisplayAsync(Model)

    <div class="action-bar-bottom">
        <button class="btn btn-primary" type="submit">@T["Save"]</button>
        <a class="btn btn-secondary cancel" role="button" asp-action="Display" asp-route-id="@ticket.ContentItemId">@T["Cancel"]</a>
    </div>
</form>
