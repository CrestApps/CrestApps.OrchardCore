@model TicketCreateViewModel

@{
    // The form is one ticket type's, chosen before it (New ticket, or the type page); it can't change here.
    var typeName = Model.Types.FirstOrDefault(type => type.Selected)?.Text;
}

<zone Name="Title"><breadcrumb name="TicketsCreate" title="@(string.IsNullOrEmpty(typeName) ? T["New Ticket"] : T["New Ticket: {0}", typeName])">
    <breadcrumb-item id="Tickets" action="Index" controller="Tickets" area="CrestApps.OrchardCore.Tickets">@T["Tickets"]</breadcrumb-item>
</breadcrumb></zone>

<style asp-name="@CrestApps.OrchardCore.Tickets.Services.TicketsResourceConfiguration.FormStyle"></style>

<form asp-action="Create" asp-route-contentType="@Model.ContentType" method="post" enctype="multipart/form-data" class="no-multisubmit">
    @Html.ValidationSummary()
    <input type="hidden" asp-for="AccountId" />
    <input type="hidden" asp-for="ConversationId" />

    @await DisplayAsync(Model.RequestEditor)

    @* The ticket type's own editor: its title (the subject) and its fields. *@
    @* The page has its own action bar; the content editor's would sit on top of it. *@
    @{ Model.Editor.Properties.Remove("Actions"); }
    <div class="ticket-fields">
        @await DisplayAsync(Model.Editor)
    </div>

    @await DisplayAsync(Model.MessageEditor)

    <div class="action-bar-bottom">
        <button type="submit" class="btn btn-primary">@T["Create"]</button>
        <a asp-action="Index" class="btn btn-secondary">@T["Cancel"]</a>
    </div>
</form>
