@model TicketsListViewModel

<zone Name="Title"><breadcrumb name="Tickets" title="@T["Tickets"]" /></zone>

<form asp-action="Index" method="get" id="tickets-filter">
    <input type="hidden" name="viewId" value="@Model.ViewId" />
    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <div class="input-group">
                        <input asp-for="Q" class="form-control" placeholder="@T["Search by number or subject"]" aria-label="@T["Search tickets"]" type="search" autocomplete="off" />
                        <button type="submit" class="btn btn-outline-secondary" title="@T["Search"]" aria-label="@T["Search"]"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
                    </div>
                </div>
                <div class="col-auto">
                    @if (!Model.CanCreate)
                    {
                    }
                    else if (Model.Options.Types.Count > 1)
                    {
                        <div class="dropdown">
                            <button type="button" class="btn btn-secondary create dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">@T["New Ticket"]</button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                @foreach (var type in Model.Options.Types)
                                {
                                    <li><a class="dropdown-item" asp-action="Create" asp-route-contentType="@type.Value">@type.Text</a></li>
                                }
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-action="Create" class="btn btn-secondary create">@T["New Ticket"]</a>
                    }
                </div>
            </div>
        </div>
    </div>
</form>

@if (Model.Options.Views.Count > 0)
{
    <ul class="nav nav-pills mb-3 gap-1" aria-label="@T["Saved views"]">
        <li class="nav-item"><a class="nav-link py-1 @(string.IsNullOrEmpty(Model.ViewId) ? "active" : null)" asp-action="Index">@T["Still being worked on"]</a></li>
        @foreach (var view in Model.Options.Views)
        {
            <li class="nav-item"><a class="nav-link py-1 @(view.Selected ? "active" : null)" asp-action="Index" asp-route-viewId="@view.Value">@view.Text</a></li>
        }
    </ul>
}

@{
    Model.List.ToolbarActions = await New.TicketsFilter(ViewModel: Model, FormId: "tickets-filter");
}

@* The pickers submit the search form above (their form attribute); this form only carries the bulk actions. *@
<style asp-name="@CrestApps.OrchardCore.Tickets.Services.TicketsResourceConfiguration.ListStyle"></style>
<form asp-action="Bulk" method="post" class="no-multisubmit tickets-list" data-list-management data-client-side-search="false"
      data-bulk-action-input-name="bulkAction" data-filter-submit-selector="[data-tickets-none]" data-selected-label="@T["selected"]">
    <input type="hidden" name="bulkAction" />
    <input type="hidden" name="returnUrl" value="@(Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString)" />
    <input type="submit" name="submit.BulkAction" class="visually-hidden" />

    <admin-list name="Tickets" context="Model.List"
                bulk-actions="Model.BulkActions"
                empty-message="@T["<strong>Nothing here!</strong> No ticket matches the view, the search and the filters."]">
        <admin-list-list item-css-class="list-group-item" />
        <admin-list-grid>
            <admin-list-column type="Select" />
            <admin-list-column name="Name" position="20" title="@T["Ticket"]" />
            @* The badges wrap in columns of a set width, so on a narrower screen the ticket's subject keeps its room. *@
            <admin-list-column name="State" position="30" title="@T["Status"]" width="9rem" no-wrap="false" />
            <admin-list-column name="People" position="40" title="@T["People"]" width="11rem" no-wrap="false" />
            <admin-list-column name="Due" position="50" title="@T["Due"]" width="9rem" no-wrap="false" />
            <admin-list-column type="Actions" title="@T["Actions"]" />
        </admin-list-grid>
    </admin-list>
</form>

<script asp-name="list-management-ui" at="Foot"></script>
