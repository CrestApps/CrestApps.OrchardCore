@model TicketRequesterViewModel

@{
    var contact = Model.Part.RequesterContact;
}

<div class="card mb-3">
    <div class="card-body">
        <h2 class="h6">@T["Requester"]</h2>
        @if (string.IsNullOrEmpty(Model.RequesterName) && contact is null)
        {
            <p class="small text-muted mb-0">@T["Nobody is named yet."]</p>
        }
        else
        {
            <div class="mb-2">
                <div>@Model.RequesterName</div>
                @if (!string.IsNullOrEmpty(contact?.Email))
                {
                    <a class="small d-block" href="mailto:@contact.Email">@contact.Email</a>
                }
                @if (contact is not null && contact.Phone.HasValue && contact.Phone.ToString() is { Length: > 0 } phone)
                {
                    <a class="small d-block" href="tel:@phone">@phone</a>
                }
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.Part.AccountId))
        {
            <div class="small mb-2">@T["Account"]: <a href="@Url.Content($"~/Admin/Contents/ContentItems/{Model.Part.AccountId}/Display")">@T["Open the account"]</a></div>
        }
        @if (Model.Participants.Count > 0)
        {
            <div class="small mb-2">@T["Also following"]: @string.Join(", ", Model.Participants)</div>
        }
        @if (Model.PreviousTickets.Count > 0)
        {
            <h3 class="h6 small text-muted mt-3">@T["Their other tickets ({0})", Model.PreviousTotal]</h3>
            <ul class="list-unstyled small mb-0">
                @foreach (var other in Model.PreviousTickets)
                {
                    <li class="mb-1">
                        <a asp-area="CrestApps.OrchardCore.Tickets" asp-controller="Tickets" asp-action="Display" asp-route-id="@other.Ticket.ContentItemId"><span class="text-muted">@other.Part?.Number</span> @other.Ticket.DisplayText</a>
                        @if (other.Status is not null)
                        {
                            <span class="badge ta-badge fw-normal">@other.Status.Name</span>
                        }
                    </li>
                }
            </ul>
        }
    </div>
</div>
