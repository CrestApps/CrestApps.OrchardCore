@model ShapeViewModel<HierarchyParentListItem>
@using OrchardCore.Environment.Shell.Models

@{
    var parent = Model.Value.Parent;
    var settings = parent.Settings;
}

<a class="btn btn-primary btn-sm" asp-controller="Platform" asp-action="EditParent" asp-route-id="@settings.Name">@T["Policy"]</a>
@if (!string.IsNullOrEmpty(parent.Address))
{
    <a class="btn btn-info btn-sm" href="@parent.Address" target="_blank" rel="noopener noreferrer">@T["View"]</a>
}
@if (settings.State == TenantState.Running)
{
    <a class="btn btn-danger btn-sm" asp-controller="Platform" asp-action="Suspend" asp-route-id="@settings.Name" data-url-af="RemoveUrl UnsafeUrl" data-title="@T["Suspend"]" data-message="@T["Suspend {0} and every running child tenant? Nobody can use them until you resume.", parent.DisplayName]">@T["Suspend"]</a>
}
else if (settings.State == TenantState.Disabled)
{
    <a class="btn btn-success btn-sm" asp-controller="Platform" asp-action="Resume" asp-route-id="@settings.Name" data-url-af="UnsafeUrl">@T["Resume"]</a>
}
<a class="btn btn-secondary btn-sm" asp-controller="Platform" asp-action="Parent" asp-route-id="@settings.Name">@T["Manage"]</a>
