@model PlatformIndexViewModel

@{
    var overview = Model.Overview;
    var canMakeParent = Model.HostGuardInstalled && overview.Candidates.Count > 0;
}

<zone Name="Title">
    <breadcrumb name="TenantHierarchyPlatform" title="@T["Tenant Hierarchy"]" />
</zone>

@if (!Model.HostGuardInstalled)
{
    <div class="alert alert-warning">
        <h5 class="alert-heading"><i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i>@T["The host guards are not installed"]</h5>
        <p class="mb-0">@T["Call AddTenantHierarchy() inside AddOrchardCms() in Program.cs, then restart the application. Until then, no tenant can be made a parent."]</p>
    </div>
}

<form method="get" asp-action="Index">
    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <div class="input-group">
                        <input id="search-box" name="search" value="@Model.Search" class="form-control" placeholder="@T["Search"]" type="search" autocomplete="off" autofocus />
                        <button type="submit" class="btn btn-outline-secondary" title="@T["Search"]" aria-label="@T["Search"]"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
                    </div>
                </div>
                <div class="col-auto">
                    @if (canMakeParent)
                    {
                        <a class="btn btn-secondary create" role="button" asp-action="MakeParent">@T["Make a Parent Tenant"]</a>
                    }
                    else if (Model.HostGuardInstalled)
                    {
                        <a class="btn btn-secondary create" role="button" asp-area="OrchardCore.Tenants" asp-controller="Admin" asp-action="Create" data-bs-toggle="tooltip" title="@T["Every tenant is already in the hierarchy. A tenant that is set up and not in the hierarchy can become a parent."]">@T["Add Tenant"]</a>
                    }
                </div>
            </div>
        </div>
    </div>
</form>

<p class="small text-muted">@T["Parents get the address <code>{{slug}}.{0}</code>; their child tenants get addresses under it.", Model.PlatformDomain]</p>

@* The parents, their count and the layout selector are rendered by the AdminList shape, in the layout (List or Grid)
   the site or the user picked. Each row names the parent's first child tenants; its own screen lists them all. *@
<admin-list name="TenantHierarchyParents" context="Model.ParentList" show-select-all="false"
            empty-message="@(overview.Parents.Count == 0 ? T["No parent tenants yet. A parent tenant creates and manages its own child tenants, and its users can open them without signing in again."] : T["No parent tenant matches your search."])">
    <admin-list-list item-css-class="list-group-item" />
    <admin-list-grid>
        <admin-list-column name="Name" position="20" title="@T["Name"]" />
        <admin-list-column name="Children" position="30" title="@T["Child tenants"]" />
        <admin-list-column name="Policy" position="40" title="@T["Policy"]" width="auto" />
        <admin-list-column name="State" position="50" title="@T["State"]" width="auto" />
        <admin-list-column type="Actions" title="@T["Actions"]" />
    </admin-list-grid>
</admin-list>

@if (overview.Orphans.Count > 0)
{
    <div class="alert alert-warning mt-4 mb-3" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i><strong>@T.Plural(overview.Orphans.Count, "1 orphaned child tenant", "{0} orphaned child tenants")</strong>
        <span class="ms-1">@T["Their parent tenant no longer exists. Move each one to a parent tenant, or make it an ordinary tenant."]</span>
    </div>

    @* The orphaned child tenants; the alert above counts them, so the list has no toolbar of its own. *@
    <admin-list name="TenantHierarchyOrphans" context="Model.OrphanList" show-select-all="false" show-toolbar="false">
        <admin-list-list item-css-class="list-group-item" />
        <admin-list-grid>
            <admin-list-column name="Name" position="20" title="@T["Name"]" />
            <admin-list-column name="Address" position="30" title="@T["Address"]" width="auto" />
            <admin-list-column name="State" position="40" title="@T["State"]" width="auto" />
            <admin-list-column type="Actions" title="@T["Actions"]" />
        </admin-list-grid>
    </admin-list>
}
