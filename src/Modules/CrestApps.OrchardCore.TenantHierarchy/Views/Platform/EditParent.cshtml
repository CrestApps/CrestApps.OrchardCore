@model ParentPolicyEditViewModel

@{
    var title = Model.IsNew
        ? T["Make a parent tenant"].Value
        : T.GetString("Policy of {0}", Model.DisplayName).Value;
    var action = Model.IsNew ? "MakeParent" : "EditParent";
}

<zone Name="Title">
    <breadcrumb name="@(Model.IsNew ? "TenantHierarchyPlatformMakeParent" : "TenantHierarchyPlatformPolicy")" title="@T["{0}", title]">
        <breadcrumb-item id="TenantHierarchyPlatform" action="Index" controller="Platform" area="@TenantHierarchyConstants.Features.Area" permission="@TenantHierarchyPermissions.ManageTenantHierarchy.Name">@T["Tenant Hierarchy"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form asp-action="@action" asp-route-id="@(Model.IsNew ? null : Model.TenantName)" method="post" class="no-multisubmit">
    @Html.ValidationSummary(true, string.Empty, new { @class = "text-danger" })

    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <button class="btn btn-primary" type="submit">@(Model.IsNew ? T["Make Parent Tenant"] : T["Save"])</button>
        <a class="btn btn-secondary cancel" role="button" asp-action="Index">@T["Cancel"]</a>
    </div>
</form>

<script at="Foot">
    (function () {
        const select = document.querySelector('[data-th-suggestions]');

        if (!select) {
            return;
        }

        const suggestions = JSON.parse(select.dataset.thSuggestions || '{}');
        const displayName = document.getElementById('@Html.IdFor(m => m.DisplayName)');
        const slug = document.getElementById('@Html.IdFor(m => m.Slug)');

        // A field the user typed in keeps its value when another tenant is picked.
        [displayName, slug].forEach((input) => input?.addEventListener('input', () => input.dataset.edited = 'true'));

        select.addEventListener('change', () => {
            const suggestion = suggestions[select.value];

            if (!suggestion) {
                return;
            }

            if (displayName && displayName.dataset.edited !== 'true') {
                displayName.value = suggestion.displayName;
            }

            if (slug && slug.dataset.edited !== 'true') {
                slug.value = suggestion.slug;
            }
        });
    })();
</script>
