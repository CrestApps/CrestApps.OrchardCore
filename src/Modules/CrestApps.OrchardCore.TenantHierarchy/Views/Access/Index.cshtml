@model AccessGrantsViewModel

@{
    var labels = Model.Labels;
    var childId = Model.Child?.Entry.EntryId;
    var title = Model.Child is null
        ? T.GetString("Access to every {0}", labels.ChildLower).Value
        : T.GetString("Access to {0}", Model.Child.Entry.DisplayName).Value;
    var target = Model.Child is null
        ? T.GetString("every {0}", labels.ChildLower).Value
        : Model.Child.Entry.DisplayName;
}

<zone Name="Title">
    <breadcrumb name="@(Model.Child is null ? "TenantHierarchyAccess" : "TenantHierarchyChildAccess")" title="@T["{0}", title]">
        <breadcrumb-item id="TenantHierarchyChildren" action="Index" controller="ChildTenants" area="@TenantHierarchyConstants.Features.Area" permission="@TenantHierarchyPermissions.ViewChildTenants.Name">@labels.Children</breadcrumb-item>
    </breadcrumb>
</zone>

<div class="alert alert-light border d-flex gap-3 mb-4">
    <i class="fa-solid fa-circle-info text-primary mt-1" aria-hidden="true"></i>
    <div>
        <div class="fw-semibold mb-1">@T["How access works"]</div>
        <ul class="mb-0 ps-3">
            <li>@T["People in {0} never need a password for a {1}. They open it from here, and are signed in to it automatically.", Model.ParentName, labels.ChildLower]</li>
            <li>@T["A rule says who in {0} may open {1}, and which roles they have once they are inside.", Model.ParentName, target]</li>
            <li>@T["Someone who matches several rules gets all of their roles. Someone who matches no rule cannot open it."]</li>
        </ul>
        @if (Model.Child is not null)
        {
            <div class="mt-2 small">@T["Rules for every {0} apply here too.", labels.ChildLower] <a asp-action="Index">@T["Edit the rules for every {0}", labels.ChildLower]</a></div>
        }
    </div>
</div>

@* The rules are rendered by the AdminList shape, in the layout (List or Grid) the site or the user picked. On a
   child tenant's screen, the rules for every child tenant follow its own, read-only. *@
<h2 class="h5">@T["Rules"]</h2>
<div class="mb-4">
    <admin-list name="TenantHierarchyAccessGrants" context="Model.List" show-select-all="false"
                empty-message="@T["No rule yet, so nobody in {0} can open {1}. Add a rule below.", Model.ParentName, target]">
        <admin-list-list item-css-class="list-group-item" />
        <admin-list-grid>
            <admin-list-column name="Name" position="20" title="@T["Who in {0}", Model.ParentName]" />
            <admin-list-column name="Scope" position="30" title="@T["Can open"]" width="auto" />
            <admin-list-column name="Roles" position="40" title="@T["Roles inside the {0}", labels.ChildLower]" width="auto" />
            <admin-list-column type="Actions" title="@T["Actions"]" />
        </admin-list-grid>
    </admin-list>
</div>

<div class="card">
    <div class="card-header fw-semibold">@T["Add a rule for {0}", target]</div>
    <div class="card-body">
        <form asp-action="Add" asp-route-id="@childId" method="post" class="no-multisubmit" id="th-grant-form">
            <div class="mb-3">
                <span class="form-label d-block">@T["Who in {0}", Model.ParentName]</span>
                <div class="btn-group" role="group">
                    <input type="radio" class="btn-check" asp-for="PrincipalType" value="@AccessGrantPrincipalType.Role" id="th-type-role" checked />
                    <label class="btn btn-outline-secondary" for="th-type-role"><i class="fa-solid fa-users me-1" aria-hidden="true"></i>@T["Everyone with a role"]</label>
                    <input type="radio" class="btn-check" asp-for="PrincipalType" value="@AccessGrantPrincipalType.User" id="th-type-user" />
                    <label class="btn btn-outline-secondary" for="th-type-user"><i class="fa-solid fa-user me-1" aria-hidden="true"></i>@T["One person"]</label>
                </div>
            </div>

            <div class="mb-3" data-th-for="Role">
                <label asp-for="PrincipalRole" class="form-label ocat-label-required">@T["Their role in {0}", Model.ParentName]</label>
                <select asp-for="PrincipalRole" class="form-select">
                    @foreach (var role in Model.ParentRoles)
                    {
                        <option value="@role">@role</option>
                    }
                </select>
            </div>

            <div class="mb-3 d-none" data-th-for="User">
                <span class="form-label d-block ocat-label-required">@T["Person"]</span>
                @await Component.InvokeAsync("UserPicker", new
                {
                    name = Html.NameFor(m => m.Principal).ToString(),
                    selectedValues = string.IsNullOrEmpty(Model.Principal) ? Array.Empty<string>() : new[] { Model.Principal },
                    valueType = "userName",
                    multiple = false,
                    buttonText = T["Select a person"].Value,
                    searchPlaceholder = T["Search users"].Value,
                    smallButton = false,
                })
            </div>

            <div class="mb-3">
                <span class="form-label d-block ocat-label-required">@T["Their roles inside the {0}", labels.ChildLower]</span>
                @foreach (var role in Model.ChildRoles)
                {
                    var id = $"th-child-role-{role}";
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" name="SelectedChildRoles" value="@role" id="@id" />
                        <label class="form-check-label" for="@id">@role</label>
                    </div>
                }
                <span class="hint">@T["These decide what they can see and do once they open the {0}. A role that does not exist in a {0} is ignored there.", labels.ChildLower]</span>
            </div>

            <button type="submit" class="btn btn-primary"><i class="fa-solid fa-plus me-1" aria-hidden="true"></i>@T["Add rule"]</button>
        </form>
    </div>
</div>

<script at="Foot">
    (function () {
        const form = document.getElementById('th-grant-form');
        const update = () => {
            const type = form.querySelector('input[name="PrincipalType"]:checked').value;
            form.querySelectorAll('[data-th-for]').forEach((element) => element.classList.toggle('d-none', element.dataset.thFor !== type));
        };

        form.querySelectorAll('input[name="PrincipalType"]').forEach((input) => input.addEventListener('change', update));
        update();
    })();
</script>
