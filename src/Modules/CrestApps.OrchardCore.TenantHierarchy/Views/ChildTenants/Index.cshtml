@model ChildTenantsIndexViewModel

@{
    var labels = Model.Labels;
    var atLimit = Model.TotalCount >= Model.MaxChildren;
}

<zone Name="Title">
    <breadcrumb name="TenantHierarchyChildren" title="@T["{0}", labels.Children]" />
</zone>

<style asp-name="bootstrap-select" at="Head"></style>
<script asp-name="bootstrap-select" at="Foot"></script>

@if (!Model.HostGuardInstalled)
{
    <div class="alert alert-warning" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i>
        @T["New {0} cannot be created yet: the platform administrator must finish the setup of the tenant hierarchy.", labels.ChildrenLower]
    </div>
}

<form asp-action="Index" method="post" class="no-multisubmit" data-list-management data-selected-label="@T["selected"]" data-client-side-search="false">
    <input type="submit" name="submit.Filter" id="submitFilter" class="visually-hidden" />
    <input asp-for="Options.BulkAction" type="hidden" />
    <input type="submit" name="submit.BulkAction" class="visually-hidden" />

    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <div class="input-group">
                        <input id="search-box" asp-for="Options.Search" class="form-control" placeholder="@T["Search by name or address"]" type="search" autofocus autocomplete="off" />
                        <button type="submit" name="submit.Filter" class="btn btn-outline-secondary" title="@T["Search"]" aria-label="@T["Search"]"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
                    </div>
                </div>
                @if (Model.CanCreate)
                {
                    <div class="col-auto">
                        @if (atLimit || !Model.HostGuardInstalled)
                        {
                            <span class="d-inline-block" tabindex="0" data-bs-toggle="tooltip" title="@(atLimit ? T["You have reached your limit of {0} {1}.", Model.MaxChildren, labels.ChildrenLower] : T["Not available yet."])">
                                <button type="button" class="btn btn-secondary" disabled>
                                    <i class="fa-solid fa-plus me-1" aria-hidden="true"></i>@T["Add {0}", labels.ChildLower]
                                </button>
                            </span>
                        }
                        else
                        {
                            <a class="btn btn-secondary create" role="button" asp-action="Create">
                                <i class="fa-solid fa-plus me-1" aria-hidden="true"></i>@T["Add {0}", labels.ChildLower]
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    @if (Model.TotalCount == 0)
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <div class="mb-3"><i class="fa-solid fa-sitemap fa-3x text-muted" aria-hidden="true"></i></div>
                <h2 class="h4">@T["No {0} yet", labels.ChildrenLower]</h2>
                <p class="text-muted mb-3">@T["Each {0} gets its own site with its own address, users and data. You can open any of them from here without signing in again.", labels.ChildLower]</p>
                @if (Model.CanCreate && Model.HostGuardInstalled)
                {
                    <a class="btn btn-primary" asp-action="Create"><i class="fa-solid fa-plus me-1" aria-hidden="true"></i>@T["Add your first {0}", labels.ChildLower]</a>
                }
            </div>
        </div>
    }
    else
    {
        @* The child tenants, the toolbar (select-all, bulk actions, state and sort filters) and the pager are rendered by the AdminList shape, in the layout (List or Grid) the site or the user picked. *@
        <admin-list name="TenantHierarchyChildren" context="Model.List"
                    empty-message="@T["<strong>Nothing here!</strong> Your search returned no results."]">
            <admin-list-list item-css-class="list-group-item" />
            <admin-list-grid>
                @if (Model.BulkActions.Count > 0)
                {
                    <admin-list-column type="Select" />
                }
                <admin-list-column name="Name" position="20" title="@T["Name"]" />
                <admin-list-column name="State" position="30" title="@T["State"]" width="auto" />
                <admin-list-column name="Address" position="40" title="@T["Address"]" width="auto" />
                <admin-list-column type="Actions" title="@T["Actions"]" />
            </admin-list-grid>
        </admin-list>
    }
</form>

<style at="Head">
    .th-avatar { width: 2rem; height: 2rem; font-size: .8125rem; background-color: var(--bs-primary-bg-subtle); color: var(--bs-primary-text-emphasis); }
</style>

<script asp-name="list-management-ui" at="Foot"></script>
<script at="Foot">
    (function () {
        const rows = document.querySelectorAll('[data-status-url]');

        if (rows.length === 0) {
            return;
        }

        let attempts = 0;
        const poll = async () => {
            attempts++;

            for (const row of rows) {
                try {
                    const response = await fetch(row.dataset.statusUrl, { headers: { 'Accept': 'application/json' }, credentials: 'same-origin' });

                    if (!response.ok) {
                        continue;
                    }

                    const status = await response.json();

                    if (status.status !== 'Provisioning' && status.status !== 'Removing' && status.state !== 'Initializing') {
                        window.location.reload();
                        return;
                    }
                } catch (e) {
                    // Keep polling: the tenant may be restarting.
                }
            }

            if (attempts < 120) {
                window.setTimeout(poll, 3000);
            }
        };

        window.setTimeout(poll, 3000);
    })();
</script>
