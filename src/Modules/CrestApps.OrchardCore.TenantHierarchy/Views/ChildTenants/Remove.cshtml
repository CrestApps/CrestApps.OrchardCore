@model ChildTenantRemoveViewModel

@{
    var labels = Model.Labels;
    var entry = Model.Info.Entry;
    var suspended = Model.Info.State == ChildTenantRuntimeState.Suspended || Model.Info.State == ChildTenantRuntimeState.Uninitialized;
}

<zone Name="Title">
    <breadcrumb name="TenantHierarchyChildrenRemove" title="@T["Remove {0}", entry.DisplayName]">
        <breadcrumb-item id="TenantHierarchyChildren" action="Index" controller="ChildTenants" area="@TenantHierarchyConstants.Features.Area" permission="@TenantHierarchyPermissions.ViewChildTenants.Name">@labels.Children</breadcrumb-item>
    </breadcrumb>
</zone>

<form asp-action="Remove" asp-route-id="@entry.EntryId" method="post" class="no-multisubmit">
    @Html.ValidationSummary(true, string.Empty, new { @class = "text-danger" })

    @if (!suspended)
    {
        <div class="alert alert-info">
            <i class="fa-solid fa-circle-info me-1" aria-hidden="true"></i>
            @T["Suspend {0} first. Only a suspended {1} can be removed.", entry.DisplayName, labels.ChildLower]
        </div>
        <a class="btn btn-secondary" asp-action="Index">@T["Back"]</a>
    }
    else
    {
        <div class="alert alert-danger">
            <h5 class="alert-heading"><i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i>@T["This removes {0} and all its data.", entry.DisplayName]</h5>
            @if (Model.GraceDays > 0)
            {
                <p class="mb-0">@T["It stays suspended for {0} day(s) first. Until then you can restore it from the list.", Model.GraceDays]</p>
            }
            else
            {
                <p class="mb-0">@T["Its site, users, content and database are removed now. This cannot be undone here."]</p>
            }
        </div>

        <div class="ocat-wrapper">
            <label asp-for="ConfirmName" class="ocat-label">@T["Type the name to confirm"]</label>
            <div class="ocat-end">
                <input asp-for="ConfirmName" class="form-control" autocomplete="off" placeholder="@entry.DisplayName" data-th-confirm data-expected="@entry.DisplayName" />
                <span asp-validation-for="ConfirmName" class="text-danger"></span>
                <span class="hint">@T["Type {0} exactly as it is shown.", entry.DisplayName]</span>
            </div>
        </div>

        <div class="ocat-wrapper">
            <div class="ocat-end-offset">
                <button class="btn btn-danger" type="submit" data-th-confirm-submit disabled><i class="fa-solid fa-trash me-1" aria-hidden="true"></i>@T["Remove {0}", labels.ChildLower]</button>
                <a class="btn btn-secondary cancel" role="button" asp-action="Index">@T["Cancel"]</a>
            </div>
        </div>
    }
</form>

<script at="Foot">
    (function () {
        const input = document.querySelector('[data-th-confirm]');
        const submit = document.querySelector('[data-th-confirm-submit]');

        if (!input || !submit) {
            return;
        }

        const update = () => submit.disabled = input.value.trim() !== input.dataset.expected;
        input.addEventListener('input', update);
        update();
    })();
</script>
