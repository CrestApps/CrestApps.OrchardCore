@using CrestApps.OrchardCore.Telephony.Core.Models

@model ShapeViewModel<TelephonyExtension>

<h5 class="mb-0 d-flex align-items-center flex-wrap gap-2">
    <span>@Model.Value.DisplayName</span>
    @* The number is a badge of its own so it never reads as part of the name beside it. A label on a plain span
       is not announced, so screen readers get a visually hidden one; the title is the pointer tooltip. *@
    <span class="badge ta-badge bg-primary-subtle font-weight-normal" data-bs-toggle="tooltip" title="@T["Extension number"]">
        <i class="fa-solid fa-hashtag" aria-hidden="true"></i><span class="visually-hidden">@T["Extension number"]</span> @Model.Value.Number
    </span>
</h5>
