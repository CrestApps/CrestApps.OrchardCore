@using CrestApps.OrchardCore.Telephony.Core.Models

@model ShapeViewModel<TelephonyExtension>

@if (!string.IsNullOrEmpty(Model.Value.UserName))
{
    <span class="badge ta-badge" title="@T["User name"]">
        <i class="fa-solid fa-user" aria-hidden="true"></i><span class="visually-hidden">@T["User name"]</span> @Model.Value.UserName
    </span>
}
