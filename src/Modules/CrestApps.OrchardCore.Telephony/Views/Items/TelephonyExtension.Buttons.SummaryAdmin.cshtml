@using CrestApps.OrchardCore.Telephony.Core.Models

@model ShapeViewModel<TelephonyExtension>

<a asp-route-action="Edit" asp-route-controller="Extensions" asp-route-id="@Model.Value.ItemId" class="btn btn-primary btn-sm">@T["Edit"]</a>

<a asp-route-action="Delete" asp-route-controller="Extensions" asp-route-id="@Model.Value.ItemId" class="btn btn-danger btn-sm" data-title="@T["Delete"]" data-message="@T["Are you sure you want to delete this extension?"]" data-ok-text="@T["Delete"]" data-cancel-text="@T["Cancel"]" data-url-af="RemoveUrl UnsafeUrl">@T["Delete"]</a>
