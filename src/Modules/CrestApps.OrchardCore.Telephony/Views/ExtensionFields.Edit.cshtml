@using CrestApps.OrchardCore.Telephony.ViewModels

@model TelephonyExtensionFieldsViewModel

<style asp-name="bootstrap-select"></style>
<script asp-name="bootstrap-select" depends-on="bootstrap" at="Foot"></script>

<div class="ocat-wrapper">
    <label asp-for="Number" class="ocat-label ocat-label-required">@T["Extension number"]</label>
    <div class="ocat-end">
        <input asp-for="Number" class="form-control" autofocus />
        <span asp-validation-for="Number" class="text-danger"></span>
        <span class="hint">@T["The number an agent dials to reach this user, for example 1001. Must be unique."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="UserId" class="ocat-label ocat-label-required">@T["User"]</label>
    <div class="ocat-end">
        <select asp-for="UserId" asp-items="Model.Users" class="selectpicker show-tick" data-live-search="true" data-header="@T["Select a user"]" data-width="100%" title="@T["Select a user"]">
        </select>
        <span asp-validation-for="UserId" class="text-danger"></span>
        <span class="hint">@T["The user this extension rings. Type to search."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="DisplayName" class="ocat-label">@T["Display name"]</label>
    <div class="ocat-end">
        <input asp-for="DisplayName" class="form-control" />
        <span class="hint">@T["Shown to a colleague who calls this extension. Defaults to the user name."]</span>
    </div>
</div>
