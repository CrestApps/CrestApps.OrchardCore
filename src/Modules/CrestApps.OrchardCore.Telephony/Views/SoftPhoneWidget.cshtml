@using System.Text.Json
@using CrestApps.OrchardCore.Telephony
@using CrestApps.OrchardCore.Telephony.Hubs
@using CrestApps.OrchardCore.Telephony.Models
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var hubUrl = Html.SignalRHubUrl<TelephonyHub>();
    var accentColor = Model.AccentColor as string ?? "#2f6fed";
    var recentCallsCount = Model.RecentCallsCount is int configuredRecentCallsCount
        ? configuredRecentCallsCount
        : SoftPhoneWidgetSettings.DefaultRecentCallsCount;
    var capabilities = 0;
    var audioCapabilities = Model.AudioCapabilities is TelephonyAudioCapabilities configuredAudioCapabilities
        ? (int)configuredAudioCapabilities
        : Model.AudioCapabilities is int intAudioCapabilities
            ? intAudioCapabilities
            : 0;
    var audioMode = Model.AudioMode is TelephonyAudioMode configuredAudioMode
        ? (int)configuredAudioMode
        : Model.AudioMode is int intAudioMode
            ? intAudioMode
            : 0;
    var browserMediaAdapterName = Model.BrowserMediaAdapterName as string;
    var defaultCountryCode = Model.DefaultCountryCode as string ?? string.Empty;

    if (Model.Capabilities is TelephonyCapabilities caps)
    {
        capabilities = (int)caps;
    }
    else if (Model.Capabilities is int intCaps)
    {
        capabilities = intCaps;
    }

    var connectUrl = Url.RouteUrl(TelephonyConstants.RouteNames.OAuthConnect);
    var disconnectUrl = Url.RouteUrl(TelephonyConstants.RouteNames.OAuthDisconnect);

    if (string.IsNullOrEmpty(connectUrl))
    {
        // Fall back to the well-known connect path (including any tenant prefix) when link generation
        // cannot resolve the named route from this shape, so the "Connect to provider" button always has
        // a destination instead of silently doing nothing.
        connectUrl = $"{Context.Request.PathBase}/Telephony/Connect";
    }

    if (string.IsNullOrEmpty(disconnectUrl))
    {
        disconnectUrl = $"{Context.Request.PathBase}/Telephony/Disconnect";
    }

    var antiForgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;

    // The voicemail media endpoint is owned by the Contact Center module. Resolving its route by name keeps the
    // soft phone decoupled from that module: when Contact Center is not enabled the route does not resolve, the
    // template is null, and voicemail playback stays disabled.
    var voicemailMediaUrlTemplate = Url.RouteUrl("ContactCenterVoicemailMedia", new { interactionId = "__INTERACTION_ID__" });
    var voicemailDeleteUrlTemplate = Url.RouteUrl("ContactCenterVoicemailDelete", new { interactionId = "__INTERACTION_ID__" });

    var config = new Dictionary<string, object>
    {
        ["hubUrl"] = hubUrl,
        ["voicemailPlaybackEnabled"] = !string.IsNullOrEmpty(voicemailMediaUrlTemplate),
        ["voicemailMediaUrlTemplate"] = voicemailMediaUrlTemplate ?? string.Empty,
        ["voicemailDeleteEnabled"] = !string.IsNullOrEmpty(voicemailDeleteUrlTemplate),
        ["voicemailDeleteUrlTemplate"] = voicemailDeleteUrlTemplate ?? string.Empty,
        ["capabilities"] = capabilities,
        ["audioCapabilities"] = audioCapabilities,
        ["audioMode"] = audioMode,
        ["browserMediaAdapterName"] = browserMediaAdapterName,
        ["recentCallsCount"] = recentCallsCount,
        ["connectUrl"] = connectUrl,
        ["disconnectUrl"] = disconnectUrl,
        ["antiForgeryToken"] = antiForgeryToken,
        ["storageKey"] = "telephony-soft-phone",
        ["defaultCountryCode"] = defaultCountryCode,
        ["strings"] = new Dictionary<string, string>
        {
            ["idle"] = T["Ready"].Value,
            ["connecting"] = T["Connecting..."].Value,
            ["answerOnDialpadDevice"] = T["Answer on your Dialpad device..."].Value,
            ["ringing"] = T["Ringing..."].Value,
            ["connected"] = T["In call"].Value,
            ["inConference"] = T["In conference"].Value,
            ["onHold"] = T["On hold"].Value,
            ["disconnected"] = T["Call ended"].Value,
            ["failed"] = T["Call failed"].Value,
            ["disconnectedHub"] = T["Disconnected"].Value,
            ["reconnecting"] = T["Reconnecting..."].Value,
            ["poorConnection"] = T["Poor connection"].Value,
            ["notReady"] = T["Not Ready"].Value,
            ["notConfigured"] = T["No provider is configured. To use the soft phone enable at least one provider and update the site settings by setting the default phone provider."].Value,
            ["notConnected"] = T["Not connected"].Value,
            ["invalidNumber"] = T["Enter a valid phone number to call."].Value,
            ["extensionRequired"] = T["Enter an extension to call."].Value,
            ["dialExtension"] = T["Dial extension"].Value,
            ["dialPhoneNumber"] = T["Dial phone number"].Value,
            ["numberPlaceholder"] = T["Enter a number"].Value,
            ["extensionPlaceholder"] = T["Enter an extension"].Value,
            ["numberLabel"] = T["Phone number"].Value,
            ["extensionLabel"] = T["Extension"].Value,
            ["transferPrompt"] = T["Transfer to number"].Value,
            ["transferTitle"] = T["Transfer call"].Value,
            ["transferDestination"] = T["Number or extension"].Value,
            ["directory"] = T["Directory"].Value,
            ["directoryEmpty"] = T["No directory entries are available."].Value,
            ["cancel"] = T["Cancel"].Value,
            ["transfer"] = T["Transfer"].Value,
            ["keypad"] = T["Keypad"].Value,
            ["activeCalls"] = T["Active calls"].Value,
            ["selectCallsToMerge"] = T["Select at least two calls to conference."].Value,
            ["conference"] = T["Conference selected calls"].Value,
            ["disconnectAll"] = T["Disconnect all calls"].Value,
            ["connectPrompt"] = T["Connect your account to the telephony provider to start making calls."].Value,
            ["connectUnavailable"] = T["The connection could not be started. Refresh the page and try again."].Value,
            ["connectPopupBlocked"] = T["Your browser blocked the connection window. Allow pop-ups for this site and try again."].Value,
            ["connectFailed"] = T["The connection could not be completed. Please try connecting again."].Value,
            ["disconnectProvider"] = T["Disconnect provider"].Value,
            ["disconnectConfirm"] = T["Disconnect your provider account from the soft phone?"].Value,
            ["disconnectFailed"] = T["The provider could not be disconnected. Please try again."].Value,
            ["disconnectActiveCalls"] = T["End active calls before disconnecting from the provider."].Value,
            ["noInteractions"] = T["No recent calls."].Value,
            ["incoming"] = T["Incoming"].Value,
            ["outgoing"] = T["Outgoing"].Value,
            ["missed"] = T["Missed"].Value,
            ["voicemailLabel"] = T["Voicemail"].Value,
            ["playVoicemail"] = T["Play voicemail"].Value,
            ["pauseVoicemail"] = T["Pause voicemail"].Value,
            ["voicemailUnavailable"] = T["This voicemail is still processing. Try again in a moment."].Value,
            ["voicemailPlaybackFailed"] = T["The voicemail could not be played."].Value,
            ["voicemailDeleteFailed"] = T["The voicemail could not be deleted."].Value,
            ["selectVoicemail"] = T["Select voicemail"].Value,
            ["deleteSelected"] = T["Delete"].Value,
            ["noVoicemails"] = T["No voicemails."].Value,
            ["callBack"] = T["Call back"].Value,
            ["call"] = T["Call"].Value,
            ["inProgress"] = T["In progress"].Value,
            ["completed"] = T["Completed"].Value,
            ["rejected"] = T["Rejected"].Value,
            ["canceled"] = T["Canceled"].Value,
            ["incomingCall"] = T["Incoming call"].Value,
            ["answer"] = T["Answer"].Value,
            ["voicemail"] = T["Send to voicemail"].Value,
            ["ignore"] = T["Ignore"].Value,
            ["answerAndOpen"] = T["Answer & open"].Value,
            ["open"] = T["Open"].Value,
            ["matchedRecords"] = T["Matched records"].Value,
            ["offerUnavailable"] = T["This call is no longer available."].Value,
            ["microphoneUnavailable"] = T["The microphone is unavailable. Allow microphone access and try again."].Value,
            ["browserAudioUnavailable"] = T["The configured browser audio adapter is unavailable."].Value,
            ["micPermissionDenied"] = T["Microphone access is blocked. Allow microphone access in your browser, then retry."].Value,
            ["micNotFound"] = T["No microphone was found. Connect a microphone, then retry."].Value,
            ["defaultMicrophone"] = T["Default microphone"].Value,
            ["defaultSpeaker"] = T["Default speaker"].Value,
            ["callCredentialExpiring"] = T["This call is nearing its session limit. If it drops, redial to reconnect."].Value,
            ["diagNoData"] = T["No active call to measure."].Value,
            ["diagUnavailable"] = T["Diagnostics are not available for this provider."].Value,
            ["diagCollecting"] = T["Collecting..."].Value,
            ["echoTestNoDestination"] = T["Configure an audio test destination in the provider settings first."].Value,
            ["echoTestBusy"] = T["End the current call before running the audio test."].Value,
            ["echoTestRunning"] = T["Running audio test..."].Value,
            ["echoTestMeasuring"] = T["Connected. Measuring round-trip audio..."].Value,
            ["echoTestUnavailable"] = T["The audio test is not available for this provider."].Value,
            ["echoTestFailed"] = T["Audio test failed."].Value,
            ["echoTestPass"] = T["Audio test passed"].Value,
            ["echoTestFail"] = T["Audio test failed"].Value,
            ["echoTestEndedEarly"] = T["the call ended before audio was confirmed"].Value,
            ["echoTestNoPlace"] = T["could not place the test call"].Value,
            ["echoTestConnectedNoStats"] = T["connected (stats unavailable)"].Value,
            ["echoTestNoStats"] = T["could not read audio stats"].Value,
        },
    };
}

<div id="telephony-soft-phone"
     class="telephony-soft-phone"
     style="--telephony-accent: @accentColor; visibility: hidden;"
     data-config="@JsonSerializer.Serialize(config, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase })">

    <button type="button" class="telephony-soft-phone__toggle" data-telephony-toggle title="@T["Phone"]" aria-label="@T["Phone"]">
        <i class="fa-solid fa-phone" data-telephony-toggle-icon></i>
    </button>

    <div class="telephony-soft-phone__panel" data-telephony-panel hidden>
        <audio data-telephony-remote-audio autoplay></audio>
        <div class="telephony-soft-phone__header" data-telephony-drag-handle>
            <span class="telephony-soft-phone__title">@T["Phone"]</span>
            @if (Model.HeaderActions != null)
            {
                @await DisplayAsync(Model.HeaderActions)
            }
            <button type="button"
                    class="telephony-soft-phone__icon-btn"
                    data-telephony-disconnect
                    title="@T["Disconnect provider"]"
                    aria-label="@T["Disconnect provider"]"
                    hidden>
                <i class="fa-solid fa-link-slash"></i>
            </button>
            <button type="button" class="telephony-soft-phone__icon-btn" data-telephony-close title="@T["Close"]" aria-label="@T["Close"]">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <div class="telephony-soft-phone__connect" data-telephony-connect-panel hidden>
            <p class="telephony-soft-phone__connect-text">@T["Connect your account to the telephony provider to start making calls."]</p>
            <div class="telephony-soft-phone__connect-error alert alert-danger" data-telephony-connect-error hidden></div>
            <button type="button" class="telephony-soft-phone__connect-btn btn btn-primary" data-telephony-connect>
                <i class="fa-solid fa-link"></i> @T["Connect to provider"]
            </button>
        </div>

        <div class="telephony-soft-phone__body" data-telephony-body>
            <div class="telephony-soft-phone__unavailable alert alert-warning" data-telephony-unavailable hidden>
                <i class="fa-solid fa-circle-exclamation"></i>
                <p data-telephony-unavailable-text>@T["No provider is configured. To use the soft phone enable at least one provider and update the site settings by setting the default phone provider."]</p>
            </div>

            <div class="telephony-soft-phone__view" data-telephony-view="keypad">
                <div class="telephony-soft-phone__display">
                    <div class="telephony-soft-phone__display-meta">
                        <span class="telephony-soft-phone__status" data-telephony-status>@T["Not Ready"]</span>
                    </div>
                    <input type="tel"
                           class="telephony-soft-phone__number"
                           data-telephony-number
                           placeholder="@T["Enter a number"]"
                           aria-label="@T["Phone number"]" />
                    <button type="button"
                            class="telephony-soft-phone__dial-mode"
                            data-telephony-dial-mode-toggle
                            aria-pressed="false"
                            title="@T["Switch between dialing a phone number and an internal extension."]">
                        <i class="fa-solid fa-hashtag" aria-hidden="true"></i>
                        <span data-telephony-dial-mode-label>@T["Dial extension"]</span>
                    </button>
                </div>

                <div class="telephony-soft-phone__error alert alert-danger" data-telephony-error hidden></div>

                <button type="button"
                        class="telephony-soft-phone__mic-retry btn btn-sm btn-outline-primary"
                        data-telephony-mic-retry
                        hidden>
                    <i class="fa-solid fa-rotate-right" aria-hidden="true"></i> @T["Retry microphone"]
                </button>

                <div class="telephony-soft-phone__devices" data-telephony-devices hidden>
                    <label class="telephony-soft-phone__device">
                        <i class="fa-solid fa-microphone" aria-hidden="true"></i>
                        <select class="telephony-soft-phone__device-select"
                                data-telephony-input-device
                                aria-label="@T["Microphone"]"></select>
                    </label>
                    <label class="telephony-soft-phone__device" data-telephony-output-device-row>
                        <i class="fa-solid fa-volume-high" aria-hidden="true"></i>
                        <select class="telephony-soft-phone__device-select"
                                data-telephony-output-device
                                aria-label="@T["Speaker"]"></select>
                    </label>
                </div>

                <div class="telephony-soft-phone__diagnostics" data-telephony-diagnostics hidden>
                    <div class="telephony-soft-phone__diag-title">@T["Diagnostics"]</div>
                    <div class="telephony-soft-phone__diag-readout" data-telephony-diag-readout></div>
                    <div class="telephony-soft-phone__diag-actions">
                        <input type="text"
                               class="form-control form-control-sm"
                               data-telephony-diag-echo-input
                               placeholder="@T["Audio test destination (optional)"]"
                               aria-label="@T["Audio test destination"]" />
                        <button type="button" class="btn btn-sm btn-secondary" data-telephony-diag-run>@T["Run audio test"]</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-telephony-diag-dump>@T["Dump SDP/stats"]</button>
                    </div>
                    <div class="telephony-soft-phone__diag-status" data-telephony-diag-status></div>
                    <pre class="telephony-soft-phone__diag-output" data-telephony-diag-output></pre>
                </div>

                <div class="telephony-soft-phone__active-calls" data-telephony-active-calls hidden>
                    <div class="telephony-soft-phone__active-calls-heading">@T["Active calls"]</div>
                    <div class="telephony-soft-phone__active-calls-list" data-telephony-active-calls-list></div>
                </div>

                <div class="telephony-soft-phone__transfer-panel" data-telephony-transfer-panel hidden>
                    <div class="telephony-soft-phone__transfer-title">@T["Transfer call"]</div>
                    <input type="tel"
                           class="telephony-soft-phone__transfer-input"
                           data-telephony-transfer-input
                           placeholder="@T["Number or extension"]"
                           aria-label="@T["Transfer destination"]" />
                    <div class="telephony-soft-phone__directory" data-telephony-directory hidden>
                        <div class="telephony-soft-phone__directory-heading">@T["Directory"]</div>
                        <div class="telephony-soft-phone__directory-list" data-telephony-directory-list></div>
                    </div>
                    <div class="telephony-soft-phone__transfer-actions">
                        <button type="button" class="btn btn-sm btn-secondary" data-telephony-transfer-cancel>@T["Cancel"]</button>
                        <button type="button" class="btn btn-sm btn-primary" data-telephony-transfer-confirm>@T["Transfer"]</button>
                    </div>
                </div>

                <div class="telephony-soft-phone__keypad" data-telephony-keypad-panel>
                    @foreach (var key in new[] { "1", "2", "3", "4", "5", "6", "7", "8", "9", "*", "0", "#" })
                    {
                        <button type="button" class="telephony-soft-phone__key" data-telephony-key="@key">@key</button>
                    }
                </div>

                <div class="telephony-soft-phone__actions">
                    <button type="button" class="telephony-soft-phone__btn telephony-soft-phone__btn--call" data-telephony-dial title="@T["Call"]">
                        <i class="fa-solid fa-phone"></i>
                    </button>
                    <button type="button" class="telephony-soft-phone__btn telephony-soft-phone__btn--hold" data-telephony-hold title="@T["Hold"]" hidden>
                        <i class="fa-solid fa-pause"></i>
                    </button>
                    <button type="button" class="telephony-soft-phone__btn telephony-soft-phone__btn--resume" data-telephony-resume title="@T["Resume"]" hidden>
                        <i class="fa-solid fa-play"></i>
                    </button>
                    <button type="button" class="telephony-soft-phone__btn telephony-soft-phone__btn--mute" data-telephony-mute title="@T["Mute"]" hidden>
                        <i class="fa-solid fa-microphone-slash"></i>
                    </button>
                    <button type="button" class="telephony-soft-phone__btn telephony-soft-phone__btn--unmute" data-telephony-unmute title="@T["Unmute"]" hidden>
                        <i class="fa-solid fa-microphone"></i>
                    </button>
                    <button type="button" class="telephony-soft-phone__btn telephony-soft-phone__btn--transfer" data-telephony-transfer title="@T["Transfer"]" hidden>
                        <i class="fa-solid fa-arrow-right-arrow-left" data-telephony-transfer-icon></i>
                        <span class="visually-hidden" data-telephony-transfer-label>@T["Transfer"]</span>
                    </button>
                    <button type="button" class="telephony-soft-phone__btn telephony-soft-phone__btn--merge" data-telephony-merge title="@T["Conference selected calls"]" hidden>
                        <i class="fa-solid fa-code-merge"></i>
                    </button>
                    <button type="button" class="telephony-soft-phone__btn telephony-soft-phone__btn--hangup-all" data-telephony-hangup-all title="@T["Disconnect all calls"]" hidden>
                        <i class="fa-solid fa-phone-volume"></i>
                    </button>
                    <button type="button" class="telephony-soft-phone__btn telephony-soft-phone__btn--hangup" data-telephony-hangup title="@T["Hang up"]" hidden>
                        <i class="fa-solid fa-phone-slash"></i>
                    </button>
                </div>
            </div>

            <div class="telephony-soft-phone__view telephony-soft-phone__history" data-telephony-view="history" data-telephony-history hidden>
                <div class="telephony-soft-phone__history-list" data-telephony-history-list></div>
            </div>

            <div class="telephony-soft-phone__view telephony-soft-phone__voicemail" data-telephony-view="voicemail" hidden>
                <div class="telephony-soft-phone__voicemail-player" data-telephony-voicemail-player hidden>
                    <div class="telephony-soft-phone__voicemail-player-info" data-telephony-voicemail-player-info></div>
                    <audio class="telephony-soft-phone__voicemail-audio" data-telephony-voicemail-audio controls preload="none"></audio>
                </div>
                <div class="telephony-soft-phone__voicemail-toolbar" data-telephony-voicemail-toolbar hidden>
                    <label class="telephony-soft-phone__voicemail-toolbar-select">
                        <input type="checkbox" data-telephony-voicemail-select-all aria-label="@T["Select all voicemails"]">
                        <span>@T["Select all"]</span>
                    </label>
                    <button type="button" class="telephony-soft-phone__voicemail-delete" data-telephony-voicemail-delete disabled>@T["Delete"]</button>
                </div>
                <div class="telephony-soft-phone__voicemail-list" data-telephony-voicemail-list></div>
            </div>

            @if (Model.Views != null)
            {
                @await DisplayAsync(Model.Views)
            }
        </div>

        <div class="telephony-soft-phone__footer" data-telephony-footer hidden>
            <button type="button" class="telephony-soft-phone__tab is-active" data-telephony-tab="keypad" aria-selected="true">
                <i class="fa-solid fa-grip"></i>
                <span>@T["Keypad"]</span>
            </button>
            <button type="button" class="telephony-soft-phone__tab" data-telephony-tab="history" aria-selected="false">
                <i class="fa-solid fa-clock-rotate-left"></i>
                <span>@T["Recent"]</span>
            </button>
            <button type="button" class="telephony-soft-phone__tab" data-telephony-tab="voicemail" aria-selected="false">
                <i class="fa-solid fa-voicemail"></i>
                <span>@T["Voicemail"]</span>
                <span class="telephony-soft-phone__tab-badge" data-telephony-voicemail-badge hidden aria-label="@T["Unread voicemails"]"></span>
            </button>
            @if (Model.Tabs != null)
            {
                @await DisplayAsync(Model.Tabs)
            }
        </div>
    </div>

    <div class="telephony-incoming" data-telephony-incoming hidden role="dialog" aria-modal="true" aria-label="@T["Incoming call"]">
        <div class="telephony-incoming__backdrop"></div>
        <div class="telephony-incoming__dialog">
            <div class="telephony-incoming__header">
                <span class="telephony-incoming__pulse"><i class="fa-solid fa-phone-volume"></i></span>
                <div class="telephony-incoming__heading">
                    <span class="telephony-incoming__label">@T["Incoming call"]</span>
                    <span class="telephony-incoming__caller" data-telephony-incoming-caller></span>
                    <span class="telephony-incoming__queue" data-telephony-incoming-queue hidden></span>
                </div>
            </div>

            <div class="telephony-incoming__cards" data-telephony-incoming-cards hidden></div>

            <div class="telephony-incoming__actions">
                <button type="button" class="btn btn-success telephony-incoming__btn" data-telephony-incoming-answer>
                    <i class="fa-solid fa-phone"></i> @T["Answer"]
                </button>
                <button type="button" class="btn btn-warning telephony-incoming__btn" data-telephony-incoming-voicemail hidden>
                    <i class="fa-solid fa-voicemail"></i> @T["Voicemail"]
                </button>
                <button type="button" class="btn btn-danger telephony-incoming__btn" data-telephony-incoming-ignore>
                    <i class="fa-solid fa-phone-slash"></i> @T["Ignore"]
                </button>
            </div>
        </div>
    </div>
</div>
