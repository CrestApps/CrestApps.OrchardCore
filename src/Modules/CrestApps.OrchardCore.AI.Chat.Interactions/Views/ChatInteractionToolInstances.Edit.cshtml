@using CrestApps.OrchardCore.AI.ViewModels

@model EditToolInstancesViewModel

@if (Model.Instances is null || Model.Instances.Length == 0)
{
    return;
}

<div class="mb-3">

    <h5 class="border-bottom pb-2">@T["Tool Instances"]</h5>

    <span class="hint mb-2 d-block">@T["Configured tool instances the AI model may call. Each selected instance is exposed as its own function."]</span>

    @for (var i = 0; i < Model.Instances.Length; i++)
    {
        <div class="form-check">
            <input type="hidden" asp-for="@Model.Instances[i].Name" />
            <input asp-for="@Model.Instances[i].IsSelected" type="checkbox" class="form-check-input" id="chat-interaction-tool-instance-@i" />
            <label class="form-check-label" for="chat-interaction-tool-instance-@i">@Model.Instances[i].Name</label>
            <span class="hint dashed">@Model.Instances[i].Description</span>
        </div>
    }
</div>
