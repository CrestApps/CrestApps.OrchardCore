@using System.Text.Json
@using CrestApps.Core.AI.Deployments
@using CrestApps.Core.AI.Models
@using CrestApps.OrchardCore.AI.Chat.Interactions.Core
@using CrestApps.OrchardCore.AI.Chat.Interactions.ViewModels
@using Microsoft.AspNetCore.Antiforgery

@model ProfileBuilderSessionViewModel

@inject IAIDeploymentManager DeploymentManager
@inject IAntiforgery Antiforgery

@{
    var coachDeployments = (await DeploymentManager.GetAllBySlotAsync(AIDeploymentSlotNames.Chat))
        .Where(deployment => !string.IsNullOrWhiteSpace(deployment.Name))
        .OrderBy(deployment => deployment.Name, StringComparer.CurrentCultureIgnoreCase)
        .ToArray();

    var linkedProfileTitle = Model.Profile is null ? null : (Model.Profile.DisplayText ?? Model.Profile.Name);

    var config = JsonSerializer.Serialize(new
    {
        sessionId = Model.Session.ItemId,
        antiforgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken,
        urls = new
        {
            state = Url.Action("State", "ProfileBuilder", new { area = ChatInteractionsConstants.Feature.ChatInteractions, id = Model.Session.ItemId }),
            feedback = Url.Action("Feedback", "ProfileBuilder", new { area = ChatInteractionsConstants.Feature.ChatInteractions, id = Model.Session.ItemId }),
            restore = Url.Action("Restore", "ProfileBuilder", new { area = ChatInteractionsConstants.Feature.ChatInteractions, id = Model.Session.ItemId }),
            replay = Url.Action("Replay", "ProfileBuilder", new { area = ChatInteractionsConstants.Feature.ChatInteractions, id = Model.Session.ItemId }),
            settings = Url.Action("Settings", "ProfileBuilder", new { area = ChatInteractionsConstants.Feature.ChatInteractions, id = Model.Session.ItemId }),
            saveProfile = Url.Action("SaveProfile", "ProfileBuilder", new { area = ChatInteractionsConstants.Feature.ChatInteractions, id = Model.Session.ItemId }),
            simulationSettings = Url.Action("SimulationSettings", "ProfileBuilder", new { area = ChatInteractionsConstants.Feature.ChatInteractions, id = Model.Session.ItemId }),
            simulate = Url.Action("Simulate", "ProfileBuilder", new { area = ChatInteractionsConstants.Feature.ChatInteractions, id = Model.Session.ItemId }),
        },
        linkedProfileTitle,
        strings = new
        {
            selectReply = T["Choose Feedback under a reply to comment on it."].Value,
            commentRequired = T["Write what you would like the assistant to do differently."].Value,
            working = T["Rewriting the instructions..."].Value,
            regenerating = T["Instructions updated. Regenerating the reply..."].Value,
            updated = T["Instructions updated."].Value,
            approved = T["Marked as a good reply."].Value,
            approvedBadge = T["Looks good"].Value,
            feedbackBadge = T["Feedback"].Value,
            rejectedBadge = T["Rejected"].Value,
            noFeedback = T["No feedback yet. Role-play a few turns, then give feedback on a reply."].Value,
            noRevisions = T["No revisions yet."].Value,
            noReplay = T["No replay has run yet."].Value,
            replaying = T["Replaying..."].Value,
            restoreConfirm = T["Make revision {0} the current instructions?"].Value,
            restored = T["Revision restored."].Value,
            voiceNotice = T["The instructions changed. End and restart the voice conversation to use them."].Value,
            regenerateOnlyLatest = T["Only the latest reply can be regenerated."].Value,
            saved = T["Saved."].Value,
            error = T["Something went wrong. Try again."].Value,
            copied = T["Copied."].Value,
            current = T["current"].Value,
            pass = T["Pass"].Value,
            fail = T["Fail"].Value,
            unknown = T["Unclear"].Value,
            revision = T["Revision {0}"].Value,
            noSimulations = T["No simulation has run yet."].Value,
            scenarioRequired = T["Describe at least one customer to play."].Value,
            simulating = T["Round {0}: the customers are talking to the assistant..."].Value,
            simulationImproved = T["Round {0} found problems. The coach wrote revision {1}; testing it next..."].Value,
            simulationPassed = T["Every conversation passed in round {0}."].Value,
            simulationFinished = T["The run is over after round {0}. Read the judge's findings below, or run it again."].Value,
            simulationStopped = T["Stopped after round {0}."].Value,
            round = T["Round {0}"].Value,
            score = T["Score {0}"].Value,
            transcript = T["Conversation"].Value,
            customer = T["Customer"].Value,
            assistant = T["Assistant"].Value,
            sources = new
            {
                Initial = T["Start"].Value,
                Feedback = T["Feedback"].Value,
                Manual = T["Manual edit"].Value,
                Restore = T["Restore"].Value,
                Simulation = T["Simulation"].Value,
            },
            kinds = new
            {
                Feedback = T["Feedback"].Value,
                FeedbackAndRegenerate = T["Feedback and regenerate"].Value,
                Approved = T["Looks good"].Value,
            },
        },
    });
}

<zone Name="Title">
    <breadcrumb name="AIProfileBuilderSession" title="@T["Profile Builder: {0}", Model.DisplayName]">
        <breadcrumb-item id="AIProfileBuilder" action="Index" controller="ProfileBuilder" area="@ChatInteractionsConstants.Feature.ChatInteractions" permission="@AIPermissions.ManageAIProfiles.Name">@T["Profile Builder"]</breadcrumb-item>
    </breadcrumb>
</zone>

<div class="container-fluid px-0 profile-builder-container">
    <div class="d-flex flex-column flex-xl-row h-100 gap-3">
        <div class="chat-parameters-panel flex-shrink-0 bg-theme border rounded">
            <div class="d-flex justify-content-between align-items-center p-2 pb-0">
                <span class="fw-semibold">@T["Settings"]</span>
                <span id="settings-save-indicator" class="settings-save-indicator text-muted" data-chat-interaction-save-indicator></span>
            </div>
            <div class="chat-parameters-content p-3 pt-2">
                @await DisplayAsync(Model.Editor.Parameters)
            </div>
        </div>

        <div class="d-flex flex-column flex-grow-1 chat-content-area">
            <div class="chat-main-area flex-grow-1 d-flex flex-column min-h-0">
                @await DisplayAsync(Model.Editor.Content)
            </div>
        </div>

        <div class="profile-builder-panel flex-shrink-0 bg-theme border rounded d-flex flex-column" id="profile-builder-panel" data-profile-builder-config="@config">
            <div class="d-flex justify-content-between align-items-center p-2 pb-0">
                <span class="fw-semibold">@T["Builder"]</span>
            </div>
            <div class="profile-builder-content p-3 pt-2 flex-grow-1 overflow-y-auto">
                <ul class="nav nav-tabs flex-column flex-md-row" role="tablist">
                    <li class="nav-item pe-md-2" role="presentation">
                        <button class="nav-item nav-link active" id="pb-tab-feedback" data-bs-toggle="tab" data-bs-target="#pb-pane-feedback" type="button" role="tab" aria-controls="pb-pane-feedback" aria-selected="true">@T["Feedback"]</button>
                    </li>
                    <li class="nav-item pe-md-2" role="presentation">
                        <button class="nav-item nav-link" id="pb-tab-revisions" data-bs-toggle="tab" data-bs-target="#pb-pane-revisions" type="button" role="tab" aria-controls="pb-pane-revisions" aria-selected="false">@T["Revisions"]</button>
                    </li>
                    <li class="nav-item pe-md-2" role="presentation">
                        <button class="nav-item nav-link" id="pb-tab-simulate" data-bs-toggle="tab" data-bs-target="#pb-pane-simulate" type="button" role="tab" aria-controls="pb-pane-simulate" aria-selected="false">@T["Simulate"]</button>
                    </li>
                    <li class="nav-item pe-md-2" role="presentation">
                        <button class="nav-item nav-link" id="pb-tab-replay" data-bs-toggle="tab" data-bs-target="#pb-pane-replay" type="button" role="tab" aria-controls="pb-pane-replay" aria-selected="false">@T["Replay"]</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-item nav-link" id="pb-tab-finish" data-bs-toggle="tab" data-bs-target="#pb-pane-finish" type="button" role="tab" aria-controls="pb-pane-finish" aria-selected="false">@T["Finish"]</button>
                    </li>
                </ul>

                <div class="tab-content">
                    <div class="tab-pane fade show active" id="pb-pane-feedback" role="tabpanel" aria-labelledby="pb-tab-feedback">
                        <div class="mb-3">
                            <div class="form-label fw-semibold">@T["Reply"]</div>
                            <div class="profile-builder-selected border rounded p-2 small text-muted" id="pb-selected-reply">@T["Choose Feedback under a reply to comment on it."]</div>
                        </div>
                        <div class="mb-2">
                            <label for="pb-comment" class="form-label fw-semibold">@T["Your feedback"]</label>
                            <textarea id="pb-comment" class="form-control" rows="4" placeholder="@T["What should the assistant have done differently?"]"></textarea>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mb-2">
                            <button type="button" class="btn btn-primary" id="pb-send-regenerate" disabled title="@T["Rewrite the instructions, then generate this reply again with them"]">
                                <i class="fa-solid fa-rotate me-1" aria-hidden="true"></i>@T["Feedback & regenerate"]
                            </button>
                            <button type="button" class="btn btn-outline-primary" id="pb-send-feedback" disabled title="@T["Rewrite the instructions and keep this reply"]">
                                @T["Feedback only"]
                            </button>
                        </div>
                        <div class="small mb-3" id="pb-status" role="status" aria-live="polite"></div>

                        <div class="fw-semibold mb-2">@T["Feedback so far"]</div>
                        <div id="pb-feedback-list" class="d-flex flex-column gap-2 small"></div>
                    </div>

                    <div class="tab-pane fade" id="pb-pane-revisions" role="tabpanel" aria-labelledby="pb-tab-revisions">
                        <p class="small text-muted">@T["Every change to the instructions is kept here. Restore one to make it current again."]</p>
                        <div id="pb-revision-list" class="d-flex flex-column gap-2 small"></div>
                    </div>

                    <div class="tab-pane fade" id="pb-pane-simulate" role="tabpanel" aria-labelledby="pb-tab-simulate">
                        <p class="small text-muted">@T["One model plays each customer below against the current instructions, tools included, and another model judges every conversation. When one fails, the coach rewrites the instructions from what the judge found, and the next round tests the new revision, until every conversation passes or the rounds run out."]</p>
                        <div class="mb-2">
                            <label for="pb-sim-scenarios" class="form-label fw-semibold">@T["Customers to play"]</label>
                            <textarea id="pb-sim-scenarios" class="form-control" rows="6" placeholder="@T["Who the customer is, what they want and how they behave. Leave a blank line between customers. For example: Dana is angry that her order 1001 is a week late, and wants a refund."]"></textarea>
                            <span class="hint dashed">@T["Up to five customers, separated by a blank line."]</span>
                        </div>
                        <div class="mb-2">
                            <label for="pb-sim-criteria" class="form-label fw-semibold">@T["What every conversation must achieve"]</label>
                            <textarea id="pb-sim-criteria" class="form-control" rows="3" placeholder="@T["One per line. For example: Confirms the order number before acting on it."]"></textarea>
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label for="pb-sim-customer-deployment" class="form-label small fw-semibold">@T["Customer model"]</label>
                                <select id="pb-sim-customer-deployment" class="form-select form-select-sm">
                                    <option value="">@T["Utility deployment"]</option>
                                    @foreach (var deployment in coachDeployments)
                                    {
                                        <option value="@deployment.Name">@deployment.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-6">
                                <label for="pb-sim-judge-deployment" class="form-label small fw-semibold">@T["Judge model"]</label>
                                <select id="pb-sim-judge-deployment" class="form-select form-select-sm">
                                    <option value="">@T["Utility deployment"]</option>
                                    @foreach (var deployment in coachDeployments)
                                    {
                                        <option value="@deployment.Name">@deployment.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-4">
                                <label for="pb-sim-turns" class="form-label small fw-semibold">@T["Turns"]</label>
                                <input id="pb-sim-turns" type="number" min="1" max="20" class="form-control form-control-sm" />
                            </div>
                            <div class="col-4">
                                <label for="pb-sim-rounds" class="form-label small fw-semibold">@T["Rounds"]</label>
                                <input id="pb-sim-rounds" type="number" min="1" max="5" class="form-control form-control-sm" />
                            </div>
                            <div class="col-4">
                                <label for="pb-sim-passing-score" class="form-label small fw-semibold">@T["Passing score"]</label>
                                <input id="pb-sim-passing-score" type="number" min="0" max="100" class="form-control form-control-sm" />
                            </div>
                        </div>
                        <div class="form-check mb-2">
                            <input type="checkbox" class="form-check-input" id="pb-sim-improve" />
                            <label class="form-check-label" for="pb-sim-improve">@T["Rewrite the instructions when a conversation fails"]</label>
                            <span class="hint dashed">@T["The assistant answers with its own deployment, so three models take part: the assistant, the customer and the judge, and the coach rewrites. Use different models for the customer and the judge for a fairer test."]</span>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mb-2">
                            <button type="button" class="btn btn-primary" id="pb-sim-run">
                                <i class="fa-solid fa-people-arrows me-1" aria-hidden="true"></i>@T["Run simulation"]
                            </button>
                            <button type="button" class="btn btn-outline-secondary d-none" id="pb-sim-stop">@T["Stop after this round"]</button>
                        </div>
                        <div class="small mb-3" id="pb-sim-status" role="status" aria-live="polite"></div>
                        <div id="pb-sim-results" class="d-flex flex-column gap-2 small"></div>
                    </div>

                    <div class="tab-pane fade" id="pb-pane-replay" role="tabpanel" aria-labelledby="pb-tab-replay">
                        <p class="small text-muted">@T["Replay answers every message you gave feedback on again with the current instructions, and checks each answer against that feedback. Tools are not used during a replay."]</p>
                        <button type="button" class="btn btn-primary mb-3" id="pb-replay">
                            <i class="fa-solid fa-flask me-1" aria-hidden="true"></i>@T["Run replay"]
                        </button>
                        <div id="pb-replay-results" class="d-flex flex-column gap-2 small"></div>
                    </div>

                    <div class="tab-pane fade" id="pb-pane-finish" role="tabpanel" aria-labelledby="pb-tab-finish">
                        <div class="mb-3">
                            <label for="pb-initial-prompt" class="form-label fw-semibold">@T["Opening message"]</label>
                            <textarea id="pb-initial-prompt" class="form-control" rows="3" placeholder="@T["Optional. What the assistant is told when it starts a conversation itself, such as an automated SMS or call."]">@Model.Session.InitialPrompt</textarea>
                            <div class="d-flex gap-2 mt-2">
                                <button type="button" class="btn btn-sm btn-outline-secondary" id="pb-send-opening" title="@T["Send the opening message to see how the assistant opens a conversation"]">@T["Try the opening"]</button>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="pb-coach-deployment" class="form-label fw-semibold">@T["Coach deployment"]</label>
                            <select id="pb-coach-deployment" class="form-select">
                                <option value="">@T["Same as the chat deployment"]</option>
                                @foreach (var deployment in coachDeployments)
                                {
                                    <option value="@deployment.Name" selected="@(string.Equals(deployment.Name, Model.Session.CoachDeploymentName, StringComparison.OrdinalIgnoreCase))">@deployment.Name</option>
                                }
                            </select>
                            <span class="hint dashed">@T["The model that reads your feedback and rewrites the instructions. A capable model gives better rewrites."]</span>
                        </div>
                        <button type="button" class="btn btn-sm btn-secondary mb-4" id="pb-save-settings">@T["Save"]</button>

                        <hr />

                        <div class="fw-semibold mb-2">@T["Use the result"]</div>
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="pb-copy-system-message">
                                <i class="fa-regular fa-copy me-1" aria-hidden="true"></i>@T["Copy system message"]
                            </button>
                        </div>

                        @if (Model.Profile is not null)
                        {
                            <div class="border rounded p-2 mb-3">
                                <div class="small mb-2">@T["This session is linked to the AI profile <strong>{0}</strong>.", linkedProfileTitle]</div>
                                <button type="button" class="btn btn-primary btn-sm" id="pb-update-profile">@T["Update the AI profile"]</button>
                            </div>
                        }

                        <div class="border rounded p-2">
                            <div class="small fw-semibold mb-2">@T["Save as a new AI profile"]</div>
                            <div class="mb-2">
                                <label for="pb-profile-display-text" class="form-label small ocat-label-required">@T["Title"]</label>
                                <input id="pb-profile-display-text" class="form-control form-control-sm" value="@Model.DisplayName" />
                            </div>
                            <div class="mb-2">
                                <label for="pb-profile-name" class="form-label small ocat-label-required">@T["Technical name"]</label>
                                <input id="pb-profile-name" class="form-control form-control-sm" />
                            </div>
                            <button type="button" class="btn btn-primary btn-sm" id="pb-create-profile">@T["Create AI profile"]</button>
                        </div>
                        <div class="small mt-2" id="pb-finish-status" role="status" aria-live="polite"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style at="Head">
    .profile-builder-container {
        min-height: calc(100vh - var(--oc-top-nav-height, 0) - 1rem - 65px - 2.25rem);
    }
    .profile-builder-container .chat-parameters-panel,
    .profile-builder-container .profile-builder-panel {
        width: 100%;
        max-height: 70vh;
    }
    .profile-builder-container .chat-parameters-content {
        overflow-y: auto;
        flex: 1;
        min-height: 0;
    }
    .profile-builder-container .chat-content-area {
        min-height: 480px;
        flex: 1;
    }
    .profile-builder-container .chat-main-area {
        min-height: 420px;
        overflow: hidden;
    }
    .profile-builder-container .min-h-0 {
        min-height: 0;
    }
    .profile-builder-content .tab-pane {
        padding-bottom: 1rem;
    }
    .profile-builder-selected {
        max-height: 10rem;
        overflow-y: auto;
        white-space: pre-wrap;
    }
    .profile-builder-item {
        border-left: 3px solid var(--bs-border-color);
        padding-left: 0.5rem;
    }
    .profile-builder-item.is-approved {
        border-left-color: var(--bs-success);
    }
    .profile-builder-item.is-rejected {
        border-left-color: var(--bs-danger);
    }
    .profile-builder-item.is-feedback {
        border-left-color: var(--bs-warning);
    }
    .ai-chat-message-item.profile-builder-selected-message {
        outline: 2px solid var(--bs-primary);
        outline-offset: 4px;
        border-radius: 0.375rem;
    }
    .profile-builder-quote {
        white-space: pre-wrap;
        max-height: 6rem;
        overflow: hidden;
    }
    .settings-save-indicator {
        min-width: 5rem;
        font-size: 0.8rem;
        font-weight: 600;
        text-align: center;
    }

    @@media (min-width: 1200px) {
        .profile-builder-container {
            height: calc(100vh - var(--oc-top-nav-height, 0) - 1rem - 65px - 2.25rem);
        }
        .profile-builder-container .chat-parameters-panel {
            width: 20rem;
            max-height: none;
            height: 100%;
            display: flex;
            flex-direction: column;
        }
        .profile-builder-container .profile-builder-panel {
            width: 26rem;
            max-height: none;
            height: 100%;
        }
        .profile-builder-container .chat-content-area,
        .profile-builder-container .chat-main-area {
            min-height: 0;
        }
    }
</style>

<script asp-name="ProfileBuilderApp" at="Foot"></script>
