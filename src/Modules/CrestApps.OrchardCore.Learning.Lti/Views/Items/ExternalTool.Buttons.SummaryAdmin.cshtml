@model ShapeViewModel<ExternalTool>

<a asp-action="Edit"
   asp-route-id="@Model.Value.ItemId"
   class="btn btn-primary btn-sm">@T["Edit"]</a>
<a asp-action="Delete"
   asp-route-id="@Model.Value.ItemId"
   class="btn btn-danger btn-sm"
   data-title="@T["Delete"]"
   data-message="@T["Are you sure you want to remove this tool? Its course items stop launching, and its OpenID application is removed."]"
   data-url-af="RemoveUrl UnsafeUrl">@T["Delete"]</a>
