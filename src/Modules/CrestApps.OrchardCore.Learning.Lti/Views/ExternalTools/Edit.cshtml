@model EditCatalogEntryViewModel

<zone Name="Title">
    <breadcrumb name="LearningExternalToolsEdit" title="@T["Edit {0}", Model.DisplayName]">
        <breadcrumb-item id="LearningExternalTools" action="Index" controller="ExternalTools" area="CrestApps.OrchardCore.Learning.Lti" permission="@LearningLtiPermissions.ManageExternalTools.Name">@T["External tools"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form method="post" class="no-multisubmit">
    @Html.ValidationSummary()
    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <button class="btn btn-primary" type="submit">@T["Save"]</button>
        <a class="btn btn-secondary cancel" role="button" asp-route-action="Index">@T["Cancel"]</a>
    </div>
</form>
