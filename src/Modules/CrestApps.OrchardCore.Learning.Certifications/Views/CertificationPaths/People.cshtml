@model CertificationPathPeopleViewModel

<zone Name="Title">
    <breadcrumb name="LearningCertificationPathPeople" title="@T["People on the '{0}' Path", Model.CertificationName ?? string.Empty]">
        <breadcrumb-item id="Certifications" action="Index" controller="Certifications" area="CrestApps.OrchardCore.Skills">@T["Certification Types"]</breadcrumb-item>
    </breadcrumb>
</zone>

<div class="card text-bg-theme mb-3 position-sticky action-bar">
    <div class="card-body">
        <div class="row gx-2 align-items-center">
            <div class="col">
                <form method="get" asp-action="People" asp-route-id="@Model.Path.ItemId" class="d-flex gap-2">
                    <select name="state" asp-items="Model.StateOptions" class="form-select" style="max-width: 14rem" onchange="this.form.submit()" aria-label="@T["State"]">
                        <option value="">@T["Every state"]</option>
                    </select>
                </form>
            </div>
            <div class="col-auto">
                <form method="post" asp-action="Start" asp-route-id="@Model.Path.ItemId" class="d-flex gap-2">
                    <input name="userName" class="form-control" placeholder="@T["User name"]" aria-label="@T["User name"]" required />
                    <button type="submit" class="btn btn-secondary text-nowrap">@T["Start on the Path"]</button>
                </form>
            </div>
        </div>
    </div>
</div>

<admin-list name="LearningCertificationPathPeople" context="Model.List" show-select-all="false" empty-message="@T["<strong>Nothing here!</strong> Nobody is on this path yet. People join it by meeting a requirement, or when you start them."]">
    <admin-list-list item-css-class="list-group-item" />
    <admin-list-grid>
        <admin-list-column name="Name" position="20" title="@T["Person"]" />
        <admin-list-column name="State" position="30" title="@T["State"]" width="auto" />
        <admin-list-column name="Dates" position="40" title="@T["Certificate"]" width="auto" />
        <admin-list-column type="Actions" title="@T["Actions"]" />
    </admin-list-grid>
</admin-list>
