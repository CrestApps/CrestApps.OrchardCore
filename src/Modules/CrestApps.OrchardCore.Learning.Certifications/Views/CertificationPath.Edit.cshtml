@model CertificationPathViewModel

<div class="ocat-wrapper"><div class="ocat-end-offset"><div class="form-check"><input asp-for="Earned" class="form-check-input" /><label asp-for="Earned" class="form-check-label">@T["People earn this certification by completing courses and passing assessments"]</label><span class="hint dashed">@T["The site issues the certificate when the requirements are met, with a verification page, and opens renewal before it expires."]</span></div></div></div>
<div class="ocat-wrapper"><div class="ocat-end-offset"><div class="form-check"><input asp-for="Enabled" class="form-check-input" /><label asp-for="Enabled" class="form-check-label">@T["Issue certificates now"]</label><span class="hint dashed">@T["Turn off to stop issuing while you change the requirements; the people on the path keep their place."]</span></div></div></div>
<div class="ocat-wrapper"><div class="ocat-end-offset"><div class="form-check"><input asp-for="StartsOnFirstRequirement" class="form-check-input" /><label asp-for="StartsOnFirstRequirement" class="form-check-label">@T["Meeting a requirement starts the path"]</label><span class="hint dashed">@T["Otherwise a manager starts people on the path by hand. Completions before the path existed never start it on their own."]</span></div></div></div>

@if (!string.IsNullOrEmpty(Model.PathId))
{
    <div class="ocat-wrapper"><div class="ocat-end-offset">
        <a class="btn btn-sm btn-outline-secondary" asp-controller="CertificationPaths" asp-action="People" asp-route-id="@Model.PathId" asp-route-area="CrestApps.OrchardCore.Learning.Certifications"><i class="fa-solid fa-users" aria-hidden="true"></i> @T["People on This Path"]</a>
    </div></div>
}
