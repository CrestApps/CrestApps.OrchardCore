@using CrestApps.OrchardCore.Learning.Certifications.Workflows

@model CertificationPathEventViewModel

<style asp-name="bootstrap-select"></style>
<script asp-name="bootstrap-select" depends-on="bootstrap" at="Foot"></script>
<div class="mb-3">
    <label asp-for="CertificationIds" class="form-label">@T["Certifications"]</label>
    <select asp-for="CertificationIds" asp-items="Model.CertificationOptions" class="selectpicker show-tick" multiple data-live-search="true" data-actions-box="true" data-width="100%" data-selected-text-format="count > 3"></select>
    <span class="hint">@T["Leave empty for every certification. The workflow input holds ProgressId, PathId, CertificationId, UserId, Cycle, CertificationRecordId and ExpiresOn."]</span>
</div>
