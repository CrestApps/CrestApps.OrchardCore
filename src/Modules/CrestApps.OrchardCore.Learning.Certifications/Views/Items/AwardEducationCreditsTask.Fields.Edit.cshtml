@using CrestApps.OrchardCore.Learning.Certifications.Workflows

@model AwardEducationCreditsTaskViewModel

<div class="mb-3">
    <label asp-for="CreditType" class="form-label">@T["Credit type"]</label>
    <input asp-for="CreditType" class="form-control code" />
    <span class="hint">@T["The credit type, by name or id. Liquid is allowed."]</span>
</div>
<div class="mb-3">
    <label asp-for="UserId" class="form-label">@T["User id"]</label>
    <input asp-for="UserId" class="form-control code" />
    <span class="hint">@T["The person, such as {{ Workflow.Input.UserId }}."]</span>
</div>
<div class="mb-3">
    <label asp-for="Amount" class="form-label">@T["Credits"]</label>
    <input asp-for="Amount" class="form-control code" />
</div>
<div class="mb-3">
    <label asp-for="SourceId" class="form-label">@T["Source id"]</label>
    <input asp-for="SourceId" class="form-control code" />
    <span class="hint">@T["What the credits are for, such as {{ Workflow.Input.ContentItemId }}. The same source id awards each person once; the task ends with Already awarded when it posted nothing new."]</span>
</div>
