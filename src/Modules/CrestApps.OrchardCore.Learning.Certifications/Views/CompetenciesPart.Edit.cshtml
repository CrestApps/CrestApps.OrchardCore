@model CompetenciesPartViewModel

<style asp-name="bootstrap-select"></style>
<script asp-name="bootstrap-select" depends-on="bootstrap" at="Foot"></script>

<div class="card text-bg-theme mb-3">
    <div class="card-header">@T["Competencies"]</div>
    <div class="card-body">
        @if (Model.Skills.Count == 0)
        {
            <p class="hint">@T["Add skills under Content > Skills first, or import a competency framework there. A competency framework is a skill category."]</p>
        }
        else
        {
            <div class="mb-3">
                <label asp-for="SkillIds" class="form-label">@T["Competencies granted on completion"]</label>
                <select asp-for="SkillIds" asp-items="Model.Skills" class="selectpicker show-tick" multiple data-live-search="true" data-width="100%" data-selected-text-format="count > 3" data-live-search-placeholder="@T["Search competencies"]" title="@T["Choose competencies"]"></select>
                <span class="hint">@T["Listed by framework (the skill category). Granted when a learner completes it and the completion counts as evidence: not failed, not under review, and not resting on a result the browser reported."]</span>
            </div>
            <div class="mb-3">
                <label asp-for="Proficiency" class="form-label">@T["Level granted"]</label>
                <select asp-for="Proficiency" class="form-select">
                    <option value="1">@T["1 - Trainee"]</option>
                    <option value="2">@T["2 - Basic"]</option>
                    <option value="3">@T["3 - Competent"]</option>
                    <option value="4">@T["4 - Advanced"]</option>
                    <option value="5">@T["5 - Expert"]</option>
                </select>
                <span class="hint">@T["A learner who already holds a competency at this level or higher keeps their level."]</span>
            </div>
        }
    </div>
</div>
