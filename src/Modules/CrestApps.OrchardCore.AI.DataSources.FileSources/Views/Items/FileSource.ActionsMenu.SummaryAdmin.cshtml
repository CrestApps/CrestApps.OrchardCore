@using CrestApps.Core.AI.Models
@using OrchardCore.DisplayManagement.Views

@model ShapeViewModel<WebCrawler>

<li>
    <a asp-action="Run"
       asp-controller="FileSources"
       asp-area="CrestApps.OrchardCore.AI.DataSources.FileSources"
       asp-route-id="@Model.Value.ItemId"
       class="dropdown-item"
       data-url-af="UnsafeUrl"
       data-title="@T["Read now"]"
       data-message="@T["Are you sure you want to read this source now and ingest whatever is new or changed?"]"
       data-ok-text="@T["Yes"]"
       data-cancel-text="@T["Cancel"]">@T["Read now"]</a>
</li>

<li>
    <a asp-action="Delete"
       asp-controller="FileSources"
       asp-area="CrestApps.OrchardCore.AI.DataSources.FileSources"
       asp-route-id="@Model.Value.ItemId"
       class="dropdown-item text-danger"
       data-url-af="RemoveUrl UnsafeUrl"
       data-title="@T["Delete"]"
       data-message="@T["Are you sure you want to delete this file source? The knowledge it produced is removed with it."]"
       data-ok-text="@T["Yes"]"
       data-cancel-text="@T["Cancel"]">@T["Delete"]</a>
</li>
