<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <Title>CrestApps OrchardCore AI Data Sources - File Sources</Title>
    <Description>
      $(CrestAppsDescription)

      Adds a File AI data source populated by file sources. A file source reads a folder or a file server on a schedule and stores each file's text, figures, charts and tables as separately retrievable knowledge. Ships the file-system connector; FTP and SFTP are separate features so a tenant that reads only its own folders never loads their libraries.
    </Description>
    <PackageTags>$(PackageTags) OrchardCoreCMS AI DataSources RAG FileSources Ingestion</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrestApps.OrchardCore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OrchardCore.Module.Targets" />
    <PackageReference Include="OrchardCore.DisplayManagement" />
    <PackageReference Include="OrchardCore.Navigation.Core" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CrestApps.Core.AI.FileSources" />
    <PackageReference Include="CrestApps.Core.Data.YesSql" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Ensure this module directly depends on the AI Data Sources module so that enabling it also enables
      the Data Sources feature this module extends, without any manual step.
    -->
    <ProjectReference Include="../CrestApps.OrchardCore.AI.DataSources/CrestApps.OrchardCore.AI.DataSources.csproj" PrivateAssets="none" />

    <!--
      Ingestion is document processing. Without this the run service has no IKnowledgeIngestionService to
      resolve and the feature throws the moment a file source runs.
    -->
    <ProjectReference Include="../CrestApps.OrchardCore.AI.Documents/CrestApps.OrchardCore.AI.Documents.csproj" PrivateAssets="none" />
  </ItemGroup>

</Project>
