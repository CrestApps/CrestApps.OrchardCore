<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <Title>CrestApps OrchardCore AI WebMCP Module</Title>
    <Description>
      $(CrestAppsDescription)

      Gives selected AI tools and page tools to AI agents in the browser through WebMCP, and lets the AI chat call the tools on the user's page.
    </Description>
    <PackageTags>$(PackageTags) OrchardCoreCMS AI MCP WebMCP ModelContextProtocol</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OrchardCore.Module.Targets" />
    <PackageReference Include="OrchardCore.Settings.Core" />
    <PackageReference Include="OrchardCore.DisplayManagement" />
    <PackageReference Include="OrchardCore.ResourceManagement" />
    <PackageReference Include="OrchardCore.Admin.Abstractions" />
    <PackageReference Include="OrchardCore.Navigation.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Abstractions/CrestApps.OrchardCore.Abstractions/CrestApps.OrchardCore.Abstractions.csproj" />
    <ProjectReference Include="../../Core/CrestApps.OrchardCore.Core/CrestApps.OrchardCore.Core.csproj" />
    <ProjectReference Include="../../Core/CrestApps.OrchardCore.AI.Core/CrestApps.OrchardCore.AI.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Reference the modules this one depends on directly, so installing this package brings the features it needs
      and the feature dependencies resolve.
    -->
    <ProjectReference Include="../CrestApps.OrchardCore.AI/CrestApps.OrchardCore.AI.csproj" PrivateAssets="none" />
    <ProjectReference Include="../CrestApps.OrchardCore.AI.Chat/CrestApps.OrchardCore.AI.Chat.csproj" PrivateAssets="none" />
  </ItemGroup>

</Project>
