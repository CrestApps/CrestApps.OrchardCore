@model CrestApps.OrchardCore.WorkOrders.Workflows.WorkOrderEventActivityViewModel

<style asp-name="bootstrap-select"></style>
<script asp-name="bootstrap-select" depends-on="bootstrap" at="Foot"></script>
<div class="ocat-wrapper">
    <label class="ocat-label" asp-for="TypeIds">@T["Work order types"]</label>
    <div class="ocat-end">
        <select class="selectpicker show-tick" asp-for="TypeIds" asp-items="Model.TypeOptions" multiple data-live-search="true" data-actions-box="true" data-width="100%" data-selected-text-format="count > 3"></select>
        <span class="hint">@T["Leave empty to start for every type."]</span>
    </div>
</div>
