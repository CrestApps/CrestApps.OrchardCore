@using CrestApps.OrchardCore.WorkOrders.Agreements.ViewModels
@model ServiceAgreementsListViewModel

<zone Name="Title"><breadcrumb name="ServiceAgreements" title="@T["Service Agreements"]" /></zone>

<form asp-action="Index" method="get" id="agreements-filter">
    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2 gy-2 align-items-center">
                <div class="col-12 col-md">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></span>
                        <input asp-for="Q" class="form-control" placeholder="@T["Search by number, name, customer or company"]" aria-label="@T["Search service agreements"]" />
                    </div>
                </div>
                <div class="col-auto"><a asp-action="Edit" class="btn btn-secondary create">@T["Add service agreement"]</a></div>
            </div>
        </div>
    </div>
</form>
@{
    Model.List.ToolbarActions = await New.ServiceAgreementsFilter(ViewModel: Model, FormId: "agreements-filter");
}

<admin-list name="ServiceAgreements" context="Model.List" show-select-all="false" empty-message="@T["<strong>Nothing here!</strong> Add a service agreement for a customer's recurring visits, such as a furnace service every 6 months."]">
    <admin-list-list item-css-class="list-group-item" />
    <admin-list-grid>
        <admin-list-column name="Name" position="20" title="@T["Agreement"]" />
        <admin-list-column name="Details" position="30" title="@T["Details"]" width="auto" />
        <admin-list-column type="Actions" title="@T["Actions"]" />
    </admin-list-grid>
</admin-list>
