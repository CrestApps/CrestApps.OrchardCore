@model WorkOrderSettingsListViewModel

@{
    var lists = new[]
    {
        (Kind: WorkOrderSettingsController.Types, Title: T["Work Order Types"], Intro: T["Kinds of job, with what each new work order starts with: its duration, priority, checklists, lines, service level and billing."], Add: T["Add work order type"], Search: T["Search work order types"], Empty: T["<strong>Nothing here!</strong> Add a work order type, such as Repair or Installation, before adding work orders."]),
        (Kind: WorkOrderSettingsController.Checklists, Title: T["Checklists"], Intro: T["Questions answered on the job, such as safety checks and readings. A required question must be answered before the work order is completed."], Add: T["Add checklist"], Search: T["Search checklists"], Empty: T["<strong>Nothing here!</strong> Add a checklist, then give it to the work order types that need it."]),
        (Kind: WorkOrderSettingsController.ServiceLevels, Title: T["Service Levels"], Intro: T["How fast work orders are responded to and resolved, by priority. The clock can run only in opening hours, and stops while a work order waits."], Add: T["Add service level"], Search: T["Search service levels"], Empty: T["<strong>Nothing here!</strong> Add a service level, then give it to work order types."]),
        (Kind: WorkOrderSettingsController.SubStatuses, Title: T["Sub-statuses"], Intro: T["Finer statuses inside a status, such as On hold: waiting for parts. A sub-status can stop the service level clock."], Add: T["Add sub-status"], Search: T["Search sub-statuses"], Empty: T["<strong>Nothing here!</strong> Add a sub-status, such as Waiting for parts under On hold."]),
    };
    var current = lists.First(list => list.Kind == Model.Kind);
    var empty = string.IsNullOrEmpty(Model.Search) ? current.Empty : T["<strong>Nothing found.</strong> No names match your search."];
}

<zone Name="Title"><breadcrumb name="WorkOrderSettings" title="@current.Title" /></zone>

<p class="text-muted">@current.Intro</p>

<form asp-action="Index" asp-route-kind="@Model.Kind" method="get">
    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <div class="input-group">
                        <input name="search" value="@Model.Search" class="form-control" placeholder="@current.Search" type="search" />
                        <button type="submit" class="btn btn-outline-secondary" title="@T["Search"]" aria-label="@T["Search"]"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
                    </div>
                </div>
                <div class="col-auto"><a asp-action="@Model.EditAction" class="btn btn-secondary create">@current.Add</a></div>
            </div>
        </div>
    </div>
</form>

<admin-list name="WorkOrderSettings" context="Model.List" show-select-all="false" empty-message="@empty">
    <admin-list-list item-css-class="list-group-item" />
    <admin-list-grid>
        <admin-list-column name="Name" position="20" title="@T["Name"]" />
        <admin-list-column name="Details" position="30" title="@T["Details"]" width="auto" />
        <admin-list-column type="Actions" title="@T["Actions"]" />
    </admin-list-grid>
</admin-list>
