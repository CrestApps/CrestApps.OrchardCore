@model WorkOrderEditorViewModel

@{
    var isNew = string.IsNullOrEmpty(Model.WorkOrderId);
}

<zone Name="Title"><breadcrumb name="@(isNew ? "WorkOrdersNew" : "WorkOrdersEdit")" title="@(isNew ? T["New Work Order: {0}", Model.TypeName] : T["Edit {0}", Model.Number])" /></zone>

<form asp-action="@(isNew ? "New" : "Edit")" asp-route-id="@Model.WorkOrderId" asp-route-typeId="@(isNew ? Model.TypeId : null)" method="post" class="no-multisubmit">
    <div asp-validation-summary="All" class="text-danger"></div>
    @await DisplayAsync(Model.Editor)
    <div class="action-bar-bottom">
        <button type="submit" class="btn btn-primary save">@(isNew ? T["Create"] : T["Save"])</button>
        @if (isNew)
        {
            <a asp-action="Index" class="btn btn-secondary cancel">@T["Cancel"]</a>
        }
        else
        {
            <a asp-action="Details" asp-route-id="@Model.WorkOrderId" class="btn btn-secondary cancel">@T["Cancel"]</a>
        }
    </div>
</form>
