@model CrestApps.OrchardCore.WorkOrders.Integrations.CreateWorkOrderSubjectActionViewModel

<div class="alert alert-info">
    @T["Makes a work order of this type for the activity's contact, with the activity's notes as its description and the number it was reached on as the contact phone. An activity makes one work order, however often its disposition is saved; dispatch it from the work order's page or the dispatch board."]
</div>

<div class="ocat-wrapper">
    <label asp-for="TypeId" class="ocat-label ocat-label-required">@T["Work order type"]</label>
    <div class="ocat-end">
        <select asp-for="TypeId" asp-items="Model.Types" class="form-select" required>
            <option value="">@T["Choose a type"]</option>
        </select>
        <span asp-validation-for="TypeId" class="text-danger"></span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="Priority" class="ocat-label">@T["Priority"]</label>
    <div class="ocat-end">
        <select asp-for="Priority" asp-items="Model.Priorities" class="form-select" style="max-width: 16rem"></select>
    </div>
</div>
