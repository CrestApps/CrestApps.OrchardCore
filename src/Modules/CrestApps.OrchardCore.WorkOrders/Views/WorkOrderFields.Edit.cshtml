@model WorkOrderEditViewModel

<style asp-name="bootstrap-select"></style>
<script asp-name="bootstrap-select" depends-on="bootstrap" at="Foot"></script>

<div class="card text-bg-theme mb-3">
    <div class="card-header">@T["Details"]</div>
    <div class="card-body">
        <div class="ocat-wrapper">
            <label asp-for="Summary" class="ocat-label">@T["Summary"]</label>
            <div class="ocat-end">
                <input asp-for="Summary" class="form-control" required placeholder="@T["Such as: No heat in the upstairs rooms"]" />
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="Priority" class="ocat-label">@T["Priority"]</label>
            <div class="ocat-end">
                <select asp-for="Priority" asp-items="Html.GetEnumSelectList<WorkOrderPriority>()" class="form-select"></select>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="EstimatedMinutes" class="ocat-label">@T["Minutes"]</label>
            <div class="ocat-end">
                <input asp-for="EstimatedMinutes" type="number" min="0" step="5" class="form-control" style="max-width: 12rem" />
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="Description" class="ocat-label">@T["Description"]</label>
            <div class="ocat-end">
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>
        </div>
    </div>
</div>
<div class="card text-bg-theme mb-3">
    <div class="card-header">@T["Who and where"]</div>
    <div class="card-body">
        @foreach (var (kind, name) in Model.CustomerPickers)
        {
            var field = kind switch { "Customer" => Html.NameFor(m => m.CustomerId).ToString(), "Account" => Html.NameFor(m => m.AccountId).ToString(), _ => Html.NameFor(m => m.ContactId).ToString() };
            var value = kind switch { "Customer" => Model.CustomerId, "Account" => Model.AccountId, _ => Model.ContactId };
            var label = kind switch { "Customer" => T["Customer"].Value, "Account" => T["Account"].Value, _ => T["CRM contact"].Value };
            var choose = kind switch { "Customer" => T["Choose a customer"].Value, "Account" => T["Choose an account"].Value, _ => T["Choose a contact"].Value };
            var initial = string.IsNullOrEmpty(value) ? "[]" : System.Text.Json.JsonSerializer.Serialize(new[] { new { value, text = string.IsNullOrEmpty(name) ? value : name, selected = true } });

            <div class="ocat-wrapper">
                <label class="ocat-label">@label</label>
                <div class="ocat-end">
                    @await Component.InvokeAsync("ItemSelector", new
                    {
                        id = $"work-order-{kind.ToLowerInvariant()}",
                        inputName = field,
                        endpoint = kind == "Account" ? Url.RouteUrl(CrestApps.OrchardCore.Accounts.AccountsConstants.RouteNames.Search) : Url.Content($"~/Admin/api/crestapps/work-orders/customers/search?kind={kind}"),
                        initialItemsJson = initial,
                        multiple = false,
                        enableSearch = true,
                        buttonText = choose,
                        searchPlaceholder = T["Search by name"].Value,
                        emptyResultsText = T["Nothing found."].Value,
                        noSelectionText = choose,
                        selectedItemsLabel = label,
                        availableItemsLabel = label,
                        smallButton = false,
                    })
                    @if (kind == "Contact")
                    {
                        <span class="hint">@T["When the name below is left empty, the contact's name fills it in."]</span>
                    }
                </div>
            </div>
        }
        @if (!Model.CustomerPickers.ContainsKey("Contact"))
        {
            <input type="hidden" asp-for="ContactId" />
        }
        @if (!Model.CustomerPickers.ContainsKey("Customer"))
        {
            <input type="hidden" asp-for="CustomerId" />
        }
        @if (!Model.CustomerPickers.ContainsKey("Account"))
        {
            <input type="hidden" asp-for="AccountId" />
        }
        <div class="ocat-wrapper">
            <label asp-for="ContactName" class="ocat-label">@T["Contact"]</label>
            <div class="ocat-end">
                <input asp-for="ContactName" class="form-control" autocomplete="off" />
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="ContactPhone" class="ocat-label">@T["Phone"]</label>
            <div class="ocat-end">
                <input asp-for="ContactPhone" type="tel" class="form-control" autocomplete="off" />
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="ContactEmail" class="ocat-label">@T["Email"]</label>
            <div class="ocat-end">
                <input asp-for="ContactEmail" type="email" class="form-control" autocomplete="off" />
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="AddressLine1" class="ocat-label">@T["Street address"]</label>
            <div class="ocat-end">
                <input asp-for="AddressLine1" class="form-control" autocomplete="off" />
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="AddressLine2" class="ocat-label">@T["Unit, floor"]</label>
            <div class="ocat-end">
                <input asp-for="AddressLine2" class="form-control" autocomplete="off" />
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="City" class="ocat-label">@T["City"]</label>
            <div class="ocat-end">
                <input asp-for="City" class="form-control" autocomplete="off" />
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="Region" class="ocat-label">@T["State or region"]</label>
            <div class="ocat-end">
                <input asp-for="Region" class="form-control" autocomplete="off" />
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="PostalCode" class="ocat-label">@T["Postal code"]</label>
            <div class="ocat-end">
                <input asp-for="PostalCode" class="form-control" autocomplete="off" />
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="Country" class="ocat-label">@T["Country"]</label>
            <div class="ocat-end">
                <input asp-for="Country" class="form-control" autocomplete="off" maxlength="2" placeholder="US" />
            </div>
        </div>
        @if (Model.Map is not null)
        {
        <div class="ocat-wrapper">
            <div class="ocat-end-offset">
                <input type="hidden" asp-for="Latitude" />
                <input type="hidden" asp-for="Longitude" />
                <style asp-name="leaflet"></style>
                <script asp-name="crestapps-map" at="Foot"></script>
                <div id="work-order-map" class="border rounded" style="height: 16rem; z-index: 0;"
                     data-tile-url="@Model.Map.TileUrl" data-attribution="@Model.Map.TileAttribution"
                     data-latitude="@Model.Map.DefaultLatitude.ToString(CultureInfo.InvariantCulture)" data-longitude="@Model.Map.DefaultLongitude.ToString(CultureInfo.InvariantCulture)" data-zoom="@Model.Map.DefaultZoom"
                     role="region" aria-label="@T["Where the job is"]"></div>
                <span class="hint">@T["Click the map to place the job, or drag the pin. Without a pin, the address is placed in the background."]</span>
                <script at="Foot">
                    document.addEventListener('DOMContentLoaded', () => {
                        const map = window.crestappsMap && window.crestappsMap.create('work-order-map');
                        if (map) {
                            window.crestappsMap.pin(map, document.getElementById('@Html.IdFor(model => model.Latitude)'), document.getElementById('@Html.IdFor(model => model.Longitude)'));
                        }
                    });
                </script>
            </div>
        </div>
        }
        <div class="ocat-wrapper">
            <label asp-for="AccessNotes" class="ocat-label">@T["Access notes"]</label>
            <div class="ocat-end">
                <textarea asp-for="AccessNotes" class="form-control" rows="2" placeholder="@T["Such as: gate code, the dog, where to park"]"></textarea>
                <span class="hint">@T["When Geo is on, the address is placed on the map in the background and gives the work order its territory."]</span>
            </div>
        </div>
    </div>
</div>
<div class="card text-bg-theme mb-3">
    <div class="card-header">@T["When"]</div>
    <div class="card-body">
        <div class="ocat-wrapper">
            <label asp-for="Earliest" class="ocat-label">@T["Not before"]</label>
            <div class="ocat-end">
                <input asp-for="Earliest" type="datetime-local" class="form-control" style="max-width: 12rem" />
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="Latest" class="ocat-label">@T["Not after"]</label>
            <div class="ocat-end">
                <input asp-for="Latest" type="datetime-local" class="form-control" style="max-width: 12rem" />
            </div>
        </div>
        @if (Model.AssetOptions.Count > 0)
        {
            <h2 class="h5 mt-4">@T["Assets"]</h2>
            <div class="mb-3">
                <label asp-for="AssetIds" class="form-label visually-hidden">@T["Assets"]</label>
                <select asp-for="AssetIds" asp-items="Model.AssetOptions" class="selectpicker show-tick" multiple data-live-search="true" data-actions-box="true" data-width="100%" data-selected-text-format="count > 3"></select>
                <span class="hint">@T["The equipment the job is on. The work order shows in each asset's history."]</span>
            </div>
        }
    </div>
</div>
<div class="card text-bg-theme mb-3">
    <div class="card-header">@T["Lines"]</div>
    <div class="card-body">
        <p class="hint">@T["Parts, labor and charges planned for the job. What is used is recorded on the work order's page."]</p>
        <partial name="_LineRows" model="(Model.Lines, Model.StockItemOptions)" />
    </div>
</div>
