@model StaffCapabilitiesListViewModel

<zone Name="Title"><breadcrumb name="StaffCapabilities" title="@T["Capabilities"]" /></zone>

<p class="hint">@T["A capability is a pool someone belongs to, such as Contact Center agent, technician, cashier or bookable: pickers and filters offer only the people who have it, and modules add the ones their code relies on (signing in to a queue makes someone an agent). It is a yes or no. How good someone is at something, from 1 to 5 with certifications, is a skill under Content > Skills."]</p>

<form method="get" class="no-multisubmit" data-list-management data-client-side-search="true">
    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <div class="input-group">
                        <input id="search-box" class="form-control" placeholder="@T["Search"]" type="search" autofocus autocomplete="off" />
                        <button type="button" class="btn btn-outline-secondary" title="@T["Search"]" aria-label="@T["Search"]"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
                    </div>
                </div>
                <div class="col-auto">
                    <a asp-action="Create" class="btn btn-secondary create" role="button">@T["Add Capability"]</a>
                </div>
            </div>
        </div>
    </div>

    <admin-list name="StaffCapabilities" context="Model.List" show-select-all="false"
                empty-message="@T["<strong>Nothing here!</strong> No capabilities yet. A capability is a pool people are put in, such as who can take calls or who can be booked."]">
        <admin-list-list item-css-class="list-group-item" />
        <admin-list-grid>
            <admin-list-column name="Name" position="20" title="@T["Name"]" />
            <admin-list-column name="Kind" position="30" title="@T["Kind"]" width="auto" />
            <admin-list-column type="Actions" title="@T["Actions"]" />
        </admin-list-grid>
    </admin-list>

    <div id="list-alert" class="alert alert-info my-3 d-none text-center" role="alert">@T["Your search returned no results."]</div>
</form>

<script asp-name="list-management-ui" at="Foot"></script>
