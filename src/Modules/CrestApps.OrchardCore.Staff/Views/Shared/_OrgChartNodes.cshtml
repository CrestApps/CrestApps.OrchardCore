@model IList<StaffOrgChartNode>

<ul class="list-unstyled ms-3 border-start ps-3">
    @foreach (var node in Model)
    {
        <li class="my-2">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <i class="fa-solid fa-user-tie text-secondary" aria-hidden="true"></i>
                <a asp-controller="Staff" asp-action="Edit" asp-route-id="@node.StaffMember.ItemId" class="fw-semibold">@node.StaffMember.DisplayName</a>
                @if (!string.IsNullOrEmpty(node.StaffMember.JobTitle))
                {
                    <span class="text-secondary">@node.StaffMember.JobTitle</span>
                }
                @if (!string.IsNullOrEmpty(node.TeamName))
                {
                    <span class="badge ta-badge fw-normal">@node.TeamName</span>
                }
                @if (node.Reports.Count > 0)
                {
                    <span class="hint">@T["{0} direct reports", node.Reports.Count]</span>
                }
            </div>
            @if (node.Reports.Count > 0)
            {
                <partial name="_OrgChartNodes" model="node.Reports" />
            }
        </li>
    }
</ul>
