@model CrestApps.OrchardCore.Staff.Drivers.StaffBadgeViewModel

<div class="card text-bg-theme mb-3">
    <div class="card-header">@T["Badge"]</div>
    <div class="card-body">
        <div class="ocat-wrapper">
            <label asp-for="Pin" class="ocat-label">@T["PIN"]</label>
            <div class="ocat-end">
                <input asp-for="Pin" type="password" inputmode="numeric" autocomplete="new-password" data-1p-ignore data-lpignore="true" data-bwignore class="form-control" style="max-width: 10rem" />
                <span class="hint">@(Model.HasPin ? T["A PIN is set. Type a new one to replace it."] : T["No PIN yet. With their employee number as the badge, they sign in at kiosks and registers."])</span>
            </div>
        </div>
        @if (Model.HasPin)
        {
            <div class="form-check">
                <input asp-for="ClearPin" class="form-check-input" />
                <label asp-for="ClearPin" class="form-check-label">@T["Remove the PIN"]</label>
            </div>
        }
    </div>
</div>
