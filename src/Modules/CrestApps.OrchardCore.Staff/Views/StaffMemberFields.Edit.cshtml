@model StaffEditViewModel

<div class="card text-bg-theme mb-3">
    <div class="card-header">@T["Person"]</div>
    <div class="card-body">
        <div class="ocat-wrapper">
            <label asp-for="UserId" class="ocat-label">@T["User account"]</label>
            <div class="ocat-end">
                @if (Model.UserLocked)
                {
                    <div class="form-control-plaintext">
                        <i class="fa-solid fa-lock text-secondary me-1" aria-hidden="true"></i>
                        <a asp-area="OrchardCore.Users" asp-controller="Admin" asp-action="Edit" asp-route-id="@Model.UserId">@Model.DisplayName</a>
                    </div>
                    <span class="hint">@T["Linked for good, so their pay, history and badge never move to someone else. For another account, add a new staff member."]</span>
                }
                else
                {
                    @await Component.InvokeAsync("UserPicker", new { name = Html.NameFor(m => m.UserId).ToString(), selectedValues = new[] { Model.UserId }, valueType = "userId", multiple = false, audience = CrestApps.OrchardCore.Staff.StaffConstants.UnlinkedUserAudience, buttonText = T["Choose a user"].Value, searchPlaceholder = T["Search users"].Value, smallButton = false })
                    <span class="hint">@T["Optional, and fixed once saved. Only accounts that aren't another staff member's are offered. Someone with no account can still be scheduled, assigned and paid, but can't sign in."]</span>
                }
            </div>
        </div>
        @* A linked user account owns the name and email: show them, with the way to change them, instead of boxes that look editable. *@
        <div class="ocat-wrapper" id="staff-linked-person" hidden="@(!Model.NameFromUser)">
            <label class="ocat-label">@T["Name"]</label>
            <div class="ocat-end">
                <div class="form-control-plaintext">
                    <strong id="staff-linked-name">@Model.DisplayName</strong>
                    <span id="staff-linked-email" class="text-muted ms-2">@Model.Email</span>
                </div>
                <span class="hint">
                    <span id="staff-linked-hint-saved" hidden="@(!Model.NameFromUser)">@T["Their name and email come from their user account, so they match everywhere on the site."]</span>
                    <span id="staff-linked-hint-new" hidden>@T["Their name and email will be taken from this user account when you save."]</span>
                    <a id="staff-linked-edit" href="@(Model.NameFromUser ? Url.Action("Edit", "Admin", new { area = "OrchardCore.Users", id = Model.UserId }) : "#")" hidden="@(!Model.NameFromUser)">@T["Change them on the user account"]</a>
                </span>
            </div>
        </div>
        <div id="staff-own-person" hidden="@Model.NameFromUser">
            <div class="ocat-wrapper">
                <label asp-for="DisplayName" class="ocat-label ocat-label-required">@T["Name"]</label>
                <div class="ocat-end">
                    <input asp-for="DisplayName" class="form-control" />
                    <span class="hint">@T["For someone with no user account. Link one above and the name comes from it instead."]</span>
                </div>
            </div>
            <div class="ocat-wrapper"><label asp-for="Email" class="ocat-label">@T["Work email"]</label><div class="ocat-end"><input asp-for="Email" type="email" class="form-control" /></div></div>
        </div>
        <div class="ocat-wrapper"><label asp-for="Phone" class="ocat-label">@T["Work phone"]</label><div class="ocat-end"><input asp-for="Phone" type="tel" class="form-control" style="max-width: 18rem" /></div></div>
        <div class="ocat-wrapper"><label asp-for="EmployeeNumber" class="ocat-label">@T["Employee number"]</label><div class="ocat-end"><input asp-for="EmployeeNumber" class="form-control" style="max-width: 14rem" /><span class="hint">@T["Also their badge number at a kiosk or register."]</span></div></div>
        <div class="ocat-wrapper"><label asp-for="ExternalId" class="ocat-label">@T["HR or payroll id"]</label><div class="ocat-end"><input asp-for="ExternalId" class="form-control" style="max-width: 14rem" /></div></div>
    </div>
</div>

<div class="card text-bg-theme mb-3">
    <div class="card-header">@T["Employment"]</div>
    <div class="card-body">
        <div class="ocat-wrapper"><label asp-for="JobTitle" class="ocat-label">@T["Job title"]</label><div class="ocat-end"><input asp-for="JobTitle" class="form-control" /></div></div>
        <div class="ocat-wrapper">
            <label asp-for="ManagerId" class="ocat-label">@T["Manager"]</label>
            <div class="ocat-end">
                @await Component.InvokeAsync("StaffPicker", new { name = Html.NameFor(m => m.ManagerId).ToString(), selectedValues = new[] { Model.ManagerId }, excludeId = Model.StaffMemberId, buttonText = T["Choose a manager"].Value })
                <span class="hint">@T["The person they report to. Managers can see and change the people who report to them."]</span>
            </div>
        </div>
        <div class="ocat-wrapper"><label asp-for="EmploymentType" class="ocat-label">@T["Employment"]</label><div class="ocat-end"><select asp-for="EmploymentType" asp-items="Model.EmploymentTypeOptions" class="form-select" style="max-width: 18rem"></select></div></div>
        <div class="ocat-wrapper"><label asp-for="Status" class="ocat-label">@T["Status"]</label><div class="ocat-end"><select asp-for="Status" asp-items="Model.StatusOptions" class="form-select" style="max-width: 18rem"></select><span class="hint">@T["Only active people are scheduled and assigned work. Terminating someone signs them out of the modules that use staff."]</span></div></div>
        <div class="ocat-wrapper"><label asp-for="HireDate" class="ocat-label">@T["Hire date"]</label><div class="ocat-end"><input asp-for="HireDate" type="date" class="form-control" style="max-width: 12rem" /></div></div>
        <div class="ocat-wrapper"><label asp-for="SeniorityDate" class="ocat-label">@T["Seniority date"]</label><div class="ocat-end"><input asp-for="SeniorityDate" type="date" class="form-control" style="max-width: 12rem" /><span class="hint">@T["When seniority counts from, if not the hire date."]</span></div></div>
        <div class="ocat-wrapper"><label asp-for="TerminationDate" class="ocat-label">@T["Last day worked"]</label><div class="ocat-end"><input asp-for="TerminationDate" type="date" class="form-control" style="max-width: 12rem" /><span class="hint">@T["They are terminated the day after, on their own."]</span></div></div>
        <div class="ocat-wrapper"><label asp-for="ContractedHoursPerWeek" class="ocat-label">@T["Contracted hours a week"]</label><div class="ocat-end"><input asp-for="ContractedHoursPerWeek" type="number" step="0.25" min="0" class="form-control" style="max-width: 10rem" /></div></div>
        @if (Model.CanSeeSensitive)
        {
            <div class="ocat-wrapper"><label asp-for="DateOfBirth" class="ocat-label">@T["Date of birth"]</label><div class="ocat-end"><input asp-for="DateOfBirth" type="date" class="form-control" style="max-width: 12rem" /><span class="hint">@T["Sensitive. Only used for the rules about young workers."]</span></div></div>
        }
    </div>
</div>

<div class="card text-bg-theme mb-3">
    <div class="card-header">@T["Place"]</div>
    <div class="card-body">
        <div class="ocat-wrapper"><label asp-for="WorkLocation" class="ocat-label">@T["Work location"]</label><div class="ocat-end"><input asp-for="WorkLocation" class="form-control" /><span class="hint">@T["The office, store or depot they work at."]</span></div></div>
        <div class="ocat-wrapper"><label asp-for="HomeBase" class="ocat-label">@T["Home base"]</label><div class="ocat-end"><input asp-for="HomeBase" class="form-control" /><span class="hint">@T["Where a field worker starts and ends the day."]</span></div></div>
        <div class="ocat-wrapper"><label asp-for="TimeZoneId" class="ocat-label">@T["Time zone"]</label><div class="ocat-end"><select asp-for="TimeZoneId" asp-items="Model.TimeZoneOptions" class="form-select" style="max-width: 22rem"><option value="">@T["The main team's time zone"]</option></select></div></div>
    </div>
</div>

<script at="Foot">
    (() => {
        // Linking a user account hands the name and email to it; unlinking gives them back to this record, keeping the last name.
        const picker = document.querySelector('select[name="@Html.NameFor(m => m.UserId)"]');
        const linked = document.getElementById('staff-linked-person');
        const own = document.getElementById('staff-own-person');

        if (!picker || !linked || !own) {
            return;
        }

        const savedUserId = '@Model.UserId';
        const editUrl = '@Url.Action("Edit", "Admin", new { area = "OrchardCore.Users", id = "__id__" })';
        const nameInput = document.getElementById('@Html.IdFor(m => m.DisplayName)');
        const emailInput = document.getElementById('@Html.IdFor(m => m.Email)');
        const shownName = document.getElementById('staff-linked-name');
        const shownEmail = document.getElementById('staff-linked-email');
        const savedHint = document.getElementById('staff-linked-hint-saved');
        const newHint = document.getElementById('staff-linked-hint-new');
        const editLink = document.getElementById('staff-linked-edit');

        picker.addEventListener('change', () => {
            const userId = picker.value;

            if (!userId) {
                if (nameInput && !nameInput.value.trim()) {
                    nameInput.value = shownName.textContent.trim();
                }

                if (emailInput && !emailInput.value.trim()) {
                    emailInput.value = shownEmail.textContent.trim();
                }

                linked.hidden = true;
                own.hidden = false;
                nameInput?.setAttribute('required', 'required');

                return;
            }

            const option = picker.options[picker.selectedIndex];
            const isSaved = userId === savedUserId;

            if (!isSaved) {
                shownName.textContent = option ? option.text.trim() : '';
                shownEmail.textContent = '';
            }

            savedHint.hidden = !isSaved;
            newHint.hidden = isSaved;
            editLink.hidden = false;
            editLink.href = editUrl.replace('__id__', encodeURIComponent(userId));
            nameInput?.removeAttribute('required');
            linked.hidden = false;
            own.hidden = true;
        });
    })();
</script>
