@using CrestApps.OrchardCore.Scheduling.Workflows

@model AppointmentTaskViewModel

<div class="mb-3">
    <label asp-for="AppointmentTypeId" class="form-label">@T["Appointment type id"]</label>
    <input asp-for="AppointmentTypeId" class="form-control code" />
</div>
<div class="mb-3">
    <label asp-for="From" class="form-label">@T["From (ISO 8601)"]</label>
    <input asp-for="From" class="form-control code" />
</div>
<div class="mb-3">
    <label asp-for="To" class="form-label">@T["To (ISO 8601)"]</label>
    <input asp-for="To" class="form-control code" />
</div>
<div class="mb-3">
    <label asp-for="CustomerName" class="form-label">@T["Customer name"]</label>
    <input asp-for="CustomerName" class="form-control code" />
</div>
<div class="mb-3">
    <label asp-for="CustomerEmail" class="form-label">@T["Customer email"]</label>
    <input asp-for="CustomerEmail" class="form-control code" />
</div>
<div class="mb-3">
    <label asp-for="CustomerPhone" class="form-label">@T["Customer phone"]</label>
    <input asp-for="CustomerPhone" class="form-control code" />
</div>
<div class="mb-3">
    <label asp-for="OutputName" class="form-label">@T["Output name"]</label>
    <input asp-for="OutputName" class="form-control" />
</div>
