@model ShapeViewModel<SchedulingResource>

<span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Kind"]"><i class="fa-solid fa-tag text-secondary me-1" aria-hidden="true"></i>@Model.Value.Kind</span>
<span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Time zone"]"><i class="fa-solid fa-globe text-secondary me-1" aria-hidden="true"></i>@Model.Value.TimeZoneId</span>
@if (!Model.Value.Enabled)
{
    <span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Status"]"><i class="fa-solid fa-ban text-warning me-1" aria-hidden="true"></i>@T["Disabled"]</span>
}
