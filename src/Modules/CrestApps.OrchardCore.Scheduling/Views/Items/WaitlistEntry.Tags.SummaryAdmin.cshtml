@model ShapeViewModel<WaitlistEntry>
@inject OrchardCore.Modules.ILocalClock LocalClock

@functions {
    // Stored times are UTC; people read them in the site time zone.
    private async Task<DateTime> LocalAsync(DateTime utc)
        => (await LocalClock.ConvertToLocalAsync(DateTime.SpecifyKind(utc, DateTimeKind.Utc))).DateTime;
}

<span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Status"]"><i class="fa-solid fa-circle-info text-secondary me-1" aria-hidden="true"></i>@Model.Value.Status</span>
<span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Contact"]"><i class="fa-solid fa-envelope text-secondary me-1" aria-hidden="true"></i>@(Model.Value.CustomerEmail ?? Model.Value.CustomerPhone)</span>
<span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Can come"]"><i class="fa-solid fa-calendar text-secondary me-1" aria-hidden="true"></i>@((await LocalAsync(Model.Value.FromUtc)).ToString("d")) - @((await LocalAsync(Model.Value.ToUtc)).AddDays(-1).ToString("d"))</span>
