@model SchedulingListViewModel

<zone Name="Title"><breadcrumb name="SchedulingAppointmentTypes" title="@T["Appointment Types"]" /></zone>

<div class="card text-bg-theme mb-3 position-sticky action-bar">
    <div class="card-body">
        <div class="row gx-2">
            <div class="col"></div>
            <div class="col-auto"><a asp-action="Edit" class="btn btn-secondary create">@T["Add appointment type"]</a></div>
        </div>
    </div>
</div>

<admin-list name="SchedulingAppointmentTypes" context="Model.List" show-select-all="false" empty-message="@T["<strong>Nothing here!</strong> There are no appointment types."]">
    <admin-list-list item-css-class="list-group-item" />
    <admin-list-grid>
        <admin-list-column name="Name" position="20" title="@T["Name"]" />
        <admin-list-column name="Details" position="30" title="@T["Details"]" width="auto" />
        <admin-list-column type="Actions" title="@T["Actions"]" />
    </admin-list-grid>
</admin-list>
