@using CrestApps.OrchardCore.Core.Models
@model EditCatalogEntryViewModel

@{
    var id = ViewContext.HttpContext.Request.RouteValues["id"] as string;
}

<zone Name="Title">
    <breadcrumb name="SchedulingAppointmentTypesEdit" title="@(string.IsNullOrEmpty(id) ? T["New Appointment Type"] : T["Edit '{0}' Appointment Type", Model.DisplayName])">
        <breadcrumb-item id="SchedulingAppointmentTypes" action="Index" controller="AppointmentTypes" area="CrestApps.OrchardCore.Scheduling">@T["Appointment Types"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form method="post" asp-action="Edit" asp-route-id="@id" class="no-multisubmit">
    @Html.ValidationSummary()
    @await DisplayAsync(Model.Editor)
    <div class="action-bar-bottom">
        <button class="btn btn-primary" type="submit">@T["Save"]</button>
        <a class="btn btn-secondary cancel" asp-action="Index">@T["Cancel"]</a>
    </div>
</form>
