@model NewAppointmentViewModel

@foreach (var error in Model.Errors)
{
    <div class="alert alert-danger">@error</div>
}

<form method="post" class="no-multisubmit">
    <input type="hidden" name="AppointmentTypeId" value="@Model.AppointmentTypeId" />
    <input type="hidden" name="Date" value="@Model.Date" />
    <div class="card text-bg-theme mb-3">
        <div class="card-header">@T["Open times on {0} ({1})", Model.Date, Model.TimeZoneId]</div>
        <div class="card-body">
            @if (Model.Slots.Count == 0)
            {
                <p class="text-muted mb-0">@T["There are no open times on this day."]</p>
            }
            else
            {
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var slot in Model.Slots)
                    {
                        <input type="radio" class="btn-check" name="Start" id="slot-@slot.Key" value="@slot.Key" checked="@(slot.Key == Model.Start)" autocomplete="off" />
                        <label class="btn btn-outline-primary" for="slot-@slot.Key">@slot.Value</label>
                    }
                </div>
            }
        </div>
    </div>
    @if (Model.Slots.Count > 0)
    {
        <div class="card text-bg-theme mb-3">
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label" for="CustomerName">@T["Name"]</label>
                    <input id="CustomerName" name="CustomerName" value="@Model.CustomerName" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="CustomerEmail">@T["Email"]</label>
                    <input id="CustomerEmail" name="CustomerEmail" value="@Model.CustomerEmail" type="email" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="CustomerPhone">@T["Phone"]</label>
                    <input id="CustomerPhone" name="CustomerPhone" value="@Model.CustomerPhone" type="tel" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="Notes">@T["Notes"]</label>
                    <textarea id="Notes" name="Notes" class="form-control" rows="2">@Model.Notes</textarea>
                </div>
                <button type="submit" class="btn btn-primary">@T["Book"]</button>
            </div>
        </div>
    }
</form>
