@model SchedulingListViewModel

<zone Name="Title"><breadcrumb name="SchedulingAppointments" title="@T["Appointments"]" /></zone>

<form asp-action="Index" method="get" id="appointments-filter">
    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <div class="input-group">
                        <input name="search" value="@Model.Search" class="form-control" placeholder="@T["Search by customer"]" type="search" />
                        <button type="submit" class="btn btn-outline-secondary" title="@T["Search"]" aria-label="@T["Search"]"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
                    </div>
                </div>
                <div class="col-auto">
                    <a asp-action="New" class="btn btn-secondary create">@T["Book an appointment"]</a>
                </div>
            </div>
        </div>
    </div>
</form>

@{
    Model.List.ToolbarActions = await New.SchedulingStatusFilter(Options: Model.StatusOptions, Selected: Model.Status);
}

<admin-list name="SchedulingAppointments" context="Model.List" show-select-all="false" empty-message="@T["<strong>Nothing here!</strong> There are no appointments."]">
    <admin-list-list item-css-class="list-group-item" />
    <admin-list-grid>
        <admin-list-column name="Name" position="20" title="@T["Appointment"]" />
        <admin-list-column name="Details" position="30" title="@T["Details"]" width="auto" />
        <admin-list-column type="Actions" title="@T["Actions"]" />
    </admin-list-grid>
</admin-list>
