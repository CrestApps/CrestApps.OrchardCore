@model MessagingLineEndpointViewModel

<div data-address-capability="@Model.ServedCapabilities">
    <div class="ocat-wrapper" asp-validation-class-for="TextingUserIds">
        <label asp-for="TextingUserIds" class="ocat-label">@T["Agents who send from this address"]</label>
        <div class="ocat-end">
            @await Component.InvokeAsync("UserPicker", new
            {
                name = Html.NameFor(m => m.TextingUserIds).ToString(),
                selectedValues = Model.TextingUserIds,
                valueType = "userId",
                multiple = true,
                buttonText = T["Select agents"].Value,
                searchPlaceholder = T["Search agents"].Value,
                smallButton = false,
            })
            <span asp-validation-for="TextingUserIds" class="text-danger"></span>
            <span class="hint">@T["New {0} conversations these agents start in the messaging workspace are sent from this address, and the Find Agent Numbers workflow task returns it for them. Each agent sends from one address per channel; for text messages, agents on no number's list use the default SMS number from Settings > Contact Center.", Model.ChannelNames]</span>
        </div>
    </div>
</div>
