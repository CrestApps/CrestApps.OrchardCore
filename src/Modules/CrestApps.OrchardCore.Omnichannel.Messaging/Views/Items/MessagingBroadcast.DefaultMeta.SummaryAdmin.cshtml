@using System.Globalization

@model ShapeViewModel<MessagingBroadcast>

<span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Created"]">
    <i class="fa-solid fa-calendar text-secondary me-1" aria-hidden="true"></i>
    <time datetime="@Model.Value.CreatedUtc.ToString(DateTimeFormatConstants.HtmlDateTimeOffset, CultureInfo.InvariantCulture)">@await DisplayAsync(await New.DateTime(Utc: Model.Value.CreatedUtc, Format: "g"))</time>
</span>
