@model ShapeViewModel<MessagingRoutingRule>

<a asp-action="Edit"
   asp-controller="RoutingRules"
   asp-route-id="@Model.Value.ItemId"
   class="btn btn-primary btn-sm">@T["Edit"]</a>

<a asp-action="Delete"
   asp-controller="RoutingRules"
   asp-route-id="@Model.Value.ItemId"
   class="btn btn-danger btn-sm"
   data-url-af="RemoveUrl UnsafeUrl"
   data-title="@T["Delete"]"
   data-message="@T["Are you sure you want to delete this routing rule?"]">@T["Delete"]</a>
