@using CrestApps.OrchardCore.Omnichannel.Messaging.Hubs
@using CrestApps.OrchardCore.Omnichannel.Messaging.Models
@model WorkspaceViewModel

@{
    var inbox = Model.Inbox;
    var thread = Model.Thread;
    var show = inbox.ShowRouteValue;
    var unread = inbox.UnreadRouteValue;

    var filterLabel = inbox.ShowFavorites
        ? T["Favorites"]
        : inbox.Filter switch
        {
            MessagingInboxFilter.Mine => T["My conversations"],
            MessagingInboxFilter.Unassigned => T["Unassigned"],
            _ => T["All conversations"],
        };

    var showNarrowing = inbox.HasNarrowingOptions && !inbox.ShowFavorites;
    var agentFilterName = inbox.AgentFilter is null ? null : inbox.Agents.FirstOrDefault(option => option.Value == inbox.AgentFilter)?.Text ?? inbox.AgentFilter;
    var queueFilterName = inbox.QueueFilter is null ? null : inbox.Queues.FirstOrDefault(option => option.Value == inbox.QueueFilter)?.Text ?? inbox.QueueFilter;
    var campaignFilterName = inbox.CampaignFilter is null ? null : inbox.Campaigns.FirstOrDefault(option => option.Value == inbox.CampaignFilter)?.Text ?? inbox.CampaignFilter;

    // The route values that keep every filter but one, for the button that removes that one.
    IDictionary<string, string> Without(string key)
    {
        var values = inbox.NarrowingRouteValues();
        values.Remove(key);

        return values;
    }
}

<zone Name="Title">
    <breadcrumb name="MessagingWorkspace" title="@T["Messaging"]" />
</zone>

<div class="messaging-workspace d-flex gap-3"
     data-messaging-workspace
     data-hub-url="@(Html.SignalRHubUrl<MessagingHub>())"
     data-inbox-url="@Url.Action("InboxList", new { show, channel = inbox.ChannelFilter, agent = inbox.AgentFilter, queue = inbox.QueueFilter, campaign = inbox.CampaignFilter, unread, page = inbox.Page, selected = inbox.SelectedCustomerKey })"
     data-conversation-url="@Url.Action("Conversation", new { id = "__ID__" })"
     data-availability-url="@Url.Action("SetAvailability")"
     data-attention-url="@Url.Action("Attention")"
     data-conversation-id="@thread?.Conversation.ItemId"
     data-customer-key="@thread?.CustomerKey"
     data-messages-url="@(thread is null ? null : Url.Action("ThreadMessages", new { id = thread.Conversation.ItemId }))"
     data-read-url="@(thread is null ? null : Url.Action("MarkRead", new { id = thread.Conversation.ItemId }))"
     data-new-message-text="@T["New message"]"
     data-view-text="@T["Open conversation"]"
     data-agent-id="@inbox.CurrentAgentId"
     data-someone-text="@T["Someone"]"
     data-transferred-to-you-text="@T["{0} transferred a conversation to you"].Value"
     data-assigned-to-you-text="@T["A conversation was assigned to you"]"
     data-assigned-from-to-you-text="@T["Assigned to you: {0}"].Value"
     data-transferred-to-queue-text="@T["{0} sent a conversation to the {1} queue"].Value"
     data-transferred-to-your-queue-text="@T["{0} sent a conversation to one of your queues"].Value"
     data-transferred-away-text="@T["This conversation was transferred to {0}"].Value">

    <aside class="messaging-inbox messaging-pane d-flex flex-column flex-shrink-0 @(thread is null && Model.Compose is null ? string.Empty : "d-none d-md-flex")">
        <div class="p-2 border-bottom d-flex flex-column gap-2">
            <div class="d-flex gap-1 align-items-center">
                <div class="has-search flex-grow-1">
                    <i class="fa-solid fa-search form-control-feedback" aria-hidden="true"></i>
                    <input class="form-control form-control-sm" data-inbox-search placeholder="@T["Search"]" type="search" autocomplete="off" />
                </div>
                <div class="dropdown">
                    <button class="btn btn-sm @(inbox.IsNarrowed ? "btn-primary" : "btn-outline-secondary")" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="@filterLabel">
                        <i class="fa-solid fa-filter" aria-hidden="true"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <a class="dropdown-item d-flex justify-content-between align-items-center gap-3 @(inbox.Filter == MessagingInboxFilter.All && !inbox.ShowFavorites ? "active" : string.Empty)" asp-all-route-data="@inbox.NarrowingRouteValues()" asp-route-action="Index" asp-route-channel="@inbox.ChannelFilter" asp-route-unread="@unread">
                                <span>@T["All conversations"]</span>
                                <span class="badge rounded-pill text-bg-secondary">@inbox.AllCount</span>
                            </a>
                        </li>
                        @if (inbox.HasAgentProfile)
                        {
                            <li>
                                <a class="dropdown-item d-flex justify-content-between align-items-center gap-3 @(inbox.Filter == MessagingInboxFilter.Mine && !inbox.ShowFavorites ? "active" : string.Empty)" asp-all-route-data="@inbox.NarrowingRouteValues()" asp-route-action="Index" asp-route-show="mine" asp-route-channel="@inbox.ChannelFilter" asp-route-unread="@unread">
                                    <span>@T["My conversations"]</span>
                                    <span class="badge rounded-pill text-bg-secondary">@inbox.MineCount</span>
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item d-flex justify-content-between align-items-center gap-3 @(inbox.ShowFavorites ? "active" : string.Empty)" asp-route-action="Index" asp-route-show="favorites">
                                    <span><i class="fa-solid fa-star text-warning me-1" aria-hidden="true"></i>@T["Favorites"]</span>
                                    <span class="badge rounded-pill text-bg-secondary">@inbox.Favorites.Count</span>
                                </a>
                            </li>
                        }
                        <li>
                            <a class="dropdown-item d-flex justify-content-between align-items-center gap-3 @(inbox.Filter == MessagingInboxFilter.Unassigned && !inbox.ShowFavorites ? "active" : string.Empty)" asp-all-route-data="@inbox.NarrowingRouteValues()" asp-route-action="Index" asp-route-show="unassigned" asp-route-channel="@inbox.ChannelFilter" asp-route-unread="@unread">
                                <span>@T["Unassigned"]</span>
                                <span class="badge rounded-pill text-bg-secondary">@inbox.UnassignedCount</span>
                            </a>
                        </li>
                        @if (inbox.Channels.Count > 1)
                        {
                            <li><hr class="dropdown-divider" /></li>
                            <li><h6 class="dropdown-header">@T["Channel"]</h6></li>
                            <li>
                                <a class="dropdown-item @(inbox.ChannelFilter is null ? "active" : string.Empty)" asp-all-route-data="@inbox.NarrowingRouteValues()" asp-route-action="Index" asp-route-show="@show" asp-route-unread="@unread">@T["Every channel"]</a>
                            </li>
                            @foreach (var channel in inbox.Channels)
                            {
                                <li>
                                    <a class="dropdown-item @(string.Equals(inbox.ChannelFilter, channel.Name, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)" asp-all-route-data="@inbox.NarrowingRouteValues()" asp-route-action="Index" asp-route-show="@show" asp-route-channel="@channel.Name" asp-route-unread="@unread">
                                        <i class="@channel.IconCssClass me-2" aria-hidden="true"></i>@channel.DisplayName
                                    </a>
                                </li>
                            }
                        }
                        @if (showNarrowing)
                        {
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <button class="dropdown-item" type="button" data-bs-toggle="collapse" data-bs-target="#messaging-inbox-narrowing" aria-controls="messaging-inbox-narrowing" aria-expanded="@(inbox.IsNarrowed ? "true" : "false")">
                                    <i class="fa-solid fa-sliders me-2" aria-hidden="true"></i>@T["More filters"]
                                </button>
                            </li>
                        }
                    </ul>
                </div>
                @if (!inbox.ShowFavorites)
                {
                    @* Narrows the open tab to the conversations nobody has read yet, and back. *@
                    <a class="btn btn-sm @(inbox.UnreadOnly ? "btn-primary" : "btn-outline-secondary")"
                       asp-all-route-data="@inbox.NarrowingRouteValues()" asp-route-action="Index" asp-route-show="@show" asp-route-channel="@inbox.ChannelFilter" asp-route-unread="@(inbox.UnreadOnly ? null : "true")"
                       title="@(inbox.UnreadOnly ? T["Show all conversations"] : T["Show unread conversations only"])"
                       aria-label="@T["Unread only"]" aria-pressed="@(inbox.UnreadOnly ? "true" : "false")" data-unread-toggle>
                        <i class="@(inbox.UnreadOnly ? "fa-solid" : "fa-regular") fa-envelope" aria-hidden="true"></i>
                    </a>
                }
                @if (inbox.HasAgentProfile)
                {
                    @* One click to the agent's starred customers, and back to the conversations. *@
                    <a class="btn btn-sm @(inbox.ShowFavorites ? "btn-warning" : "btn-outline-secondary")"
                       asp-route-action="Index" asp-route-show="@(inbox.ShowFavorites ? null : "favorites")"
                       title="@(inbox.ShowFavorites ? T["Back to conversations"] : T["Your favorite customers"])"
                       aria-label="@T["Favorites"]" aria-pressed="@(inbox.ShowFavorites ? "true" : "false")" data-favorites-toggle>
                        <i class="@(inbox.ShowFavorites ? "fa-solid" : "fa-regular") fa-star" aria-hidden="true"></i>
                    </a>
                }
                <a class="btn btn-sm btn-primary" asp-route-action="New" title="@T["New conversation"]" aria-label="@T["New conversation"]">
                    <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                </a>
            </div>
            @if (showNarrowing)
            {
                @* Narrows the list to one person's, one queue's or one campaign's conversations. It stays open while any is applied. *@
                <form method="get" asp-route-action="Index" class="collapse @(inbox.IsNarrowed ? "show" : string.Empty)" id="messaging-inbox-narrowing" data-inbox-narrowing-form>
                    <input type="hidden" name="show" value="@show" />
                    <input type="hidden" name="channel" value="@inbox.ChannelFilter" />
                    <input type="hidden" name="unread" value="@(inbox.UnreadOnly ? "true" : string.Empty)" />
                    <div class="d-flex flex-column gap-1">
                        @if (inbox.Agents.Count > 0)
                        {
                            <div class="input-group input-group-sm">
                                <label class="input-group-text messaging-narrowing-label" for="messaging-filter-agent">@T["Assigned to"]</label>
                                <select class="form-select" id="messaging-filter-agent" name="agent" data-inbox-narrowing>
                                    <option value="">@T["Anyone"]</option>
                                    @foreach (var option in inbox.Agents)
                                    {
                                        <option value="@option.Value" selected="@(option.Value == inbox.AgentFilter)">@option.Text</option>
                                    }
                                </select>
                            </div>
                        }
                        @if (inbox.Queues.Count > 0)
                        {
                            <div class="input-group input-group-sm">
                                <label class="input-group-text messaging-narrowing-label" for="messaging-filter-queue">@T["Queue"]</label>
                                <select class="form-select" id="messaging-filter-queue" name="queue" data-inbox-narrowing>
                                    <option value="">@T["Any queue"]</option>
                                    @foreach (var option in inbox.Queues)
                                    {
                                        <option value="@option.Value" selected="@(option.Value == inbox.QueueFilter)">@option.Text</option>
                                    }
                                </select>
                            </div>
                        }
                        @if (inbox.Campaigns.Count > 0)
                        {
                            <div class="input-group input-group-sm">
                                <label class="input-group-text messaging-narrowing-label" for="messaging-filter-campaign">@T["Campaign"]</label>
                                <select class="form-select" id="messaging-filter-campaign" name="campaign" data-inbox-narrowing>
                                    <option value="">@T["Any campaign"]</option>
                                    @foreach (var option in inbox.Campaigns)
                                    {
                                        <option value="@option.Value" selected="@(option.Value == inbox.CampaignFilter)">@option.Text</option>
                                    }
                                </select>
                            </div>
                        }
                    </div>
                    <noscript><button type="submit" class="btn btn-sm btn-primary mt-1">@T["Apply"]</button></noscript>
                </form>
            }
            <div class="d-flex justify-content-between align-items-center small">
                <span class="text-muted">
                    @filterLabel
                    @if (inbox.UnreadOnly)
                    {
                        <span class="badge rounded-pill text-bg-primary ms-1" data-unread-filter-label>@T["Unread"]</span>
                    }
                </span>
                @if (inbox.HasAgentProfile)
                {
                    <div class="form-check form-switch mb-0 flex-shrink-0" title="@T["Accept routed conversations to your inbox"]">
                        <input class="form-check-input" type="checkbox" role="switch" id="messaging-available-toggle" data-availability-toggle @(inbox.Available ? "checked" : string.Empty) />
                        <label class="form-check-label" for="messaging-available-toggle">@T["Available"]</label>
                    </div>
                }
            </div>
            @if (inbox.IsNarrowed && !inbox.ShowFavorites)
            {
                <div class="d-flex flex-wrap gap-1" data-inbox-narrowing-chips>
                    @if (agentFilterName is not null)
                    {
                        <a class="badge rounded-pill text-bg-light border text-decoration-none fw-normal" asp-all-route-data="@Without("agent")" asp-route-action="Index" asp-route-show="@show" asp-route-channel="@inbox.ChannelFilter" asp-route-unread="@unread" title="@T["Remove this filter"]">
                            <i class="fa-solid fa-user me-1" aria-hidden="true"></i>@agentFilterName<i class="fa-solid fa-xmark ms-1" aria-hidden="true"></i>
                        </a>
                    }
                    @if (queueFilterName is not null)
                    {
                        <a class="badge rounded-pill text-bg-light border text-decoration-none fw-normal" asp-all-route-data="@Without("queue")" asp-route-action="Index" asp-route-show="@show" asp-route-channel="@inbox.ChannelFilter" asp-route-unread="@unread" title="@T["Remove this filter"]">
                            <i class="fa-solid fa-users me-1" aria-hidden="true"></i>@queueFilterName<i class="fa-solid fa-xmark ms-1" aria-hidden="true"></i>
                        </a>
                    }
                    @if (campaignFilterName is not null)
                    {
                        <a class="badge rounded-pill text-bg-light border text-decoration-none fw-normal" asp-all-route-data="@Without("campaign")" asp-route-action="Index" asp-route-show="@show" asp-route-channel="@inbox.ChannelFilter" asp-route-unread="@unread" title="@T["Remove this filter"]">
                            <i class="fa-solid fa-bullhorn me-1" aria-hidden="true"></i>@campaignFilterName<i class="fa-solid fa-xmark ms-1" aria-hidden="true"></i>
                        </a>
                    }
                </div>
            }
        </div>

        <div class="flex-grow-1 overflow-y-auto" data-inbox-list>
            @await Html.PartialAsync("_InboxList", inbox)
        </div>
    </aside>

    <section class="messaging-thread messaging-pane d-flex flex-column flex-grow-1 overflow-hidden">
        @if (Model.Compose is not null)
        {
            @await Html.PartialAsync("_Compose", Model.Compose)
        }
        else if (thread is null)
        {
            <div class="d-flex flex-column align-items-center justify-content-center flex-grow-1 text-muted p-4 text-center">
                <i class="fa-regular fa-comments fa-3x mb-3" aria-hidden="true"></i>
                <p class="mb-1">@T["Select a customer to see their conversation."]</p>
                @if (inbox.Channels.Count == 0)
                {
                    <p class="small mb-0">@T["No messaging channel is enabled yet. Enable a channel feature, such as SMS Messaging Channel, to send and receive messages."]</p>
                }
            </div>
        }
        else
        {
            @await Html.PartialAsync("_Thread", thread)
        }
    </section>
</div>

<form class="d-none" data-antiforgery>@Html.AntiForgeryToken()</form>
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1090;" data-toast-container></div>

<style at="Head">
    .ta-content {
        padding-bottom: 0 !important;
    }

    .messaging-workspace {
        height: calc(100vh - var(--oc-top-nav-height, 0px) - 5.5rem);
        min-height: 32rem;
    }

    /* Leave room for the breadcrumb trail above the title when it is shown. */
    .ta-content:has(> .oc-breadcrumb) .messaging-workspace {
        height: calc(100vh - var(--oc-top-nav-height, 0px) - 7.75rem);
    }

    /* The list and the conversation are two panes of their own, set apart by a gap, rather than one box split by a
       rule: each carries its own frame and the page background shows between them. */
    .messaging-pane {
        background-color: var(--bs-body-bg);
        border: 1px solid var(--bs-border-color-translucent);
        border-radius: var(--bs-border-radius-lg);
        box-shadow: var(--bs-box-shadow-sm);
        overflow: hidden;
    }

    .messaging-inbox {
        width: 21rem;
    }

    @@media (max-width: 767.98px) {
        .messaging-inbox {
            width: 100%;
        }
    }

    /* A flush list inside a framed pane would draw its own rule against the pane's edge. */
    .messaging-inbox .list-group-item {
        border-inline: 0;
    }

    .messaging-inbox .list-group-item:first-child {
        border-top: 0;
    }

    /* Bootstrap's active item is white text on the primary colour, which washed the customer's name out on a light
       row. The selected customer keeps readable text on a subtle tint, marked by an accent bar. */
    .messaging-inbox-row.active,
    .messaging-inbox-row.active:hover,
    .messaging-inbox-row.active:focus {
        background-color: var(--bs-primary-bg-subtle);
        color: var(--bs-body-color);
        border-color: var(--bs-border-color-translucent);
        box-shadow: inset 3px 0 0 var(--bs-primary);
    }

    .messaging-inbox-row.active .text-muted {
        color: var(--bs-secondary-color) !important;
    }

    .messaging-inbox-row.messaging-unread .messaging-row-name,
    .messaging-inbox-row.messaging-unread .messaging-row-preview {
        font-weight: 600;
        color: var(--bs-body-color);
    }

    .messaging-narrowing-label {
        width: 6.5rem;
    }

    .messaging-avatar {
        width: 2.25rem;
        height: 2.25rem;
        font-size: .8rem;
    }

    .messaging-channel-tabs .nav-link {
        position: relative;
        font-size: 1.15rem;
        padding: .5rem .8rem;
        color: var(--bs-secondary-color);
        border: 0;
        border-bottom: 2px solid transparent;
    }

    .messaging-channel-tabs .nav-link.active {
        color: var(--bs-success);
        border-bottom-color: var(--bs-success);
        background: transparent;
    }

    .messaging-channel-tabs .nav-link.disabled {
        opacity: .35;
    }

    .messaging-favorite {
        width: 4rem;
    }

    .messaging-favorite:hover,
    .messaging-favorite.active {
        background-color: var(--bs-primary-bg-subtle);
    }

    .messaging-favorite-name {
        max-width: 100%;
        font-size: .72rem;
    }

    .messaging-favorite-channel {
        position: absolute;
        right: -.25rem;
        bottom: -.2rem;
        font-size: .65rem;
        padding: .12rem;
        border-radius: 50%;
        background-color: var(--bs-body-bg);
        color: var(--bs-secondary-color);
    }

    /* Pictures in a bubble are thumbnails; the full picture opens in a new tab. */
    .messaging-attachment img {
        display: block;
        max-width: 15rem;
        max-height: 15rem;
        object-fit: cover;
    }

    .messaging-drop-overlay {
        position: absolute;
        inset: 0;
        z-index: 5;
        background-color: rgba(var(--bs-primary-rgb), .08);
        border: 2px dashed var(--bs-primary);
    }

    .messaging-drop-overlay.show {
        display: flex !important;
    }

    .messaging-composer-preview {
        position: relative;
        width: 4.5rem;
        height: 4.5rem;
    }

    .messaging-composer-file {
        width: 9rem;
        padding-right: 1.5rem !important;
    }

    .messaging-file {
        max-width: 16rem;
    }

    .messaging-composer-preview img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .messaging-composer-preview .btn-close {
        position: absolute;
        top: .15rem;
        right: .15rem;
        padding: .3rem;
        background-color: var(--bs-body-bg);
        border-radius: 50%;
        opacity: .85;
    }

    .messaging-channel-tabs .messaging-tab-badge {
        position: absolute;
        top: .1rem;
        right: .05rem;
        font-size: .6rem;
    }
</style>

<script asp-name="signalr" at="Foot"></script>
<script asp-src="~/CrestApps.OrchardCore.Omnichannel.Messaging/scripts/messaging-workspace.min.js" debug-src="~/CrestApps.OrchardCore.Omnichannel.Messaging/scripts/messaging-workspace.js" depends-on="signalr" at="Foot"></script>
