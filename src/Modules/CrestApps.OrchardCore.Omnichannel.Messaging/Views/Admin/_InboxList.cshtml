@using CrestApps.OrchardCore.Omnichannel.Messaging.Models
@using CrestApps.OrchardCore.Omnichannel.Messaging.Services
@model InboxViewModel

@{
    var show = Model.Filter == MessagingInboxFilter.All ? null : Model.Filter.ToString().ToLowerInvariant();
}

@if (Model.Favorites.Count > 0)
{
    @* The customers the agent starred, one click from their conversation, or from a new one when they have none yet. *@
    <div class="messaging-favorites border-bottom px-2 pt-2 pb-1" data-inbox-favorites>
        <div class="d-flex align-items-center gap-1 text-muted small fw-semibold mb-1">
            <i class="fa-solid fa-star text-warning" aria-hidden="true"></i>@T["Favorites"]
        </div>
        <div class="d-flex gap-2 overflow-x-auto pb-1">
            @foreach (var favorite in Model.Favorites)
            {
                <a class="messaging-favorite text-decoration-none text-body d-flex flex-column align-items-center flex-shrink-0 rounded-3 p-1 @(favorite.IsSelected ? "active" : string.Empty)"
                   asp-route-action="Start" asp-route-channel="@favorite.Favorite.Channel" asp-route-address="@favorite.Favorite.ContactAddress"
                   title="@favorite.Name — @favorite.AddressDisplay"
                   data-favorite-key="@favorite.Favorite.CustomerKey"
                   data-filter-value="@($"{favorite.Name} {favorite.AddressDisplay} {favorite.Favorite.ContactAddress}")">
                    <span class="messaging-avatar rounded-circle @AvatarPalette.For(favorite.Favorite.CustomerKey) d-inline-flex align-items-center justify-content-center fw-semibold position-relative" aria-hidden="true">
                        @if (AvatarPalette.Initials(favorite.Name) is { } initials)
                        {
                            @initials
                        }
                        else
                        {
                            <i class="fa-solid fa-user"></i>
                        }
                        @if (!string.IsNullOrEmpty(favorite.ChannelIconCssClass))
                        {
                            <i class="@favorite.ChannelIconCssClass messaging-favorite-channel" aria-hidden="true"></i>
                        }
                    </span>
                    <span class="messaging-favorite-name text-truncate small">@favorite.Name</span>
                </a>
            }
        </div>
    </div>
}

@if (Model.Rows.Count == 0)
{
    <div class="text-muted small p-3">@T["Nothing here yet. Start a new conversation, or messages that reach the endpoints you serve will appear here."]</div>
}
else
{
    <div class="list-group list-group-flush" data-inbox-rows>
        @foreach (var row in Model.Rows)
        {
            var isSelected = string.Equals(row.CustomerKey, Model.SelectedCustomerKey, StringComparison.Ordinal);
            var unread = row.UnreadCount > 0;

            <a class="list-group-item list-group-item-action messaging-inbox-row px-2 py-2 @(isSelected ? "active" : string.Empty) @(unread ? "messaging-unread" : string.Empty)"
               asp-route-action="Conversation" asp-route-id="@row.Conversation.ItemId" asp-route-show="@show" asp-route-channel="@Model.ChannelFilter"
               data-customer-key="@row.CustomerKey"
               data-conversation-id="@row.Conversation.ItemId"
               data-filter-value="@($"{row.Conversation.ContactAddress} {row.Conversation.LastMessagePreview}")">
                <div class="d-flex gap-2 align-items-start">
                    <div class="flex-grow-1" style="min-width: 0;">
                        @await DisplayAsync(row.Shape)
                    </div>
                    <div class="d-flex flex-column align-items-end gap-1 flex-shrink-0">
                        @if (row.IsFavorite)
                        {
                            <i class="fa-solid fa-star text-warning small" title="@T["Favorite"]" aria-label="@T["Favorite"]"></i>
                        }
                        <span class="badge rounded-pill text-bg-danger @(unread ? string.Empty : "d-none")" data-row-unread>@row.UnreadCount</span>
                        @if (row.Channels.Count > 1)
                        {
                            <span class="text-muted small text-nowrap" title="@T["Channels this customer wrote on"]">
                                @foreach (var channel in row.Channels)
                                {
                                    <i class="@channel.IconCssClass ms-1" aria-label="@channel.DisplayName"></i>
                                }
                            </span>
                        }
                    </div>
                </div>
            </a>
        }
    </div>

    <div class="d-none text-muted small p-3" data-inbox-no-results>@T["Your search returned no results."]</div>

    @if (Model.HasPreviousPage || Model.HasNextPage)
    {
        <nav class="d-flex justify-content-between align-items-center p-2 border-top small" aria-label="@T["Inbox pages"]">
            <div>
                @if (Model.HasPreviousPage)
                {
                    <a class="btn btn-sm btn-outline-secondary" asp-route-action="Index" asp-route-show="@show" asp-route-channel="@Model.ChannelFilter" asp-route-page="@(Model.Page - 1)">@T["Newer"]</a>
                }
            </div>
            <span class="text-muted">@T["Page {0} of {1}", Model.Page, Math.Max(1, (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize))]</span>
            <div>
                @if (Model.HasNextPage)
                {
                    <a class="btn btn-sm btn-outline-secondary" asp-route-action="Index" asp-route-show="@show" asp-route-channel="@Model.ChannelFilter" asp-route-page="@(Model.Page + 1)">@T["Older"]</a>
                }
            </div>
        </nav>
    }
}
