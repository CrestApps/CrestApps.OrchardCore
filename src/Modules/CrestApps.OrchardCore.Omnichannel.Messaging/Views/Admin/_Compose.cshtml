@using System.Text.Json
@using CrestApps.OrchardCore.Omnichannel.Messaging.Core.Channels
@model ComposeViewModel
@inject IMessagingChannelResolver ChannelResolver

@*
    The composer sits in the conversation pane, beside the customer list, laid out like a mail client's compose window:
    labelled From and To lines separated by rules, then the message itself filling the pane, and the send bar last.
*@

<style asp-name="bootstrap-select"></style>
<script asp-name="bootstrap-select" depends-on="bootstrap" at="Foot"></script>
<style asp-name="intl-tel-input" at="Head"></style>
<script asp-name="intl-tel-input" at="Foot"></script>

<form method="post" asp-action="New" class="messaging-compose d-flex flex-column flex-grow-1 overflow-hidden no-multisubmit">
    <input type="hidden" asp-for="Channel" />

    <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom flex-shrink-0">
        <span class="fw-semibold">
            <i class="fa-solid fa-pen-to-square me-2 text-primary" aria-hidden="true"></i>@T["New message"]
        </span>
        <a class="btn btn-sm btn-link text-body-secondary" asp-action="Index" title="@T["Discard"]" aria-label="@T["Discard"]">
            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </a>
    </div>

    <div asp-validation-summary="All" class="alert alert-danger m-3 mb-0 py-2 small flex-shrink-0"></div>

    <div class="messaging-compose-line">
        <label asp-for="EndpointId" class="messaging-compose-label">@T["From"]</label>
        <div class="flex-grow-1" style="min-width: 0;">
            <select asp-for="EndpointId" asp-items="Model.Endpoints" id="endpoint-select" class="selectpicker show-tick" data-live-search="true" data-style="btn-theme border-0 bg-transparent px-0" title="@T["Choose the channel and address to send from"]"></select>
        </div>
    </div>

    <div class="messaging-compose-line">
        <label asp-for="ContactAddresses" class="messaging-compose-label">@T["To"]</label>
        <div class="flex-grow-1" style="min-width: 0;">
            <select asp-for="ContactAddresses" id="recipient-select" class="selectpicker show-tick" multiple data-live-search="true" data-style="btn-theme border-0 bg-transparent px-0"
                    title="@T["Search contacts, or type an address…"]"
                    data-messaging-contact-picker
                    data-search-url="@Url.RouteUrl("MessagingSearchContacts")"
                    data-endpoint-select="#endpoint-select"
                    data-endpoint-channels="@JsonSerializer.Serialize(Model.EndpointChannels)"
                    data-new-address-text="@T["Not in your contacts"]"
                    data-phone-channels="@JsonSerializer.Serialize(ChannelResolver.GetAll().Where(channel => channel.Capabilities.AddressesArePhoneNumbers).Select(channel => channel.Name))"
                    data-phone-hint="@T["A number that is not in your contacts must be in international format, for example +12015550123."]"
                    data-number-entry="#recipient-number-entry">
                @foreach (var contact in Model.SelectedContacts)
                {
                    <option value="@contact.Address" data-subtext="@contact.DisplayAddress" selected>@contact.Name</option>
                }
            </select>
        </div>
        <button type="button" class="btn btn-sm btn-link text-body-secondary text-nowrap px-1" id="recipient-number-toggle" hidden aria-controls="recipient-number-entry" aria-expanded="false">
            <i class="fa-solid fa-hashtag me-1" aria-hidden="true"></i>@T["Enter a number"]
        </button>
    </div>

    @* A number with its country picked from a flag, for someone who is not in the contacts. It is added to the To line
       above in E.164, so it is sent exactly as validated here. *@
    <div class="messaging-compose-line" id="recipient-number-entry" hidden
         data-number-toggle="#recipient-number-toggle"
         data-invalid-text="@T["Enter a valid number for the selected country."]">
        <span class="messaging-compose-label" aria-hidden="true"></span>
        <div class="flex-grow-1" style="min-width: 0;">
            <div class="d-flex align-items-center gap-2">
                <div class="flex-grow-1" style="min-width: 0;">
                    <input type="tel" class="form-control form-control-sm" autocomplete="off" aria-label="@T["Phone number"]" data-number-input />
                </div>
                <button type="button" class="btn btn-sm btn-primary text-nowrap" data-number-add>
                    <i class="fa-solid fa-plus me-1" aria-hidden="true"></i>@T["Add"]
                </button>
            </div>
            <div class="small text-danger mt-1" data-number-error hidden></div>
        </div>
    </div>

    <div class="messaging-compose-line">
        <label asp-for="Recipients" class="messaging-compose-label" title="@T["Addresses that are not in your contacts"]">@T["Other"]</label>
        <input asp-for="Recipients" class="form-control border-0 shadow-none px-0" autocomplete="off" placeholder="@T["Addresses not in your contacts, comma-separated"]" />
    </div>

    <div class="messaging-compose-line d-none" data-messaging-subject-line
         data-endpoint-select="#endpoint-select"
         data-endpoint-channels="@JsonSerializer.Serialize(Model.EndpointChannels)"
         data-subject-channels="@JsonSerializer.Serialize(Model.SubjectChannels)">
        <label asp-for="Subject" class="messaging-compose-label">@T["Subject"]</label>
        <input asp-for="Subject" class="form-control border-0 shadow-none px-0" autocomplete="off" maxlength="255" />
    </div>

    <textarea asp-for="Body" class="messaging-compose-body form-control border-0 rounded-0 shadow-none flex-grow-1 px-3 py-3" placeholder="@T["Write your message…"]"></textarea>

    <div class="d-flex justify-content-between align-items-center gap-3 px-3 py-2 border-top flex-shrink-0">
        <span class="text-muted small">@T["One recipient starts a conversation; several get their own private conversation each."]</span>
        <div class="d-flex gap-2 flex-shrink-0">
            <a class="btn btn-outline-secondary" asp-action="Index">@T["Discard"]</a>
            <button class="btn btn-primary" type="submit">
                <i class="fa-solid fa-paper-plane me-1" aria-hidden="true"></i>@T["Send"]
            </button>
        </div>
    </div>
</form>

<style at="Head">
    .messaging-compose-line {
        display: flex;
        align-items: center;
        gap: .75rem;
        padding: .35rem 1rem;
        border-bottom: 1px solid var(--bs-border-color-translucent);
        flex-shrink: 0;
    }

    .messaging-compose-label {
        width: 3.5rem;
        margin: 0;
        color: var(--bs-secondary-color);
        flex-shrink: 0;
    }

    .messaging-compose-body {
        resize: none;
        min-height: 8rem;
    }

    /* An empty validation summary would otherwise leave a red bar above a form that has no errors. */
    .messaging-compose .validation-summary-valid {
        display: none;
    }
</style>

<script asp-src="~/CrestApps.OrchardCore.Omnichannel.Messaging/scripts/messaging-contact-picker.min.js" debug-src="~/CrestApps.OrchardCore.Omnichannel.Messaging/scripts/messaging-contact-picker.js" depends-on="bootstrap-select" at="Foot"></script>
