@using CrestApps.OrchardCore.Omnichannel.Messaging.Models

@model EndpointRoutingViewModel

@{
    var isAgent = Model.TargetType == ConversationRouteTargetType.Agent;
    var agentUserIds = string.IsNullOrEmpty(Model.AgentUserId) ? Array.Empty<string>() : new[] { Model.AgentUserId };

    var queueEndpoint = Url.Content("~/Admin/api/crestapps/contact-center/queues/search");
    var queueInitialJson = string.IsNullOrEmpty(Model.QueueId)
        ? "[]"
        : System.Text.Json.JsonSerializer.Serialize(new[] { new { value = Model.QueueId, text = string.IsNullOrWhiteSpace(Model.QueueName) ? Model.QueueId : Model.QueueName, selected = true } });
}

<div data-messaging-routing>
    <div class="ocat-wrapper" asp-validation-class-for="TargetType">
        <label asp-for="TargetType" class="ocat-label">@T["Routes to"]</label>
        <div class="ocat-end">
            <select asp-for="TargetType" class="form-select" asp-items="Model.TargetTypes" data-messaging-routing-target-type></select>
            <span asp-validation-for="TargetType" class="text-danger"></span>
            <span class="hint">@T["Where inbound messages on this endpoint go. Leave the target empty to send them to the unassigned inbox."]</span>
        </div>
    </div>

    <div class="ocat-wrapper @(isAgent ? "" : "d-none")" data-messaging-routing-agent>
        <label class="ocat-label">@T["Agent"]</label>
        <div class="ocat-end">
            @await Component.InvokeAsync("UserPicker", new
            {
                name = Html.NameFor(m => m.AgentUserId).ToString(),
                selectedValues = agentUserIds,
                valueType = "userId",
                multiple = false,
                buttonText = T["Select an agent"].Value,
                searchPlaceholder = T["Search agents"].Value,
                smallButton = false,
            })
            <span class="hint">@T["Inbound messages become this operator's personal conversation."]</span>
        </div>
    </div>

    <div class="ocat-wrapper @(isAgent ? "d-none" : "")" data-messaging-routing-queue>
        <label class="ocat-label">@T["Queue (department)"]</label>
        <div class="ocat-end">
            @await Component.InvokeAsync("ItemSelector", new
            {
                id = "messaging-routing-queue-selector",
                inputName = Html.NameFor(m => m.QueueId).ToString(),
                endpoint = queueEndpoint,
                initialItemsJson = queueInitialJson,
                multiple = false,
                enableSearch = true,
                buttonText = T["Select a queue"].Value,
                searchPlaceholder = T["Search queues"].Value,
                emptyResultsText = T["No queues found. Enable Contact Center Work Distribution to route to a queue."].Value,
                noSelectionText = T["No queue selected."].Value,
                selectedItemsLabel = T["Selected queue"].Value,
                availableItemsLabel = T["Available queues"].Value,
                smallButton = false,
            })
            <span class="hint">@T["Inbound messages go to the shared department pool. Requires Contact Center Work Distribution."]</span>
        </div>
    </div>

    <div class="ocat-wrapper @(isAgent ? "d-none" : "")" asp-validation-class-for="DistributionMode" data-messaging-routing-queue-options>
        <label asp-for="DistributionMode" class="ocat-label">@T["Queue distribution"]</label>
        <div class="ocat-end">
            <select asp-for="DistributionMode" class="form-select" asp-items="Model.DistributionModes"></select>
            <span asp-validation-for="DistributionMode" class="text-danger"></span>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="AutoReplyMessage">
        <label asp-for="AutoReplyMessage" class="ocat-label">@T["Auto-reply"]</label>
        <div class="ocat-end">
            <input asp-for="AutoReplyMessage" class="form-control" />
            <span asp-validation-for="AutoReplyMessage" class="text-danger"></span>
            <span class="hint">@T["Optional message sent to the contact when they message this endpoint, at most once every 24 hours per conversation. Contacts who have opted out never receive it."]</span>
        </div>
    </div>
</div>

<script at="Foot">
    (function () {
        document.querySelectorAll('[data-messaging-routing]').forEach(function (root) {
            var typeSelect = root.querySelector('[data-messaging-routing-target-type]');
            if (!typeSelect) { return; }

            var agent = root.querySelector('[data-messaging-routing-agent]');
            var queue = root.querySelector('[data-messaging-routing-queue]');
            var queueOptions = root.querySelector('[data-messaging-routing-queue-options]');

            var apply = function () {
                var isAgent = typeSelect.value === 'Agent';
                if (agent) { agent.classList.toggle('d-none', !isAgent); }
                if (queue) { queue.classList.toggle('d-none', isAgent); }
                if (queueOptions) { queueOptions.classList.toggle('d-none', isAgent); }
            };

            typeSelect.addEventListener('change', apply);
            apply();
        });
    })();
</script>
