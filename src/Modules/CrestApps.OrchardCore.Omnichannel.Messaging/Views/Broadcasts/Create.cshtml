@using System.Text.Json
@using CrestApps.OrchardCore.Omnichannel.Messaging.Core
@using CrestApps.OrchardCore.Omnichannel.Messaging.Core.Channels
@model BroadcastCreateViewModel
@inject IMessagingChannelResolver ChannelResolver

<style asp-name="bootstrap-select"></style>
<script asp-name="bootstrap-select" depends-on="bootstrap" at="Foot"></script>
<style asp-name="intl-tel-input" at="Head"></style>
<script asp-name="intl-tel-input" at="Foot"></script>

<zone Name="Title">
    <breadcrumb name="MessagingBroadcastsCreate" title="@T["New broadcast"]">
        <breadcrumb-item id="MessagingBroadcasts" action="Index" controller="Broadcasts" area="CrestApps.OrchardCore.Omnichannel.Messaging" permission="@MessagingPermissions.SendGroupMessages.Name">@T["Broadcasts"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form method="post" class="no-multisubmit">
    @Html.ValidationSummary()

    <div class="mb-3">
        <label asp-for="Name" class="form-label ocat-label-required">@T["Name"]</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EndpointId" class="form-label ocat-label-required">@T["Send from"]</label>
        <select asp-for="EndpointId" asp-items="Model.Endpoints" id="endpoint-select" class="selectpicker show-tick" data-live-search="true" title="@T["Select the channel and address to send from"]"></select>
        <span class="hint">@T["The address you pick decides the channel the broadcast is sent on."]</span>
        <span asp-validation-for="EndpointId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ContactAddresses" class="form-label">@T["Recipients"]</label>
        <div class="d-flex align-items-start gap-2">
            <div class="flex-grow-1" style="min-width: 0;">
                <select asp-for="ContactAddresses" id="recipient-select" class="selectpicker show-tick" multiple data-live-search="true" title="@T["Search contacts or leads by name or address…"]"
                        data-messaging-contact-picker
                        data-search-url="@Url.RouteUrl("MessagingSearchContacts")"
                        data-endpoint-select="#endpoint-select"
                        data-endpoint-channels="@JsonSerializer.Serialize(Model.EndpointChannels)"
                        data-new-address-text="@T["Not in your contacts"]"
                        data-phone-channels="@JsonSerializer.Serialize(ChannelResolver.GetAll().Where(channel => channel.Capabilities.AddressesArePhoneNumbers).Select(channel => channel.Name))"
                        data-phone-hint="@T["A number that is not in your contacts must be in international format, for example +12015550123."]"
                        data-number-entry="#recipient-number-entry"></select>
            </div>
            <button type="button" class="btn btn-outline-secondary text-nowrap" id="recipient-number-toggle" hidden aria-controls="recipient-number-entry" aria-expanded="false">
                <i class="fa-solid fa-hashtag me-1" aria-hidden="true"></i>@T["Enter a number"]
            </button>
        </div>
        @* A number with its country picked from a flag, for someone who is not in the contacts. It is added to the
           recipients above in E.164, so it is sent exactly as validated here. *@
        <div class="mt-2" id="recipient-number-entry" hidden
             data-number-toggle="#recipient-number-toggle"
             data-invalid-text="@T["Enter a valid number for the selected country."]">
            <partial name="_RecipientNumberEntry" />
        </div>
        <span class="hint">@T["Type a name or address to search the contacts and leads reachable on the selected channel, then select recipients. Use Enter a number for someone who is not in either."]</span>
    </div>

    <div class="mb-3">
        <label asp-for="RecipientsText" class="form-label">@T["Additional addresses"]</label>
        <textarea asp-for="RecipientsText" class="form-control" rows="4" placeholder="@T["One address per line, or comma-separated"]"></textarea>
        <span class="hint">@T["Each recipient gets their own 1:1 thread; they cannot see each other."]</span>
        <span asp-validation-for="RecipientsText" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Body" class="form-label ocat-label-required">@T["Message"]</label>
        <textarea asp-for="Body" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Body" class="text-danger"></span>
    </div>

    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <button class="btn btn-primary" type="submit">@T["Queue broadcast"]</button>
            <a class="btn btn-secondary cancel" role="button" asp-route-action="Index">@T["Cancel"]</a>
        </div>
    </div>
</form>

<script asp-src="~/CrestApps.OrchardCore.Omnichannel.Messaging/scripts/messaging-contact-picker.min.js" debug-src="~/CrestApps.OrchardCore.Omnichannel.Messaging/scripts/messaging-contact-picker.js" depends-on="bootstrap-select" at="Foot"></script>
