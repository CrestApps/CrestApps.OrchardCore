@using CrestApps.OrchardCore.AI.WebCrawlers
@model EditCatalogEntryViewModel

<zone Name="Title">
    <breadcrumb name="AIWebCrawlersEdit" title="@T["Edit Web Crawler: '{0}'", Model.DisplayName]">
        <breadcrumb-item id="AIWebCrawlers" action="Index" controller="WebCrawlers" area="CrestApps.OrchardCore.AI.WebCrawlers" permission="@WebCrawlerPermissions.ManageWebCrawlers.Name">@T["Web Crawlers"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form method="post" asp-route-id="@ViewContext.HttpContext.Request.RouteValues["id"]" enctype="multipart/form-data" class="no-multisubmit">
    @Html.ValidationSummary()
    @await DisplayAsync(Model.Editor)

    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <button class="btn btn-primary" type="submit">@T["Save"]</button>
            <a class="btn btn-secondary cancel" role="button" asp-route-action="Index">@T["Cancel"]</a>
        </div>
    </div>
</form>
