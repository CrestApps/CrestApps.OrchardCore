@model CrestApps.OrchardCore.Tickets.ContactCenter.ViewModels.TicketDeskQueueViewModel

<div class="ocat-wrapper" asp-validation-class-for="QueueId">
    <label asp-for="QueueId" class="ocat-label">@T["Contact Center queue"]</label>
    <div class="ocat-end">
        <select asp-for="QueueId" asp-items="Model.Queues" class="form-select">
            <option value="">@T["None"]</option>
        </select>
        <span asp-validation-for="QueueId" class="text-danger"></span>
        <span class="hint">@T["New tickets on this desk that nobody has yet are offered to agents through this queue, with its presence, capacity and skills; the agent who accepts one gets the ticket. Agents accept offers in the agent desktop."]</span>
    </div>
</div>
