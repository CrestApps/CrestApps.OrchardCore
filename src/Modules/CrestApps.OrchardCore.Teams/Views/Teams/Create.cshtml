@using CrestApps.OrchardCore.Core.Models
@model EditCatalogEntryViewModel

<zone Name="Title">
    <breadcrumb name="TeamsCreate" title="@T["New Team"]">
        <breadcrumb-item id="TeamsIndex" action="Index" controller="Teams" area="CrestApps.OrchardCore.Teams">@T["Teams"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form method="post" asp-action="Create" class="no-multisubmit">
    @Html.ValidationSummary()
    @await DisplayAsync(Model.Editor)
    <div class="action-bar-bottom">
        <button class="btn btn-primary" type="submit">@T["Save"]</button>
        <a class="btn btn-secondary cancel" asp-action="Index">@T["Cancel"]</a>
    </div>
</form>
