@using CrestApps.OrchardCore.Carts.Core
@using CrestApps.OrchardCore.Products.Core.Services
@using OrchardCore.ContentManagement

@model CartViewModel

@*
    The cart page. Every line is priced again each time the page is shown; a line that can no longer be bought as it
    is says why, and the cart cannot be checked out until it is changed or removed.
*@

@{
    var pricing = Model.Pricing;
    var currency = pricing.Currency;

    string Format(decimal amount) => ProductPriceFormatter.Format(amount, currency);
}

<div class="product-cart mb-4">
    @if (pricing.Lines.Count == 0)
    {
        <div class="text-center border rounded py-5 px-3" role="status">
            <span class="fa-solid fa-cart-shopping fa-2x text-muted mb-3 d-block" aria-hidden="true"></span>
            <p class="h5">@T["Your cart is empty."]</p>
            <a href="@Url.Content("~/")" class="btn btn-outline-primary mt-2">@T["Continue shopping"]</a>
        </div>

        return;
    }

    <div class="row g-4">
        <div class="col-lg-8">
            <ul class="list-group">
                @foreach (var line in pricing.Lines)
                {
                    var formId = "cart-line-" + line.Line.LineId;

                    <li class="list-group-item py-3 product-cart-line">
                        <div class="d-flex flex-wrap justify-content-between gap-3">
                            <div class="flex-grow-1">
                                <div class="fw-semibold">
                                    @if (line.ContentItem is not null)
                                    {
                                        <a display-for="@line.ContentItem">@line.Title</a>
                                    }
                                    else
                                    {
                                        @T["A product that is no longer available"]
                                    }
                                </div>
                                @if (line.Price?.Price is { Name.Length: > 0 } price)
                                {
                                    <div class="small text-muted">@price.Name</div>
                                }
                                @if (!string.IsNullOrEmpty(line.Product?.Sku))
                                {
                                    <div class="small text-muted">@T["SKU {0}", line.Product.Sku]</div>
                                }
                                @if (line.ShipsFromUtc is { } shipsFrom)
                                {
                                    <div class="small text-info-emphasis"><span class="fa-solid fa-calendar-day me-1" aria-hidden="true"></span>@T["Pre-order: ships {0:D}", shipsFrom]</div>
                                }
                                @foreach (var addOn in line.AddOns)
                                {
                                    <div class="small">
                                        <span class="fa-solid fa-pen-to-square text-body-secondary me-1" aria-hidden="true"></span>@(string.IsNullOrEmpty(addOn.Value) ? addOn.Label : addOn.Label + ": " + addOn.Value)
                                        @if (addOn.Price > 0)
                                        {
                                            <span class="text-muted">(+@Format(addOn.Price))</span>
                                        }
                                    </div>
                                }
                                @if (line.IsAvailable)
                                {
                                    <div class="small text-muted">@T["{0} each", Format(line.UnitPrice)]</div>
                                }
                                @if (line.IsAvailable && line.PriceChanged)
                                {
                                    <div class="small"><span class="fa-solid fa-circle-info text-primary" aria-hidden="true"></span> @T["The price changed since you added it."]</div>
                                }
                                @if (!line.IsAvailable)
                                {
                                    <div class="alert alert-warning py-1 px-2 mt-2 mb-0 small" role="alert">@line.Problem</div>
                                }
                            </div>

                            <div class="d-flex align-items-start gap-2">
                                @if (line.IsAvailable && line.MaxQuantity > 1)
                                {
                                    // A product sold in packs steps by its pack size, as on its own page.
                                    var packSize = line.ContentItem is not null && line.ContentItem.TryGet<CrestApps.OrchardCore.Products.Core.Models.ProductPart>(out var productPart) && productPart.QuantityStep is > 1
                                        ? productPart.QuantityStep.Value
                                        : 1;

                                    <form method="post" asp-route="@CartConstants.RouteNames.Update" class="d-flex gap-1" id="@formId">
                                        <input type="hidden" name="lineId" value="@line.Line.LineId" />
                                        <label class="visually-hidden" for="@(formId)-quantity">@T["Quantity of {0}", line.Title]</label>
                                        <input type="number" name="quantity" id="@(formId)-quantity" min="0" max="@line.MaxQuantity" step="@packSize" value="@line.Line.Quantity" class="form-control form-control-sm" style="width: 5rem" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">@T["Update"]</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="small text-muted pt-1">@T["Qty {0}", line.Line.Quantity]</span>
                                }
                                <form method="post" asp-route="@CartConstants.RouteNames.Remove">
                                    <input type="hidden" name="lineId" value="@line.Line.LineId" />
                                    <button type="submit" class="btn btn-sm btn-link text-danger" title="@T["Remove {0}", line.Title]">
                                        <span class="fa-solid fa-trash-can" aria-hidden="true"></span>
                                        <span class="visually-hidden">@T["Remove {0}", line.Title]</span>
                                    </button>
                                </form>
                            </div>

                            <div class="text-end fw-semibold" style="min-width: 6rem">
                                @(line.IsAvailable ? Format(line.LineTotal) : "—")
                            </div>
                        </div>
                    </li>
                }
            </ul>

            @* Product Recommendations fills this with what goes with the cart's products; without it, nothing shows. *@
            @await DisplayAsync(await New.CartRecommendations(ContentItems: pricing.Lines.Select(line => line.ContentItem).Where(item => item is not null).ToArray()))
        </div>

        <div class="col-lg-4">
            <div class="card product-cart-summary">
                <div class="card-body">
                    <h2 class="h5 card-title">@T["Summary"]</h2>
                    <div class="d-flex justify-content-between">
                        <span>@T.Plural(pricing.ItemCount, "Subtotal (1 item)", "Subtotal ({0} items)")</span>
                        <span class="fw-semibold">@Format(pricing.Subtotal)</span>
                    </div>
                    <p class="small text-muted mt-2 mb-3">@T["Discounts and taxes are worked out at checkout."]</p>

                    @if (string.IsNullOrEmpty(Model.CheckoutUrl))
                    {
                        <p class="small text-muted mb-0">@T["Checkout isn't available on this site yet."]</p>
                    }
                    else if (!pricing.CanCheckout)
                    {
                        <button type="button" class="btn btn-primary w-100" disabled>@T["Checkout"]</button>
                        <p class="small text-muted mt-2 mb-0">@T["Change or remove the items marked above to check out."]</p>
                    }
                    else
                    {
                        <form method="post" action="@Model.CheckoutUrl" asp-antiforgery="true">
                            <button type="submit" class="btn btn-primary w-100">@T["Checkout"]</button>
                        </form>
                    }

                    @foreach (var action in Model.Actions)
                    {
                        <a href="@action.Url" class="btn btn-outline-secondary w-100 mt-2">@action.Label</a>
                        @if (!string.IsNullOrEmpty(action.Description))
                        {
                            <p class="small text-muted mt-1 mb-0">@action.Description</p>
                        }
                    }
                </div>
            </div>
            <a href="@Url.Content("~/")" class="d-inline-block mt-3 small">@T["Continue shopping"]</a>
        </div>
    </div>
</div>
