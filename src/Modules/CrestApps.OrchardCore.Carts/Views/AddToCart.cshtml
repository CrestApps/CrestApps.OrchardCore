@using CrestApps.OrchardCore.Carts.Core
@using CrestApps.OrchardCore.Products.Core.Services

@model AddToCartViewModel

@*
    The Add to cart action on a product's card and page. It is an ordinary form, so it works without JavaScript and
    returns the visitor to the page they added from.
*@

@{
    var formId = "add-to-cart-" + Model.ContentItemId;
}

@if (Model.Variants.Count > 0 && Model.Options.Count > 0)
{
    <script asp-name="product-variant-picker" at="Foot"></script>
}

<form method="post" asp-route="@CartConstants.RouteNames.Add" class="product-add-to-cart w-100" id="@formId" data-product-variant-form="@(Model.Options.Count > 0 ? "" : null)" data-sku-template="@T["SKU {0}"].Value">
    <input type="hidden" name="contentItemId" value="@Model.ContentItemId" />
    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

    @if (Model.Variants.Count > 0)
    {
        @* One list per option, shown by the script; without it, the list of variants below is used. *@
        @if (Model.Options.Count > 0)
        {
            <div class="d-none" data-product-variant-options>
                @for (var i = 0; i < Model.Options.Count; i++)
                {
                    var option = Model.Options[i];

                    <div class="mb-2">
                        <label class="form-label small text-muted" for="@(formId)-option-@i">@option.Name</label>
                        <select id="@(formId)-option-@i" class="form-select form-select-sm" data-product-option="@option.Name">
                            @foreach (var value in option.Values)
                            {
                                <option value="@value">@value</option>
                            }
                        </select>
                    </div>
                }
            </div>
        }

        <div class="mb-2" data-product-variant-fallback>
            <label class="form-label small text-muted" for="@(formId)-variant">@T["Choose"]</label>
            <select name="variantId" id="@(formId)-variant" class="form-select form-select-sm" data-product-variant>
                @foreach (var variant in Model.Variants)
                {
                    var label = string.IsNullOrEmpty(variant.Price) ? variant.Title : variant.Title + " — " + variant.Price;

                    <option value="@variant.VariantId" data-sku="@variant.Sku" data-price="@variant.Price" data-image="@variant.ImagePath" data-options="@System.Text.Json.JsonSerializer.Serialize(variant.Options)" data-availability="@variant.Availability?.Label" data-availability-tone="@variant.Availability?.Tone" data-buyable="@((variant.Availability?.CanBuy ?? true) ? "true" : "false")">
                        @(variant.Availability is null ? label : label + " (" + variant.Availability.Label + ")")
                    </option>
                }
            </select>
        </div>
    }

    @if (Model.Prices.Count > 1)
    {
        <div class="mb-2">
            <label class="form-label small text-muted" for="@(formId)-price">@T["Option"]</label>
            <select name="priceId" id="@(formId)-price" class="form-select form-select-sm">
                @foreach (var price in Model.Prices)
                {
                    var amount = ProductPriceFormatter.Format(price.Amount, price.Currency);

                    <option value="@price.PriceId" selected="@(price.PriceId == Model.DefaultPriceId)">
                        @(string.IsNullOrWhiteSpace(price.Name) ? amount : price.Name + " — " + amount)
                    </option>
                }
            </select>
        </div>
    }
    else if (!string.IsNullOrEmpty(Model.DefaultPriceId))
    {
        <input type="hidden" name="priceId" value="@Model.DefaultPriceId" />
    }

    @{
        var initial = Model.Variants.Count > 0 ? Model.Variants[0].Availability : Model.Availability;
        var canBuy = initial?.CanBuy ?? true;
    }
    <p class="product-availability small mb-2 text-@(initial?.Tone ?? "success")" data-product-availability hidden="@(initial is null)">@initial?.Label</p>

    @if (Model.RoleDiscount is not null)
    {
        <p class="small text-success mb-2"><span class="fa-solid fa-tag me-1" aria-hidden="true"></span>@T["Your {0} pricing: {1}% off, in your cart.", Model.RoleDiscount.Role, Model.RoleDiscount.PercentOff.ToString("0.##")]</p>
    }

    @if (Model.PriceTiers.Count > 0)
    {
        <ul class="list-unstyled small mb-2 product-price-tiers">
            @foreach (var tier in Model.PriceTiers)
            {
                <li><span class="fa-solid fa-layer-group text-body-secondary me-1" aria-hidden="true"></span>@T["Buy {0} or more: {1}% off each", tier.MinQuantity, tier.PercentOff.ToString("0.##")]</li>
            }
        </ul>
    }

    @if (Model.MinQuantity > 1 || Model.QuantityStep > 1)
    {
        <p class="small text-body-secondary mb-2">
            @if (Model.QuantityStep > 1)
            {
                @T["Sold in packs of {0}.", Model.QuantityStep]
            }
            @if (Model.MinQuantity > Model.QuantityStep)
            {
                @T["Buy at least {0}.", Model.MinQuantity]
            }
        </p>
    }

    @* On a narrow card the button wraps under the quantity rather than breaking its label. *@
    <div class="d-flex flex-wrap gap-2">
        @if ((Model.MaxQuantity > 1 || Model.MinQuantity > 1) && canBuy)
        {
            <input type="number"
                   name="quantity"
                   id="@(formId)-quantity"
                   min="@Model.MinQuantity"
                   max="@Model.MaxQuantity"
                   step="@Model.QuantityStep"
                   value="@Model.MinQuantity"
                   class="form-control product-add-to-cart-quantity"
                   style="flex: 0 0 4.5rem; max-width: 4.5rem"
                   aria-label="@T["Quantity"]" />
        }
        <button type="submit" class="btn btn-primary text-nowrap" style="flex: 1 1 8rem" disabled="@(!canBuy)">
            <span class="fa-solid fa-cart-plus" aria-hidden="true"></span>
            @T["Add to cart"]
        </button>
    </div>
</form>
