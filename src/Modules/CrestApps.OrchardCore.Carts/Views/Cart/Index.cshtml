@model IShape

@* The breadcrumb also gives the browser tab its title. *@
<div class="product-breadcrumb">
    <breadcrumb name="Cart" title="@T["Cart"]">
        <breadcrumb-item id="Home" url="@Url.Content("~/")">@T["Home"]</breadcrumb-item>
    </breadcrumb>
</div>

<h1 class="mt-2">@T["Cart"]</h1>

@await DisplayAsync(Model)
