@model IShape

<zone Name="Title">
    <breadcrumb name="AccountOrders" title="@T["Orders"]">
        <breadcrumb-item id="CommerceAccount" url="@Url.RouteUrl(CommerceConstants.Account.HomeRouteName)">@T["Your account"]</breadcrumb-item>
    </breadcrumb>
</zone>

<div class="container my-4">
    <div class="row g-4">
        <div class="col-lg-3">
            @await DisplayAsync(await New.CommerceAccountNavigation())
        </div>
        <div class="col-lg-9">
            <h1 class="h3 mb-3">@T["Orders"]</h1>

            @await DisplayAsync(Model)
        </div>
    </div>
</div>
