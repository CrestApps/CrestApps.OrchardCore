@model IShape

@{
    var order = (OrderViewViewModel)Model;
}

<zone Name="Title">
    <breadcrumb name="AccountOrder" title="@T["Order {0}", order.Order.OrderNumber]">
        <breadcrumb-item id="CommerceAccount" url="@Url.RouteUrl(CommerceConstants.Account.HomeRouteName)">@T["Your account"]</breadcrumb-item>
        <breadcrumb-item id="AccountOrders" url="@Url.RouteUrl("AccountOrders")">@T["Orders"]</breadcrumb-item>
    </breadcrumb>
</zone>

@await DisplayAsync(await New.CommerceAccountPage(Content: Model))
