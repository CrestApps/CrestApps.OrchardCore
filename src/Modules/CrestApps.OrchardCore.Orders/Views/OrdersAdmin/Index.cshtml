@model OrdersIndexViewModel

<zone Name="Title">
    @if (Model.IsOwnOrders)
    {
        <breadcrumb name="MyOrders" title="@T["My Orders"]" />
    }
    else
    {
        <breadcrumb name="Orders" title="@T["Orders"]" />
    }
</zone>

@if (!Model.IsOwnOrders)
{
    <form asp-action="Index" asp-route-pageSize="@Context.Request.Query["pageSize"]" method="post" id="orders-filter" class="no-multisubmit">
        <input type="submit" name="submit.Filter" id="submitFilter" class="visually-hidden" />

        <div class="card text-bg-theme mb-3 position-sticky action-bar">
            <div class="card-body">
                <div class="row gx-2">
                    <div class="col">
                        <div class="input-group">
                            <input asp-for="Options.Search" class="form-control" placeholder="@T["Search by order number or customer email"]" type="search" autocomplete="off" />
                            <button type="submit" name="submit.Filter" class="btn btn-outline-secondary" title="@T["Search"]" aria-label="@T["Search"]"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
                        </div>
                    </div>
                    <div class="col-auto">
                        <a asp-controller="DraftOrdersAdmin" asp-action="Create" class="btn btn-secondary create">@T["Create order"]</a>
                    </div>
                    <div class="col-auto">
                        @* The orders the list shows, with its search and status, a row per line. *@
                        <a asp-action="Export"
                           asp-route-Options.Search="@Model.Options.Search"
                           asp-route-Options.Status="@(Model.Options.Status == OrderStatusFilter.Placed ? null : Model.Options.Status.ToString())"
                           class="btn btn-outline-secondary"
                           title="@T["Export the orders shown to a CSV file"]">
                            <i class="fa-solid fa-file-csv" aria-hidden="true"></i><span class="d-none d-sm-inline ms-1">@T["Export CSV"]</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </form>
}

@* The orders, the toolbar and the pager are rendered by the AdminList shape, in the layout (List or Grid) the site or the user picked.
   A customer's own orders are a list of their own, so each keeps the layout the user picked for it. *@
<admin-list name="@(Model.IsOwnOrders ? "MyOrders" : "Orders")" context="Model.List"
            show-select-all="false"
            empty-message="@(Model.IsOwnOrders ? T["You haven't placed any orders yet."] : T["<strong>Nothing here!</strong> There are no orders that match the current filter."])">
    <admin-list-list item-css-class="list-group-item" />
    <admin-list-grid>
        <admin-list-column name="Name" position="20" title="@T["Order"]" />
        <admin-list-column name="Status" position="30" title="@T["Status"]" width="auto" />
        <admin-list-column name="Placed" position="40" title="@T["Placed"]" width="auto" />
        <admin-list-column name="Items" position="50" title="@T["Items"]" width="auto" />
        <admin-list-column name="Total" position="60" title="@T["Total"]" width="auto" />
        @if (!Model.IsOwnOrders)
        {
            <admin-list-column name="Customer" position="70" title="@T["Customer"]" width="auto" />
        }
        <admin-list-column type="Actions" title="@T["Actions"]" />
    </admin-list-grid>
</admin-list>

@if (!Model.IsOwnOrders)
{
    <style asp-name="bootstrap-select"></style>
    <script asp-name="commerce-admin-list" at="Foot"></script>
}
