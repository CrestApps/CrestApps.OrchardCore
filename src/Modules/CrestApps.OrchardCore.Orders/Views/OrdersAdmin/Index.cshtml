@using CrestApps.OrchardCore.Products.Core.Services

@model OrdersIndexViewModel

<zone Name="Title">
    @if (Model.IsOwnOrders)
    {
        <breadcrumb name="MyOrders" title="@T["My Orders"]" />
    }
    else
    {
        <breadcrumb name="OrdersIndex" title="@T["Orders"]" />
    }
</zone>

@if (!Model.IsOwnOrders)
{
    <form asp-action="Index" asp-route-pageSize="@Context.Request.Query["pageSize"]" method="post" id="orders-filter" class="no-multisubmit">
        <input type="submit" name="submit.Filter" id="submitFilter" class="visually-hidden" />

        <div class="card text-bg-theme mb-3 position-sticky action-bar">
            <div class="card-body">
                <div class="has-search">
                    <i class="fa-solid fa-search form-control-feedback" aria-hidden="true"></i>
                    <input asp-for="Options.Search" class="form-control" placeholder="@T["Search by order number or customer email"]" type="search" autocomplete="off" />
                </div>
            </div>
        </div>
    </form>
}

<ul class="list-group">
    <li class="list-group-item text-bg-theme">
        <div class="row gx-3 align-items-center">
            <div class="col text-nowrap">
                @T.Plural(Model.TotalCount, "1 order", "{0} orders")
            </div>
            @if (!Model.IsOwnOrders)
            {
                <div class="col col-md-auto text-end">
                    <div class="btn-group filter">
                        <select asp-for="Options.Status" asp-items="Model.Options.Statuses" form="orders-filter" class="selectpicker show-tick" data-style="btn-sm" data-width="fit" data-header="@T["Filter by status"]" data-dropdown-align-right="auto" data-commerce-list-filter aria-label="@T["Status"]"></select>
                    </div>
                </div>
            }
        </div>
    </li>
    @if (Model.Orders.Count > 0)
    {
        @foreach (var order in Model.Orders)
        {
            <li class="list-group-item">
                <div class="row g-0">
                    <div class="col-lg col-12 title d-flex align-items-center">
                        <div class="summary">
                            <div class="d-flex flex-column flex-md-row align-items-md-center">
                                <div class="me-2">
                                    <h5 class="mb-1 mb-md-0"><a asp-action="Detail" asp-route-orderId="@order.ItemId">@order.OrderNumber</a></h5>
                                </div>
                                <div class="tags me-1">
                                    @await Html.PartialAsync("_OrderStatus", order.Status)
                                </div>
                            </div>
                            <div class="metadata mt-1">
                                <span class="badge ta-badge font-weight-normal" data-bs-toggle="tooltip" title="@T["Placed"]">
                                    <i class="fa-regular fa-calendar text-secondary" aria-hidden="true"></i><span class="visually-hidden">@T["Placed"]</span>
                                    @order.CreatedUtc.ToString("g")
                                </span>
                                <span class="badge ta-badge font-weight-normal" data-bs-toggle="tooltip" title="@T["Items"]">
                                    <i class="fa-solid fa-box text-secondary" aria-hidden="true"></i><span class="visually-hidden">@T["Items"]</span>
                                    @T.Plural(order.ItemCount, "1 item", "{0} items")
                                </span>
                                <span class="badge ta-badge font-weight-normal" data-bs-toggle="tooltip" title="@T["Total"]">
                                    <i class="fa-solid fa-money-bill text-secondary" aria-hidden="true"></i><span class="visually-hidden">@T["Total"]</span>
                                    @ProductPriceFormatter.Format(order.Total ?? order.Subtotal, order.Currency)
                                </span>
                                @if (!Model.IsOwnOrders && !string.IsNullOrEmpty(order.CustomerEmail))
                                {
                                    <span class="badge ta-badge font-weight-normal" data-bs-toggle="tooltip" title="@T["Customer"]">
                                        <i class="fa-regular fa-user text-secondary" aria-hidden="true"></i><span class="visually-hidden">@T["Customer"]</span>
                                        @(string.IsNullOrEmpty(order.CustomerName) ? order.CustomerEmail : $"{order.CustomerName} <{order.CustomerEmail}>")
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-auto col-12 d-flex justify-content-end align-items-center">
                        <a class="btn btn-primary btn-sm" asp-action="Detail" asp-route-orderId="@order.ItemId">@T["View"]</a>
                    </div>
                </div>
            </li>
        }
    }
    else
    {
        <li class="list-group-item">
            <div class="alert alert-info mb-0" role="alert">
                @(Model.IsOwnOrders ? T["You haven't placed any orders yet."] : T["<strong>Nothing here!</strong> There are no orders that match the current filter."])
            </div>
        </li>
    }
</ul>

@await DisplayAsync(Model.Pager)

<style asp-name="bootstrap-select"></style>
<script asp-name="commerce-admin-list" at="Foot"></script>
