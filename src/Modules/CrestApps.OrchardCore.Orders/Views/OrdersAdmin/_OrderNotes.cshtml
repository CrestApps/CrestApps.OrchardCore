@using CrestApps.OrchardCore.Orders.Core

@model OrderDetailViewModel

@* The order's notes and history are its timeline: what the store wrote, and what happened, such as a refund. *@
<div class="mt-4">
    @await Component.InvokeAsync("Timeline", new { subject = $"{OrderConstants.RecordKind}:{Model.Order.ItemId}", title = T["Notes"].Value })
</div>
