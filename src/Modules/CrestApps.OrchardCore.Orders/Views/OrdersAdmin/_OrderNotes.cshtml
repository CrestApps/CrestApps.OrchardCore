@model OrderDetailViewModel
@inject OrchardCore.Modules.ILocalClock LocalClock
@functions {
    // Stored times are UTC; people read them in the site's time zone.
    private async Task<DateTime> LocalAsync(DateTime utc)
        => (await LocalClock.ConvertToLocalAsync(DateTime.SpecifyKind(utc, DateTimeKind.Utc))).DateTime;
}

@{
    var order = Model.Order;
}

<div class="card mt-4">
    <div class="card-header">@T["Notes"]</div>
    <div class="card-body">
        <form asp-action="AddNote" asp-route-orderId="@order.ItemId" method="post" class="mb-3">
            <label class="form-label visually-hidden" for="order-note">@T["Note"]</label>
            <textarea id="order-note" name="text" rows="2" class="form-control mb-2" maxlength="2000" placeholder="@T["Write a note for the store"]"></textarea>
            <button type="submit" class="btn btn-sm btn-outline-primary">@T["Add note"]</button>
        </form>

        @if (order.Notes is not { Count: > 0 })
        {
            <p class="text-muted mb-0">@T["No notes yet."]</p>
        }
        else
        {
            <ul class="list-unstyled mb-0">
                @foreach (var note in Enumerable.Reverse(order.Notes))
                {
                    <li class="border-top pt-2 mt-2">
                        <div class="small text-muted">
                            <i class="@(note.Kind == OrderNoteKind.Event ? "fa-solid fa-bolt" : "fa-regular fa-note-sticky") me-1" aria-hidden="true"></i>
                            @((await LocalAsync(note.CreatedUtc)).ToString("g")) ·
                            @if (string.IsNullOrEmpty(note.AuthorName))
                            {
                                @T["The site"]
                            }
                            else
                            {
                                @note.AuthorName
                            }
                        </div>
                        <div style="white-space: pre-line">@note.Text</div>
                    </li>
                }
            </ul>
        }
    </div>
</div>
