@using CrestApps.OrchardCore.Orders
@model GiftCardCreateViewModel

<zone Name="Title">
    <breadcrumb name="GiftCardsCreate" title="@T["Issue gift card"]">
        <breadcrumb-item id="GiftCards" action="Index" controller="GiftCardsAdmin" area="CrestApps.OrchardCore.Orders" permission="@OrderPermissions.ManageGiftCards.Name">@T["Gift cards"]</breadcrumb-item>
    </breadcrumb>
</zone>

@* The form keeps its own validation (required fields), so the question is asked by the crestapps-browser helpers. *@
<script asp-name="crestapps-browser" at="Foot"></script>

<form asp-action="Create" method="post" class="no-multisubmit" data-confirm-title="@T["Issue gift card"]" data-confirm="@T["Issue this gift card? Its balance can be spent at once."]" data-confirm-ok="@T["Issue"]" data-confirm-cancel="@T["Cancel"]">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <button type="submit" class="btn btn-primary">@T["Issue"]</button>
        <a class="btn btn-secondary" asp-action="Index">@T["Cancel"]</a>
    </div>
</form>
