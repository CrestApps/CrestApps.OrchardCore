@using CrestApps.OrchardCore.Orders
@model GiftCardCreateViewModel

<zone Name="Title">
    <breadcrumb name="GiftCardsCreate" title="@T["Issue gift card"]">
        <breadcrumb-item id="GiftCards" action="Index" controller="GiftCardsAdmin" area="CrestApps.OrchardCore.Orders" permission="@OrderPermissions.ManageGiftCards.Name">@T["Gift cards"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="ocat-limited-wrapper" asp-validation-class-for="Value">
        <label asp-for="Value" class="ocat-label ocat-label-required">@T["Amount"]</label>
        <div class="ocat-limited">
            <input asp-for="Value" type="number" step="0.01" min="0.01" class="form-control" required />
            <span asp-validation-for="Value"></span>
        </div>
    </div>

    <div class="ocat-limited-wrapper" asp-validation-class-for="Currency">
        <label asp-for="Currency" class="ocat-label ocat-label-required">@T["Currency"]</label>
        <div class="ocat-limited">
            <input asp-for="Currency" class="form-control" maxlength="3" />
            <span asp-validation-for="Currency"></span>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="Code">
        <label asp-for="Code" class="ocat-label">@T["Code"]</label>
        <div class="ocat-end">
            <input asp-for="Code" class="form-control font-monospace" autocomplete="off" />
            <span asp-validation-for="Code"></span>
            <span class="hint">@T["Optional. Leave it blank to have a 16-character code made up, which nobody can guess."]</span>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="RecipientName">
        <label asp-for="RecipientName" class="ocat-label">@T["Recipient's name"]</label>
        <div class="ocat-end">
            <input asp-for="RecipientName" class="form-control" />
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="RecipientEmail">
        <label asp-for="RecipientEmail" class="ocat-label">@T["Recipient's email"]</label>
        <div class="ocat-end">
            <input asp-for="RecipientEmail" type="email" class="form-control" />
            <span asp-validation-for="RecipientEmail"></span>
        </div>
    </div>

    <div class="ocat-limited-wrapper" asp-validation-class-for="ExpiresUtc">
        <label asp-for="ExpiresUtc" class="ocat-label">@T["Expires (UTC)"]</label>
        <div class="ocat-limited">
            <input asp-for="ExpiresUtc" type="datetime-local" class="form-control" />
            <span asp-validation-for="ExpiresUtc"></span>
            <span class="hint">@T["Optional. Leave blank for a card that never expires; some places require that."]</span>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="Message">
        <label asp-for="Message" class="ocat-label">@T["Message"]</label>
        <div class="ocat-end">
            <textarea asp-for="Message" class="form-control" rows="2"></textarea>
            <span class="hint">@T["Optional. Shown in the email with the card."]</span>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="Note">
        <label asp-for="Note" class="ocat-label">@T["Note"]</label>
        <div class="ocat-end">
            <input asp-for="Note" class="form-control" />
            <span class="hint">@T["Optional. For the store only, such as why the card was given."]</span>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="SendEmail">
        <div class="ocat-end-offset">
            <div class="form-check">
                <input asp-for="SendEmail" class="form-check-input" />
                <label asp-for="SendEmail" class="form-check-label">@T["Email the card"]</label>
            </div>
            <span class="hint dashed">@T["Sends the code to the recipient's email, with how to use it."]</span>
        </div>
    </div>

    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <button type="submit" class="btn btn-primary">@T["Issue"]</button>
            <a class="btn btn-secondary" asp-action="Index">@T["Cancel"]</a>
        </div>
    </div>
</form>
