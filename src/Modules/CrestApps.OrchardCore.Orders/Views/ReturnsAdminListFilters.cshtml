@*
    The "Show" filter of the returns list, passed to the admin list as its 'ToolbarActions'. The select names the
    filter form, so it submits it wherever the list is rendered; the commerce-admin-list script submits it when it
    changes.
*@
@{
    var options = (OrderReturnIndexOptions)Model.Options;
}

<div class="btn-group filter">
    <select name="Options.Show" asp-items="options.Filters" form="returns-filter" class="selectpicker show-tick" data-style="btn-sm" data-width="fit" data-header="@T["Show"]" data-dropdown-align-right="auto" data-commerce-list-filter aria-label="@T["Show"]"></select>
</div>
