@model ShapeViewModel<GiftCardPart>

<div class="alert alert-info mb-3" role="note">
    <i class="fa-solid fa-gift me-1" aria-hidden="true"></i>
    @T["This product is a gift card. Each one bought issues a gift card worth its price, emailed to the buyer once the order is paid; a discount on the order doesn't make the card worth less. Manage the cards under Commerce > Gift cards."]
</div>
