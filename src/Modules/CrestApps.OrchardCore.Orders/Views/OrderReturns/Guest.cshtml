@model IShape

@{
    var form = (OrderReturnRequestViewModel)Model;
}

<zone Name="Title">
    <breadcrumb name="GuestOrderReturn" title="@T["Return items"]">
        <breadcrumb-item id="OrdersView" url="@form.BackUrl">@T["Order {0}", form.Order.OrderNumber]</breadcrumb-item>
    </breadcrumb>
</zone>

<div class="container my-4" style="max-width: 860px;">
    @await DisplayAsync(Model)
</div>
