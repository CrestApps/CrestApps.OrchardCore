@model IShape

@{
    var form = (OrderReturnRequestViewModel)Model;
}

<zone Name="Title">
    <breadcrumb name="AccountOrderReturn" title="@T["Return items"]">
        <breadcrumb-item id="CommerceAccount" url="@Url.RouteUrl(CommerceConstants.Account.HomeRouteName)">@T["Your account"]</breadcrumb-item>
        <breadcrumb-item id="AccountOrders" url="@Url.RouteUrl("AccountOrders")">@T["Orders"]</breadcrumb-item>
        <breadcrumb-item id="AccountOrder" url="@form.BackUrl">@T["Order {0}", form.Order.OrderNumber]</breadcrumb-item>
    </breadcrumb>
</zone>

<div class="container my-4">
    <div class="row g-4">
        <div class="col-lg-3">
            @await DisplayAsync(await New.CommerceAccountNavigation())
        </div>
        <div class="col-lg-9">
            @await DisplayAsync(Model)
        </div>
    </div>
</div>
