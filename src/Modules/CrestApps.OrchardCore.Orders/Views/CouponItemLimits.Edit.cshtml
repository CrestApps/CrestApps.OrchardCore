@model CouponItemLimitsViewModel

@* A buy X get Y offer counts what the customer buys separately from what they get; the coupon editor shows this part
   only for that kind of coupon. *@
<div data-coupon-kinds="@((int)CrestApps.OrchardCore.Checkout.Models.CouponKind.BuyXGetY)">
    <h5 class="mt-2">@T["What the customer buys"]</h5>
    <p class="text-muted">@T["Optional. Leave both blank to count any item. Only these count toward the items bought and the minimums."]</p>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label" for="@Html.IdFor(model => model.BuyProductIds)">@T["Products bought"]</label>
            @await Component.InvokeAsync("ItemSelector", new
            {
                id = Html.IdFor(model => model.BuyProductIds),
                inputName = Html.NameFor(model => model.BuyProductIds),
                endpoint = Model.ProductSearchEndpoint,
                initialItemsJson = Model.InitialBuyProductsJson,
                multiple = true,
                enableSearch = true,
                buttonText = T["Choose products"].Value,
                searchPlaceholder = T["Search products"].Value,
                emptyResultsText = T["No products match."].Value,
                smallButton = false,
            })
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label" for="@Html.IdFor(model => model.BuyCategoryIds)">@T["Categories bought"]</label>
            @await Component.InvokeAsync("ItemSelector", new
            {
                id = Html.IdFor(model => model.BuyCategoryIds),
                inputName = Html.NameFor(model => model.BuyCategoryIds),
                endpoint = Model.CategorySearchEndpoint,
                initialItemsJson = Model.InitialBuyCategoriesJson,
                multiple = true,
                enableSearch = true,
                buttonText = T["Choose categories"].Value,
                searchPlaceholder = T["Search categories"].Value,
                emptyResultsText = T["No categories match."].Value,
                smallButton = false,
            })
        </div>
    </div>
</div>

<h5 class="mt-2" data-coupon-kinds="@((int)CrestApps.OrchardCore.Checkout.Models.CouponKind.Percentage) @((int)CrestApps.OrchardCore.Checkout.Models.CouponKind.FixedAmount) @((int)CrestApps.OrchardCore.Checkout.Models.CouponKind.FreeShipping)">@T["Products and categories"]</h5>
<h5 class="mt-2" data-coupon-kinds="@((int)CrestApps.OrchardCore.Checkout.Models.CouponKind.BuyXGetY)">@T["What the customer gets"]</h5>
<p class="text-muted" data-coupon-kinds="@((int)CrestApps.OrchardCore.Checkout.Models.CouponKind.Percentage) @((int)CrestApps.OrchardCore.Checkout.Models.CouponKind.FixedAmount) @((int)CrestApps.OrchardCore.Checkout.Models.CouponKind.FreeShipping)">@T["Optional. Leave both blank for a code that applies to everything in the order. Otherwise it takes something off only these products and the products in these categories, and only they count toward its minimum and maximum amounts."]</p>
<p class="text-muted" data-coupon-kinds="@((int)CrestApps.OrchardCore.Checkout.Models.CouponKind.BuyXGetY)">@T["The items the customer gets at the percentage off. Leave both blank for any item; the cheapest are the ones discounted."]</p>

<div class="row">
    <div class="col-md-6 mb-3">
        <label class="form-label" for="@Html.IdFor(model => model.ProductIds)">@T["Only for products"]</label>
        @await Component.InvokeAsync("ItemSelector", new
        {
            id = Html.IdFor(model => model.ProductIds),
            inputName = Html.NameFor(model => model.ProductIds),
            endpoint = Model.ProductSearchEndpoint,
            initialItemsJson = Model.InitialProductsJson,
            multiple = true,
            enableSearch = true,
            buttonText = T["Choose products"].Value,
            searchPlaceholder = T["Search products"].Value,
            emptyResultsText = T["No products match."].Value,
            smallButton = false,
        })
    </div>
    <div class="col-md-6 mb-3">
        <label class="form-label" for="@Html.IdFor(model => model.CategoryIds)">@T["Only for categories"]</label>
        @await Component.InvokeAsync("ItemSelector", new
        {
            id = Html.IdFor(model => model.CategoryIds),
            inputName = Html.NameFor(model => model.CategoryIds),
            endpoint = Model.CategorySearchEndpoint,
            initialItemsJson = Model.InitialCategoriesJson,
            multiple = true,
            enableSearch = true,
            buttonText = T["Choose categories"].Value,
            searchPlaceholder = T["Search categories"].Value,
            emptyResultsText = T["No categories match."].Value,
            smallButton = false,
        })
        <span class="hint">@T["Categories are the terms of your taxonomies, such as a product type's category field."]</span>
    </div>
</div>
