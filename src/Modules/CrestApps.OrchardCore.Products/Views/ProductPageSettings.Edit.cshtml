@using CrestApps.OrchardCore.Products.ViewModels

@model ProductPageSettingsViewModel

<div class="ocat-wrapper">
    <div class="ocat-end">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" asp-for="ShowDetails" />
            <label class="form-check-label" asp-for="ShowDetails">@T["Show product details on the product page"]</label>
            <span class="hint dashed">@T["Adds the price, the specification table and the product actions to the page of each product of this type."]</span>
        </div>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="InquiryLabel" class="ocat-label">@T["Inquiry button"]</label>
    <div class="ocat-end">
        <input asp-for="InquiryLabel" class="form-control" placeholder="@T["Request information"]" />
        <span class="hint">@T["The button shown on products that cannot be bought online. Leave it empty for no button."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="InquiryUrl" class="ocat-label">@T["Inquiry link"]</label>
    <div class="ocat-end">
        <input asp-for="InquiryUrl" class="form-control" placeholder="/contact?product={id}" />
        <span class="hint">@T["Where the inquiry button leads. {0} and {1} are replaced with the product's identifier and title.", "{id}", "{title}"]</span>
    </div>
</div>
