@using CrestApps.OrchardCore.Core.Models
@using CrestApps.OrchardCore.Products.Models
@using Microsoft.AspNetCore.Mvc.Localization

@model ListCatalogEntryViewModel<CatalogEntryViewModel<CurrencyEntry>>

<zone Name="Title">
    <breadcrumb name="Currencies" title="@T["Currencies"]" />
</zone>

@* The post form provides the antiforgery token used by the delete action. *@
<form asp-action="Index" method="post" class="no-multisubmit">
    <input type="submit" name="submit.Filter" id="submitFilter" class="visually-hidden" />

    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <div class="input-group">
                        <input id="search-box" asp-for="Options.Search" class="form-control" placeholder="@T["Search"]" type="search" autofocus autocomplete="off" />
                        <button type="submit" name="submit.Filter" class="btn btn-outline-secondary" title="@T["Search"]" aria-label="@T["Search"]"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
                    </div>
                </div>
                <div class="col-auto">
                    <a class="btn btn-secondary create" role="button" asp-action="Create">@T["Add Currency"]</a>
                </div>
            </div>
        </div>
    </div>

    @* The currencies, the toolbar and the pager are rendered by the AdminList shape, in the layout (List or Grid) the site or the user picked. *@
    <admin-list name="Currencies" context="Model.List"
                show-select-all="false"
                empty-message="@T["<strong>Nothing here!</strong> There are no managed currencies at the moment."]">
        <admin-list-list item-css-class="list-group-item" />
        <admin-list-grid>
            <admin-list-column name="Name" position="20" title="@T["Name"]" />
            <admin-list-column name="Code" position="30" title="@T["Code"]" width="auto" />
            <admin-list-column type="Actions" title="@T["Actions"]" />
        </admin-list-grid>
    </admin-list>
</form>
