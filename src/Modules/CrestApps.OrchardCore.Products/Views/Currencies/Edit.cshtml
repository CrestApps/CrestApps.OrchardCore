@using CrestApps.OrchardCore.Core.Models
@using CrestApps.OrchardCore.Products

@model EditCatalogEntryViewModel

<zone Name="Title">
    <breadcrumb name="ProductsCurrenciesEdit" title="@(T["Edit Currency '{0}'", Model.DisplayName])">
        <breadcrumb-item id="ProductsCurrencies" action="Index" controller="Currencies" area="CrestApps.OrchardCore.Products" permission="@ProductsConstants.Permissions.ManageCurrencies.Name">@T["Currencies"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form method="post" asp-route-id="@ViewContext.HttpContext.Request.RouteValues["id"]" enctype="multipart/form-data" class="no-multisubmit">
    @Html.ValidationSummary()
    @await DisplayAsync(Model.Editor)

    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <button class="btn btn-primary" type="submit">@T["Save"]</button>
            <a class="btn btn-secondary cancel" role="button" asp-route-action="Index">@T["Cancel"]</a>
        </div>
    </div>
</form>
