@using CrestApps.OrchardCore.Products.ViewModels

@model ProductListingPartViewModel

@{
    var typeNames = Model.ContentTypes.ToDictionary(type => type.Name, type => type.DisplayName, StringComparer.Ordinal);

    // Rows are grouped by the product types their field belongs to: first what every product has (the price,
    // the type), then one group per type, then fields that several types share.
    string GroupKey(IList<string> types) => string.Join(',', types.Order(StringComparer.Ordinal));

    string GroupLabel(string key) => string.IsNullOrEmpty(key)
        ? T["All product types"].Value
        : string.Join(", ", key.Split(',').Select(name => typeNames.TryGetValue(name, out var displayName) ? displayName : name));

    int GroupRank(string key) => string.IsNullOrEmpty(key) ? 0 : key.Contains(',') ? 2 : 1;

    var facetGroups = Model.Facets
        .Select((row, index) => (Row: row, Index: index))
        .GroupBy(item => GroupKey(item.Row.ContentTypes))
        .OrderBy(group => GroupRank(group.Key))
        .ThenBy(group => GroupLabel(group.Key), StringComparer.CurrentCultureIgnoreCase)
        .ToList();

    var sortGroups = Model.Sorts
        .Select((row, index) => (Row: row, Index: index))
        .GroupBy(item => GroupKey(item.Row.ContentTypes))
        .OrderBy(group => GroupRank(group.Key))
        .ThenBy(group => GroupLabel(group.Key), StringComparer.CurrentCultureIgnoreCase)
        .ToList();
}

<div data-product-listing-editor>
    <div class="ocat-wrapper">
        <label class="ocat-label">@T["Products"]</label>
        <div class="ocat-end">
            @if (Model.ContentTypes.Count == 0)
            {
                <div class="alert alert-warning mb-0">@T["No content type has a Product part yet. Attach the Product part to a content type to list it here."]</div>
            }
            else
            {
                @for (var i = 0; i < Model.ContentTypes.Count; i++)
                {
                    var type = Model.ContentTypes[i];
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" name="@Html.NameFor(m => m.SelectedContentTypes)" value="@type.Name" id="@Html.IdFor(m => m.SelectedContentTypes)-@i" checked="@type.Selected" data-product-type />
                        <label class="form-check-label" for="@Html.IdFor(m => m.SelectedContentTypes)-@i">@type.DisplayName</label>
                    </div>
                }
                <span class="hint">@T["The product types this page lists. Every product type is listed when none is selected. The filters and sorts below follow the types you pick."]</span>
            }
        </div>
    </div>

    <div class="ocat-wrapper">
        <label class="ocat-label">@T["Filters"]</label>
        <div class="ocat-end">
            <div class="form-check mb-2">
                <input type="checkbox" class="form-check-input" asp-for="AutomaticFacets" />
                <label class="form-check-label" asp-for="AutomaticFacets">@T["Offer a filter for every filterable field"]</label>
                <span class="hint dashed">@T["When unchecked, only the filters ticked below are offered, in their order."]</span>
            </div>

            @if (Model.Facets.Count == 0)
            {
                <p class="hint">@T["No field of these product types is marked as filterable yet. Mark fields as Filterable in the content type's field settings."]</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th scope="col">@T["Use"]</th>
                                <th scope="col">@T["Field"]</th>
                                <th scope="col">@T["Label"]</th>
                                <th scope="col">@T["URL key"]</th>
                                <th scope="col">@T["Kind"]</th>
                                <th scope="col">@T["Style"]</th>
                                <th scope="col">@T["Term level"]</th>
                                <th scope="col">@T["Shown after"]</th>
                                <th scope="col">@T["Visible options"]</th>
                                <th scope="col">@T["Collapsed"]</th>
                                <th scope="col">@T["Ranges"]</th>
                                <th scope="col">@T["Order"]</th>
                            </tr>
                        </thead>
                        @foreach (var group in facetGroups)
                        {
                            <tbody data-product-types="@group.Key">
                                <tr class="table-light">
                                    <th scope="rowgroup" colspan="12" class="small text-uppercase">@GroupLabel(group.Key)</th>
                                </tr>
                                @foreach (var (row, i) in group)
                                {
                                    <tr>
                                        <td>
                                            <input type="checkbox" class="form-check-input" asp-for="Facets[i].Enabled" aria-label="@T["Use this filter"]" />
                                            <input type="hidden" asp-for="Facets[i].AttributeKey" />
                                        </td>
                                        <td>@row.AttributeLabel</td>
                                        <td><input class="form-control form-control-sm" asp-for="Facets[i].Label" placeholder="@row.AttributeLabel" /></td>
                                        <td><input class="form-control form-control-sm" asp-for="Facets[i].Key" /></td>
                                        <td><select class="form-select form-select-sm" asp-for="Facets[i].Kind" asp-items="Model.FacetKinds"></select></td>
                                        <td><select class="form-select form-select-sm" asp-for="Facets[i].Display" asp-items="Model.FacetDisplays" aria-label="@T["How the options are drawn"]"></select></td>
                                        <td>
                                            @if (row.IsTerm)
                                            {
                                                <input type="number" min="0" class="form-control form-control-sm" asp-for="Facets[i].Level" placeholder="@T["All"]" />
                                            }
                                        </td>
                                        <td><input class="form-control form-control-sm" asp-for="Facets[i].DependsOn" placeholder="@T["URL key"]" /></td>
                                        <td><input type="number" min="0" class="form-control form-control-sm" asp-for="Facets[i].MaxVisible" /></td>
                                        <td><input type="checkbox" class="form-check-input" asp-for="Facets[i].Collapsed" aria-label="@T["Start collapsed"]" /></td>
                                        <td><input type="checkbox" class="form-check-input" asp-for="Facets[i].ShowRanges" aria-label="@T["Offer ready-made ranges"]" /></td>
                                        <td><input type="number" class="form-control form-control-sm" asp-for="Facets[i].Order" /></td>
                                    </tr>
                                }
                            </tbody>
                        }
                    </table>
                </div>
                <span class="hint">@T["Term level offers one level of a taxonomy, such as 1 for makes and 2 for models. Shown after hides a filter until the filter with that URL key has a selection. Style draws checkbox and radio options as a list, buttons (sizes) or color swatches (option names that are CSS colors). Ranges offers ready-made ranges, such as Up to $50, above a range filter."]</span>
            }
        </div>
    </div>

    <div class="ocat-wrapper">
        <label class="ocat-label">@T["Sorting"]</label>
        <div class="ocat-end">
            <div class="form-check mb-2">
                <input type="checkbox" class="form-check-input" asp-for="AutomaticSorts" />
                <label class="form-check-label" asp-for="AutomaticSorts">@T["Offer the standard sorts and every sortable field"]</label>
                <span class="hint dashed">@T["When unchecked, only the sorts ticked below are offered, in their order."]</span>
            </div>

            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th scope="col">@T["Use"]</th>
                            <th scope="col">@T["Label"]</th>
                            <th scope="col">@T["URL key"]</th>
                            <th scope="col">@T["Order"]</th>
                        </tr>
                    </thead>
                    @foreach (var group in sortGroups)
                    {
                        <tbody data-product-types="@group.Key">
                            <tr class="table-light">
                                <th scope="rowgroup" colspan="4" class="small text-uppercase">@GroupLabel(group.Key)</th>
                            </tr>
                            @foreach (var (row, i) in group)
                            {
                                <tr>
                                    <td>
                                        <input type="checkbox" class="form-check-input" asp-for="Sorts[i].Enabled" aria-label="@T["Use this sort"]" />
                                        <input type="hidden" asp-for="Sorts[i].AttributeKey" />
                                        <input type="hidden" asp-for="Sorts[i].Descending" />
                                    </td>
                                    <td><input class="form-control form-control-sm" asp-for="Sorts[i].Label" /></td>
                                    <td><input class="form-control form-control-sm" asp-for="Sorts[i].Key" /></td>
                                    <td><input type="number" class="form-control form-control-sm" asp-for="Sorts[i].Order" /></td>
                                </tr>
                            }
                        </tbody>
                    }
                </table>
            </div>
        </div>
    </div>

    <div class="ocat-wrapper">
        <label asp-for="DefaultSort" class="ocat-label">@T["Default sort"]</label>
        <div class="ocat-end">
            <select asp-for="DefaultSort" asp-items="Model.SortOptions" class="form-select">
                <option value="">@T["The first sort"]</option>
            </select>
            <span class="hint">@T["The sort visitors see before they pick one."]</span>
        </div>
    </div>

    <div class="ocat-wrapper">
        <label asp-for="DefaultView" class="ocat-label">@T["Layout"]</label>
        <div class="ocat-end">
            <select asp-for="DefaultView" asp-items="Model.Views" class="form-select"></select>
            <div class="form-check mt-2">
                <input type="checkbox" class="form-check-input" asp-for="AllowViewSwitching" />
                <label class="form-check-label" asp-for="AllowViewSwitching">@T["Let visitors switch between grid and list"]</label>
            </div>
        </div>
    </div>

    <div class="ocat-wrapper">
        <label asp-for="ImageAspectRatio" class="ocat-label">@T["Image shape"]</label>
        <div class="ocat-end">
            <select asp-for="ImageAspectRatio" asp-items="Model.ImageAspectRatios" class="form-select"></select>
            <span class="hint">@T["The shape of product images on the cards. Images are cropped to fit."]</span>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="PageSizes">
        <label asp-for="PageSizes" class="ocat-label">@T["Page sizes"]</label>
        <div class="ocat-end">
            <input asp-for="PageSizes" class="form-control" placeholder="12, 24, 48" />
            <span class="hint">@T["The page sizes visitors can pick from, separated by commas."]</span>
            <span asp-validation-for="PageSizes"></span>
        </div>
    </div>

    <div class="ocat-wrapper">
        <label asp-for="DefaultPageSize" class="ocat-label">@T["Default page size"]</label>
        <div class="ocat-end">
            <input type="number" min="1" max="200" asp-for="DefaultPageSize" class="form-control" />
            <span class="hint">@T["The page size visitors see before they pick one. It must be one of the page sizes."]</span>
        </div>
    </div>

    <div class="ocat-wrapper">
        <div class="ocat-end">
            <div class="form-check">
                <input type="checkbox" class="form-check-input" asp-for="EnableKeywordSearch" />
                <label class="form-check-label" asp-for="EnableKeywordSearch">@T["Keyword search"]</label>
                <span class="hint dashed">@T["Adds a search box that matches titles, SKUs and searchable fields."]</span>
            </div>
        </div>
    </div>
</div>

<script at="Foot">
    // Shows the filter and sort groups of the product types that are ticked, and every group when none is.
    (function () {
        document.querySelectorAll('[data-product-listing-editor]').forEach(function (editor) {
            var boxes = editor.querySelectorAll('[data-product-type]');

            function update() {
                var picked = Array.prototype.filter.call(boxes, function (box) { return box.checked; })
                    .map(function (box) { return box.value; });

                editor.querySelectorAll('tbody[data-product-types]').forEach(function (group) {
                    var types = group.getAttribute('data-product-types');
                    var visible = !types || picked.length === 0 || types.split(',').some(function (type) {
                        return picked.indexOf(type) >= 0;
                    });

                    group.hidden = !visible;
                });
            }

            boxes.forEach(function (box) {
                box.addEventListener('change', update);
            });

            update();
        });
    })();
</script>
