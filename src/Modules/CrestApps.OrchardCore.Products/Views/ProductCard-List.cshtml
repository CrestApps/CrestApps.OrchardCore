@using CrestApps.OrchardCore.Products.ViewModels

@model ProductCardViewModel

<article class="product-card product-card-row card">
    <div class="row g-0 h-100">
        <div class="col-sm-5 col-md-4">
            <div class="product-card-media h-100">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="" class="product-listing-cover" loading="lazy" />
                }
                else
                {
                    <span class="product-card-placeholder" aria-hidden="true"><span class="fa-regular fa-image fa-2x"></span></span>
                }
                @if (Model.DiscountPercent > 0)
                {
                    <span class="product-card-badge badge bg-danger">@T["−{0}%", Model.DiscountPercent]<span class="visually-hidden"> @T["off"]</span></span>
                }
            </div>
        </div>
        <div class="col-sm-7 col-md-8">
            <div class="card-body product-card-body h-100">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                    <h3 class="product-card-title product-card-title-lg">
                        @if (string.IsNullOrEmpty(Model.Url))
                        {
                            @Model.Title
                        }
                        else
                        {
                            <a href="@Model.Url" class="stretched-link">@Model.Title</a>
                        }
                    </h3>
                    @await DisplayAsync(Model.Price)
                </div>
                @if (Model.Specifications.Count > 0)
                {
                    <dl class="product-card-specifications">
                        @foreach (var specification in Model.Specifications)
                        {
                            <div>
                                <dt>@specification.Label</dt>
                                <dd>@specification.Value</dd>
                            </div>
                        }
                    </dl>
                }
                @if (Model.ShowAvailability && Model.IsPurchasable)
                {
                    <span class="product-card-availability mt-auto"><span class="fa-solid fa-circle-check" aria-hidden="true"></span> @T["Buy online"]</span>
                }
                <div class="product-card-actions">
                    @await DisplayAsync(Model.Actions)
                </div>
            </div>
        </div>
    </div>
</article>
