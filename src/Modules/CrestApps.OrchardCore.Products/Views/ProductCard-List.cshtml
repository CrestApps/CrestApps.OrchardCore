@using CrestApps.OrchardCore.Products.ViewModels

@model ProductCardViewModel

<article class="card shadow-sm overflow-hidden">
    <div class="row g-0">
        <div class="col-md-5 col-lg-4">
            <a display-for="@Model.ContentItem" class="ratio ratio-4x3 d-block bg-light h-100" tabindex="-1" aria-hidden="true">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="" class="w-100 h-100 product-listing-cover" loading="lazy" />
                }
                else
                {
                    <span class="d-flex align-items-center justify-content-center text-muted">
                        <span class="fa-regular fa-image fa-2x" aria-hidden="true"></span>
                    </span>
                }
            </a>
        </div>
        <div class="col-md-7 col-lg-8">
            <div class="card-body d-flex flex-column h-100 gap-2">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                    <h3 class="card-title h5 mb-0">
                        <a display-for="@Model.ContentItem" class="text-reset text-decoration-none">@Model.Title</a>
                    </h3>
                    @await DisplayAsync(Model.Price)
                </div>
                @if (Model.Specifications.Count > 0)
                {
                    <dl class="row small mb-0">
                        @foreach (var specification in Model.Specifications)
                        {
                            <dt class="col-5 col-xl-4 fw-semibold text-muted">@specification.Label</dt>
                            <dd class="col-7 col-xl-8 mb-1">@specification.Value</dd>
                        }
                    </dl>
                }
                <div class="mt-auto d-flex flex-wrap align-items-center gap-3">
                    <a display-for="@Model.ContentItem" class="btn btn-primary">@T["Details"]<span class="visually-hidden">: @Model.Title</span></a>
                    @if (Model.IsPurchasable)
                    {
                        <span class="small text-success"><span class="fa-solid fa-cart-shopping" aria-hidden="true"></span> @T["Available to buy online"]</span>
                    }
                </div>
            </div>
        </div>
    </div>
</article>
