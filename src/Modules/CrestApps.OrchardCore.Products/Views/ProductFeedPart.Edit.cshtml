@model CrestApps.OrchardCore.Products.Feeds.ProductFeedPartViewModel

<fieldset class="mb-3">
    <legend class="h6">@T["Shopping feeds"]</legend>
    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="Brand" class="form-label">@T["Brand"]</label>
            <input asp-for="Brand" class="form-control" maxlength="70" />
        </div>
        <div class="col-md-4">
            <label asp-for="Gtin" class="form-label">@T["GTIN"]</label>
            <input asp-for="Gtin" class="form-control" maxlength="14" inputmode="numeric" />
            <span asp-validation-for="Gtin" class="text-danger"></span>
            <span class="hint">@T["The barcode's number: UPC, EAN or ISBN."]</span>
        </div>
        <div class="col-md-4">
            <label asp-for="Mpn" class="form-label">@T["MPN"]</label>
            <input asp-for="Mpn" class="form-control" maxlength="70" />
            <span class="hint">@T["The maker's part number."]</span>
        </div>
        <div class="col-md-4">
            <label asp-for="Condition" class="form-label">@T["Condition"]</label>
            <select asp-for="Condition" class="form-select">
                <option value="">@T["The store's default"]</option>
                <option value="new">@T["New"]</option>
                <option value="refurbished">@T["Refurbished"]</option>
                <option value="used">@T["Used"]</option>
            </select>
        </div>
        <div class="col-md-8">
            <label asp-for="GoogleProductCategory" class="form-label">@T["Google product category"]</label>
            <input asp-for="GoogleProductCategory" class="form-control" maxlength="250" />
        </div>
    </div>
    <div class="form-check mt-2">
        <input asp-for="ExcludeFromFeeds" type="checkbox" class="form-check-input" />
        <label asp-for="ExcludeFromFeeds" class="form-check-label">@T["Leave it out of shopping feeds"]</label>
    </div>
</fieldset>
