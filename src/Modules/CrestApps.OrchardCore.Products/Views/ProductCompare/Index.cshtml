@using OrchardCore.DisplayManagement
@model IShape

@* The comparison page. The products side by side are the ProductCompare shape, which a theme can override. *@

<zone Name="Title">
    <breadcrumb name="ProductCompare" title="@T["Compare products"]" />
</zone>

<h1 class="h3 my-4">@T["Compare products"]</h1>

@await DisplayAsync(Model)
