@using CrestApps.OrchardCore.Products.ViewModels

@model ProductDetailsShapeViewModel

@*
    What a visitor can do with the product. Modules add their actions, such as a subscribe form, to the product's
    ProductAction display, rendered here.
*@

@{
    var product = Model.Product;
    var actions = await DisplayAsync(product.ProductActions);
    using var writer = new System.IO.StringWriter();
    actions?.WriteTo(writer, System.Text.Encodings.Web.HtmlEncoder.Default);
    var rendered = writer.ToString();
    var hasActions = !string.IsNullOrWhiteSpace(rendered);
}

<div class="product-actions" data-product-actions>
    @if (hasActions)
    {
        @Html.Raw(rendered)
    }
    else if (product.IsPurchasable)
    {
        <p class="product-actions-availability text-success mb-0">
            <span class="fa-solid fa-circle-check" aria-hidden="true"></span>
            @T["Available to buy online"]
        </p>
    }

    @if (!product.IsPurchasable)
    {
        @if (!string.IsNullOrEmpty(product.InquiryLabel) && !string.IsNullOrEmpty(product.InquiryUrl))
        {
            <a class="btn btn-primary w-100" href="@product.InquiryUrl">@product.InquiryLabel</a>
        }
        <p class="product-actions-availability text-muted small mt-2 mb-0">@T["Not sold online. Contact us to buy."]</p>
    }
</div>
