@using CrestApps.OrchardCore.Products.Core.Listing
@using CrestApps.OrchardCore.Products.ViewModels

@model ProductFacetViewModel

@*
    A filter with checkboxes or radio buttons. Alternates: ProductFacet-{Kind} (Checkbox, Radio, Range, Toggle) and
    ProductFacet-{Key}, for example ProductFacet-color to show color swatches.
*@

@{
    var id = $"facet-{Model.Key}";
    var visible = Model.MaxVisible > 0 ? Model.MaxVisible : int.MaxValue;
    var options = Model.Options;
    var extraSelected = options.Skip(visible).Any(option => option.Selected);
    var expanded = !Model.Collapsed || Model.HasSelection;
    var inputType = Model.Kind == ProductFacetKind.Radio ? "radio" : "checkbox";
}

<section class="product-facet" data-facet="@Model.Key">
    <h3 class="product-facet-heading">
        <button class="product-facet-toggle @(expanded ? null : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#@id" aria-expanded="@(expanded ? "true" : "false")" aria-controls="@id">
            <span>
                @Model.Label
                @if (Model.SelectedCount > 0)
                {
                    <span class="badge rounded-pill bg-primary ms-1">@Model.SelectedCount<span class="visually-hidden"> @T["selected"]</span></span>
                }
            </span>
            <span class="fa-solid fa-chevron-down product-facet-chevron" aria-hidden="true"></span>
        </button>
    </h3>
    <div class="collapse @(expanded ? "show" : null)" id="@id">
        <fieldset class="product-facet-body">
            <legend class="visually-hidden">@Model.Label</legend>
            @if (Model.Kind == ProductFacetKind.Radio)
            {
                <div class="form-check product-facet-option">
                    <input class="form-check-input" type="radio" name="@Model.Key" value="" id="@id-any" checked="@(!Model.HasSelection)" />
                    <label class="form-check-label" for="@id-any">@T["Any"]</label>
                </div>
            }
            @for (var i = 0; i < options.Count; i++)
            {
                var option = options[i];
                var optionId = $"{id}-{i}";

                if (i == visible)
                {
                    @Html.Raw($"<div class=\"collapse{(extraSelected ? " show" : string.Empty)}\" id=\"{id}-more\">")
                }

                <div class="form-check product-facet-option">
                    <input class="form-check-input" type="@inputType" name="@Model.Key" value="@option.Value" id="@optionId" checked="@option.Selected" />
                    <label class="form-check-label" for="@optionId">
                        <span class="product-facet-option-label">@option.Label</span>
                        <span class="product-facet-count">@option.Count</span>
                    </label>
                </div>
            }
            @if (options.Count > visible)
            {
                @Html.Raw("</div>")
                <button type="button" class="product-facet-more btn btn-link btn-sm p-0 @(extraSelected ? null : "collapsed")" data-bs-toggle="collapse" data-bs-target="#@id-more" aria-expanded="@(extraSelected ? "true" : "false")" aria-controls="@id-more">
                    <span class="product-facet-more-show">@T["Show {0} more", options.Count - visible]</span>
                    <span class="product-facet-more-hide">@T["Show less"]</span>
                </button>
            }
        </fieldset>
        @if (Model.HasSelection)
        {
            <a href="@Model.ClearUrl" class="product-facet-clear small" data-product-listing-link>@T["Clear"]</a>
        }
    </div>
</section>
