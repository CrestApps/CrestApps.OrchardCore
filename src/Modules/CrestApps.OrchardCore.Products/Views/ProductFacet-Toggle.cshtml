@using CrestApps.OrchardCore.Products.ViewModels

@model ProductFacetViewModel

@{
    var option = Model.Options.FirstOrDefault();
    var id = $"facet-{Model.Key}";
}

@if (option is not null)
{
    <section class="product-facet product-facet-switch" data-facet="@Model.Key">
        <div class="form-check form-switch product-facet-option mb-0">
            <input class="form-check-input" type="checkbox" role="switch" name="@Model.Key" value="true" id="@id" checked="@option.Selected" />
            <label class="form-check-label" for="@id">
                <span class="product-facet-option-label fw-semibold">@Model.Label</span>
                <span class="product-facet-count">@option.Count</span>
            </label>
        </div>
    </section>
}
