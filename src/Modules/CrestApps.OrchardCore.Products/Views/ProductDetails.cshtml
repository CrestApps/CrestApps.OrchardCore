@using CrestApps.OrchardCore.Products.ViewModels

@model ProductDetailsViewModel

@if (Model.ContentItem is not null)
{
    <section class="card shadow-sm my-4" aria-label="@T["Product details"]">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    @await DisplayAsync(Model.Price)
                    @if (!string.IsNullOrEmpty(Model.Sku))
                    {
                        <div class="small text-muted">@T["SKU: {0}", Model.Sku]</div>
                    }
                </div>
                <div class="d-flex flex-wrap gap-2" data-product-actions>
                    @if (Model.IsPurchasable)
                    {
                        <span class="text-success"><span class="fa-solid fa-cart-shopping" aria-hidden="true"></span> @T["Available to buy online"]</span>
                    }
                    else if (!string.IsNullOrEmpty(Model.InquiryLabel) && !string.IsNullOrEmpty(Model.InquiryUrl))
                    {
                        <a class="btn btn-primary" href="@Model.InquiryUrl">@Model.InquiryLabel</a>
                    }
                </div>
            </div>

            @if (Model.Specifications.Count > 0)
            {
                <h2 class="h5 mt-4">@T["Specifications"]</h2>
                <table class="table table-sm table-striped mb-0">
                    <tbody>
                        @foreach (var specification in Model.Specifications)
                        {
                            <tr>
                                <th scope="row" class="w-50 fw-semibold">@specification.Label</th>
                                <td>@specification.Value</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </section>
}
