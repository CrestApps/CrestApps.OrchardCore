@using CrestApps.OrchardCore.Products.ViewModels

@model ProductAttributeSettingsViewModel

<h5 class="mt-3">@T["Product listing"]</h5>
<p class="hint">@T["Applies when this field is on a product type and the Product Listing feature is enabled."]</p>

<div class="mb-3">
    <div class="form-check">
        <input type="checkbox" class="form-check-input" asp-for="Filterable" />
        <label class="form-check-label" asp-for="Filterable">@T["Filterable"]</label>
        <span class="hint dashed">@T["Visitors can filter listings by this field."]</span>
    </div>
</div>

@if (Model.CanSort)
{
    <div class="mb-3">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" asp-for="Sortable" />
            <label class="form-check-label" asp-for="Sortable">@T["Sortable"]</label>
            <span class="hint dashed">@T["Visitors can sort listings by this field."]</span>
        </div>
    </div>
}

<div class="mb-3">
    <div class="form-check">
        <input type="checkbox" class="form-check-input" asp-for="Searchable" />
        <label class="form-check-label" asp-for="Searchable">@T["Searchable"]</label>
        <span class="hint dashed">@T["Keyword search matches this field's value."]</span>
    </div>
</div>

<div class="mb-3">
    <div class="form-check">
        <input type="checkbox" class="form-check-input" asp-for="ShowOnCard" />
        <label class="form-check-label" asp-for="ShowOnCard">@T["Show on product cards"]</label>
        <span class="hint dashed">@T["Shown as a short chip on the product's card in the grid."]</span>
    </div>
</div>

<div class="mb-3">
    <div class="form-check">
        <input type="checkbox" class="form-check-input" asp-for="ShowInSpecifications" />
        <label class="form-check-label" asp-for="ShowInSpecifications">@T["Show in specifications"]</label>
        <span class="hint dashed">@T["Shown in the specification table of list rows and the product page."]</span>
    </div>
</div>

<div class="mb-3">
    <label asp-for="Label" class="form-label">@T["Listing label"]</label>
    <input asp-for="Label" class="form-control" />
    <span class="hint">@T["The label visitors see. Leave it empty to use the field's display name."]</span>
</div>

@if (Model.IsNumber)
{
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="NumberFormat" class="form-label">@T["Number format"]</label>
            <input asp-for="NumberFormat" class="form-control" placeholder="#,0.##" />
            <span class="hint">@T["A .NET format string, such as 0 for a year or #,0 for a mileage."]</span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Suffix" class="form-label">@T["Unit"]</label>
            <input asp-for="Suffix" class="form-control" placeholder="@T["mi"]" />
            <span class="hint">@T["Text shown after the number, such as mi or sq ft."]</span>
        </div>
    </div>
}
