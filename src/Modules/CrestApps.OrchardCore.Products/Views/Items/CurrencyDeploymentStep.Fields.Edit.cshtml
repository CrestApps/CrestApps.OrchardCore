@using CrestApps.OrchardCore.Products.ViewModels

@model CurrencyDeploymentStepViewModel

<div class="ocat-wrapper">
    <div class="ocat-label">@T["Currencies"]</div>
    <div class="ocat-end">
        <div class="form-check mb-3">
            <label class="form-check-label">
                <input class="form-check-input" asp-for="IncludeAll" data-bs-toggle="collapse" role="button" data-bs-target="#currency-list" aria-expanded="false" aria-controls="currency-list" />
                @T["Include all currencies"]
            </label>
        </div>

        <div id="currency-list" class="collapse@(Model.IncludeAll ? string.Empty : " show")">
            <div class="hint mb-1">@T["The currencies to export as part of the deployment plan."]</div>

            <div class="mb-3">
                @for (var i = 0; i < Model.Currencies.Length; i++)
                {
                    <div class="form-check">
                        <input type="hidden" asp-for="Currencies[i].ItemId" />
                        <input asp-for="Currencies[i].IsSelected" type="checkbox" class="form-check-input">
                        <label class="form-check-label" asp-for="Currencies[i].IsSelected">@Model.Currencies[i].DisplayName <span class="text-muted">(@Model.Currencies[i].Name)</span></label>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
