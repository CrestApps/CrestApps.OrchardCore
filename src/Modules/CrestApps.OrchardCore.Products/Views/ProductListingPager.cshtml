@using CrestApps.OrchardCore.Products.ViewModels

@model ProductListingShapeViewModel

@{
    var listing = Model.Listing;
}

@*
    Numbered pages in every mode, so the listing works without JavaScript and crawlers reach every page. With
    "Load more" or infinite scroll, the script hides them and shows the button, which adds the next page's products.
*@

@if (listing.Paging != CrestApps.OrchardCore.Products.Core.Listing.ProductListingPaging.Pages && listing.NextPageUrl is not null)
{
    <div class="product-listing-more text-center mt-4 d-none" data-product-listing-more="@(listing.Paging == CrestApps.OrchardCore.Products.Core.Listing.ProductListingPaging.InfiniteScroll ? "infinite" : "button")">
        <a class="btn btn-outline-primary" href="@listing.NextPageUrl" rel="next" data-product-listing-next>@T["Load more"]</a>
    </div>
}

@if (listing.PageLinks.Count > 0)
{
    <nav class="product-listing-pager mt-4" aria-label="@T["Pages"]" data-product-listing-pages="@(listing.Paging == CrestApps.OrchardCore.Products.Core.Listing.ProductListingPaging.Pages ? null : "replaceable")">
        <ul class="pagination flex-wrap justify-content-center">
            <li class="page-item @(listing.PreviousPageUrl is null ? "disabled" : null)">
                @if (listing.PreviousPageUrl is null)
                {
                    <span class="page-link"><span aria-hidden="true">&lsaquo;</span> @T["Previous"]</span>
                }
                else
                {
                    <a class="page-link" href="@listing.PreviousPageUrl" rel="prev" data-product-listing-link><span aria-hidden="true">&lsaquo;</span> @T["Previous"]</a>
                }
            </li>
            @foreach (var link in listing.PageLinks)
            {
                if (link.Page is null)
                {
                    <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                }
                else if (link.Current)
                {
                    <li class="page-item active" aria-current="page"><span class="page-link">@link.Page</span></li>
                }
                else
                {
                    <li class="page-item"><a class="page-link" href="@link.Url" data-product-listing-link>@link.Page</a></li>
                }
            }
            <li class="page-item @(listing.NextPageUrl is null ? "disabled" : null)">
                @if (listing.NextPageUrl is null)
                {
                    <span class="page-link">@T["Next"] <span aria-hidden="true">&rsaquo;</span></span>
                }
                else
                {
                    <a class="page-link" href="@listing.NextPageUrl" rel="next" data-product-listing-link>@T["Next"] <span aria-hidden="true">&rsaquo;</span></a>
                }
            </li>
        </ul>
    </nav>
}
