@using CrestApps.OrchardCore.Products.Core.Models
@model ShapeViewModel<ProductPart>

@*
    The Compare toggle on a product's card and page, and once per page the bar that opens the comparison. The products
    picked are kept in the shopper's browser, up to four.
*@

<button type="button" class="btn btn-link btn-sm p-0 mt-1 product-compare-toggle position-relative" style="z-index: 2" data-compare-toggle="@Model.Value.ContentItem.ContentItemId" aria-pressed="false">
    <span class="fa-regular fa-square me-1" data-compare-off aria-hidden="true"></span><span class="fa-solid fa-square-check me-1 d-none" data-compare-on aria-hidden="true"></span>@T["Compare"]
</button>

<div class="product-compare-bar d-none" data-compare-bar data-url="@Url.RouteUrl("ProductCompare")" data-max="4" data-full-text="@T["You can compare up to 4 products. Remove one first."]">
    <div class="container d-flex flex-wrap align-items-center justify-content-between gap-2 py-2">
        <span data-compare-count-text data-one="@T["1 product to compare"]" data-many="@(T["{0} products to compare"].Value)"></span>
        <span class="d-flex gap-2">
            <button type="button" class="btn btn-link btn-sm text-white" data-compare-clear>@T["Clear"]</button>
            <a class="btn btn-light btn-sm" data-compare-go href="#">@T["Compare"]</a>
        </span>
    </div>
</div>

<style at="Head">
    .product-compare-bar {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 1030;
        background: var(--bs-dark);
        color: #fff;
    }
</style>

<script at="Foot">
    (function () {
        if (window.crestAppsCompare) {
            return;
        }

        window.crestAppsCompare = true;

        var key = 'crestapps.compare';
        var bars = document.querySelectorAll('[data-compare-bar]');
        var bar = bars[0];

        // One bar serves the page.
        for (var i = 1; i < bars.length; i++) {
            bars[i].remove();
        }

        // Rendered inside the first card, the bar moves to the page body so no card's styles hold it in place.
        if (bar) {
            document.body.appendChild(bar);
        }

        function read() {
            try {
                var list = JSON.parse(window.localStorage.getItem(key) || '[]');

                return Array.isArray(list) ? list : [];
            } catch (e) {
                return [];
            }
        }

        function write(list) {
            try {
                window.localStorage.setItem(key, JSON.stringify(list));
            } catch (e) {
                // Without storage the comparison lasts the page.
            }
        }

        function render() {
            var list = read();

            document.querySelectorAll('[data-compare-toggle]').forEach(function (button) {
                var on = list.indexOf(button.getAttribute('data-compare-toggle')) >= 0;

                button.setAttribute('aria-pressed', on ? 'true' : 'false');
                button.querySelector('[data-compare-on]').classList.toggle('d-none', !on);
                button.querySelector('[data-compare-off]').classList.toggle('d-none', on);
            });

            if (!bar) {
                return;
            }

            var text = bar.querySelector('[data-compare-count-text]');
            text.textContent = list.length === 1 ? text.getAttribute('data-one') : text.getAttribute('data-many').replace('{0}', list.length);
            bar.querySelector('[data-compare-go]').href = bar.getAttribute('data-url') + '?ids=' + encodeURIComponent(list.join(','));

            var shown = list.length > 0 && !document.querySelector('[data-compare-page]');
            bar.classList.toggle('d-none', !shown);

            // The page makes room under its content, so the bar never covers it.
            document.body.style.paddingBottom = shown ? bar.offsetHeight + 'px' : '';
        }

        document.addEventListener('click', function (event) {
            var toggle = event.target.closest('[data-compare-toggle]');

            if (toggle) {
                event.preventDefault();

                var id = toggle.getAttribute('data-compare-toggle');
                var list = read();
                var at = list.indexOf(id);

                if (at >= 0) {
                    list.splice(at, 1);
                } else if (list.length >= parseInt(bar.getAttribute('data-max'), 10)) {
                    window.alert(bar.getAttribute('data-full-text'));

                    return;
                } else {
                    list.push(id);
                }

                write(list);

                // On the comparison itself, a product taken off leaves the page.
                if (document.querySelector('[data-compare-page]')) {
                    window.location.assign(bar.getAttribute('data-url') + '?ids=' + encodeURIComponent(list.join(',')));

                    return;
                }

                render();

                return;
            }

            if (event.target.closest('[data-compare-clear]')) {
                write([]);
                render();
            }
        });

        render();
    })();
</script>
