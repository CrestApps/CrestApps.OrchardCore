@model DisbursementBatchesIndexViewModel

<zone Name="Title">
    <breadcrumb name="DisbursementBatches" title="@T["Disbursement batches"]">
        <breadcrumb-item id="Disbursements" action="Index" controller="Disbursements" area="CrestApps.OrchardCore.Banking" permission="@DisbursementsPermissions.ViewDisbursements.Name">@T["Disbursements"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form asp-action="Index" method="get" class="no-multisubmit">
    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2 gy-2 align-items-center">
                <div class="col">
                    <select asp-for="Status" class="form-select" onchange="this.form.submit()" aria-label="@T["Status"]">
                        <option value="">@T["All batches"]</option>
                        <option value="Open">@T["Open"]</option>
                        <option value="Released">@T["Released"]</option>
                        <option value="Settled">@T["Settled"]</option>
                        <option value="Canceled">@T["Cancelled"]</option>
                    </select>
                </div>
                @if (Model.CanImportReturns)
                {
                    <div class="col-auto">
                        <a class="btn btn-secondary" role="button" asp-action="Returns">@T["Import a return file"]</a>
                    </div>
                }
            </div>
        </div>
    </div>
</form>

@* The rows' actions post with the page's antiforgery token. *@
<form asp-action="Index" method="post" class="no-multisubmit">
<admin-list name="DisbursementBatches" context="Model.List"
            empty-message="@T["<strong>Nothing here!</strong> No batch yet. Check disbursements in the list of disbursements and batch them."]">
    <admin-list-list item-css-class="list-group-item" />
    <admin-list-grid>
        <admin-list-column name="Batch" position="10" title="@T["Batch"]" />
        <admin-list-column name="Total" position="20" title="@T["Total"]" />
        <admin-list-column name="Status" position="30" title="@T["Status"]" width="auto" />
        <admin-list-column type="Actions" title="@T["Actions"]" />
    </admin-list-grid>
</admin-list>
</form>
