@using CrestApps.OrchardCore.Banking.Disbursements.Workflows
@using OrchardCore.Workflows.Helpers
@using OrchardCore.Workflows.ViewModels

@model ActivityViewModel<DisbursementBatchSettledEvent>

<header><h4><i class="fa-solid fa-circle-check" aria-hidden="true"></i> @Model.Activity.GetTitleOrDefault(() => T["Disbursement Batch Settled"])</h4></header>
<p class="hint">@T["Starts when a batch is settled, by hand, by the Settle Disbursement Batches task, or at release when the provider paid everything; Settled counts the disbursements paid. Input: BatchId, Provider, SourceBankAccountId, SourceBankAccountName, EffectiveDate, Count, TotalAmount, Currency, Status, PreviousStatus, SourceKind, AccessScope, FileName, ProviderReference, Change, Reason, Settled and Actor."]</p>
