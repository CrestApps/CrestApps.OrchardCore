@using CrestApps.OrchardCore.Banking.Disbursements.Workflows
@using OrchardCore.Workflows.Helpers
@using OrchardCore.Workflows.ViewModels

@model ActivityViewModel<DisbursementBatchReleasedEvent>

<header><h4><i class="fa-solid fa-paper-plane" aria-hidden="true"></i> @Model.Activity.GetTitleOrDefault(() => T["Disbursement Batch Released"])</h4></header>
<p class="hint">@T["Starts when a batch is released to its provider: its bank file is written or its checks issued. Settled counts what the provider paid at once. Input: BatchId, Provider, SourceBankAccountId, SourceBankAccountName, EffectiveDate, Count, TotalAmount, Currency, Status, PreviousStatus, SourceKind, AccessScope, FileName, ProviderReference, Change, Reason, Settled and Actor."]</p>
