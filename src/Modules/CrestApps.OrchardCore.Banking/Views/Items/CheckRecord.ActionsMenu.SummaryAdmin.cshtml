@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@model ShapeViewModel<CheckRecord>

@{
    var check = Model.Value;
    var canManage = (!CheckStatuses.Transitions.IsTerminal(check.Status) || check.Status == CheckStatus.Cleared) && await AuthorizationService.AuthorizeAsync(User, ChecksPermissions.ManageChecks);
    var name = check.Number > 0 ? T["check {0}", check.Number] : T["the check to {0}", check.PayeeName];
}

@if (canManage)
{
    @* History records what happened at the bank: it can still clear or be voided, but never prints or is replaced. *@
    @if (check.Status == CheckStatus.Queued)
    {
        <a asp-action="PrintRun" asp-route-bankAccountId="@check.BankAccountId" class="dropdown-item">@T["Print queued checks"]</a>
    }
    @if (!check.IsHistorical && check.Status == CheckStatus.Printed && check.Numbering != CheckNumbering.Handwritten)
    {
        <a asp-action="Reprint" asp-route-id="@check.ItemId" class="dropdown-item">@T["Reprint"]</a>
    }
    @if (!check.IsHistorical && CheckStatuses.Transitions.CanMove(check.Status, CheckStatus.Reissued))
    {
        <a asp-action="Reissue" asp-route-id="@check.ItemId" class="dropdown-item" data-confirm-title="@T["Reissue"]" data-confirm="@T["Replace check {0} with a new check with the next number, such as for a spoiled sheet or a lost check? Check {0} is kept as reissued.", check.Number]" data-url-af="RemoveUrl UnsafeUrl">@T["Reissue"]</a>
    }
    @if (CheckStatuses.Transitions.CanMove(check.Status, CheckStatus.Cleared))
    {
        <a asp-action="Cleared" asp-route-id="@check.ItemId" class="dropdown-item" data-confirm-title="@T["Mark cleared"]" data-confirm="@T["Record that the bank paid check {0} today?", check.Number]" data-url-af="RemoveUrl UnsafeUrl">@T["Mark cleared"]</a>
    }
    @if (CheckStatuses.Transitions.CanMove(check.Status, CheckStatus.StopPayment))
    {
        <a asp-action="Stop" asp-route-id="@check.ItemId" class="dropdown-item text-danger" data-confirm-title="@T["Stop payment"]" data-confirm="@T["Record a stop payment on check {0}? Ask the bank to stop it too.", check.Number]" data-url-af="RemoveUrl UnsafeUrl">@T["Stop payment"]</a>
    }
    @if (check.Status == CheckStatus.Cleared)
    {
        <a asp-action="Unclear" asp-route-id="@check.ItemId" class="dropdown-item" data-confirm-title="@T["Mark not cleared"]" data-confirm="@T["Record that the bank did not pay {0} after all? It goes back to the status it had before it cleared.", name]" data-url-af="RemoveUrl UnsafeUrl">@T["Mark not cleared"]</a>
    }
    @if (CheckStatuses.Transitions.CanMove(check.Status, CheckStatus.Voided))
    {
        <a asp-action="Void" asp-route-id="@check.ItemId" class="dropdown-item text-danger">@T["Void"]</a>
    }
}
else
{
    <span class="dropdown-item-text text-secondary">@T["No action"]</span>
}
<script asp-name="crestapps-browser" at="Foot"></script>
