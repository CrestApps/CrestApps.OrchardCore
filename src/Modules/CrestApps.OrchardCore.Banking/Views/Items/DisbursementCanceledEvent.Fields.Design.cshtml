@using CrestApps.OrchardCore.Banking.Disbursements.Workflows
@using OrchardCore.Workflows.Helpers
@using OrchardCore.Workflows.ViewModels

@model ActivityViewModel<DisbursementCanceledEvent>

<header><h4><i class="fa-solid fa-circle-xmark" aria-hidden="true"></i> @Model.Activity.GetTitleOrDefault(() => T["Disbursement Canceled"])</h4></header>
<p class="hint">@T["Starts when a disbursement is cancelled, such as when its check is voided or stopped. Input: DisbursementId, PayeeName, Amount, Currency, Method, Status, Change, SourceKind, SourceId, BatchId, TraceNumber, FailureCode, FailureReason, IsPrenote and Actor."]</p>
