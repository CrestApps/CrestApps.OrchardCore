@model CheckLayoutViewModel

<div data-check-designer
     data-text-choose="@T["Choose a field on the check to edit it, or drag it to move it. Drag its right edge to change its width; the arrow keys move it a point at a time."]"
     data-text-off="@T["left off"]"
     data-text-blank-only="@T["prints on blank paper only"]">
    <div class="check-designer-visual mb-3">
        <div class="check-designer-panel d-flex flex-wrap align-items-center gap-2 mb-2" data-check-panel>
            <strong data-panel-title></strong>
            <div class="d-flex d-none flex-wrap align-items-center gap-2" data-panel-controls>
                <div class="input-group input-group-sm w-auto">
                    <span class="input-group-text">@T["Left"]</span>
                    <input class="form-control check-designer-number" inputmode="decimal" data-panel-prop="x" aria-label="@T["Left"]" />
                    <span class="input-group-text">@T["Top"]</span>
                    <input class="form-control check-designer-number" inputmode="decimal" data-panel-prop="y" aria-label="@T["Top"]" />
                </div>
                <div class="input-group input-group-sm w-auto">
                    <span class="input-group-text">@T["Width"]</span>
                    <input class="form-control check-designer-number" inputmode="decimal" data-panel-prop="width" aria-label="@T["Width"]" />
                    <span class="input-group-text">@T["Size"]</span>
                    <input class="form-control check-designer-number" inputmode="decimal" data-panel-prop="size" aria-label="@T["Size"]" />
                </div>
                <div class="form-check form-check-inline mb-0">
                    <input class="form-check-input" type="checkbox" id="check-designer-hidden" data-panel-prop="hidden" />
                    <label class="form-check-label" for="check-designer-hidden">@T["Leave off"]</label>
                </div>
            </div>
        </div>
        <div class="check-designer-canvas" data-check-canvas>
            <div class="check-designer-band" title="@T["Kept clear for the check line"]"></div>
        </div>
        <span class="hint">@T["The check at its real proportions, with sample values. Measures are in points from the top left corner: 72 points make an inch. A field drawn in red reaches into the band kept clear for the check line. The calibration above moves everything."]</span>
    </div>

    <details>
        <summary class="mb-2">@T["Exact positions"]</summary>
        <span asp-validation-for="Fields" class="text-danger"></span>
        @for (var i = 0; i < Model.Fields.Count; i++)
        {
            var name = Model.Fields[i].Name;
            var sample = name switch
            {
                CheckFieldNames.Date => new DateOnly(2026, 11, 13).ToString("d"),
                CheckFieldNames.Payee => T["Jane Doe"].Value,
                CheckFieldNames.PayeeAddress => T["Jane Doe"].Value + "|" + T["22 Oak Road"].Value + "|" + T["Springfield IL 62702"].Value,
                CheckFieldNames.Amount => "**1,234.56",
                CheckFieldNames.AmountInWords => T["One thousand two hundred thirty-four and 56/100 USD ***"].Value,
                CheckFieldNames.Memo => T["Memo: Invoice 1042"].Value,
                CheckFieldNames.Number => "1001",
                CheckFieldNames.Payer => T["Your business"].Value,
                CheckFieldNames.Bank => T["Your bank"].Value,
                CheckFieldNames.Signature => T["Authorized signature"].Value,
                CheckFieldNames.SecondSignature => T["Second signature"].Value,
                _ => name,
            };
            var blankOnly = name is CheckFieldNames.Payer or CheckFieldNames.Bank;
            var signature = name is CheckFieldNames.Signature or CheckFieldNames.SecondSignature;
            <div class="ocat-wrapper border-bottom pb-2 mb-2" role="group" aria-labelledby="check-designer-label-@name"
                      data-designer-field="@name"
                      data-designer-label="@Model.Fields[i].Label"
                      data-designer-sample="@sample"
                      data-designer-blank-only="@(blankOnly ? "true" : "false")"
                      data-designer-signature="@(signature ? "true" : "false")">
                <div class="ocat-label fs-6" id="check-designer-label-@name">@Model.Fields[i].Label</div>
                <div class="ocat-end">
                    <input type="hidden" asp-for="Fields[i].Name" />
                    <div class="input-group input-group-sm mb-1">
                        <span class="input-group-text">@T["Left"]</span>
                        <input asp-for="Fields[i].X" class="form-control" inputmode="decimal" aria-label="@T["Left"]" data-designer-prop="x" />
                        <span class="input-group-text">@T["Top"]</span>
                        <input asp-for="Fields[i].Y" class="form-control" inputmode="decimal" aria-label="@T["Top"]" data-designer-prop="y" />
                    </div>
                    <div class="input-group input-group-sm mb-1">
                        <span class="input-group-text">@T["Width"]</span>
                        <input asp-for="Fields[i].Width" class="form-control" inputmode="decimal" aria-label="@T["Width"]" data-designer-prop="width" />
                        <span class="input-group-text">@T["Size"]</span>
                        <input asp-for="Fields[i].FontSize" class="form-control" inputmode="decimal" aria-label="@T["Size"]" data-designer-prop="size" />
                    </div>
                    <div class="form-check">
                        <input asp-for="Fields[i].Hidden" class="form-check-input" data-designer-prop="hidden" />
                        <label asp-for="Fields[i].Hidden" class="form-check-label">@T["Leave off"]</label>
                    </div>
                </div>
            </div>
        }
    </details>
</div>

<style asp-name="check-layout-designer"></style>
<script asp-name="check-layout-designer" at="Foot"></script>
