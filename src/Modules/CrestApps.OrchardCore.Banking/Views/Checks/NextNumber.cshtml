@model CheckNextNumberViewModel

<zone Name="Title">
    <breadcrumb name="ChecksNextNumber" title="@T["Next check numbers"]">
        <breadcrumb-item id="Checks" action="Index" controller="Checks" area="CrestApps.OrchardCore.Banking" permission="@ChecksPermissions.ViewCheckRegister.Name">@T["Checks"]</breadcrumb-item>
    </breadcrumb>
</zone>

<div class="card mb-3">
    <div class="card-header">@T["Now"]</div>
    <div class="card-body">
        @if (Model.Current.Count == 0)
        {
            <p class="mb-0">@T["The business has no bank account yet."]</p>
        }
        else
        {
            <ul class="mb-0">
                @foreach (var (name, next) in Model.Current)
                {
                    <li>@T["{0}: the next check gets number {1}.", name, next]</li>
                }
            </ul>
        }
    </div>
</div>

<form method="post" class="no-multisubmit">
    @Html.ValidationSummary()
    <div class="card mb-3">
        <div class="card-header">@T["Load new stock"]</div>
        <div class="card-body">
            <div class="ocat-wrapper" asp-validation-class-for="BankAccountId">
                <label asp-for="BankAccountId" class="ocat-label ocat-label-required">@T["Bank account"]</label>
                <div class="ocat-end">
                    <select asp-for="BankAccountId" asp-items="Model.BankAccountOptions" class="form-select"></select>
                    <span asp-validation-for="BankAccountId" class="text-danger"></span>
                </div>
            </div>
            <div class="ocat-wrapper" asp-validation-class-for="NextNumber">
                <label asp-for="NextNumber" class="ocat-label ocat-label-required">@T["Next number"]</label>
                <div class="ocat-end">
                    <input asp-for="NextNumber" class="form-control" inputmode="numeric" />
                    <span asp-validation-for="NextNumber" class="text-danger"></span>
                    <span class="hint">@T["The number printed on the first check of the new stock. A number a check of the account already has is refused."]</span>
                </div>
            </div>
        </div>
    </div>

    <div class="action-bar-bottom">
        <button class="btn btn-primary" type="submit">@T["Save"]</button>
        <a class="btn btn-secondary cancel" role="button" asp-route-action="Index">@T["Cancel"]</a>
    </div>
</form>
