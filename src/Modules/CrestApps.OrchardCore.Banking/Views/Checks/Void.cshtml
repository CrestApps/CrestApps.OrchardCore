@using CrestApps.OrchardCore.Currencies
@model CheckVoidViewModel

@{
    var check = Model.Check;
    var name = check.Number > 0 ? T["Void check {0}", check.Number] : T["Void the check to {0}", check.PayeeName];
}

<zone Name="Title">
    <breadcrumb name="ChecksVoid" title="@name">
        <breadcrumb-item id="Checks" action="Index" controller="Checks" area="CrestApps.OrchardCore.Banking" permission="@ChecksPermissions.ViewCheckRegister.Name">@T["Checks"]</breadcrumb-item>
    </breadcrumb>
</zone>

<div class="alert alert-warning">
    @T["The check to {0} for {1} {2}, dated {3}, can't be paid or printed again once it is voided. It keeps its number.", check.PayeeName, CurrencyScale.FormatForDisplay(check.Amount, check.Currency), check.Currency, check.CheckDate.ToString("d")]
</div>

<form method="post" class="no-multisubmit">
    @Html.ValidationSummary()
    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <button class="btn btn-danger" type="submit">@T["Void"]</button>
        <a class="btn btn-secondary cancel" role="button" asp-route-action="Index">@T["Cancel"]</a>
    </div>
</form>
