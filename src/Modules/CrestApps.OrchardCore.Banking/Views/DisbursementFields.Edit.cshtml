@model DisbursementViewModel

<div class="ocat-wrapper" asp-validation-class-for="Method">
    <label asp-for="Method" class="ocat-label ocat-label-required">@T["Sent by"]</label>
    <div class="ocat-end">
        <select asp-for="Method" asp-items="Model.MethodOptions" class="form-select"></select>
        <span asp-validation-for="Method" class="text-danger"></span>
        <span class="hint">@T["A bank file pays into the payee's bank account; a printed check is mailed; paid outside the system records a wire or cash payment."]</span>
    </div>
</div>
<div class="ocat-wrapper" asp-validation-class-for="SourceBankAccountId">
    <label asp-for="SourceBankAccountId" class="ocat-label">@T["From"]</label>
    <div class="ocat-end">
        <select asp-for="SourceBankAccountId" asp-items="Model.SourceAccountOptions" class="form-select"></select>
        <span asp-validation-for="SourceBankAccountId" class="text-danger"></span>
        <span class="hint">@T["The business's bank account the money leaves from. Needed for a bank file or a check."]</span>
    </div>
</div>
<div class="ocat-wrapper" asp-validation-class-for="Amount">
    <label asp-for="Amount" class="ocat-label ocat-label-required">@T["Amount"]</label>
    <div class="ocat-end ocat-limited-wrapper">
        <input asp-for="Amount" class="form-control" inputmode="decimal" autocomplete="off" />
        <span asp-validation-for="Amount" class="text-danger"></span>
    </div>
</div>
<div class="ocat-wrapper" asp-validation-class-for="Memo">
    <label asp-for="Memo" class="ocat-label">@T["Memo"]</label>
    <div class="ocat-end">
        <input asp-for="Memo" class="form-control" maxlength="200" />
    </div>
</div>
