@using CrestApps.OrchardCore.Banking.Services
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@inject IBankAccountService BankAccountService

@model EditCatalogEntryViewModel

@{
    var id = ViewContext.RouteData.Values["id"]?.ToString();
    var canReveal = await AuthorizationService.AuthorizeAsync(User, BankingPermissions.RevealBankAccountNumbers);
}

<zone Name="Title">
    <breadcrumb name="BankAccountsEdit" title="@T["Edit {0}", Model.DisplayName]">
        <breadcrumb-item id="BankAccounts" action="Index" controller="BankAccounts" area="CrestApps.OrchardCore.Banking" permission="@BankingPermissions.ManageBankAccounts.Name">@T["Bank accounts"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form method="post" class="no-multisubmit" autocomplete="off">
    @Html.ValidationSummary()
    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <button class="btn btn-primary" type="submit">@T["Save"]</button>
        @if (canReveal)
        {
            <button class="btn btn-secondary action-bar-secondary" type="submit" formaction="@Url.Action("Reveal", new { id })">@T["Show the full number"]</button>
        }
        @foreach (var verifier in BankAccountService.Verifiers)
        {
            <button class="btn btn-secondary action-bar-secondary" type="submit" formaction="@Url.Action("Verify", new { id, verifier = verifier.Name })">@T["Check with {0}", verifier.DisplayName]</button>
        }
        <a class="btn btn-secondary cancel" role="button" asp-route-action="Index">@T["Cancel"]</a>
    </div>
</form>
