@model EditCatalogEntryViewModel

<zone Name="Title">
    <breadcrumb name="DisbursementsCreate" title="@T["Record a Disbursement"]">
        <breadcrumb-item id="Disbursements" action="Index" controller="Disbursements" area="CrestApps.OrchardCore.Banking" permission="@DisbursementsPermissions.ViewDisbursements.Name">@T["Disbursements"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form method="post" class="no-multisubmit">
    @Html.ValidationSummary()
    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <button class="btn btn-primary" type="submit">@T["Record"]</button>
        <a class="btn btn-secondary cancel" role="button" asp-route-action="Index">@T["Cancel"]</a>
    </div>
</form>
