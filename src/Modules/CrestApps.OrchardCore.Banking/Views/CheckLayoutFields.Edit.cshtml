@model CheckLayoutViewModel

<div class="ocat-wrapper" asp-validation-class-for="Name">
    <label asp-for="Name" class="ocat-label ocat-label-required">@T["Name"]</label>
    <div class="ocat-end">
        <input asp-for="Name" class="form-control" maxlength="255" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
</div>
<div class="ocat-wrapper" asp-validation-class-for="Description">
    <label asp-for="Description" class="ocat-label">@T["Notes"]</label>
    <div class="ocat-end">
        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
        <span class="hint">@T["Such as the stock and the printer the layout is calibrated for."]</span>
    </div>
</div>
<div class="ocat-wrapper" asp-validation-class-for="Stock">
    <label asp-for="Stock" class="ocat-label">@T["Paper"]</label>
    <div class="ocat-end">
        <select asp-for="Stock" asp-items="Model.StockOptions" class="form-select" data-designer-stock></select>
        <span class="hint">@T["On blank check paper the layout also prints the payer, the bank and the check line. Pre-printed checks have them already."]</span>
    </div>
</div>
<div class="ocat-wrapper" asp-validation-class-for="Form">
    <label asp-for="Form" class="ocat-label">@T["Sheet"]</label>
    <div class="ocat-end">
        <select asp-for="Form" asp-items="Model.FormOptions" class="form-select"></select>
    </div>
</div>
