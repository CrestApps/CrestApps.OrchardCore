@model BankAccountLinkViewModel

@*
    The link provider's shape runs the browser part. It opens the provider when a [data-bank-account-link-open] button in
    this form is clicked (after the form's own checks pass), writes what the provider returned into the clientResult
    field and submits the form.
*@
<form method="post" action="@Model.FormAction" class="no-multisubmit" autocomplete="off" data-bank-account-link>
    <input type="hidden" name="clientResult" value="" />

    @await DisplayAsync(Model.Editor)

    @await DisplayAsync(Model.LinkShape)

    <div class="action-bar-bottom">
        <button class="btn btn-primary" type="button" data-bank-account-link-open>@T["Link Your Bank"]</button>
        <a class="btn btn-secondary cancel" role="button" href="@Model.CancelUrl">@T["Cancel"]</a>
    </div>
</form>
