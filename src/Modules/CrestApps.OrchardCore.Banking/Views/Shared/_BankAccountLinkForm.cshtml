@model BankAccountLinkViewModel

@*
    The link provider's shape runs the browser part. It opens the provider when a [data-bank-account-link-open] button in
    this form is clicked (after the form's own checks pass), writes what the provider returned into the clientResult
    field and submits the form.
*@
<form method="post" action="@Model.FormAction" class="no-multisubmit" autocomplete="off" data-bank-account-link>
    <input type="hidden" name="clientResult" value="" />

    <div class="card mb-3">
        <div class="card-header">@T["Link your bank with {0}", Model.ProviderDisplayName]</div>
        <div class="card-body">
            <p>@T["Sign in to your bank in the {0} window and choose the account. The bank's own routing and account numbers are saved, and the account is verified at once. Your bank password goes to the bank, never to this site.", Model.ProviderDisplayName]</p>
            @if (!Model.IsNew)
            {
                <p class="mb-0">@T["The bank's numbers replace those of {0} ({1}).", Model.AccountName, string.IsNullOrEmpty(Model.MaskedNumber) ? T["no number yet"].Value : Model.MaskedNumber]</p>
            }
            <div class="text-danger mt-2 d-none" data-bank-account-link-error role="alert"></div>
        </div>
    </div>

    @if (Model.IsNew)
    {
        <div class="card mb-3">
            <div class="card-header">@T["The account"]</div>
            <div class="card-body">
                <div class="ocat-wrapper">
                    <label asp-for="HolderName" class="ocat-label ocat-label-required">@T["Account holder"]</label>
                    <div class="ocat-end">
                        <input asp-for="HolderName" class="form-control" maxlength="255" required />
                        <span class="hint">@T["The name of the account holder as the bank knows it."]</span>
                    </div>
                </div>
                <div class="ocat-wrapper">
                    <label asp-for="Name" class="ocat-label">@T["Name"]</label>
                    <div class="ocat-end">
                        <input asp-for="Name" class="form-control" maxlength="255" />
                        <span class="hint">@T["The name the account is listed by. Leave it empty to use the bank's name and the account's last digits."]</span>
                    </div>
                </div>
            </div>
        </div>
    }

    @await DisplayAsync(Model.LinkShape)

    <div class="action-bar-bottom">
        <button class="btn btn-primary" type="button" data-bank-account-link-open>@T["Link your bank"]</button>
        <a class="btn btn-secondary cancel" role="button" href="@Model.CancelUrl">@T["Cancel"]</a>
    </div>
</form>
