<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <Title>CrestApps OrchardCore AI File Sources - FTP</Title>
    <Description>
      $(CrestAppsDescription)

      Adds an FTP/FTPS connector to File Sources. Its own module so a tenant that reads only its own folders never loads the FTP client.
    </Description>
    <PackageTags>$(PackageTags) OrchardCoreCMS AI DataSources RAG FileSources FTP</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OrchardCore.Module.Targets" />
    <PackageReference Include="OrchardCore.DisplayManagement" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CrestApps.Core.AI.Ftp" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Enabling this feature also enables File Sources, which registers the run service, the knowledge store
      and the screens this connector appears on.
    -->
    <ProjectReference Include="../CrestApps.OrchardCore.AI.FileSources/CrestApps.OrchardCore.AI.FileSources.csproj" PrivateAssets="none" />
  </ItemGroup>

</Project>
