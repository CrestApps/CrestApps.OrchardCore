<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
    <Title>CrestApps OrchardCore Payroll</Title>
    <Description>
      $(OCCMSDescription)

      Payroll for Orchard Core: Pay Setup (pay schedules with pay dates and pay codes by class and kind, shared with
      Workforce's time clock), and the employers, pay profiles, pay runs, engine and statements of Payroll.
    </Description>
    <PackageTags>$(PackageTags) CrestApps OrchardCoreCMS Payroll</PackageTags>
  </PropertyGroup>

