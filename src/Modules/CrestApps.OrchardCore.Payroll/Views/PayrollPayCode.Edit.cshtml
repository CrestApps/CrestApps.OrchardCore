@model PayrollPayCodeViewModel

<div class="ocat-wrapper" asp-validation-class-for="Calculation">
    <label asp-for="Calculation" class="ocat-label">@T["Calculated as"]</label>
    <div class="ocat-end">
        <select asp-for="Calculation" class="form-select" style="max-width: 24rem">
            <option value="HoursByRate">@T["Hours times the rate"]</option>
            <option value="FixedAmount">@T["An amount (from a pay item or an input)"]</option>
            <option value="PercentOfEarnings">@T["A percent of earnings"]</option>
            <option value="PercentOfDisposableEarnings">@T["A percent of disposable earnings (deductions)"]</option>
        </select>
        <span asp-validation-for="Calculation" class="text-danger"></span>
    </div>
</div>
@if (Model.BaseCodes.Count > 0)
{
    <div class="ocat-wrapper">
        <label asp-for="BaseCodeIds" class="ocat-label">@T["Percent of"]</label>
        <div class="ocat-end">
            <select asp-for="BaseCodeIds" asp-items="Model.BaseCodes" class="form-select" multiple size="5" style="max-width: 24rem"></select>
            <span class="hint">@T["For a percent of earnings: the earnings it is taken of. None chosen for every earning."]</span>
        </div>
    </div>
}
