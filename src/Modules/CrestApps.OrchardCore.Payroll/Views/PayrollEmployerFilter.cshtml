@model PayProfilesIndexViewModel

@if (Model.Employers.Count > 1)
{
    <div class="btn-group filter">
        <select name="employerId" form="payroll-profiles-filter" asp-items="Model.Employers" class="form-select form-select-sm" onchange="this.form.submit()" aria-label="@T["Employer"]">
            <option value="">@T["Every employer"]</option>
        </select>
    </div>
}
