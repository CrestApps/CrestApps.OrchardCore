@model PayrollSettingsViewModel

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input asp-for="AllowPreparerToApprove" type="checkbox" class="form-check-input" />
            <label asp-for="AllowPreparerToApprove" class="form-check-label">@T["The person who prepared a pay run may approve it"]</label>
            <span class="hint dashed">@T["Off by default. Turn it on only for a business where one person runs payroll."]</span>
        </div>
    </div>
</div>
<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input asp-for="AllowChangingOwnPay" type="checkbox" class="form-check-input" />
            <label asp-for="AllowChangingOwnPay" class="form-check-label">@T["People may change their own pay in the admin pages"]</label>
            <span class="hint dashed">@T["Off by default: nobody changes their own pay rate, pay items, inputs or garnishments."]</span>
        </div>
    </div>
</div>
<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input asp-for="EmployeeReview" type="checkbox" class="form-check-input" />
            <label asp-for="EmployeeReview" class="form-check-label">@T["Employees review their coming pay before the run is submitted"]</label>
            <span class="hint dashed">@T["Once a run is calculated, each employee with a user is told to look at their pay in My Pay and say it is right or ask about it; the run shows their answers and warns before it is submitted with a question open."]</span>
        </div>
    </div>
</div>
