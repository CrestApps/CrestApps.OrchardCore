@model PayScheduleViewModel

<div class="ocat-wrapper" asp-validation-class-for="Name">
    <label asp-for="Name" class="ocat-label ocat-label-required">@T["Name"]</label>
    <div class="ocat-end">
        <input asp-for="Name" class="form-control" maxlength="255" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
</div>
<div class="ocat-wrapper">
    <label asp-for="Frequency" class="ocat-label">@T["Periods"]</label>
    <div class="ocat-end">
        <select asp-for="Frequency" class="form-select" style="max-width: 18rem">
            <option value="Weekly">@T["Every week"]</option>
            <option value="Biweekly">@T["Every two weeks"]</option>
            <option value="FourWeekly">@T["Every four weeks"]</option>
            <option value="SemiMonthly">@T["Twice a month"]</option>
            <option value="Monthly">@T["Every month"]</option>
            <option value="Quarterly">@T["Every quarter"]</option>
            <option value="Yearly">@T["Every year"]</option>
        </select>
    </div>
</div>
<div class="ocat-wrapper" asp-validation-class-for="AnchorDate">
    <label asp-for="AnchorDate" class="ocat-label">@T["A period starts on"]</label>
    <div class="ocat-end">
        <input asp-for="AnchorDate" type="date" class="form-control" style="max-width: 12rem" />
        <span asp-validation-for="AnchorDate" class="text-danger"></span>
        <span class="hint">@T["For weekly, every two weeks and every four weeks: a day any period starts on. Its month starts quarterly and yearly periods."]</span>
    </div>
</div>
<div class="ocat-wrapper" asp-validation-class-for="SecondPeriodStartDay">
    <label asp-for="SecondPeriodStartDay" class="ocat-label">@T["Second period starts on day"]</label>
    <div class="ocat-end ocat-limited-wrapper">
        <input asp-for="SecondPeriodStartDay" type="number" min="2" max="28" class="form-control" />
        <span class="hint">@T["Twice a month: the first period runs from the 1st to the day before, the second to the end of the month."]</span>
    </div>
</div>
<div class="ocat-wrapper">
    <label asp-for="WeekStart" class="ocat-label">@T["Overtime week starts on"]</label>
    <div class="ocat-end">
        <select asp-for="WeekStart" class="form-select" style="max-width: 12rem">
            <option value="Sunday">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetDayName(DayOfWeek.Sunday)</option>
            <option value="Monday">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetDayName(DayOfWeek.Monday)</option>
            <option value="Tuesday">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetDayName(DayOfWeek.Tuesday)</option>
            <option value="Wednesday">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetDayName(DayOfWeek.Wednesday)</option>
            <option value="Thursday">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetDayName(DayOfWeek.Thursday)</option>
            <option value="Friday">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetDayName(DayOfWeek.Friday)</option>
            <option value="Saturday">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetDayName(DayOfWeek.Saturday)</option>
        </select>
    </div>
</div>
