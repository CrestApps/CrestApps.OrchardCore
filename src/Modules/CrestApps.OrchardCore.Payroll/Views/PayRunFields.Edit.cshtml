@model PayRunViewModel

@{
    var paysPeople = Model.Paid == "People";
}

<div class="ocat-wrapper" asp-validation-class-for="Title">
    <label asp-for="Title" class="ocat-label">@T["Name"]</label>
    <div class="ocat-end">
        <input asp-for="Title" class="form-control" maxlength="200" />
        <span asp-validation-for="Title" class="text-danger"></span>
        <span class="hint">@T["Leave it empty for a name made from the dates, the schedule and who is paid, such as \"Pay for Nov 16 – Nov 29, 2026 (Weekly)\"."]</span>
    </div>
</div>
<div class="ocat-wrapper" asp-validation-class-for="PayScheduleId">
    <label asp-for="PayScheduleId" class="ocat-label">@T["Pay schedule"]</label>
    <div class="ocat-end">
        <select asp-for="PayScheduleId" asp-items="Model.Schedules" class="form-select">
            <option value="">@T["Choose…"]</option>
        </select>
        <span asp-validation-for="PayScheduleId" class="text-danger"></span>
        <span class="hint">@T["People are paid on the schedule of their pay profile: a weekly run pays the weekly people, a monthly run the monthly ones. The schedule also gives the period and the pay date."]</span>
    </div>
</div>
<div class="ocat-wrapper" asp-validation-class-for="StaffMemberIds" data-pay-run-paid>
    <span class="ocat-label">@T["Who is paid"]</span>
    <div class="ocat-end">
        <div class="form-check">
            <input type="radio" class="form-check-input" id="@Html.IdFor(m => m.Paid)-schedule" name="@Html.NameFor(m => m.Paid)" value="Schedule" checked="@(!paysPeople)" />
            <label class="form-check-label" for="@Html.IdFor(m => m.Paid)-schedule">@T["All staff on the pay schedule"]</label>
            <span class="hint dashed">@T["Everyone with an active pay profile on the schedule."]</span>
        </div>
        <div class="form-check">
            <input type="radio" class="form-check-input" id="@Html.IdFor(m => m.Paid)-people" name="@Html.NameFor(m => m.Paid)" value="People" checked="@paysPeople" />
            <label class="form-check-label" for="@Html.IdFor(m => m.Paid)-people">@T["Only the staff members I choose"]</label>
            <span class="hint dashed">@T["Such as a bonus for a few people or the final pay of someone who left: they are paid whatever their schedule."]</span>
        </div>
        <div class="mt-2@(paysPeople ? null : " d-none")" data-pay-run-people>
            @await Component.InvokeAsync("StaffPicker", new { name = Html.NameFor(m => m.StaffMemberIds).ToString(), selectedValues = Model.StaffMemberIds, multiple = true, buttonText = T["Choose staff members"].Value })
        </div>
        <span asp-validation-for="StaffMemberIds" class="text-danger"></span>
    </div>
</div>
<script at="Foot">
    document.querySelectorAll('[data-pay-run-paid]').forEach(group => {
        const people = group.querySelector('[data-pay-run-people]');

        group.querySelectorAll('input[type="radio"]').forEach(radio => radio.addEventListener('change', () => {
            people.classList.toggle('d-none', !(radio.checked && radio.value === 'People'));
        }));
    });
</script>
<div class="ocat-wrapper">
    <label asp-for="Type" class="ocat-label">@T["Type"]</label>
    <div class="ocat-end">
        <select asp-for="Type" class="form-select" style="max-width: 24rem">
            <option value="Regular">@T["Regular (salaries, hours, pay items and inputs)"]</option>
            <option value="Supplemental">@T["Supplemental (bonuses and commissions: inputs only)"]</option>
            <option value="OffCycle">@T["Off-cycle (inputs only)"]</option>
            <option value="Final">@T["Final pay"]</option>
            <option value="Correction">@T["Correction"]</option>
            <option value="Contractor">@T["Contractors (nothing withheld)"]</option>
        </select>
    </div>
</div>
<div class="ocat-wrapper">
    <label asp-for="SupplementalMethod" class="ocat-label">@T["Bonuses withheld"]</label>
    <div class="ocat-end">
        <select asp-for="SupplementalMethod" class="form-select" style="max-width: 24rem">
            <option value="Aggregate">@T["With regular wages"]</option>
            <option value="Flat">@T["At each tax's flat supplemental rate"]</option>
        </select>
    </div>
</div>
<div class="ocat-wrapper" asp-validation-class-for="PeriodStart">
    <label asp-for="PeriodStart" class="ocat-label">@T["Period"]</label>
    <div class="ocat-end">
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <input asp-for="PeriodStart" type="date" class="form-control" style="max-width: 12rem" aria-label="@T["First day"]" />
            <span>@T["to"]</span>
            <input asp-for="PeriodEnd" type="date" class="form-control" style="max-width: 12rem" aria-label="@T["Last day"]" />
        </div>
        <span asp-validation-for="PeriodStart" class="text-danger"></span>
        <span class="hint">@T["Leave the period and the pay date empty to take the schedule's current period and its pay date."]</span>
    </div>
</div>
<div class="ocat-wrapper">
    <label asp-for="PayDate" class="ocat-label">@T["Pay date"]</label>
    <div class="ocat-end">
        <input asp-for="PayDate" type="date" class="form-control" style="max-width: 12rem" />
    </div>
</div>
