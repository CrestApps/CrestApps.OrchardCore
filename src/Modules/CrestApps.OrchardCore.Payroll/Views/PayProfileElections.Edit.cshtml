@model PayProfileElectionsViewModel
@using System.Globalization
@using OrchardCore.Localization
@using Microsoft.Extensions.Localization
@inject OrchardCore.Modules.ILocalClock LocalClock
@inject Microsoft.Extensions.Localization.IStringLocalizerFactory LocalizerFactory

@if (Model.History.Count == 0)
{
    <p class="text-muted">@T["No election yet."]</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm">
            <thead>
                <tr>
                    <th scope="col">@T["Jurisdiction"]</th>
                    <th scope="col">@T["From"]</th>
                    <th scope="col">@T["Election"]</th>
                    <th scope="col">@T["Entered"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var election in Model.History)
                {
                    <tr>
                        <td>@election.Jurisdiction</td>
                        <td>@election.EffectiveFrom.ToString("d", CultureInfo.CurrentCulture)</td>
                        <td>@string.Join(" · ", election.Values.Select(value => $"{(Model.FieldLabels.TryGetValue(value.Key, out var fieldLabel) ? fieldLabel : value.Key)}: {(value.Value switch { "true" => T["Yes"].Value, "false" => T["No"].Value, _ => value.Value })}"))</td>
                        <td class="small text-muted">@if (election.EnteredUtc != default)
                        {
                            @((await LocalClock.ConvertToLocalAsync(DateTime.SpecifyKind(election.EnteredUtc, DateTimeKind.Utc))).DateTime.ToString("g", CultureInfo.CurrentCulture))
                        } @election.EnteredBy</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
