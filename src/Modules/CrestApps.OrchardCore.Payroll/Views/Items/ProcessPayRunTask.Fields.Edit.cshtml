@using CrestApps.OrchardCore.Payroll.Workflows

@model PayrollTaskViewModel

<p class="hint">@T["Processes an approved pay run, or pays what is left of a partly paid one. Ends in Paid, PartiallyPaid or Failed."]</p>
<div class="mb-3">
    <label asp-for="PayRunId" class="form-label">@T["Pay run id"]</label>
    <input asp-for="PayRunId" class="form-control code" />
    <span class="hint">@T["The run's id or number. Liquid."]</span>
</div>

<div class="mb-3">
    <div class="form-check">
        <input type="checkbox" class="form-check-input" id="@Html.IdFor(model => model.IncludeTotals)" name="@Html.NameFor(model => model.IncludeTotals)" value="true" checked="@(string.Equals(Model.IncludeTotals, "true", StringComparison.OrdinalIgnoreCase))" />
        <label class="form-check-label" for="@Html.IdFor(model => model.IncludeTotals)">@T["Write the run's amounts to the output"]</label>
        <span class="hint dashed">@T["Gross, Net and CashNeeded, kept in the workflow's state. Written only when the workflow's user may view the employer's payroll reports; never for a timer."]</span>
    </div>
</div>
