@model ShapeViewModel<PayrollFiling>
@using System.Globalization

<span class="badge ta-badge fw-normal">@(Model.Value.Status switch { PayrollFilingStatus.Filed => T["Filed"], PayrollFilingStatus.Amended => T["Amended"], _ => T["Draft"] })</span>
@if (Model.Value.FiledOn is { } filedOn)
{
    <span class="badge ta-badge fw-normal">@filedOn.ToString("d", CultureInfo.CurrentCulture)</span>
}
@if (!string.IsNullOrEmpty(Model.Value.AmendsId))
{
    <span class="badge ta-badge fw-normal">@T["Amendment"]</span>
}
@if (Model.Value.People.Count > 0)
{
    <span class="badge ta-badge fw-normal">@T["{0} people", Model.Value.People.Count]</span>
}
