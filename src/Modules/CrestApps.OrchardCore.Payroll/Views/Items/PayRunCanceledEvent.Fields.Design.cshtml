@using CrestApps.OrchardCore.Payroll.Workflows
@using OrchardCore.Workflows.Helpers
@using OrchardCore.Workflows.ViewModels

@model ActivityViewModel<PayRunCanceledEvent>

<header><h4><i class="fa-solid fa-circle-xmark" aria-hidden="true"></i> @Model.Activity.GetTitleOrDefault(() => T["Pay Run Canceled"])</h4></header>
<p class="hint">@T["Starts when a pay run is cancelled; Note is the reason. Input: PayRunId, Number, EmployerId, PayScheduleId, Type, PeriodStart, PeriodEnd, PayDate, Status, Statements, Change, Actor and Note."]</p>
