@using CrestApps.OrchardCore.Payroll.Workflows
@using OrchardCore.Workflows.Helpers
@using OrchardCore.Workflows.ViewModels

@model ActivityViewModel<GarnishmentOrderCompletedEvent>

<header><h4><i class="fa-solid fa-circle-check" aria-hidden="true"></i> @Model.Activity.GetTitleOrDefault(() => T["Garnishment Order Completed"])</h4></header>
<p class="hint">@T["Starts when a garnishment order owes nothing more and is completed. Input: OrderId, EmployerId, StaffMemberId, Type, CaseNumber, Agency, PayeeName, Status, Withheld, TotalOwed, Remaining, StatementId, StatementNumber, PayDate, Amount, Currency, Method, ReferenceId, Reference, Problem and Change."]</p>
