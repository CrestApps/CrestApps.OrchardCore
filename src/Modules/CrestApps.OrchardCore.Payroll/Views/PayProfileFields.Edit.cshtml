@model PayProfileViewModel

@if (Model.Blockers.Count > 0)
{
    <div class="alert alert-warning">
        <strong>@T["Not ready to pay:"]</strong>
        <ul class="mb-0">
            @foreach (var blocker in Model.Blockers)
            {
                <li>@blocker.Message</li>
            }
        </ul>
    </div>
}
else if (!Model.IsNew)
{
    <div class="alert alert-success py-2"><i class="fa-solid fa-check me-1" aria-hidden="true"></i>@T["Ready to pay."]</div>
}

<div class="card mb-3">
    <div class="card-header d-flex align-items-center">
        <span class="me-auto">@T["Pay profile"]</span>
        @if (!Model.IsNew)
        {
            <a class="btn btn-sm btn-secondary" asp-area="CrestApps.OrchardCore.Payroll" asp-controller="PayItems" asp-action="Index" asp-route-profileId="@Model.ProfileId">@T["Pay items"]</a>
            <a class="btn btn-sm btn-secondary ms-1" asp-area="CrestApps.OrchardCore.Payroll" asp-controller="PayPreviews" asp-action="Index" asp-route-id="@Model.ProfileId">@T["Preview the next pay"]</a>
        }
    </div>
    <div class="card-body">
        <div class="ocat-wrapper" asp-validation-class-for="StaffMemberId">
            <label asp-for="StaffMemberId" class="ocat-label ocat-label-required">@T["Staff member"]</label>
            <div class="ocat-end">
                @if (Model.StaffMembers.Count > 0)
                {
                    <select asp-for="StaffMemberId" asp-items="Model.StaffMembers" class="form-select" style="max-width: 24rem">
                        <option value="">@T["Choose…"]</option>
                    </select>
                }
                else
                {
                    <input type="hidden" asp-for="StaffMemberId" />
                    <span class="form-control-plaintext">@Model.StaffName</span>
                }
                <span asp-validation-for="StaffMemberId" class="text-danger"></span>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="EmployerId">
            <label asp-for="EmployerId" class="ocat-label ocat-label-required">@T["Employer"]</label>
            <div class="ocat-end">
                <select asp-for="EmployerId" asp-items="Model.Employers" class="form-select" style="max-width: 24rem">
                    <option value="">@T["Choose…"]</option>
                </select>
                <span asp-validation-for="EmployerId" class="text-danger"></span>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="PayScheduleId" class="ocat-label">@T["Pay schedule"]</label>
            <div class="ocat-end">
                <select asp-for="PayScheduleId" asp-items="Model.Schedules" class="form-select" style="max-width: 24rem">
                    <option value="">@T["Choose…"]</option>
                </select>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="WorkerType" class="ocat-label">@T["Worker type"]</label>
            <div class="ocat-end">
                <select asp-for="WorkerType" class="form-select" style="max-width: 16rem">
                    <option value="Employee">@T["Employee"]</option>
                    <option value="Contractor">@T["Contractor (no withholding)"]</option>
                </select>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="OvertimeStatus" class="ocat-label">@T["Overtime"]</label>
            <div class="ocat-end">
                <select asp-for="OvertimeStatus" class="form-select" style="max-width: 16rem">
                    <option value="NonExempt">@T["Paid overtime"]</option>
                    <option value="Exempt">@T["Exempt from overtime"]</option>
                </select>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="Status" class="ocat-label">@T["Status"]</label>
            <div class="ocat-end">
                <select asp-for="Status" class="form-select" style="max-width: 16rem">
                    <option value="Active">@T["Active"]</option>
                    <option value="OnLeave">@T["On leave"]</option>
                    <option value="Terminated">@T["Terminated"]</option>
                </select>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="LegalName" class="ocat-label">@T["Legal name"]</label>
            <div class="ocat-end">
                <input asp-for="LegalName" class="form-control" style="max-width: 24rem" />
                <span class="hint">@T["Printed on statements and forms, when it differs from the staff member's name."]</span>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="WorkSiteTeamId" class="ocat-label">@T["Work site"]</label>
            <div class="ocat-end">
                <select asp-for="WorkSiteTeamId" asp-items="Model.Teams" class="form-select" style="max-width: 24rem">
                    <option value="">@T["None"]</option>
                </select>
                <span class="hint">@T["A site team whose tax jurisdictions apply to the work."]</span>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="RetroPayFrom" class="ocat-label">@T["Retro pay from"]</label>
            <div class="ocat-end">
                <input asp-for="RetroPayFrom" type="date" class="form-control" style="max-width: 12rem" />
                <span class="hint">@T["The first day retro pay may reach back to. Empty for no limit."]</span>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">@T["Tax id"]</div>
    <div class="card-body">
        <div class="ocat-wrapper">
            <span class="ocat-label">@T["On file"]</span>
            <div class="ocat-end">
                @if (string.IsNullOrEmpty(Model.TaxIdHint))
                {
                    <span class="form-control-plaintext text-muted">@T["None yet"]</span>
                }
                else
                {
                    <span class="form-control-plaintext font-monospace">@Model.TaxIdHint</span>
                    @if (Model.CanRevealTaxId)
                    {
                        <button type="submit" class="btn btn-sm btn-outline-secondary" formaction="@Url.Action("TaxId", "PayProfiles", new { area = "CrestApps.OrchardCore.Payroll", id = Model.ProfileId })" formnovalidate>@T["Show the full number"]</button>
                    }
                }
            </div>
        </div>
        @if (Model.SameTaxIdStaff.Count > 0)
        {
            <div class="alert alert-warning">@T["The same tax id is on file for: {0}.", string.Join(", ", Model.SameTaxIdStaff)]</div>
        }
        <div class="ocat-wrapper">
            <label asp-for="TaxId" class="ocat-label">@T["New tax id"]</label>
            <div class="ocat-end">
                <input asp-for="TaxId" type="password" class="form-control" style="max-width: 16rem" autocomplete="new-password" data-1p-ignore data-lpignore="true" data-bwignore />
                <span class="hint">@T["Kept protected: only the last characters show. Leave it empty to keep the number on file."]</span>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Model.TaxIdHint))
        {
            <div class="ocat-wrapper">
                <div class="ocat-end-offset">
                    <div class="form-check">
                        <input asp-for="RemoveTaxId" type="checkbox" class="form-check-input" />
                        <label asp-for="RemoveTaxId" class="form-check-label">@T["Remove the tax id"]</label>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">@T["Where the cost goes"]</div>
    <div class="card-body">
        <div class="ocat-wrapper">
            <label asp-for="DepartmentTeamId" class="ocat-label">@T["Department"]</label>
            <div class="ocat-end">
                <select asp-for="DepartmentTeamId" asp-items="Model.Teams" class="form-select" style="max-width: 24rem">
                    <option value="">@T["None"]</option>
                </select>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="ActivityCode" class="ocat-label">@T["Activity and job"]</label>
            <div class="ocat-end">
                <div class="d-flex flex-wrap gap-2">
                    <input asp-for="ActivityCode" class="form-control" style="max-width: 12rem" placeholder="@T["Activity"]" />
                    <input asp-for="Job" class="form-control" style="max-width: 12rem" placeholder="@T["Job"]" aria-label="@T["Job"]" />
                </div>
                <span class="hint">@T["Used when an input says nothing about where its cost goes."]</span>
            </div>
        </div>
    </div>
</div>
