@model PayProfilesIndexViewModel

<zone Name="Title">
    <breadcrumb name="PayrollPayProfiles" title="@T["Employees"]" />
</zone>

@* The form is necessary to generate an antiforgery token for delete actions. *@
<form asp-action="Index" method="get" id="payroll-profiles-filter" class="no-multisubmit" data-list-management data-client-side-search="true">
    @Html.AntiForgeryToken()
    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <div class="input-group">
                        <input id="search-box" class="form-control" placeholder="@T["Search"]" type="search" autofocus autocomplete="off" />
                        <button type="button" class="btn btn-outline-secondary" title="@T["Search"]" aria-label="@T["Search"]"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
                    </div>
                </div>
                @if (Model.CanAdd)
                {
                    <div class="col-auto">
                        <a class="btn btn-secondary create" role="button" asp-action="Create">@T["Add pay profile"]</a>
                    </div>
                }
            </div>
        </div>
    </div>

    <admin-list name="PayrollPayProfiles" context="Model.List"
                show-select-all="false"
                empty-message="@T["<strong>Nothing here!</strong> No one has a pay profile yet. Add one here or from a staff member's Pay section."]">
        <admin-list-list item-css-class="list-group-item" />
        <admin-list-grid>
            <admin-list-column name="Name" position="20" title="@T["Staff member"]" />
            <admin-list-column name="Details" position="30" title="@T["Details"]" width="auto" />
            <admin-list-column type="Actions" title="@T["Actions"]" />
        </admin-list-grid>
    </admin-list>

    <div id="list-alert" class="alert alert-info my-3 d-none text-center" role="alert">@T["Your search returned no results."]</div>
</form>

<script asp-name="list-management-ui" at="Foot"></script>
