@model GarnishmentOrderViewModel
@using System.Globalization

<div class="card mb-3">
    <div class="card-header">@T["The order"]</div>
    <div class="card-body">
        @if (Model.IsNew)
        {
            <div class="ocat-wrapper" asp-validation-class-for="ProfileId">
                <label asp-for="ProfileId" class="ocat-label ocat-label-required">@T["Person"]</label>
                <div class="ocat-end">
                    <select asp-for="ProfileId" asp-items="Model.Profiles" class="form-select" style="max-width: 28rem">
                        <option value="">@T["Choose…"]</option>
                    </select>
                    <span asp-validation-for="ProfileId" class="text-danger"></span>
                    <span class="hint">@T["The pay profile the order applies to: the person and the employer that withholds."]</span>
                </div>
            </div>
        }
        else
        {
            <div class="ocat-wrapper">
                <label class="ocat-label">@T["Person"]</label>
                <div class="ocat-end"><p class="form-control-plaintext mb-0">@Model.ProfileName</p></div>
            </div>
        }
        <div class="ocat-wrapper">
            <label asp-for="Type" class="ocat-label">@T["Kind"]</label>
            <div class="ocat-end">
                <select asp-for="Type" class="form-select" style="max-width: 20rem">
                    <option value="Support">@T["Child or spousal support"]</option>
                    <option value="FederalTaxLevy">@T["Federal tax levy"]</option>
                    <option value="StateTaxLevy">@T["State or local tax levy"]</option>
                    <option value="Bankruptcy">@T["Bankruptcy"]</option>
                    <option value="StudentLoan">@T["Student loan"]</option>
                    <option value="Creditor">@T["Creditor"]</option>
                    <option value="Other">@T["Other"]</option>
                </select>
                <span class="hint">@T["The kind sets the limit and the order of withholding below when they are left empty."]</span>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="CaseNumber">
            <label asp-for="CaseNumber" class="ocat-label">@T["Case number"]</label>
            <div class="ocat-end">
                <input asp-for="CaseNumber" class="form-control" style="max-width: 20rem" maxlength="100" />
                <span class="hint">@T["Sent with each payment so the payee can credit it."]</span>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="Agency" class="ocat-label">@T["Court or agency"]</label>
            <div class="ocat-end">
                <input asp-for="Agency" class="form-control" maxlength="255" />
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="PayCodeId">
            <label asp-for="PayCodeId" class="ocat-label ocat-label-required">@T["Pay code"]</label>
            <div class="ocat-end">
                <select asp-for="PayCodeId" asp-items="Model.PayCodes" class="form-select" style="max-width: 24rem">
                    <option value="">@T["Choose…"]</option>
                </select>
                <span asp-validation-for="PayCodeId" class="text-danger"></span>
                <span class="hint">@T["The deduction the withholding shows as on statements and adds up under."]</span>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="ReceivedDate">
            <label asp-for="ReceivedDate" class="ocat-label">@T["Received"]</label>
            <div class="ocat-end">
                <input asp-for="ReceivedDate" type="date" class="form-control" style="max-width: 12rem" />
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="StartDate">
            <label asp-for="StartDate" class="ocat-label ocat-label-required">@T["From"]</label>
            <div class="ocat-end">
                <input asp-for="StartDate" type="date" class="form-control" style="max-width: 12rem" />
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="EndDate">
            <label asp-for="EndDate" class="ocat-label">@T["To"]</label>
            <div class="ocat-end">
                <input asp-for="EndDate" type="date" class="form-control" style="max-width: 12rem" />
                <span asp-validation-for="EndDate" class="text-danger"></span>
                <span class="hint">@T["By pay date; empty until the total owed is withheld or the order is released."]</span>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="Status" class="ocat-label">@T["Status"]</label>
            <div class="ocat-end">
                <select asp-for="Status" class="form-select" style="max-width: 14rem">
                    <option value="Active">@T["Active"]</option>
                    <option value="Suspended">@T["Suspended"]</option>
                    <option value="Completed">@T["Completed"]</option>
                    <option value="Released">@T["Released"]</option>
                </select>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">@T["How much"]</div>
    <div class="card-body">
        <div class="ocat-wrapper" asp-validation-class-for="Amount">
            <label asp-for="Amount" class="ocat-label">@T["Amount each pay"]</label>
            <div class="ocat-end">
                <input asp-for="Amount" class="form-control" inputmode="decimal" style="max-width: 10rem" />
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="Percent">
            <label asp-for="Percent" class="ocat-label">@T["Percent of disposable earnings"]</label>
            <div class="ocat-end">
                <input asp-for="Percent" class="form-control" inputmode="decimal" style="max-width: 8rem" />
                <span asp-validation-for="Percent" class="text-danger"></span>
                <span class="hint">@T["Disposable earnings are gross pay less the employee's taxes. An amount and a percent add up."]</span>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="TotalOwed">
            <label asp-for="TotalOwed" class="ocat-label">@T["Total owed"]</label>
            <div class="ocat-end">
                <input asp-for="TotalOwed" class="form-control" inputmode="decimal" style="max-width: 10rem" />
                <span asp-validation-for="TotalOwed" class="text-danger"></span>
                <span class="hint">@T["The order completes once this much was withheld; empty for an order with no end amount."]</span>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="LimitPercent">
            <label asp-for="LimitPercent" class="ocat-label">@T["Limit (% of disposable earnings)"]</label>
            <div class="ocat-end">
                <input asp-for="LimitPercent" class="form-control" inputmode="decimal" style="max-width: 8rem" />
                <span asp-validation-for="LimitPercent" class="text-danger"></span>
                <span class="hint">@T["The most the law lets the order take: 50 to 65 for support (shared by the person's support orders), 25 for a creditor and 15 for a student loan (shared with the orders before it). Empty takes the kind's."]</span>
            </div>
        </div>
        <div class="ocat-wrapper">
            <div class="ocat-end-offset">
                <div class="form-check">
                    <input asp-for="OtherDependents" type="checkbox" class="form-check-input" />
                    <label asp-for="OtherDependents" class="form-check-label">@T["Supports another spouse or child"]</label>
                    <span class="hint dashed">@T["For a support order: the person supports a spouse or child the order doesn't cover, so the limit is 50% instead of 60%."]</span>
                </div>
                <div class="form-check">
                    <input asp-for="ArrearsOver12Weeks" type="checkbox" class="form-check-input" />
                    <label asp-for="ArrearsOver12Weeks" class="form-check-label">@T["Arrears over 12 weeks old"]</label>
                    <span class="hint dashed">@T["For a support order: it collects support more than 12 weeks overdue, so the limit is 5 points higher (55% or 65%)."]</span>
                </div>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="ProtectedWeeklyAmount">
            <label asp-for="ProtectedWeeklyAmount" class="ocat-label">@T["Pay left each week"]</label>
            <div class="ocat-end">
                <input asp-for="ProtectedWeeklyAmount" class="form-control" inputmode="decimal" style="max-width: 10rem" />
                <span class="hint">@T["A creditor order never takes pay below this much a week: 30 times the federal minimum wage (217.50) unless a state's is higher."]</span>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="ExemptAmount">
            <label asp-for="ExemptAmount" class="ocat-label">@T["Exempt each pay"]</label>
            <div class="ocat-end">
                <input asp-for="ExemptAmount" class="form-control" inputmode="decimal" style="max-width: 10rem" />
                <span class="hint">@T["For a tax levy: the take-home pay exempt each pay, from the levy notice. The levy takes the rest."]</span>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="Priority">
            <label asp-for="Priority" class="ocat-label">@T["Order of withholding"]</label>
            <div class="ocat-end">
                <input asp-for="Priority" class="form-control" inputmode="numeric" style="max-width: 8rem" />
                <span class="hint">@T["The lowest number is withheld first; orders with the same number by the day they were received. Empty takes the kind's: support first, then tax levies, bankruptcy, student loans and creditors."]</span>
            </div>
        </div>
        @if (!Model.IsNew)
        {
            <div class="ocat-wrapper">
                <label class="ocat-label">@T["Withheld so far"]</label>
                <div class="ocat-end">
                    <p class="form-control-plaintext mb-0">
                        @Model.Withheld.ToString("N2", CultureInfo.CurrentCulture)
                        @if (Model.Remaining is { } left)
                        {
                            <span class="text-muted">· @T["{0} left", left.ToString("N2", CultureInfo.CurrentCulture)]</span>
                        }
                    </p>
                </div>
            </div>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">@T["The payee"]</div>
    <div class="card-body">
        <div class="ocat-wrapper" asp-validation-class-for="PayeeName">
            <label asp-for="PayeeName" class="ocat-label">@T["Payee"]</label>
            <div class="ocat-end">
                <input asp-for="PayeeName" class="form-control" maxlength="255" />
                <span asp-validation-for="PayeeName" class="text-danger"></span>
                <span class="hint">@T["Who the withholding is sent to, such as a state disbursement unit; printed on checks."]</span>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="PaymentMethod">
            <label asp-for="PaymentMethod" class="ocat-label">@T["Paid by"]</label>
            <div class="ocat-end">
                <select asp-for="PaymentMethod" class="form-select" style="max-width: 20rem">
                    <option value="Check">@T["Check"]</option>
                    <option value="BankAccount">@T["Deposit to the payee's bank account"]</option>
                    <option value="Outside">@T["Outside payroll (only recorded)"]</option>
                </select>
                <span asp-validation-for="PaymentMethod" class="text-danger"></span>
                <span class="hint">@T["A check or a deposit is made from the employer's funding account when the pay statement is processed, and stopped if the statement is voided before it goes out."]</span>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="PayeeBankAccountId">
            <label asp-for="PayeeBankAccountId" class="ocat-label">@T["Payee's bank account"]</label>
            <div class="ocat-end">
                <select asp-for="PayeeBankAccountId" asp-items="Model.BankAccounts" class="form-select" style="max-width: 24rem">
                    <option value="">@T["None"]</option>
                </select>
                <span asp-validation-for="PayeeBankAccountId" class="text-danger"></span>
                <span class="hint">@T["For a deposit: an account under Banking owned by the payee (not a staff member, not the business)."]</span>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="Notes" class="ocat-label">@T["Notes"]</label>
            <div class="ocat-end">
                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
            </div>
        </div>
    </div>
</div>

@if (Model.Remittances.Count > 0)
{
    <div class="card mb-3">
        <div class="card-header">@T["Sent to the payee"]</div>
        <div class="card-body">
            <ul class="list-group list-group-flush">
                @foreach (var row in Model.Remittances)
                {
                    <li class="list-group-item px-0">
                        @row.PayDate.ToString("d", CultureInfo.CurrentCulture) · @T["Statement {0}", row.StatementNumber] · @row.Amount.ToString("N2", CultureInfo.CurrentCulture)
                        @if (!string.IsNullOrEmpty(row.Reference))
                        {
                            <span class="text-muted">· @row.Reference</span>
                        }
                        @if (row.Voided)
                        {
                            <span class="badge ta-badge fw-normal ms-1">@T["Voided"]</span>
                        }
                        @if (!string.IsNullOrEmpty(row.Problem))
                        {
                            <div class="text-danger small">@row.Problem</div>
                        }
                        @if (!row.Voided && string.IsNullOrEmpty(row.ReferenceId) && row.Method != CrestApps.OrchardCore.Payroll.Models.GarnishmentPaymentMethod.Outside && row.Amount > 0 && !string.IsNullOrEmpty(Model.OrderId))
                        {
                            <button type="submit" class="btn btn-sm btn-outline-secondary mt-1" formaction="@Url.Action("Retry", "Garnishments", new { area = "CrestApps.OrchardCore.Payroll", id = Model.OrderId, statementId = row.StatementId })" formnovalidate>@T["Send again"]</button>
                        }
                    </li>
                }
            </ul>
        </div>
    </div>
}
