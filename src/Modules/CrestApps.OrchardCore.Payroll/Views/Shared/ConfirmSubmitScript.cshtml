@* Asks before a button marked data-confirm-submit submits its form, with the button's data-title and data-message.
   Orchard's RemoveUrl confirmation submits the form without the button, so a button's formaction would be lost:
   requestSubmit(button) keeps it. *@
<script at="Foot">
    document.addEventListener('click', (event) => {
        const button = event.target.closest('button[data-confirm-submit]');

        if (!button || !button.form || button.dataset.confirmed === 'true' || typeof window.confirmDialog !== 'function') {
            return;
        }

        event.preventDefault();

        window.confirmDialog({
            ...button.dataset,
            callback: (confirmed) => {
                if (!confirmed) {
                    return;
                }

                button.dataset.confirmed = 'true';
                button.form.requestSubmit(button);
                delete button.dataset.confirmed;
            },
        });
    });
</script>
