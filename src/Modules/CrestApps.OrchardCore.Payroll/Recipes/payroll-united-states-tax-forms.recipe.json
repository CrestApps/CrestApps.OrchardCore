        {
          "Name": "US-940",
          "DisplayName": "Form 940 (annual federal unemployment return)",
          "Description": "The employer's annual federal unemployment (FUTA) return: payments to employees, the part exempt or over each person's wage base, the taxable wages, the tax at the federal rule's rate, the deposits and the balance.",
          "Source": "Payroll",
          "Jurisdiction": "US",
          "Period": "Year",
          "HasRecipientStatements": false,
          "StatementPerJurisdiction": false,
          "RecipientCondition": null,
          "MissingTaxIdNote": null,
          "Enabled": true,
          "Values": [
            {
              "Name": "WageBase",
              "Year": 1983,
              "Amount": 7000
            },
            {
              "Name": "Rate",
              "Year": 2011,
              "Amount": 0.6
            }
          ],
          "Checks": [],
          "Fields": [
            {
              "Number": "5",
              "Label": "5 Payments to each employee in excess of the FUTA wage base",
              "Level": "Recipient",
              "Formula": "GREATEST(0, WAGES('Unemployment') - COALESCE(RULE('US-FUTA', 'WageBase'), VALUE('WageBase')))",
              "AddToFiling": true,
              "AcceptsReportedAmounts": false,
              "Print": "Never"
            },
            {
              "Number": "3",
              "Label": "3 Total payments to all employees",
              "Level": "Filing",
              "Formula": "GROSS()",
              "AddToFiling": false,
              "AcceptsReportedAmounts": false,
              "Print": "Never"
            },
            {
              "Number": "4",
              "Label": "4 Payments exempt from FUTA tax",
              "Level": "Filing",
              "Formula": "GREATEST(0, [3] - WAGES('Unemployment'))",
              "AddToFiling": false,
              "AcceptsReportedAmounts": false,
              "Print": "Never"
            },
            {
              "Number": "6",
              "Label": "6 Subtotal",
              "Level": "Filing",
              "Formula": "[4] + [5]",
              "AddToFiling": false,
              "AcceptsReportedAmounts": false,
              "Print": "Never"
            },
            {
              "Number": "7",
              "Label": "7 Total taxable FUTA wages",
              "Level": "Filing",
              "Formula": "GREATEST(0, [3] - [6])",
              "AddToFiling": false,
              "AcceptsReportedAmounts": false,
              "Print": "Never"
            },
            {
              "Number": "8",
              "Label": "8 FUTA tax before adjustments",
              "Level": "Filing",
              "Formula": "ROUND([7] * COALESCE(RULE('US-FUTA', 'Rate'), VALUE('Rate')) / 100, 2)",
              "AddToFiling": false,
              "AcceptsReportedAmounts": false,
              "Print": "Never"
            },
            {
              "Number": "12",
              "Label": "12 Total FUTA tax after adjustments",
              "Level": "Filing",
              "Formula": "[8]",
              "AddToFiling": false,
              "AcceptsReportedAmounts": false,
              "Print": "Never"
            },
            {
              "Number": "13",
              "Label": "13 FUTA tax deposited for the year",
              "Level": "Filing",
              "Formula": "DEPOSITS('US', 'Unemployment')",
              "AddToFiling": false,
              "AcceptsReportedAmounts": false,
              "Print": "Never"
            },
            {
              "Number": "14",
              "Label": "14 Balance due",
              "Level": "Filing",
              "Formula": "GREATEST(0, [12] - [13])",
              "AddToFiling": false,
              "AcceptsReportedAmounts": false,
              "Print": "Never"
            },
            {
              "Number": "15",
              "Label": "15 Overpayment",
              "Level": "Filing",
              "Formula": "GREATEST(0, [13] - [12])",
              "AddToFiling": false,
              "AcceptsReportedAmounts": false,
              "Print": "Never"
            }
