{
  "name": "PayrollUnitedStatesTaxForms",
  "displayName": "United States Payroll: federal tax forms",
  "description": "Adds the federal tax forms an employer registered in US files, worked out from the final pay statements: Form 941 (quarterly), Forms 940 and 945, Forms W-2 and W-3, and Forms 1099-NEC and 1096. Running it again puts back the shipped fields and formulas of these forms. Edit the forms, or add others, under Taxation > Tax Forms; check the figures against the IRS's current instructions before filing.",
  "author": "CrestApps",
  "website": "https://crestapps.com",
  "version": "1.0.0",
  "issetuprecipe": false,
  "categories": [
    "payroll"
  ],
  "tags": [
    "payroll",
    "united states",
    "tax forms",
    "941",
    "w-2",
    "1099-nec"
  ],
  "steps": [
    {
      "name": "Feature",
      "enable": [
        "CrestApps.OrchardCore.Taxation.TaxForms",
        "CrestApps.OrchardCore.Payroll",
        "CrestApps.OrchardCore.Payroll.UnitedStates"
      ]
    },
    {
      "name": "TaxForms",
      "Forms": [
        {
          "Name": "US-941",
          "DisplayName": "Form 941 (quarterly federal return)",
          "Description": "The employer's quarterly federal tax return: wages, income tax withheld, Social Security and Medicare wages and taxes (both sides, at the form's rates), the fractions-of-cents adjustment, the deposits and the balance.",
          "Source": "Payroll",
          "Jurisdiction": "US",
          "Period": "Quarter",
          "HasRecipientStatements": false,
          "StatementPerJurisdiction": false,
          "RecipientCondition": null,
          "MissingTaxIdNote": null,
          "Enabled": true,
          "Values": [
            {
              "Name": "SocialSecurityRate",
              "Year": 2000,
              "Amount": 0.124
            },
            {
              "Name": "MedicareRate",
              "Year": 2000,
              "Amount": 0.029
            },
            {
              "Name": "AdditionalMedicareRate",
              "Year": 2013,
              "Amount": 0.009
            }
          ],
          "Checks": [],
          "Fields": [
            {
              "Number": "1",
              "Label": "1 Number of employees paid for the pay period including the 12th of the quarter's last month",
              "Level": "Filing",
              "Formula": "HEADCOUNT(12)",
              "AddToFiling": false,
              "AcceptsReportedAmounts": false,
              "Print": "Never"
            },
            {
              "Number": "2",
              "Label": "2 Wages, tips, and other compensation",
              "Level": "Filing",
              "Formula": "WAGES('IncomeTax')",
              "AddToFiling": false,
              "AcceptsReportedAmounts": false,
              "Print": "Never"
            },
            {
              "Number": "3",
              "Label": "3 Federal income tax withheld",
              "Level": "Filing",
              "Formula": "TAX('US-FIT')",
              "AddToFiling": false,
              "AcceptsReportedAmounts": false,
              "Print": "Never"
            },
            {
              "Number": "5a",
              "Label": "5a Taxable social security wages",
              "Level": "Filing",
              "Formula": "GREATEST(0, TAXABLE('US-SS-EE') - [5b])",
              "AddToFiling": false,
              "AcceptsReportedAmounts": false,
              "Print": "Never"
            },
            {
              "Number": "5a.tax",
              "Label": "5a Tax on taxable social security wages",
              "Level": "Filing",
              "Formula": "ROUND([5a] * VALUE('SocialSecurityRate'), 2)",
              "AddToFiling": false,
              "AcceptsReportedAmounts": false,
              "Print": "Never"
            },
            {
              "Number": "5b",
              "Label": "5b Taxable social security tips",
              "Level": "Filing",
              "Formula": "PAYKIND('Tips')",
              "AddToFiling": false,
              "AcceptsReportedAmounts": false,
              "Print": "Never"
            },
            {
              "Number": "5b.tax",
              "Label": "5b Tax on taxable social security tips",
              "Level": "Filing",
              "Formula": "ROUND([5b] * VALUE('SocialSecurityRate'), 2)",
              "AddToFiling": false,
              "AcceptsReportedAmounts": false,
              "Print": "Never"
            },
            {
              "Number": "5c",
              "Label": "5c Taxable Medicare wages and tips",
              "Level": "Filing",
              "Formula": "TAXABLE('US-MED-EE')",
              "AddToFiling": false,
              "AcceptsReportedAmounts": false,
              "Print": "Never"
            },
            {
              "Number": "5c.tax",
              "Label": "5c Tax on taxable Medicare wages and tips",
              "Level": "Filing",
              "Formula": "ROUND([5c] * VALUE('MedicareRate'), 2)",
              "AddToFiling": false,
              "AcceptsReportedAmounts": false,
              "Print": "Never"
            },
            {
              "Number": "5d",
              "Label": "5d Taxable wages and tips subject to Additional Medicare Tax withholding",
              "Level": "Filing",
              "Formula": "TAXABLE('US-MED-ADD')",
              "AddToFiling": false,
              "AcceptsReportedAmounts": false,
              "Print": "Never"
            },
            {
              "Number": "5d.tax",
              "Label": "5d Additional Medicare Tax",
              "Level": "Filing",
              "Formula": "ROUND([5d] * VALUE('AdditionalMedicareRate'), 2)",
              "AddToFiling": false,
              "AcceptsReportedAmounts": false,
              "Print": "Never"
            },
            {
              "Number": "5e",
              "Label": "5e Total social security and Medicare taxes",
              "Level": "Filing",
              "Formula": "[5a.tax] + [5b.tax] + [5c.tax] + [5d.tax]",
              "AddToFiling": false,
              "AcceptsReportedAmounts": false,
              "Print": "Never"
            },
            {
              "Number": "6",
              "Label": "6 Total taxes before adjustments",
              "Level": "Filing",
              "Formula": "[3] + [5e]",
              "AddToFiling": false,
              "AcceptsReportedAmounts": false,
              "Print": "Never"
            },
            {
              "Number": "7",
              "Label": "7 Current quarter's adjustment for fractions of cents",
              "Level": "Filing",
              "Formula": "TAX('US-SS-EE', 'US-SS-ER', 'US-MED-EE', 'US-MED-ER', 'US-MED-ADD') - [5e]",
              "AddToFiling": false,
              "AcceptsReportedAmounts": false,
              "Print": "Never"
            },
            {
              "Number": "10",
              "Label": "10 Total taxes after adjustments",
              "Level": "Filing",
              "Formula": "[6] + [7]",
              "AddToFiling": false,
              "AcceptsReportedAmounts": false,
              "Print": "Never"
            },
            {
              "Number": "12",
              "Label": "12 Total taxes after adjustments and nonrefundable credits",
              "Level": "Filing",
              "Formula": "[10]",
              "AddToFiling": false,
              "AcceptsReportedAmounts": false,
              "Print": "Never"
            },
            {
              "Number": "13",
              "Label": "13 Total deposits for this quarter",
              "Level": "Filing",
              "Formula": "DEPOSITS('US', 'Withholding')",
              "AddToFiling": false,
              "AcceptsReportedAmounts": false,
              "Print": "Never"
            },
            {
              "Number": "14",
              "Label": "14 Balance due",
              "Level": "Filing",
              "Formula": "GREATEST(0, [12] - [13])",
              "AddToFiling": false,
              "AcceptsReportedAmounts": false,
              "Print": "Never"
            },
            {
              "Number": "15",
              "Label": "15 Overpayment",
              "Level": "Filing",
              "Formula": "GREATEST(0, [13] - [12])",
              "AddToFiling": false,
              "AcceptsReportedAmounts": false,
              "Print": "Never"
            }
          ],
          "Statement": {},
          "Properties": {
            "PayrollTaxFormSettings": {
              "Workers": "Employees",
              "PeopleJurisdiction": null,
              "ListJurisdictionAmounts": false,
              "PayCodeFieldPrefix": null
            }
          }
