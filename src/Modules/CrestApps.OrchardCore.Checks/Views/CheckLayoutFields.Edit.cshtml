@model CheckLayoutViewModel

<div class="card mb-3">
    <div class="card-header">@T["The layout"]</div>
    <div class="card-body">
        <div class="ocat-wrapper" asp-validation-class-for="Name">
            <label asp-for="Name" class="ocat-label ocat-label-required">@T["Name"]</label>
            <div class="ocat-end">
                <input asp-for="Name" class="form-control" maxlength="255" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="Description">
            <label asp-for="Description" class="ocat-label">@T["Notes"]</label>
            <div class="ocat-end">
                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                <span class="hint">@T["Such as the stock and the printer the layout is calibrated for."]</span>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="Stock">
            <label asp-for="Stock" class="ocat-label">@T["Paper"]</label>
            <div class="ocat-end">
                <select asp-for="Stock" asp-items="Model.StockOptions" class="form-select"></select>
                <span class="hint">@T["On blank check paper the layout also prints the payer, the bank and the check line. Pre-printed checks have them already."]</span>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="Form">
            <label asp-for="Form" class="ocat-label">@T["Sheet"]</label>
            <div class="ocat-end">
                <select asp-for="Form" asp-items="Model.FormOptions" class="form-select"></select>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">@T["Payer (blank paper)"]</div>
    <div class="card-body">
        <div class="ocat-wrapper" asp-validation-class-for="PayerName">
            <label asp-for="PayerName" class="ocat-label">@T["Name"]</label>
            <div class="ocat-end">
                <input asp-for="PayerName" class="form-control" maxlength="255" />
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="PayerAddressLine1" class="ocat-label">@T["Address"]</label>
            <div class="ocat-end">
                <input asp-for="PayerAddressLine1" class="form-control mb-1" maxlength="255" placeholder="@T["Street"]" />
                <input asp-for="PayerAddressLine2" class="form-control mb-1" maxlength="255" placeholder="@T["Suite or unit"]" />
                <input asp-for="PayerCity" class="form-control mb-1" maxlength="100" placeholder="@T["City"]" />
                <input asp-for="PayerRegion" class="form-control mb-1" maxlength="100" placeholder="@T["State"]" />
                <input asp-for="PayerPostalCode" class="form-control" maxlength="20" placeholder="@T["Postal code"]" />
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">@T["Signatures"]</div>
    <div class="card-body">
        <div class="ocat-wrapper" asp-validation-class-for="SignatureFile">
            <label asp-for="SignatureFile" class="ocat-label">@T["Signature"]</label>
            <div class="ocat-end">
                <input asp-for="SignatureFile" class="form-control" type="file" accept="image/png,image/jpeg" />
                <span asp-validation-for="SignatureFile" class="text-danger"></span>
                @if (Model.HasSignature)
                {
                    <div class="form-check mt-1">
                        <input asp-for="RemoveSignature" class="form-check-input" />
                        <label asp-for="RemoveSignature" class="form-check-label">@T["Remove the stored signature"]</label>
                    </div>
                }
                <span class="hint">@(Model.HasSignature ? T["A signature is stored. Upload a PNG or JPEG to replace it."] : T["Optional. A PNG or JPEG printed above the signature line. It is kept encrypted, never in the media library."])</span>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="SecondSignatureAbove">
            <label asp-for="SecondSignatureAbove" class="ocat-label">@T["Second signature above"]</label>
            <div class="ocat-end">
                <input asp-for="SecondSignatureAbove" class="form-control" inputmode="decimal" />
                <span asp-validation-for="SecondSignatureAbove" class="text-danger"></span>
                <span class="hint">@T["Checks for more than this amount print a second signature line. Leave it empty for never."]</span>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="SecondSignatureFile">
            <label asp-for="SecondSignatureFile" class="ocat-label">@T["Second signature"]</label>
            <div class="ocat-end">
                <input asp-for="SecondSignatureFile" class="form-control" type="file" accept="image/png,image/jpeg" />
                <span asp-validation-for="SecondSignatureFile" class="text-danger"></span>
                @if (Model.HasSecondSignature)
                {
                    <div class="form-check mt-1">
                        <input asp-for="RemoveSecondSignature" class="form-check-input" />
                        <label asp-for="RemoveSecondSignature" class="form-check-label">@T["Remove the stored second signature"]</label>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">@T["Check line (MICR)"]</div>
    <div class="card-body">
        <div class="ocat-wrapper" asp-validation-class-for="PrintMicr">
            <div class="ocat-end-offset">
                <div class="form-check">
                    <input asp-for="PrintMicr" class="form-check-input" />
                    <label asp-for="PrintMicr" class="form-check-label">@T["Print the check line"]</label>
                    <span class="hint dashed">@T["The routing, account and check numbers at the bottom of the check, in the E-13B font. Banks read it with magnetic toner. Leave it off on pre-printed checks."]</span>
                </div>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="MicrFontFile">
            <label asp-for="MicrFontFile" class="ocat-label">@T["Check line font"]</label>
            <div class="ocat-end">
                <input asp-for="MicrFontFile" class="form-control" type="file" accept=".ttf" />
                <span asp-validation-for="MicrFontFile" class="text-danger"></span>
                @if (Model.HasMicrFont)
                {
                    <div class="form-check mt-1">
                        <input asp-for="RemoveMicrFont" class="form-check-input" />
                        <label asp-for="RemoveMicrFont" class="form-check-label">@T["Remove the stored font"]</label>
                    </div>
                }
                else
                {
                    <div class="text-warning small mt-1">@T["No check line font is uploaded. The check line can't print until you upload a TrueType MICR E-13B font you are licensed to use."]</div>
                }
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="MicrSymbolCharacters">
            <label asp-for="MicrSymbolCharacters" class="ocat-label">@T["Symbol characters"]</label>
            <div class="ocat-end">
                <input asp-for="MicrSymbolCharacters" class="form-control" maxlength="4" />
                <span asp-validation-for="MicrSymbolCharacters" class="text-danger"></span>
                <span class="hint">@T["The four characters the font draws the transit, amount, on-us and dash symbols on, in that order. Most fonts use ABCD."]</span>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="MicrFontSize">
            <label asp-for="MicrFontSize" class="ocat-label">@T["Font size"]</label>
            <div class="ocat-end">
                <input asp-for="MicrFontSize" class="form-control" inputmode="decimal" />
                <span asp-validation-for="MicrFontSize" class="text-danger"></span>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="UseAuxiliaryOnUs">
            <div class="ocat-end-offset">
                <div class="form-check">
                    <input asp-for="UseAuxiliaryOnUs" class="form-check-input" />
                    <label asp-for="UseAuxiliaryOnUs" class="form-check-label">@T["Business check format"]</label>
                    <span class="hint dashed">@T["The check number prints left of the routing number. Off, it prints after the account number, as on personal checks."]</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">@T["Calibration"]</div>
    <div class="card-body">
        <p class="hint">@T["Print a check on plain paper and hold it against the stock. Measures are in points: 72 points make an inch."]</p>
        <div class="ocat-wrapper" asp-validation-class-for="OffsetX">
            <label asp-for="OffsetX" class="ocat-label">@T["Move right"]</label>
            <div class="ocat-end">
                <input asp-for="OffsetX" class="form-control" inputmode="decimal" />
                <span asp-validation-for="OffsetX" class="text-danger"></span>
                <span class="hint">@T["Negative moves left."]</span>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="OffsetY">
            <label asp-for="OffsetY" class="ocat-label">@T["Move down"]</label>
            <div class="ocat-end">
                <input asp-for="OffsetY" class="form-control" inputmode="decimal" />
                <span asp-validation-for="OffsetY" class="text-danger"></span>
                <span class="hint">@T["Negative moves up."]</span>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">@T["Fields"]</div>
    <div class="card-body">
        <p class="hint">@T["Where each field prints, from the top left corner of the check, in points."]</p>
        <span asp-validation-for="Fields" class="text-danger"></span>
        @for (var i = 0; i < Model.Fields.Count; i++)
        {
            <fieldset class="ocat-wrapper border-bottom pb-2 mb-2">
                <legend class="ocat-label fs-6">@Model.Fields[i].Label</legend>
                <div class="ocat-end">
                    <input type="hidden" asp-for="Fields[i].Name" />
                    <div class="input-group input-group-sm mb-1">
                        <span class="input-group-text">@T["Left"]</span>
                        <input asp-for="Fields[i].X" class="form-control" inputmode="decimal" aria-label="@T["Left"]" />
                        <span class="input-group-text">@T["Top"]</span>
                        <input asp-for="Fields[i].Y" class="form-control" inputmode="decimal" aria-label="@T["Top"]" />
                    </div>
                    <div class="input-group input-group-sm mb-1">
                        <span class="input-group-text">@T["Width"]</span>
                        <input asp-for="Fields[i].Width" class="form-control" inputmode="decimal" aria-label="@T["Width"]" />
                        <span class="input-group-text">@T["Size"]</span>
                        <input asp-for="Fields[i].FontSize" class="form-control" inputmode="decimal" aria-label="@T["Size"]" />
                    </div>
                    <div class="form-check">
                        <input asp-for="Fields[i].Hidden" class="form-check-input" />
                        <label asp-for="Fields[i].Hidden" class="form-check-label">@T["Leave off"]</label>
                    </div>
                </div>
            </fieldset>
        }
    </div>
</div>
