@model ShapeViewModel<CheckRecord>

@{
    var check = Model.Value;
    var (status, icon) = check.Status switch
    {
        CheckStatus.Printed => (T["Printed"], "fa-solid fa-print text-info"),
        CheckStatus.Cleared => (T["Cleared"], "fa-solid fa-circle-check text-success"),
        CheckStatus.Voided => (T["Voided"], "fa-solid fa-ban text-secondary"),
        CheckStatus.StopPayment => (T["Stop payment"], "fa-solid fa-hand text-danger"),
        CheckStatus.Reissued => (T["Reissued"], "fa-solid fa-rotate text-secondary"),
        CheckStatus.Stale => (T["Stale"], "fa-solid fa-hourglass-end text-warning"),
        _ => (T["Issued"], "fa-solid fa-file-invoice-dollar text-warning"),
    };
}

<span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Status"]"><i class="@icon me-1" aria-hidden="true"></i>@status</span>
@if (check.IsHistorical)
{
    <span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Imported from another system: it is history."]"><i class="fa-solid fa-box-archive text-secondary me-1" aria-hidden="true"></i>@T["History"]</span>
}
@if (!string.IsNullOrEmpty(check.SourceKind))
{
    <span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Pays"]"><i class="fa-solid fa-link text-secondary me-1" aria-hidden="true"></i>@check.SourceKind</span>
}
