@model HelpCenterViewModel

<zone Name="Title">
    <breadcrumb name="KnowledgeBaseHome" title="@T["Help center"]" />
</zone>

@{
    var searching = !string.IsNullOrWhiteSpace(Model.Query) || !string.IsNullOrWhiteSpace(Model.Category);
}

<div class="container my-4" style="max-width: 960px;">
    <h1 class="h3 mb-3">@T["Help center"]</h1>

    <form method="get" asp-route="@KnowledgeBaseConstants.HomeRouteName" class="mb-4" role="search">
        <div class="input-group">
            <input type="search" name="q" value="@Model.Query" class="form-control" placeholder="@T["Search the articles"]" aria-label="@T["Search the articles"]" />
            @if (!string.IsNullOrEmpty(Model.Category))
            {
                <input type="hidden" name="category" value="@Model.Category" />
            }
            <button type="submit" class="btn btn-primary">@T["Search"]</button>
        </div>
    </form>

    <div class="row g-4">
        <div class="col-md-4">
            <h2 class="h6 text-uppercase text-body-secondary">@T["Categories"]</h2>
            <div class="list-group">
                <a class="list-group-item list-group-item-action@(string.IsNullOrEmpty(Model.Category) ? " active" : null)" href="@Url.RouteUrl(KnowledgeBaseConstants.HomeRouteName)">@T["All articles"]</a>
                @foreach (var (category, count) in Model.Categories)
                {
                    <a class="list-group-item list-group-item-action d-flex justify-content-between@(string.Equals(category, Model.Category, StringComparison.OrdinalIgnoreCase) ? " active" : null)" href="@Url.RouteUrl(KnowledgeBaseConstants.HomeRouteName, new { category })">
                        <span>@category</span><span class="badge text-bg-light">@count</span>
                    </a>
                }
            </div>
        </div>
        <div class="col-md-8">
            <h2 class="h6 text-uppercase text-body-secondary">@(searching ? T["Articles found"] : T["Most helpful"])</h2>
            @if (Model.Articles.Count == 0)
            {
                <p class="text-body-secondary">@(searching ? T["No article matches. Try other words."] : T["There are no articles yet."])</p>
            }
            else
            {
                <div class="list-group">
                    @foreach (var article in Model.Articles)
                    {
                        <a class="list-group-item list-group-item-action" asp-area="OrchardCore.Contents" asp-controller="Item" asp-action="Display" asp-route-contentItemId="@article.ContentItemId">
                            <div class="fw-semibold">@article.Title</div>
                            @if (!string.IsNullOrWhiteSpace(article.Summary))
                            {
                                <div class="small text-body-secondary">@article.Summary</div>
                            }
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>
