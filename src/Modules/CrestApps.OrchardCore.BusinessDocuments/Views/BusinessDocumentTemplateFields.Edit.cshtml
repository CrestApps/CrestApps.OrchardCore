@model BusinessDocumentTemplateViewModel

<div class="ocat-wrapper" asp-validation-class-for="Name">
    <label asp-for="Name" class="ocat-label ocat-label-required">@T["Name"]</label>
    <div class="ocat-end">
        <input asp-for="Name" class="form-control" maxlength="255" />
        <span asp-validation-for="Name" class="text-danger"></span>
        <span class="hint">@T["A name staff recognize, such as Standard or Wholesale."]</span>
    </div>
</div>
<div class="ocat-wrapper" asp-validation-class-for="Description">
    <label asp-for="Description" class="ocat-label">@T["Notes"]</label>
    <div class="ocat-end">
        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
    </div>
</div>
<div class="ocat-wrapper" asp-validation-class-for="Kinds">
    <label class="ocat-label">@T["Used for"]</label>
    <div class="ocat-end">
        @if (Model.KindOptions.Count == 0)
        {
            <span class="hint">@T["No enabled feature prints business documents yet. The template is used for every kind of document."]</span>
        }
        @foreach (var option in Model.KindOptions)
        {
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="@Html.NameFor(m => m.Kinds)" value="@option.Value" id="@Html.IdFor(m => m.Kinds)-@option.Value" checked="@option.Selected" />
                <label class="form-check-label" for="@Html.IdFor(m => m.Kinds)-@option.Value">@option.Text</label>
            </div>
        }
        <span class="hint">@T["The kinds of documents the template is for. Choose none to use it for every kind."]</span>
    </div>
</div>
<div class="ocat-wrapper" asp-validation-class-for="IsDefault">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input asp-for="IsDefault" class="form-check-input" />
            <label asp-for="IsDefault" class="form-check-label">@T["Default template"]</label>
            <span class="hint dashed">@T["Documents of its kinds that name no template are printed with it. Saving it as the default stops another template from being the default for the same kinds."]</span>
        </div>
    </div>
</div>
