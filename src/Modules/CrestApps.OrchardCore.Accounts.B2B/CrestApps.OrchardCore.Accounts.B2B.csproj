<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
    <Title>CrestApps OrchardCore Accounts B2B</Title>
    <Description>
      $(OCCMSDescription)

      Selling to businesses on the shared account: several buyers and locations, payment terms with a deposit and net
      days, purchase order numbers, quotes, price lists, approvals and budgets, and punchout.
    </Description>
    <PackageTags>$(PackageTags) CrestApps OrchardCoreCMS Commerce Accounts B2B</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
