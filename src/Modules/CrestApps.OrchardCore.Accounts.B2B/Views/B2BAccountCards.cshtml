@using CrestApps.OrchardCore.Accounts.B2B.Drivers
@using CrestApps.OrchardCore.Products.Core.Services
@model B2BAccountCardsViewModel

@{
    var account = Model.Account;
    var terms = account.Terms;
}

<div class="card mb-3">
    <div class="card-header">@T["Business buying"]</div>
    <div class="card-body">
        <div class="mb-2">
            @if (terms.OffersTerms)
            {
                <span class="badge ta-badge fw-normal me-1"><i class="fa-solid fa-file-invoice-dollar text-secondary me-1" aria-hidden="true"></i>@T["Net {0}", terms.NetDays]</span>
                @if (terms.DepositPercent > 0m)
                {
                    <span class="badge ta-badge fw-normal me-1">@T["{0}% deposit", terms.DepositPercent.ToString("0.##", System.Globalization.CultureInfo.CurrentCulture)]</span>
                }
            }
            else
            {
                <span class="badge ta-badge fw-normal me-1">@T["Pays at checkout"]</span>
            }
            @if (terms.CreditLimit is { } limit)
            {
                <span class="badge ta-badge fw-normal me-1">@T["Credit limit {0}", ProductPriceFormatter.Format(limit, Model.Currency)]</span>
            }
            @if (account.MonthlyBudget is { } budget)
            {
                <span class="badge ta-badge fw-normal me-1">@T["Monthly budget {0}", ProductPriceFormatter.Format(budget, Model.Currency)]</span>
            }
        </div>
        @if (terms.OffersTerms)
        {
            <p class="mb-2">@T["Owes {0} on its terms.", ProductPriceFormatter.Format(Model.Owed, Model.Currency)]</p>
        }

        <h6 class="mt-3">@T["Buyers"]</h6>
        @if (account.Buyers.Count == 0)
        {
            <p class="text-body-secondary mb-0">@T["No buyers yet. Add them on the account's editor."]</p>
        }
        else
        {
            <ul class="list-unstyled mb-0">
                @foreach (var buyer in account.Buyers)
                {
                    <li>
                        @(buyer.Email ?? buyer.UserName)
                        <span class="badge ta-badge fw-normal ms-1">@(buyer.Role == AccountBuyerRole.Admin ? T["Admin"] : T["Buyer"])</span>
                        @if (!string.IsNullOrEmpty(buyer.ContactContentItemId))
                        {
                            <a class="small ms-1" asp-action="Display" asp-controller="Admin" asp-route-area="OrchardCore.Contents" asp-route-contentItemId="@buyer.ContactContentItemId">@T["Contact"]</a>
                        }
                    </li>
                }
            </ul>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">@T.Plural(Model.OrderCount, "1 order", "{0} orders")</div>
    @if (Model.Orders.Count == 0)
    {
        <div class="card-body text-body-secondary">@T["No orders yet."]</div>
    }
    else
    {
        <ul class="list-group list-group-flush">
            @foreach (var order in Model.Orders)
            {
                <li class="list-group-item d-flex justify-content-between">
                    <a href="@Url.RouteUrl("OrdersDetail", new { area = "CrestApps.OrchardCore.Orders", orderId = order.ItemId })">@T["Order {0}", order.OrderNumber]</a>
                    <span class="text-body-secondary">@(order.Total is { } total ? ProductPriceFormatter.Format(total, order.Currency) : null)</span>
                </li>
            }
        </ul>
    }
</div>
