@model PriceListEditViewModel

<zone Name="Title">
    <breadcrumb name="PriceListEdit" title="@(Model.IsNew ? T["Add Price List"] : T["Edit Price List"])">
        <breadcrumb-item id="PriceLists" action="Index" controller="PriceListsAdmin" area="@B2BAccountsConstants.Feature" permission="@B2BAccountsPermissions.ManageB2BAccounts.Name">@T["Price Lists"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form method="post" class="no-multisubmit">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <button type="submit" class="btn btn-primary save">@T["Save"]</button>
        <a asp-action="Index" class="btn btn-secondary">@T["Cancel"]</a>
    </div>
</form>
