<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <Title>CrestApps OrchardCore Products - Elasticsearch</Title>
    <Description>
      $(CrestAppsDescription)

      Product listings that search an Elasticsearch index.
    </Description>
    <PackageTags>$(PackageTags) OrchardCoreCMS Products Commerce Search Elasticsearch</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OrchardCore.Module.Targets" />
    <PackageReference Include="OrchardCore.Elasticsearch.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Core/CrestApps.OrchardCore.Products.Core/CrestApps.OrchardCore.Products.Core.csproj" />
    <ProjectReference Include="../CrestApps.OrchardCore.Products/CrestApps.OrchardCore.Products.csproj" PrivateAssets="none" />
  </ItemGroup>

</Project>
