@*
    The filters of the statements list, passed to the admin list as its ToolbarActions so they render at the end of
    the list's toolbar, inside the page's GET filter form.
*@
@{
    var listModel = (StatementListViewModel)Model.ListModel;
}

<style asp-name="bootstrap-select"></style>
<script asp-name="bootstrap-select" depends-on="bootstrap" at="Foot"></script>

@* The text and date filters apply with the Filter button; the verb picker submits on change. *@
<div class="d-flex flex-wrap align-items-center gap-2 filter">
    <input type="text" name="Options.Activity" value="@listModel.Options.Activity" class="form-control form-control-sm w-auto" placeholder="@T["Activity IRI"]" aria-label="@T["Activity IRI"]" />
    <input type="text" name="Options.Registration" value="@listModel.Options.Registration" class="form-control form-control-sm w-auto" placeholder="@T["Registration"]" aria-label="@T["Registration"]" />
    <input type="date" name="Options.From" value="@listModel.Options.From" class="form-control form-control-sm w-auto" aria-label="@T["Stored from"]" title="@T["Stored from"]" />
    <input type="date" name="Options.To" value="@listModel.Options.To" class="form-control form-control-sm w-auto" aria-label="@T["Stored to"]" title="@T["Stored to"]" />
    <button type="submit" class="btn btn-sm btn-secondary">@T["Filter"]</button>
    <a asp-action="Index" class="btn btn-sm btn-link">@T["Clear"]</a>
</div>
<div class="btn-group filter">
    <select name="Options.Verb" asp-items="listModel.Verbs" class="selectpicker show-tick" data-style="btn-sm" data-width="fit" data-header="@T["Verb"]" data-dropdown-align-right="auto" aria-label="@T["Verb"]" onchange="this.form.submit()">
        <option value="">@T["Any verb"]</option>
    </select>
</div>
