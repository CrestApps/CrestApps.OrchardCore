@using CrestApps.OrchardCore.Learning.Xapi.Recipes
@model ShapeViewModel<LearningStatementsDeploymentStep>

<h5>@T["Learning statements (learner records)"]</h5>
<p class="hint">@T["Exports every xAPI statement of the Learning Record Store as it was stored, with its voided mark. Statements cannot change, so the actors stay as the statements name them. The content of attachments stays in the protected store of this site. Learner records hold personal data: the export needs the Export learner records permission and is recorded."]</p>
