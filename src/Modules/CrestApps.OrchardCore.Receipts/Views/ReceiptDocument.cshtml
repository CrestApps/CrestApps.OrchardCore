@using CrestApps.OrchardCore.BusinessDocuments.Services
@using CrestApps.OrchardCore.Receipts.Core.Services
@model ReceiptDocument
@inject ReceiptBusinessDocumentMapper ReceiptMapper
@inject IBusinessDocumentTemplateManager TemplateManager

@* Other modules render this view as a partial with a ReceiptDocument. It prints the receipt through the shared
   BusinessDocument shape, in the look of the document template for receipts, so a theme restyles receipts with
   BusinessDocument-Receipt.cshtml. *@
@{
    var document = ReceiptMapper.Map(Model);

    await TemplateManager.ApplyAsync(document);
}
@await DisplayAsync(await New.BusinessDocument(Document: document))
