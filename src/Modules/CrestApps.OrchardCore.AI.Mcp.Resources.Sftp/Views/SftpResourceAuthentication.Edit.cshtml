@using CrestApps.OrchardCore.AI.FileTransfer.Core.ViewModels

@model SftpConnectionFieldsViewModel

<div class="ocat-wrapper">
    <label asp-for="Username" class="ocat-label ocat-label-required">@T["Username"]</label>
    <div class="ocat-end">
        <input asp-for="Username" class="form-control" />
        <span asp-validation-for="Username" class="text-danger"></span>
        <span class="hint">@T["The username for SFTP authentication."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="Password" class="ocat-label">@T["Password"]</label>
    <div class="ocat-end">
        @if (Model.HasPassword)
        {
            <input asp-for="Password" type="password" class="form-control" placeholder="@T["Keep current password"]" autocomplete="new-password" data-1p-ignore data-lpignore="true" data-bwignore="true" />
            <span class="hint">@T["Leave empty to keep the current password."]</span>
        }
        else
        {
            <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" data-1p-ignore data-lpignore="true" data-bwignore="true" />
        }
        <span asp-validation-for="Password" class="text-danger"></span>
        <span class="hint">@T["The password for password-based authentication. Optional if using private key."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="PrivateKey" class="ocat-label">@T["Private Key"]</label>
    <div class="ocat-end">
        @if (Model.HasPrivateKey)
        {
            <textarea asp-for="PrivateKey" class="form-control" rows="5" placeholder="@T["Keep current private key"]"></textarea>
            <span class="hint">@T["Leave empty to keep the current private key."]</span>
        }
        else
        {
            <textarea asp-for="PrivateKey" class="form-control" rows="5" placeholder="-----BEGIN RSA PRIVATE KEY-----"></textarea>
        }
        <span asp-validation-for="PrivateKey" class="text-danger"></span>
        <span class="hint">@T["The private key for key-based authentication. Optional if using password."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="Passphrase" class="ocat-label">@T["Passphrase"]</label>
    <div class="ocat-end">
        @if (Model.HasPassphrase)
        {
            <input asp-for="Passphrase" type="password" class="form-control" placeholder="@T["Keep current passphrase"]" autocomplete="new-password" data-1p-ignore data-lpignore="true" data-bwignore="true" />
            <span class="hint">@T["Leave empty to keep the current passphrase."]</span>
        }
        else
        {
            <input asp-for="Passphrase" type="password" class="form-control" autocomplete="new-password" data-1p-ignore data-lpignore="true" data-bwignore="true" />
        }
        <span asp-validation-for="Passphrase" class="text-danger"></span>
        <span class="hint">@T["The passphrase for the private key. Only required if the private key is encrypted."]</span>
    </div>
</div>

