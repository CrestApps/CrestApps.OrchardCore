@using CrestApps.OrchardCore.Reports.Models
@model ReportDocument

@{
    var containers = Model.Containers
        .Where(container => !string.IsNullOrEmpty(container.Id))
        .DistinctBy(container => container.Id, StringComparer.Ordinal)
        .ToDictionary(container => container.Id, StringComparer.Ordinal);
    var placed = new HashSet<string>(StringComparer.Ordinal);
}

<style asp-name="CrestApps.OrchardCore.Reports.Document"></style>

<div class="row g-4 mb-4 report-document">
    @for (var sectionIndex = 0; sectionIndex < Model.Sections.Count; sectionIndex++)
    {
        var reportSection = Model.Sections[sectionIndex];

        if (string.IsNullOrEmpty(reportSection.ContainerId) || !containers.TryGetValue(reportSection.ContainerId, out var container))
        {
            <partial name="_ReportSection" model="new ReportSectionViewModel { Section = reportSection, ShowTitle = sectionIndex > 0 }" />

            continue;
        }

        @* A container is placed where its first section is and frames all of its sections; a container with a height scrolls them. *@
        if (!placed.Add(container.Id))
        {
            continue;
        }

        var height = container.Height > 0 ? $"height: {container.Height}px;" : null;

        <section class="report-container col-12 col-xl-@Math.Clamp(container.Width, 1, 12) d-flex flex-column" data-report-container="@container.Id">
            <div class="card flex-grow-1 shadow-sm">
                @if (!string.IsNullOrEmpty(container.Title))
                {
                    <div class="card-header report-container-header">@container.Title</div>
                }
                <div class="card-body report-container-body@(height is null ? null : " is-scrolling")" style="@height">
                    <div class="row g-3">
                        @foreach (var inner in Model.Sections.Where(candidate => candidate.ContainerId == container.Id))
                        {
                            <partial name="_ReportSection" model="new ReportSectionViewModel { Section = inner, ShowTitle = true }" />
                        }
                    </div>
                </div>
            </div>
        </section>
    }
</div>

@if (Model.Sections.Any(section => section.Kind == ReportSectionKind.Chart))
{
    <script asp-name="CrestApps.OrchardCore.Reports.Charts" at="Foot"></script>
}
