@using System.Globalization
@using System.Text.Json
@using CrestApps.OrchardCore.Reports.Models
@model ReportSectionViewModel

@{
    var reportSection = Model.Section;
    var sectionWidth = Math.Clamp(reportSection.Width, 1, 12);
    var selection = reportSection.Selection;
    var selectedKeys = selection?.SelectedKeys ?? [];
    var chartData = reportSection.Chart is null
        ? null
        : JsonSerializer.Serialize(new
        {
            type = reportSection.Chart.Type.ToString().ToLowerInvariant(),
            labels = reportSection.Chart.Labels,
            datasets = reportSection.Chart.Datasets.Select(dataset => new
            {
                label = dataset.Label,
                data = dataset.Values,
            }),
            stacked = reportSection.Chart.Stacked,
            showLegend = reportSection.Chart.ShowLegend,
            percentageScale = reportSection.Chart.PercentageScale,
            keys = selection is null ? null : reportSection.Chart.Keys,
            seriesKeys = selection is null ? null : reportSection.Chart.SeriesKeys,
            selectedKeys,
        });
}

@* A column of the title and its content; a chart card fills what the title leaves, so sections side by side line up without spilling into the next row. *@
<section class="report-section col-12 col-xl-@sectionWidth d-flex flex-column@(selectedKeys.Count > 0 ? " has-selection" : null)"
         data-report-visual="@reportSection.Id"
         data-report-selectable="@(selection is null ? null : "true")"
         data-report-targets="@(selection is null ? null : string.Join(' ', selection.TargetIds))"
         data-report-selected="@(selection is null ? null : JsonSerializer.Serialize(selectedKeys))"
         data-report-clear-text="@(selection is null ? null : T["Clear selection"].Value)">
@if (Model.ShowTitle && !string.IsNullOrEmpty(reportSection.Title))
{
    <h2 class="h5">@reportSection.Title</h2>
}
@if (!string.IsNullOrEmpty(reportSection.Description))
{
    <p class="text-muted small">@reportSection.Description</p>
}

@switch (reportSection.Kind)
{
    case ReportSectionKind.Metrics:
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xxl-5 g-3">
            @foreach (var metric in reportSection.Metrics)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm text-bg-theme">
                        <div class="card-body">
                            <div class="text-muted small text-uppercase">@metric.Label</div>
                            <div class="display-6 fw-semibold">@metric.Value</div>
                            @if (!string.IsNullOrEmpty(metric.Hint))
                            {
                                <div class="text-muted small">@metric.Hint</div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        break;

    case ReportSectionKind.Table:
        {
            var alignClasses = reportSection.Columns
                .Select(column => column.Align == ReportColumnAlign.End ? "text-end" : column.Align == ReportColumnAlign.Center ? "text-center" : "text-start")
                .ToList();

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            @for (var i = 0; i < reportSection.Columns.Count; i++)
                            {
                                var headerStyle = reportSection.Columns[i].HeaderStyle?.ToInlineCss();

                                <th class="@alignClasses[i]" style="@headerStyle">@reportSection.Columns[i].Label</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in reportSection.Rows)
                        {
                            var rowClass = row.Kind switch
                            {
                                ReportRowKind.Subtotal => "fw-semibold border-top table-info",
                                ReportRowKind.GrandTotal => "fw-semibold border-top table-primary",
                                _ => null,
                            };
                            var rowKey = selection is null ? null : row.Key;

                            if (rowKey is not null && selectedKeys.Contains(rowKey))
                            {
                                rowClass = "is-selected";
                            }

                            <tr class="@rowClass" data-report-key="@rowKey" tabindex="@(rowKey is null ? null : "0")">
                                @for (var i = 0; i < row.Cells.Count; i++)
                                {
                                    var cell = row.Cells[i];
                                    var cellStyle = row.GetCellStyle(i)?.ToInlineCss();

                                    <td class="@(i < alignClasses.Count ? alignClasses[i] : "text-start")" style="@cellStyle">
                                        @if (ReportValue.TryGetUserName(cell, out var userName))
                                        {
                                            <user-display-name user-name="@userName" display-type="Report" cache-id="report-user-display-name" />
                                        }
                                        else
                                        {
                                            @cell
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        break;

    case ReportSectionKind.Bars:
        <div class="d-flex flex-column gap-2">
            @foreach (var bar in reportSection.Bars)
            {
                var width = (Math.Clamp(bar.Ratio, 0d, 1d) * 100d).ToString("0.###", CultureInfo.InvariantCulture);
                <div>
                    <div class="d-flex justify-content-between small">
                        <span>@bar.Label</span>
                        <span class="fw-semibold">@bar.Value</span>
                    </div>
                    <div class="progress" role="progressbar" style="height: 0.6rem;">
                        <div class="progress-bar" style="width: @width%"></div>
                    </div>
                </div>
            }
        </div>

        break;

    case ReportSectionKind.Chart:
        <div class="card flex-grow-1 border-0 shadow-sm">
            <div class="card-body">
                <div style="position: relative; min-height: 20rem;">
                    <canvas data-report-chart="@chartData" role="img" aria-label="@reportSection.Title"></canvas>
                </div>
            </div>
        </div>

        break;
}
</section>
