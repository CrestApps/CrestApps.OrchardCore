@model ReportViewsIndexViewModel

<zone Name="Title">
    <breadcrumb name="ReportViewsIndex" title="@T["Report Views"]">
        <breadcrumb-item id="ReportDesignsIndex" action="Index" controller="ReportDesigns" area="CrestApps.OrchardCore.Reports">@T["Report Builder"]</breadcrumb-item>
    </breadcrumb>
</zone>

<p class="text-muted">@T["A view is a reusable data set: it joins, filters, and calculates data once, and reports and other views read its result columns as fields."]</p>

<div class="card text-bg-theme mb-3 position-sticky action-bar">
    <div class="card-body text-end">
        <a class="btn btn-primary create" asp-route="ReportViewsCreate">@T["Add View"]</a>
    </div>
</div>

<ul class="list-group">
    @if (Model.Entries.Count == 0)
    {
        <li class="list-group-item list-group-item-info text-center">@T["<strong>Nothing here!</strong> There are no views yet."]</li>
    }

    @foreach (var (view, canEdit) in Model.Entries)
    {
        var scheduled = view.RefreshIntervalMinutes > ReportViewRefreshIntervals.Live;
        var snapshot = scheduled ? Model.Snapshots.GetValueOrDefault(view.ItemId) : null;
        var schedule = view.RefreshIntervalMinutes switch
        {
            ReportViewRefreshIntervals.Minimum => T["Every 15 minutes"],
            ReportViewRefreshIntervals.Hourly => T["Every hour"],
            ReportViewRefreshIntervals.EverySixHours => T["Every 6 hours"],
            ReportViewRefreshIntervals.Daily => T["Every day"],
            _ => T["Every {0} minutes", view.RefreshIntervalMinutes],
        };
        <li class="list-group-item d-flex flex-wrap gap-2 align-items-center">
            <div class="flex-grow-1">
                <div class="fw-semibold">
                    @view.DisplayText
                    @if (scheduled)
                    {
                        <span class="badge text-bg-info ms-1" title="@T["The view's result is stored on this schedule, and reports read the stored result."]">@schedule</span>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(view.Description))
                {
                    <div class="small text-muted">@view.Description</div>
                }
                <div class="small text-muted">
                    @T.Plural(view.Query?.Columns?.Count ?? 0, "1 column", "{0} columns") · @(view.Author ?? "?")
                    @if (scheduled)
                    {
                        if (snapshot?.RefreshedUtc is DateTime refreshedUtc)
                        {
                            <span> · @T["Last refreshed {0}", refreshedUtc.ToString("g", System.Globalization.CultureInfo.CurrentCulture)] UTC</span>
                        }
                        else
                        {
                            <span> · @T["Not refreshed yet"]</span>
                        }

                        if (!string.IsNullOrEmpty(snapshot?.LastError))
                        {
                            <span class="text-danger" title="@snapshot.LastError"> · @T["The last refresh failed"]</span>
                        }
                    }
                </div>
            </div>
            @if (canEdit)
            {
                <div class="d-flex gap-1">
                    <a class="btn btn-sm btn-outline-secondary" asp-route="ReportViewsEdit" asp-route-id="@view.ItemId">@T["Edit"]</a>
                    <form method="post" asp-route="ReportViewsDelete" asp-route-id="@view.ItemId" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-danger" data-url-af="RemoveUrl UnsafeUrl">@T["Delete"]</button>
                    </form>
                </div>
            }
        </li>
    }
</ul>
