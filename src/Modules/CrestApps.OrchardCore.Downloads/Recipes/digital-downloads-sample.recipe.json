{
  "name": "DigitalDownloadsSample",
  "displayName": "Digital downloads sample",
  "description": "Creates a Digital Product type and an Ebooks listing at /ebooks whose buyers download files after paying, with two sample ebooks priced in US dollars and their PDF files, links that work 14 days for 3 downloads, and two coupons: WELCOME10 (10% off, once per customer) and EBOOKS5 ($5 off orders of $15 or more).",
  "author": "CrestApps",
  "website": "https://crestapps.com",
  "version": "1.0.0",
  "issetuprecipe": false,
  "categories": [
    "commerce"
  ],
  "tags": [
    "commerce",
    "products",
    "downloads",
    "digital",
    "sample"
  ],
  "steps": [
    {
      "name": "feature",
      "enable": [
        "OrchardCore.Contents",
        "OrchardCore.Title",
        "OrchardCore.Autoroute",
        "OrchardCore.Html",
        "CrestApps.OrchardCore.Products",
        "CrestApps.OrchardCore.Products.Listing",
        "CrestApps.OrchardCore.Carts",
        "CrestApps.OrchardCore.Orders",
        "CrestApps.OrchardCore.Customers",
        "CrestApps.OrchardCore.Downloads",
        "CrestApps.OrchardCore.Checkout"
      ]
    },
    {
      "name": "ContentDefinition",
      "ContentTypes": [
        {
          "Name": "DigitalProduct",
          "DisplayName": "Digital Product",
          "Settings": {
            "ContentTypeSettings": {
              "Creatable": true,
              "Listable": true,
              "Draftable": true,
              "Versionable": true,
              "Securable": false
            }
          },
          "ContentTypePartDefinitionRecords": [
            {
              "PartName": "TitlePart",
              "Name": "TitlePart",
              "Settings": {
                "ContentTypePartSettings": {
                  "Position": "0"
                }
              }
            },
            {
              "PartName": "AutoroutePart",
              "Name": "AutoroutePart",
              "Settings": {
                "ContentTypePartSettings": {
                  "Position": "1"
                },
                "AutoroutePartSettings": {
                  "AllowCustomPath": true,
                  "Pattern": "downloads-shop/{{ ContentItem | display_text | slugify }}"
                }
              }
            },
            {
              "PartName": "ProductPart",
              "Name": "ProductPart",
              "Settings": {
                "ContentTypePartSettings": {
                  "Position": "2"
                },
                "ProductPartSettings": {
                  "Type": "Digital",
                  "DefaultCurrency": "USD",
                  "SalesMode": "Purchasable",
                  "PriceDisplay": "Show"
                },
                "ProductPageSettings": {
                  "ShowDetails": true
                }
              }
            },
            {
              "PartName": "HtmlBodyPart",
              "Name": "HtmlBodyPart",
              "Settings": {
                "ContentTypePartSettings": {
                  "Position": "3",
                  "DisplayName": "Description"
                }
              }
            },
            {
              "PartName": "DigitalFilesPart",
              "Name": "DigitalFilesPart",
              "Settings": {
                "ContentTypePartSettings": {
                  "Position": "4",
                  "DisplayName": "Digital files"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "name": "content",
      "data": [
        {
          "ContentItemId": "4dgtlprod0trailguide00000a",
          "ContentItemVersionId": "4dgtlprod0trailguide00000b",
          "ContentType": "DigitalProduct",
          "DisplayText": "Trail Field Guide (PDF)",
          "Latest": true,
          "Published": true,
          "ModifiedUtc": "2026-10-18T12:00:00Z",
          "PublishedUtc": "2026-10-18T12:00:00Z",
          "CreatedUtc": "2026-10-18T12:00:00Z",
          "Owner": null,
          "Author": "admin",
          "TitlePart": {
            "Title": "Trail Field Guide (PDF)"
          },
          "AutoroutePart": {
            "Path": "downloads-shop/trail-field-guide-pdf",
            "SetHomepage": false,
            "Disabled": false,
            "RouteContainedItems": false,
            "Absolute": false
          },
          "ProductPart": {
            "Price": 12,
            "Currency": "USD",
            "Sku": "EBK-TRAIL",
            "IsPurchasable": true
          },
          "HtmlBodyPart": {
            "Html": "<p>A 60-page field guide to trail navigation, packing and safety, as a PDF you download right after paying.</p>"
          },
          "DigitalFilesPart": {
            "Files": []
          }
        },
        {
          "ContentItemId": "4dgtlprod0camprecipes0000a",
          "ContentItemVersionId": "4dgtlprod0camprecipes0000b",
          "ContentType": "DigitalProduct",
          "DisplayText": "Camp Kitchen Recipes (eBook)",
          "Latest": true,
          "Published": true,
          "ModifiedUtc": "2026-10-18T12:00:00Z",
          "PublishedUtc": "2026-10-18T12:00:00Z",
          "CreatedUtc": "2026-10-18T12:00:00Z",
          "Owner": null,
          "Author": "admin",
          "TitlePart": {
            "Title": "Camp Kitchen Recipes (eBook)"
          },
          "AutoroutePart": {
            "Path": "downloads-shop/camp-kitchen-recipes-ebook",
            "SetHomepage": false,
            "Disabled": false,
            "RouteContainedItems": false,
            "Absolute": false
          },
          "ProductPart": {
            "Price": 8,
            "Currency": "USD",
            "Sku": "EBK-CAMP",
            "IsPurchasable": true
          },
          "HtmlBodyPart": {
            "Html": "<p>Forty one-pot recipes for the trail and the campsite, as an ebook.</p>"
          },
          "DigitalFilesPart": {
            "Files": []
          }
        },
        {
          "ContentItemId": "4dgtllisting0ebooks000000a",
          "ContentItemVersionId": "4dgtllisting0ebooks000000b",
          "ContentType": "ProductListing",
          "DisplayText": "Ebooks",
          "Latest": true,
          "Published": true,
          "ModifiedUtc": "2026-10-18T12:00:00Z",
          "PublishedUtc": "2026-10-18T12:00:00Z",
          "CreatedUtc": "2026-10-18T12:00:00Z",
          "Owner": null,
          "Author": "admin",
          "TitlePart": {
            "Title": "Ebooks"
          },
          "AutoroutePart": {
            "Path": "ebooks",
            "SetHomepage": false,
            "Disabled": false,
            "RouteContainedItems": false,
            "Absolute": false
          },
          "ProductListingPart": {
            "ContentTypes": [
              "DigitalProduct"
            ],
            "AutomaticFacets": true,
            "Facets": [],
            "AutomaticSorts": true,
            "Sorts": [],
            "DefaultSort": "newest",
            "DefaultView": "Grid",
            "AllowViewSwitching": true,
            "ImageAspectRatio": "Square",
            "PageSizes": [
              12,
              24
            ],
            "DefaultPageSize": 12,
            "EnableKeywordSearch": true
          }
        }
      ]
    },
    {
      "name": "DigitalFiles",
      "Files": [
        {
          "ProductId": "4dgtlprod0trailguide00000a",
          "FileName": "trail-field-guide.pdf",
          "Base64": ""
        },
        {
          "ProductId": "4dgtlprod0camprecipes0000a",
          "FileName": "camp-kitchen-recipes.pdf",
          "Base64": ""
        }
      ]
    },
    {
      "name": "Settings",
      "DownloadSettings": {
        "DownloadLimit": 3,
        "LinkLifetimeDays": 14
      }
    },
    {
      "name": "Coupons",
      "Coupons": [
        {
          "Code": "WELCOME10",
          "Description": "10% off your first order",
          "Kind": "Percentage",
          "Percentage": 10,
          "MaxRedemptionsPerCustomer": 1,
          "IsEnabled": true
        },
        {
          "Code": "EBOOKS5",
          "Description": "$5 off ebooks",
          "Kind": "FixedAmount",
          "Amount": 5,
          "Currency": "USD",
          "MinimumAmount": 15,
          "MaxRedemptions": 500,
          "IsEnabled": true
        }
      ]
    }
  ]
}
