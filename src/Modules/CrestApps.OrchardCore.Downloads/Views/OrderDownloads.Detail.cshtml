@model OrderDownloadsViewModel
@inject OrchardCore.Modules.ILocalClock LocalClock
@functions {
    // Stored times are UTC; people read them in the site's time zone.
    private async Task<DateTime> LocalAsync(DateTime utc)
        => (await LocalClock.ConvertToLocalAsync(DateTime.SpecifyKind(utc, DateTimeKind.Utc))).DateTime;
}

@{
    var working = Model.Downloads.Where(download => download.Problem == DownloadProblem.None && !string.IsNullOrEmpty(download.Url)).ToList();
}

<div class="card mt-4 mb-4">
    <div class="card-header">@T["Your downloads"]</div>
    @if (working.Count == 0)
    {
        <div class="card-body text-muted">@T["Your downloads are no longer available: their links expired, were used up, or the order was refunded. Contact us if you need them again."]</div>
    }
    else
    {
        <ul class="list-group list-group-flush">
            @foreach (var download in working)
            {
                var entitlement = download.Entitlement;
                <li class="list-group-item d-flex justify-content-between align-items-center gap-3">
                    <div>
                        <div class="fw-semibold">@entitlement.FileName</div>
                        <div class="small text-muted">
                            @if (entitlement.Remaining.HasValue)
                            {
                                @T.Plural(entitlement.Remaining.Value, "1 download left", "{0} downloads left")
                            }
                            @if (entitlement.ExpiresUtc.HasValue)
                            {
                                <span> · @T["until {0:d}", await LocalAsync(entitlement.ExpiresUtc.Value)]</span>
                            }
                        </div>
                    </div>
                    <a class="btn btn-sm btn-primary" href="@download.Url">@T["Download"]</a>
                </li>
            }
        </ul>
    }
</div>
