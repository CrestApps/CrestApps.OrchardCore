@using OrchardCore.DisplayManagement.Html
@model IShape

@{
    var download = (DownloadPageViewModel)Model;
    var entitlement = download.Entitlement;
}

<zone Name="Title">
    <breadcrumb name="DigitalDownload" title="@(download.Problem == DownloadProblem.None ? new HtmlContentString(entitlement.FileName ?? string.Empty) : (Microsoft.AspNetCore.Html.IHtmlContent)T["Download"])" />
</zone>

@await DisplayAsync(Model)
