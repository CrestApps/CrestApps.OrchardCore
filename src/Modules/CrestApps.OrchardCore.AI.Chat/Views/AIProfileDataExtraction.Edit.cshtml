@using CrestApps.Core.AI.Models
@using CrestApps.OrchardCore.AI.Chat.ViewModels
@using CrestApps.OrchardCore.AI.Core.Conversations

@model AIProfileDataExtractionViewModel

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" asp-for="EnableDataExtraction" />
            <label class="form-check-label" asp-for="EnableDataExtraction">@T["Enable data extraction"]</label>
            <span class="hint dashed">@T["When enabled, the system will extract structured data from chat messages."]</span>
        </div>
    </div>
</div>

@{
    var dataExtractionSettingsId = Html.IdFor(m => m.EnableDataExtraction) + "_settings";
    var typeNames = new Dictionary<DataExtractionFieldType, string>
    {
        [DataExtractionFieldType.Text] = T["Text"].Value,
        [DataExtractionFieldType.Number] = T["Number"].Value,
        [DataExtractionFieldType.Boolean] = T["Yes or no"].Value,
        [DataExtractionFieldType.Date] = T["Date"].Value,
        [DataExtractionFieldType.Enum] = T["Choice"].Value,
        [DataExtractionFieldType.List] = T["List"].Value,
    };
}

<div id="@dataExtractionSettingsId" class="@(Model.EnableDataExtraction ? "" : "d-none")">
    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <div class="alert alert-info mb-0">
                <i class="fa-solid fa-circle-info me-1"></i>
                @T["Data extraction runs after each qualifying message exchange. Additionally, when an AI session is closed (either due to inactivity or natural conversation ending), a final extraction is automatically performed to capture any remaining data."]
            </div>
        </div>
    </div>

    <div class="ocat-wrapper">
        <label class="ocat-label" asp-for="ExtractionCheckInterval">@T["Extraction check interval"]</label>
        <div class="ocat-end">
            <input type="number" class="form-control" asp-for="ExtractionCheckInterval" min="1" />
            <span class="hint">@T["Run extraction every N user messages. Default is 1 (every message)."]</span>
        </div>
    </div>

    <div class="ocat-wrapper">
        <div class="ocat-label ocat-label-required">@T["Extraction entries"]</div>
        <div class="ocat-end">
            <span class="hint dashed d-block mb-2">@T["Define the fields to extract from the conversation."]</span>

            <div id="extractionEntriesContainer">
                @for (var i = 0; i < Model.Entries.Count; i++)
                {
                    <div class="card mb-2 extraction-entry-card">
                        <div class="card-header d-flex justify-content-between align-items-center py-2">
                            <a class="btn btn-sm btn-link text-start text-decoration-none flex-grow-1 px-0 entry-collapse-toggle" data-bs-toggle="collapse" href="#entryCollapse_@i" role="button" aria-expanded="true">
                                <i class="fa-solid fa-chevron-down me-1"></i>
                                <span class="entry-name-display fw-semibold">@(string.IsNullOrWhiteSpace(Model.Entries[i].Name) ? T["New Entry"] : Model.Entries[i].Name)</span>
                            </a>
                            <button type="button" class="btn btn-sm btn-danger remove-entry-btn" title="@T["Remove"]">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </div>
                        <div id="entryCollapse_@i" class="collapse show">
                            <div class="card-body">
                                <div class="mb-3">
                                    <label class="form-label ocat-label-required">@T["Name"]</label>
                                    <input type="text" class="form-control entry-name-input" name="@Html.NameFor(m => m.Entries[i].Name)" value="@Model.Entries[i].Name" pattern="^[a-zA-Z0-9_]+$" required placeholder="@T["e.g., customer_name"]" />
                                    <span class="hint">@T["A unique identifier for this field. Only alphanumeric characters and underscores are allowed."]</span>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">@T["Description"]</label>
                                    <textarea class="form-control" name="@Html.NameFor(m => m.Entries[i].Description)" rows="3" placeholder="@T["What to extract"]">@Model.Entries[i].Description</textarea>
                                    <span class="hint">@T["Describes what data to extract from the conversation. The AI model uses this to understand what to look for."]</span>
                                </div>
                                <div class="row g-2 mb-3">
                                    <div class="col-md-4">
                                        <label class="form-label">@T["Type"]</label>
                                        <select class="form-select entry-type-select" name="@Html.NameFor(m => m.Entries[i].FieldType)">
                                            @foreach (var type in Enum.GetValues<DataExtractionFieldType>())
                                            {
                                                <option value="@type" selected="@(Model.Entries[i].FieldType == type)">@typeNames[type]</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-8 entry-allowed-values @(Model.Entries[i].FieldType is DataExtractionFieldType.Enum or DataExtractionFieldType.List ? "" : "d-none")">
                                        <label class="form-label">@T["Allowed values"]</label>
                                        <textarea class="form-control" name="@Html.NameFor(m => m.Entries[i].AllowedValues)" rows="2" placeholder="@T["One per line"]">@Model.Entries[i].AllowedValues</textarea>
                                        <span class="hint">@T["A choice takes one of these; a list takes any of them, or anything when empty."]</span>
                                    </div>
                                </div>
                                <div class="row g-2 mb-3">
                                    <div class="col-md-8">
                                        <label class="form-label">@T["Write to contact field"]</label>
                                        <input type="text" class="form-control" name="@Html.NameFor(m => m.Entries[i].ContactField)" value="@Model.Entries[i].ContactField" placeholder="@T["e.g., Contact.Company"]" />
                                        <span class="hint">@T["When the conversation closes, the value is written to this field of its contact, as PartName.FieldName. Text, numeric, yes/no and date fields are supported."]</span>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">@T["How"]</label>
                                        <select class="form-select" name="@Html.NameFor(m => m.Entries[i].ContactFieldMode)">
                                            <option value="@AIContactFieldMappingMode.Overwrite" selected="@(Model.Entries[i].ContactFieldMode == AIContactFieldMappingMode.Overwrite)">@T["Replace what it holds"]</option>
                                            <option value="@AIContactFieldMappingMode.FillIfEmpty" selected="@(Model.Entries[i].ContactFieldMode == AIContactFieldMappingMode.FillIfEmpty)">@T["Fill only when empty"]</option>
                                            <option value="@AIContactFieldMappingMode.Append" selected="@(Model.Entries[i].ContactFieldMode == AIContactFieldMappingMode.Append)">@T["Add to a text field"]</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-check mb-2">
                                    <input type="checkbox" class="form-check-input" name="@Html.NameFor(m => m.Entries[i].AllowMultipleValues)" value="true" @(Model.Entries[i].AllowMultipleValues ? "checked" : "") />
                                    <label class="form-check-label">@T["Allow Multiple Values"]</label>
                                    <span class="hint dashed">@T["When enabled, the field can accumulate multiple extracted values across messages (e.g., a list of mentioned product names)."]</span>
                                </div>
                                <div class="form-check mb-2">
                                    <input type="checkbox" class="form-check-input" name="@Html.NameFor(m => m.Entries[i].IsUpdatable)" value="true" @(Model.Entries[i].IsUpdatable ? "checked" : "") />
                                    <label class="form-check-label">@T["Updatable"]</label>
                                    <span class="hint dashed">@T["When enabled, the extracted value can be replaced if the user provides updated information in a later message."]</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <button type="button" class="btn btn-sm btn-success" id="addExtractionEntry"><i class="fa-solid fa-plus"></i> @T["Add Entry"]</button>
        </div>
    </div>
</div>

<script at="Foot">
    document.addEventListener('DOMContentLoaded', function () {
        var toggleCheckbox = document.getElementById('@Html.IdFor(m => m.EnableDataExtraction)');
        var target = document.getElementById('@dataExtractionSettingsId');
        if (toggleCheckbox && target) {
            toggleCheckbox.addEventListener('change', function () {
                target.classList.toggle('d-none', !this.checked);
            });
        }

        var container = document.getElementById('extractionEntriesContainer');
        var typeOptions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.Concat(typeNames.Select(pair => $"<option value=\"{pair.Key}\">{System.Net.WebUtility.HtmlEncode(pair.Value)}</option>"))));

        // A choice or a list shows its allowed values.
        document.addEventListener('change', function (e) {
            if (e.target.classList.contains('entry-type-select')) {
                var allowed = e.target.closest('.card-body').querySelector('.entry-allowed-values');
                if (allowed) {
                    allowed.classList.toggle('d-none', e.target.value !== 'Enum' && e.target.value !== 'List');
                }
            }
        });
        var addButton = document.getElementById('addExtractionEntry');

        if (addButton && container) {
            addButton.addEventListener('click', function () {
                var index = container.querySelectorAll('.extraction-entry-card').length;
                var prefix = '@Html.NameFor(m => m.Entries)';
                var collapseId = 'entryCollapse_' + index;
                var card = document.createElement('div');
                card.className = 'card mb-2 extraction-entry-card';
                card.innerHTML =
                    '<div class="card-header d-flex justify-content-between align-items-center py-2">' +
                    '<a class="btn btn-sm btn-link text-start text-decoration-none flex-grow-1 px-0 entry-collapse-toggle" data-bs-toggle="collapse" href="#' + collapseId + '" role="button" aria-expanded="true">' +
                    '<i class="fa-solid fa-chevron-down me-1"></i>' +
                    '<span class="entry-name-display fw-semibold">New Entry</span>' +
                    '</a>' +
                    '<button type="button" class="btn btn-sm btn-danger remove-entry-btn" title="Remove"><i class="fa-solid fa-trash"></i></button>' +
                    '</div>' +
                    '<div id="' + collapseId + '" class="collapse show">' +
                    '<div class="card-body">' +
                    '<div class="mb-3"><label class="form-label ocat-label-required">Name</label><input type="text" class="form-control entry-name-input" name="' + prefix + '[' + index + '].Name" pattern="^[a-zA-Z0-9_]+$" required placeholder="e.g., customer_name" /><span class="hint">A unique identifier for this field. Only alphanumeric characters and underscores are allowed.</span></div>' +
                    '<div class="mb-3"><label class="form-label">Description</label><textarea class="form-control" name="' + prefix + '[' + index + '].Description" rows="3" placeholder="What to extract"></textarea><span class="hint">Describes what data to extract from the conversation. The AI model uses this to understand what to look for.</span></div>' +
                    '<div class="row g-2 mb-3"><div class="col-md-4"><label class="form-label">Type</label><select class="form-select entry-type-select" name="' + prefix + '[' + index + '].FieldType">' + typeOptions + '</select></div>' +
                    '<div class="col-md-8 entry-allowed-values d-none"><label class="form-label">Allowed values</label><textarea class="form-control" name="' + prefix + '[' + index + '].AllowedValues" rows="2" placeholder="One per line"></textarea></div></div>' +
                    '<div class="row g-2 mb-3"><div class="col-md-8"><label class="form-label">Write to contact field</label><input type="text" class="form-control" name="' + prefix + '[' + index + '].ContactField" placeholder="e.g., Contact.Company" /></div>' +
                    '<div class="col-md-4"><label class="form-label">How</label><select class="form-select" name="' + prefix + '[' + index + '].ContactFieldMode"><option value="Overwrite">Replace what it holds</option><option value="FillIfEmpty">Fill only when empty</option><option value="Append">Add to a text field</option></select></div></div>' +
                    '<div class="form-check mb-2"><input type="checkbox" class="form-check-input" name="' + prefix + '[' + index + '].AllowMultipleValues" value="true" /><label class="form-check-label">Allow Multiple Values</label><span class="hint dashed">When enabled, the field can accumulate multiple extracted values across messages.</span></div>' +
                    '<div class="form-check mb-2"><input type="checkbox" class="form-check-input" name="' + prefix + '[' + index + '].IsUpdatable" value="true" /><label class="form-check-label">Updatable</label><span class="hint dashed">When enabled, the extracted value can be replaced if the user provides updated information.</span></div>' +
                    '</div>' +
                    '</div>';
                container.appendChild(card);
            });
        }

        document.addEventListener('click', function (e) {
            if (e.target.closest('.remove-entry-btn')) {
                var card = e.target.closest('.extraction-entry-card');
                if (card) card.remove();
            }
        });

        // Update card header name display when the Name input changes.
        document.addEventListener('input', function (e) {
            if (e.target.classList.contains('entry-name-input')) {
                var card = e.target.closest('.extraction-entry-card');
                if (card) {
                    var display = card.querySelector('.entry-name-display');
                    if (display) {
                        display.textContent = e.target.value || 'New Entry';
                    }
                }
            }
        });
    });
</script>
