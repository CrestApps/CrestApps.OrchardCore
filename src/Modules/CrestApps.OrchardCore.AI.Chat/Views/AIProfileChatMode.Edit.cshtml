@using System.Text.Json
@using CrestApps.OrchardCore.AI.Chat.ViewModels
@using CrestApps.Core.AI.Models

@model AIProfileChatModeViewModel

@{
    var realtimeVoicesUrl = Url.Action("Voices", "Realtime", new { area = "CrestApps.OrchardCore.AI.Chat" });
}

@* The chat mode decides how the chat is used. The conversation deployment and voice below it are shown whatever
   it is: the chat uses them in conversation mode, and phone calls answered or placed with this profile always do,
   so hiding them on a text-only profile hid the model and voice of its calls. The chat deployment is the text
   model, and a profile that speaks still types. *@
<div class="ocat-wrapper profile-type profile-type-chat" id="chatModeSelectorGroup">
    <label asp-for="ChatMode" class="ocat-label">@T["Chat mode"]</label>
    <div class="ocat-end">
        <select asp-for="ChatMode" asp-items="Model.AvailableModes" class="form-select" id="chatModeSelector">
        </select>
        <span class="hint">@T["Text input only, microphone dictation, or a two-way voice conversation the user can switch on and off while typing."]</span>
    </div>
</div>

<div class="ocat-wrapper profile-type profile-type-chat" id="chatModeConversationDeploymentGroup">
    <label asp-for="ConversationDeploymentName" class="ocat-label">@T["Conversation deployment"]</label>
    <div class="ocat-end">
        <select asp-for="ConversationDeploymentName" asp-items="Model.AvailableConversationDeployments" class="form-select" id="chatModeConversationDeploymentSelect">
            <option value="">@T["Use the site's default realtime deployment"]</option>
        </select>
        <span class="hint">@T["The model that carries this profile's spoken conversations: in the chat when the chat mode is Conversation, and on every phone call the profile answers or places. Leave this empty to use the site's default realtime deployment. With no realtime deployment, the chat falls back to speech-to-text plus text-to-speech, and a call takes turns."]</span>
    </div>
</div>

<div class="ocat-wrapper profile-type profile-type-chat" id="chatModeTranscriptionWarning" style="display: none;">
    <div class="ocat-end-offset">
        <div class="alert alert-warning mb-0">
            @T["The user's words will not be transcribed: this deployment's provider has no speech-to-text deployment. The conversation still works, but stored transcripts, summaries and AI call reviews will see only the assistant's side. Add a speech-to-text deployment on the same provider, and choose it as the default speech-to-text deployment in the AI settings if there is more than one."]
        </div>
    </div>
</div>

<div class="ocat-wrapper profile-type profile-type-chat" id="chatModeVoiceSelector">
    <label asp-for="VoiceName" class="ocat-label">@T["Voice"]</label>
    <div class="ocat-end">
        <select asp-for="VoiceName" asp-items="Model.AvailableVoices" class="form-select" id="chatModeVoiceSelect"
                data-voice-name="@Model.VoiceName">
            <option value="">@T["Default voice"]</option>
        </select>
        <span class="hint">@T["The voice this profile speaks with, in the chat's conversation mode and on phone calls. Leave this empty to use the persona's voice, or the site's default voice when the profile has no persona or the persona has no voice."]</span>
    </div>
</div>

<div class="ocat-wrapper profile-type profile-type-chat" id="chatModeTtsPlaybackGroup">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" asp-for="EnableTextToSpeechPlayback" />
            <label class="form-check-label" asp-for="EnableTextToSpeechPlayback">@T["Enable text-to-speech playback"]</label>
            <span class="hint dashed">@T["When enabled, a play button is shown on each assistant message, allowing users to listen to AI responses via the configured text-to-speech deployment."]</span>
        </div>
    </div>
</div>

<script at="Foot">
    (function () {
        function init() {
            var chatModeSelect = document.getElementById('chatModeSelector');
            var conversationDeploymentGroup = document.getElementById('chatModeConversationDeploymentGroup');
            var transcriptionWarning = document.getElementById('chatModeTranscriptionWarning');
            var conversationDeploymentSelect = document.getElementById('chatModeConversationDeploymentSelect');
            var voiceSelector = document.getElementById('chatModeVoiceSelector');
            var voiceSelect = document.getElementById('chatModeVoiceSelect');
            var ttsPlaybackGroup = document.getElementById('chatModeTtsPlaybackGroup');

            var realtimeDeploymentNames = @Html.Raw(JsonSerializer.Serialize(Model.RealtimeDeploymentNames ?? []));
            var untranscribedDeploymentNames = @Html.Raw(JsonSerializer.Serialize(Model.UntranscribedRealtimeDeploymentNames ?? []));
            var defaultRealtimeDeploymentName = @Html.Raw(JsonSerializer.Serialize(Model.DefaultRealtimeDeploymentName ?? string.Empty));

            if (!chatModeSelect || !voiceSelector) {
                return;
            }

            var voicesUrl = '@realtimeVoicesUrl';

            // The voice to keep selected as the lists change: the saved one, then whichever the user picks.
            var selectedVoice = voiceSelect ? (voiceSelect.getAttribute('data-voice-name') || '') : '';

            // Only the newest voice list is shown. Switching deployments quickly sends a request for each, and an
            // older answer arriving last would offer one deployment's voices under another.
            var voicesRequest = 0;

            // The text-to-speech voices rendered on the server, restored when the conversation falls back to
            // the speech-to-text plus text-to-speech cascade.
            var ttsOptionsHtml = voiceSelect ? voiceSelect.innerHTML : '';

            // Mirrors the realtime slot's chain on the server: the profile's own choice, then the site
            // default, then the first realtime-capable deployment. Empty means the conversation falls back to
            // the speech-to-text plus text-to-speech cascade, which uses a different set of voices.
            function resolvedConversationDeploymentName() {
                return (conversationDeploymentSelect && conversationDeploymentSelect.value)
                    || defaultRealtimeDeploymentName
                    || (realtimeDeploymentNames.length ? realtimeDeploymentNames[0] : '');
            }

            // The persona picker sits on another tab of the same editor. When a persona with a voice is chosen,
            // leaving the voice empty means "speak with the persona's voice", so the empty option says so.
            var personaSelect = document.querySelector('[data-ai-persona-select]');
            var defaultVoiceText = @Html.Raw(JsonSerializer.Serialize(T["Default voice"].Value));
            var personaVoiceText = @Html.Raw(JsonSerializer.Serialize(T["Use persona voice ({0})"].Value));

            function refreshDefaultVoiceLabel() {
                if (!voiceSelect) {
                    return;
                }

                var emptyOption = voiceSelect.querySelector('option[value=""]');

                if (!emptyOption) {
                    return;
                }

                var personaOption = personaSelect && personaSelect.selectedIndex >= 0
                    ? personaSelect.options[personaSelect.selectedIndex]
                    : null;
                var personaVoice = personaOption ? (personaOption.getAttribute('data-voice-name') || '') : '';

                emptyOption.textContent = personaVoice
                    ? personaVoiceText.replace('{0}', personaVoice)
                    : defaultVoiceText;
            }

            if (personaSelect) {
                personaSelect.addEventListener('change', refreshDefaultVoiceLabel);
            }

            function setVoiceOptions(html) {
                if (voiceSelect) {
                    voiceSelect.innerHTML = html;
                    voiceSelect.value = selectedVoice;

                    // A voice this list does not have would leave nothing selected; say plainly that the default
                    // voice is used instead.
                    if (voiceSelect.selectedIndex < 0) {
                        voiceSelect.value = '';
                    }

                    refreshDefaultVoiceLabel();
                }
            }

            async function loadRealtimeVoices(deploymentName) {
                if (!voiceSelect || !voicesUrl) {
                    return;
                }

                var html = '<option value="">@T["Default voice"]</option>';
                var request = ++voicesRequest;

                try {
                    var response = await fetch(voicesUrl + '?deploymentName=' + encodeURIComponent(deploymentName), { credentials: 'same-origin' });
                    var result = await response.json();

                    if (result && Array.isArray(result.voices)) {
                        var grouped = {};
                        result.voices.forEach(function (voice) {
                            var group = voice.gender || 'Voices';
                            (grouped[group] = grouped[group] || []).push(voice);
                        });

                        Object.keys(grouped).sort().forEach(function (group) {
                            html += '<optgroup label="' + group + '">';
                            grouped[group].forEach(function (voice) {
                                html += '<option value="' + voice.id + '">' + voice.name + '</option>';
                            });
                            html += '</optgroup>';
                        });
                    }
                } catch (e) {
                    /* ignore voice load failures */
                }

                if (request === voicesRequest) {
                    setVoiceOptions(html);
                }
            }

            function apply() {
                // The conversation deployment and the voice stay visible whatever the chat mode, because phone
                // calls use them whatever it is. One voice question, whichever path answers it: a realtime
                // deployment's own voices, or the text-to-speech voices when the conversation runs as the cascade.

                // Playback reads an assistant message aloud on demand, which is a text-chat affordance, so it
                // applies whatever the conversation is carried by.
                if (ttsPlaybackGroup) {
                    ttsPlaybackGroup.style.display = '';
                }

                var resolved = resolvedConversationDeploymentName();

                // The conversation would run on a model whose provider cannot write the user down, which a call's
                // transcript and review need as much as the chat does.
                if (transcriptionWarning) {
                    transcriptionWarning.style.display = resolved && untranscribedDeploymentNames.indexOf(resolved) >= 0 ? '' : 'none';
                }

                if (resolved) {
                    loadRealtimeVoices(resolved);
                } else {
                    // Any voice list still on its way is for a deployment no longer chosen.
                    voicesRequest++;
                    setVoiceOptions(ttsOptionsHtml);
                }
            }

            if (conversationDeploymentSelect) {
                conversationDeploymentSelect.addEventListener('change', apply);
            }

            if (voiceSelect) {
                voiceSelect.addEventListener('change', function () {
                    selectedVoice = voiceSelect.value;
                });
            }

            apply();
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }
    })();
</script>
