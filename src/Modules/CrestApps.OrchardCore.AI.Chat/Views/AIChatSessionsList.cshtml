@using CrestApps.OrchardCore.AI.Chat.ViewModels

@model ListChatSessionsViewModel

<div class="card text-bg-theme mb-3 position-sticky action-bar">
    <div class="card-body">
        <div class="row gx-2">
            <div class="col">
                @* The options editor: the search form. *@
                @await DisplayAsync(Model.Header)
            </div>
            <div class="col-auto">
                <a class="btn btn-secondary" asp-action="Chat" asp-controller="Admin" asp-route-profileId="@Model.ProfileId">
                    <i class="fa-solid fa-plus"></i> @T["New Chat"]
                </a>

                <a asp-action="DeleteAll"
                   asp-controller="Admin"
                   asp-route-profileId="@Model.ProfileId"
                   class="btn btn-danger"
                   data-url-af="RemoveUrl UnsafeUrl"
                   data-title="@T["Delete"]"
                   data-message="@T["Are you sure you want to delete all chat history?"]"
                   data-ok-text="@T["Yes"]"
                   data-cancel-text="@T["Cancel"]">
                    <i class="fa-solid fa-trash"></i> @T["Delete Chat History"]
                </a>
            </div>
        </div>
    </div>
</div>

@* The sessions, the toolbar and the pager are rendered by the AdminList shape, in the layout (List or Grid) the site or the user picked. *@
<admin-list name="AIChatSessions" context="Model.List"
            show-select-all="false"
            empty-message="@T["No chat history found."]">
    <admin-list-list item-css-class="list-group-item" />
    <admin-list-grid>
        <admin-list-column name="Name" position="20" title="@T["Title"]" />
        <admin-list-column name="Status" position="30" title="@T["Status"]" width="auto" />
        <admin-list-column name="LastActivity" position="40" title="@T["Last activity"]" width="auto" />
        <admin-list-column type="Actions" title="@T["Actions"]" />
    </admin-list-grid>
</admin-list>
