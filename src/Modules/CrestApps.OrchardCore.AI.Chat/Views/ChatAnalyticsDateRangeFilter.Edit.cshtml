@model CrestApps.OrchardCore.AI.Chat.ViewModels.ChatAnalyticsFilterViewModel

@* The shared date range selector of the reports: relative ranges (last 7 days, this month, ...) or custom dates. *@
@await Component.InvokeAsync("DateRangePicker", new
{
    fromName = Html.NameFor(m => m.StartDate),
    toName = Html.NameFor(m => m.EndDate),
    fromId = Html.IdFor(m => m.StartDate),
    toId = Html.IdFor(m => m.EndDate),
    from = Model.StartDate,
    to = Model.EndDate,
    selectedRangeName = Html.NameFor(m => m.Range),
    selectedRange = Model.Range,
    label = T["Date range"].Value,
})
