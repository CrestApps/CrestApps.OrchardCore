@using System.Text.Json
@using CrestApps.OrchardCore.AI.Chat.ViewModels
@using OrchardCore
@using OrchardCore.DisplayManagement.Html

@model ChatSessionViewModel

@inject IAIProfileManager ProfileManager

@{
    var profile = await ProfileManager.FindByIdAsync(Model.ProfileId);
}

<zone Name="Title">
    <breadcrumb name="AIChat" title="@(new HtmlContentString(profile?.DisplayText ?? profile?.Name ?? string.Empty))" heading="">
        <breadcrumb-item id="AIProfiles" action="Index" controller="Profiles" area="CrestApps.OrchardCore.AI" permission="@AIPermissions.ManageAIProfiles.Name">@T["AI Profiles"]</breadcrumb-item>
    </breadcrumb>
</zone>

<div class="d-flex flex-row flex-grow-1 mb-3" style="min-height: 0;">

    <div class="d-flex flex-column flex-grow-1 overflow-hidden">
        @await DisplayAsync(Model.Content)
    </div>

    @if (Model.History is not null && Model.History.Count > 0)
    {
        <div class="d-none d-md-block flex-shrink-0 bg-theme p-2 border rounded" style="width: 20rem; overflow-y:auto">
            <div class="list-group">
                @foreach (var record in Model.History)
                {
                    @await DisplayAsync(record)
                }
            </div>
        </div>
    }

</div>

<style at="Head">
    /* The chat fills the rest of the screen below the breadcrumb, whether or not the trail is shown. */
    .ta-content {
        display: flex !important;
        flex-direction: column;
        height: 100% !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
        padding-bottom: 0 !important;
    }
</style>
