@using CrestApps.Core.AI.Ingestion
@using System.Text.Json
@using CrestApps.Core
@using CrestApps.Core.AI
@using CrestApps.Core.AI.Chat.Realtime
@using CrestApps.Core.AI.Deployments
@using CrestApps.Core.AI.Documents.Models
@using CrestApps.Core.AI.Models
@using CrestApps.Core.AI.Profiles
@using CrestApps.OrchardCore.AI.Chat.Hubs
@using CrestApps.OrchardCore.AI.Chat.ViewModels
@using CrestApps.OrchardCore.AI.Core
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Options
@using OrchardCore.DisplayManagement
@using OrchardCore.DisplayManagement.ModelBinding
@using OrchardCore.Entities
@using OrchardCore.Environment.Shell
@using OrchardCore.Environment.Shell.Scope

@model ChatSessionCapsuleViewModel

@inject IUpdateModelAccessor UpdateModelAccessor
@inject IDisplayManager<AIChatSessionPrompt> DisplayManager
@inject IAIProfileStore ProfilesCatalog
@inject IAIChatSessionPromptStore PromptStore
@inject IAIDeploymentManager AIDeploymentManager

@{
    var baseId = Html.IdForModel();
    var chatAppHtmlId = $"{baseId}_ChatApp";
    var buttonHtmlId = $"{baseId}_SendButton";
    var userPromptHtmlId = $"{baseId}_UserPrompt";
    var placeholderHtmlId = $"{baseId}_SessionPlaceHolder";
    var chatContainerHtmlId = $"{baseId}_ChatContainer";
    var documentBarHtmlId = $"{baseId}_DocumentBar";
    var promptGeneratedProfiles = await ProfilesCatalog.GetByTypeAsync(AIProfileType.TemplatePrompt);
    var shellFeaturesManager = ShellScope.Services.GetRequiredService<IShellFeaturesManager>();
    var enabledFeatures = await shellFeaturesManager.GetEnabledFeaturesAsync();
    var sessionDocumentsFeatureEnabled = enabledFeatures.Any(f => f.Id == AIConstants.Feature.ChatSessionDocuments);
    var sessionDocumentMetadata = Model.Profile?.GetOrCreate<AIProfileSessionDocumentsMetadata>();
    var allowSessionDocuments = sessionDocumentMetadata?.AllowSessionDocuments == true;

    var visionDeployment = await AIDeploymentManager.ResolveSlotAsync(AIDeploymentSlotNames.Vision);
    var visionEnabled = visionDeployment != null;
    var allowSessionImageUploads = sessionDocumentMetadata?.AllowSessionImageUploads == true && visionEnabled;
    var sessionDocumentsEnabled = sessionDocumentsFeatureEnabled && (allowSessionDocuments || allowSessionImageUploads);

    var allowedExtensions = string.Empty;
    var supportedExtensionsText = string.Empty;

    if (sessionDocumentsEnabled)
    {
        var chatDocOptions = ShellScope.Services.GetRequiredService<IOptions<ChatDocumentsOptions>>();

        allowedExtensions = chatDocOptions.Value.GetAllowedFileExtensionsAcceptValue(allowSessionImageUploads, allowSessionDocuments);
        supportedExtensionsText = chatDocOptions.Value.GetAllowedFileExtensionsDisplayValue(allowSessionImageUploads, allowSessionDocuments);
    }

    var metricsEnabled = Model.Profile != null
        && enabledFeatures.Any(f => f.Id == AIConstants.Feature.ChatAnalytics)
        && Model.Profile.GetOrCreate<AnalyticsMetadata>().EnableSessionMetrics;

    var profileMetadata = Model.Profile?.GetOrCreate<AIProfileMetadata>();

    var addInitialPrompt = !string.IsNullOrWhiteSpace(profileMetadata?.InitialPrompt);

    ChatModeProfileSettings chatModeSettings = null;

    var chatMode = Model.Profile != null && Model.Profile.TryGetSettings<ChatModeProfileSettings>(out chatModeSettings)

        ? chatModeSettings.ChatMode

        : ChatMode.TextInput;

    var speechToTextDeployment = await AIDeploymentManager.ResolveSlotAsync(AIDeploymentSlotNames.SpeechToText);
    var textToSpeechDeployment = await AIDeploymentManager.ResolveSlotAsync(AIDeploymentSlotNames.TextToSpeech);

    // Conversation mode decides how the conversation is carried, and the conversation deployment names the
    // model that carries it. One resolution shared with the hub, so the toggle the user sees and the session
    // the hub will start cannot disagree.
    var conversation = await AIDeploymentManager.ResolveConversationModeAsync(
        chatMode,
        chatModeSettings?.ConversationDeploymentName,
        Model.Profile?.ChatDeploymentName,
        speechToTextDeployment != null,
        textToSpeechDeployment != null);

    var realtimeEnabled = conversation.RealtimeEnabled;
    var effectiveChatMode = conversation.ChatMode;

    // A realtime session captures the microphone itself, so the dictation button would be a second microphone
    // doing something different. Suppress it while realtime carries the conversation.
    var speechToTextEnabled = !realtimeEnabled
        && (effectiveChatMode == ChatMode.AudioInput || effectiveChatMode == ChatMode.Conversation)
        && speechToTextDeployment != null;
    var textToSpeechEnabled = (!realtimeEnabled && effectiveChatMode == ChatMode.Conversation || chatModeSettings?.EnableTextToSpeechPlayback == true)
        && textToSpeechDeployment != null;

    var ttsVoiceName = chatModeSettings?.VoiceName;

    // Whether the server can offer WebRTC is a capability of the host, not of this page's current mode. The
    // client turns realtime on by itself when a realtime-capable deployment is picked after the page loaded, and
    // gating this on realtimeEnabled left those sessions permanently on the WebSocket transport.
    var realtimeWebRtcEnabled = RealtimeTransportSettings.IsWebRtcEnabled(Context.RequestServices);
    var realtimeVoiceName = chatModeSettings?.VoiceName;

    // The conversation button doubles as the realtime "Start speaking" toggle. Conversation mode alone
    // decides whether it is rendered now: a realtime deployment no longer turns the surface voice-only.
    var conversationModeEnabled = effectiveChatMode == ChatMode.Conversation;

    var micBtnHtmlId = $"{baseId}_MicBtn";

    var conversationBtnHtmlId = $"{baseId}_ConversationBtn";
    var realtimeHintHtmlId = $"{baseId}_RealtimeHint";

    var orchestratorAvailability = new OrchestratorAvailability();

    if (!string.IsNullOrWhiteSpace(Model.Profile?.OrchestratorName))
    {
        var availabilityProvider = ViewContext.HttpContext.RequestServices.GetServices<IOrchestratorAvailabilityProvider>()
        .FirstOrDefault(provider => string.Equals(provider.OrchestratorName, Model.Profile.OrchestratorName, StringComparison.OrdinalIgnoreCase));

        if (availabilityProvider is not null)
        {
            orchestratorAvailability = await availabilityProvider.GetAvailabilityAsync();
        }
    }
}

<div class="container-fluid d-flex flex-column h-100">
    <div class="flex-grow-1 overflow-y-auto p-3 mb-3 rounded-2 border bg-theme" id="@chatContainerHtmlId">
        <div class="w-100 ai-chat-messages">
            @{
                var sessionPrompts = !string.IsNullOrEmpty(Model.Session?.SessionId)
                    ? await PromptStore.GetPromptsAsync(Model.Session.SessionId)
                    : Array.Empty<AIChatSessionPrompt>();
            }

            <div id="@placeholderHtmlId" class="text-center p-3 @((sessionPrompts.Count > 0 || addInitialPrompt) ? "d-none" : string.Empty)">
                <h1 class="mb-3">
                    @(addInitialPrompt || string.IsNullOrEmpty(Model.Profile?.WelcomeMessage) ? T["What do you want to know?"] : Model.Profile?.WelcomeMessage)
                </h1>
            </div>

            <div id="@chatAppHtmlId"></div>
        </div>
    </div>

    <div class="flex-shrink-0">
        @if (!orchestratorAvailability.IsAvailable)
        {
            <div class="alert alert-warning mb-3">
                <i class="fas fa-exclamation-triangle"></i>
                @orchestratorAvailability.Message
            </div>
        }

        <div class="ai-chat-prompt-container bg-body text-body rounded border w-100">

            @if (sessionDocumentsEnabled)
            {
                <div id="@documentBarHtmlId" class="d-none"></div>
            }

            @* Typing stays available whatever the voice toggle is doing: a typed message ends the voice
               session and is sent as an ordinary text turn into the same thread. The client hides it only
               while a session is actually live, and gives it straight back when the session ends. *@
            <textarea class="form-control bg-transparent border-0 chat-user-prompt-input px-4" id="@userPromptHtmlId" data-session-id="@(Model.IsNew ? string.Empty : Model.Session.SessionId)" data-profile-id="@(Model.Profile?.ItemId ?? Model.Session.ProfileId)" placeholder="@T["Message AI Chat"] ..." aria-label="@T["Message AI Chat"]" aria-describedby="@buttonHtmlId"></textarea>

            @* Single flex row so the "End Conversation" button (flex-grow-1) can take the space the message
               box leaves behind while a voice session runs. The shared realtime-audio controller inserts its
               settings gear as a sibling (beside the button) and appends the status line + push-to-talk bar
               to the prompt container below the row — mirroring CrestApps.Core. *@
            <div class="d-flex gap-2 align-items-center px-3 my-2">

                @if (promptGeneratedProfiles.Any())
                {
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary rounded-pill dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fa-solid fa-screwdriver-wrench"></i>
                        </button>
                        <ul class="dropdown-menu">
                            @foreach (var promptGeneratedProfile in promptGeneratedProfiles)
                            {
                                <li>
                                    <button type="button" class="dropdown-item profile-generated-prompt" data-profile-id="@promptGeneratedProfile.ItemId">@promptGeneratedProfile.DisplayText</button>
                                </li>
                            }
                        </ul>
                    </div>
                }

                <div class="d-flex gap-2 align-items-center ms-auto">

                    <button class="btn btn-outline-secondary rounded stt-mic-btn" type="button" id="@micBtnHtmlId" title="@T["Voice input"]" style="display: none;">
                        <i class="fa-solid fa-microphone"></i>
                    </button>

                    @* Send sits with the message box it belongs to. *@
                    <button class="btn btn-dark rounded" type="button" id="@buttonHtmlId" disabled data-start-icon="<i class='fa-solid fa-arrow-up'></i>" data-stop-icon="<i class='fa-solid fa-stop'></i>">
                        <i class="fa-solid fa-arrow-up"></i>
                    </button>
                </div>

                @if (conversationModeEnabled)
                {
                    @* A direct child of the row rather than of the group above, so that when a live session
                       takes the message box and send away the client can grow this button into the space they
                       leave. The realtime module inserts its settings popover directly after it, which puts
                       the gear at the far right of the row.

                       Idle is the soundwave on its own; the title and aria-label carry the meaning. The end
                       state keeps its words because stopping a live conversation should be unmistakable. *@
                    <button class="btn btn-dark rounded" type="button" id="@conversationBtnHtmlId" title="@(realtimeEnabled ? T["Start speaking"] : T["Start Conversation"])" aria-label="@(realtimeEnabled ? T["Start speaking"] : T["Start Conversation"])" data-start-title="@(realtimeEnabled ? T["Start speaking"] : T["Start Conversation"])" data-end-title="@T["End Conversation"]" data-start-html="<i class='fa-solid fa-wave-square'></i>" data-end-html="<i class='fa-solid fa-stop me-1'></i> @T["End Conversation"]">
                        <i class="fa-solid fa-wave-square"></i>
                    </button>
                }
            </div>

            @if (realtimeEnabled)
            {
                @* Shown only while a voice session is live: the old copy announced a voice-only profile,
                   which is exactly what this is not any more. *@
                <div class="form-text text-center pb-2 d-none" id="@realtimeHintHtmlId">
                    <i class="fa-solid fa-circle-info"></i> @T["Speaking. Use headphones to avoid echo — end the conversation to go back to typing."]
                </div>
            }
        </div>
    </div>
</div>

@{
    var prompts = new List<object>();

    if (sessionPrompts.Count > 0)
    {
        foreach (var prompt in sessionPrompts)
        {
            prompts.Add(new
            {
                Id = prompt.ItemId,
                prompt.Role,
                prompt.Content,
                prompt.Title,
                prompt.IsGeneratedPrompt,
                prompt.UserRating,
                prompt.References,
                Appearance = prompt.GetOrCreate<AssistantMessageAppearance>(),
            });
        }
    }

    var profileId = Model.Profile?.ItemId ?? Model.Session.ProfileId;
    var sessionUrlTemplate = Url.RouteUrl("AIChatSessionsIndex", new { profileId, sessionId = "__SESSION_ID__" })
        ?.Replace("__SESSION_ID__", "{sessionId}");

    var chatConfigJson = JsonSerializer.Serialize(new
    {
        signalRHubUrl = Html.SignalRHubUrl<AIChatHub>(),
        appElementSelector = $"#{chatAppHtmlId}",
        chatContainerElementSelector = $"#{chatContainerHtmlId}",
        inputElementSelector = $"#{userPromptHtmlId}",
        sendButtonElementSelector = $"#{buttonHtmlId}",
        placeholderElementSelector = $"#{placeholderHtmlId}",
        autoCreateSession = false,
        initialPrompt = addInitialPrompt ? profileMetadata.InitialPrompt : null,
        sessionUrlTemplate,
        messages = prompts,
        metricsEnabled,
        chatMode = effectiveChatMode.ToString(),
        micButtonElementSelector = $"#{micBtnHtmlId}",
        ttsVoiceName = string.IsNullOrWhiteSpace(ttsVoiceName) ? null : ttsVoiceName,
        conversationButtonElementSelector = $"#{conversationBtnHtmlId}",
        realtimeHintElementSelector = realtimeEnabled ? $"#{realtimeHintHtmlId}" : null,
        textToSpeechEnabled,
        visionEnabled,
        // Realtime (speech-to-speech). ai-chat.js reuses the conversation button as the realtime toggle and
        // drives capture/playback via the shared realtime-audio.js controller (window.CoreAIRealtime). ICE
        // servers are fetched per session over the hub, so they are not embedded here.
        realtimeEnabled,
        realtimeWebRtcEnabled,
        realtimeVoiceName = string.IsNullOrWhiteSpace(realtimeVoiceName) ? null : realtimeVoiceName,
        isOrchestratorAvailable = orchestratorAvailability.IsAvailable,
        orchestratorUnavailableMessage = orchestratorAvailability.IsAvailable ? null : orchestratorAvailability.Message,
        sessionDocumentsEnabled,
        documentBarSelector = sessionDocumentsEnabled ? $"#{documentBarHtmlId}" : null,
        uploadDocumentUrl = sessionDocumentsEnabled ? Url.RouteUrl(AIConstants.RouteNames.ChatSessionUploadDocument) : null,
        removeDocumentUrl = sessionDocumentsEnabled ? Url.RouteUrl(AIConstants.RouteNames.ChatSessionRemoveDocument) : null,
        allowedExtensions = sessionDocumentsEnabled ? allowedExtensions : null,
        supportedExtensionsText = sessionDocumentsEnabled ? supportedExtensionsText : null,
        existingDocuments = sessionDocumentsEnabled
            ? Model.Session.Documents ?? new List<ChatDocumentInfo>()
            : new List<ChatDocumentInfo>(),
    }, JOptions.CamelCase);
}

<style asp-name="AIChatApp" at="Head"></style>

<style asp-name="highlightjs" at="Head"></style>

@if (speechToTextEnabled)
{
    <style asp-name="SpeechToText" at="Head"></style>
}

<script asp-name="AIChatApp" at="Foot"></script>

<div id="@($"{baseId}_Config")"
     class="d-none"
     data-coreai-chat-config="@chatConfigJson"></div>

<style at="Head">
    .chat-user-prompt-input:focus {
        border: none;
        box-shadow: none;
    }
</style>
