@model ShapeViewModel<WebhookSubscription>

<span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Events sent"]">
    <i class="fa-solid fa-bolt text-secondary me-1" aria-hidden="true"></i>@(Model.Value.Events.Contains(WebhookConstants.AllEvents) ? T["Every event"] : T.Plural(Model.Value.Events.Count, "1 event", "{0} events"))
</span>
