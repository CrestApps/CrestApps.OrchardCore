<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
    <Title>CrestApps OrchardCore Commerce Webhooks</Title>
    <Description>
      $(OCCMSDescription)

      Outgoing webhooks for the commerce modules: order, shipment, customer and stock events, published through the
      Webhooks building block, which signs each payload with the subscription's secret, retries with backoff and logs
      every delivery.
    </Description>
    <PackageTags>$(PackageTags) CrestApps OrchardCoreCMS Commerce Webhooks</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OrchardCore.Module.Targets" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Abstractions\CrestApps.OrchardCore.Abstractions\CrestApps.OrchardCore.Abstractions.csproj" />
    <ProjectReference Include="..\..\Abstractions\CrestApps.OrchardCore.Webhooks.Abstractions\CrestApps.OrchardCore.Webhooks.Abstractions.csproj" />
    <!-- Carries the Webhooks feature this feature depends on. -->
    <ProjectReference Include="..\CrestApps.OrchardCore.Webhooks\CrestApps.OrchardCore.Webhooks.csproj" />
  </ItemGroup>

</Project>
