@model FundraisingSettingsViewModel

<div class="mb-3">
    <label asp-for="OrganizationName" class="form-label">@T["Organization"]</label>
    <input asp-for="OrganizationName" class="form-control" />
    <span class="hint">@T["Who donations go to, as it reads on receipts. Leave it empty to use the site's name."]</span>
</div>

<div class="mb-3">
    <label asp-for="TaxId" class="form-label">@T["Tax ID"]</label>
    <input asp-for="TaxId" class="form-control" style="max-width: 16rem;" />
    <span class="hint">@T["The organization's tax or charity registration number, printed on receipts."]</span>
</div>

<div class="mb-3">
    <label asp-for="ReceiptStatement" class="form-label">@T["Receipt statement"]</label>
    <textarea asp-for="ReceiptStatement" class="form-control" rows="3"></textarea>
    <span class="hint">@T["What the receipt says about the gift, such as that nothing was given in return for it."]</span>
</div>

<div class="mb-3">
    <div class="form-check">
        <input asp-for="EmailReceipts" type="checkbox" class="form-check-input" />
        <label asp-for="EmailReceipts" class="form-check-label">@T["Email donors their receipts"]</label>
        <span class="hint dashed">@T["Untick it to have donors find their receipts in their account only."]</span>
    </div>
</div>
