@model PhoneNumberVerificationsSettingsViewModel

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <div class="alert alert-info" role="alert">@T["Configure how often stored phone number verification results are revalidated and which provider is used by default. Enable a provider feature to make it available below."]</div>
    </div>
</div>

@if (Model.Providers.Count > 0)
{
    <div class="ocat-wrapper">
        <label asp-for="SelectedProvider" class="ocat-label">@T["Default provider"]</label>
        <div class="ocat-end">
            <select asp-for="SelectedProvider" asp-items="Model.Providers" class="form-select">
                <option value="">@T["First available provider"]</option>
            </select>
            <span class="hint">@T["The provider used by default when verifying phone numbers. Only enabled providers are listed here."]</span>
        </div>
    </div>
}
else
{
    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <div class="alert alert-warning" role="alert">@T["No verification providers are enabled. Enable a provider from its tab above (for example, AbstractAPI, Veriphone, or Twilio) to verify phone numbers."]</div>
        </div>
    </div>
}
