@model PhoneNumberVerificationRecordsViewModel

@{
    var returnUrl = Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString;

    var filters = new[]
    {
        PhoneNumberVerificationRecordFilter.All,
        PhoneNumberVerificationRecordFilter.Verified,
        PhoneNumberVerificationRecordFilter.Invalid,
        PhoneNumberVerificationRecordFilter.Failed,
        PhoneNumberVerificationRecordFilter.Pending,
        PhoneNumberVerificationRecordFilter.NeedsAttention,
    };
}

<zone Name="Title">
    <breadcrumb name="PhoneVerifications" title="@T["Phone Verifications Queue"]" />
</zone>

<div class="row row-cols-2 row-cols-md-3 row-cols-xl-6 g-3 mb-4">
    @foreach (var filter in filters)
    {
        var count = Model.Counts.TryGetValue(filter, out var value) ? value : 0;
        var isActive = Model.Status == filter;
        var label = filter switch
        {
            PhoneNumberVerificationRecordFilter.All => T["All"],
            PhoneNumberVerificationRecordFilter.Verified => T["Verified"],
            PhoneNumberVerificationRecordFilter.Invalid => T["Invalid"],
            PhoneNumberVerificationRecordFilter.Failed => T["Failed"],
            PhoneNumberVerificationRecordFilter.Pending => T["Pending"],
            PhoneNumberVerificationRecordFilter.NeedsAttention => T["Needs attention"],
            _ => T[filter.ToString()],
        };
        var accent = filter switch
        {
            PhoneNumberVerificationRecordFilter.Verified => "text-success",
            PhoneNumberVerificationRecordFilter.Invalid => "text-danger",
            PhoneNumberVerificationRecordFilter.Failed => "text-warning",
            PhoneNumberVerificationRecordFilter.NeedsAttention => "text-danger",
            _ => "text-body",
        };

        <div class="col">
            <a asp-action="Index" asp-route-status="@filter" asp-route-q="@Model.Q" asp-route-sort="@Model.Sort" asp-route-pageSize="@Context.Request.Query["pageSize"]"
               class="card h-100 text-decoration-none @(isActive ? "border-primary border-2" : "")"
               title="@T["Show {0} records", label]">
                <div class="card-body py-3">
                    <h6 class="card-subtitle text-muted mb-1">@label</h6>
                    <p class="h3 mb-0 @accent">@count</p>
                </div>
            </a>
        </div>
    }
</div>

@* One form for the search, the bulk action and the row actions: it carries the antiforgery token and the return URL. *@
<form asp-action="Index" asp-controller="Records" asp-route-pageSize="@Context.Request.Query["pageSize"]" method="post" class="no-multisubmit" autocomplete="off"
      data-list-management data-selected-label="@T["selected"]" data-client-side-search="false">
    <input type="submit" name="submit.Filter" id="submitFilter" class="visually-hidden" />
    @* The bulk action of the toolbar ("Retry") re-queues the selected records. *@
    <input type="submit" name="submit.BulkAction" formaction="@Url.Action("RetrySelected", "Records")" class="visually-hidden" />
    <input type="hidden" asp-for="Status" />
    <input type="hidden" name="returnUrl" value="@returnUrl" />

    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <div class="input-group">
                        <input id="search-box" asp-for="Q" class="form-control" placeholder="@T["Search by phone number"]" type="search" autofocus autocomplete="off" />
                        <button type="submit" name="submit.Filter" class="btn btn-outline-secondary" title="@T["Search"]" aria-label="@T["Search"]"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
                    </div>
                </div>
                <div class="col-auto">
                    <select asp-for="Sort" asp-items="Model.Sorts" class="form-select" title="@T["Sort by"]" aria-label="@T["Sort by"]" data-list-filter-submit></select>
                </div>
                @if (Model.CanVerifyPhoneNumbers)
                {
                    <div class="col-auto">
                        <button type="submit" class="btn btn-warning" formaction="@Url.Action("RetryAllFailed", "Records")"
                                title="@T["Re-queues every failed or needs-attention record across all pages that matches the current search."]">
                            <i class="fa-solid fa-list-check me-1" aria-hidden="true"></i>@T["Retry all failed"]
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

    @* The records, the toolbar and the pager are rendered by the AdminList shape, in the layout (List or Grid) the site or the user picked. *@
    <admin-list name="PhoneNumberVerificationRecords" context="Model.List"
                empty-message="@T["No phone number verifications match the current filter."]">
        <admin-list-list item-css-class="list-group-item" />
        <admin-list-grid>
            @if (Model.CanVerifyPhoneNumbers)
            {
                <admin-list-column type="Select" />
            }
            <admin-list-column name="Name" position="20" title="@T["Phone number"]" />
            <admin-list-column name="Status" position="30" title="@T["Status"]" width="auto" />
            <admin-list-column name="Provider" position="40" title="@T["Provider"]" width="auto" />
            <admin-list-column name="Attempts" position="50" title="@T["Attempts"]" width="auto" />
            <admin-list-column type="Actions" title="@T["Actions"]" />
        </admin-list-grid>
    </admin-list>
</form>

<script asp-name="list-management-ui" at="Foot"></script>
