@model TelnyxSettingsViewModel

<div class="ocat-wrapper" asp-validation-class-for="NoiseSuppressionEngine">
    <label asp-for="NoiseSuppressionEngine" class="ocat-label">@T["Noise suppression"]</label>
    <div class="ocat-end">
        <select class="form-select" asp-for="NoiseSuppressionEngine">
            <option value="@TelnyxNoiseSuppressionEngine.Off">@T["Off"]</option>
            <option value="@TelnyxNoiseSuppressionEngine.Krisp">@T["Krisp - also removes other people talking nearby"]</option>
            <option value="@TelnyxNoiseSuppressionEngine.DeepFilterNet">@T["DeepFilterNet - tuned for phone calls"]</option>
            <option value="@TelnyxNoiseSuppressionEngine.Denoiser">@T["Denoiser - general background noise"]</option>
            <option value="@TelnyxNoiseSuppressionEngine.AiCoustics">@T["ai-coustics - tuned for speech recognition"]</option>
        </select>
        <span class="hint">@T["Telnyx cleans background sound out of the call audio before the other person hears it. Choose Krisp when callers can hear colleagues talking near your agents. This is a Telnyx beta feature, billed by Telnyx for each voice you clean."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="NoiseSuppressionStrength">
    <label asp-for="NoiseSuppressionStrength" class="ocat-label">@T["Suppression strength"]</label>
    <div class="ocat-end">
        <select class="form-select" asp-for="NoiseSuppressionStrength">
            <option value="@TelnyxNoiseSuppressionStrength.Light">@T["Light - the most natural voice"]</option>
            <option value="@TelnyxNoiseSuppressionStrength.Balanced">@T["Balanced - removes line hiss, keeps word endings"]</option>
            <option value="@TelnyxNoiseSuppressionStrength.Strong">@T["Strong - removes the most noise"]</option>
        </select>
        <span class="hint">@T["How hard the engine works on each voice it cleans. Strong can cut off the quiet end of words and make a voice sound louder and less natural, so Balanced suits most call centers. Every engine except Denoiser, which has no strength to set, honors it."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" asp-for="NoiseSuppressionAgentVoice" />
            <label class="form-check-label" asp-for="NoiseSuppressionAgentVoice">@T["Clean the agent's voice (what callers hear)"]</label>
            <span class="hint dashed">@T["Removes the noise around the agent before it reaches the caller. The soft phone's voice isolation, on by default, usually does this already."]</span>
        </div>
        <div class="form-check">
            <input type="checkbox" class="form-check-input" asp-for="NoiseSuppressionCallerVoice" />
            <label class="form-check-label" asp-for="NoiseSuppressionCallerVoice">@T["Clean the caller's voice (what the agent hears)"]</label>
            <span class="hint dashed">@T["Removes line hiss and the noise around the caller before it reaches the agent. Billed separately."]</span>
        </div>
    </div>
</div>
