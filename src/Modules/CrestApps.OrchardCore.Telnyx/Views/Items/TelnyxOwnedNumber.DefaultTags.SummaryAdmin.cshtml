@using CrestApps.OrchardCore.Telnyx.Services
@using Microsoft.AspNetCore.Mvc.Localization
@using OrchardCore.DisplayManagement.Views

@model ShapeViewModel<TelnyxOwnedNumber>

<span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Status"]"><i class="fa-solid fa-signal text-secondary me-1" aria-hidden="true"></i>@Model.Value.Status</span>
@if (!string.IsNullOrEmpty(Model.Value.MessagingProfileId))
{
    <span class="badge ta-badge fw-normal"><i class="fa-solid fa-comment-sms text-secondary me-1" aria-hidden="true"></i>@T["Texts"]</span>
}
@if (Model.Value.SpamRejections > 0)
{
    <span class="badge text-bg-warning fw-normal" data-bs-toggle="tooltip" title="@T["Calls from this number carriers refused as spam (SIP 607 or 608) in the last 30 days. Register the number with the carriers' call analytics, or replace it."]"><i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i>@T.Plural(Model.Value.SpamRejections, "1 spam rejection", "{0} spam rejections")</span>
}
