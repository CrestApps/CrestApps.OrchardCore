@model WebhookEditViewModel

<div class="ocat-wrapper" asp-validation-class-for="Name">
    <label asp-for="Name" class="ocat-label ocat-label-required">@T["Name"]</label>
    <div class="ocat-end">
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name"></span>
        <span class="hint">@T["What you call it, such as the system it feeds."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="Url">
    <label asp-for="Url" class="ocat-label ocat-label-required">@T["URL"]</label>
    <div class="ocat-end">
        <input asp-for="Url" class="form-control font-monospace" type="url" placeholder="https://" />
        <span asp-validation-for="Url"></span>
        <span class="hint">@T["Events are posted here as JSON. It must answer with a 2xx status; anything else is tried again, less and less often, for about two days."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="IsEnabled">
    <div class="ocat-end-offset">
        <div class="form-check form-switch">
            <input asp-for="IsEnabled" type="checkbox" class="form-check-input" />
            <label asp-for="IsEnabled" class="form-check-label">@T["On"]</label>
        </div>
        <span class="hint dashed">@T["Turn it off to stop sending without losing it; deliveries still waiting are dropped."]</span>
    </div>
</div>