@model WebhookEditViewModel

<zone Name="Title">
    <breadcrumb name="WebhookEdit" title="@(Model.IsNew ? T["Add Webhook"] : T["Edit Webhook"])">
        <breadcrumb-item id="Webhooks" action="Index" controller="WebhooksAdmin" area="CrestApps.OrchardCore.Webhooks" permission="@WebhookPermissions.ManageWebhooks.Name">@T["Webhooks"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form asp-action="@(Model.IsNew ? "Create" : "Edit")" asp-route-itemId="@Model.ItemId" method="post" class="no-multisubmit" id="webhook-form">
    <div asp-validation-summary="ModelOnly"></div>

    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <button type="submit" class="btn btn-primary save">@T["Save"]</button>
        <a asp-action="Index" class="btn btn-secondary">@T["Cancel"]</a>
        @if (!Model.IsNew)
        {
            <a asp-action="Deliveries" asp-route-itemId="@Model.ItemId" class="btn btn-secondary action-bar-secondary">@T["Deliveries"]</a>
            <a asp-action="Delete" asp-route-itemId="@Model.ItemId" class="btn btn-danger action-bar-secondary" data-url-af="RemoveUrl UnsafeUrl">@T["Delete"]</a>
        }
    </div>
</form>
