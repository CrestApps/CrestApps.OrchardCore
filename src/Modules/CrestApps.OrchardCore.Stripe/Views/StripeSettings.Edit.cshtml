@using CrestApps.OrchardCore.Stripe.Core
@using CrestApps.OrchardCore.Stripe.Endpoints
@using CrestApps.OrchardCore.Stripe.ViewModels
@using Microsoft.AspNetCore.Routing

@inject LinkGenerator LinkGenerator
@model StripeSettingsViewModel
@{
    var webhookUrl = LinkGenerator.GetUriByName(ViewContext.HttpContext, StripeConstants.RouteName.CreateWebhookEndpoint);
}
<div class="alert alert-info" role="alert">
    <p>
        @T["<strong>Step 1 — Get your API keys.</strong> Sign in to the <a href=\"https://dashboard.stripe.com/\" target=\"_blank\" rel=\"noopener\">Stripe Dashboard</a>. Use the <code>Test mode</code> switch (top-right) to choose test or live keys, then open <a href=\"https://dashboard.stripe.com/apikeys\" target=\"_blank\" rel=\"noopener\">Developers &rarr; API keys</a>. Copy the <code>Publishable key</code> and the <code>Secret key</code> into the fields below."]
    </p>
    <p class="mb-1">
        @T["<strong>Step 2 — Add a webhook</strong> so Stripe can notify this site when a payment succeeds. Use one of the options below, then copy the resulting signing secret (it starts with <code>whsec_</code>) into the matching <em>Webhooks Secret</em> field below."]
    </p>
    <ul>
        <li>
            @T["<strong>Public or production site:</strong> open <a href=\"https://dashboard.stripe.com/webhooks/create\" target=\"_blank\" rel=\"noopener\">Developers &rarr; Webhooks &rarr; Add endpoint</a> and set the <code>Endpoint URL</code> to:"]
            <div>
                <code>@webhookUrl</code>
            </div>
            @T["After the endpoint is created, open it and reveal its <code>Signing secret</code>."]
        </li>
        <li>
            @T["<strong>Local development:</strong> Stripe cannot reach a private address, so forward events with the <a href=\"https://docs.stripe.com/stripe-cli\" target=\"_blank\" rel=\"noopener\">Stripe CLI</a> instead. The signing secret is printed when <code>stripe listen</code> starts:"]
            <pre class="mb-0"><code>stripe login
stripe listen --forward-to @webhookUrl</code></pre>
        </li>
        <li>
            @T["Subscribe the endpoint to these events:"]
            <ul>
                @foreach (var eventName in CreateWebhookEndpoint.SupportedEvents)
                {
                    <li>
                        <code>@eventName</code>
                    </li>
                }
            </ul>
        </li>
    </ul>
</div>

<div class="ocat-wrapper" asp-validation-class-for="IsLive">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" asp-for="IsLive" role="button" />
            <label class="form-check-label" asp-for="IsLive">@T["Enable Production"]</label>
        </div>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="CheckoutMode">
    <label asp-for="CheckoutMode" class="ocat-label">@T["Checkout Mode"]</label>
    <div class="ocat-end">
        <select asp-for="CheckoutMode" class="form-select" asp-items="Html.GetEnumSelectList<StripeCheckoutMode>()"></select>
        <span class="hint">
            @T["Choose how customers pay. <strong>Payment Elements</strong> collects card details on your site (the original integration). <strong>Hosted Checkout</strong> redirects customers to a secure Stripe-hosted page, which Stripe recommends and which minimizes your PCI scope."]
        </span>
    </div>
</div>

<div class="live-stripe-settings@(Model.IsLive ? string.Empty : " d-none")">

    <div class="ocat-wrapper" asp-validation-class-for="LivePublishableKey">
        <label asp-for="LivePublishableKey" class="ocat-label">@T["Production Publishable Key"]</label>
        <div class="ocat-end">
            <input asp-for="LivePublishableKey" class="form-control" type="text" />
            <span asp-validation-for="LivePublishableKey"></span>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="LivePrivateSecret">
        <label asp-for="LivePrivateSecret" class="ocat-label">@T["Production Secret Key"]</label>
        <div class="ocat-end">
            <input asp-for="LivePrivateSecret" class="form-control" type="text" placeholder="@(Model.HasLivePrivateSecret ? @T["To update a stored key securely, provide a new value."] : string.Empty)" />
            <span asp-validation-for="LivePrivateSecret"></span>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="LiveWebhookSecret">
        <label asp-for="LiveWebhookSecret" class="ocat-label">@T["Production Webhooks Secret"]</label>
        <div class="ocat-end">
            <input asp-for="LiveWebhookSecret" class="form-control" type="text" placeholder="@(Model.HasLiveWebhookSecret ? @T["To update a stored key securely, provide a new value."] : string.Empty)" />
            <span asp-validation-for="LiveWebhookSecret"></span>
        </div>
    </div>

</div>

<div class="testing-stripe-settings@(Model.IsLive ? " d-none" : string.Empty)">

    <div class="ocat-wrapper" asp-validation-class-for="TestPublishableKey">
        <label asp-for="TestPublishableKey" class="ocat-label">@T["Test Publishable Key"]</label>
        <div class="ocat-end">
            <input asp-for="TestPublishableKey" class="form-control" type="text" />
            <span asp-validation-for="TestPublishableKey"></span>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="TestPrivateSecret">
        <label asp-for="TestPrivateSecret" class="ocat-label">@T["Test Secret Key"]</label>
        <div class="ocat-end">
            <input asp-for="TestPrivateSecret" class="form-control" type="text" placeholder="@(Model.HasTestPrivateSecret ? @T["To update a stored key securely, provide a new value."] : string.Empty)" />
            <span asp-validation-for="TestPrivateSecret"></span>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="TestWebhookSecret">
        <label asp-for="TestWebhookSecret" class="ocat-label">@T["Test Webhooks Secret"]</label>
        <div class="ocat-end">
            <input asp-for="TestWebhookSecret" class="form-control" type="text" placeholder="@(Model.HasTestWebhookSecret ? @T["To update a stored key securely, provide a new value."] : string.Empty)" />
            <span asp-validation-for="TestWebhookSecret"></span>
        </div>
    </div>

</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const isLiveElement = document.getElementById('@Html.IdFor(m => m.IsLive)');
        const liveElements = document.querySelectorAll('.live-stripe-settings');
        const testingElements = document.querySelectorAll('.testing-stripe-settings');
        const toggleElements = (elements, show) => {
            for (let i = 0; i < elements.length; i++) {
                if (show) {
                    elements[i].classList.remove('d-none');
                } else {
                    elements[i].classList.add('d-none');
                }
            }
        }

        isLiveElement.addEventListener('change', (e) => {
            if (e.target.checked) {
                toggleElements(liveElements, true);
                toggleElements(testingElements, false);
            } else {
                toggleElements(liveElements, false);
                toggleElements(testingElements, true);
            }
        })
    });
</script>
