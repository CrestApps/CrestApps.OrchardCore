@using CrestApps.OrchardCore.Stripe.Core
@using CrestApps.OrchardCore.Stripe.ViewModels
@using Microsoft.AspNetCore.Routing

@inject LinkGenerator LinkGenerator
@model StripeSettingsViewModel

@{
    var webhookUrl = LinkGenerator.GetUriByName(ViewContext.HttpContext, StripeConstants.RouteName.CreateWebhookEndpoint);

    var anyFromConfiguration = Model.IsLiveFromConfiguration ||
        Model.LivePublishableKeyFromConfiguration ||
        Model.LivePrivateSecretFromConfiguration ||
        Model.LiveWebhookSecretFromConfiguration ||
        Model.TestPublishableKeyFromConfiguration ||
        Model.TestPrivateSecretFromConfiguration ||
        Model.TestWebhookSecretFromConfiguration;
}

@if (anyFromConfiguration)
{
    <div class="alert alert-secondary" role="alert">
        @T["Some values on this page are configured from the application settings. They take precedence over the values saved here, are shown read-only, and can only be changed where the application settings are kept."]
    </div>
}

<div class="ocat-wrapper" asp-validation-class-for="IsLive">
    <div class="ocat-end-offset">
        <div class="form-check">
            @if (Model.IsLiveFromConfiguration)
            {
                <input type="checkbox" class="form-check-input" id="@Html.IdFor(m => m.IsLive)" checked="@Model.IsLive" disabled />
            }
            else
            {
                <input type="checkbox" class="form-check-input" asp-for="IsLive" role="button" />
            }
            <label class="form-check-label" asp-for="IsLive">@T["Enable Production"]</label>
        </div>
        <span class="hint">@T["When enabled, the production (live) environment is used. Otherwise the test environment is used."]</span>
        @if (Model.IsLiveFromConfiguration)
        {
            <span class="hint d-block">@T["Configured from the application settings."]</span>
        }
    </div>
</div>

<div class="alert alert-info" role="alert">
    <p class="mb-1">
        @T["Paste your Stripe keys, <strong>save</strong> the settings, then click <strong>Connect</strong>. The saved key is verified and the webhook is created for you automatically \u2014 no dashboard setup required. Get your keys from <a href=\"https://dashboard.stripe.com/apikeys\" target=\"_blank\" rel=\"noopener\">Developers &rarr; API keys</a> (use the <code>Test mode</code> switch to choose test or live keys)."]
    </p>
    <p class="mb-0">
        @T["<strong>Local development.</strong> When this site is not publicly reachable, Stripe cannot create the webhook. Forward events with the <a href=\"https://docs.stripe.com/stripe-cli\" target=\"_blank\" rel=\"noopener\">Stripe CLI</a> and paste the printed signing secret into the optional <em>Webhook signing secret</em> field below:"]
        <span class="d-block"><code>stripe listen --forward-to @webhookUrl</code></span>
    </p>
</div>

<script data-disconnect-confirm="@T["Are you sure you want to disconnect this Stripe account? Card payments stop, the webhook this site created is removed, and the saved publishable key, secret key and webhook signing secret are deleted. To connect again you'll need to enter the keys again."]">
    const stripeSettingsScript = document.currentScript;

    document.addEventListener('DOMContentLoaded', () => {
        const isLiveElement = document.getElementById('@Html.IdFor(m => m.IsLive)');
        const liveElements = document.querySelectorAll('.live-stripe-settings');
        const testingElements = document.querySelectorAll('.testing-stripe-settings');
        const confirmMessage = stripeSettingsScript ? stripeSettingsScript.getAttribute('data-disconnect-confirm') : '';
        const token = document.querySelector('input[name="__RequestVerificationToken"]');
        const connectButtons = document.querySelectorAll('.stripe-connect');
        const disconnectButtons = document.querySelectorAll('.stripe-disconnect');

        // The environment is the content of a card: the card is hidden with it, so no empty card is left behind.
        const toggleElements = (elements, show) => {
            for (let i = 0; i < elements.length; i++) {
                const target = elements[i].closest('fieldset') || elements[i];

                target.classList.toggle('d-none', !show);
                elements[i].classList.toggle('d-none', !show);
            }
        };

        const syncEnvironment = () => {
            const live = isLiveElement.checked;
            toggleElements(liveElements, live);
            toggleElements(testingElements, !live);
        };

        isLiveElement.addEventListener('change', syncEnvironment);
        syncEnvironment();

        const post = async (url, params) => {
            const body = new URLSearchParams(params);
            const response = await fetch(url, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token ? token.value : '',
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: body.toString()
            });

            if (response.redirected) {
                window.location.href = response.url;
            } else {
                window.location.reload();
            }
        };

        for (let i = 0; i < connectButtons.length; i++) {
            connectButtons[i].addEventListener('click', async (e) => {
                e.preventDefault();

                const button = e.currentTarget;

                button.disabled = true;

                // Connecting uses the saved keys. Keys typed but not saved never reach it: the button is hidden
                // while they are edited, so nothing the administrator entered is lost to the reload.
                await post(button.getAttribute('data-url'), {
                    live: button.getAttribute('data-live')
                });
            });
        }

        // An edited key is not saved yet, so connecting now would verify the old one. Ask for a save instead.
        const environments = document.querySelectorAll('[data-stripe-environment]');

        for (let i = 0; i < environments.length; i++) {
            const environment = environments[i];
            const connectArea = environment.querySelector('[data-stripe-connect-area]');
            const saveFirst = environment.querySelector('[data-stripe-save-first]');

            if (!connectArea || !saveFirst) {
                continue;
            }

            const keyInputs = environment.querySelectorAll('[data-stripe-secret], [data-stripe-publishable]');
            const initialValues = Array.prototype.map.call(keyInputs, (input) => input.value);

            const syncConnect = () => {
                const edited = Array.prototype.some.call(keyInputs, (input, index) => input.value !== initialValues[index]);

                connectArea.classList.toggle('d-none', edited);
                saveFirst.classList.toggle('d-none', !edited);
            };

            for (let j = 0; j < keyInputs.length; j++) {
                keyInputs[j].addEventListener('input', syncConnect);
            }
        }

        for (let i = 0; i < disconnectButtons.length; i++) {
            disconnectButtons[i].addEventListener('click', async (e) => {
                e.preventDefault();

                if (!window.confirm(confirmMessage)) {
                    return;
                }

                const button = e.currentTarget;

                button.disabled = true;

                await post(button.getAttribute('data-url'), {
                    live: button.getAttribute('data-live')
                });
            });
        }
    });
</script>
