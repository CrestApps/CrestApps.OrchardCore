@using CrestApps.OrchardCore.Commerce
@using OrchardCore.DisplayManagement
@model IShape

@*
    The cards the buyer saved at checkout. Stripe keeps them; this page lists them and removes one.
*@

<zone Name="Title">
    <breadcrumb name="AccountPaymentMethods" title="@T["Payment methods"]">
        <breadcrumb-item id="CommerceAccount" url="@Url.RouteUrl(CommerceConstants.Account.HomeRouteName)">@T["Your account"]</breadcrumb-item>
    </breadcrumb>
</zone>

@await DisplayAsync(await New.CommerceAccountPage(Title: T["Payment methods"], Content: Model))
