@using CrestApps.OrchardCore.Subscriptions.ViewModels

@model TenantOnboardingViewModel

<div class="ocat-wrapper" asp-validation-class-for="RecipeName">
    <label asp-for="RecipeName" class="ocat-label">@T["Recipe"]</label>
    <div class="ocat-end">
        <select asp-for="RecipeName" asp-items="Model.Recipes" class="form-select"></select>
        <span asp-validation-for="RecipeName"></span>
    </div>
</div>
