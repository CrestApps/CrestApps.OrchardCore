@using CrestApps.OrchardCore.Subscriptions.ViewModels

@model SubscriptionSettingsViewModel

<h6>@T["Subscription Settings"]</h6>

@if (Model.PaymentMethods.Any())
{
    <div class="ocat-wrapper" asp-validation-class-for="DefaultPaymentMethod">
        <label asp-for="DefaultPaymentMethod" class="ocat-label">@T["Default Payment Method"]</label>
        <div class="ocat-end">
            <select asp-for="DefaultPaymentMethod" asp-items="Model.PaymentMethods" class="form-select">
                <option value="">@T["Select a method"]</option>
            </select>
        </div>
    </div>
}

<div class="ocat-wrapper" asp-validation-class-for="AllowGuestSignup">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" asp-for="AllowGuestSignup">
            <label class="form-check-label" asp-for="AllowGuestSignup">@T["Allow Guest Signup"]</label>
            <span class="hint dashed">@T["By default, users need to be logged in to sign up. Enabling this option allows individuals to sign up without having to register on the site."]</span>
        </div>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="Currency">
    <label asp-for="Currency" class="ocat-label">@T["Currency"]</label>
    <div class="ocat-end">
        <select asp-for="Currency" asp-items="Model.Currencies" class="form-select">
            <option value="">@T["Select default currency"]</option>
        </select>
    </div>
</div>
