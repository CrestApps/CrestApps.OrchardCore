@using CrestApps.OrchardCore.Subscriptions.Models
@using CrestApps.OrchardCore.Subscriptions.Services
@using CrestApps.OrchardCore.Products.Core.Services
@using CrestApps.OrchardCore.Subscriptions.ViewModels
@model AccountSubscriptionsViewModel
@inject SubscriptionDisplayText DisplayText
@inject OrchardCore.Modules.ILocalClock LocalClock
@functions {
    // Stored times are UTC; people read them in the site's time zone.
    private async Task<DateTime> LocalAsync(DateTime utc)
        => (await LocalClock.ConvertToLocalAsync(DateTime.SpecifyKind(utc, DateTimeKind.Utc))).DateTime;
}

@* The signed-in customer's subscriptions, the ones still running first, with a way to stop one from renewing. *@

@if (Model.Subscriptions.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <p class="mb-0">@T["You have no subscriptions."]</p>
        </div>
    </div>
}
else
{
    <div class="list-group">
        @foreach (var entry in Model.Subscriptions)
        {
            var subscription = entry.Subscription;
            var canCancel = subscription.Status is SubscriptionStatus.Active or SubscriptionStatus.Trialing or SubscriptionStatus.PastDue && !subscription.CancelAtPeriodEnd;
            var tone = subscription.Status switch
            {
                SubscriptionStatus.Active => "success",
                SubscriptionStatus.Trialing => "info",
                SubscriptionStatus.PastDue => "warning",
                _ => "secondary",
            };

            <div class="list-group-item py-3">
                <div class="d-flex flex-wrap align-items-start justify-content-between gap-2">
                    <div>
                        <div class="fw-semibold">@subscription.Title</div>
                        <div class="small text-muted">
                            @ProductPriceFormatter.Format(subscription.Amount, subscription.Currency) &middot; @DisplayText.BillingInterval(subscription.BillingDuration, subscription.DurationType)
                        </div>
                        <div class="small text-muted">
                            @if (subscription.CancelAtPeriodEnd)
                            {
                                @T["Ends {0:D}; it won't renew.", await LocalAsync(subscription.CurrentPeriodEndUtc)]
                            }
                            else if (subscription.NextBillingUtc is { } next && subscription.Status is SubscriptionStatus.Active or SubscriptionStatus.Trialing)
                            {
                                @T["Renews {0:D}.", await LocalAsync(next)]
                            }
                            else if (subscription.Status is SubscriptionStatus.Canceled or SubscriptionStatus.Expired)
                            {
                                @T["Ended {0:D}.", await LocalAsync(subscription.CurrentPeriodEndUtc)]
                            }
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge text-bg-@tone">@DisplayText.StatusName(subscription.Status)</span>
                        @if (canCancel)
                        {
                            <form action="@Url.RouteUrl("AccountSubscriptionCancel", new { itemId = subscription.ItemId })" method="post" onsubmit="return confirm('@T["Stop {0} from renewing? You keep access until {1:d}.", subscription.Title, await LocalAsync(subscription.CurrentPeriodEndUtc)]');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">@T["Cancel"]</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
    <p class="small text-muted mt-3">@T["Canceling stops the next payment. You keep access until the end of the period you have already paid for."]</p>
}
