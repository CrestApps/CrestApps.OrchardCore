@using CrestApps.OrchardCore.Payments
@using CrestApps.OrchardCore.Subscriptions.Core
@using CrestApps.OrchardCore.Subscriptions.Models
@using CrestApps.OrchardCore.Subscriptions.Services
@using CrestApps.OrchardCore.Subscriptions.ViewModels
@using OrchardCore.DisplayManagement.Html
@model SubscriptionAgreementViewModel
@inject SubscriptionDisplayText DisplayText

@{
    var subscription = Model.Subscription;
}

<zone Name="Title">
    <breadcrumb name="SubscriptionsAgreementsDetail" title="@(new HtmlContentString(subscription.Title ?? string.Empty))">
        <breadcrumb-item id="SubscriptionsAgreements" action="Index" controller="SubscriptionAgreements" area="CrestApps.OrchardCore.Subscriptions" permission="@SubscriptionPermissions.ManageSubscriptions.Name">@T["Agreements"]</breadcrumb-item>
    </breadcrumb>
</zone>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">@T["Status"]</dt>
            <dd class="col-sm-9"><partial name="_SubscriptionStatusBadge" model="subscription.Status" /></dd>

            <dt class="col-sm-3">@T["Billed"]</dt>
            <dd class="col-sm-9">@subscription.Currency @CurrencyScale.Format(subscription.TotalAmount, subscription.Currency) @DisplayText.BillingInterval(subscription.BillingDuration, subscription.DurationType)</dd>

            <dt class="col-sm-3">@T["Cycles billed"]</dt>
            <dd class="col-sm-9">
                @subscription.CyclesBilled
                @if (subscription.BillingCycleLimit.HasValue)
                {
                    @T["of {0}", subscription.BillingCycleLimit.Value]
                }
            </dd>

            <dt class="col-sm-3">@T["Current period"]</dt>
            <dd class="col-sm-9">@subscription.CurrentPeriodStartUtc.ToString("d") &ndash; @subscription.CurrentPeriodEndUtc.ToString("d")</dd>

            <dt class="col-sm-3">@T["Renews"]</dt>
            <dd class="col-sm-9">@(subscription.NextBillingUtc.HasValue ? subscription.NextBillingUtc.Value.ToString("g") : T["Never"].Value)</dd>

            @if (subscription.GraceEndsUtc.HasValue)
            {
                <dt class="col-sm-3">@T["Grace ends"]</dt>
                <dd class="col-sm-9">@subscription.GraceEndsUtc.Value.ToString("g")</dd>
            }

            <dt class="col-sm-3">@T["Payment method"]</dt>
            <dd class="col-sm-9">@(DisplayText.PaymentMethodName(subscription.ProviderKey) ?? T["None"].Value)</dd>

            @if (!string.IsNullOrEmpty(subscription.ProviderSubscriptionId))
            {
                <dt class="col-sm-3">@T["Gateway reference"]</dt>
                <dd class="col-sm-9"><span class="text-muted small">@subscription.ProviderSubscriptionId</span></dd>
            }

            <dt class="col-sm-3">@T["Owner"]</dt>
            <dd class="col-sm-9">@(Model.OwnerName ?? (string.IsNullOrEmpty(subscription.GuestContactEmail) ? T["Unknown"].Value : subscription.GuestContactEmail))</dd>
        </dl>
    </div>
</div>

@if (subscription.Lines.Count > 0)
{
    <div class="card mb-3">
        <div class="card-header">@T["What is billed"]</div>
        <div class="card-body p-0">
            <table class="table mb-0 align-middle">
                <tbody>
                    @foreach (var line in subscription.Lines)
                    {
                        <tr>
                            <td>@line.Description</td>
                            <td class="text-end">@line.Quantity &times; @subscription.Currency @CurrencyScale.Format(line.UnitPrice, subscription.Currency)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="card mb-3">
    <div class="card-header">@T["Actions"]</div>
    <div class="card-body">
        @if (subscription.Status != SubscriptionStatus.Canceled && subscription.Status != SubscriptionStatus.Expired)
        {
            <form asp-action="Cancel" asp-route-itemId="@subscription.ItemId" method="post" class="row gx-2 align-items-center mb-3">
                <div class="col">
                    <input type="text" name="reason" class="form-control" placeholder="@T["Reason"]" />
                </div>
                <div class="col-auto form-check">
                    <input class="form-check-input" type="checkbox" name="atPeriodEnd" value="true" id="atPeriodEnd" checked />
                    <label class="form-check-label" for="atPeriodEnd">@T["Keep access until the paid period ends"]</label>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-danger"
                            data-url-af="RemoveUrl"
                            data-title="@T["Cancel subscription"]"
                            data-message="@T["Are you sure you want to cancel this subscription? With Keep access until the paid period ends ticked, it ends when the paid period does; otherwise it ends now. Billing stops either way."]"
                            data-ok-text="@T["Cancel subscription"]"
                            data-cancel-text="@T["Keep it"]">
                        @T["Cancel subscription"]
                    </button>
                </div>
            </form>
        }

        @if (subscription.Status is SubscriptionStatus.Active or SubscriptionStatus.Trialing)
        {
            <form asp-action="Pause" asp-route-itemId="@subscription.ItemId" method="post" class="row gx-2 align-items-center">
                <div class="col">
                    <input type="text" name="reason" class="form-control" placeholder="@T["Reason"]" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-secondary"
                            data-url-af="RemoveUrl"
                            data-title="@T["Pause billing"]"
                            data-message="@T["Are you sure you want to pause billing? No payments are taken until you resume it."]"
                            data-ok-text="@T["Pause billing"]"
                            data-cancel-text="@T["Keep billing"]">
                        @T["Pause billing"]
                    </button>
                </div>
            </form>
        }

        @if (subscription.Status is SubscriptionStatus.Paused or SubscriptionStatus.PastDue)
        {
            <form asp-action="Resume" asp-route-itemId="@subscription.ItemId" method="post">
                <button type="submit" class="btn btn-primary"
                        data-url-af="RemoveUrl"
                        data-title="@T["Resume billing"]"
                        data-message="@T["Are you sure you want to resume billing for this subscription?"]"
                        data-ok-text="@T["Resume"]"
                        data-cancel-text="@T["Not now"]">
                    @T["Resume"]
                </button>
            </form>
        }
    </div>
</div>

<div class="card">
    <div class="card-header">@T["History"]</div>
    <div class="card-body p-0">
        <table class="table mb-0 align-middle">
            <tbody>
                @foreach (var subscriptionEvent in subscription.Events.OrderByDescending(e => e.CreatedUtc))
                {
                    <tr>
                        <td class="text-nowrap">@subscriptionEvent.CreatedUtc.ToString("g")</td>
                        <td class="text-nowrap">@DisplayText.EventTypeName(subscriptionEvent.Type)</td>
                        <td>@subscriptionEvent.Message</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
