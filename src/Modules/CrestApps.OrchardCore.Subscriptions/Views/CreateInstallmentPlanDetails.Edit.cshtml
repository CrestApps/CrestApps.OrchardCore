@using CrestApps.OrchardCore.Subscriptions.Models
@using CrestApps.OrchardCore.Subscriptions.ViewModels
@model CreateInstallmentPlanViewModel

<div class="ocat-wrapper" asp-validation-class-for="Title">
    <label asp-for="Title" class="ocat-label ocat-label-required">@T["What the plan is for"]</label>
    <div class="ocat-end">
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
        <span class="hint">@T["Shown to the customer on every payment, reminder and receipt."]</span>
    </div>
</div>

<div class="ocat-limited-wrapper" asp-validation-class-for="Currency">
    <label asp-for="Currency" class="ocat-label ocat-label-required">@T["Currency"]</label>
    <div class="ocat-limited">
        @if (Model.Currencies.Count > 0)
        {
            <select asp-for="Currency" asp-items="Model.Currencies" class="form-select" data-installment-input></select>
        }
        else
        {
            <input asp-for="Currency" class="form-control" maxlength="3" placeholder="USD" data-installment-input />
            <span class="hint">@T["The three-letter currency code, for example USD."]</span>
        }
        <span asp-validation-for="Currency" class="text-danger"></span>
    </div>
</div>

<div class="ocat-limited-wrapper" asp-validation-class-for="TotalAmount">
    <label asp-for="TotalAmount" class="ocat-label ocat-label-required">@T["Total"]</label>
    <div class="ocat-limited">
        <input asp-for="TotalAmount" type="number" min="0" step="any" class="form-control" data-installment-input />
        <span asp-validation-for="TotalAmount" class="text-danger"></span>
        <span class="hint">@T["Everything the customer pays, the down payment included."]</span>
    </div>
</div>

<div class="ocat-limited-wrapper" asp-validation-class-for="DownPaymentAmount">
    <label asp-for="DownPaymentAmount" class="ocat-label ocat-label-required">@T["Down payment today"]</label>
    <div class="ocat-limited">
        <input asp-for="DownPaymentAmount" type="number" min="0" step="any" class="form-control" data-installment-input />
        <span asp-validation-for="DownPaymentAmount" class="text-danger"></span>
        <span class="hint">@T["Enter 0 for no down payment. The first payment is then taken today instead, so its due date must be today."]</span>
    </div>
</div>

<div class="ocat-limited-wrapper" asp-validation-class-for="InstallmentCount">
    <label asp-for="InstallmentCount" class="ocat-label ocat-label-required">@T["Number of payments after it"]</label>
    <div class="ocat-limited">
        <input asp-for="InstallmentCount" type="number" min="1" max="120" step="1" class="form-control" data-installment-input />
        <span asp-validation-for="InstallmentCount" class="text-danger"></span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="Frequency">
    <label asp-for="Frequency" class="ocat-label">@T["Payments fall due"]</label>
    <div class="ocat-end">
        <select asp-for="Frequency" class="form-select" data-installment-input>
            <option value="@InstallmentFrequency.Weekly">@T["Every week"]</option>
            <option value="@InstallmentFrequency.BiWeekly">@T["Every two weeks"]</option>
            <option value="@InstallmentFrequency.Monthly">@T["Every month"]</option>
            <option value="@InstallmentFrequency.Quarterly">@T["Every three months"]</option>
        </select>
    </div>
</div>

<div class="ocat-limited-wrapper" asp-validation-class-for="FirstDueDate">
    <label asp-for="FirstDueDate" class="ocat-label ocat-label-required">@T["First payment due"]</label>
    <div class="ocat-limited">
        <input asp-for="FirstDueDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" data-installment-input />
        <span asp-validation-for="FirstDueDate" class="text-danger"></span>
    </div>
</div>
