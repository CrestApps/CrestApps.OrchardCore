@using CrestApps.OrchardCore.Subscriptions.Models
@using CrestApps.OrchardCore.Subscriptions.ViewModels
@model TenantProvisioningListViewModel

<zone Name="Title">
    <breadcrumb name="MySites" title="@T["My Sites"]" />
</zone>

@* The sites, the toolbar and the pager are rendered by the AdminList shape, in the layout (List or Grid) the site or the user picked. *@
<admin-list name="MySites" context="Model.List" show-select-all="false"
            empty-message="@T["<strong>Nothing here!</strong> You have not bought a site yet."]">
    <admin-list-list item-css-class="list-group-item" />
    <admin-list-grid>
        <admin-list-column name="Title" position="20" title="@T["Site"]" />
        <admin-list-column name="Status" position="30" title="@T["Status"]" width="auto" />
        <admin-list-column name="SiteName" position="40" title="@T["Site name"]" width="auto" />
        <admin-list-column name="Bought" position="50" title="@T["Bought"]" width="auto" />
        <admin-list-column type="Actions" title="@T["Actions"]" />
    </admin-list-grid>
</admin-list>

@if (Model.Jobs.Any(job => job.Status is not (TenantProvisioningStatus.Succeeded or TenantProvisioningStatus.Abandoned)))
{
    @* Only worth saying while a site is still being created. *@
    <p class="text-muted small mt-2">
        @T["A new site usually takes a minute or two to appear. This page refreshes when you reload it."]
    </p>
}
