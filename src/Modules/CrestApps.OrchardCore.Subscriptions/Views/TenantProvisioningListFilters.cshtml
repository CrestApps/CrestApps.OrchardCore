@*
    The status filter of the site provisioning list, passed to the admin list as its 'ToolbarActions' so it renders at
    the end of the list's toolbar. The select names the page's GET filter form; the commerce-admin-list script submits
    it when it changes.
*@
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    var statuses = (IList<SelectListItem>)Model.Statuses;
}

<div class="btn-group filter">
    <select name="status" asp-items="statuses" form="provisioning-filter" class="selectpicker show-tick" data-style="btn-sm" data-width="fit" data-header="@T["Filter by status"]" data-dropdown-align-right="auto" data-commerce-list-filter aria-label="@T["Status"]"></select>
</div>
