@using CrestApps.OrchardCore.Subscriptions.Models
@using CrestApps.OrchardCore.Subscriptions.ViewModels
@model MySubscriptionsViewModel

<zone Name="Title">
    <breadcrumb name="MySubscriptions" title="@T["My Plans"]" />
</zone>

@* The filter renders in the list's toolbar, after this form, and names it with its form attribute. The list stays
   outside the form because its rows post forms of their own (Cancel). *@
<form asp-action="Index" method="get" id="my-subscriptions-filter">
    @if (Context.Request.Query.TryGetValue("pageSize", out var selectedPageSize))
    {
        <input type="hidden" name="pageSize" value="@selectedPageSize" />
    }
</form>

@* The plans, the toolbar with the filter and the pager are rendered by the AdminList shape, in the layout (List or Grid) the site or the user picked. *@
<admin-list name="MySubscriptions" context="Model.List" show-select-all="false"
            empty-message="@T["<strong>Nothing here!</strong> You do not have any subscriptions that match the current filter."]">
    <admin-list-list item-css-class="list-group-item" />
    <admin-list-grid>
        <admin-list-column name="Title" position="20" title="@T["Plan"]" />
        <admin-list-column name="Status" position="30" title="@T["Status"]" width="auto" />
        <admin-list-column name="Amount" position="40" title="@T["Per cycle"]" width="auto" />
        <admin-list-column name="Renews" position="50" title="@T["Renews"]" width="auto" />
        <admin-list-column name="AccessUntil" position="60" title="@T["Access until"]" width="auto" />
        <admin-list-column type="Actions" title="@T["Actions"]" />
    </admin-list-grid>
</admin-list>

@if (Model.Subscriptions.Any(subscription => subscription.Status is SubscriptionStatus.Active or SubscriptionStatus.Trialing or SubscriptionStatus.PastDue))
{
    @* Only worth saying when there is something here the customer can cancel. *@
    <p class="text-muted small mt-2">
        @T["Cancelling stops the next payment. You keep access until the end of the period you have already paid for."]
    </p>
}

<style asp-name="bootstrap-select"></style>
<script asp-name="commerce-admin-list" at="Foot"></script>
