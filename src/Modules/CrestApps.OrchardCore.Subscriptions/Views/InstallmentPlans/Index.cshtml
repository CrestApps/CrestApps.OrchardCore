@using CrestApps.OrchardCore.Payments
@using CrestApps.OrchardCore.Subscriptions.Models
@using CrestApps.OrchardCore.Subscriptions.ViewModels
@using Microsoft.AspNetCore.Mvc.Localization
@model InstallmentPlansIndexViewModel

@{
    var pager = (dynamic)Model.Pager;
    int totalItemCount = pager.TotalItemCount;
}

<zone Name="Title">
    <breadcrumb name="SubscriptionsInstallmentPlans" title="@T["Installment Plans"]" />
</zone>

<form asp-action="Index" asp-route-pageSize="@Context.Request.Query["pageSize"]" method="post" id="installment-plans-filter" class="no-multisubmit">
    <input type="submit" name="submit.Filter" id="submitFilter" class="visually-hidden" />

    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-1">
                <div class="col">
                    <div class="has-search">
                        <i class="fa-solid fa-search form-control-feedback" aria-hidden="true"></i>
                        <input asp-for="Options.Search" class="form-control" placeholder="@T["Search by plan or customer"]" type="search" autocomplete="off" />
                    </div>
                </div>
                <div class="col-auto">
                    <a asp-action="Create" class="btn btn-secondary text-nowrap">@T["New plan"]</a>
                </div>
            </div>
        </div>
    </div>
</form>

<ul class="list-group">
    <li class="list-group-item text-bg-theme">
        <div class="row gx-3 align-items-center">
            <div class="col text-nowrap">
                @T.Plural(Model.Plans.Count, "1 plan", "{0} plans")
                <span class="text-muted">@T.Plural(totalItemCount, " / {0} plan in total", " / {0} plans in total")</span>
            </div>
            <div class="col col-md-auto text-end">
                <div class="btn-group filter">
                    <select asp-for="Options.Status" asp-items="Model.Options.Statuses" form="installment-plans-filter" class="selectpicker show-tick" data-style="btn-sm" data-width="fit" data-header="@T["Filter by status"]" data-dropdown-align-right="auto" data-commerce-list-filter aria-label="@T["Status"]"></select>
                </div>
            </div>
        </div>
    </li>
    @if (Model.Plans.Count > 0)
    {
        @foreach (var plan in Model.Plans)
        {
            var next = plan.NextPayment;
            var isOpen = plan.Status is not (InstallmentPlanStatus.Canceled or InstallmentPlanStatus.Completed);
            string Money(decimal amount) => $"{plan.Currency} {CurrencyScale.Format(amount, plan.Currency)}";

            <li class="list-group-item">
                <div class="row g-0">
                    <div class="col-lg col-12 title d-flex align-items-center">
                        <div class="summary">
                            <div class="d-flex flex-column flex-md-row align-items-md-center">
                                <div class="me-2">
                                    <h5 class="mb-1 mb-md-0"><a asp-action="Detail" asp-route-itemId="@plan.ItemId">@plan.Title</a></h5>
                                </div>
                                <div class="tags me-1">
                                    <partial name="_InstallmentPlanStatusBadge" model="plan.Status" />
                                </div>
                            </div>
                            <div class="metadata mt-1">
                                <span class="badge ta-badge font-weight-normal" data-bs-toggle="tooltip" title="@T["Customer"]">
                                    <i class="fa-solid fa-user text-secondary" aria-hidden="true"></i><span class="visually-hidden">@T["Customer"]</span>
                                    @plan.CustomerName
                                </span>
                                <span class="badge ta-badge font-weight-normal" data-bs-toggle="tooltip" title="@T["Total"]">
                                    <i class="fa-solid fa-sack-dollar text-secondary" aria-hidden="true"></i><span class="visually-hidden">@T["Total"]</span>
                                    @Money(plan.TotalAmount)
                                </span>
                                <span class="badge ta-badge font-weight-normal" data-bs-toggle="tooltip" title="@T["Received"]">
                                    <i class="fa-solid fa-coins text-secondary" aria-hidden="true"></i><span class="visually-hidden">@T["Received"]</span>
                                    @Money(plan.AmountPaid)
                                </span>
                                @if (isOpen && plan.AmountOutstanding > 0m)
                                {
                                    <span class="badge ta-badge bg-warning-subtle font-weight-normal" data-bs-toggle="tooltip" title="@T["Outstanding"]">
                                        <i class="fa-solid fa-hourglass-half text-secondary" aria-hidden="true"></i><span class="visually-hidden">@T["Outstanding"]</span>
                                        @Money(plan.AmountOutstanding)
                                    </span>
                                }
                                @if (isOpen && next is not null)
                                {
                                    <span class="badge ta-badge bg-info-subtle font-weight-normal" data-bs-toggle="tooltip" title="@T["Next payment"]">
                                        <i class="fa-regular fa-calendar text-secondary" aria-hidden="true"></i><span class="visually-hidden">@T["Next payment"]</span>
                                        @T["{0} on {1:d}", Money(next.Amount), next.DueUtc]
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-auto col-12 d-flex justify-content-end align-items-center">
                        <div class="actions">
                            @if (plan.Status == InstallmentPlanStatus.Draft)
                            {
                                <a class="btn btn-primary btn-sm" asp-action="Pay" asp-route-itemId="@plan.ItemId">@T["Take down payment"]</a>
                            }
                            <a class="btn btn-secondary btn-sm" asp-action="Detail" asp-route-itemId="@plan.ItemId">@T["Manage"]</a>
                        </div>
                    </div>
                </div>
            </li>
        }
    }
    else
    {
        <li class="list-group-item">
            <div class="alert alert-info mb-0" role="alert">
                @T["<strong>Nothing here!</strong> There are no installment plans that match the current filter."]
            </div>
        </li>
    }
</ul>

@await DisplayAsync(Model.Pager)

<style asp-name="bootstrap-select"></style>
<script asp-name="commerce-admin-list" at="Foot"></script>
