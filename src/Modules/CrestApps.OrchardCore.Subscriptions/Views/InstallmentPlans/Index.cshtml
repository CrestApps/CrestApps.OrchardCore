@using CrestApps.OrchardCore.Payments
@using CrestApps.OrchardCore.Subscriptions.Models
@using CrestApps.OrchardCore.Subscriptions.ViewModels
@model InstallmentPlansIndexViewModel

<zone Name="Title">
    <breadcrumb name="SubscriptionsInstallmentPlans" title="@T["Installment Plans"]" />
</zone>

<form asp-action="Index" method="post" class="no-multisubmit">
    <input type="submit" name="submit.Filter" id="submitFilter" class="visually-hidden" />

    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-1">
                <div class="col">
                    <div class="has-search">
                        <i class="fa-solid fa-search form-control-feedback" aria-hidden="true"></i>
                        <input asp-for="Options.Search" class="form-control" placeholder="@T["Search by plan or customer"]" type="search" autocomplete="off" />
                    </div>
                </div>
                <div class="col-auto">
                    <select asp-for="Options.Status" asp-items="Model.Options.Statuses" class="form-select"></select>
                </div>
                <div class="col-auto">
                    <button type="submit" name="submit.Filter" class="btn btn-primary text-nowrap">
                        <i class="fa-solid fa-filter me-1" aria-hidden="true"></i>@T["Filter"]
                    </button>
                </div>
                <div class="col-auto">
                    <a asp-action="Create" class="btn btn-secondary text-nowrap">
                        <i class="fa-solid fa-plus me-1" aria-hidden="true"></i>@T["New plan"]
                    </a>
                </div>
            </div>
        </div>
    </div>
</form>

<ul class="list-group">
    @if (Model.Plans.Count > 0)
    {
        @foreach (var plan in Model.Plans)
        {
            var next = plan.NextPayment;
            string Money(decimal amount) => $"{plan.Currency} {CurrencyScale.Format(amount, plan.Currency)}";

            <li class="list-group-item">
                <div class="row g-0">
                    <div class="col-lg col-12 title d-flex align-items-center">
                        <div class="summary">
                            <div class="d-flex flex-column flex-md-row">
                                <div class="me-2">
                                    <h5 class="mb-0"><a asp-action="Detail" asp-route-itemId="@plan.ItemId">@plan.Title</a></h5>
                                </div>
                                <div class="metadata me-1">
                                    <partial name="_InstallmentPlanStatusBadge" model="plan.Status" />
                                </div>
                            </div>
                            <div class="text-muted small mt-1">
                                <span class="me-3" title="@T["Customer"]">
                                    <i class="fa-regular fa-user" aria-hidden="true"></i><span class="visually-hidden">@T["Customer"]</span>
                                    @plan.CustomerName
                                    @if (!string.IsNullOrEmpty(plan.CustomerEmail))
                                    {
                                        <span>&lt;@plan.CustomerEmail&gt;</span>
                                    }
                                </span>
                                <span class="me-3 text-nowrap" title="@T["Received of the total"]">
                                    <i class="fa-solid fa-coins" aria-hidden="true"></i><span class="visually-hidden">@T["Received of the total"]</span>
                                    @T["{0} of {1} received", Money(plan.AmountPaid), Money(plan.TotalAmount)]
                                </span>
                                @if (plan.AmountOutstanding > 0m && plan.Status != InstallmentPlanStatus.Canceled)
                                {
                                    <span class="me-3 text-nowrap" title="@T["Outstanding"]">
                                        <i class="fa-solid fa-hourglass-half" aria-hidden="true"></i><span class="visually-hidden">@T["Outstanding"]</span>
                                        @T["{0} outstanding", Money(plan.AmountOutstanding)]
                                    </span>
                                }
                                @if (next is not null && plan.Status is not (InstallmentPlanStatus.Canceled or InstallmentPlanStatus.Completed))
                                {
                                    <span class="text-nowrap" title="@T["Next payment"]">
                                        <i class="fa-regular fa-calendar" aria-hidden="true"></i><span class="visually-hidden">@T["Next payment"]</span>
                                        @T["Next: {0} on {1:d}", Money(next.Amount), next.DueUtc]
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-auto col-12 d-flex justify-content-end align-items-center">
                        <div class="actions">
                            @if (plan.Status == InstallmentPlanStatus.Draft)
                            {
                                <a class="btn btn-primary btn-sm" asp-action="Pay" asp-route-itemId="@plan.ItemId">
                                    <i class="fa-solid fa-credit-card" aria-hidden="true"></i>
                                    @T["Take down payment"]
                                </a>
                            }
                            <a class="btn btn-secondary btn-sm" asp-action="Detail" asp-route-itemId="@plan.ItemId">
                                <i class="fa-solid fa-eye" aria-hidden="true"></i>
                                @T["Manage"]
                            </a>
                        </div>
                    </div>
                </div>
            </li>
        }
    }
    else
    {
        <li class="list-group-item list-group-item-info text-center">
            @T["<strong>Nothing here!</strong> There are no installment plans that match the current filter."]
        </li>
    }
</ul>

@await DisplayAsync(Model.Pager)
