@using CrestApps.OrchardCore.Subscriptions.Models

@model ShapeViewModel<TenantProvisioningJob>

@* The list is rendered outside the page's filter form, so this form is not nested in another. *@
<form asp-action="Retry" asp-route-itemId="@Model.Value.ItemId" method="post" class="d-inline">
    <button type="submit" class="btn btn-secondary btn-sm"
            data-url-af="RemoveUrl"
            data-title="@T["Retry now"]"
            data-message="@T["Try to create the site {0} again now?", Model.Value.TenantName]"
            data-ok-text="@T["Retry now"]"
            data-cancel-text="@T["Cancel"]">
        @T["Retry now"]
    </button>
</form>
