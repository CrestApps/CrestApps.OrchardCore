@using CrestApps.OrchardCore.Subscriptions.Models

@model ShapeViewModel<CustomerSubscription>

<span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Access until"]">
    <i class="fa-regular fa-calendar text-secondary" aria-hidden="true"></i><span class="visually-hidden">@T["Access until"]</span>
    @if (Model.Value.IsCurrent)
    {
        @await DisplayAsync(await New.DateTime(Utc: Model.Value.Subscription.CurrentPeriodEndUtc, Format: "d"))
    }
    else
    {
        @T["Ended"]
    }
</span>
