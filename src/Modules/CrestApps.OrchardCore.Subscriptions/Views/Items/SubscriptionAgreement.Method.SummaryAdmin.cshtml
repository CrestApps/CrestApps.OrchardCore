@using CrestApps.OrchardCore.Subscriptions.Models
@using CrestApps.OrchardCore.Subscriptions.Services

@model ShapeViewModel<SubscriptionAgreement>
@inject SubscriptionDisplayText DisplayText

<span class="badge ta-badge bg-primary-subtle fw-normal" data-bs-toggle="tooltip" title="@T["Method"]">
    <i class="fa-solid fa-credit-card text-secondary" aria-hidden="true"></i><span class="visually-hidden">@T["Method"]</span>
    @(DisplayText.PaymentMethodName(Model.Value.Subscription.ProviderKey) ?? T["None"].Value)
</span>
