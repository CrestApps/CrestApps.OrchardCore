@using CrestApps.OrchardCore.Subscriptions.Models

@model ShapeViewModel<TenantProvisioningJob>

@if (!string.IsNullOrEmpty(Model.Value.LastError))
{
    @* An error can run to several sentences, so it is text that wraps, not a badge. *@
    <div class="admin-list-secondary text-danger">
        <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i><span class="visually-hidden">@T["Last error"]</span>
        @Model.Value.LastError
    </div>
}
