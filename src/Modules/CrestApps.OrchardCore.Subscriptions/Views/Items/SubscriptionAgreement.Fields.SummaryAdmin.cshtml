@using CrestApps.OrchardCore.Subscriptions.Models

@model ShapeViewModel<SubscriptionAgreement>

@* A plain link to the agreement's page, like the title of a content item in the Manage Content list. *@
<a asp-action="Detail" asp-route-itemId="@Model.Value.Subscription.ItemId">@(string.IsNullOrEmpty(Model.Value.Subscription.Title) ? T["(untitled)"].Value : Model.Value.Subscription.Title)</a>
