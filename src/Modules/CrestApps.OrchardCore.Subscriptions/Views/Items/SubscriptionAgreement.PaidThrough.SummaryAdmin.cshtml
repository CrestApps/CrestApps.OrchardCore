@using CrestApps.OrchardCore.Subscriptions.Models

@model ShapeViewModel<SubscriptionAgreement>

<span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Paid through"]">
    <i class="fa-regular fa-calendar text-secondary" aria-hidden="true"></i><span class="visually-hidden">@T["Paid through"]</span>
    @await DisplayAsync(await New.DateTime(Utc: Model.Value.Subscription.CurrentPeriodEndUtc, Format: "d"))
</span>
