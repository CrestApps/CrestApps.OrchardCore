@using CrestApps.OrchardCore.Subscriptions.Models
@using Microsoft.AspNetCore.Mvc.Localization

@model ShapeViewModel<TenantProvisioningJob>

<span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Attempts"]">
    <i class="fa-solid fa-rotate text-secondary" aria-hidden="true"></i><span class="visually-hidden">@T["Attempts"]</span>
    @T.Plural(Model.Value.AttemptCount, "1 attempt", "{0} attempts")
</span>
