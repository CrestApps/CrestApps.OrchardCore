@using CrestApps.OrchardCore.Subscriptions.Models

@model ShapeViewModel<TenantProvisioningJob>

<span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Bought"]">
    <i class="fa-regular fa-calendar text-secondary" aria-hidden="true"></i><span class="visually-hidden">@T["Bought"]</span>
    @await DisplayAsync(await New.DateTime(Utc: Model.Value.CreatedUtc, Format: "g"))
</span>
