@using CrestApps.OrchardCore.Subscriptions.ViewModels
@model TenantProvisioningStepViewModel

<div class="mb-3">
    <label asp-for="TenantName" class="form-label ocat-label-required">@T["Site name"]</label>
    <input asp-for="TenantName" class="form-control" autocomplete="off" />
    <span asp-validation-for="TenantName"></span>
    <span class="hint">@T["Letters, digits, and underscores. This name identifies your site and cannot be changed later."]</span>
</div>

<div class="mb-3">
    <label asp-for="TenantTitle" class="form-label">@T["Site title"]</label>
    <input asp-for="TenantTitle" class="form-control" />
    <span asp-validation-for="TenantTitle"></span>
    <span class="hint">@T["What visitors see. You can change this at any time."]</span>
</div>

@if (Model.AllowCustomPrefix || Model.AllowCustomDomains)
{
    <div class="row">
        @if (Model.AllowCustomPrefix)
        {
            <div class="col-md-6 mb-3">
                <label asp-for="Prefix" class="form-label">@T["URL prefix"]</label>
                <input asp-for="Prefix" class="form-control" autocomplete="off" />
                <span asp-validation-for="Prefix"></span>
                <span class="hint">@(Model.AllowCustomDomains ? T["Leave blank to use the site name, or to answer on your custom domain alone."] : T["Leave blank to use the site name."])</span>
            </div>
        }
        @if (Model.AllowCustomDomains)
        {
            <div class="col-md-6 mb-3">
                <label asp-for="Domains" class="form-label">@T["Custom domains"]</label>
                <input asp-for="Domains" class="form-control" autocomplete="off" placeholder="@T["example.com, www.example.com"]" />
                <span asp-validation-for="Domains"></span>
                <span class="hint">@T["Optional, separated by commas."]</span>
            </div>
        }
    </div>
}
else
{
    <span asp-validation-for="Prefix"></span>
    <span asp-validation-for="Domains"></span>
}

<hr />

<h5>@T["Site administrator"]</h5>
<p class="text-muted small">@T["These are the credentials you will sign in to your new site with."]</p>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="AdminUsername" class="form-label ocat-label-required">@T["User name"]</label>
        <input asp-for="AdminUsername" class="form-control" autocomplete="off" />
        <span asp-validation-for="AdminUsername"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="AdminEmail" class="form-label ocat-label-required">@T["Email"]</label>
        <input asp-for="AdminEmail" type="email" class="form-control" autocomplete="off" />
        <span asp-validation-for="AdminEmail"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="AdminPassword" class="form-label @(Model.HasPassword ? "" : "ocat-label-required")">@T["Password"]</label>
        <input asp-for="AdminPassword" type="password" class="form-control" autocomplete="new-password" data-1p-ignore data-lpignore="true" data-bwignore="true" />
        <span asp-validation-for="AdminPassword"></span>
        @if (Model.HasPassword)
        {
            <span class="hint">@T["Leave blank to keep the password you already entered."]</span>
        }
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="ConfirmPassword" class="form-label @(Model.HasPassword ? "" : "ocat-label-required")">@T["Confirm password"]</label>
        <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" data-1p-ignore data-lpignore="true" data-bwignore="true" />
        <span asp-validation-for="ConfirmPassword"></span>
    </div>
</div>
