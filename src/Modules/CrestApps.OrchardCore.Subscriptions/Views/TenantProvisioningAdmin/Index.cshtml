@using CrestApps.OrchardCore.Subscriptions.ViewModels
@model TenantProvisioningListViewModel

<zone Name="Title">
    <breadcrumb name="TenantProvisioningJobs" title="@T["Site provisioning"]" />
</zone>

<div class="alert alert-warning" role="alert">
    @T["A job marked <strong>Abandoned</strong> means a customer paid and did not get their site, and the site has stopped trying. Fix the cause so the next sale works, then create this site by hand under <strong>Tenants</strong> and mark the job as created, or refund the purchase."]
</div>

@* The filter renders in the list's toolbar, after this form, and names it with its form attribute. The list stays
   outside the form because its rows post forms of their own (Retry now, Mark as created). *@
<form asp-action="Index" method="get" id="provisioning-filter">
    @if (Context.Request.Query.TryGetValue("pageSize", out var selectedPageSize))
    {
        <input type="hidden" name="pageSize" value="@selectedPageSize" />
    }
</form>

@* The jobs, the toolbar with the filter and the pager are rendered by the AdminList shape, in the layout (List or Grid) the site or the user picked. *@
<admin-list name="TenantProvisioningJobs" context="Model.List" show-select-all="false"
            empty-message="@T["<strong>Nothing here!</strong> No sites match the current filter."]">
    <admin-list-list item-css-class="list-group-item" />
    <admin-list-grid>
        <admin-list-column name="Title" position="20" title="@T["Site"]" />
        <admin-list-column name="Status" position="30" title="@T["Status"]" width="auto" />
        <admin-list-column name="Owner" position="40" title="@T["Owner"]" width="auto" />
        <admin-list-column name="Bought" position="50" title="@T["Bought"]" width="auto" />
        <admin-list-column name="Attempts" position="60" title="@T["Attempts"]" width="auto" />
        <admin-list-column type="Actions" title="@T["Actions"]" />
    </admin-list-grid>
</admin-list>

<style asp-name="bootstrap-select"></style>
<script asp-name="commerce-admin-list" at="Foot"></script>
