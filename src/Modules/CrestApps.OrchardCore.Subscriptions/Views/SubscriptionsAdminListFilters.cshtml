@using CrestApps.OrchardCore.Subscriptions.Core.Models

@model ListSubscriptionOptions

<div class="d-flex gap-2 filter">
    <select asp-for="Status" asp-items="@Model.Statuses" class="form-select form-select-sm w-auto" title="@T["Filter by status"]" aria-label="@T["Filter by status"]">
        <option value="">@T["All"]</option>
    </select>
    <select asp-for="OrderBy" asp-items="@Model.Sorts" class="form-select form-select-sm w-auto" title="@T["Sort by"]" aria-label="@T["Sort by"]"></select>
</div>
