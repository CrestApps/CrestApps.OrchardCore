@using CrestApps.OrchardCore.Receipts.Models
@model ReceiptDocument

<style>
    @@media print {
        .no-print {
            display: none !important;
        }
    }
</style>

<div class="mb-3 no-print">
    <button type="button" class="btn btn-primary" onclick="window.print();">@T["Print receipt"]</button>
    <a class="btn btn-secondary" asp-controller="Dashboard" asp-action="Index">@T["Back"]</a>
</div>

<partial name="~/Areas/CrestApps.OrchardCore.Receipts/Views/ReceiptDocument.cshtml" model="Model" />
