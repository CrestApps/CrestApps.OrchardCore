@using CrestApps.OrchardCore.Subscriptions.ViewModels

@model SubscriptionOnboardingSettingsViewModel

<div class="ocat-wrapper" asp-validation-class-for="DatabaseProvider">
    <label asp-for="DatabaseProvider" class="ocat-label">@T["Database for new sites"]</label>
    <div class="ocat-end">
        <select asp-for="DatabaseProvider" asp-items="Model.DatabaseProviders" class="form-select">
            <option value="">@T["Sqlite (a file per site)"]</option>
        </select>
        <span asp-validation-for="DatabaseProvider"></span>
        <span class="hint">@T["Every site sold is created on this database. A site cannot be created without one, and the buyer never chooses it."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="ConnectionString">
    <label asp-for="ConnectionString" class="ocat-label">@T["Connection string"]</label>
    <div class="ocat-end">
        <input asp-for="ConnectionString" class="form-control" type="password" autocomplete="new-password" data-1p-ignore data-lpignore="true" data-bwignore="true" placeholder="@(Model.HasConnectionString ? T["A connection string is stored. Provide a new value to replace it."].Value : string.Empty)" />
        <span asp-validation-for="ConnectionString"></span>
        <span class="hint">@T["Required for every provider except Sqlite. It is stored encrypted and never shown again; leave it blank to keep the stored one. Each site gets its own table prefix, derived from its name."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <div class="ocat-end ocat-end-offset">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" asp-for="AllowCustomPrefix" />
            <label class="form-check-label" asp-for="AllowCustomPrefix">@T["Buyers may choose the URL prefix"]</label>
            <span class="hint dashed">@T["When off, a sold site answers on a prefix equal to its name."]</span>
        </div>
    </div>
</div>

<div class="ocat-wrapper">
    <div class="ocat-end ocat-end-offset">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" asp-for="AllowCustomDomains" />
            <label class="form-check-label" asp-for="AllowCustomDomains">@T["Buyers may use their own domains"]</label>
            <span class="hint dashed">@T["Only turn this on if you check who controls a domain: a site answers every request to the domains it names."]</span>
        </div>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="ReservedPrefixes">
    <label asp-for="ReservedPrefixes" class="ocat-label">@T["Reserved prefixes"]</label>
    <div class="ocat-end">
        <input asp-for="ReservedPrefixes" class="form-control" />
        <span asp-validation-for="ReservedPrefixes"></span>
        <span class="hint">@T["URL prefixes no sold site may take, separated by commas. The admin prefix is always reserved."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="ReservedHosts">
    <label asp-for="ReservedHosts" class="ocat-label">@T["Reserved host names"]</label>
    <div class="ocat-end">
        <input asp-for="ReservedHosts" class="form-control" />
        <span asp-validation-for="ReservedHosts"></span>
        <span class="hint">@T["Your own domains, separated by commas: no sold site may take them or any name under them (operator.com covers www.operator.com). This site's base URL host and the host a buyer checks out on are always reserved. Required before buyers may use domains of their own."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="BaseDomain">
    <label asp-for="BaseDomain" class="ocat-label">@T["Base domain"]</label>
    <div class="ocat-end">
        <input asp-for="BaseDomain" class="form-control" placeholder="sites.example.com" />
        <span asp-validation-for="BaseDomain"></span>
        <span class="hint">@T["Optional. Each sold site answers on its own host, the site name followed by this domain, instead of a prefix. Point a wildcard DNS record at this site first."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="Schema">
    <label asp-for="Schema" class="ocat-label">@T["Schema"]</label>
    <div class="ocat-end">
        <input asp-for="Schema" class="form-control" />
        <span asp-validation-for="Schema"></span>
        <span class="hint">@T["Optional. Leave blank to use the provider's default."]</span>
    </div>
</div>
