@using CrestApps.OrchardCore.Subscriptions.ViewModels

@model SubscriptionOnboardingSettingsViewModel

<div class="ocat-wrapper" asp-validation-class-for="DatabaseProvider">
    <label asp-for="DatabaseProvider" class="ocat-label">@T["Database for new sites"]</label>
    <div class="ocat-end">
        <select asp-for="DatabaseProvider" asp-items="Model.DatabaseProviders" class="form-select">
            <option value="">@T["Sqlite (a file per site)"]</option>
        </select>
        <span asp-validation-for="DatabaseProvider"></span>
        <span class="hint">@T["Every site sold is created on this database. A site cannot be created without one, and the buyer never chooses it."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="ConnectionString">
    <label asp-for="ConnectionString" class="ocat-label">@T["Connection string"]</label>
    <div class="ocat-end">
        <input asp-for="ConnectionString" class="form-control" type="password" autocomplete="new-password" placeholder="@(Model.HasConnectionString ? T["A connection string is stored. Provide a new value to replace it."].Value : string.Empty)" />
        <span asp-validation-for="ConnectionString"></span>
        <span class="hint">@T["Required for every provider except Sqlite. It is stored encrypted and never shown again; leave it blank to keep the stored one. Each site gets its own table prefix, derived from its name."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="Schema">
    <label asp-for="Schema" class="ocat-label">@T["Schema"]</label>
    <div class="ocat-end">
        <input asp-for="Schema" class="form-control" />
        <span asp-validation-for="Schema"></span>
        <span class="hint">@T["Optional. Leave blank to use the provider's default."]</span>
    </div>
</div>
