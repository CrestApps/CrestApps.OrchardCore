@using CrestApps.OrchardCore.AI.A2A.ViewModels

@model EditProfileA2AConnectionsViewModel

@if (Model.A2AConnections is not null && Model.A2AConnections.Length > 0)
{
    <div class="ocat-wrapper">
        <div class="ocat-label">@T["A2A Connections"]</div>
        <div class="ocat-end">
            @for (var i = 0; i < Model.A2AConnections.Length; i++)
            {
                <div class="form-check">
                    <input type="hidden" asp-for="A2AConnections[i].ItemId" />
                    <input asp-for="A2AConnections[i].IsSelected" type="checkbox" class="form-check-input">
                    <label class="form-check-label" asp-for="A2AConnections[i].IsSelected">@Model.A2AConnections[i].DisplayText</label>
                </div>
            }
        </div>
    </div>
}
