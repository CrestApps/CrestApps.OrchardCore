@using CrestApps.OrchardCore.Omnichannel.Core
@using CrestApps.OrchardCore.Omnichannel.Core.Models
@using CrestApps.OrchardCore.Omnichannel.Managements.ViewModels

@model OmnichannelSubjectPartSettingsViewModel

<div class="ocat-wrapper" asp-validation-class-for="DefaultCampaignId">
    <label asp-for="DefaultCampaignId" class="ocat-label">@T["Default campaign"]</label>
    <div class="ocat-end">
        <select asp-for="DefaultCampaignId" asp-items="Model.Campaigns" class="form-select">
            <option value="">@T["Select a campaign"]</option>
        </select>
        <span asp-validation-for="DefaultCampaignId" class="text-danger"></span>
        <span class="hint">@T["The campaign applied to activities of this subject that are created outside an activity batch, such as manually created activities, inbound activities, and activities moved to this subject. Activity loads pre-select it and can override it when activities are loaded. Campaigns are used for grouping and reporting only."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="Direction">
    <label asp-for="Direction" class="ocat-label">@T["Direction"]</label>
    <div class="ocat-end">
        <select asp-for="Direction" asp-items="Model.Directions" class="form-select" data-omnichannel-subject-direction></select>
        <span asp-validation-for="Direction" class="text-danger"></span>
        <span class="hint">@T["Whether this subject is primarily contacted proactively (outbound) or engaged in response to an incoming contact (inbound). Outbound activities choose their channel and endpoint when an activity batch is loaded."]</span>
    </div>
</div>

<div class="subject-inbound-only@(Model.Direction == SubjectDirection.Inbound ? string.Empty : " d-none")">
    <div class="ocat-wrapper" asp-validation-class-for="InteractionType">
        <label asp-for="InteractionType" class="ocat-label">@T["Interaction type"]</label>
        <div class="ocat-end">
            <select asp-for="InteractionType" asp-items="Model.InteractionTypes" class="form-select" data-omnichannel-subject-interaction-type></select>
            <span asp-validation-for="InteractionType" class="text-danger"></span>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="Channel">
        <label asp-for="Channel" class="ocat-label">@T["Channel"]</label>
        <div class="ocat-end">
            <select asp-for="Channel" asp-items="Model.Channels" class="form-select" data-omnichannel-subject-channel>
                <option value="">@T["Select a channel"]</option>
            </select>
            <span asp-validation-for="Channel" class="text-danger"></span>
        </div>
    </div>

    <div class="ocat-wrapper subject-inbound-automated-only@(Model.Direction == SubjectDirection.Inbound && Model.InteractionType == ActivityInteractionType.Automated ? string.Empty : " d-none")" asp-validation-class-for="ChannelEndpointId">
        <label asp-for="ChannelEndpointId" class="ocat-label">@T["Address"]</label>
        <div class="ocat-end">
            <select asp-for="ChannelEndpointId" asp-items="Model.ChannelEndpoints" class="form-select">
                <option value="">@T["Select an address"]</option>
            </select>
            <span asp-validation-for="ChannelEndpointId" class="text-danger"></span>
            <span class="hint">@T["Specifies the endpoint to use when sending a response to the incoming message."]</span>
        </div>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="RequireDisposition">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input asp-for="RequireDisposition" class="form-check-input" />
            <label asp-for="RequireDisposition" class="form-check-label">@T["Require a disposition"]</label>
            <span class="hint dashed">@T["Recommended. An activity using this subject cannot be completed until a disposition is selected, and that disposition is what triggers the subject flow actions such as retrying, creating a follow-up activity, or updating communication preferences. Clear this only for fire-and-forget notification subjects, such as a one-way SMS alert, where the contact never responds and there is no outcome to record."]</span>
        </div>
    </div>
</div>

<script at="Foot">
(() => {
    const directionSelect = document.querySelector('[data-omnichannel-subject-direction]');

    if (!directionSelect) {
        return;
    }

    const interactionTypeSelect = document.querySelector('[data-omnichannel-subject-interaction-type]');
    const channelSelect = document.querySelector('[data-omnichannel-subject-channel]');

    const toggle = (selector, visible) => {
        document.querySelectorAll(selector).forEach((element) => {
            element.classList.toggle('d-none', !visible);
        });
    };

    const refresh = () => {
        const isInbound = directionSelect.value === '@nameof(SubjectDirection.Inbound)';
        const isOutbound = directionSelect.value === '@nameof(SubjectDirection.Outbound)';
        const isInboundAutomated = isInbound && interactionTypeSelect && interactionTypeSelect.value === '@nameof(ActivityInteractionType.Automated)';
        const channel = isInbound && channelSelect ? channelSelect.value : '';

        // AI configuration only applies to an inbound subject running an automated interaction. Outbound AI is
        // configured when the inventory is loaded, so the section stays hidden for outbound subjects.
        const canAutomate = isInboundAutomated;

        // Live agent handoff applies to any automated conversation: an inbound automated subject, or any outbound
        // subject (whose AI settings are chosen at inventory load). This mirrors ShowHandoffSettings in
        // OmnichannelSubjectAISettingsDisplayDriver so the card follows the selection before the settings are saved.
        const showHandoff = canAutomate || isOutbound;

        toggle('.subject-inbound-only', isInbound);
        toggle('.subject-inbound-automated-only', isInboundAutomated);
        toggle('.subject-ai-settings', canAutomate);
        toggle('.subject-ai-handoff', showHandoff);
        toggle('.subject-ai-voice-only', canAutomate && channel === '@OmnichannelConstants.Channels.Phone');
        toggle('.subject-ai-sms-only', canAutomate && channel === '@OmnichannelConstants.Channels.Sms');
    };

    [directionSelect, interactionTypeSelect, channelSelect].forEach((element) => {
        if (element) {
            element.addEventListener('change', refresh);
        }
    });

    refresh();
})();
</script>
