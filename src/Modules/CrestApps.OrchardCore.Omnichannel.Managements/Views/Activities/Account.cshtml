@using CrestApps.OrchardCore.Omnichannel.Managements.Services
@using CrestApps.OrchardCore.Omnichannel.Managements.ViewModels
@using OrchardCore.Contents
@using OrchardCore.Lists.ViewModels

@model ListAccountActivitiesViewModel

@inject ContactListPartNavigationResolver ListPartNavigationResolver

@{
    var listPartNavigation = await ListPartNavigationResolver.ResolveAsync(Model.Account);
}

<zone Name="Title">
    <breadcrumb name="OmnichannelAccountActivities" title="@T["Activities"]">
        <breadcrumb-item id="OmnichannelAccount" action="Edit" controller="Admin" area="OrchardCore.Contents" route-contentItemId="@Model.Account.ContentItemId" permission="@CommonPermissions.EditContent.Name" resource="@Model.Account">@Model.Account.DisplayText</breadcrumb-item>
    </breadcrumb>
</zone>

@if (listPartNavigation is not null)
{
    if (listPartNavigation.ShowHeader)
    {
        @await DisplayAsync(await Factory.CreateAsync<ListPartHeaderAdminViewModel>("ListPartHeaderAdmin", header =>
        {
            header.ContainerContentItem = Model.Account;
            header.ContainedContentTypeDefinitions = listPartNavigation.ContainedContentTypeDefinitions;
            header.EnableOrdering = listPartNavigation.EnableOrdering;
        }))
    }

    @await DisplayAsync(await Factory.CreateAsync<ListPartNavigationAdminViewModel>("ListPartNavigationAdmin", navigation =>
    {
        navigation.Container = Model.Account;
        navigation.ContainerContentTypeDefinition = listPartNavigation.ContactTypeDefinition;
        navigation.ContainedContentTypeDefinitions = listPartNavigation.ContainedContentTypeDefinitions;
        navigation.EnableOrdering = listPartNavigation.EnableOrdering;
    }))
}

<p class="text-muted">@T["The activities of every contact in {0}.", Model.Account.DisplayText]</p>

@* Each list, its toolbar and its pager are rendered by the AdminList shape, in the layout (List or Grid) the site or the user picked for it. *@
<div class="card text-bg-theme mb-3">
    <div class="card-header">
        @T["Scheduled Activities"]
    </div>
    <div class="card-body">
        <admin-list name="OmnichannelAccountScheduledActivities" context="Model.ScheduledList"
                    show-select-all="false"
                    empty-message="@T["No scheduled activities."]">
            <admin-list-list item-css-class="list-group-item" />
            <admin-list-grid>
                <admin-list-column name="Subject" position="20" title="@T["Subject"]" />
                <admin-list-column name="Contact" position="25" title="@T["Contact"]" width="auto" />
                <admin-list-column name="Details" position="30" title="@T["Details"]" />
                <admin-list-column name="Handler" position="40" title="@T["Handled by"]" width="auto" />
                <admin-list-column type="Actions" title="@T["Actions"]" />
            </admin-list-grid>
        </admin-list>
    </div>
</div>

<div class="card text-bg-theme mb-3">
    <div class="card-header">
        @T["Completed Activities"]
    </div>
    <div class="card-body">
        <admin-list name="OmnichannelAccountCompletedActivities" context="Model.CompletedList"
                    show-select-all="false"
                    empty-message="@T["No completed activities."]">
            <admin-list-list item-css-class="list-group-item" />
            <admin-list-grid>
                <admin-list-column name="Subject" position="20" title="@T["Subject"]" />
                <admin-list-column name="Contact" position="25" title="@T["Contact"]" width="auto" />
                <admin-list-column name="Details" position="30" title="@T["Details"]" />
                <admin-list-column name="Handler" position="40" title="@T["Completed by"]" width="auto" />
                <admin-list-column type="Actions" title="@T["Actions"]" />
            </admin-list-grid>
        </admin-list>
    </div>
</div>
