@using CrestApps.OrchardCore.Omnichannel.Core
@using CrestApps.OrchardCore.Omnichannel.Managements.ViewModels
@using OrchardCore.ContentManagement
@using OrchardCore.Contents

@{
    var contact = Model.ContactContentItem as ContentItem;
}

<zone Name="Title">
    <breadcrumb name="OmnichannelActivitiesEdit" title="@T["Edit Activity"]">
        @if (contact is not null)
        {
            <breadcrumb-item id="OmnichannelContact" action="Edit" controller="Admin" area="OrchardCore.Contents" route-contentItemId="@contact.ContentItemId" permission="@CommonPermissions.EditContent.Name" resource="@contact">@contact.DisplayText</breadcrumb-item>
            <breadcrumb-item id="OmnichannelContactActivities" action="List" controller="Activities" area="CrestApps.OrchardCore.Omnichannel.Managements" route-contentItemId="@contact.ContentItemId" permission="@OmnichannelConstants.Permissions.ListContactActivities.Name" resource="@contact">@T["Activities"]</breadcrumb-item>
        }
    </breadcrumb>
</zone>

@{
    var activityId = ViewContext.HttpContext.Request.RouteValues["id"];
}

@{
    var shape = new ContactNavigationAdminShapeViewModel
    {
        ContactContentItem = Model.ContactContentItem,
        ShowEdit = true,
    };
}

@await DisplayAsync(shape)

<form method="post" asp-action="Edit" asp-route-id="@activityId" enctype="multipart/form-data" class="no-multisubmit">
    @Html.ValidationSummary()

    <div class="card mb-3">
        <div class="card-header">
            @T["Subject"]
        </div>
        <div class="card-body">
            @await DisplayAsync(Model.Subject)
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">
            @T["Activity"]
        </div>
        <div class="card-body">
            @await DisplayAsync(Model.Activity)
        </div>
    </div>

    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <button class="btn btn-primary" type="submit">@T["Save"]</button>
            <a class="btn btn-secondary cancel" role="button" asp-route-action="List" asp-route-contentItemId="@Model.ContactContentItem.ContentItemId">@T["Cancel"]</a>
        </div>
    </div>
</form>
