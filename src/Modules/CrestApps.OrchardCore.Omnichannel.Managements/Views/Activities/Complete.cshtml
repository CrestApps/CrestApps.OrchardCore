@using CrestApps.OrchardCore.Omnichannel.Core
@using CrestApps.OrchardCore.Omnichannel.Managements.ViewModels
@using OrchardCore.ContentManagement
@using OrchardCore.Contents

@{
    var activityId = ViewContext.HttpContext.Request.RouteValues["id"];
    var contactContentItem = Model.ContactContentItem as ContentItem;
}

<zone Name="Title">
    <breadcrumb name="OmnichannelActivitiesComplete" title="@T["Complete Activity"]">
        @if (contactContentItem is not null)
        {
            <breadcrumb-item id="OmnichannelContact" action="Edit" controller="Admin" area="OrchardCore.Contents" route-contentItemId="@contactContentItem.ContentItemId" permission="@CommonPermissions.EditContent.Name" resource="@contactContentItem">@contactContentItem.DisplayText</breadcrumb-item>
            <breadcrumb-item id="OmnichannelContactActivities" action="List" controller="Activities" area="CrestApps.OrchardCore.Omnichannel.Managements" route-contentItemId="@contactContentItem.ContentItemId" permission="@OmnichannelConstants.Permissions.ListContactActivities.Name" resource="@contactContentItem">@T["Activities"]</breadcrumb-item>
        }
    </breadcrumb>
</zone>

@if (contactContentItem is not null)
{
    var shape = new ContactNavigationAdminShapeViewModel
    {
        ContactContentItem = contactContentItem,
        ShowEdit = true,
    };

    @await DisplayAsync(shape)
}

<form method="post" asp-action="Complete" asp-route-id="@activityId" asp-route-returnUrl="@Model.ReturnUrl" enctype="multipart/form-data" class="no-multisubmit"
      data-keep-alive-url="@Url.Action("KeepAlive", "Activities", new { area = "CrestApps.OrchardCore.Omnichannel.Managements", id = activityId })">
    @Html.ValidationSummary()
    @await DisplayAsync(Model)

    <div class="action-bar-bottom">
        <button class="btn btn-primary" type="submit">@T["Complete"]</button>
        @if (!string.IsNullOrEmpty(Model.ReturnUrl))
        {
            <a class="btn btn-secondary cancel" role="button" href="@Model.ReturnUrl">@T["Cancel"]</a>
        }
        else if (contactContentItem is null)
        {
            <a class="btn btn-secondary cancel" role="button" asp-action="Activities">@T["Cancel"]</a>
        }
        else
        {
            <a class="btn btn-secondary cancel" role="button" asp-action="List" asp-route-contentItemId="@contactContentItem.ContentItemId">@T["Cancel"]</a>
        }
    </div>
</form>

<script at="Foot">
    // A preview record is offered to the agent for a limited time. While this screen is open the agent is still working
    // on it, so the offer is kept with them instead of running out and going to someone else mid-disposition.
    (() => {
        const form = document.querySelector('form[data-keep-alive-url]');
        const url = form?.dataset.keepAliveUrl;
        const token = form?.querySelector('input[name="__RequestVerificationToken"]')?.value;

        if (!url || !token) {
            return;
        }

        const intervalMilliseconds = 60000;
        let timer = null;

        const ping = () => {
            const body = new FormData();
            body.append('__RequestVerificationToken', token);

            fetch(url, { method: 'POST', body: body, credentials: 'same-origin', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(response => response.ok ? response.json() : null)
                .then(data => {
                    // Nothing held for this agent any more: stop asking. Completing still says why.
                    if (data && data.held === false && timer) {
                        window.clearInterval(timer);
                        timer = null;
                    }
                })
                .catch(() => { /* the next ping tries again */ });
        };

        timer = window.setInterval(ping, intervalMilliseconds);
    })();
</script>
