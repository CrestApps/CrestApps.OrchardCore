@using CrestApps.OrchardCore.Omnichannel.Managements.ViewModels
@using OrchardCore.ContentManagement
<zone Name="Title">
    <h1>@RenderTitleSegments(T["New Activity"])</h1>
</zone>

@{
    var contentItemId = ViewContext.HttpContext.Request.RouteValues["id"] ?? ViewContext.HttpContext.Request.RouteValues["contentItemId"];
    var hasOutboundSubjects = ViewData["HasOutboundSubjects"] as bool? ?? true;

    var shape = new ContactNavigationAdminShapeViewModel
    {
        ContactContentItem = ViewData["Contact"] as ContentItem,
        ShowEdit = true,
    };
}

@await DisplayAsync(shape)

@if (!hasOutboundSubjects)
{
    <div class="alert alert-warning">
        @T["There is no configured outbound subject yet. You can't create a scheduled activity until an outbound subject flow is configured."]
    </div>

    <a class="btn btn-secondary" asp-action="List" asp-route-contentItemId="@contentItemId">@T["Back to activities"]</a>

    return;
}

<form method="post" asp-route-contentItemId="@contentItemId" enctype="multipart/form-data" class="no-multisubmit">
    @Html.ValidationSummary()
    @await DisplayAsync(Model.Content)

    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <button class="btn btn-primary" type="submit">@T["Save"]</button>
            <a class="btn btn-secondary cancel" role="button" asp-route-action="List" asp-route-contentItemId="@contentItemId">@T["Cancel"]</a>
        </div>
    </div>
</form>
