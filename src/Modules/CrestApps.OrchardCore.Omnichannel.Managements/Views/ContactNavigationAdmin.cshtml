@using OrchardCore.ContentManagement
@using CrestApps.OrchardCore.Omnichannel.Core.Models
@using Microsoft.Extensions.Options
@using OrchardCore.Lists.Models
@using CrestApps.OrchardCore.Omnichannel.Core
@using CrestApps.OrchardCore.Omnichannel.Managements.Services
@using CrestApps.OrchardCore.Omnichannel.Managements.ViewModels
@using Microsoft.AspNetCore.Authorization
@using OrchardCore.ContentManagement.Metadata
@using OrchardCore.Contents
@using OrchardCore.Lists.ViewModels

@model ContactNavigationAdminShapeViewModel

@inject IOptions<OmnichannelCrmOptions> CrmOptions
@inject CrestApps.OrchardCore.Omnichannel.Managements.Services.OmnichannelContentTypeProvider CrmContentTypes
@inject IAuthorizationService AuthorizationService
@inject IContentDefinitionManager ContentDefinitionManager
@inject ContactListPartNavigationResolver ListPartNavigationResolver
@{
    if (Model.ContactContentItem is null)
    {
        return;
    }

    // A contact that is also a list shows the list part's header and bar on its content pages. The contact's own
    // pages, such as the activity list and editor, show the same ones so the contact looks the same everywhere.
    // The bar's contact alternate carries the activity buttons.
    var listPartNavigation = await ListPartNavigationResolver.ResolveAsync(Model.ContactContentItem, Model.Definition);

    if (listPartNavigation is not null)
    {
        if (listPartNavigation.ShowHeader)
        {
            @await DisplayAsync(await Factory.CreateAsync<ListPartHeaderAdminViewModel>("ListPartHeaderAdmin", header =>
            {
                header.ContainerContentItem = Model.ContactContentItem;
                header.ContainedContentTypeDefinitions = listPartNavigation.ContainedContentTypeDefinitions;
                header.EnableOrdering = listPartNavigation.EnableOrdering;
            }))
        }

        @await DisplayAsync(await Factory.CreateAsync<ListPartNavigationAdminViewModel>("ListPartNavigationAdmin", navigation =>
        {
            navigation.Container = Model.ContactContentItem;
            navigation.ContainerContentTypeDefinition = listPartNavigation.ContactTypeDefinition;
            navigation.ContainedContentTypeDefinitions = listPartNavigation.ContainedContentTypeDefinitions;
            navigation.EnableOrdering = listPartNavigation.EnableOrdering;
        }))

        return;
    }
}

<div class="card text-bg-theme text-right mb-3 second-action-bar">
    <div class="card-body">
        <div class="d-flex justify-content-end">

            @if (CrmOptions.Value.Enabled &&
                Model.ContactContentItem.TryGet<LeadPart>(out var leadPart) &&
                !leadPart.IsConverted &&
                await AuthorizationService.AuthorizeAsync(User, OmnichannelConstants.Permissions.ConvertLead, Model.ContactContentItem))
            {
                <a class="btn btn-success me-1" asp-action="Convert" asp-controller="Leads" asp-route-contentItemId="@Model.ContactContentItem.ContentItemId" asp-route-area="@OmnichannelConstants.Features.Managements">@T["Convert Lead"]</a>
            }

            @if (CrmOptions.Value.Enabled &&
                Model.ContactContentItem.TryGet<ContainedPart>(out var containedPart) &&
                !string.IsNullOrEmpty(containedPart.ListContentItemId) &&
                (await CrmContentTypes.GetAccountContentTypesAsync()).Contains(containedPart.ListContentType))
            {
                <a class="btn btn-secondary me-1" asp-action="Display" asp-controller="Admin" asp-route-contentItemId="@containedPart.ListContentItemId" asp-route-area="OrchardCore.Contents">@T["View Account"]</a>
            }

            @if (await AuthorizationService.AuthorizeAsync(User, OmnichannelConstants.Permissions.ListContactActivities, Model.ContactContentItem))
            {
                <a class="btn btn-secondary me-1" asp-action="List" asp-controller="Activities" asp-route-contentItemId="@Model.ContactContentItem.ContentItemId" asp-route-area="@OmnichannelConstants.Features.Managements">@T["List Activities"]</a>
            }

            @if (Model.ShowEdit && await AuthorizationService.AuthorizeAsync(User, CommonPermissions.EditContent, Model.ContactContentItem))
            {
                var defintion = Model.Definition ?? await ContentDefinitionManager.GetTypeDefinitionAsync(Model.ContactContentItem.ContentType);

                <a class="btn btn-primary me-1" asp-action="Edit" asp-controller="Admin" asp-route-contentItemId="@Model.ContactContentItem.ContentItemId" asp-route-area="OrchardCore.Contents">
                    @T["Edit {0}", defintion?.DisplayName]
                </a>
            }

            @if (!(Model.ContactContentItem.TryGet<LeadPart>(out var addActivityLead) && addActivityLead.IsConverted) &&
                await AuthorizationService.AuthorizeAsync(User, OmnichannelConstants.Permissions.EditActivity))
            {
                <div class="btn-group me-1">
                    <button type="button" class="btn btn-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                        @T["Add Activity"]
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <a class="dropdown-item" asp-action="Create" asp-controller="Activities" asp-route-contentItemId="@Model.ContactContentItem.ContentItemId" asp-route-area="@OmnichannelConstants.Features.Managements">@T["Outbound"]</a>
                        </li>
                        <li>
                            <a class="dropdown-item" asp-action="CreateInbound" asp-controller="Activities" asp-route-contentItemId="@Model.ContactContentItem.ContentItemId" asp-route-area="@OmnichannelConstants.Features.Managements">@T["Inbound"]</a>
                        </li>
                    </ul>
                </div>
            }

        </div>
    </div>
</div>
