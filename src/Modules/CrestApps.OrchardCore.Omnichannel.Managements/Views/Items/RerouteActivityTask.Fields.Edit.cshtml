@using CrestApps.OrchardCore.Omnichannel.Managements.Models
@using CrestApps.OrchardCore.Omnichannel.Managements.Workflows.ViewModels

@model RerouteActivityTaskViewModel

<div class="ocat-wrapper" asp-validation-class-for="ActivityItemId">
    <label class="ocat-label ocat-label-required" asp-for="ActivityItemId">@T["Activity"]</label>
    <div class="ocat-end">
        <input class="form-control" asp-for="ActivityItemId" />
        <span asp-validation-for="ActivityItemId"></span>
        <span class="hint">@T["A Liquid expression resolving the activity. The default is the activity a Contact Center event is about, such as Activity disposition applied. When the activity is finished, its open follow-ups are rerouted instead."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <label class="ocat-label" asp-for="Target">@T["Next call by"]</label>
    <div class="ocat-end">
        <select class="form-select" asp-for="Target" data-reroute-target>
            <option value="@ActivityRerouteTarget.Agent">@T["An agent (manual call): take it off the dialer"]</option>
            <option value="@ActivityRerouteTarget.Dialer">@T["The dialer, under a dialer profile"]</option>
            <option value="@ActivityRerouteTarget.KeepRoute">@T["Same as before; only change the campaign"]</option>
        </select>
        <span class="hint">@T["An activity moved to an agent is taken out of the dialer queue, and the dialer does not call it again."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="CampaignId">
    <label class="ocat-label" asp-for="CampaignId">@T["Campaign"]</label>
    <div class="ocat-end">
        <select class="form-select" asp-for="CampaignId" asp-items="Model.Campaigns"></select>
        <span asp-validation-for="CampaignId"></span>
        <span class="hint">@T["The dialer queues an activity on its campaign, so an activity sent to the dialer needs one."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="DialerProfileId" data-reroute-show="@ActivityRerouteTarget.Dialer">
    <label class="ocat-label ocat-label-required" asp-for="DialerProfileId">@T["Dialer profile"]</label>
    <div class="ocat-end">
        <select class="form-select" asp-for="DialerProfileId" asp-items="Model.DialerProfiles"></select>
        <span asp-validation-for="DialerProfileId"></span>
        <span class="hint">@T["The dialer offers the activity to whichever agent signed in to the campaign is free, so it has no owner of its own."]</span>
    </div>
</div>

<div class="ocat-wrapper" data-reroute-show="@ActivityRerouteTarget.Agent">
    <label class="ocat-label" asp-for="Source">@T["Source"]</label>
    <div class="ocat-end">
        <select class="form-select" asp-for="Source" asp-items="Model.Sources"></select>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="UserName" data-reroute-show="@ActivityRerouteTarget.Agent">
    <label class="ocat-label" asp-for="UserName">@T["Agent"]</label>
    <div class="ocat-end">
        <input class="form-control" asp-for="UserName" />
        <span asp-validation-for="UserName"></span>
        <span class="hint">@T["A Liquid expression resolving the user name of the agent who makes the call, such as {0} for the agent the dialer called for. Empty keeps the owner the activity has.", "{{ Workflow.Input.AgentUserName }}"]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" asp-for="CreateNextAttempt" />
            <label class="form-check-label" asp-for="CreateNextAttempt">@T["Create the next call when none is waiting"]</label>
            <span class="hint dashed">@T["A finished activity with no open follow-up gets its next attempt, already rerouted. Without it, the task takes Nothing To Reroute."]</span>
        </div>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="DelayMinutes">
    <label class="ocat-label" asp-for="DelayMinutes">@T["Delay in minutes"]</label>
    <div class="ocat-end">
        <input class="form-control" asp-for="DelayMinutes" />
        <span asp-validation-for="DelayMinutes"></span>
        <span class="hint">@T["Optional. A Liquid expression resolving how many minutes from now a created next call is due. Empty is due now."]</span>
    </div>
</div>

<p class="text-muted small">@T["A record the dialer is dialing, or an agent is on a call for, is left as it is. The ids of the rerouted activities are written to {0}.", "Workflow.Output.ReroutedActivityItemIds"]</p>

<script at="Foot">
    (function () {
        const target = document.querySelector('[data-reroute-target]');

        if (!target) {
            return;
        }

        const toggle = () => {
            document.querySelectorAll('[data-reroute-show]').forEach(element => {
                element.classList.toggle('d-none', element.getAttribute('data-reroute-show') !== target.value);
            });
        };

        target.addEventListener('change', toggle);
        toggle();
    })();
</script>
