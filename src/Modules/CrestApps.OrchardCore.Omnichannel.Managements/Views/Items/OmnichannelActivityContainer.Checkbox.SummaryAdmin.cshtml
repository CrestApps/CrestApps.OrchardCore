@using CrestApps.OrchardCore.Omnichannel.Core.Models
@using OrchardCore.DisplayManagement.Views

@model ShapeViewModel<OmnichannelActivityContainer>

<div class="form-check">
    <input type="checkbox" class="form-check-input" value="@Model.Value.Activity.ItemId" name="itemIds" id="itemIds-@Model.Value.Activity.ItemId">
    <label class="form-check-label" for="itemIds-@Model.Value.Activity.ItemId">&nbsp;</label>
</div>
