@using CrestApps.OrchardCore.Omnichannel.Core.Models
@using OrchardCore.DisplayManagement.Views

@model ShapeViewModel<LeadStatus>

<h5>@Model.Value.Name</h5>
<div class="d-flex flex-wrap gap-1">
    @if (Model.Value.IsDefault)
    {
        <span class="badge text-bg-secondary">@T["Default"]</span>
    }
    @if (Model.Value.IsClosed)
    {
        <span class="badge text-bg-secondary">@T["Closed"]</span>
    }
    @if (Model.Value.IsConverted)
    {
        <span class="badge text-bg-secondary">@T["Converted"]</span>
    }
</div>
@if (!string.IsNullOrEmpty(Model.Value.Description))
{
    <div class="text-muted small">@Model.Value.Description</div>
}
