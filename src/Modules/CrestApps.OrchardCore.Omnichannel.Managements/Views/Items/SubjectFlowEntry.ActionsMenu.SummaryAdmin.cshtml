@using CrestApps.OrchardCore.Omnichannel.Core
@using CrestApps.OrchardCore.Omnichannel.Managements.Models
@using OrchardCore.DisplayManagement.Views

@model ShapeViewModel<SubjectFlowEntry>

<a class="dropdown-item"
   href="@Url.Action("Edit", "Admin", new { area = "OrchardCore.ContentTypes", id = Model.Value.ContentTypeName })">@T["Edit Content Type"]</a>
<a class="dropdown-item"
   href="@Url.Action("EditTypePart", "Admin", new { area = "OrchardCore.ContentTypes", id = Model.Value.ContentTypeName, name = OmnichannelConstants.ContentParts.OmnichannelSubject })">@T["Edit Settings"]</a>
