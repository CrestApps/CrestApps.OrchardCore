@using CrestApps.OrchardCore.Omnichannel.Core
@using CrestApps.OrchardCore.Omnichannel.Core.Models
@using Microsoft.AspNetCore.Authorization
@using OrchardCore.DisplayManagement.Views

@inject IAuthorizationService AuthorizationService

@model ShapeViewModel<OmnichannelActivityBatch>

@if (Model.Value.Status == OmnichannelActivityBatchStatus.New)
{
    <a asp-action="Edit"
       asp-route-id="@Model.Value.ItemId"
       class="btn btn-primary btn-sm">@T["Edit"]</a>

    <a asp-action="Delete"
       asp-route-id="@Model.Value.ItemId"
       class="btn btn-danger btn-sm"
       data-url-af="RemoveUrl UnsafeUrl">@T["Delete"]</a>
}
else
{
    <a asp-action="Edit"
       asp-route-id="@Model.Value.ItemId"
       class="btn btn-primary btn-sm">@T["View"]</a>

    @* Only a batch whose load has finished; one still loading is never removed from under its load. *@
    @if (Model.Value.Status == OmnichannelActivityBatchStatus.Loaded &&
        await AuthorizationService.AuthorizeAsync(User, OmnichannelConstants.Permissions.DeleteLoadedActivityBatches))
    {
        <a asp-action="Delete"
           asp-route-id="@Model.Value.ItemId"
           class="btn btn-danger btn-sm"
           data-title="@T["Delete activity load"]"
           data-message="@T["Delete this activity load? The activities it loaded are kept and stay assigned as they are."]"
           data-url-af="RemoveUrl UnsafeUrl">@T["Delete"]</a>
    }
}
