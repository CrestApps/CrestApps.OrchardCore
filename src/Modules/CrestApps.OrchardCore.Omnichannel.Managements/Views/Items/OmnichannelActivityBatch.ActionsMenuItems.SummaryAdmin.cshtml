@using CrestApps.OrchardCore.Omnichannel.Core.Models

@model ShapeViewModel<OmnichannelActivityBatch>

@if (Model.Value.Status == OmnichannelActivityBatchStatus.New)
{
    <a asp-action="Load"
       asp-route-id="@Model.Value.ItemId"
       class="text-danger dropdown-item"
       data-url-af="RemoveUrl UnsafeUrl"
       data-title="@T["Load activities"]"
       data-message="@T["Are you sure you want to load activities for this batch?"]">@T["Load activities"]</a>
}

@* Cloning copies the settings only: the copy is a new batch that has loaded nothing. *@
<a asp-action="Clone"
   asp-route-id="@Model.Value.ItemId"
   class="dropdown-item"
   data-url-af="UnsafeUrl">@T["Clone"]</a>
