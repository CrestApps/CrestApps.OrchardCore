@using CrestApps.OrchardCore.Omnichannel.Core.Models
@using Microsoft.Extensions.Options
@using OrchardCore.Lists.Models
@using System.Security.Claims
@using CrestApps.OrchardCore.Omnichannel.Core
@using Microsoft.AspNetCore.Authorization
@using OrchardCore.ContentManagement
@using OrchardCore.ContentManagement.Metadata.Models
@using OrchardCore.Contents
@using OrchardCore.ContentTypes
@using OrchardCore.Localization.Data

@model OrchardCore.Lists.ViewModels.ListPartNavigationAdminViewModel

@inject IOptions<OmnichannelCrmOptions> CrmOptions
@inject CrestApps.OrchardCore.Omnichannel.Managements.Services.OmnichannelContentTypeProvider CrmContentTypes
@inject IContentManager ContentManager
@inject IAuthorizationService AuthorizationService
@inject IDataLocalizer D

@*
    The list part's navigation bar for a container that is a contact. Orchard Core's bar cannot be extended, so a
    contact that is also a list would otherwise show two bars: this one and the contact's activity bar. This keeps
    the list part's buttons exactly as Orchard Core renders them and adds the contact's activity buttons, so the
    contact gets a single bar. Keep the list part's buttons in sync with Orchard Core's ListPartNavigationAdmin view.
*@
@{
    // Orchard Core hides the button of the page being shown. This bar also renders on the contact's activity
    // pages, whose actions are named Edit and List too, so only hide a button on the content pages themselves.
    var isContentsAdmin = string.Equals(ViewContext.RouteData.Values["area"]?.ToString(), "OrchardCore.Contents", StringComparison.OrdinalIgnoreCase) &&
        string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Admin", StringComparison.OrdinalIgnoreCase);
    var actionName = isContentsAdmin ? ViewContext.RouteData.Values["action"]?.ToString() : null;
    var containedContentTypeDefinitions = Model.ContainedContentTypeDefinitions ?? [];
    var authorizedContentTypeDefinitions = new List<ContentTypeDefinition>();

    foreach (var contentTypeDefinition in containedContentTypeDefinitions)
    {
        if (!await AuthorizationService.AuthorizeContentTypeAsync(User, CommonPermissions.EditContent, contentTypeDefinition.Name, User.FindFirstValue(ClaimTypes.NameIdentifier)))
        {
            continue;
        }

        authorizedContentTypeDefinitions.Add(contentTypeDefinition);
    }
}

<div class="card text-bg-theme text-right mb-3 second-action-bar">
    <div class="card-body">
        <div class="d-flex justify-content-end">

            @if (actionName != "Display" && await AuthorizationService.AuthorizeContentTypeDefinitionsAsync(User, CommonPermissions.ViewContent, containedContentTypeDefinitions, ContentManager))
            {
                if (containedContentTypeDefinitions.Length == 1)
                {
                    <a class="btn btn-secondary me-1" asp-action="Display" asp-controller="Admin" asp-route-contentItemId="@Model.Container.ContentItemId" asp-route-area="OrchardCore.Contents">@T["List {0} Items", D[containedContentTypeDefinitions[0].DisplayName, DataLocalizationContext.ContentType]]</a>
                }
                else
                {
                    <a class="btn btn-secondary me-1" asp-action="Display" asp-controller="Admin" asp-route-contentItemId="@Model.Container.ContentItemId" asp-route-area="OrchardCore.Contents">@T["List Items"]</a>
                }
            }

            @if (CrmOptions.Value.Enabled &&
                Model.Container.TryGet<LeadPart>(out var leadPart) &&
                !leadPart.IsConverted &&
                await AuthorizationService.AuthorizeAsync(User, OmnichannelConstants.Permissions.ConvertLead, Model.Container))
            {
                <a class="btn btn-success me-1" asp-action="Convert" asp-controller="Leads" asp-route-contentItemId="@Model.Container.ContentItemId" asp-route-area="@OmnichannelConstants.Features.Managements">@T["Convert Lead"]</a>
            }

            @if (CrmOptions.Value.Enabled &&
                Model.Container.TryGet<ContainedPart>(out var containedPart) &&
                !string.IsNullOrEmpty(containedPart.ListContentItemId) &&
                (await CrmContentTypes.GetAccountContentTypesAsync()).Contains(containedPart.ListContentType))
            {
                <a class="btn btn-secondary me-1" asp-action="Display" asp-controller="Admin" asp-route-contentItemId="@containedPart.ListContentItemId" asp-route-area="OrchardCore.Contents">@T["View Account"]</a>
            }

            @if (await AuthorizationService.AuthorizeAsync(User, OmnichannelConstants.Permissions.ListContactActivities, Model.Container))
            {
                <a class="btn btn-secondary me-1" asp-action="List" asp-controller="Activities" asp-route-contentItemId="@Model.Container.ContentItemId" asp-route-area="@OmnichannelConstants.Features.Managements">@T["List Activities"]</a>
            }

            @if (actionName != "Edit" && await AuthorizationService.AuthorizeAsync(User, CommonPermissions.EditContent, Model.Container))
            {
                <a class="btn btn-primary me-1" asp-action="Edit" asp-controller="Admin" asp-route-contentItemId="@Model.Container.ContentItemId" asp-route-area="OrchardCore.Contents">
                    @T["Edit {0}", D[Model.ContainerContentTypeDefinition?.DisplayName, DataLocalizationContext.ContentType]]
                </a>
            }

            @if (authorizedContentTypeDefinitions.Count == 1)
            {
                var contentTypeDefinition = authorizedContentTypeDefinitions[0];

                <a class="btn btn-secondary me-1" asp-action="Create" asp-controller="Admin" asp-route-id="@contentTypeDefinition.Name" asp-route-area="OrchardCore.Contents" asp-route-ListPart.ContainerId="@Model.Container.ContentItemId" asp-route-ListPart.ContainerContentType="@Model.ContainerContentTypeDefinition?.Name" asp-route-ListPart.ContentType="@contentTypeDefinition.Name" asp-route-ListPart.EnableOrdering="@Model.EnableOrdering" asp-route-returnUrl="@FullRequestPath">
                    @T["Create {0}", D[contentTypeDefinition.DisplayName, DataLocalizationContext.ContentType]]
                </a>
            }
            else if (authorizedContentTypeDefinitions.Count > 1)
            {
                <div class="btn-group me-1">
                    <button type="button" class="btn btn-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                        @T["New"]
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        @foreach (var containedContentTypeDefinition in authorizedContentTypeDefinitions)
                        {
                            <li>
                                <a class="dropdown-item" asp-action="Create" asp-controller="Admin" asp-route-id="@containedContentTypeDefinition.Name" asp-route-area="OrchardCore.Contents" asp-route-ListPart.ContainerId="@Model.Container.ContentItemId" asp-route-ListPart.ContainerContentType="@Model.ContainerContentTypeDefinition?.Name" asp-route-ListPart.ContentType="@containedContentTypeDefinition.Name" asp-route-ListPart.EnableOrdering="@Model.EnableOrdering" asp-route-returnUrl="@FullRequestPath">
                                    @D[containedContentTypeDefinition.DisplayName, DataLocalizationContext.ContentType]
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }

            @if (!(Model.Container.TryGet<LeadPart>(out var addActivityLead) && addActivityLead.IsConverted) &&
                await AuthorizationService.AuthorizeAsync(User, OmnichannelConstants.Permissions.EditActivity))
            {
                <div class="btn-group">
                    <button type="button" class="btn btn-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                        @T["Add Activity"]
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <a class="dropdown-item" asp-action="Create" asp-controller="Activities" asp-route-contentItemId="@Model.Container.ContentItemId" asp-route-area="@OmnichannelConstants.Features.Managements">@T["Outbound"]</a>
                        </li>
                        <li>
                            <a class="dropdown-item" asp-action="CreateInbound" asp-controller="Activities" asp-route-contentItemId="@Model.Container.ContentItemId" asp-route-area="@OmnichannelConstants.Features.Managements">@T["Inbound"]</a>
                        </li>
                    </ul>
                </div>
            }

        </div>
    </div>
</div>
