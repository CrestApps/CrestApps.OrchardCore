@using CrestApps.OrchardCore.Omnichannel.Managements.ViewModels
@using Microsoft.AspNetCore.Mvc.Localization

@model NotInServiceNumbersIndexViewModel

<zone Name="Title">
    <breadcrumb name="OmnichannelNotInServiceNumbers" title="@T["Numbers Not In Service"]" />
</zone>

<p class="text-muted">
    @T["These numbers are skipped when contacts are loaded into a campaign, and the dialer and automated calls never dial them. A number is added when a call finds it not in service, a number lookup reports it disconnected or invalid, or an agent uses a disposition that marks it. Use <strong>Allow dialing</strong> when a number has been given to somebody new: it removes the mark so campaigns can load and dial the number again. Nothing is dialed when you do."]
</p>

@* The form is necessary to generate an antiforgery token for the allow dialing and bulk actions. *@
<form asp-action="Index" asp-route-pageSize="@Context.Request.Query["pageSize"]" method="post" class="no-multisubmit" data-list-management data-selected-label="@T["selected"]" data-client-side-search="false">
    <input type="submit" name="submit.Filter" id="submitFilter" class="visually-hidden" />
    <input asp-for="Options.BulkAction" type="hidden" />
    <input type="submit" name="submit.BulkAction" class="visually-hidden" />

    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <div class="input-group">
                        <input id="search-box" asp-for="Options.Search" class="form-control" placeholder="@T["Search by number"]" type="search" autofocus autocomplete="off" />
                        <button type="submit" name="submit.Filter" class="btn btn-outline-secondary" title="@T["Search"]" aria-label="@T["Search"]"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
                    </div>
                </div>
                <div class="col-auto">
                    <button type="button" class="btn btn-secondary create" data-bs-toggle="modal" data-bs-target="#modalMarkNotInService">@T["Mark as not in service"]</button>
                </div>
            </div>
        </div>
    </div>

    @* The rows, the toolbar and the pager are rendered by the AdminList shape, in the layout (List or Grid) the site or the user picked. *@
    <admin-list name="OmnichannelNotInServiceNumbers" context="Model.List"
                bulk-actions="Model.Options.BulkActions"
                empty-message="@(string.IsNullOrWhiteSpace(Model.Options.Search) ? T["<strong>Nothing here!</strong> No number is marked as not in service."] : T["No marked number matches your search."])">
        <admin-list-list item-css-class="list-group-item" />
        <admin-list-grid>
            <admin-list-column type="Select" />
            <admin-list-column name="Number" position="20" title="@T["Number"]" />
            <admin-list-column name="FoundBy" position="30" title="@T["Found by"]" width="auto" />
            <admin-list-column name="LastFound" position="40" title="@T["Last found"]" width="auto" />
            <admin-list-column type="Actions" title="@T["Actions"]" />
        </admin-list-grid>
    </admin-list>
</form>

<div class="modal fade" id="modalMarkNotInService" tabindex="-1" role="dialog" aria-labelledby="mark-not-in-service-title" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <form asp-action="Mark" method="post" class="no-multisubmit">
                <div class="modal-header">
                    <h5 class="modal-title" id="mark-not-in-service-title">@T["Mark as not in service"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Close"]"></button>
                </div>
                <div class="modal-body">
                    <div class="ocat-wrapper">
                        <label for="mark-phone-number" class="ocat-label ocat-label-required">@T["Phone number"]</label>
                        <div class="ocat-end">
                            <input id="mark-phone-number" name="phoneNumber" class="form-control" type="tel" placeholder="+17025550123" required />
                            <span class="hint">@T["Enter the number with its country code. Campaigns will not load or dial it until you allow dialing again."]</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">@T["Mark as not in service"]</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@T["Cancel"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script asp-name="list-management-ui" at="Foot"></script>
