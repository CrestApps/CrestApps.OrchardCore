@using CrestApps.OrchardCore.Omnichannel.Managements.ViewModels

@model CadenceViewModel

@{
    // The base name the model binder expects for the step collection, e.g. "Cadence.Steps".
    var stepsName = Html.NameFor(m => m.Steps).ToString();
}

@*
    Each step is drawn like an Orchard bag-part item: a card whose header carries the collapse toggle, the step's
    title with its message source muted beside it, and the delete (trash) button on the right; the step's fields are
    in the collapsible body. The ids the collapse toggle and the labels point at are set by reindex() below, so a
    step added or removed in the browser keeps them unique.
*@
<div class="ocat-wrapper">
    <label class="ocat-label">@T["Follow-up steps"]</label>
    <div class="ocat-end">
        <div id="cadence-steps" data-steps-name="@stepsName">
            @for (var i = 0; i < Model.Steps.Count; i++)
            {
                var step = Model.Steps[i];
                var stepId = $"cadence-step-{i}";

                <div class="cadence-step widget-editor card mb-2">
                    <div class="widget-editor-header card-header text-muted d-flex align-items-center gap-2 py-1 ps-2 pe-1">
                        <button type="button" class="btn btn-outline-secondary btn-sm cadence-step-toggle" data-bs-toggle="collapse" data-bs-target="#@(stepId)-body" aria-expanded="true" aria-controls="@(stepId)-body" title="@T["Collapse or expand this step"]"><i class="fa-solid fa-angle-down" aria-hidden="true"></i></button>
                        <span class="flex-grow-1 text-truncate">
                            <span class="cadence-step-title">@T["Step {0}", i + 1]</span>
                            <span class="hint dashed cadence-step-kind">@(step.IsAiGenerated ? T["AI-generated"] : T["Defined message"])</span>
                        </span>
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-danger cadence-step-remove" title="@T["Remove"]" aria-label="@T["Remove"]"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
                        </div>
                    </div>
                    <div id="@(stepId)-body" class="collapse show cadence-step-body">
                        <div class="widget-editor-body card-body">
                            <div class="ocat-wrapper">
                                <label class="ocat-label cadence-step-delay-label" for="@(stepId)-delay">@T["After (minutes)"]</label>
                                <div class="ocat-end">
                                    <input type="number" min="1" id="@(stepId)-delay" class="form-control cadence-step-delay" name="@(stepsName)[@i].DelayMinutes" value="@step.DelayMinutes" />
                                    <span class="hint">@T["Minutes of silence since our previous message before this follow-up is sent."]</span>
                                </div>
                            </div>

                            <div class="ocat-wrapper">
                                <label class="ocat-label cadence-step-type-label" for="@(stepId)-type">@T["Message source"]</label>
                                <div class="ocat-end">
                                    <select id="@(stepId)-type" class="form-select cadence-step-type" name="@(stepsName)[@i].IsAiGenerated">
                                        <option value="false" selected="@(!step.IsAiGenerated)">@T["Defined message"]</option>
                                        <option value="true" selected="@(step.IsAiGenerated)">@T["AI-generated"]</option>
                                    </select>
                                    <span class="hint">@T["Defined sends your exact text; AI-generated composes it from the conversation."]</span>
                                </div>
                            </div>

                            <div class="ocat-wrapper">
                                <label class="ocat-label cadence-step-message-label" for="@(stepId)-message">@(step.IsAiGenerated ? T["AI guidance (optional)"] : T["Message text"])</label>
                                <div class="ocat-end">
                                    <textarea id="@(stepId)-message" class="form-control cadence-step-message" name="@(stepsName)[@i].Message" rows="2">@step.Message</textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <button type="button" id="cadence-step-add" class="btn btn-secondary btn-sm mt-1">@T["Add step"]</button>
        <span asp-validation-for="Steps" class="text-danger d-block"></span>
        <span class="hint">
            @T["Each step sends one follow-up after its own quiet period, measured from our previous message — the opening message for step 1, or the previous step after that. The clock restarts every time we send, so the delays add up. For example, two steps of 60 send the first follow-up 60 minutes after the opening and the second 60 minutes after that (about two hours in) — two follow-ups in total, not one. Follow-ups stop after the last step, and every one respects the campaign's business hours."]
        </span>
    </div>
</div>

<template id="cadence-step-template">
    <div class="cadence-step widget-editor card mb-2">
        <div class="widget-editor-header card-header text-muted d-flex align-items-center gap-2 py-1 ps-2 pe-1">
            <button type="button" class="btn btn-outline-secondary btn-sm cadence-step-toggle" data-bs-toggle="collapse" aria-expanded="true" title="@T["Collapse or expand this step"]"><i class="fa-solid fa-angle-down" aria-hidden="true"></i></button>
            <span class="flex-grow-1 text-truncate">
                <span class="cadence-step-title"></span>
                <span class="hint dashed cadence-step-kind">@T["Defined message"]</span>
            </span>
            <div class="btn-group btn-group-sm" role="group">
                <button type="button" class="btn btn-danger cadence-step-remove" title="@T["Remove"]" aria-label="@T["Remove"]"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
            </div>
        </div>
        <div class="collapse show cadence-step-body">
            <div class="widget-editor-body card-body">
                <div class="ocat-wrapper">
                    <label class="ocat-label cadence-step-delay-label">@T["After (minutes)"]</label>
                    <div class="ocat-end">
                        <input type="number" min="1" class="form-control cadence-step-delay" value="60" />
                        <span class="hint">@T["Minutes of silence since our previous message before this follow-up is sent."]</span>
                    </div>
                </div>

                <div class="ocat-wrapper">
                    <label class="ocat-label cadence-step-type-label">@T["Message source"]</label>
                    <div class="ocat-end">
                        <select class="form-select cadence-step-type">
                            <option value="false" selected>@T["Defined message"]</option>
                            <option value="true">@T["AI-generated"]</option>
                        </select>
                        <span class="hint">@T["Defined sends your exact text; AI-generated composes it from the conversation."]</span>
                    </div>
                </div>

                <div class="ocat-wrapper">
                    <label class="ocat-label cadence-step-message-label">@T["Message text"]</label>
                    <div class="ocat-end">
                        <textarea class="form-control cadence-step-message" rows="2"></textarea>
                    </div>
                </div>
            </div>
        </div>
    </div>
</template>

<script at="Foot">
(function () {
    var container = document.getElementById('cadence-steps');
    var addButton = document.getElementById('cadence-step-add');
    var template = document.getElementById('cadence-step-template');
    if (!container || !addButton || !template) { return; }

    var stepsName = container.getAttribute('data-steps-name');
    var aiLabel = '@T["AI guidance (optional)"]';
    var definedLabel = '@T["Message text"]';
    var aiKind = '@T["AI-generated"]';
    var definedKind = '@T["Defined message"]';
    var stepWord = '@T["Step"]';

    function setFor(row, labelSelector, controlSelector, id) {
        var label = row.querySelector(labelSelector);
        var control = row.querySelector(controlSelector);
        if (control) { control.id = id; }
        if (label) { label.setAttribute('for', id); }
    }

    function reindex() {
        var rows = container.querySelectorAll('.cadence-step');
        rows.forEach(function (row, i) {
            var delay = row.querySelector('.cadence-step-delay');
            var type = row.querySelector('.cadence-step-type');
            var msg = row.querySelector('.cadence-step-message');
            var title = row.querySelector('.cadence-step-title');
            var body = row.querySelector('.cadence-step-body');
            var toggle = row.querySelector('.cadence-step-toggle');
            var stepId = 'cadence-step-' + i;
            if (delay) { delay.name = stepsName + '[' + i + '].DelayMinutes'; }
            if (type) { type.name = stepsName + '[' + i + '].IsAiGenerated'; }
            if (msg) { msg.name = stepsName + '[' + i + '].Message'; }
            if (title) { title.textContent = stepWord + ' ' + (i + 1); }
            if (body) { body.id = stepId + '-body'; }
            if (toggle) {
                toggle.setAttribute('data-bs-target', '#' + stepId + '-body');
                toggle.setAttribute('aria-controls', stepId + '-body');
            }
            setFor(row, '.cadence-step-delay-label', '.cadence-step-delay', stepId + '-delay');
            setFor(row, '.cadence-step-type-label', '.cadence-step-type', stepId + '-type');
            setFor(row, '.cadence-step-message-label', '.cadence-step-message', stepId + '-message');
        });
    }

    function syncLabel(row) {
        var type = row.querySelector('.cadence-step-type');
        var label = row.querySelector('.cadence-step-message-label');
        var kind = row.querySelector('.cadence-step-kind');
        if (type && label) { label.textContent = type.value === 'true' ? aiLabel : definedLabel; }
        if (type && kind) { kind.textContent = type.value === 'true' ? aiKind : definedKind; }
    }

    container.addEventListener('click', function (e) {
        var remove = e.target.closest('.cadence-step-remove');
        if (remove) {
            var row = remove.closest('.cadence-step');
            if (row) { row.remove(); reindex(); }
        }
    });

    container.addEventListener('change', function (e) {
        if (e.target.classList.contains('cadence-step-type')) {
            syncLabel(e.target.closest('.cadence-step'));
        }
    });

    addButton.addEventListener('click', function () {
        var clone = template.content.firstElementChild.cloneNode(true);
        container.appendChild(clone);
        reindex();
        syncLabel(clone);
    });

    reindex();
})();
</script>
