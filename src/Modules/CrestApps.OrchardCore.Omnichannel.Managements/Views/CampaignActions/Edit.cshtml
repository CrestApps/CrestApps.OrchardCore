@using CrestApps.OrchardCore.Core.Models
@using CrestApps.OrchardCore.Omnichannel.Core

@model EditCatalogEntryViewModel

<zone Name="Title">
    <breadcrumb name="OmnichannelCampaignActionsEdit" title="@T["Edit Campaign Action - {0}", Model.DisplayName]">
        <breadcrumb-item id="OmnichannelCampaigns" action="Index" controller="Campaigns" area="CrestApps.OrchardCore.Omnichannel.Managements" permission="@OmnichannelConstants.Permissions.ManageCampaigns.Name">@T["Campaigns"]</breadcrumb-item>
        <breadcrumb-item id="OmnichannelCampaignsEdit" action="Edit" controller="Campaigns" area="CrestApps.OrchardCore.Omnichannel.Managements" route-id="@(ViewData["CampaignId"]?.ToString())" permission="@OmnichannelConstants.Permissions.ManageCampaigns.Name">@T["Edit Campaign"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form method="post" enctype="multipart/form-data" class="no-multisubmit">
    @Html.ValidationSummary()
    @await DisplayAsync(Model.Editor)

    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <button class="btn btn-primary" type="submit">@T["Save"]</button>
            <a class="btn btn-secondary cancel"
               role="button"
               asp-route-action="Edit"
               asp-route-controller="Campaigns"
               asp-route-id="@ViewData["CampaignId"]">@T["Cancel"]</a>
        </div>
    </div>
</form>
