@using System.Globalization
@using System.Text.Json
@using CrestApps.OrchardCore.Omnichannel.Core.Models
@using CrestApps.OrchardCore.Omnichannel.Managements.ViewModels

@model OmnichannelActivityBatchViewModel

@{
    var contactCreatedFromId = Html.IdFor(m => m.LeadCreatedFrom);
    var contactCreatedToId = Html.IdFor(m => m.LeadCreatedTo);
    var datePattern = CultureInfo.CurrentCulture.DateTimeFormat.ShortDatePattern;
    var timePattern = CultureInfo.CurrentCulture.DateTimeFormat.ShortTimePattern;
    var contactCreatedFromValue = Model.LeadCreatedFrom?.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture);
    var contactCreatedToValue = Model.LeadCreatedTo?.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture);
}

<style asp-name="flatpickr"></style>
<script asp-name="flatpickr" at="Foot"></script>
<script asp-name="flatpickr-culture" at="Foot"></script>

<style asp-name="bootstrap-select"></style>
<script asp-name="bootstrap-select" at="Foot"></script>

<div class="ocat-wrapper">
    <label asp-for="ContactContentType" class="ocat-label ocat-label-required">@T["Record type"]</label>
    <div class="ocat-end">
        <select asp-for="ContactContentType" asp-items="Model.ContactContentTypes" class="form-select">
            <option value="">@T["Select a contact or lead type"]</option>
        </select>
        <span asp-validation-for="ContactContentType" class="text-danger"></span>
    </div>
</div>

@if (Model.RecordFilters is not null)
{
    @await DisplayAsync(Model.RecordFilters)
}

<div class="ocat-wrapper">
    <label asp-for="LeadCreatedFrom" class="ocat-label">@T["Created from"]</label>
    <div class="ocat-end">
        <input type="text"
               id="@contactCreatedFromId"
               name="@Html.NameFor(m => m.LeadCreatedFrom)"
               value="@contactCreatedFromValue"
               class="form-control"
               placeholder="@T["Created from"]" />
        <span asp-validation-for="LeadCreatedFrom" class="text-danger"></span>
        <span class="hint">@T["Optionally, only include records created on or after this date."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="LeadCreatedTo" class="ocat-label">@T["Created to"]</label>
    <div class="ocat-end">
        <input type="text"
               id="@contactCreatedToId"
               name="@Html.NameFor(m => m.LeadCreatedTo)"
               value="@contactCreatedToValue"
               class="form-control"
               placeholder="@T["Created to"]" />
        <span asp-validation-for="LeadCreatedTo" class="text-danger"></span>
        <span class="hint">@T["Optionally, only include records created on or before this date."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" asp-for="OnlyPublishedLeads">
            <label class="form-check-label" asp-for="OnlyPublishedLeads">@T["Only published records"]</label>
            <span class="hint dashed">@T["When enabled, only published records are included. When disabled, the latest version of each record is included, whatever its publish status."]</span>
        </div>
    </div>
</div>

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" asp-for="IncludeDoNoCalls">
            <label class="form-check-label" asp-for="IncludeDoNoCalls">@T["Include records marked Do not call"]</label>
            <span class="hint dashed">@T["When enabled, records marked Do not call are loaded too."]</span>
        </div>
    </div>
</div>

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" asp-for="IncludeDoNoEmail">
            <label class="form-check-label" asp-for="IncludeDoNoEmail">@T["Include records marked Do not email"]</label>
            <span class="hint dashed">@T["When enabled, records marked Do not email are loaded too."]</span>
        </div>
    </div>
</div>

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" asp-for="IncludeDoNoSms">
            <label class="form-check-label" asp-for="IncludeDoNoSms">@T["Include records marked Do not SMS"]</label>
            <span class="hint dashed">@T["When enabled, records marked Do not SMS are loaded too."]</span>
        </div>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="PhoneNumberMatchType" class="ocat-label">@T["Phone number filter"]</label>
    <div class="ocat-end">
        <div class="input-group">
            <select asp-for="PhoneNumberMatchType" asp-items="Model.PhoneNumberMatchTypes" class="form-select" style="max-width: 160px;"></select>
            <input asp-for="PhoneNumber" class="form-control" placeholder="@T["Phone number"]" />
        </div>
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
        <span class="hint">@T["Enter a national number or fragment (e.g., 702499). Start with + to search E.164 values (e.g., +1702499). Searches primary cell and home numbers."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="TimeZoneIds" class="ocat-label">@T["Time zones"]</label>
    <div class="ocat-end">
        <select asp-for="TimeZoneIds" asp-items="Model.TimeZones" class="selectpicker show-tick" multiple data-live-search="true" data-show-selected-tags="true" data-actions-box="true" data-header="@T["Select time zones"]" data-selected-text-format="count > 2" data-count-selected-text="{0} time zones selected" title="@T["Any time zone"]">
        </select>
        <span class="hint">@T["Optionally, only include records in the selected time zones."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="Limit" class="ocat-label">@T["Limit"]</label>
    <div class="ocat-end">
        <input type="number" asp-for="Limit" class="form-control" placeholder="@T["Max records"]" min="1" />
        <span class="hint">@T["Optionally, limit the number of records loaded into this batch."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <span class="ocat-label"></span>
    <div class="ocat-end">
        <button type="button" class="btn btn-outline-secondary" id="activity-load-count-button"
                data-url="@Url.RouteUrl("OmnichannelActivityBatchesCount", new { source = Model.Source, id = Model.BatchId })">
            <i class="fa-solid fa-calculator" aria-hidden="true"></i> @T["Count matching records"]
        </button>
        <div id="activity-load-count-result" class="mt-2" aria-live="polite"></div>
        <span class="hint">@T["Counts how many records these filters, including the last activity filters below, match and how many would be loaded right now, without loading anything."]</span>
    </div>
</div>

<script at="Foot">
    document.addEventListener('DOMContentLoaded', function () {
        var button = document.getElementById('activity-load-count-button');
        var result = document.getElementById('activity-load-count-result');

        if (!button || !result) {
            return;
        }

        var text = @Html.Raw(JsonSerializer.Serialize(new Dictionary<string, string>
        {
            ["counting"] = T["Counting matching records..."].Value,
            ["failed"] = T["The records could not be counted. Try again."].Value,
            ["summary"] = T["{0} records match; {1} would be loaded."].Value,
            ["duplicate"] = T["{0} already have an open activity for this subject"].Value,
            ["optedOut"] = T["{0} asked not to be reached on this channel"].Value,
            ["noDestination"] = T["{0} have no address on this channel"].Value,
            ["notInService"] = T["{0} have only numbers that are not in service"].Value,
            ["lead"] = T["{0} are converted leads or share a number with a contact"].Value,
            ["limit"] = T["{0} are over the limit"].Value,
            ["skipped"] = T["Not loaded:"].Value,
        }));

        function format(template) {
            var args = Array.prototype.slice.call(arguments, 1);

            return template.replace(/\{(\d+)\}/g, function (match, index) {
                var value = args[Number(index)];

                return typeof value === 'number' ? value.toLocaleString() : String(value);
            });
        }

        function show(className, message, details) {
            result.replaceChildren();

            var box = document.createElement('div');
            box.className = 'alert py-2 mb-0 ' + className;
            box.textContent = message;

            if (details && details.length) {
                var label = document.createElement('div');
                label.className = 'mt-1';
                label.textContent = text.skipped;
                box.appendChild(label);

                var list = document.createElement('ul');
                list.className = 'mb-0';
                details.forEach(function (detail) {
                    var item = document.createElement('li');
                    item.textContent = detail;
                    list.appendChild(item);
                });
                box.appendChild(list);
            }

            result.appendChild(box);
        }

        button.addEventListener('click', async function () {
            var form = button.closest('form');

            if (!form) {
                return;
            }

            button.disabled = true;
            show('alert-secondary', text.counting);

            try {
                var response = await fetch(button.dataset.url, {
                    method: 'POST',
                    body: new FormData(form),
                    credentials: 'same-origin',
                });

                if (!response.ok) {
                    throw new Error(response.status);
                }

                var count = await response.json();

                if (count.error) {
                    show('alert-warning', count.error);

                    return;
                }

                var details = [];
                [
                    ['duplicate', count.skippedAsDuplicate],
                    ['optedOut', count.skippedAsOptedOut],
                    ['noDestination', count.skippedForNoDestination],
                    ['notInService', count.skippedAsNotInService],
                    ['lead', count.skippedAsLead],
                    ['limit', count.skippedByLimit],
                ].forEach(function (entry) {
                    if (entry[1] > 0) {
                        details.push(format(text[entry[0]], entry[1]));
                    }
                });

                show('alert-info', format(text.summary, count.matched, count.wouldLoad), details);
            } catch (error) {
                show('alert-danger', text.failed);
            } finally {
                button.disabled = false;
            }
        });
    });
</script>

<script at="Foot" depends-on="flatpickr,flatpickr-culture">
    document.addEventListener('DOMContentLoaded', function () {
        var fromField = document.getElementById('@contactCreatedFromId');
        var toField = document.getElementById('@contactCreatedToId');

        var fromPicker = flatpickr(fromField, Object.assign(
            flatpickrCulture.createLocalizedDateTimeConfig("@datePattern", "@timePattern", {
                altInputClass: fromField.className,
            }),
            {
            onChange: function (selectedDates) {
                if (selectedDates && selectedDates.length > 0) {
                    toPicker.set('minDate', selectedDates[0]);
                } else {
                    toPicker.set('minDate', null);
                }
            }
            }));

        var toPicker = flatpickr(toField, Object.assign(
            flatpickrCulture.createLocalizedDateTimeConfig("@datePattern", "@timePattern", {
                altInputClass: toField.className,
            }),
            {
            onChange: function (selectedDates) {
                if (selectedDates && selectedDates.length > 0) {
                    fromPicker.set('maxDate', selectedDates[0]);
                } else {
                    fromPicker.set('maxDate', null);
                }
            }
            }));

        if (fromField.value) {
            toPicker.set('minDate', fromField.value);
        }

        if (toField.value) {
            fromPicker.set('maxDate', toField.value);
        }

    });
</script>
