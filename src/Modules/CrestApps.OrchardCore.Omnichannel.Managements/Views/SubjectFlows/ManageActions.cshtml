@using CrestApps.OrchardCore.Omnichannel.Core
@using CrestApps.OrchardCore.Omnichannel.Managements.ViewModels
@using Microsoft.AspNetCore.Mvc.Localization

@model ManageSubjectActionsViewModel

<zone Name="Title">
    <breadcrumb name="OmnichannelSubjectFlowsManageActions" title="@T["Manage Flow: {0}", Model.SubjectDisplayName]">
        <breadcrumb-item id="OmnichannelSubjectFlows" action="Index" controller="SubjectFlows" area="CrestApps.OrchardCore.Omnichannel.Managements" permission="@OmnichannelConstants.Permissions.ManageSubjectFlows.Name">@T["Subject Flows"]</breadcrumb-item>
    </breadcrumb>
</zone>

<div data-list-management data-client-side-search="true">
    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <div class="input-group">
                        <input id="search-box" class="form-control" placeholder="@T["Search"]" type="search" autofocus autocomplete="off" />
                        <button type="button" class="btn btn-outline-secondary" title="@T["Search"]" aria-label="@T["Search"]"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
                    </div>
                </div>
                <div class="col-auto">
                    @if (Model.ActionTypes.Any())
                    {
                        <button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#modalAddSubjectAction">
                            @T["Add Action"]
                        </button>
                    }

                    <a class="btn btn-secondary"
                       asp-action="Index">@T["Back to Subject Flows"]</a>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Actions.Count > 0)
    {
        @* The rows are rendered by the AdminList shape, in the layout (List or Grid) the site or the user picked. *@
        <admin-list name="OmnichannelSubjectActions" context="Model.List"
                    show-select-all="false">
            <admin-list-list item-css-class="list-group-item" />
            <admin-list-grid>
                <admin-list-column name="Disposition" position="20" title="@T["Disposition"]" />
                <admin-list-column name="Type" position="30" title="@T["Action type"]" width="auto" />
                <admin-list-column type="Actions" title="@T["Actions"]" />
            </admin-list-grid>
        </admin-list>

        <div id="list-alert" class="alert alert-info my-3 d-none text-center" role="alert">
            @T["Your search returned no results."]
        </div>
    }
    else
    {
        <div class="alert alert-info">
            @T["No actions have been added yet. Click \"Add Action\" to define what happens when a disposition is selected."]
        </div>
    }
</div>

@if (Model.ActionTypes.Any())
{
    <div class="modal fade" id="modalAddSubjectAction" tabindex="-1" role="dialog" aria-labelledby="available-action-types-title" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="available-action-types-title">@T["Available Action Types"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row row-cols-1 row-cols-md-3 g-2">
                        @foreach (var actionType in Model.ActionTypes)
                        {
                            <div class="col">
                                <div class="card h-100">
                                    <div class="card-body d-flex flex-column">
                                        <h5 class="card-title">@actionType.DisplayName</h5>
                                        @if (actionType.Description != null)
                                        {
                                            <p class="card-text flex-grow-1">@actionType.Description</p>
                                        }
                                        <a class="btn btn-sm btn-primary mt-auto"
                                           asp-action="CreateAction"
                                           asp-controller="SubjectFlows"
                                           asp-route-subjectContentType="@Model.SubjectContentType"
                                           asp-route-source="@actionType.Type">@T["Select"]</a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@T["Cancel"]</button>
                </div>
            </div>
        </div>
    </div>
}

<script asp-name="list-management-ui" at="Foot"></script>
