@using CrestApps.OrchardCore.Omnichannel.Managements.ViewModels
@using Microsoft.AspNetCore.Mvc.Localization

@model SubjectFlowsIndexViewModel

<zone Name="Title">
    <breadcrumb name="OmnichannelSubjectFlows" title="@T["Subject Flows"]" />
</zone>

@if (Model.Subjects.Count == 0)
{
    <div class="alert alert-info" role="alert">
        <p class="mb-2">@T["There are no subject content types configured yet."]</p>
        <p class="mb-0">
            @T["To get started, create a content type and attach the <code>{0}</code> part.", "OmnichannelSubjectPart"]
            <a href="@Url.Action("Create", "Admin", new { area = "OrchardCore.ContentTypes" })">@T["Create a new content type"]</a>
        </p>
    </div>
}
else
{
    <form asp-action="Index" method="post" class="no-multisubmit" data-list-management data-client-side-search="true">
        <div class="card text-bg-theme mb-3 position-sticky action-bar">
            <div class="card-body">
                <div class="row gx-2">
                    <div class="col">
                        <div class="input-group">
                            <input id="search-box" class="form-control" placeholder="@T["Search"]" type="search" autofocus autocomplete="off" />
                            <button type="button" class="btn btn-outline-secondary" title="@T["Search"]" aria-label="@T["Search"]"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
                        </div>
                    </div>
                    <div class="col-auto">
                        <a class="btn btn-secondary create" role="button" href="@Url.Action("Create", "Admin", new { area = "OrchardCore.ContentTypes" })">@T["Add Subject"]</a>
                    </div>
                </div>
            </div>
        </div>

        @* The rows are rendered by the AdminList shape, in the layout (List or Grid) the site or the user picked. *@
        <admin-list name="OmnichannelSubjectFlows" context="Model.List"
                    show-select-all="false">
            <admin-list-list item-css-class="list-group-item" />
            <admin-list-grid>
                <admin-list-column name="Name" position="20" title="@T["Subject"]" />
                <admin-list-column name="Direction" position="30" title="@T["Direction"]" width="auto" />
                <admin-list-column name="Flow" position="40" title="@T["Flow"]" width="auto" />
                <admin-list-column type="Actions" title="@T["Actions"]" />
            </admin-list-grid>
        </admin-list>

        <div id="list-alert" class="alert alert-info my-3 d-none text-center" role="alert">
            @T["Your search returned no results."]
        </div>
    </form>

    <script asp-name="list-management-ui" at="Foot"></script>
}
