@using CrestApps.OrchardCore.Omnichannel.Core
@using CrestApps.OrchardCore.Omnichannel.Managements.ViewModels

@model EditSubjectActionViewModel

<zone Name="Title">
    <breadcrumb name="OmnichannelSubjectFlowsCreateAction" title="@T["Create Subject Action: {0}", Model.ActionTypeDisplayName]">
        <breadcrumb-item id="OmnichannelSubjectFlows" action="Index" controller="SubjectFlows" area="CrestApps.OrchardCore.Omnichannel.Managements" permission="@OmnichannelConstants.Permissions.ManageSubjectFlows.Name">@T["Subject Flows"]</breadcrumb-item>
        <breadcrumb-item id="OmnichannelSubjectFlowsManageActions" action="ManageActions" controller="SubjectFlows" area="CrestApps.OrchardCore.Omnichannel.Managements" route-subjectContentType="@Model.SubjectContentType" permission="@OmnichannelConstants.Permissions.ManageSubjectFlows.Name">@T["Manage Flow: {0}", Model.SubjectDisplayName]</breadcrumb-item>
    </breadcrumb>
</zone>

<form asp-action="CreateAction" method="post">
    @await DisplayAsync(Model.Editor)

    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <button class="btn btn-primary" type="submit">@T["Create"]</button>
            <a class="btn btn-secondary" asp-action="ManageActions" asp-controller="SubjectFlows" asp-route-subjectContentType="@Model.SubjectContentType">@T["Cancel"]</a>
        </div>
    </div>
</form>
