@using CrestApps.Core.Models
@using CrestApps.OrchardCore.Omnichannel.Core

@model EditCatalogEntryViewModel

<zone Name="Title">
    <breadcrumb name="OmnichannelActivityBatchesEdit" title="@T["Edit '{0}' Inventory Load", Model.DisplayName]">
        <breadcrumb-item id="OmnichannelActivityBatches" action="Index" controller="ActivityBatches" area="CrestApps.OrchardCore.Omnichannel.Managements" permission="@OmnichannelConstants.Permissions.ManageActivityBatches.Name">@T["Load Inventory"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form method="post" asp-route-id="@ViewContext.HttpContext.Request.RouteValues["id"]" enctype="multipart/form-data" class="no-multisubmit">
    @Html.ValidationSummary()
    @await DisplayAsync(Model.Editor)

    @if (ViewData["IsReadOnly"] as bool? == false)
    {
        <div class="ocat-wrapper">
            <div class="ocat-end-offset">
                <button class="btn btn-primary" type="submit">@T["Save"]</button>
                <a class="btn btn-secondary cancel" role="button" asp-route-action="Index">@T["Cancel"]</a>
            </div>
        </div>
    }
    else
    {
        <div class="ocat-wrapper">
            <div class="ocat-end-offset">
                <a class="btn btn-secondary cancel" role="button" asp-route-action="Index">@T["Cancel"]</a>
            </div>
        </div>
    }
</form>
