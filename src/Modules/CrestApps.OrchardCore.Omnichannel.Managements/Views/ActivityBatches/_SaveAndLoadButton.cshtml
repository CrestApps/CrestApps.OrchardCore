@* The name must match ActivityBatchesController.SaveAndLoadSubmitName, which routes the post to Save & Load. The
   crestapps-browser helpers ask the question (data-confirm) and submit the form with this button once agreed. *@
<button class="btn btn-success"
        type="submit"
        name="submit.SaveAndLoad"
        value="submit.SaveAndLoad"
        data-confirm-title="@T["Save & Load activities"]"
        data-confirm="@T["Are you sure you want to save this batch and load its activities now?"]"
        data-confirm-ok="@T["Save & Load"]"
        data-confirm-cancel="@T["Cancel"]">@T["Save & Load activities"]</button>

<script asp-name="crestapps-browser" at="Foot"></script>
