@using CrestApps.OrchardCore.Omnichannel.Managements.ViewModels

@model OmnichannelSubjectAISettingsViewModel

<div class="card mb-3 subject-ai-settings@(Model.CanAutomate ? string.Empty : " d-none")">
    <div class="card-header">@T["AI configuration"]</div>
    <div class="card-body">
        <div class="ocat-wrapper">
            <div class="ocat-end-offset">
                <span class="hint dashed">@T["These settings apply when this inbound subject runs as an automated (AI-driven) interaction. An inventory load can override the AI profile for the activities it creates; the speech deployments and voice always come from this subject, or from the site defaults when left empty."]</span>
            </div>
        </div>

        <div class="ocat-wrapper" asp-validation-class-for="ProfileId">
            <label asp-for="ProfileId" class="ocat-label">@T["AI profile"]</label>
            <div class="ocat-end">
                <select asp-for="ProfileId" asp-items="Model.Profiles" class="form-select">
                    <option value="">@T["Select a profile"]</option>
                </select>
                <span asp-validation-for="ProfileId" class="text-danger"></span>
                <span class="hint">@T["Only chat profiles with Add initial prompt enabled are shown because the initial prompt is sent as the first outbound message."]</span>
            </div>
        </div>

        <div class="ocat-wrapper" asp-validation-class-for="SubjectGoal">
            <label asp-for="SubjectGoal" class="ocat-label">@T["Subject goal"]</label>
            <div class="ocat-end">
                <textarea asp-for="SubjectGoal" rows="3" class="form-control"></textarea>
                <span asp-validation-for="SubjectGoal" class="text-danger"></span>
                <span class="hint">@T["Describe the goal of this subject. The AI uses this to determine when to disposition the activity and end the conversation."]</span>
            </div>
        </div>

        <div class="subject-ai-voice-only@(Model.ShowVoiceSettings ? string.Empty : " d-none")">
            <h6 class="mb-3">@T["Voice call automation"]</h6>

            <div class="ocat-wrapper">
                <label asp-for="SpeechToTextDeploymentName" class="ocat-label">@T["Speech-to-text deployment"]</label>
                <div class="ocat-end">
                    <select asp-for="SpeechToTextDeploymentName" asp-items="Model.SpeechToTextDeployments" class="form-select">
                        <option value="">@T["Use site default"]</option>
                    </select>
                    <span class="hint">@T["Leave empty to use the default speech-to-text deployment configured in Artificial Intelligence settings. Used when the subject runs as an automated phone call."]</span>
                </div>
            </div>

            <div class="ocat-wrapper">
                <label asp-for="TextToSpeechDeploymentName" class="ocat-label">@T["Text-to-speech deployment"]</label>
                <div class="ocat-end">
                    <select asp-for="TextToSpeechDeploymentName" asp-items="Model.TextToSpeechDeployments" class="form-select">
                        <option value="">@T["Use site default"]</option>
                    </select>
                    <span class="hint">@T["Leave empty to use the default text-to-speech deployment configured in Artificial Intelligence settings."]</span>
                </div>
            </div>

            <div class="ocat-wrapper">
                <label asp-for="TextToSpeechVoiceId" class="ocat-label">@T["Voice"]</label>
                <div class="ocat-end">
                    <select asp-for="TextToSpeechVoiceId" asp-items="Model.TextToSpeechVoices" class="form-select">
                        <option value="">@T["Use site default"]</option>
                    </select>
                    <span class="hint">@T["Leave empty to use the default text-to-speech voice. Save after changing the text-to-speech deployment to refresh its voice list."]</span>
                </div>
            </div>
        </div>

        <div class="ocat-wrapper">
            <label class="ocat-label">@T["AI permissions"]</label>
            <div class="ocat-end">
                <div class="form-check">
                    <input asp-for="AllowAIToUpdateContact" class="form-check-input" type="checkbox" />
                    <label asp-for="AllowAIToUpdateContact" class="form-check-label">@T["Allow AI to update contact"]</label>
                    <span class="hint dashed">@T["Opt-out SMS requests always update the contact's Do not SMS preference, even when contact updates are disabled."]</span>
                </div>
                <div class="form-check">
                    <input asp-for="AllowAIToUpdateSubject" class="form-check-input" type="checkbox" />
                    <label asp-for="AllowAIToUpdateSubject" class="form-check-label">@T["Allow AI to update subject"]</label>
                </div>
            </div>
        </div>

        <div class="subject-ai-sms-only@(Model.ShowSmsSettings ? string.Empty : " d-none")">
            <h6 class="mb-3">@T["SMS automation"]</h6>

            <div class="ocat-wrapper" asp-validation-class-for="NoResponseTimeoutInMinutes">
                <label asp-for="NoResponseTimeoutInMinutes" class="ocat-label">@T["No-response timeout (minutes)"]</label>
                <div class="ocat-end">
                    <input asp-for="NoResponseTimeoutInMinutes" type="number" min="1" class="form-control" />
                    <span asp-validation-for="NoResponseTimeoutInMinutes" class="text-danger"></span>
                    <span class="hint">@T["When set, an automated SMS activity is failed if the contact does not respond before this timeout."]</span>
                </div>
            </div>

            <div class="ocat-wrapper" asp-validation-class-for="SmsResponseDelayInSeconds">
                <label asp-for="SmsResponseDelayInSeconds" class="ocat-label">@T["Response delay (seconds)"]</label>
                <div class="ocat-end">
                    <input asp-for="SmsResponseDelayInSeconds" type="number" min="0" class="form-control" />
                    <span asp-validation-for="SmsResponseDelayInSeconds" class="text-danger"></span>
                    <span class="hint">@T["Optional delay before each AI SMS response is sent. Leave empty or use 0 to reply immediately."]</span>
                </div>
            </div>

            <div class="ocat-wrapper" asp-validation-class-for="SmsOptOutKeywords">
                <label asp-for="SmsOptOutKeywords" class="ocat-label">@T["Opt-out keywords"]</label>
                <div class="ocat-end">
                    <textarea asp-for="SmsOptOutKeywords" rows="3" class="form-control"></textarea>
                    <span asp-validation-for="SmsOptOutKeywords" class="text-danger"></span>
                    <span class="hint">@T["Enter one keyword per line or separate keywords with commas. Defaults include STOP, STOPALL, UNSUBSCRIBE, CANCEL, END, and QUIT."]</span>
                </div>
            </div>
        </div>
    </div>
</div>

@* Handoff applies to any automated conversation for this subject, including outbound campaigns whose AI settings
   are chosen at inventory load, so it lives in its own card rather than the inbound-only AI configuration above. *@
<div class="card mb-3 subject-ai-handoff@(Model.ShowHandoffSettings ? string.Empty : " d-none")">
    <div class="card-header">@T["Live agent handoff"]</div>
    <div class="card-body">
        <div class="ocat-wrapper">
            <div class="ocat-end-offset">
                <div class="form-check">
                    <input asp-for="EnableAgentHandoff" class="form-check-input" type="checkbox" />
                    <label asp-for="EnableAgentHandoff" class="form-check-label">@T["Allow the AI to hand off to a live agent"]</label>
                    <span class="hint dashed">@T["When enabled, the AI can escalate the conversation to a human. SMS threads move into the Messaging inbox (Messaging > Inbox) of the queue below; phone calls are placed into the queue and offered to an agent. Applies to inbound and outbound automated conversations for this subject."]</span>
                </div>
            </div>
        </div>

        <div class="ocat-wrapper" asp-validation-class-for="HandoffQueueId">
            <label asp-for="HandoffQueueId" class="ocat-label">@T["Handoff queue"]</label>
            <div class="ocat-end">
                @if (Model.HasHandoffQueuePicker)
                {
                    <select asp-for="HandoffQueueId" asp-items="Model.HandoffQueues" class="form-select">
                        <option value="">@T["Select a queue"]</option>
                    </select>
                }
                else
                {
                    <input asp-for="HandoffQueueId" class="form-control" />
                }
                <span asp-validation-for="HandoffQueueId" class="text-danger"></span>
                <span class="hint">@T["The Contact Center queue that receives escalated conversations. Handoff is only performed when this is set."]</span>
            </div>
        </div>

        <div class="ocat-wrapper">
            <label class="ocat-label">@T["Escalate when"]</label>
            <div class="ocat-end">
                <div class="form-check">
                    <input asp-for="HandoffOnUserRequest" class="form-check-input" type="checkbox" />
                    <label asp-for="HandoffOnUserRequest" class="form-check-label">@T["The customer asks for a human"]</label>
                </div>
                <div class="form-check">
                    <input asp-for="HandoffOnQualifiedLead" class="form-check-input" type="checkbox" />
                    <label asp-for="HandoffOnQualifiedLead" class="form-check-label">@T["The customer is a qualified, ready lead"]</label>
                </div>
                <div class="form-check">
                    <input asp-for="HandoffOnFrustration" class="form-check-input" type="checkbox" />
                    <label asp-for="HandoffOnFrustration" class="form-check-label">@T["The customer is frustrated or the AI cannot help"]</label>
                </div>
                <span class="hint dashed">@T["These conditions guide when the AI escalates. Select at least one, or handoff is never triggered."]</span>
            </div>
        </div>
    </div>
</div>
