@using CrestApps.OrchardCore.Omnichannel.Managements.ViewModels

@model LeadBatchFilterViewModel

@{
    var panelId = Html.IdFor(m => m.Rendered) + "_Panel";
}

<style asp-name="bootstrap-select"></style>
<script asp-name="bootstrap-select" at="Foot"></script>

<div id="@panelId" class="card text-bg-theme mb-3 d-none" data-lead-batch-filter data-lead-types="@string.Join(",", Model.LeadContentTypes)">
    <div class="card-header">@T["Lead filters"]</div>
    <div class="card-body">
        <input type="hidden" name="@Html.NameFor(m => m.Rendered)" value="true" />

        <div class="ocat-wrapper">
            <div class="ocat-label">@T["Lead status"]</div>
            <div class="ocat-end">
                @for (var i = 0; i < Model.Statuses.Count; i++)
                {
                    var status = Model.Statuses[i];
                    var id = Html.IdFor(m => m.StatusIds) + "_" + i;

                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" id="@id" name="@Html.NameFor(m => m.StatusIds)" value="@status.Value" checked="@status.Selected" />
                        <label class="form-check-label" for="@id">@status.Text</label>
                    </div>
                }
                <div class="hint">@T["Leave every status cleared to load the leads of every open status. Tick a closed status to load its leads too. Converted leads are never loaded."]</div>
            </div>
        </div>

        <div class="ocat-wrapper">
            <div class="ocat-end-offset">
                <div class="form-check">
                    <input asp-for="SkipLeadsThatAreContacts" class="form-check-input" type="checkbox" />
                    <label asp-for="SkipLeadsThatAreContacts" class="form-check-label">@T["Skip leads that are already contacts"]</label>
                    <span class="hint dashed">@T["A lead whose phone number belongs to a contact is not loaded, so a customer is not called again as a stranger."]</span>
                </div>
            </div>
        </div>

        <div class="ocat-wrapper">
            <label asp-for="ListName" class="ocat-label">@T["List"]</label>
            <div class="ocat-end">
                <select asp-for="ListName" asp-items="Model.Lists" class="selectpicker show-tick" data-style="btn-light" data-live-search="true" data-none-results-text="@T["No list matches {0}"].Value">
                    <option value="">@T["Any list"]</option>
                </select>
                <span class="hint">@T["Load only the leads of this list, for example a file imported earlier."]</span>
            </div>
        </div>

        <div class="ocat-wrapper">
            <label asp-for="SourceId" class="ocat-label">@T["Lead source"]</label>
            <div class="ocat-end">
                <select asp-for="SourceId" asp-items="Model.Sources" class="form-select">
                    <option value="">@T["Any source"]</option>
                </select>
            </div>
        </div>

        <div class="ocat-wrapper">
            <div class="ocat-label">@T["Rating"]</div>
            <div class="ocat-end">
                @for (var i = 0; i < Model.Ratings.Count; i++)
                {
                    var rating = Model.Ratings[i];
                    var id = Html.IdFor(m => m.SelectedRatings) + "_" + i;

                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" id="@id" name="@Html.NameFor(m => m.SelectedRatings)" value="@rating.Value" checked="@rating.Selected" />
                        <label class="form-check-label" for="@id">@rating.Text</label>
                    </div>
                }
            </div>
        </div>

        <div class="ocat-wrapper">
            <label class="ocat-label">@T["Lead owner"]</label>
            <div class="ocat-end">
                @await Component.InvokeAsync("UserPicker", new
                {
                    name = Html.NameFor(m => m.OwnerId).ToString(),
                    selectedValues = string.IsNullOrEmpty(Model.OwnerId) ? Array.Empty<string>() : new[] { Model.OwnerId },
                    valueType = "userId",
                    multiple = false,
                    buttonText = T["Any owner"].Value,
                    searchPlaceholder = T["Search users"].Value,
                    smallButton = false,
                })
                <span class="hint">@T["Load only the leads this user owns. Leave it empty to load the leads of every owner."]</span>
            </div>
        </div>
    </div>
</div>

<script at="Foot">
    (() => {
        const panel = document.getElementById('@panelId');
        const form = panel?.closest('form');
        const select = form?.querySelector('select[name$=".ContactContentType"], select[name="ContactContentType"]');

        if (!panel || !select) {
            return;
        }

        const leadTypes = (panel.dataset.leadTypes || '').split(',').filter(Boolean);
        const refresh = () => panel.classList.toggle('d-none', !leadTypes.includes(select.value));

        select.addEventListener('change', refresh);
        refresh();
    })();
</script>
