@using CrestApps.OrchardCore.Omnichannel.Managements.ViewModels

@model LeadStatusViewModel

<div class="ocat-wrapper">
    <label asp-for="Name" class="ocat-label">@T["Name"]</label>
    <div class="ocat-end">
        @if (Model.IsNew)
        {
            <input asp-for="Name" class="form-control" />
        }
        else
        {
            <input value="@Model.Name" class="form-control" readonly />
            <input asp-for="Name" type="hidden" />
            <span class="hint">@T["The name is fixed after creation."]</span>
        }
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="Description" class="ocat-label">@T["Description"]</label>
    <div class="ocat-end">
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="Order" class="ocat-label">@T["Order"]</label>
    <div class="ocat-end">
        <input asp-for="Order" type="number" class="form-control" />
        <span asp-validation-for="Order" class="text-danger"></span>
        <span class="hint">@T["Lists show the lowest first."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="Kind" class="ocat-label">@T["Type"]</label>
    <div class="ocat-end">
        <select asp-for="Kind" class="form-select" data-lead-status-kind>
            <option value="@LeadStatusKind.Open">@T["Open"]</option>
            <option value="@LeadStatusKind.Closed">@T["Closed"]</option>
            <option value="@LeadStatusKind.Converted">@T["Converted"]</option>
        </select>
        <span class="hint">@T["Open: leads are still worked and loaded. Closed: leads are finished without being converted, and activity loads skip them unless a load asks for them. Converted: the status a lead takes when it is converted. It cannot be chosen by hand, and only one status can be the converted status."]</span>
    </div>
</div>

<div class="ocat-wrapper" data-lead-status-default>
    <div class="ocat-end-offset">
        <div class="form-check">
            <input asp-for="IsDefault" class="form-check-input" type="checkbox" />
            <label asp-for="IsDefault" class="form-check-label">@T["A new lead starts in this status"]</label>
            <span class="hint dashed">@T["Only one status can be the default. Choosing this one clears it from the others."]</span>
            <span asp-validation-for="IsDefault" class="text-danger"></span>
        </div>
    </div>
</div>

<script at="Foot">
    (() => {
        const kind = document.querySelector('[data-lead-status-kind]');
        const defaultRow = document.querySelector('[data-lead-status-default]');

        if (!kind || !defaultRow) {
            return;
        }

        // Only an open status can be the one new leads start in.
        const refresh = () => defaultRow.classList.toggle('d-none', kind.value !== '@LeadStatusKind.Open');

        kind.addEventListener('change', refresh);
        refresh();
    })();
</script>
