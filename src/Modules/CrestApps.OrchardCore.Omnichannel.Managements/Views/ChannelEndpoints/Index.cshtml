@using CrestApps.Core.Models
@using CrestApps.OrchardCore.Core.Models
@using CrestApps.OrchardCore.Omnichannel.Core.Models
@using Microsoft.AspNetCore.Mvc.Localization
@using OrchardCore.DisplayManagement

@model ListSourceCatalogEntryViewModel<OmnichannelChannelEndpoint>

<zone Name="Title">
    <breadcrumb name="OmnichannelChannelEndpoints" title="@T["Omnichannel Addresses"]" />
</zone>

@* The form is necessary to generate an antiforgery token for the delete and toggle actions. *@
<form asp-action="Index" asp-route-pageSize="@Context.Request.Query["pageSize"]" method="post" class="no-multisubmit">
    <input type="submit" name="submit.Filter" id="submitFilter" class="visually-hidden" />

    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <div class="input-group">
                        <input id="search-box" asp-for="Options.Search" class="form-control" placeholder="@T["Search"]" type="search" autofocus autocomplete="off" />
                        <button type="submit" name="submit.Filter" class="btn btn-outline-secondary" title="@T["Search"]" aria-label="@T["Search"]"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
                    </div>
                </div>
                <div class="col-auto">
                    <button type="button" class="btn btn-secondary create" data-bs-toggle="modal" data-bs-target="#modalAddChannelEndpoint">@T["Add Address"]</button>
                </div>
            </div>
        </div>
    </div>

    @* The rows, the toolbar and the pager are rendered by the AdminList shape, in the layout (List or Grid) the site or the user picked. *@
    <admin-list name="OmnichannelChannelEndpoints" context="Model.List"
                show-select-all="false"
                empty-message="@T["<strong>Nothing here!</strong> There are no addresses at the moment."]">
        <admin-list-list item-css-class="list-group-item" />
        <admin-list-grid>
            <admin-list-column name="Name" position="20" title="@T["Name"]" />
            <admin-list-column name="Address" position="30" title="@T["Address"]" width="auto" />
            <admin-list-column name="Type" position="40" title="@T["Type"]" width="auto" />
            <admin-list-column name="Modified" position="50" title="@T["Last modified"]" width="auto" />
            <admin-list-column type="Actions" title="@T["Actions"]" />
        </admin-list-grid>
    </admin-list>
</form>

<!-- Modal -->
<div class="modal fade" id="modalAddChannelEndpoint" tabindex="-1" role="dialog" aria-labelledby="available-channel-endpoint-sources-title" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="available-channel-endpoint-sources-title">@T["What kind of address?"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @if (!Model.Sources.Any())
                {
                    <p class="p-3 mb-2 bg-warning text-white">@T["Enable a feature that uses addresses, such as Contact Center Voice or SMS Messaging Channel."]</p>
                }
                else
                {
                    <div class="row row-cols-1 row-cols-md-3 g-2">
                        @foreach (var source in Model.Sources)
                        {
                            IShape shape = await New.OmnichannelChannelEndpoint_Link(Source: source);
                            shape.Metadata.Alternates.Add("OmnichannelChannelEndpoint_Link__" + source);

                            @await DisplayAsync(shape)
                        }
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@T["Cancel"]</button>
            </div>
        </div>
    </div>
</div>
