@using CrestApps.OrchardCore.Omnichannel.Core.Models
@using CrestApps.OrchardCore.Omnichannel.Managements.ViewModels

@model FollowUpOwnerPoolSubjectActionViewModel

@{
    var containerId = Html.IdFor(m => m.Source) + "_Pool";
    var sourceId = Html.IdFor(m => m.Source);
}

<div id="@containerId" class="d-none" data-follow-up-owner-pool>
    <div class="ocat-wrapper">
        <label asp-for="Source" class="ocat-label">@T["Pool of agents"]</label>
        <div class="ocat-end">
            <select asp-for="Source" class="form-select">
                <option value="@nameof(FollowUpOwnerPoolSource.Team)">@T["Members of a team"]</option>
                <option value="@nameof(FollowUpOwnerPoolSource.Roles)">@T["Users in roles"]</option>
                <option value="@nameof(FollowUpOwnerPoolSource.Users)">@T["Specific users"]</option>
            </select>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="TeamId" data-follow-up-owner-pool-source="@nameof(FollowUpOwnerPoolSource.Team)">
        <label asp-for="TeamId" class="ocat-label ocat-label-required">@T["Team"]</label>
        <div class="ocat-end">
            <select asp-for="TeamId" asp-items="Model.Teams" class="form-select">
                <option value="">@T["Choose a team"]</option>
            </select>
            <span asp-validation-for="TeamId" class="text-danger"></span>
            <span class="hint">@T["The members of the team and of the teams under it."]</span>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="RoleNames" data-follow-up-owner-pool-source="@nameof(FollowUpOwnerPoolSource.Roles)">
        <label asp-for="RoleNames" class="ocat-label ocat-label-required">@T["Roles"]</label>
        <div class="ocat-end">
            <select asp-for="RoleNames" asp-items="Model.Roles" class="form-select" multiple size="5"></select>
            <span asp-validation-for="RoleNames" class="text-danger"></span>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="UserIds" data-follow-up-owner-pool-source="@nameof(FollowUpOwnerPoolSource.Users)">
        <label asp-for="UserIds" class="ocat-label ocat-label-required">@T["Users"]</label>
        <div class="ocat-end">
            @await Component.InvokeAsync("UserPicker", new
            {
                audience = "Staff",
                name = Html.NameFor(m => m.UserIds).ToString(),
                selectedValues = Model.UserIds,
                valueType = "userId",
                multiple = true,
                buttonText = T["Select users"].Value,
                searchPlaceholder = T["Search users"].Value,
                smallButton = false,
            })
            <span asp-validation-for="UserIds" class="text-danger"></span>
        </div>
    </div>

    <div class="ocat-wrapper">
        <label asp-for="Strategy" class="ocat-label">@T["Pick"]</label>
        <div class="ocat-end">
            <select asp-for="Strategy" class="form-select">
                <option value="@nameof(FollowUpOwnerPoolStrategy.RoundRobin)">@T["Round robin: the user given an activity longest ago"]</option>
                <option value="@nameof(FollowUpOwnerPoolStrategy.FewestOpenActivities)">@T["Fewest open activities"]</option>
            </select>
            <span class="hint">@T["When the pool has nobody to pick, the follow-up is left for any agent."]</span>
        </div>
    </div>
</div>

<script at="Foot">
    (function () {
        const container = document.getElementById('@containerId');
        const form = container?.closest('form');
        const assignment = form?.querySelector('select[data-subject-action-assignment-toggle]');
        const source = document.getElementById('@sourceId');

        if (!container || !assignment || !source) {
            return;
        }

        const toggle = () => {
            container.classList.toggle('d-none', assignment.value !== '@nameof(SubjectActionOwnerAssignmentType.Pool)');
            container.querySelectorAll('[data-follow-up-owner-pool-source]').forEach(element => {
                element.classList.toggle('d-none', element.getAttribute('data-follow-up-owner-pool-source') !== source.value);
            });
        };

        assignment.addEventListener('change', toggle);
        source.addEventListener('change', toggle);
        toggle();
    })();
</script>
