@using CrestApps.OrchardCore.Omnichannel.Managements.ViewModels

@model LeadPartViewModel

<div class="ocat-wrapper" asp-validation-class-for="StatusId">
    <label asp-for="StatusId" class="ocat-label">@T["Lead status"]</label>
    <div class="ocat-end">
        <select asp-for="StatusId" asp-items="Model.Statuses" class="form-select">
            <option value="">@T["Default status"]</option>
        </select>
        <span asp-validation-for="StatusId" class="text-danger"></span>
        <span class="hint dashed">@T["Where the lead is in qualification. A lead takes the converted status only when it is converted."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="Company">
    <label asp-for="Company" class="ocat-label">@T["Company"]</label>
    <div class="ocat-end">
        <input asp-for="Company" class="form-control" />
        <span class="hint dashed">@T["The company the lead works for. Converting the lead creates or picks an account with this name."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="Source">
    <label asp-for="Source" class="ocat-label">@T["Lead source"]</label>
    <div class="ocat-end">
        <input asp-for="Source" class="form-control" />
        <span class="hint dashed">@T["Where the lead came from, for example Web form, Purchased list or Trade show."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="ListName">
    <label asp-for="ListName" class="ocat-label">@T["List"]</label>
    <div class="ocat-end">
        <input asp-for="ListName" class="form-control" />
        <span class="hint dashed">@T["The list or import the lead arrived in, so the whole list can be loaded and reported on together."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="Rating">
    <label asp-for="Rating" class="ocat-label">@T["Rating"]</label>
    <div class="ocat-end">
        <select asp-for="Rating" asp-items="Model.Ratings" class="form-select">
            <option value="">@T["Not rated"]</option>
        </select>
    </div>
</div>

<div class="ocat-wrapper">
    <label class="ocat-label">@T["Lead owner"]</label>
    <div class="ocat-end">
        @await Component.InvokeAsync("UserPicker", new
        {
            name = Html.NameFor(m => m.OwnerId).ToString(),
            selectedValues = string.IsNullOrEmpty(Model.OwnerId) ? Array.Empty<string>() : new[] { Model.OwnerId },
            valueType = "userId",
            multiple = false,
            buttonText = T["Select an owner"].Value,
            searchPlaceholder = T["Search users"].Value,
            smallButton = false,
        })
        <span class="hint dashed">@T["The person responsible for working the lead."]</span>
    </div>
</div>
