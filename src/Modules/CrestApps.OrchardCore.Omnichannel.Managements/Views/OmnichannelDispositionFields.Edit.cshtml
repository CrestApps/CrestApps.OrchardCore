@using CrestApps.OrchardCore.Omnichannel.Core.Models
@using CrestApps.OrchardCore.Omnichannel.Managements.ViewModels

@model OmnichannelDispositionViewModel

<div class="ocat-wrapper">
    <label asp-for="Name" class="ocat-label">@T["Name"]</label>
    <div class="ocat-end">
        @if (Model.IsNew)
        {
            <input asp-for="Name" class="form-control" />
        }
        else
        {
            <input value="@Model.Name" class="form-control" readonly />
            <input asp-for="Name" type="hidden" />
            <span class="hint">@T["The disposition name is fixed after creation."]</span>
        }
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="Description" class="ocat-label">@T["Description"]</label>
    <div class="ocat-end">
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="Outcome" class="ocat-label">@T["Outcome"]</label>
    <div class="ocat-end">
        <select asp-for="Outcome" class="form-select">
            <option value="@DispositionOutcome.None">@T["None"]</option>
            <option value="@DispositionOutcome.NotInService">@T["Number not in service (dialer and automated calls)"]</option>
            <option value="@DispositionOutcome.NoAnswer">@T["No answer (dialer and automated calls)"]</option>
            <option value="@DispositionOutcome.Busy">@T["Busy (dialer and automated calls)"]</option>
            <option value="@DispositionOutcome.AnsweringMachine">@T["Answering machine (dialer and automated calls)"]</option>
            <option value="@DispositionOutcome.Rejected">@T["Rejected (dialer)"]</option>
            <option value="@DispositionOutcome.Failed">@T["Call failed (dialer)"]</option>
            <option value="@DispositionOutcome.Disconnected">@T["Disconnected before an agent joined (dialer)"]</option>
        </select>
        <span asp-validation-for="Outcome" class="text-danger"></span>
        <span class="hint">@T["Set this only when the platform should apply the disposition on its own. When a call ends in a way nobody chose, the disposition with the matching outcome in the subject's flow is applied: a number not in service, a call nobody answered, that found the line busy, that reached voicemail, that the network rejected or failed, or that the customer hung up before an agent joined. The dialer applies these to every attempt that did not reach an agent, so the agent never sees it. For a number not in service, any disposition with that outcome is used when the flow has none, and picking it also stops the number from being dialed again."]</span>
    </div>
</div>
