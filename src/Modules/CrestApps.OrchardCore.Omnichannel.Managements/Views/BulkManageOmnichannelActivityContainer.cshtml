@using CrestApps.OrchardCore.Omnichannel.Core.Models
@using CrestApps.OrchardCore.Omnichannel.Managements.ViewModels

@model BulkManageOmnichannelActivityContainer

<script asp-name="list-management-ui" at="Foot"></script>
<script asp-name="collapsible-panel" at="Foot"></script>
<script asp-name="flatpickr" at="Foot"></script>
<script asp-name="flatpickr-culture" at="Foot"></script>
<style asp-name="flatpickr"></style>

<form asp-route-area="CrestApps.OrchardCore.Omnichannel.Managements" asp-action="ManageActivities" asp-route-pageSize="@Context.Request.Query["pageSize"]" asp-controller="Activities" method="post" class="no-multisubmit" data-list-management data-selected-label="@T["selected"]" data-item-input-name="itemIds">
    <input type="submit" name="submit.Filter" id="submitFilter" class="visually-hidden" />
    <input type="submit" name="submit.BulkAction" value="Execute" class="visually-hidden" />
    <input type="hidden" name="BulkAction" id="BulkAction" value="@nameof(BulkActivityAction.None)" />

    @if (Model.Header is not null)
    {
        <div class="card text-bg-theme mb-3">
            <div class="card-header d-flex align-items-center justify-content-between">
                <button class="btn btn-sm btn-link text-decoration-none p-0 d-flex align-items-center gap-2"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#manage-activities-filters"
                        aria-expanded="true"
                        aria-controls="manage-activities-filters">
                    <i class="fa-solid fa-chevron-up" data-collapsible-panel-icon aria-hidden="true"></i>
                    <span>@T["Filters"]</span>
                </button>
            </div>
            <div class="collapse show" id="manage-activities-filters" data-collapsible-panel="omnichannel-manage-activities-filters">
                <div class="card-body">
                    <div class="row gx-2 gy-2 align-items-end">
                        @await DisplayAsync(Model.Header)
                    </div>
                </div>
            </div>
        </div>
    }

    @if (Model.BulkActions is not null)
    {
        @await DisplayAsync(Model.BulkActions)
    }

    @* The activities, the toolbar (count and select-all) and the pager are rendered by the AdminList shape, in the
       layout (List or Grid) the site or the user picked. The bulk actions are the panel above, which also offers to
       apply an action to every matching activity. *@
    <admin-list name="OmnichannelManageActivities" context="Model.List"
                empty-message="@T["No activities match the current filter criteria."]">
        <admin-list-list item-css-class="list-group-item" />
        <admin-list-grid>
            <admin-list-column type="Select" />
            <admin-list-column name="Subject" position="20" title="@T["Subject"]" />
            <admin-list-column name="Details" position="30" title="@T["Details"]" />
            <admin-list-column name="Handler" position="40" title="@T["Handled by"]" width="auto" />
            <admin-list-column type="Actions" title="@T["Actions"]" />
        </admin-list-grid>
    </admin-list>
</form>

<script at="Foot" depends-on="flatpickr, flatpickr-culture">
    document.addEventListener('DOMContentLoaded', function () {
        if (typeof flatpickr !== 'undefined') {
            flatpickr('#new-scheduled-date', flatpickrCulture.createLocalizedDateConfig('@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.ShortDatePattern', {
                altInputClass: 'form-control',
            }));
        }

        var bulkActionParams = document.getElementById('bulk-action-params');
        var bulkActionInput = document.getElementById('BulkAction');
        var bulkActionTitle = document.getElementById('bulk-action-title');
        var bulkActionDefaultTitle = bulkActionTitle ? bulkActionTitle.textContent : '';
        var bulkActionForm = bulkActionInput ? bulkActionInput.form : null;
        var applyToAllMatchingInput = document.getElementById('apply-to-all-matching');
        var dropdownItems = document.querySelectorAll('.bulk-action-item');
        var purgeConfirmed = false;
        var purgeDialogText = {
            title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Purge activities"].Value)),
            selectedMessage: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Purge the selected activities? This cannot be undone."].Value)),
            allMatchingMessage: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.Format(T["Purge all {0} matching activities? This cannot be undone."].Value, Model.TotalCount))),
            okText: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Purge"].Value)),
            cancelText: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Cancel"].Value)),
        };
        var togglePanelInputs = function (activePanel) {
            document.querySelectorAll('.bulk-action-param').forEach(function (panel) {
                var isActive = panel === activePanel;

                panel.querySelectorAll('input, select, textarea, button').forEach(function (input) {
                    input.disabled = !isActive;
                });
            });
        };

        togglePanelInputs(null);

        var resetBulkAction = function () {
            bulkActionInput.value = '@nameof(BulkActivityAction.None)';

            if (bulkActionTitle) {
                bulkActionTitle.textContent = bulkActionDefaultTitle;
            }
        };

        // Purging cannot be undone, so every submission of the Purge action (from the action menu or the
        // Execute Action button) is held until the user confirms it. The listener sits on the form itself and
        // stops the event before it reaches the admin theme's multi-submit guard on the body, which would
        // otherwise mark the form as already submitting and swallow the confirmed resubmission.
        if (bulkActionForm) {
            bulkActionForm.addEventListener('submit', function (e) {
                var isBulkActionSubmit = !e.submitter || e.submitter.name === 'submit.BulkAction';

                if (purgeConfirmed || !isBulkActionSubmit || bulkActionInput.value !== '@nameof(BulkActivityAction.Purge)') {
                    return;
                }

                e.preventDefault();
                e.stopPropagation();

                var submitter = e.submitter || bulkActionForm.querySelector('[name="submit.BulkAction"]');
                var applyToAllMatching = applyToAllMatchingInput && applyToAllMatchingInput.checked;

                confirmDialog({
                    title: purgeDialogText.title,
                    message: applyToAllMatching ? purgeDialogText.allMatchingMessage : purgeDialogText.selectedMessage,
                    okText: purgeDialogText.okText,
                    cancelText: purgeDialogText.cancelText,
                    okClass: 'btn-danger',
                    callback: function (confirmed) {
                        if (!confirmed) {
                            resetBulkAction();

                            return;
                        }

                        purgeConfirmed = true;
                        submitter.click();
                    }
                });
            });
        }

        dropdownItems.forEach(function (item) {
            item.addEventListener('click', function () {
                var action = item.dataset.bulkAction;
                var title = item.dataset.title;

                document.querySelectorAll('.bulk-action-param').forEach(function (panel) {
                    panel.classList.add('d-none');
                });

                var paramPanel = document.getElementById('params-' + action);

                if (paramPanel) {
                    paramPanel.classList.remove('d-none');
                    bulkActionParams.classList.remove('d-none');
                    togglePanelInputs(paramPanel);
                } else if (action === '@nameof(BulkActivityAction.Purge)') {
                    togglePanelInputs(null);
                    bulkActionParams.classList.add('d-none');
                    bulkActionInput.value = action;

                    // The form's submit listener asks for confirmation before anything is purged.
                    bulkActionForm.querySelector('[name="submit.BulkAction"]').click();

                    return;
                } else {
                    togglePanelInputs(null);
                }

                bulkActionInput.value = action;

                if (bulkActionTitle) {
                    bulkActionTitle.textContent = title;
                }
            });
        });
    });
</script>
