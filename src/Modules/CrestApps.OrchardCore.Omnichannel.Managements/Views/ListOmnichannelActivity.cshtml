@using CrestApps.OrchardCore.Omnichannel.Managements.ViewModels
@model ListOmnichannelActivity

@{
    var shape = new ContactNavigationAdminShapeViewModel
    {
        ContactContentItem = Model.ContactContentItem,
        ShowEdit = true,
    };
}

@await DisplayAsync(shape)

@* Each list, its toolbar and its pager are rendered by the AdminList shape, in the layout (List or Grid) the site or the user picked for it. *@
<div class="card text-bg-theme mb-3">
    <div class="card-header">
        @T["Scheduled Activities"]
    </div>
    <div class="card-body">
        <admin-list name="OmnichannelContactScheduledActivities" context="Model.ScheduledList"
                    show-select-all="false"
                    empty-message="@T["No scheduled activities."]">
            <admin-list-list item-css-class="list-group-item" />
            <admin-list-grid>
                <admin-list-column name="Subject" position="20" title="@T["Subject"]" />
                <admin-list-column name="Details" position="30" title="@T["Details"]" />
                <admin-list-column name="Handler" position="40" title="@T["Handled by"]" width="auto" />
                <admin-list-column type="Actions" title="@T["Actions"]" />
            </admin-list-grid>
        </admin-list>
    </div>
</div>

<div class="card text-bg-theme mb-3">
    <div class="card-header">
        @T["Completed Activities"]
    </div>
    <div class="card-body">
        <admin-list name="OmnichannelContactCompletedActivities" context="Model.CompletedList"
                    show-select-all="false"
                    empty-message="@T["No completed activities."]">
            <admin-list-list item-css-class="list-group-item" />
            <admin-list-grid>
                <admin-list-column name="Subject" position="20" title="@T["Subject"]" />
                <admin-list-column name="Details" position="30" title="@T["Details"]" />
                <admin-list-column name="Handler" position="40" title="@T["Completed by"]" width="auto" />
                <admin-list-column type="Actions" title="@T["Actions"]" />
            </admin-list-grid>
        </admin-list>
    </div>
</div>
