{
  "name": "OmnichannelCrmStarter",
  "displayName": "Omnichannel CRM starter",
  "description": "Enables the Omnichannel CRM and adds a ready-to-use Lead type, a Contact type that leads convert into, a Sales Opportunity type and a starter set of lead sources. The Account and Lead Source types, the lead statuses and the opportunity stages come with the feature itself. Every type can be renamed or extended afterward.",
  "author": "CrestApps",
  "website": "https://crestapps.com",
  "version": "1.0.0",
  "issetuprecipe": false,
  "categories": [ "omnichannel" ],
  "tags": [ "omnichannel", "crm", "leads", "accounts", "opportunities" ],
  "steps": [
    {
      "name": "feature",
      "enable": [
        "CrestApps.OrchardCore.Omnichannel.Managements",
        "CrestApps.OrchardCore.Omnichannel.Crm"
      ]
    },
    {
      "name": "ContentDefinition",
      "ContentTypes": [
        {
          "Name": "Contact",
          "DisplayName": "Contact",
          "Settings": {
            "ContentTypeSettings": {
              "Creatable": true,
              "Listable": true,
              "Securable": true
            }
          },
          "ContentTypePartDefinitionRecords": [
            {
              "PartName": "TitlePart",
              "Name": "TitlePart",
              "Settings": {
                "ContentTypePartSettings": {
                  "Position": "0"
                }
              }
            },
            {
              "PartName": "OmnichannelContactPart",
              "Name": "OmnichannelContactPart",
              "Settings": {
                "ContentTypePartSettings": {
                  "Position": "2"
                }
              }
            }
          ]
        },
        {
          "Name": "Lead",
          "DisplayName": "Lead",
          "Settings": {
            "ContentTypeSettings": {
              "Creatable": true,
              "Listable": true,
              "Securable": true
            }
          },
          "ContentTypePartDefinitionRecords": [
            {
              "PartName": "TitlePart",
              "Name": "TitlePart",
              "Settings": {
                "ContentTypePartSettings": {
                  "Position": "0"
                }
              }
            },
            {
              "PartName": "LeadPart",
              "Name": "LeadPart",
              "Settings": {
                "ContentTypePartSettings": {
                  "Position": "1"
                },
                "LeadPartSettings": {
                  "TargetContactContentType": "Contact",
                  "DefaultOpportunityContentType": "SalesOpportunity"
                }
              }
            },
            {
              "PartName": "OmnichannelContactPart",
              "Name": "OmnichannelContactPart",
              "Settings": {
                "ContentTypePartSettings": {
                  "Position": "2"
                }
              }
            }
          ]
        },
        {
          "Name": "SalesOpportunity",
          "DisplayName": "Sales Opportunity",
          "Settings": {
            "ContentTypeSettings": {
              "Creatable": true,
              "Listable": true,
              "Securable": true
            }
          },
          "ContentTypePartDefinitionRecords": [
            {
              "PartName": "TitlePart",
              "Name": "TitlePart",
              "Settings": {
                "ContentTypePartSettings": {
                  "Position": "0"
                }
              }
            },
            {
              "PartName": "OpportunityPart",
              "Name": "OpportunityPart",
              "Settings": {
                "ContentTypePartSettings": {
                  "Position": "1"
                }
              }
            }
          ]
        }
      ],
      "ContentParts": []
    },
    {
      "name": "content",
      "data": [
        {
          "ContentItemId": "leadsource-web-form",
          "ContentType": "LeadSource",
          "DisplayText": "Web form",
          "Latest": true,
          "Published": true,
          "TitlePart": {
            "Title": "Web form"
          }
        },
        {
          "ContentItemId": "leadsource-referral",
          "ContentType": "LeadSource",
          "DisplayText": "Referral",
          "Latest": true,
          "Published": true,
          "TitlePart": {
            "Title": "Referral"
          }
        },
        {
          "ContentItemId": "leadsource-trade-show",
          "ContentType": "LeadSource",
          "DisplayText": "Trade show",
          "Latest": true,
          "Published": true,
          "TitlePart": {
            "Title": "Trade show"
          }
        },
        {
          "ContentItemId": "leadsource-purchased-list",
          "ContentType": "LeadSource",
          "DisplayText": "Purchased list",
          "Latest": true,
          "Published": true,
          "TitlePart": {
            "Title": "Purchased list"
          }
        },
        {
          "ContentItemId": "leadsource-advertisement",
          "ContentType": "LeadSource",
          "DisplayText": "Advertisement",
          "Latest": true,
          "Published": true,
          "TitlePart": {
            "Title": "Advertisement"
          }
        },
        {
          "ContentItemId": "leadsource-cold-call",
          "ContentType": "LeadSource",
          "DisplayText": "Cold call",
          "Latest": true,
          "Published": true,
          "TitlePart": {
            "Title": "Cold call"
          }
        }
      ]
    }
  ]
}
