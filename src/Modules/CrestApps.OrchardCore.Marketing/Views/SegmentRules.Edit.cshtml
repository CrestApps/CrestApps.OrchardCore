@model SegmentEditViewModel

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <span class="hint">@T["Every rule you fill in has to hold. Leave them all blank for every customer who has bought."]</span>
    </div>
</div>
<div class="ocat-limited-wrapper">
    <label asp-for="LastOrderAtLeastDaysAgo" class="ocat-label">@T["Haven't ordered in (days)"]</label>
    <div class="ocat-limited">
        <input asp-for="LastOrderAtLeastDaysAgo" type="number" min="0" class="form-control" />
        <span class="hint">@T["Such as 90, for lapsed buyers."]</span>
    </div>
</div>
<div class="ocat-limited-wrapper">
    <label asp-for="LastOrderWithinDays" class="ocat-label">@T["Ordered in the last (days)"]</label>
    <div class="ocat-limited">
        <input asp-for="LastOrderWithinDays" type="number" min="0" class="form-control" />
    </div>
</div>
<div class="ocat-limited-wrapper">
    <label asp-for="FirstOrderWithinDays" class="ocat-label">@T["First ordered in the last (days)"]</label>
    <div class="ocat-limited">
        <input asp-for="FirstOrderWithinDays" type="number" min="0" class="form-control" />
        <span class="hint">@T["Such as 30, for new customers."]</span>
    </div>
</div>
<div class="ocat-limited-wrapper">
    <label asp-for="MinOrders" class="ocat-label">@T["At least (orders)"]</label>
    <div class="ocat-limited">
        <input asp-for="MinOrders" type="number" min="0" class="form-control" />
    </div>
</div>
<div class="ocat-limited-wrapper">
    <label asp-for="MaxOrders" class="ocat-label">@T["At most (orders)"]</label>
    <div class="ocat-limited">
        <input asp-for="MaxOrders" type="number" min="0" class="form-control" />
    </div>
</div>
<div class="ocat-limited-wrapper" asp-validation-class-for="MinSpent">
    <label asp-for="MinSpent" class="ocat-label">@T["Spent at least ({0})", Model.StoreCurrency]</label>
    <div class="ocat-limited">
        <input asp-for="MinSpent" type="number" step="0.01" min="0" class="form-control" />
        <span asp-validation-for="MinSpent" class="text-danger"></span>
    </div>
</div>
<div class="ocat-limited-wrapper" asp-validation-class-for="MaxSpent">
    <label asp-for="MaxSpent" class="ocat-label">@T["Spent at most ({0})", Model.StoreCurrency]</label>
    <div class="ocat-limited">
        <input asp-for="MaxSpent" type="number" step="0.01" min="0" class="form-control" />
        <span asp-validation-for="MaxSpent" class="text-danger"></span>
    </div>
</div>
<div class="ocat-limited-wrapper" asp-validation-class-for="Country">
    <label asp-for="Country" class="ocat-label">@T["Country"]</label>
    <div class="ocat-limited">
        <input asp-for="Country" class="form-control" maxlength="2" placeholder="@T["Any"]" />
        <span asp-validation-for="Country" class="text-danger"></span>
        <span class="hint">@T["Two letters, such as DE: where their last order went."]</span>
    </div>
</div>
