@model DataConnectionsIndexViewModel

<zone Name="Title">
    <breadcrumb name="DataConnections" title="@T["Connections"]" />
</zone>

@* The form is necessary to generate an antiforgery token for the row actions. *@
<form asp-action="Index" method="post" class="no-multisubmit" data-list-management data-selected-label="@T["selected"]" data-client-side-search="true">
    <input type="submit" name="submit.Filter" id="submitFilter" class="visually-hidden" />

    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <div class="input-group">
                        <input id="search-box" asp-for="Options.Search" class="form-control" placeholder="@T["Search"]" type="search" autofocus autocomplete="off" />
                        <button type="submit" name="submit.Filter" class="btn btn-outline-secondary" title="@T["Search"]" aria-label="@T["Search"]"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
                    </div>
                </div>
                <div class="col-auto">
                    <button type="button" class="btn btn-secondary create" data-bs-toggle="modal" data-bs-target="#modalAddConnection">@T["Add Connection"]</button>
                </div>
            </div>
        </div>
    </div>

    <admin-list name="DataConnections" context="Model.List" show-select-all="false"
                empty-message="@T["<strong>Nothing here!</strong> There are no connections yet. Add one to read an external system."]">
        <admin-list-list item-css-class="list-group-item" />
        <admin-list-grid>
            <admin-list-column name="Name" position="20" title="@T["Name"]" />
            <admin-list-column name="Connector" position="30" title="@T["Connector"]" width="auto" />
            <admin-list-column name="Modified" position="40" title="@T["Last modified"]" width="auto" />
            <admin-list-column type="Actions" title="@T["Actions"]" />
        </admin-list-grid>
    </admin-list>

    <div id="list-alert" class="alert alert-info my-3 d-none text-center" role="alert">@T["Your search returned no results."]</div>
</form>

<div class="modal fade" id="modalAddConnection" tabindex="-1" role="dialog" aria-labelledby="available-connectors-title" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="available-connectors-title">@T["Available Connectors"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Close"]"></button>
            </div>
            <div class="modal-body">
                @if (Model.Connectors.Count == 0)
                {
                    <div class="alert alert-warning mb-0" role="alert">@T["No connector is enabled. Enable a connector feature, such as <strong>HTTP API Data Connector</strong> or <strong>SQL Server Data Connector</strong>, under <strong>Configuration › Features</strong>."]</div>
                }
                else
                {
                    <div class="row row-cols-1 row-cols-md-3 g-2">
                        @foreach (var connector in Model.Connectors)
                        {
                            <div class="col">
                                <div class="card h-100">
                                    <div class="card-body">
                                        <h4>@connector.DisplayName.Value</h4>
                                        <p class="hint">@connector.Description.Value</p>
                                    </div>
                                    <div class="card-footer text-muted text-sm-end">
                                        <a class="btn btn-primary btn-sm" asp-action="Create" asp-route-id="@connector.Name">@T["Add"]</a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@T["Cancel"]</button>
            </div>
        </div>
    </div>
</div>

<script asp-name="list-management-ui" at="Foot"></script>
