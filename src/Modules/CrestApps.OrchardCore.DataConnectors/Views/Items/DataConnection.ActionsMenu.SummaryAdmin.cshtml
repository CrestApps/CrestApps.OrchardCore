@model ShapeViewModel<DataConnection>

<a asp-action="Test"
   asp-controller="DataConnections"
   asp-area="CrestApps.OrchardCore.DataConnectors"
   asp-route-id="@Model.Value.ItemId"
   class="dropdown-item"
   data-url-af="UnsafeUrl">@T["Test"]</a>
<a asp-action="Create"
   asp-controller="ConnectedDataSets"
   asp-area="CrestApps.OrchardCore.DataConnectors"
   asp-route-id="@Model.Value.ItemId"
   class="dropdown-item">@T["Add data set"]</a>
<a asp-action="Delete"
   asp-controller="DataConnections"
   asp-area="CrestApps.OrchardCore.DataConnectors"
   asp-route-id="@Model.Value.ItemId"
   class="dropdown-item text-danger"
   data-url-af="RemoveUrl UnsafeUrl"
   data-title="@T["Delete"]"
   data-message="@T["Are you sure you want to delete this connection and its credentials?"]"
   data-ok-text="@T["Yes"]"
   data-cancel-text="@T["Cancel"]">@T["Delete"]</a>
