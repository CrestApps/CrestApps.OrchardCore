<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <Title>CrestApps OrchardCore Data Connectors</Title>
    <Description>
      $(CrestAppsDescription)

      Brings data from external systems into reports and data pipelines: connections to HTTP APIs, Elasticsearch and
      media library files, and data sets read live or imported into the tenant's database on a schedule, all exposed
      through Orchard Core's data sources.
    </Description>
    <PackageTags>$(PackageTags) OrchardCoreCMS DataSources DataPipelines Connectors REST OpenID Elasticsearch</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrestApps.OrchardCore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OrchardCore.Module.Targets" />
    <PackageReference Include="OrchardCore.Admin.Abstractions" />
    <PackageReference Include="OrchardCore.Data.Abstractions" />
    <PackageReference Include="OrchardCore.Deployment.Abstractions" />
    <PackageReference Include="OrchardCore.DisplayManagement" />
    <PackageReference Include="OrchardCore.Navigation.Core" />
    <PackageReference Include="OrchardCore.Recipes.Abstractions" />
    <PackageReference Include="OrchardCore.ResourceManagement" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\CrestApps.OrchardCore.DataConnectors.Core\CrestApps.OrchardCore.DataConnectors.Core.csproj" />
  </ItemGroup>

</Project>
