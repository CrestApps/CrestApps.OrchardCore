<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <Title>CrestApps OrchardCore Learning Credentials Module</Title>
    <Description>
      $(CrestAppsDescription)

      Digital Credentials for the Learning module: credential definitions as content items, awards on a completed
      course, a passed quiz, a completed learning path, an issued certification or by hand, each an Open Badges 3.0
      credential (issuer) on the W3C Verifiable Credentials Data Model 2.0 signed as a JSON Web Token with a key from
      Orchard Core Secrets, with public endpoints, a verification page and a Bitstring Status List for revocation.
    </Description>
    <PackageTags>$(PackageTags) Learning LMS OpenBadges VerifiableCredentials</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrestApps.OrchardCore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OrchardCore.Module.Targets" />
    <PackageReference Include="OrchardCore.Admin.Abstractions" />
    <PackageReference Include="OrchardCore.ContentFields" />
