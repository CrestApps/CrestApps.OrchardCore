@model RevokeCredentialViewModel

<zone Name="Title">
    <breadcrumb name="LearningCredentialAwardRevoke" title="@T["Revoke a credential"]">
        <breadcrumb-item id="LearningCredentialAwards" route-name="LearningCredentialAwards" permission="@LearningCredentialsPermissions.ViewCredentialAwards.Name">@T["Credential awards"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form method="post" class="no-multisubmit">
    @Html.ValidationSummary(true)
    @await DisplayAsync(Model.Editor)
    <div class="action-bar-bottom">
        @if (!Model.AlreadyRevoked)
        {
            <button class="btn btn-danger" type="submit">@T["Revoke"]</button>
        }
        <a class="btn btn-secondary cancel" role="button" href="@Url.RouteUrl("LearningCredentialAward", new { id = Model.AwardId })">@T["Cancel"]</a>
    </div>
</form>
