@model RevokeCredentialViewModel

<div class="ocat-wrapper">
    <span class="ocat-label">@T["Credential"]</span>
    <div class="ocat-end">@Model.AchievementName</div>
</div>
<div class="ocat-wrapper">
    <span class="ocat-label">@T["Recipient"]</span>
    <div class="ocat-end">@(Model.RecipientName ?? T["Unknown person"].Value)</div>
</div>
@if (Model.AlreadyRevoked)
{
    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <div class="alert alert-info mb-0">@T["This credential is already revoked."]</div>
        </div>
    </div>
}
else
{
    <div class="ocat-wrapper" asp-validation-class-for="Reason">
        <label asp-for="Reason" class="ocat-label ocat-label-required">@T["Reason"]</label>
        <div class="ocat-end">
            <textarea asp-for="Reason" class="form-control" rows="3" maxlength="1000"></textarea>
            <span asp-validation-for="Reason" class="text-danger"></span>
            <span class="hint">@T["Kept with the award for staff. The verification page says the credential is revoked and when, not why."]</span>
        </div>
    </div>
    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <span class="hint">@T["A revocation cannot be undone. The status list and the verification page show it at once; copies the holder downloaded stay signed, and a verifier that checks the status list sees them revoked."]</span>
        </div>
    </div>
}
