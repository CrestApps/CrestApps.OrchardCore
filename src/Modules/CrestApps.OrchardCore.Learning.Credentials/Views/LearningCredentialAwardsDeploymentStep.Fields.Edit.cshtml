@using CrestApps.OrchardCore.Learning.Credentials.Recipes
@model ShapeViewModel<LearningCredentialAwardsDeploymentStep>

<h5>@T["Credential awards (learner records)"]</h5>
<p class="hint">@T["Exports every digital credential award as it was issued, with its signed credential, its status list slot and its revocation. People are named by user name. The credentials' addresses and signatures belong to this site. Learner records hold personal data: the export needs the Export learner records permission and is recorded."]</p>
