@model ShapeViewModel<CredentialAwardRow>

@{
    var row = Model.Value;
}

<a href="@Url.RouteUrl("LearningCredentialAward", new { id = row.Award.ItemId })">@row.Award.Achievement?.Name</a>
<div class="admin-list-secondary">@(row.RecipientName ?? (row.Award.ErasedUtc is null ? T["Unknown person"].Value : T["Personal data erased"].Value))</div>
