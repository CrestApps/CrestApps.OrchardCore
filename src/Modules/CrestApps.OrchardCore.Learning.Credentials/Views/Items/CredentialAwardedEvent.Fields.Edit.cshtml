@using CrestApps.OrchardCore.Learning.Credentials.Workflows

@model CredentialAwardedEventViewModel

<style asp-name="bootstrap-select"></style>
<script asp-name="bootstrap-select" depends-on="bootstrap" at="Foot"></script>
<div class="mb-3">
    <label asp-for="DefinitionIds" class="form-label">@T["Credentials"]</label>
    <select asp-for="DefinitionIds" asp-items="Model.DefinitionOptions" class="selectpicker show-tick" multiple data-live-search="true" data-actions-box="true" data-width="100%" data-selected-text-format="count > 3"></select>
    <span class="hint">@T["Leave empty for every credential. The workflow input holds AwardId, PublicId, DefinitionId, AchievementName, UserId, RuleKind, SourceId, IssuedUtc and ExpiresUtc; it never holds an e-mail address."]</span>
</div>
