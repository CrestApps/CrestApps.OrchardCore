@model ShapeViewModel<CredentialAwardRow>

@{
    var award = Model.Value.Award;
}

<span class="badge ta-badge fw-normal" title="@T["Issued"]"><i class="fa-regular fa-clock text-secondary me-1" aria-hidden="true"></i>@await DisplayAsync(await New.DateTime(Utc: DateTime.SpecifyKind(award.IssuedUtc, DateTimeKind.Utc), Format: "g"))</span>
@if (award.ExpiresUtc is { } expires)
{
    <span class="badge ta-badge fw-normal" title="@T["Valid until"]"><i class="fa-regular fa-calendar-xmark text-secondary me-1" aria-hidden="true"></i>@await DisplayAsync(await New.DateTime(Utc: DateTime.SpecifyKind(expires, DateTimeKind.Utc), Format: "d"))</span>
}
