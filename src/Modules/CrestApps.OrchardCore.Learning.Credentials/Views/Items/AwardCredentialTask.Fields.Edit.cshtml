@using CrestApps.OrchardCore.Learning.Credentials.Workflows

@model AwardCredentialTaskViewModel

<div class="mb-3">
    <label asp-for="DefinitionId" class="form-label">@T["Credential definition"]</label>
    <input asp-for="DefinitionId" class="form-control code" />
    <span class="hint">@T["The content item id of a published credential definition. Liquid is allowed."]</span>
</div>
<div class="mb-3">
    <label asp-for="UserId" class="form-label">@T["User id"]</label>
    <input asp-for="UserId" class="form-control code" />
    <span class="hint">@T["The person to award, such as {{ Workflow.Input.UserId }}."]</span>
</div>
<div class="mb-3">
    <label asp-for="SourceId" class="form-label">@T["Source id"]</label>
    <input asp-for="SourceId" class="form-control code" />
    <span class="hint">@T["What makes the award happen once, such as the id of the record that started the workflow. Leave empty to use the workflow instance id. A person who holds a valid award of the credential gets no second one."]</span>
</div>
