@model ShapeViewModel<CredentialAwardRow>

@{
    var row = Model.Value;
    var (css, icon, text) = row.Status switch
    {
        CredentialAwardStatus.Revoked => ("text-bg-danger", "fa-ban", T["Revoked"]),
        CredentialAwardStatus.Expired => ("text-bg-secondary", "fa-hourglass-end", T["Expired"]),
        _ => ("text-bg-success", "fa-circle-check", T["Active"]),
    };
    var rule = row.Award.RuleKind switch
    {
        CredentialsConstants.RuleKinds.CourseCompleted => T["Course completed"],
        CredentialsConstants.RuleKinds.QuizPassed => T["Quiz passed"],
        CredentialsConstants.RuleKinds.LearningPathCompleted => T["Learning path completed"],
        CredentialsConstants.RuleKinds.CertificationIssued => T["Certification issued"],
        CredentialsConstants.RuleKinds.Manual => T["By hand"],
        CredentialsConstants.RuleKinds.Workflow => T["Workflow"],
        _ => new LocalizedHtmlString(row.Award.RuleKind ?? string.Empty, row.Award.RuleKind ?? string.Empty),
    };
}

<span class="badge @css fw-normal" title="@T["Status"]"><i class="fa-solid @icon me-1" aria-hidden="true"></i>@text</span>
<span class="badge ta-badge fw-normal" title="@T["Awarded by"]"><i class="fa-solid fa-award me-1" aria-hidden="true"></i>@rule</span>
