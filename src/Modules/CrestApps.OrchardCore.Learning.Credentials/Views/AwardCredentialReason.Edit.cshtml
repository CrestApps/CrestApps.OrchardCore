@model AwardCredentialViewModel

<div class="ocat-wrapper">
    <label asp-for="Reason" class="ocat-label">@T["Reason"]</label>
    <div class="ocat-end">
        <textarea asp-for="Reason" class="form-control" rows="2" maxlength="1000"></textarea>
        <span class="hint">@T["Kept with the award for staff; the credential does not show it."]</span>
    </div>
</div>
