@model CredentialDefinitionPartViewModel

@{
    var rules = Model.Rules.ToList();
    var alignments = Model.Alignments.ToList();

    while (rules.Count < Model.Rules.Count + 2)
    {
        rules.Add(new CredentialRuleRow());
    }

    while (alignments.Count < Model.Alignments.Count + 1)
    {
        alignments.Add(new CredentialAlignmentRow());
    }

    var rulesPrefix = Html.NameFor(m => m.Rules).ToString();
    var alignmentsPrefix = Html.NameFor(m => m.Alignments).ToString();
    var groups = Model.RuleOptions.GroupBy(option => option.Group?.Name ?? string.Empty).ToList();
}

<div class="card mb-3">
    <div class="card-header">@T["Achievement"]</div>
    <div class="card-body">
        <div class="ocat-wrapper" asp-validation-class-for="Description">
            <label asp-for="Description" class="ocat-label ocat-label-required">@T["Description"]</label>
            <div class="ocat-end">
                <textarea asp-for="Description" class="form-control" rows="3" maxlength="2000"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
                <span class="hint">@T["What the holder achieved, in plain text. Wallets and the verification page show it."]</span>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="Criteria">
            <label asp-for="Criteria" class="ocat-label ocat-label-required">@T["Criteria"]</label>
            <div class="ocat-end">
                <textarea asp-for="Criteria" class="form-control" rows="3" maxlength="4000"></textarea>
                <span asp-validation-for="Criteria" class="text-danger"></span>
                <span class="hint">@T["What a person did to earn it, such as \"Completed the Forklift Safety course\"."]</span>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="AchievementType">
            <label asp-for="AchievementType" class="ocat-label">@T["Achievement type"]</label>
            <div class="ocat-end">
                <select asp-for="AchievementType" asp-items="Model.AchievementTypes" class="form-select"></select>
                <span asp-validation-for="AchievementType" class="text-danger"></span>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="Tags">
            <label asp-for="Tags" class="ocat-label">@T["Tags"]</label>
            <div class="ocat-end">
                <input asp-for="Tags" class="form-control" maxlength="1000" />
                <span asp-validation-for="Tags" class="text-danger"></span>
                <span class="hint">@T["Separate tags with commas."]</span>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="ValidityMonths">
            <label asp-for="ValidityMonths" class="ocat-label">@T["Valid for (months)"]</label>
            <div class="ocat-end">
                <input asp-for="ValidityMonths" type="number" min="1" max="1200" class="form-control" />
                <span asp-validation-for="ValidityMonths" class="text-danger"></span>
                <span class="hint">@T["Empty for a credential that does not expire. An award made later uses the value of that time."]</span>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">@T["Award rules"]</div>
    <div class="card-body">
        <div class="ocat-wrapper" asp-validation-class-for="Rules">
            <label class="ocat-label">@T["Awarded when"]</label>
            <div class="ocat-end">
                @for (var i = 0; i < rules.Count; i++)
                {
                    <select name="@(rulesPrefix)[@i].Value" class="form-select mb-2" aria-label="@T["Award rule"]">
                        <option value="">@T["No rule"]</option>
                        @foreach (var group in groups)
                        {
                            <optgroup label="@group.Key">
                                @foreach (var option in group)
                                {
                                    <option value="@option.Value" selected="@(option.Value == rules[i].Value)">@option.Text</option>
                                }
                            </optgroup>
                        }
                    </select>
                }
                <span asp-validation-for="Rules" class="text-danger"></span>
                <span class="hint">@T["Any one rule awards the credential, once per person while their award is valid. A course completion that rests on a result the browser reported does not count unless the item allows it. Staff with Award and revoke digital credentials can also award it by hand. Save to get more rows."]</span>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">@T["Alignments"]</div>
    <div class="card-body">
        @if (Model.SkillsEnabled)
        {
            <div class="ocat-wrapper">
                <label asp-for="SkillId" class="ocat-label">@T["Skill"]</label>
                <div class="ocat-end">
                    <select asp-for="SkillId" asp-items="Model.Skills" class="form-select">
                        <option value="">@T["None"]</option>
                    </select>
                    <span class="hint">@T["A skill of the site the achievement shows, stated as an alignment."]</span>
                </div>
            </div>
            <div class="ocat-wrapper">
                <label asp-for="CertificationId" class="ocat-label">@T["Certification"]</label>
                <div class="ocat-end">
                    <select asp-for="CertificationId" asp-items="Model.Certifications" class="form-select">
                        <option value="">@T["None"]</option>
                    </select>
                    <span class="hint">@T["A certification of the site the achievement relates to, stated as an alignment."]</span>
                </div>
            </div>
        }
        <div class="ocat-wrapper" asp-validation-class-for="Alignments">
            <label class="ocat-label">@T["Framework alignments"]</label>
            <div class="ocat-end">
                @for (var i = 0; i < alignments.Count; i++)
                {
                    <div class="border rounded p-2 mb-2">
                        <input name="@(alignmentsPrefix)[@i].TargetName" value="@alignments[i].TargetName" class="form-control mb-1" placeholder="@T["Name"]" aria-label="@T["Name"]" maxlength="255" />
                        <input name="@(alignmentsPrefix)[@i].TargetUrl" value="@alignments[i].TargetUrl" class="form-control mb-1" placeholder="@T["Address (https://...)"]" aria-label="@T["Address"]" maxlength="1000" />
                        <input name="@(alignmentsPrefix)[@i].TargetFramework" value="@alignments[i].TargetFramework" class="form-control mb-1" placeholder="@T["Framework"]" aria-label="@T["Framework"]" maxlength="255" />
                        <input name="@(alignmentsPrefix)[@i].TargetCode" value="@alignments[i].TargetCode" class="form-control mb-1" placeholder="@T["Code"]" aria-label="@T["Code"]" maxlength="255" />
                        <input name="@(alignmentsPrefix)[@i].TargetType" value="@alignments[i].TargetType" class="form-control" placeholder="@T["Type, such as ceasn:Competency"]" aria-label="@T["Type"]" maxlength="255" />
                    </div>
                }
                <span asp-validation-for="Alignments" class="text-danger"></span>
                <span class="hint">@T["Nodes of outside frameworks, such as competencies, the achievement meets. Leave a row empty to remove it. Save to get another row."]</span>
            </div>
        </div>
    </div>
</div>
