@model AwardCredentialViewModel

<div class="ocat-wrapper" asp-validation-class-for="DefinitionId">
    <label asp-for="DefinitionId" class="ocat-label ocat-label-required">@T["Credential"]</label>
    <div class="ocat-end">
        <select asp-for="DefinitionId" asp-items="Model.Definitions" class="form-select">
            <option value="">@T["Choose a credential"]</option>
        </select>
        <span asp-validation-for="DefinitionId" class="text-danger"></span>
        <span class="hint">@T["A published credential definition."]</span>
    </div>
</div>
<div class="ocat-wrapper" asp-validation-class-for="UserId">
    <label asp-for="UserId" class="ocat-label ocat-label-required">@T["Person"]</label>
    <div class="ocat-end">
        @await Component.InvokeAsync("UserPicker", new { name = Html.NameFor(m => m.UserId).ToString(), selectedValues = new[] { Model.UserId }, valueType = "userId", multiple = false, buttonText = T["Choose a person"].Value, searchPlaceholder = T["Search users"].Value, smallButton = false, required = true })
        <span asp-validation-for="UserId" class="text-danger"></span>
        <span class="hint">@T["The credential names the person by a salted hash of their e-mail address, so they need one."]</span>
    </div>
</div>
