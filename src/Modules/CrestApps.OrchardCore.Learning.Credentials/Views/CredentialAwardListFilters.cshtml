@*
    The filters of the credential awards list, passed to the admin list as its ToolbarActions so they render at the end
    of the list's toolbar, inside the page's GET filter form.
*@
@{
    var listModel = (CredentialAwardListViewModel)Model.ListModel;
}

<style asp-name="bootstrap-select"></style>
<script asp-name="bootstrap-select" depends-on="bootstrap" at="Foot"></script>

@* The issue dates apply with the Filter button and are days in your time zone; the pickers submit on change. *@
<div class="d-flex flex-wrap align-items-center gap-2 filter">
    <input type="date" name="Options.From" value="@listModel.Options.From" class="form-control form-control-sm w-auto" aria-label="@T["Issued from"]" title="@T["Issued from"]" />
    <input type="date" name="Options.To" value="@listModel.Options.To" class="form-control form-control-sm w-auto" aria-label="@T["Issued to"]" title="@T["Issued to"]" />
    <button type="submit" class="btn btn-sm btn-secondary">@T["Filter"]</button>
    <a asp-action="Index" class="btn btn-sm btn-link">@T["Clear"]</a>
</div>
<div class="btn-group filter">
    <select name="Options.Definition" asp-items="listModel.Definitions" class="selectpicker show-tick" data-style="btn-sm" data-width="fit" data-header="@T["Credential"]" data-dropdown-align-right="auto" aria-label="@T["Credential"]" onchange="this.form.submit()">
        <option value="">@T["Any credential"]</option>
    </select>
</div>
<div class="btn-group filter">
    <select name="Options.Status" asp-items="listModel.Statuses" class="selectpicker show-tick" data-style="btn-sm" data-width="fit" data-header="@T["Status"]" data-dropdown-align-right="auto" aria-label="@T["Status"]" onchange="this.form.submit()">
        <option value="">@T["Any status"]</option>
    </select>
</div>
