@model StructuredDataTypeSettingsViewModel

<h5>@T["Structured data"]</h5>

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" asp-for="Disabled" />
            <label class="form-check-label" asp-for="Disabled">@T["Publish no structured data"]</label>
            <span class="hint dashed">@T["When enabled, the content items of this type are left out of the page's JSON-LD and are not described to AI agents."]</span>
        </div>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="SchemaType">
    <label asp-for="SchemaType" class="ocat-label">@T["Schema.org type"]</label>
    <div class="ocat-end">
        <input asp-for="SchemaType" class="form-control" list="structured-data-schema-types" placeholder="Article" />
        <datalist id="structured-data-schema-types">
            <option value="Article"></option>
            <option value="BlogPosting"></option>
            <option value="NewsArticle"></option>
            <option value="WebPage"></option>
            <option value="FAQPage"></option>
            <option value="Event"></option>
            <option value="Product"></option>
            <option value="Recipe"></option>
            <option value="HowTo"></option>
            <option value="Course"></option>
            <option value="JobPosting"></option>
            <option value="LocalBusiness"></option>
            <option value="Organization"></option>
            <option value="Person"></option>
            <option value="Place"></option>
            <option value="Service"></option>
            <option value="SoftwareApplication"></option>
            <option value="VideoObject"></option>
        </datalist>
        <span asp-validation-for="SchemaType"></span>
        <span class="hint">@T["The schema.org type of the content items, such as Article or Event. Leave empty to let the modules that own the type choose it (a product is a Product), or to use WebPage."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="Properties">
    <label asp-for="Properties" class="ocat-label">@T["Schema.org properties"]</label>
    <div class="ocat-end">
        <textarea asp-for="Properties" class="form-control font-monospace" rows="5" placeholder="headline: {{ ContentItem.DisplayText }}&#10;author.name: {{ ContentItem.Content.BlogPost.Author.Text }}"></textarea>
        <span class="hint">@T["One property per line, written as name: Liquid. The Liquid can use ContentItem, Url and BaseUrl. A dotted name, such as offers.price, sets a nested property. A value that is a JSON object or array is written as JSON. These properties replace the ones the site sets by default: name, url, dates, language and description."]</span>
    </div>
</div>
