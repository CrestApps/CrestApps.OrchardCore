@model RequiredLearningEditViewModel

<zone Name="Title">
    <breadcrumb name="RequiredLearningEdit" title="@(string.IsNullOrEmpty(Model.Id) ? T["New Required Learning"] : T["Edit '{0}' Required Learning", Model.Name ?? string.Empty])">
        <breadcrumb-item id="RequiredLearning" action="Index" controller="RequiredLearning" area="CrestApps.OrchardCore.Learning.Programs">@T["Required Learning"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="no-multisubmit" id="required-learning-form">
    <input type="hidden" asp-for="Id" />
    @Html.ValidationSummary()

    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <button class="btn btn-primary" type="submit" name="submit" value="save">@T["Save"]</button>
        <button class="btn btn-success" type="submit" name="submit" value="run">@T["Save and run now"]</button>
        <a class="btn btn-secondary cancel" role="button" asp-action="Index">@T["Cancel"]</a>
    </div>
</form>

<script at="Foot">
    (function () {
        const form = document.getElementById('required-learning-form');
        const kind = form.querySelector('[data-target-kind]');
        const due = form.querySelector('[data-due-rule]');

        function syncTarget() {
            form.querySelectorAll('[data-target-for]').forEach(function (select) {
                const active = select.getAttribute('data-target-for') === kind.value;

                select.hidden = !active;
                select.disabled = !active;
            });
        }

        function syncDue() {
            form.querySelectorAll('[data-due-for]').forEach(function (part) {
                const active = part.getAttribute('data-due-for').split(' ').indexOf(due.value) >= 0;

                part.hidden = !active;
                part.querySelectorAll('input').forEach(function (input) { input.disabled = !active; });

                if (part.tagName === 'INPUT') {
                    part.disabled = !active;
                }
            });
        }

        kind.addEventListener('change', syncTarget);
        due.addEventListener('change', syncDue);
        syncTarget();
        syncDue();
    })();
</script>
