@model RequiredLearningExemptViewModel

<zone Name="Title">
    <breadcrumb name="RequiredLearningExempt" title="@T["Exempt {0}", Model.UserName ?? string.Empty]">
        <breadcrumb-item id="RequiredLearning" action="Index" controller="RequiredLearning" area="CrestApps.OrchardCore.Learning.Programs">@T["Required Learning"]</breadcrumb-item>
        <breadcrumb-item id="RequiredLearningPeople" action="People" controller="RequiredLearning" area="CrestApps.OrchardCore.Learning.Programs" route-id="@Model.RequirementId">@Model.RequirementName</breadcrumb-item>
    </breadcrumb>
</zone>

<form asp-action="Exempt" asp-route-id="@Model.AssignmentId" method="post" enctype="multipart/form-data" class="no-multisubmit">
    @Html.ValidationSummary()

    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <button class="btn btn-primary" type="submit">@T["Exempt"]</button>
        <a class="btn btn-secondary cancel" role="button" asp-action="People" asp-route-id="@Model.RequirementId">@T["Cancel"]</a>
    </div>
</form>
