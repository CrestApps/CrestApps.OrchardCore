@model LearningPathPeopleViewModel

<zone Name="Title">
    <breadcrumb name="LearningPathPeople" title="@T["People on the '{0}' Path", Model.PathTitle ?? string.Empty]">
        <breadcrumb-item id="LearningPaths" href="@Url.Action("List", "Admin", new { area = "OrchardCore.Contents", contentTypeId = ProgramsConstants.LearningPathContentType })">@T["Learning Paths"]</breadcrumb-item>
    </breadcrumb>
</zone>

<div class="card text-bg-theme mb-3 position-sticky action-bar">
    <div class="card-body">
        <div class="row gx-2 align-items-center">
            <div class="col">
                <form method="get" asp-action="People" asp-route-id="@Model.PathId" class="d-flex gap-2">
                    <select name="state" class="form-select" style="max-width: 14rem" onchange="this.form.submit()" aria-label="@T["State"]">
                        <option value="">@T["Every state"]</option>
                        <option value="@LearningPathState.InProgress" selected="@(Model.State == LearningPathState.InProgress)">@T["In progress"]</option>
                        <option value="@LearningPathState.Completed" selected="@(Model.State == LearningPathState.Completed)">@T["Completed"]</option>
                    </select>
                </form>
            </div>
            <div class="col-auto">
                <form method="post" asp-action="Start" asp-route-id="@Model.PathId" class="d-flex gap-2">
                    <input name="userName" class="form-control" placeholder="@T["User name"]" aria-label="@T["User name"]" required />
                    <button type="submit" class="btn btn-secondary text-nowrap">@T["Start on the Path"]</button>
                </form>
            </div>
        </div>
    </div>
</div>

<admin-list name="LearningPathPeople" context="Model.List" show-select-all="false" empty-message="@T["<strong>Nothing here!</strong> Nobody is on this path yet. Start someone above, or require the path with required learning."]">
    <admin-list-list item-css-class="list-group-item" />
    <admin-list-grid>
        <admin-list-column name="Name" position="20" title="@T["Person"]" />
        <admin-list-column name="State" position="30" title="@T["State"]" width="auto" />
    </admin-list-grid>
</admin-list>
