@model RequiredLearningEditViewModel

<div class="ocat-limited-wrapper">
    <label asp-for="DueRule" class="ocat-label">@T["Due"]</label>
    <div class="ocat-limited">
        <select asp-for="DueRule" class="form-select" data-due-rule>
            <option value="@RequiredLearningDueRule.None">@T["No due date"]</option>
            <option value="@RequiredLearningDueRule.FixedDate">@T["On a date"]</option>
            <option value="@RequiredLearningDueRule.DaysAfterRequired">@T["Some days after it is required"]</option>
            <option value="@RequiredLearningDueRule.DaysAfterHire">@T["Some days after the hire date"]</option>
        </select>
        <input asp-for="DueDate" type="date" class="form-control mt-2" data-due-for="FixedDate" aria-label="@T["Due date"]" />
        <div class="input-group mt-2" data-due-for="DaysAfterRequired DaysAfterHire">
            <input asp-for="DueDays" type="number" min="0" class="form-control" aria-label="@T["Days"]" />
            <span class="input-group-text">@T["days"]</span>
        </div>
        <span class="hint">@T["Due at the end of the day in the site's time zone. Without a hire date, days count from when it is required."]</span>
    </div>
</div>

<div class="ocat-limited-wrapper" asp-validation-class-for="ReminderDays">
    <label asp-for="ReminderDays" class="ocat-label">@T["Reminders"]</label>
    <div class="ocat-limited">
        <input asp-for="ReminderDays" class="form-control" />
        <span class="hint">@T["Days before the due date to remind the person, separated by commas, such as 14, 7, 1."]</span>
    </div>
</div>

<div class="ocat-limited-wrapper">
    <label asp-for="EscalateAfterDays" class="ocat-label">@T["Tell the manager"]</label>
    <div class="ocat-limited">
        <div class="input-group">
            <input asp-for="EscalateAfterDays" type="number" min="0" class="form-control" />
            <span class="input-group-text">@T["days after the due date"]</span>
        </div>
        <span class="hint">@T["Empty never tells the manager. The manager is the person's manager on their staff record."]</span>
    </div>
</div>
