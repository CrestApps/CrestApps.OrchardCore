@using CrestApps.OrchardCore.Learning.Programs.Workflows

@model RequireLearningTaskViewModel

<div class="mb-3">
    <label asp-for="RequirementId" class="form-label">@T["Required learning"]</label>
    <select asp-for="RequirementId" asp-items="Model.RequirementOptions" class="form-select">
        <option value="">@T["Choose a rule"]</option>
    </select>
</div>
<div class="mb-3">
    <label asp-for="UserId" class="form-label">@T["User id"]</label>
    <input asp-for="UserId" class="form-control code" />
    <span class="hint">@T["The person, such as {{ Workflow.Input.UserId }}."]</span>
</div>
<div class="mb-3">
    <label asp-for="Reason" class="form-label">@T["Reason"]</label>
    <input asp-for="Reason" class="form-control code" />
    <span class="hint">@T["Why the person is exempt. Liquid is allowed."]</span>
</div>
