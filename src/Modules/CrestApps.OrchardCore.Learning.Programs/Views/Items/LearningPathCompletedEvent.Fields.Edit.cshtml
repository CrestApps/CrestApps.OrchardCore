@using CrestApps.OrchardCore.Learning.Programs.Workflows

@model LearningPathCompletedEventViewModel

<style asp-name="bootstrap-select"></style>
<script asp-name="bootstrap-select" depends-on="bootstrap" at="Foot"></script>
<div class="mb-3">
    <label asp-for="PathIds" class="form-label">@T["Learning paths"]</label>
    <select asp-for="PathIds" asp-items="Model.PathOptions" class="selectpicker show-tick" multiple data-live-search="true" data-actions-box="true" data-width="100%" data-selected-text-format="count > 3"></select>
    <span class="hint">@T["Leave empty for every path. The workflow input holds ProgressId, PathId, UserId, Source and SourceId."]</span>
</div>
