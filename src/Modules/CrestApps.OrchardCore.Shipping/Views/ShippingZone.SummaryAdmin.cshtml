@using OrchardCore.Admin
@using OrchardCore.DisplayManagement
@* The row of the List layout. The actions sit beside the whole row, centred on it, and everything else is
   stacked in the column left of them. The Grid layout renders the zones of the row in the columns the index
   view declares. *@
<div class="row g-0 align-items-center">
    <div class="col">
        <div class="title d-flex align-items-center">
            <div class="summary d-flex flex-column flex-md-row list-item-search-text">
                <div class="me-2">
                    @if (Model.Content != null)
                    {
                        @await DisplayAsync(Model.Content)
                    }
                </div>
                @if (Model.Tags != null)
                {
                    <div class="tags me-1">
                        @await DisplayAsync(Model.Tags)
                    </div>
                }
                @if (Model.Meta != null)
                {
                    <div class="metadata me-1">
                        @await DisplayAsync(Model.Meta)
                    </div>
                }
            </div>
        </div>
        @if (Model.Description != null)
        {
            @await DisplayAsync(Model.Description)
        }
    </div>
    <div class="col-auto d-flex justify-content-end ps-2">
        @await DisplayAsync(await Factory.CreateAdminListActionsAsync((IShape)Model))
    </div>
</div>
