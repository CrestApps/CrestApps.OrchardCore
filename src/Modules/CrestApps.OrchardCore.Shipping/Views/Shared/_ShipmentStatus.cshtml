@model ShipmentStatus
@{
    // An order picked up from the store goes through the same states, read as being got ready, ready and picked up.
    var isPickup = ViewData["IsPickup"] is true;
}

@switch (Model)
{
    case ShipmentStatus.Shipped:
        <span class="badge bg-info-subtle text-info-emphasis fw-normal"><i class="fa-solid @(isPickup ? "fa-store" : "fa-truck-fast") me-1" aria-hidden="true"></i>@(isPickup ? T["Ready for pickup"] : T["Shipped"])</span>
        break;
    case ShipmentStatus.Delivered:
        <span class="badge bg-success-subtle text-success-emphasis fw-normal"><i class="fa-solid fa-house-circle-check me-1" aria-hidden="true"></i>@(isPickup ? T["Picked up"] : T["Delivered"])</span>
        break;
    case ShipmentStatus.Returned:
        <span class="badge bg-secondary-subtle text-secondary-emphasis fw-normal"><i class="fa-solid fa-rotate-left me-1" aria-hidden="true"></i>@T["Returned"]</span>
        break;
    default:
        <span class="badge bg-warning-subtle text-warning-emphasis fw-normal"><i class="fa-solid fa-box-open me-1" aria-hidden="true"></i>@(isPickup ? T["Being got ready"] : T["Being packed"])</span>
        break;
}
