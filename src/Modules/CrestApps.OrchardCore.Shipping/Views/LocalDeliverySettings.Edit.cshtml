@model LocalDeliverySettingsViewModel

<div class="ocat-wrapper" asp-validation-class-for="PostalCodes">
    <label asp-for="PostalCodes" class="ocat-label ocat-label-required">@T["Postal codes delivered to"]</label>
    <div class="ocat-end">
        <textarea asp-for="PostalCodes" rows="4" class="form-control font-monospace"></textarea>
        <span asp-validation-for="PostalCodes"></span>
        <span class="hint">@T["One per line, or separated by commas. End one with * to cover every code starting with it, such as 981*. Case, spaces and dashes are ignored."]</span>
    </div>
</div>

<div class="ocat-limited-wrapper" asp-validation-class-for="Amount">
    <label asp-for="Amount" class="ocat-label">@T["Delivery fee"]</label>
    <div class="ocat-limited">
        <input asp-for="Amount" type="number" min="0" step="any" class="form-control" />
        <span asp-validation-for="Amount"></span>
    </div>
</div>

<div class="ocat-limited-wrapper">
    <label asp-for="FreeFromSubtotal" class="ocat-label">@T["Free from an order subtotal of"]</label>
    <div class="ocat-limited">
        <input asp-for="FreeFromSubtotal" type="number" min="0" step="any" class="form-control" />
        <span class="hint">@T["Leave it empty to always charge the fee."]</span>
    </div>
</div>

<div class="ocat-limited-wrapper">
    <label asp-for="MinimumSubtotal" class="ocat-label">@T["Smallest order delivered"]</label>
    <div class="ocat-limited">
        <input asp-for="MinimumSubtotal" type="number" min="0" step="any" class="form-control" />
        <span class="hint">@T["Orders below this subtotal aren't offered local delivery. Leave it at 0 to deliver any order."]</span>
    </div>
</div>
