@model ShippingSettingsViewModel

<div class="ocat-wrapper">
    <label asp-for="WeightUnit" class="ocat-label">@T["Weight unit"]</label>
    <div class="ocat-end">
        <select asp-for="WeightUnit" class="form-select w-auto">
            <option value="@WeightUnit.Kilogram">@T["Kilograms (kg)"]</option>
            <option value="@WeightUnit.Pound">@T["Pounds (lb)"]</option>
        </select>
        <span class="hint">@T["Product weights and weight tables are in this unit. Changing it doesn't convert weights already entered."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="ShippingClasses" class="ocat-label">@T["Shipping classes"]</label>
    <div class="ocat-end">
        <textarea asp-for="ShippingClasses" rows="4" class="form-control"></textarea>
        <span class="hint">@T["One per line, such as Bulky or Fragile. A product can be put in a class, and each shipping method can charge extra for each unit in it."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="Carriers" class="ocat-label">@T["Carriers"]</label>
    <div class="ocat-end">
        <textarea asp-for="Carriers" rows="4" class="form-control font-monospace"></textarea>
        <span class="hint">@T["One per line: the carrier's name, then | and its tracking link with {0} where the tracking number goes, such as {1}. A shipment sent with the carrier gets its tracking link from here.", "{0}", "UPS | https://www.ups.com/track?tracknum={0}"]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input asp-for="SendShippedEmails" type="checkbox" class="form-check-input" />
            <label asp-for="SendShippedEmails" class="form-check-label">@T["Email the buyer when a shipment leaves"]</label>
            <span class="hint dashed">@T["With what's in the shipment, the carrier and the tracking link. Needs an email service set up."]</span>
        </div>
    </div>
</div>

<h4 class="mt-4">@T["Store pickup"]</h4>
<p class="text-body-secondary">@T["Places buyers can pick their order up from instead of having it shipped. They're offered on the checkout's Shipping step. Leave the blank location empty to add none."]</p>

@for (var i = 0; i < Model.PickupLocations.Count; i++)
{
    var isNew = string.IsNullOrEmpty(Model.PickupLocations[i].LocationId);

    <fieldset class="border rounded p-3 mb-3">
        <legend class="float-none w-auto fs-6 px-1 mb-0">@(isNew ? T["Add a pickup location"] : T["Pickup location"])</legend>
        <input type="hidden" asp-for="PickupLocations[i].LocationId" />
        <div class="row g-2">
            <div class="col-md-6" asp-validation-class-for="PickupLocations[i].Name">
                <label asp-for="PickupLocations[i].Name" class="form-label">@T["Name"]</label>
                <input asp-for="PickupLocations[i].Name" class="form-control" placeholder="@T["Downtown store"]" />
                <span asp-validation-for="PickupLocations[i].Name"></span>
            </div>
            <div class="col-md-6" asp-validation-class-for="PickupLocations[i].Fee">
                <label asp-for="PickupLocations[i].Fee" class="form-label">@T["Fee"]</label>
                <input asp-for="PickupLocations[i].Fee" type="number" min="0" step="any" class="form-control w-auto" />
                <span asp-validation-for="PickupLocations[i].Fee"></span>
            </div>
            <div class="col-12" asp-validation-class-for="PickupLocations[i].AddressLine1">
                <label asp-for="PickupLocations[i].AddressLine1" class="form-label">@T["Street address"]</label>
                <input asp-for="PickupLocations[i].AddressLine1" class="form-control" autocomplete="off" />
                <span asp-validation-for="PickupLocations[i].AddressLine1"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="PickupLocations[i].City" class="form-label">@T["City"]</label>
                <input asp-for="PickupLocations[i].City" class="form-control" autocomplete="off" />
            </div>
            <div class="col-md-3">
                <label asp-for="PickupLocations[i].Region" class="form-label">@T["State or region"]</label>
                <input asp-for="PickupLocations[i].Region" class="form-control" autocomplete="off" />
            </div>
            <div class="col-md-3">
                <label asp-for="PickupLocations[i].PostalCode" class="form-label">@T["Postal code"]</label>
                <input asp-for="PickupLocations[i].PostalCode" class="form-control" autocomplete="off" />
            </div>
            <div class="col-md-2">
                <label asp-for="PickupLocations[i].Country" class="form-label">@T["Country"]</label>
                <input asp-for="PickupLocations[i].Country" class="form-control text-uppercase" maxlength="2" placeholder="US" autocomplete="off" />
            </div>
            @if (Model.StockLocations.Count > 1)
            {
                <div class="col-md-6">
                    <label asp-for="PickupLocations[i].StockLocationId" class="form-label">@T["Stock comes from"]</label>
                    <select asp-for="PickupLocations[i].StockLocationId" class="form-select">
                        <option value="">@T["Any location"]</option>
                        @foreach (var stock in Model.StockLocations)
                        {
                            <option value="@stock.Value" selected="@(stock.Value == Model.PickupLocations[i].StockLocationId)">@stock.Text</option>
                        }
                    </select>
                    <span class="hint">@T["The inventory location orders picked up here take their units from, when it has them."]</span>
                </div>
            }
            <div class="col-12">
                <label asp-for="PickupLocations[i].Instructions" class="form-label">@T["What buyers are told"]</label>
                <input asp-for="PickupLocations[i].Instructions" class="form-control" placeholder="@T["Open 9-5, Monday to Saturday. Ready within 2 hours."]" />
                <span class="hint">@T["Shown when they choose it, and on their order."]</span>
            </div>
        </div>
        @if (!isNew)
        {
            <div class="form-check mt-2">
                <input asp-for="PickupLocations[i].Remove" type="checkbox" class="form-check-input" />
                <label asp-for="PickupLocations[i].Remove" class="form-check-label">@T["Remove this location"]</label>
            </div>
        }
    </fieldset>
}

<h4 class="mt-4">@T["Sending parcels"]</h4>
<p class="text-body-secondary">@T["Where parcels leave from and the box most orders go in, which carriers quote rates and print labels for."]</p>

<div class="row g-2 mb-3">
    <div class="col-md-6" asp-validation-class-for="ShipFromAddressLine1">
        <label asp-for="ShipFromName" class="form-label">@T["Sender's name"]</label>
        <input asp-for="ShipFromName" class="form-control" autocomplete="off" />
    </div>
    <div class="col-md-6">
        <label asp-for="ShipFromCompany" class="form-label">@T["Company"]</label>
        <input asp-for="ShipFromCompany" class="form-control" autocomplete="off" />
    </div>
    <div class="col-md-8">
        <label asp-for="ShipFromAddressLine1" class="form-label">@T["Street address"]</label>
        <input asp-for="ShipFromAddressLine1" class="form-control" autocomplete="off" />
        <span asp-validation-for="ShipFromAddressLine1"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="ShipFromAddressLine2" class="form-label">@T["Apartment, suite"]</label>
        <input asp-for="ShipFromAddressLine2" class="form-control" autocomplete="off" />
    </div>
    <div class="col-md-4">
        <label asp-for="ShipFromCity" class="form-label">@T["City"]</label>
        <input asp-for="ShipFromCity" class="form-control" autocomplete="off" />
    </div>
    <div class="col-md-3">
        <label asp-for="ShipFromRegion" class="form-label">@T["State or region"]</label>
        <input asp-for="ShipFromRegion" class="form-control" autocomplete="off" />
    </div>
    <div class="col-md-3">
        <label asp-for="ShipFromPostalCode" class="form-label">@T["Postal code"]</label>
        <input asp-for="ShipFromPostalCode" class="form-control" autocomplete="off" />
    </div>
    <div class="col-md-2">
        <label asp-for="ShipFromCountry" class="form-label">@T["Country"]</label>
        <input asp-for="ShipFromCountry" class="form-control text-uppercase" maxlength="2" placeholder="US" autocomplete="off" />
    </div>
    <div class="col-md-4">
        <label asp-for="ShipFromPhone" class="form-label">@T["Phone"]</label>
        <input asp-for="ShipFromPhone" type="tel" class="form-control" autocomplete="off" />
        <span class="hint">@T["Some carriers need one for labels."]</span>
    </div>
</div>

<div class="row g-2 mb-3">
    <div class="col-sm-6 col-md-3">
        <label asp-for="DefaultParcelLength" class="form-label">@(Model.WeightUnit == WeightUnit.Pound ? T["Box length (in)"] : T["Box length (cm)"])</label>
        <input asp-for="DefaultParcelLength" type="number" min="0" step="any" class="form-control" />
    </div>
    <div class="col-sm-6 col-md-3">
        <label asp-for="DefaultParcelWidth" class="form-label">@(Model.WeightUnit == WeightUnit.Pound ? T["Width (in)"] : T["Width (cm)"])</label>
        <input asp-for="DefaultParcelWidth" type="number" min="0" step="any" class="form-control" />
    </div>
    <div class="col-sm-6 col-md-3">
        <label asp-for="DefaultParcelHeight" class="form-label">@(Model.WeightUnit == WeightUnit.Pound ? T["Height (in)"] : T["Height (cm)"])</label>
        <input asp-for="DefaultParcelHeight" type="number" min="0" step="any" class="form-control" />
    </div>
    <div class="col-sm-6 col-md-3">
        <label asp-for="PackagingWeight" class="form-label">@(Model.WeightUnit == WeightUnit.Pound ? T["Box weight (lb)"] : T["Box weight (kg)"])</label>
        <input asp-for="PackagingWeight" type="number" min="0" step="any" class="form-control" />
    </div>
    <div class="col-12">
        <span class="hint">@T["The box size is optional: carriers price by weight without it. The box weight is added to the items' weight."]</span>
    </div>
</div>
