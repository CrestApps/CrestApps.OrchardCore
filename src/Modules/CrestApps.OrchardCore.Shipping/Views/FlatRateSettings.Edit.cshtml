@model FlatRateSettingsViewModel

<div class="ocat-limited-wrapper" asp-validation-class-for="Amount">
    <label asp-for="Amount" class="ocat-label">@T["Amount per order"]</label>
    <div class="ocat-limited">
        <input asp-for="Amount" type="number" min="0" step="any" class="form-control" />
        <span asp-validation-for="Amount"></span>
    </div>
</div>

<div class="ocat-limited-wrapper">
    <label asp-for="PerItemAmount" class="ocat-label">@T["Amount per item"]</label>
    <div class="ocat-limited">
        <input asp-for="PerItemAmount" type="number" min="0" step="any" class="form-control" />
        <span class="hint">@T["Added for each item shipped. Leave it at 0 to charge the same whatever the order holds."]</span>
    </div>
</div>
