@using CrestApps.OrchardCore.Core.Models

@model EditCatalogEntryViewModel

<zone Name="Title">
    <breadcrumb name="ServiceLevelPoliciesEdit" title="@T["Edit '{0}' Service Level Policy", Model.DisplayName]">
        <breadcrumb-item id="ServiceLevelPolicies" action="Index" controller="Policies" area="CrestApps.OrchardCore.ServiceLevels" permission="@ServiceLevelsPermissions.ManageServiceLevelPolicies.Name">@T["Service Levels"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form method="post" asp-route-id="@ViewContext.HttpContext.Request.RouteValues["id"]" class="no-multisubmit">
    @Html.ValidationSummary()
    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <button class="btn btn-primary" type="submit">@T["Save"]</button>
        <a class="btn btn-secondary cancel" role="button" asp-route-action="Index">@T["Cancel"]</a>
    </div>
</form>
