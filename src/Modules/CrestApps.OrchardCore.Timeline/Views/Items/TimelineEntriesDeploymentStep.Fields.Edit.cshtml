@using CrestApps.OrchardCore.Timeline.Deployments

@model TimelineEntriesDeploymentStepViewModel

<div class="ocat-wrapper" asp-validation-class-for="SubjectKinds">
    <label asp-for="SubjectKinds" class="ocat-label">@T["Record kinds"]</label>
    <div class="ocat-end">
        <input asp-for="SubjectKinds" class="form-control" placeholder="WorkOrder, Order" />
        <span asp-validation-for="SubjectKinds"></span>
        <span class="hint">@T["The kinds of records whose timelines are exported, separated by commas, such as WorkOrder or Order."]</span>
    </div>
</div>
