@using CrestApps.OrchardCore.Sms.Workspace.Hubs
@model SmsInboxViewModel

@{
    var filterLabel = Model.Filter switch
    {
        SmsInboxFilter.Mine => T["My conversations"],
        SmsInboxFilter.Unassigned => T["Unassigned"],
        _ => T["All conversations"],
    };

    var smsHubUrl = Html.SignalRHubUrl<SmsPortalHub>();
    var conversationUrlTemplate = Url.Action("Conversation", new { id = "__ID__" });
}

<zone Name="Title"><h1>@RenderTitleSegments(T["SMS Conversations"])</h1></zone>

<div data-list-management data-client-side-search="true">
    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-1">
                <div class="col">
                    <div class="has-search">
                        <i class="fa-solid fa-search form-control-feedback" aria-hidden="true"></i>
                        <input id="search-box" class="form-control" placeholder="@T["Search conversations"]" type="search" autofocus autocomplete="off" />
                    </div>
                </div>
                <div class="col-auto">
                    <div class="dropdown">
                        <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="@T["Filter conversations"]">
                            <i class="fa-solid fa-filter me-1" aria-hidden="true"></i>@filterLabel
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item d-flex justify-content-between align-items-center gap-3 @(Model.Filter == SmsInboxFilter.All ? "active" : string.Empty)" asp-route-action="Index" asp-route-show="all">
                                    <span>@T["All conversations"]</span>
                                    <span class="badge rounded-pill text-bg-secondary">@Model.AllCount</span>
                                </a>
                            </li>
                            @if (Model.HasAgentProfile)
                            {
                                <li>
                                    <a class="dropdown-item d-flex justify-content-between align-items-center gap-3 @(Model.Filter == SmsInboxFilter.Mine ? "active" : string.Empty)" asp-route-action="Index" asp-route-show="mine">
                                        <span>@T["My conversations"]</span>
                                        <span class="badge rounded-pill text-bg-secondary">@Model.MineCount</span>
                                    </a>
                                </li>
                            }
                            <li>
                                <a class="dropdown-item d-flex justify-content-between align-items-center gap-3 @(Model.Filter == SmsInboxFilter.Unassigned ? "active" : string.Empty)" asp-route-action="Index" asp-route-show="unassigned">
                                    <span>@T["Unassigned"]</span>
                                    <span class="badge rounded-pill text-bg-secondary">@Model.UnassignedCount</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
                @if (Model.HasAgentProfile)
                {
                    <div class="col-auto d-flex align-items-center">
                        <div class="form-check form-switch mb-0" title="@T["Accept routed SMS assignments to your inbox"]">
                            <input class="form-check-input" type="checkbox" role="switch" id="sms-available-toggle" @(Model.SmsAvailable ? "checked" : string.Empty) />
                            <label class="form-check-label" for="sms-available-toggle">@T["Available for SMS"]</label>
                        </div>
                    </div>
                }
                <div class="col-auto">
                    <a class="btn btn-secondary create" role="button" asp-route-action="New">@T["New conversation"]</a>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Rows.Count == 0)
    {
        <div class="alert alert-info">@T["Nothing here yet. Start a new conversation, or inbound messages on the numbers you serve will appear here."]</div>
    }
    else
    {
        <div class="list-group" id="sms-inbox-list">
            @foreach (var row in Model.Rows)
            {
                <a class="list-group-item list-group-item-action" asp-route-action="Conversation" asp-route-id="@row.Conversation.ItemId"
                   data-conversation-id="@row.Conversation.ItemId"
                   data-filter-value="@($"{row.Conversation.ContactAddress} {row.Conversation.ServiceAddress} {row.Conversation.LastMessagePreview}")">
                    @await DisplayAsync(row.Shape)
                </a>
            }
        </div>

        <div id="list-alert" class="alert alert-info my-3 d-none text-center" role="alert">
            @T["Your search returned no results."]
        </div>
    }
</div>

<script asp-name="list-management-ui" at="Foot"></script>

@if (Model.HasAgentProfile)
{
    <form id="sms-availability-form" class="d-none">@Html.AntiForgeryToken()</form>
    <script at="Foot">
        (function () {
            var toggle = document.getElementById('sms-available-toggle');
            if (!toggle) { return; }
            var url = '@Url.Action("SetAvailability")';
            var tokenEl = document.querySelector('#sms-availability-form input[name="__RequestVerificationToken"]');
            toggle.addEventListener('change', function () {
                var token = tokenEl ? tokenEl.value : '';
                fetch(url + '?available=' + (toggle.checked ? 'true' : 'false'), {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token }
                }).then(function (r) {
                    if (!r.ok) { toggle.checked = !toggle.checked; }
                }).catch(function () { toggle.checked = !toggle.checked; });
            });
        })();
    </script>
}

<div id="sms-toast-container" class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1090;"></div>

<script asp-name="signalr" at="Foot"></script>
<script at="Foot" depends-on="signalr"
        data-sms-hub-url="@smsHubUrl"
        data-sms-conversation-url="@conversationUrlTemplate"
        data-sms-new-message-text="@T["New message"]"
        data-sms-view-text="@T["View conversation"]">
    (function () {
        var script = document.currentScript;
        var hubUrl = script.getAttribute('data-sms-hub-url');
        var conversationUrlTemplate = script.getAttribute('data-sms-conversation-url');
        var newMessageText = script.getAttribute('data-sms-new-message-text');
        var viewText = script.getAttribute('data-sms-view-text');

        function showToast(title, body, href) {
            var container = document.getElementById('sms-toast-container');
            if (!container) { return; }

            var toast = document.createElement('div');
            toast.className = 'toast';
            toast.setAttribute('role', 'alert');
            toast.setAttribute('aria-live', 'assertive');
            toast.setAttribute('aria-atomic', 'true');

            var header = document.createElement('div');
            header.className = 'toast-header';
            header.innerHTML = '<i class="fa-solid fa-comment-sms text-primary me-2" aria-hidden="true"></i>';

            var strong = document.createElement('strong');
            strong.className = 'me-auto';
            strong.textContent = title;
            header.appendChild(strong);

            var close = document.createElement('button');
            close.type = 'button';
            close.className = 'btn-close';
            close.setAttribute('data-bs-dismiss', 'toast');
            header.appendChild(close);

            var bodyEl = document.createElement('div');
            bodyEl.className = 'toast-body';
            // textContent (not innerHTML) so message content can never inject markup.
            bodyEl.textContent = body || '';

            if (href) {
                var link = document.createElement('a');
                link.href = href;
                link.className = 'd-block mt-2 fw-semibold';
                link.textContent = viewText;
                bodyEl.appendChild(link);
            }

            toast.appendChild(header);
            toast.appendChild(bodyEl);
            container.appendChild(toast);

            if (window.bootstrap && bootstrap.Toast) {
                var instance = new bootstrap.Toast(toast, { delay: 8000 });
                instance.show();
                toast.addEventListener('hidden.bs.toast', function () { toast.remove(); });
            } else {
                toast.classList.add('show');
            }
        }

        if (window.signalR && hubUrl) {
            try {
                var connection = new signalR.HubConnectionBuilder()
                    .withUrl(hubUrl)
                    .withAutomaticReconnect()
                    .build();

                connection.on('NewInboundMessage', function (notification) {
                    if (!notification) { return; }

                    var href = notification.conversationId
                        ? conversationUrlTemplate.replace('__ID__', encodeURIComponent(notification.conversationId))
                        : null;

                    var title = notification.contactAddress
                        ? newMessageText + ' — ' + notification.contactAddress
                        : newMessageText;

                    showToast(title, notification.preview, href);
                });

                connection.start().catch(function () { /* notifications are best-effort */ });
            } catch (e) { /* SignalR unavailable */ }
        }
    })();
</script>
