@model SmsComposeViewModel

<style asp-name="bootstrap-select"></style>
<script asp-name="bootstrap-select" depends-on="bootstrap" at="Foot"></script>

<zone Name="Title"><h1>@RenderTitleSegments(T["New conversation"])</h1></zone>

<form method="post" class="no-multisubmit">
    @Html.ValidationSummary()

    <div class="mb-3">
        <label asp-for="EndpointId" class="form-label">@T["Send from (number)"]</label>
        <select asp-for="EndpointId" asp-items="Model.Endpoints" class="selectpicker show-tick" data-live-search="true" data-width="100%" title="@T["Select an SMS number"]"></select>
        <span asp-validation-for="EndpointId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ContactPhones" class="form-label">@T["To (contacts)"]</label>
        <select asp-for="ContactPhones" id="recipient-select" class="selectpicker show-tick" multiple data-live-search="true" data-width="100%" title="@T["Search contacts by name or phone…"]"></select>
        <span class="hint">@T["Type a name or phone number to search your contacts, then select one or more."]</span>
    </div>

    <div class="mb-3">
        <label asp-for="Recipients" class="form-label">@T["Additional numbers"]</label>
        <textarea asp-for="Recipients" class="form-control" rows="2" placeholder="@T["One number per line (E.164), or comma-separated"]"></textarea>
        <span class="hint">@T["One recipient starts a 1:1 conversation; multiple recipients start a group (each gets their own private 1:1 thread)."]</span>
        <span asp-validation-for="Recipients" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Body" class="form-label">@T["Message"]</label>
        <textarea asp-for="Body" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Body" class="text-danger"></span>
    </div>

    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <button class="btn btn-primary" type="submit">@T["Send"]</button>
            <a class="btn btn-secondary cancel" role="button" asp-route-action="Index">@T["Cancel"]</a>
        </div>
    </div>
</form>

<script at="Foot" depends-on="bootstrap-select">
    (function () {
        var $ = window.jQuery;
        if (!$) { return; }
        var url = '@Url.Action("SearchContacts")';

        $(function () {
            var $picker = $('#recipient-select');
            $picker.selectpicker();

            // Server-side live search: as the agent types in the picker's search box, query contacts and add
            // matching options (keeping any already-selected options so selections persist across searches).
            var $wrapper = $picker.closest('.bootstrap-select');
            var timer = null;

            $wrapper.on('input', '.bs-searchbox input', function () {
                var q = $(this).val().trim();
                clearTimeout(timer);
                if (q.length < 2) { return; }
                timer = setTimeout(function () {
                    $.getJSON(url, { q: q }).done(function (items) {
                        (items || []).forEach(function (item) {
                            if (!item.phone) { return; }
                            if ($picker.find('option[value="' + item.phone.replace(/"/g, '\\"') + '"]').length === 0) {
                                $picker.append($('<option>').attr('value', item.phone).attr('data-subtext', item.phone).text(item.name || item.phone));
                            }
                        });
                        $picker.selectpicker('refresh');
                    });
                }, 250);
            });
        });
    })();
</script>
