@using CrestApps.OrchardCore.Sms.Workspace.Models
@model SmsThreadViewModel

<zone Name="Title"><h1>@RenderTitleSegments(T["Conversation with {0}", string.IsNullOrEmpty(Model.ContactDisplayText) ? Model.Conversation.CustomerAddress : Model.ContactDisplayText])</h1></zone>

<div class="mb-2">
    @if (!string.IsNullOrEmpty(Model.ContactDisplayText))
    {
        <span class="badge bg-info text-dark">@T["Customer:"] @Model.ContactDisplayText</span>
        <a class="small ms-1" asp-action="Edit" asp-controller="Admin" asp-area="OrchardCore.Contents" asp-route-contentItemId="@Model.Conversation.ContactContentItemId">@T["view contact"]</a>
    }
    else
    {
        <span class="badge bg-secondary">@T["Unknown contact"]</span>
    }
    <span class="text-muted small ms-1">@Model.Conversation.CustomerAddress</span>
</div>

<div class="mb-2 d-flex justify-content-between align-items-center">
    <div>
        <a class="btn btn-sm btn-link" asp-route-action="Index">&laquo; @T["Back to inbox"]</a>
        <span class="text-muted small ms-2">@T["on"] @Model.Conversation.ServiceAddress &middot; @Model.Conversation.Status.ToString()</span>
    </div>
    <div class="btn-group">
        @if (Model.Conversation.Status == SmsConversationStatus.Open)
        {
            <form asp-route-action="SetStatus" asp-route-id="@Model.Conversation.ItemId" method="post" class="d-inline">
                <input type="hidden" name="status" value="@nameof(SmsConversationStatus.Closed)" />
                <button type="submit" class="btn btn-sm btn-outline-secondary">@T["Close"]</button>
            </form>
            <form asp-route-action="SetStatus" asp-route-id="@Model.Conversation.ItemId" method="post" class="d-inline">
                <input type="hidden" name="status" value="@nameof(SmsConversationStatus.Spam)" />
                <button type="submit" class="btn btn-sm btn-outline-danger">@T["Mark spam"]</button>
            </form>
        }
        else
        {
            <form asp-route-action="SetStatus" asp-route-id="@Model.Conversation.ItemId" method="post" class="d-inline">
                <input type="hidden" name="status" value="@nameof(SmsConversationStatus.Open)" />
                <button type="submit" class="btn btn-sm btn-outline-primary">@T["Reopen"]</button>
            </form>
        }
    </div>
</div>

<div class="sms-thread border rounded p-3 mb-3" style="max-height: 60vh; overflow-y: auto; background: var(--bs-tertiary-bg);">
    @if (Model.Messages.Count == 0)
    {
        <div class="text-muted">@T["No messages yet."]</div>
    }
    else
    {
        foreach (var message in Model.Messages)
        {
            var outbound = !message.IsInbound;
            <div class="d-flex mb-2 @(outbound ? "justify-content-end" : "justify-content-start")">
                <div class="p-2 rounded-3 @(outbound ? "bg-primary text-white" : "bg-white border")" style="max-width: 75%;">
                    <div>@message.Content</div>
                    <div class="small @(outbound ? "text-white-50" : "text-muted")">
                        @message.CreatedUtc.ToString("g")
                        @if (outbound && !string.IsNullOrEmpty(message.DeliveryStatus))
                        {
                            <text>&middot; @message.DeliveryStatus</text>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>

@if (Model.Conversation.AssignmentStatus != SmsConversationAssignmentStatus.Assigned)
{
    <form method="post" asp-route-action="Claim" asp-route-id="@Model.Conversation.ItemId" class="mb-2">
        <button type="submit" class="btn btn-outline-primary btn-sm">@T["Claim this conversation"]</button>
        <span class="text-muted small ms-1">@T["Claim to own it and remove it from the shared inbox."]</span>
    </form>
}

@if (Model.Conversation.Status != SmsConversationStatus.Closed && Model.Conversation.Status != SmsConversationStatus.Spam)
{
    @if (Model.Templates.Count > 0)
    {
        <div class="mb-2">
            <select class="form-select form-select-sm" style="max-width: 24rem;" id="sms-template-picker" aria-label="@T["Insert a canned response"]">
                <option value="">@T["Insert a canned response…"]</option>
                @foreach (var template in Model.Templates)
                {
                    <option value="@template.Body">@template.Name</option>
                }
            </select>
        </div>
    }
    <form method="post" asp-route-action="Send" asp-route-id="@Model.Conversation.ItemId" class="d-flex gap-2 align-items-end">
        <textarea name="body" id="sms-composer-body" class="form-control" rows="2" placeholder="@T["Type a message…"]" autofocus required></textarea>
        <button type="submit" class="btn btn-primary">@T["Send"]</button>
    </form>
    <script at="Foot">
        (function () {
            var picker = document.getElementById('sms-template-picker');
            var body = document.getElementById('sms-composer-body');
            if (picker && body) {
                picker.addEventListener('change', function () {
                    if (this.value) {
                        body.value = body.value ? (body.value + '\n' + this.value) : this.value;
                        body.focus();
                        this.selectedIndex = 0;
                    }
                });
            }
        })();
    </script>
}
else
{
    <div class="alert alert-secondary">@T["This conversation is {0} and cannot be replied to.", Model.Conversation.Status.ToString().ToLowerInvariant()]</div>
}
