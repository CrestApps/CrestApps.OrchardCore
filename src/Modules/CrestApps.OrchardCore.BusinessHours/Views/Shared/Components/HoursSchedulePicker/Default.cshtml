@model HoursSchedulePickerViewModel

@{
    var emptyText = Model.EmptyText ?? T["Choose a schedule"].Value;
}

<style asp-name="bootstrap-select"></style>
<script asp-name="bootstrap-select" depends-on="bootstrap" at="Foot"></script>

<select id="@Model.Id"
        name="@Model.InputName"
        class="selectpicker show-tick"
        required="@Model.Required"
        data-live-search="@(Model.Options.Count > 10 ? "true" : "false")"
        data-none-results-text="@T["No schedules found."]"
        data-width="100%"
        title="@emptyText">
    <option value="" data-hidden="@(Model.Required ? "true" : null)">@emptyText</option>
    @foreach (var option in Model.Options)
    {
        <option value="@option.Value" selected="@option.Selected">@(option.Missing ? T.GetString("{0} (no longer available)", option.Text).Value : option.Text)</option>
    }
</select>
