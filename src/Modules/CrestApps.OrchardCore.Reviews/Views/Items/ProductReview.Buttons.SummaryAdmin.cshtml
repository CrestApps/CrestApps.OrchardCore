@model ShapeViewModel<ProductReview>

@{
    var returnUrl = Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString;
}

@* Posted with the antiforgery token of the list form. *@
@if (Model.Value.Status != ReviewStatus.Approved)
{
    <a asp-action="Approve" asp-controller="ReviewsAdmin" asp-route-area="@ReviewsConstants.Feature" asp-route-itemId="@Model.Value.ItemId" asp-route-returnUrl="@returnUrl"
       class="btn btn-success btn-sm" data-url-af="UnsafeUrl">@T["Approve"]</a>
}
@if (Model.Value.Status != ReviewStatus.Rejected)
{
    <a asp-action="Reject" asp-controller="ReviewsAdmin" asp-route-area="@ReviewsConstants.Feature" asp-route-itemId="@Model.Value.ItemId" asp-route-returnUrl="@returnUrl"
       class="btn btn-secondary btn-sm" data-url-af="UnsafeUrl">@T["Reject"]</a>
}
<a asp-action="Delete" asp-controller="ReviewsAdmin" asp-route-area="@ReviewsConstants.Feature" asp-route-itemId="@Model.Value.ItemId" asp-route-returnUrl="@returnUrl"
   class="btn btn-danger btn-sm"
   data-title="@T["Delete"]"
   data-message="@T["Are you sure you want to delete this review?"]"
   data-ok-text="@T["Delete"]"
   data-cancel-text="@T["Cancel"]"
   data-url-af="RemoveUrl UnsafeUrl">@T["Delete"]</a>
