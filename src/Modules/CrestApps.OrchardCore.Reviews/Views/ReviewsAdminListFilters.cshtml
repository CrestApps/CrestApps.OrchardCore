@*
    The status filter of the reviews list, rendered at the end of the list's toolbar. The select names the filter form, so it
    submits it wherever the list is rendered; the commerce-admin-list script submits it when it changes.
*@
@{
    var options = (ReviewsIndexOptions)Model.Options;
}

<div class="btn-group filter">
    <select name="Options.Status" asp-items="options.Statuses" form="reviews-filter" class="selectpicker show-tick" data-style="btn-sm" data-width="fit" data-header="@T["Filter by status"]" data-dropdown-align-right="auto" data-commerce-list-filter aria-label="@T["Status"]"></select>
</div>
