@using Microsoft.AspNetCore.Html
@using OrchardCore.DisplayManagement
@using OrchardCore.DisplayManagement.Html
@model IShape

@{
    var transaction = ((TransactionPayViewModel)Model).Transaction;
    var title = string.IsNullOrEmpty(transaction.Title) ? T["Your payment"] : (IHtmlContent)new HtmlContentString(transaction.Title);
}

<zone Name="Title">
    <breadcrumb name="TransactionsPay" title="@title" />
</zone>

<style>
    @@media print {
        .no-print {
            display: none !important;
        }
    }
</style>

<div class="container my-4" style="max-width: 860px;">
    <h1 class="h3 mb-3 no-print">@title</h1>

    @await DisplayAsync(Model)
</div>
