@using OrchardCore.DisplayManagement
@model IShape

@{
    var transaction = ((TransactionPayViewModel)Model).Transaction;
    var title = string.IsNullOrEmpty(transaction.Title) ? T["Your payment"].Value : transaction.Title;
}

<zone Name="Title">
    <breadcrumb name="TransactionsPay" title="@(new Microsoft.AspNetCore.Html.HtmlContentBuilder().Append(title))" />
</zone>

<style>
    @@media print {
        .no-print {
            display: none !important;
        }
    }
</style>

<div class="container my-4" style="max-width: 860px;">
    <h1 class="h3 mb-3 no-print">@title</h1>

    @await DisplayAsync(Model)
</div>
