@* A pay link that was altered, expired, or names a transaction that no longer exists. Nothing about any transaction is
   shown, so a guessed or tampered link learns nothing. *@
<zone Name="Title">
    <breadcrumb name="TransactionsPayInvalid" title="@T["Payment link"]" />
</zone>

<div class="container my-4" style="max-width: 640px;">
    <h1 class="h3 mb-3">@T["This payment link no longer works"]</h1>
    <p>@T["The link may have expired. Sign in to pay from your transactions, or contact us for a new link."]</p>
</div>
