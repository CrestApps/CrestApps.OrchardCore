@model RefundsAdminIndexViewModel

<zone Name="Title">
    <breadcrumb name="Refunds" title="@T["Refunds"]" />
</zone>

@* The filters render in the list's toolbar, after this form, and name it with their form attribute. The list stays
   outside the form because its rows post forms of their own (Mark settled). *@
<form asp-action="Index" asp-route-pageSize="@Context.Request.Query["pageSize"]" method="post" id="refunds-filter" class="no-multisubmit">
    <input type="submit" name="submit.Filter" id="submitFilter" class="visually-hidden" />
</form>

@* The refunds, the toolbar with the filters and the pager are rendered by the AdminList shape, in the layout (List or Grid) the site or the user picked. *@
<admin-list name="Refunds" context="Model.List" show-select-all="false"
            empty-message="@T["<strong>Nothing here!</strong> There are no refunds that match the current filter."]">
    <admin-list-list item-css-class="list-group-item" />
    <admin-list-grid>
        <admin-list-column name="Amount" position="20" title="@T["Amount"]" />
        <admin-list-column name="Status" position="30" title="@T["Status"]" width="auto" />
        <admin-list-column name="Method" position="40" title="@T["Method"]" width="auto" />
        <admin-list-column name="Updated" position="50" title="@T["Updated"]" width="auto" />
        <admin-list-column name="Tax" position="60" title="@T["Tax refunded"]" width="auto" />
        <admin-list-column type="Actions" title="@T["Actions"]" />
    </admin-list-grid>
</admin-list>

<style asp-name="bootstrap-select"></style>
<script asp-name="commerce-admin-list" at="Foot"></script>
