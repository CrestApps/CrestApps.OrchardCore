@using OrchardCore.DisplayManagement.Views

@model ShapeViewModel<Transaction>

@* A plain link to the transaction's page, like the title of a content item in the Manage Content list. *@
<a asp-action="Detail" asp-route-itemId="@Model.Value.ItemId">@(string.IsNullOrEmpty(Model.Value.Title) ? T["(untitled)"].Value : Model.Value.Title)</a>
