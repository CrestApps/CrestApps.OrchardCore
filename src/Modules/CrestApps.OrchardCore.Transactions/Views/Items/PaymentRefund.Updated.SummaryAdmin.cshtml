@using OrchardCore.DisplayManagement.Views

@model ShapeViewModel<PaymentRefund>

<span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Updated"]">
    <i class="fa-regular fa-calendar text-secondary" aria-hidden="true"></i><span class="visually-hidden">@T["Updated"]</span>
    @await DisplayAsync(await New.DateTime(Utc: Model.Value.UpdatedUtc, Format: "g"))
</span>
