@using OrchardCore.DisplayManagement.Views

@model ShapeViewModel<PaymentIssue>

@{
    var issue = Model.Value;
}

@* What to do, and why it failed, can run to several sentences, so they are text that wraps, not badges. *@
@if (!string.IsNullOrEmpty(issue.Message))
{
    <div class="admin-list-secondary">
        <i class="fa-solid fa-list-check" aria-hidden="true"></i><span class="visually-hidden">@T["What to do"]</span>
        @issue.Message
    </div>
}
@if (!string.IsNullOrEmpty(issue.Error))
{
    <div class="admin-list-secondary text-danger">
        <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i><span class="visually-hidden">@T["Why it failed"]</span>
        @issue.Error
    </div>
}
@if (!string.IsNullOrEmpty(issue.ResolutionNote))
{
    <div class="admin-list-secondary text-muted">
        <i class="fa-regular fa-comment" aria-hidden="true"></i><span class="visually-hidden">@T["Resolution"]</span>
        @issue.ResolutionNote
    </div>
}
