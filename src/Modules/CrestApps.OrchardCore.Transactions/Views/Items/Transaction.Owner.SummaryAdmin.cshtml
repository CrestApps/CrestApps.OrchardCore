@* The owner's display name is resolved by the row's driver, as it needs the user store. *@
@{
    string ownerName = Model.OwnerName;
}

<span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Owner"]">
    <i class="fa-solid fa-user text-secondary" aria-hidden="true"></i><span class="visually-hidden">@T["Owner"]</span>
    @(ownerName ?? T["Unknown"].Value)
</span>
