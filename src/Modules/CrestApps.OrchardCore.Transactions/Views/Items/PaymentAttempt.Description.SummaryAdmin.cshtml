@using OrchardCore.DisplayManagement.Views

@model ShapeViewModel<PaymentAttempt>

@if (Model.Value.State == PaymentAttemptState.Failed && !string.IsNullOrEmpty(Model.Value.FailureReason))
{
    @* A gateway's reason can run to several sentences, so it is text that wraps, not a badge. *@
    <div class="admin-list-secondary text-danger">
        <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i><span class="visually-hidden">@T["Why it failed"]</span>
        @Model.Value.FailureReason
    </div>
}
