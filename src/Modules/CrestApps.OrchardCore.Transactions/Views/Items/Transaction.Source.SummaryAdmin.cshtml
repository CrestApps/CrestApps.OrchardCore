@using OrchardCore.DisplayManagement.Views

@model ShapeViewModel<Transaction>
@inject TransactionDisplayText DisplayText

@if (!string.IsNullOrEmpty(Model.Value.Source))
{
    <span class="badge ta-badge bg-primary-subtle fw-normal" data-bs-toggle="tooltip" title="@T["Source"]">
        <i class="fa-solid fa-tag text-secondary" aria-hidden="true"></i><span class="visually-hidden">@T["Source"]</span>
        @DisplayText.SourceName(Model.Value.Source)
    </span>
}
