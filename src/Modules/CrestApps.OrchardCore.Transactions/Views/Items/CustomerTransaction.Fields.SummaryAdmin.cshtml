@using OrchardCore.DisplayManagement.Views

@model ShapeViewModel<CustomerTransaction>

@* A plain link to the transaction's page, like the title of a content item in the Manage Content list. *@
<a asp-action="Detail" asp-route-itemId="@Model.Value.Transaction.ItemId">@(string.IsNullOrEmpty(Model.Value.Transaction.Title) ? T["Purchase"].Value : Model.Value.Transaction.Title)</a>
