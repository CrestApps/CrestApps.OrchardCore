@using OrchardCore.DisplayManagement.Views

@model ShapeViewModel<Transaction>
@inject OrchardCore.Modules.ILocalClock LocalClock

@functions {
    // Stored times are UTC; people read them in the site time zone.
    private async Task<DateTime> LocalAsync(DateTime utc)
        => (await LocalClock.ConvertToLocalAsync(DateTime.SpecifyKind(utc, DateTimeKind.Utc))).DateTime;
}

@if (Model.Value.DueUtc.HasValue)
{
    <span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Due"]">
        <i class="fa-regular fa-calendar text-secondary" aria-hidden="true"></i><span class="visually-hidden">@T["Due"]</span>
        @((await DocumentDates.ToSiteDueDateAsync(LocalClock, Model.Value.DueUtc.Value)).ToString("d"))
    </span>
}
