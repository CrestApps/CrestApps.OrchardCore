@using CrestApps.OrchardCore.Payments
@using OrchardCore.DisplayManagement.Views

@model ShapeViewModel<PaymentRefund>

@if (Model.Value.RefundTaxAmount > 0m)
{
    <span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Tax refunded"]">
        <i class="fa-solid fa-percent text-secondary" aria-hidden="true"></i><span class="visually-hidden">@T["Tax refunded"]</span>
        @Model.Value.Currency @CurrencyScale.Format(Model.Value.RefundTaxAmount, Model.Value.Currency)
    </span>
}
