@using CrestApps.OrchardCore.Payments
@using OrchardCore.DisplayManagement.Views

@model ShapeViewModel<PaymentAttempt>

@{
    var attempt = Model.Value;
    var tax = attempt.State == PaymentAttemptState.Succeeded ? attempt.ConfirmedTaxAmount : attempt.ExpectedTaxAmount;
}

@if (tax > 0m)
{
    <span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Tax included"]">
        <i class="fa-solid fa-percent text-secondary" aria-hidden="true"></i><span class="visually-hidden">@T["Tax included"]</span>
        @attempt.Currency @CurrencyScale.Format(tax, attempt.Currency)
    </span>
}
@if (!string.IsNullOrEmpty(attempt.ProviderReference))
{
    <span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Gateway reference"]">
        <i class="fa-solid fa-link text-secondary" aria-hidden="true"></i><span class="visually-hidden">@T["Gateway reference"]</span>
        @attempt.ProviderReference
    </span>
}
