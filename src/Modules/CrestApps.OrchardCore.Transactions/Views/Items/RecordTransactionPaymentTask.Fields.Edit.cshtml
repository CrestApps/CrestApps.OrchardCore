@using CrestApps.OrchardCore.Transactions.Workflows

@model TransactionTaskViewModel

<div class="mb-3">
    <label asp-for="TransactionId" class="form-label">@T["Transaction id"]</label>
    <input asp-for="TransactionId" class="form-control code" />
    <span class="hint">@T["The id of the transaction. In a workflow started by a transaction event, write Workflow.Input.TransactionId in Liquid."]</span>
</div>

<div class="mb-3">
    <label asp-for="Amount" class="form-label">@T["Amount"]</label>
    <input asp-for="Amount" class="form-control code" />
    <span class="hint">@T["The amount received, with a dot as the decimal separator. More than is owed is not applied."]</span>
</div>

<div class="mb-3">
    <label asp-for="PaymentMethod" class="form-label">@T["Payment method"]</label>
    <input asp-for="PaymentMethod" class="form-control code" />
    <span class="hint">@T["Optional. How the payment was made, such as Bank transfer."]</span>
</div>

<div class="mb-3">
    <label asp-for="Reference" class="form-label">@T["Reference"]</label>
    <input asp-for="Reference" class="form-control code" />
    <span class="hint">@T["Optional. Such as a check or transfer number."]</span>
</div>

<div class="mb-3">
    <label asp-for="Note" class="form-label">@T["Note"]</label>
    <input asp-for="Note" class="form-control code" />
    <span class="hint">@T["Optional. Kept on the transaction's timeline."]</span>
</div>

<div class="mb-3">
    <label asp-for="OutputName" class="form-label">@T["Output name"]</label>
    <input asp-for="OutputName" class="form-control code" />
    <span class="hint">@T["The name the transaction is saved under in the workflow output. Leave empty for Transaction."]</span>
</div>
