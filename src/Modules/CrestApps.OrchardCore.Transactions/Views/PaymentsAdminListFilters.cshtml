@*
    The state and method filters of the payments ledger, passed to the admin list as its 'ToolbarActions' so they
    render at the end of the list's toolbar. The list is rendered outside the filter form, so the selects name that
    form; the commerce-admin-list script submits it when one changes.
*@
@{
    var options = (PaymentsAdminIndexOptions)Model.Options;
}

<div class="btn-group filter">
    <select name="Options.State" asp-items="options.States" form="payments-filter" class="selectpicker show-tick me-2" data-style="btn-sm" data-width="fit" data-header="@T["Filter by state"]" data-dropdown-align-right="auto" data-commerce-list-filter aria-label="@T["State"]"></select>
    <select name="Options.ProviderKey" asp-items="options.Providers" form="payments-filter" class="selectpicker show-tick" data-style="btn-sm" data-width="fit" data-header="@T["Filter by method"]" data-dropdown-align-right="auto" data-commerce-list-filter aria-label="@T["Method"]"></select>
</div>
