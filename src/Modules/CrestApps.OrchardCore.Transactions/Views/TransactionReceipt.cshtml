@model TransactionReceiptViewModel

@*
    The TransactionReceipt shape: the printable receipt of one payment on a transaction, for the site theme. A theme
    overrides it with its own TransactionReceipt.cshtml.
*@

<style>
    @@media print {
        body * {
            visibility: hidden;
        }

        .receipt-print-area,
        .receipt-print-area * {
            visibility: visible;
        }

        .receipt-print-area {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
        }

        .no-print {
            display: none !important;
        }
    }
</style>

<div class="transaction-receipt">
    <div class="mb-3 no-print">
        <button type="button" class="btn btn-primary" onclick="window.print();">@T["Print receipt"]</button>
    </div>

    <div class="receipt-print-area">
        <partial name="~/Areas/CrestApps.OrchardCore.Receipts/Views/ReceiptDocument.cshtml" model="Model.Receipt" />
    </div>
</div>
