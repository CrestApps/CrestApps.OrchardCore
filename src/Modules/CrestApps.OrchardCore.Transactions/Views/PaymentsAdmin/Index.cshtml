@model PaymentsAdminIndexViewModel

<zone Name="Title">
    <breadcrumb name="Payments" title="@T["Payments"]" />
</zone>

@* The filters render in the list's toolbar, after this form, and name it with their form attribute. *@
<form asp-action="Index" asp-route-pageSize="@Context.Request.Query["pageSize"]" method="post" id="payments-filter" class="no-multisubmit">
    <input type="submit" name="submit.Filter" id="submitFilter" class="visually-hidden" />
</form>

@* The payments, the toolbar with the filters and the pager are rendered by the AdminList shape, in the layout (List or Grid) the site or the user picked. *@
<admin-list name="Payments" context="Model.List" show-select-all="false"
            empty-message="@T["<strong>Nothing here!</strong> There are no payments that match the current filter."]">
    <admin-list-list item-css-class="list-group-item" />
    <admin-list-grid>
        <admin-list-column name="Amount" position="20" title="@T["Amount"]" />
        <admin-list-column name="State" position="30" title="@T["State"]" width="auto" />
        <admin-list-column name="Method" position="40" title="@T["Method"]" width="auto" />
        <admin-list-column name="Updated" position="50" title="@T["Updated"]" width="auto" />
        <admin-list-column name="Details" position="60" title="@T["Details"]" width="auto" />
        <admin-list-column type="Actions" title="@T["Actions"]" />
    </admin-list-grid>
</admin-list>

<style asp-name="bootstrap-select"></style>
<script asp-name="commerce-admin-list" at="Foot"></script>
