@using CrestApps.OrchardCore.Payments
@using CrestApps.OrchardCore.Transactions.Core
@inject TransactionDisplayText DisplayText

@model RefundRequestViewModel

@{
    var attempt = Model.Attempt;
    var settled = attempt.ConfirmedAmount + attempt.ConfirmedTaxAmount;
}

<zone Name="Title">
    <breadcrumb name="TransactionsPaymentsRefund" title="@T["Refund payment"]">
        <breadcrumb-item id="TransactionsPayments" action="Index" controller="PaymentsAdmin" area="CrestApps.OrchardCore.Transactions" permission="@TransactionsPermissions.ManageRefunds.Name">@T["Payments"]</breadcrumb-item>
    </breadcrumb>
</zone>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">@T["Method"]</dt>
            <dd class="col-sm-9">@DisplayText.PaymentMethodName(attempt.ProviderKey)</dd>

            <dt class="col-sm-3">@T["Payment"]</dt>
            <dd class="col-sm-9"><span class="text-muted small">@attempt.TransactionId</span></dd>

            <dt class="col-sm-3">@T["Collected"]</dt>
            <dd class="col-sm-9">@attempt.Currency @CurrencyScale.Format(settled, attempt.Currency)</dd>

            <dt class="col-sm-3">@T["Already refunded"]</dt>
            <dd class="col-sm-9">@attempt.Currency @CurrencyScale.Format(Model.AlreadyRefunded, attempt.Currency)</dd>
        </dl>
    </div>
</div>

<form asp-action="Refund" asp-route-itemId="@attempt.ItemId" method="post">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="ocat-limited-wrapper" asp-validation-class-for="Amount">
        <label asp-for="Amount" class="ocat-label ocat-label-required">@T["Amount to refund"]</label>
        <div class="ocat-limited">
            <div class="input-group">
                <span class="input-group-text">@attempt.Currency</span>
                <input asp-for="Amount" type="number" step="0.01" min="0" class="form-control" />
            </div>
            <span class="hint">@T["The tax already collected is refunded in proportion, using the tax that applied when the payment was taken."]</span>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="Reason">
        <label asp-for="Reason" class="ocat-label">@T["Reason"]</label>
        <div class="ocat-end">
            <input asp-for="Reason" class="form-control" />
            <span class="hint">@T["Recorded on the refund so anyone reading the ledger later knows why the money went back."]</span>
        </div>
    </div>

    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <button type="submit" class="btn btn-primary"
                    data-url-af="RemoveUrl" data-title="@T["Refund the customer"]" data-message="@T["Send this refund to the customer's original payment method? It cannot be undone."]" data-ok-text="@T["Refund"]" data-cancel-text="@T["Cancel"]">
                @T["Refund"]
            </button>
            <a class="btn btn-secondary" asp-action="Index">@T["Cancel"]</a>
        </div>
    </div>
</form>
