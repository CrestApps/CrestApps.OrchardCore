@using CrestApps.OrchardCore.Currencies
@using CrestApps.OrchardCore.Transactions.Core.Services
@using CrestApps.OrchardCore.Payments
@using CrestApps.OrchardCore.Transactions.Core
@model TransactionDetailViewModel
@inject OrchardCore.Modules.ILocalClock LocalClock
@inject TransactionDisplayText DisplayText

@* The buttons below ask with data-confirm (the crestapps-browser helpers), which lets the browser check the fields first. *@
<script asp-name="crestapps-browser" at="Foot"></script>

@{
    var transaction = Model.Transaction;
    var localNow = (await LocalClock.GetLocalNowAsync()).DateTime.ToString("yyyy-MM-ddTHH:mm", System.Globalization.CultureInfo.InvariantCulture);

    // The same rules the actions apply, so a button is only offered when pressing it would work.
    var canRecordPayment = TransactionStateMachine.CanRecordPayment(transaction);
    var canMarkPaid = TransactionStateMachine.CanMarkPaid(transaction);
    var canCancel = TransactionStateMachine.CanCancel(transaction);
    var canSendReminder = TransactionStateMachine.CanSendReminder(transaction);
    var canAdjust = TransactionStateMachine.CanAdjust(transaction);
    var canSendInvoice = TransactionStateMachine.CanSendInvoice(transaction);

    var amountStep = CurrencyScale.GetInputStep(transaction.Currency);
}

@if (Model.CanManage)
{
    @if (transaction.AutoCharge is { } autoCharge)
    {
        <div class="card mb-3">
            <div class="card-header">@T["Charged to a saved card"]</div>
            <div class="card-body">
                <p class="mb-1">
                    @T["{0} is charged on {1}.", transaction.AutoCollection?.PaymentMethodDescription ?? T["The saved card"].Value, (await LocalClock.ConvertToLocalAsync(DateTime.SpecifyKind(autoCharge.NextAttemptUtc, DateTimeKind.Utc))).DateTime.ToString("g")]
                </p>
                @if (autoCharge.Attempts > 0)
                {
                    <p class="text-muted mb-1">@T["Charges declined so far: {0}. The last reason: {1}", autoCharge.Attempts, autoCharge.LastFailure]</p>
                }
                <form asp-action="CancelAutoCharge" method="post" class="mt-2 no-multisubmit">
                    <input type="hidden" name="itemId" value="@transaction.ItemId" />
                    <button type="submit" class="btn btn-outline-danger"
                            data-url-af="RemoveUrl UnsafeUrl" data-title="@T["Cancel the charge"]" data-message="@T["The card is not charged, and the owner pays the balance themselves."]" data-ok-text="@T["Cancel the charge"]" data-cancel-text="@T["Keep it"]">
                        @T["Cancel the charge"]
                    </button>
                </form>
            </div>
        </div>
    }

    @if (TransactionStateMachine.IsCollectable(transaction.Status) && transaction.OutstandingAmount > 0m)
    {
        <div class="card mb-3">
            <div class="card-header">@T["Scheduled reminders"]</div>
            <div class="card-body">
                <p class="text-muted">
                    @(transaction.RemindersPaused
                        ? T["Paused: the owner gets no scheduled reminder for this balance until they are resumed."]
                        : T["The owner is reminded of this balance on the schedule set under Settings > Commerce > Transactions."])
                </p>
                <form asp-action="PauseReminders" method="post">
                    <input type="hidden" name="itemId" value="@transaction.ItemId" />
                    <input type="hidden" name="paused" value="@(transaction.RemindersPaused ? "false" : "true")" />
                    <button type="submit" class="btn btn-outline-secondary">@(transaction.RemindersPaused ? T["Resume reminders"] : T["Pause reminders"])</button>
                </form>
            </div>
        </div>
    }

    @if (Model.CanSendReminder)
    {
        <div class="card mb-3">
            <div class="card-header">@T["Send a reminder"]</div>
            <div class="card-body">
                <p class="text-muted">@T["Notify the owner about the outstanding balance through their preferred notification channel."]</p>
                <form asp-action="SendReminder" method="post">
                    <input type="hidden" name="itemId" value="@transaction.ItemId" />
                    <button type="submit" class="btn btn-primary" disabled="@(!canSendReminder)"
                            data-url-af="RemoveUrl" data-title="@T["Send reminder"]" data-confirm="@T["Send the owner a reminder about the {0} {1} still owed?", transaction.Currency, CurrencyScale.Format(transaction.OutstandingAmount, transaction.Currency)]" data-ok-text="@T["Send reminder"]" data-cancel-text="@T["Cancel"]">
                        @T["Send reminder"]
                    </button>
                </form>
            </div>
        </div>

        @if (transaction.AutoCollection is null)
        {
            <div class="card mb-3">
                <div class="card-header">@T["Send the invoice"]</div>
                <div class="card-body">
                    <p class="text-muted">@T["Send the owner the invoice now, with a link that pays it. It counts as the first notice, so the next reminder waits the reminder interval."]</p>
                    <form asp-action="SendInvoice" method="post">
                        <input type="hidden" name="itemId" value="@transaction.ItemId" />
                        <button type="submit" class="btn btn-primary" disabled="@(!canSendInvoice)"
                                data-url-af="RemoveUrl" data-title="@T["Send invoice"]" data-confirm="@T["Send the owner the invoice for the {0} {1} still owed?", transaction.Currency, CurrencyScale.Format(transaction.OutstandingAmount, transaction.Currency)]" data-ok-text="@T["Send invoice"]" data-cancel-text="@T["Cancel"]">
                            @T["Send invoice"]
                        </button>
                    </form>
                </div>
            </div>
        }
    }

    <div class="card mb-3">
        <div class="card-header">@T["Record an offline payment"]</div>
        <div class="card-body">
            <form asp-action="RecordPayment" method="post" class="no-multisubmit">
                <input type="hidden" name="TransactionId" value="@transaction.ItemId" />
                <div class="mb-2">
                    <label class="form-label ocat-label-required" for="Amount">@T["Amount"]</label>
                    <input type="number" step="@amountStep" min="0" class="form-control" id="Amount" name="Amount" value="@CurrencyScale.Round(transaction.OutstandingAmount, transaction.Currency).ToString(System.Globalization.CultureInfo.InvariantCulture)" disabled="@(!canRecordPayment)" />
                </div>
                <div class="mb-2">
                    <label class="form-label" for="PaymentMethod">@T["Payment method"]</label>
                    <input type="text" class="form-control" id="PaymentMethod" name="PaymentMethod" maxlength="100" list="PaymentMethodSuggestions" autocomplete="off" placeholder="@T["Pick one or type another (optional)"]" />
                    <datalist id="PaymentMethodSuggestions">
                        @foreach (var method in TransactionsConstants.OfflinePaymentMethods.All)
                        {
                            <option value="@DisplayText.OfflinePaymentMethodName(method)"></option>
                        }
                    </datalist>
                    <div class="form-text">@T["A common method is saved with a fixed key, so reports group it the same in every language."]</div>
                </div>
                <div class="mb-2">
                    <label class="form-label" for="ReceivedAt">@T["Received"]</label>
                    <input type="datetime-local" class="form-control" id="ReceivedAt" name="ReceivedAt" value="@localNow" />
                    <div class="form-text">@T["When the money arrived, in the site's time zone."]</div>
                </div>
                <div class="mb-2">
                    <label class="form-label" for="Reference">@T["Reference"]</label>
                    <input type="text" class="form-control" id="Reference" name="Reference" placeholder="@T["Check number or transfer reference (optional)"]" />
                </div>
                <div class="mb-2">
                    <label class="form-label" for="Note">@T["Note"]</label>
                    <input type="text" class="form-control" id="Note" name="Note" placeholder="@T["Anything else about the payment (optional)"]" />
                </div>
                @if (Model.CanHoldCredit)
                {
                    <div class="mb-2">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="CreditExcess" name="CreditExcess" value="true" />
                            <label class="form-check-label" for="CreditExcess">@T["Keep anything above what is owed as customer credit"]</label>
                            <span class="hint dashed">@T["When more is received than the {0} {1} owed, the rest is added to the customer's credit. Otherwise only what is owed is recorded.", transaction.Currency, CurrencyScale.Format(transaction.OutstandingAmount, transaction.Currency)]</span>
                        </div>
                    </div>
                }
                <button type="submit" class="btn btn-success" disabled="@(!canRecordPayment)"
                        data-confirm-title="@T["Record payment"]" data-confirm="@T["Record this payment against the transaction? It counts as received."]" data-confirm-ok="@T["Record payment"]" data-confirm-cancel="@T["Cancel"]">
                    @T["Record payment"]
                </button>
            </form>
        </div>
    </div>

    @if (Model.CanHoldCredit && Model.CreditBalance > 0m)
    {
        var creditToApply = CurrencyScale.Round(Math.Min(Model.CreditBalance, transaction.OutstandingAmount), transaction.Currency);

        <div class="card mb-3">
            <div class="card-header">@T["Apply customer credit"]</div>
            <div class="card-body">
                <p class="text-muted">@T["The customer has {0} {1} of credit. Applying it pays toward this transaction like any other payment.", transaction.Currency, CurrencyScale.Format(Model.CreditBalance, transaction.Currency)]</p>
                <form asp-action="ApplyCredit" method="post" class="no-multisubmit">
                    <input type="hidden" name="TransactionId" value="@transaction.ItemId" />
                    <div class="mb-2">
                        <label class="form-label ocat-label-required" for="CreditAmount">@T["Amount"]</label>
                        <input type="number" step="@amountStep" min="0" class="form-control" id="CreditAmount" name="Amount" value="@creditToApply.ToString(System.Globalization.CultureInfo.InvariantCulture)" disabled="@(!canRecordPayment)" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label" for="CreditNote">@T["Note"]</label>
                        <input type="text" class="form-control" id="CreditNote" name="Note" placeholder="@T["Anything else about the payment (optional)"]" disabled="@(!canRecordPayment)" />
                    </div>
                    <button type="submit" class="btn btn-success" disabled="@(!canRecordPayment)"
                            data-confirm-title="@T["Apply credit"]" data-confirm="@T["Pay toward this transaction with the customer's credit?"]" data-confirm-ok="@T["Apply credit"]" data-confirm-cancel="@T["Cancel"]">
                        @T["Apply credit"]
                    </button>
                </form>
            </div>
        </div>
    }

    <div class="card mb-3">
        <div class="card-header">@T["Adjust or waive"]</div>
        <div class="card-body">
            <p class="text-muted">@T["Lower what is owed without money being received, for example financial aid or a discount given after the fact."]</p>
            <form asp-action="Adjust" method="post" class="no-multisubmit">
                <input type="hidden" name="TransactionId" value="@transaction.ItemId" />
                <div class="mb-2">
                    <label class="form-label" for="AdjustmentKind">@T["Type"]</label>
                    <select class="form-select" id="AdjustmentKind" name="Kind" disabled="@(!canAdjust)">
                        <option value="@TransactionAdjustmentKind.Discount">@T["Discount"]</option>
                        <option value="@TransactionAdjustmentKind.Waiver">@T["Waiver"]</option>
                        <option value="@TransactionAdjustmentKind.Credit">@T["Credit"]</option>
                        <option value="@TransactionAdjustmentKind.WriteOff">@T["Write-off"]</option>
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label ocat-label-required" for="AdjustmentAmount">@T["Amount"]</label>
                    <input type="number" step="@amountStep" min="0" class="form-control" id="AdjustmentAmount" name="Amount" value="@CurrencyScale.Round(transaction.OutstandingAmount, transaction.Currency).ToString(System.Globalization.CultureInfo.InvariantCulture)" disabled="@(!canAdjust)" />
                    <div class="form-text">@T["At most the {0} {1} still owed.", transaction.Currency, CurrencyScale.Format(transaction.OutstandingAmount, transaction.Currency)]</div>
                </div>
                <div class="mb-2">
                    <label class="form-label" for="AdjustmentReason">@T["Reason"]</label>
                    <input type="text" class="form-control" id="AdjustmentReason" name="Reason" placeholder="@T["Shown on the invoice (optional)"]" disabled="@(!canAdjust)" />
                </div>
                <button type="submit" class="btn btn-outline-primary" disabled="@(!canAdjust)"
                        data-confirm-title="@T["Adjust"]" data-confirm="@T["Take this amount off what is owed? It is not counted as money received."]" data-confirm-ok="@T["Adjust"]" data-confirm-cancel="@T["Cancel"]">
                    @T["Adjust"]
                </button>
            </form>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body d-grid gap-2">
            <form asp-action="MarkPaid" method="post" class="no-multisubmit">
                <input type="hidden" name="itemId" value="@transaction.ItemId" />
                <button type="submit" class="btn btn-outline-success w-100" disabled="@(!canMarkPaid)"
                        data-url-af="RemoveUrl" data-title="@T["Mark as paid"]" data-message="@T["Are you sure you want to mark this transaction as fully paid?"]" data-ok-text="@T["Mark as paid"]" data-cancel-text="@T["Cancel"]">
                    @T["Mark as paid"]
                </button>
            </form>
            <form asp-action="Cancel" method="post" class="no-multisubmit">
                <input type="hidden" name="itemId" value="@transaction.ItemId" />
                <input type="text" class="form-control mb-2" name="note" placeholder="@T["Cancellation reason (optional)"]" disabled="@(!canCancel)" />
                <button type="submit" class="btn btn-outline-danger w-100" disabled="@(!canCancel)"
                        data-url-af="RemoveUrl" data-title="@T["Cancel transaction"]" data-message="@T["Are you sure you want to cancel this transaction? Nothing more will be collected for it."]" data-ok-text="@T["Cancel transaction"]" data-cancel-text="@T["Keep it"]">
                    @T["Cancel transaction"]
                </button>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header">@T["Add a note"]</div>
        <div class="card-body">
            <form asp-action="AddNote" method="post">
                <input type="hidden" name="itemId" value="@transaction.ItemId" />
                <textarea class="form-control mb-2" name="note" rows="2" placeholder="@T["Internal note"]"></textarea>
                <button type="submit" class="btn btn-secondary">@T["Add note"]</button>
            </form>
        </div>
    </div>
}
