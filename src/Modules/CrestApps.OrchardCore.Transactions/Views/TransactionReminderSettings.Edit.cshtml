@model TransactionReminderSettingsViewModel

<div class="ocat-wrapper">
    <div class="ocat-label"></div>
    <div class="ocat-end">
        <div class="form-check">
            <input asp-for="Enabled" class="form-check-input" />
            <label asp-for="Enabled" class="form-check-label">@T["Enable scheduled reminders"]</label>
            <span class="hint">@T["When enabled, a background sweep sends reminders for outstanding transactions on the cadence configured below."]</span>
        </div>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="FirstReminderDelayDays">
    <label asp-for="FirstReminderDelayDays" class="ocat-label">@T["First reminder delay (days)"]</label>
    <div class="ocat-end">
        <input asp-for="FirstReminderDelayDays" type="number" min="0" class="form-control" />
        <span asp-validation-for="FirstReminderDelayDays"></span>
        <span class="hint">@T["The number of days to wait after a transaction becomes due before the first reminder is sent. Use 0 to send as soon as it is due."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="ReminderIntervalDays">
    <label asp-for="ReminderIntervalDays" class="ocat-label">@T["Reminder interval (days)"]</label>
    <div class="ocat-end">
        <input asp-for="ReminderIntervalDays" type="number" min="1" class="form-control" />
        <span asp-validation-for="ReminderIntervalDays"></span>
        <span class="hint">@T["The number of days to wait between reminders for the same transaction."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="MaxReminders">
    <label asp-for="MaxReminders" class="ocat-label">@T["Maximum reminders"]</label>
    <div class="ocat-end">
        <input asp-for="MaxReminders" type="number" min="0" class="form-control" />
        <span asp-validation-for="MaxReminders"></span>
        <span class="hint">@T["The maximum number of reminders to send for a single transaction. Use 0 for no limit."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="UpcomingReminderDays">
    <label asp-for="UpcomingReminderDays" class="ocat-label">@T["Remind before the due date (days)"]</label>
    <div class="ocat-end">
        <input asp-for="UpcomingReminderDays" type="number" min="0" class="form-control" />
        <span asp-validation-for="UpcomingReminderDays"></span>
        <span class="hint">@T["How many days before a payment falls due the customer is told it is coming due, once per payment. A payment charged automatically to a saved card names the card. Use 0 to send no such reminder."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="Steps">
    <label asp-for="Steps" class="ocat-label">@T["Reminder steps (days)"]</label>
    <div class="ocat-end">
        <input asp-for="Steps" class="form-control" autocomplete="off" placeholder="-3, 0, 7, 14, 30" />
        <span asp-validation-for="Steps"></span>
        <span class="hint">@T["Optional. The days, counted from the due date, a reminder is sent on: a negative number is before it, 0 is the day itself. For example -3, 0, 7, 14, 30. When set, these steps replace the first reminder delay, interval, maximum and the reminder before the due date above. A missed step is passed over, so a customer never gets several reminders at once."]</span>
    </div>
</div>

<div class="ocat-limited-wrapper" asp-validation-class-for="SendFromHour">
    <label asp-for="SendFromHour" class="ocat-label">@T["Send between"]</label>
    <div class="ocat-limited">
        <div class="input-group">
            <input asp-for="SendFromHour" type="number" min="0" max="23" class="form-control" />
            <span class="input-group-text">@T["and"]</span>
            <input asp-for="SendUntilHour" type="number" min="1" max="24" class="form-control" />
            <span class="input-group-text">@T["o'clock"]</span>
        </div>
        <span class="hint">@T["The hours of the day, in the site's time zone, scheduled reminders are sent in. Use 0 and 24 to send them at any time."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="ChargeRetryDays">
    <label asp-for="ChargeRetryDays" class="ocat-label">@T["Retry a declined card after (days)"]</label>
    <div class="ocat-end">
        <input asp-for="ChargeRetryDays" class="form-control" autocomplete="off" placeholder="1, 3, 5" />
        <span asp-validation-for="ChargeRetryDays"></span>
        <span class="hint">@T["When a balance charged automatically to a saved card is declined, it is charged again after each of these numbers of days, in order. After the last one, the customer is asked to pay it themselves. Leave it empty to ask them at once."]</span>
    </div>
</div>
