@using CrestApps.OrchardCore.Transactions.Core
@addTagHelper *, OrchardCore.Navigation.Core
@model TransactionReceiptViewModel

@{
    var transaction = Model.Transaction;
    var transactionTitle = string.IsNullOrEmpty(transaction.Title) ? T["Transaction"].Value : transaction.Title;
}

<zone Name="Title">
    @if (Model.IsAdministrator)
    {
        <breadcrumb name="TransactionsReceipt" title="@T["Receipt"]">
            <breadcrumb-item id="TransactionsIndex" action="Index" controller="Admin" area="CrestApps.OrchardCore.Transactions" permission="@TransactionsPermissions.ManageTransactions.Name">@T["Transactions"]</breadcrumb-item>
            <breadcrumb-item id="TransactionsDetail" action="Detail" controller="Admin" area="CrestApps.OrchardCore.Transactions" route-itemId="@transaction.ItemId" permission="@TransactionsPermissions.ManageTransactions.Name">@transactionTitle</breadcrumb-item>
        </breadcrumb>
    }
    else
    {
        <breadcrumb name="TransactionsMyReceipt" title="@T["Receipt"]">
            <breadcrumb-item id="TransactionsMyTransactions" action="Index" controller="Transaction" area="CrestApps.OrchardCore.Transactions" permission="@TransactionsPermissions.ViewOwnTransactions.Name">@T["My Transactions"]</breadcrumb-item>
            <breadcrumb-item id="TransactionsMyDetail" action="Detail" controller="Transaction" area="CrestApps.OrchardCore.Transactions" route-itemId="@transaction.ItemId" permission="@TransactionsPermissions.ViewOwnTransactions.Name">@transactionTitle</breadcrumb-item>
        </breadcrumb>
    }
</zone>

<style>
    @@media print {
        body * {
            visibility: hidden;
        }

        .receipt-print-area,
        .receipt-print-area * {
            visibility: visible;
        }

        .receipt-print-area {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
        }

        .no-print {
            display: none !important;
        }
    }
</style>

<div class="mb-3 no-print">
    <button type="button" class="btn btn-primary" onclick="window.print();">@T["Print receipt"]</button>
</div>

<div class="receipt-print-area">
    <partial name="~/Areas/CrestApps.OrchardCore.Receipts/Views/ReceiptDocument.cshtml" model="Model.Receipt" />
</div>
