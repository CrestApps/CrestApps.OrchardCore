@*
    The status and method filters of the refunds ledger, passed to the admin list as its 'ToolbarActions' so they
    render at the end of the list's toolbar. The list is rendered outside the filter form, so the selects name that
    form; the commerce-admin-list script submits it when one changes.
*@
@{
    var options = (RefundsAdminIndexOptions)Model.Options;
}

<div class="btn-group filter">
    <select name="Options.Status" asp-items="options.Statuses" form="refunds-filter" class="selectpicker show-tick me-2" data-style="btn-sm" data-width="fit" data-header="@T["Filter by status"]" data-dropdown-align-right="auto" data-commerce-list-filter aria-label="@T["Status"]"></select>
    <select name="Options.ProviderKey" asp-items="options.Providers" form="refunds-filter" class="selectpicker show-tick" data-style="btn-sm" data-width="fit" data-header="@T["Filter by method"]" data-dropdown-align-right="auto" data-commerce-list-filter aria-label="@T["Method"]"></select>
</div>
