@*
    The status and source filters of the transactions report, passed to the admin list as its 'ToolbarActions'
    so they render at the end of the list's toolbar. The list is rendered outside the filter form, so the selects
    name that form; the commerce-admin-list script submits it when one changes.
*@
@{
    var options = (TransactionsAdminIndexOptions)Model.Options;
}

<div class="btn-group filter">
    <select name="Options.Status" asp-items="options.Statuses" form="transactions-filter" class="selectpicker show-tick me-2" data-style="btn-sm" data-width="fit" data-header="@T["Filter by status"]" data-dropdown-align-right="auto" data-commerce-list-filter aria-label="@T["Status"]"></select>
    <select name="Options.Source" asp-items="options.Sources" form="transactions-filter" class="selectpicker show-tick" data-style="btn-sm" data-width="fit" data-header="@T["Filter by source"]" data-dropdown-align-right="auto" data-commerce-list-filter aria-label="@T["Source"]"></select>
</div>
