@model PartyCollectionSettingsViewModel

<div class="card mb-3">
    <div class="card-header">@T["Reminders and late fees"]</div>
    @if (Model.CanManage)
    {
        <form asp-area="CrestApps.OrchardCore.Transactions" asp-controller="PartyCollectionSettings" asp-action="Save" method="post" class="card-body">
            <input type="hidden" name="party" value="@Model.Party" />
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <div class="form-check mb-2">
                <input type="checkbox" class="form-check-input" id="party-reminders-paused" name="remindersPaused" value="true" checked="@Model.RemindersPaused" />
                <label class="form-check-label" for="party-reminders-paused">@T["Send no payment reminders"]</label>
                <span class="hint dashed">@T["For every balance this customer owes or pays. Their invoices are still sent."]</span>
            </div>
            <div class="form-check mb-3">
                <input type="checkbox" class="form-check-input" id="party-late-fees-exempt" name="lateFeesExempt" value="true" checked="@Model.LateFeesExempt" />
                <label class="form-check-label" for="party-late-fees-exempt">@T["Charge no late fees"]</label>
                <span class="hint dashed">@T["On any invoice billed to this customer. Fees already charged stay."]</span>
            </div>
            <button type="submit" class="btn btn-secondary btn-sm">@T["Save"]</button>
        </form>
    }
    else
    {
        <ul class="list-group list-group-flush">
            <li class="list-group-item">@(Model.RemindersPaused ? T["No payment reminders are sent."] : T["Payment reminders are sent."])</li>
            <li class="list-group-item">@(Model.LateFeesExempt ? T["No late fees are charged."] : T["Late fees are charged by the policies."])</li>
        </ul>
    }
</div>
