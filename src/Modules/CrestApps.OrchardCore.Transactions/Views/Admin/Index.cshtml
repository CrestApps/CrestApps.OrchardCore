@using CrestApps.OrchardCore.Transactions.Models
@model TransactionsAdminIndexViewModel

<zone Name="Title"><h1>@RenderTitleSegments(T["Transactions"])</h1></zone>

<form asp-action="Index" method="post" class="no-multisubmit">
    <input type="submit" name="submit.Filter" id="submitFilter" class="visually-hidden" />

    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-1">
                <div class="col">
                    <div class="has-search">
                        <i class="fa-solid fa-search form-control-feedback" aria-hidden="true"></i>
                        <input asp-for="Options.Search" class="form-control" placeholder="@T["Search by title"]" type="search" autocomplete="off" />
                    </div>
                </div>
                <div class="col-auto">
                    <select asp-for="Options.Status" asp-items="Model.Options.Statuses" class="form-select"></select>
                </div>
                <div class="col-auto">
                    <input asp-for="Options.Source" class="form-control" placeholder="@T["Source"]" autocomplete="off" />
                </div>
                <div class="col-auto">
                    <button type="submit" name="submit.Filter" class="btn btn-primary text-nowrap">
                        <i class="fa-solid fa-filter me-1" aria-hidden="true"></i>@T["Filter"]
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

<div class="alert alert-secondary d-flex justify-content-between align-items-center" role="alert">
    <span>@T["Total outstanding (all matching transactions)"]</span>
    <strong>@Model.TotalOutstanding.ToString("0.00")</strong>
</div>

@if (Model.Transactions.Count > 0)
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col">@T["Title"]</th>
                    <th scope="col">@T["Owner"]</th>
                    <th scope="col">@T["Source"]</th>
                    <th scope="col" class="text-end">@T["Total"]</th>
                    <th scope="col" class="text-end">@T["Outstanding"]</th>
                    <th scope="col">@T["Status"]</th>
                    <th scope="col">@T["Due"]</th>
                    <th scope="col" class="text-end">@T["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Transactions)
                {
                    var transaction = item.Transaction;

                    <tr>
                        <td>
                            <a asp-action="Detail" asp-route-itemId="@transaction.ItemId">@(string.IsNullOrEmpty(transaction.Title) ? T["(untitled)"].Value : transaction.Title)</a>
                        </td>
                        <td>@(item.OwnerName ?? T["Unknown"].Value)</td>
                        <td>@transaction.Source</td>
                        <td class="text-end">@transaction.Currency @transaction.TotalAmount.ToString("0.00")</td>
                        <td class="text-end">@transaction.Currency @transaction.OutstandingAmount.ToString("0.00")</td>
                        <td>
                            <partial name="_TransactionStatusBadge" model="transaction.Status" />
                        </td>
                        <td>@(transaction.DueUtc.HasValue ? transaction.DueUtc.Value.ToString("d") : "-")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-secondary" asp-action="Detail" asp-route-itemId="@transaction.ItemId">@T["Manage"]</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info text-center" role="alert">
        @T["<strong>Nothing here!</strong> There are no transactions that match the current filter."]
    </div>
}

@await DisplayAsync(Model.Pager)
