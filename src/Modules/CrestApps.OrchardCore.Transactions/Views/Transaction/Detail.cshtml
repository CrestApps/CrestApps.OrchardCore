@using CrestApps.OrchardCore.Payments
@using CrestApps.OrchardCore.Transactions.Core
@using CrestApps.OrchardCore.Transactions.Core.Services
@using CrestApps.OrchardCore.Transactions.Models
@using OrchardCore.DisplayManagement.Html
@model TransactionDetailViewModel

@{
    var transaction = Model.Transaction;

    // Abandoned, refunded and canceled transactions can't be paid, whatever balance they still show.
    var canPay = TransactionStateMachine.CanRecordPayment(transaction);
}

<zone Name="Title">
    <breadcrumb name="TransactionsMyTransactionsDetail" title="@(string.IsNullOrEmpty(transaction.Title) ? T["Transaction"] : (Microsoft.AspNetCore.Html.IHtmlContent)new HtmlContentString(transaction.Title))">
        <breadcrumb-item id="TransactionsMyTransactions" action="Index" controller="Transaction" area="CrestApps.OrchardCore.Transactions" permission="@TransactionsPermissions.ViewOwnTransactions.Name">@T["My Transactions"]</breadcrumb-item>
    </breadcrumb>
</zone>

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>@T["Details"]</span>
        <partial name="_TransactionStatusBadge" model="transaction.Status" />
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">@T["Total"]</dt>
            <dd class="col-sm-8">@transaction.Currency @CurrencyScale.Format(transaction.TotalAmount, transaction.Currency)</dd>

            @if (transaction.AmountAdjusted > 0m)
            {
                <dt class="col-sm-4">@T["Adjusted"]</dt>
                <dd class="col-sm-8">@transaction.Currency @CurrencyScale.Format(transaction.AmountAdjusted, transaction.Currency)</dd>
            }

            <dt class="col-sm-4">@T["Paid"]</dt>
            <dd class="col-sm-8">@transaction.Currency @CurrencyScale.Format(transaction.AmountPaid, transaction.Currency)</dd>

            @if (transaction.AmountRefunded > 0m)
            {
                <dt class="col-sm-4">@T["Refunded"]</dt>
                <dd class="col-sm-8">@transaction.Currency @CurrencyScale.Format(transaction.AmountRefunded, transaction.Currency)</dd>
            }

            <dt class="col-sm-4">@T["Outstanding"]</dt>
            <dd class="col-sm-8"><strong>@transaction.Currency @CurrencyScale.Format(transaction.OutstandingAmount, transaction.Currency)</strong></dd>

            <dt class="col-sm-4">@T["Created"]</dt>
            <dd class="col-sm-8">@await DisplayAsync(await New.DateTime(Utc: transaction.CreatedUtc, Format: "g"))</dd>

            @if (transaction.DueUtc.HasValue)
            {
                <dt class="col-sm-4">@T["Due"]</dt>
                <dd class="col-sm-8">@transaction.DueUtc.Value.ToString("d")</dd>
            }

            @if (!string.IsNullOrEmpty(transaction.InvoiceNumber))
            {
                <dt class="col-sm-4">@T["Invoice"]</dt>
                <dd class="col-sm-8">
                    @if (Model.ShowReceipts)
                    {
                        <a asp-action="Index" asp-controller="TransactionInvoice" asp-route-itemId="@transaction.ItemId">@transaction.InvoiceNumber</a>
                    }
                    else
                    {
                        @transaction.InvoiceNumber
                    }
                </dd>
            }
        </dl>
    </div>
    @if (canPay)
    {
        <div class="card-footer">
            <form asp-action="Pay" method="post">
                <input type="hidden" name="itemId" value="@transaction.ItemId" />
                <button type="submit" class="btn btn-success">@T["Pay now"]</button>
            </form>
        </div>
    }
</div>

<div class="card">
    <div class="card-header">@T["History"]</div>
    <ul class="list-group list-group-flush">
        @{
            var visibleEvents = transaction.Events
                .Where(x => x.Type != TransactionEventType.Note)
                .OrderByDescending(x => x.CreatedUtc)
                .ToList();
        }
        @if (visibleEvents.Count > 0)
        {
            @foreach (var evt in visibleEvents)
            {
                <li class="list-group-item">
                    <div class="d-flex justify-content-between">
                        <span>
                            @evt.Message
                            @if (Model.ShowReceipts && evt.Type == TransactionEventType.PaymentRecorded && !string.IsNullOrEmpty(evt.Id))
                            {
                                <a class="ms-1 small" asp-action="Index" asp-controller="TransactionReceipt" asp-route-itemId="@transaction.ItemId" asp-route-paymentId="@evt.Id">@T["View receipt"]</a>
                            }
                        </span>
                        <span class="text-muted small">@await DisplayAsync(await New.DateTime(Utc: evt.CreatedUtc, Format: "g"))</span>
                    </div>
                </li>
            }
        }
        else
        {
            <li class="list-group-item text-muted">@T["No history yet."]</li>
        }
    </ul>
</div>

<a class="btn btn-link" asp-action="Index">@T["Back to my transactions"]</a>
