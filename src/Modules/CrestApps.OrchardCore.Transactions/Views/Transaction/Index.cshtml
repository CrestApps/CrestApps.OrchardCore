@model MyTransactionsViewModel

<zone Name="Title">
    <breadcrumb name="MyTransactions" title="@T["My Transactions"]" />
</zone>

@* The filter renders in the list's toolbar, after this form, and names it with its form attribute. The list stays
   outside the form because its rows post forms of their own (Pay now). *@
<form asp-action="Index" asp-route-pageSize="@Context.Request.Query["pageSize"]" method="post" id="my-transactions-filter" class="no-multisubmit">
    <input type="submit" name="submit.Filter" id="submitFilter" class="visually-hidden" />

    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <div class="input-group">
                        <input id="search-box" asp-for="Options.Search" class="form-control" placeholder="@T["Search by description"]" type="search" autofocus autocomplete="off" />
                        <button type="submit" name="submit.Filter" class="btn btn-outline-secondary" title="@T["Search"]" aria-label="@T["Search"]"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@* The transactions, the toolbar with the filter and the pager are rendered by the AdminList shape, in the layout (List or Grid) the site or the user picked. *@
<admin-list name="MyTransactions" context="Model.List" show-select-all="false"
            empty-message="@T["You have no transactions that match the current filter."]">
    <admin-list-list item-css-class="list-group-item" />
    <admin-list-grid>
        <admin-list-column name="Title" position="20" title="@T["Description"]" />
        <admin-list-column name="Status" position="30" title="@T["Status"]" width="auto" />
        <admin-list-column name="Amount" position="40" title="@T["Amount"]" width="auto" />
        <admin-list-column name="Due" position="50" title="@T["Due"]" width="auto" />
        <admin-list-column type="Actions" title="@T["Actions"]" />
    </admin-list-grid>
</admin-list>

<style asp-name="bootstrap-select"></style>
<script asp-name="commerce-admin-list" at="Foot"></script>
