@model ShapeViewModel<VisitRow>

@{
    var visit = Model.Value.Visit;
    var zone = ViewData["TimeZoneId"] as string ?? "UTC";
}
<span class="badge @(visit.Status switch { VisitStatus.Unscheduled => "text-bg-warning", VisitStatus.Canceled or VisitStatus.Incomplete => "text-bg-secondary", VisitStatus.Completed => "text-bg-success", _ => "text-bg-primary" }) fw-normal">@T[visit.Status.Text()]</span>
@if (!string.IsNullOrEmpty(Model.Value.TypeName))
{
    <span class="badge ta-badge fw-normal">@Model.Value.TypeName</span>
}
@if (visit.StartUtc is not null)
{
    <span class="badge ta-badge fw-normal"><i class="fa-regular fa-clock" aria-hidden="true"></i> @DispatchTimeZone.Format(visit.StartUtc, zone)–@DispatchTimeZone.Format(visit.EndUtc, zone, "HH:mm")</span>
}
@if (!string.IsNullOrEmpty(Model.Value.Workers))
{
    <span class="badge ta-badge fw-normal"><i class="fa-solid fa-user-gear" aria-hidden="true"></i> @Model.Value.Workers</span>
}
@if (visit.Priority is CrestApps.OrchardCore.WorkOrders.Models.WorkOrderPriority.Urgent or CrestApps.OrchardCore.WorkOrders.Models.WorkOrderPriority.High)
{
    <span class="badge @(visit.Priority == CrestApps.OrchardCore.WorkOrders.Models.WorkOrderPriority.Urgent ? "text-bg-danger" : "text-bg-warning") fw-normal">@visit.Priority</span>
}
@if (visit.Pinned)
{
    <span class="badge ta-badge fw-normal"><i class="fa-solid fa-thumbtack" aria-hidden="true"></i> @T["Pinned"]</span>
}
@if (VisitStatusRules.IsOpen(visit.Status) && visit.DueUtc is { } due && (visit.EndUtc ?? Model.Value.NowUtc) > due)
{
    <span class="badge text-bg-danger fw-normal">@T["Past the work order's resolution target"]</span>
}
