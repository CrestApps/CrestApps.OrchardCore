@model DispatchSettingsViewModel

<div class="card mb-3">
    <div class="card-header">@T["Visits"]</div>
    <div class="card-body">
        <div class="ocat-wrapper">
            <div class="ocat-end-offset">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" asp-for="CreateVisitsForNewWorkOrders" />
                    <label class="form-check-label" asp-for="CreateVisitsForNewWorkOrders">@T["Give each new work order an unscheduled visit"]</label>
                    <span class="hint dashed">@T["Turn it off to make visits only from the work order's page."]</span>
                </div>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="ArrivalWindowMinutes" class="ocat-label">@T["Arrival window (minutes)"]</label>
            <div class="ocat-end">
                <input asp-for="ArrivalWindowMinutes" class="form-control" type="number" min="0" max="720" step="15" />
                <span asp-validation-for="ArrivalWindowMinutes" class="text-danger"></span>
                <span class="hint">@T["The window promised to the customer, around the start. 0 promises the start time itself."]</span>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="BufferMinutes" class="ocat-label">@T["Buffer between visits (minutes)"]</label>
            <div class="ocat-end">
                <input asp-for="BufferMinutes" class="form-control" type="number" min="0" max="120" />
                <span asp-validation-for="BufferMinutes" class="text-danger"></span>
                <span class="hint">@T["Kept free next to each visit, on top of the travel time."]</span>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="HorizonDays" class="ocat-label">@T["Look ahead (days)"]</label>
            <div class="ocat-end">
                <input asp-for="HorizonDays" class="form-control" type="number" min="1" max="60" />
                <span asp-validation-for="HorizonDays" class="text-danger"></span>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="TimeZoneId" class="ocat-label">@T["Time zone"]</label>
            <div class="ocat-end">
                <input asp-for="TimeZoneId" class="form-control" placeholder="@T["The site's time zone"]" />
                <span asp-validation-for="TimeZoneId" class="text-danger"></span>
                <span class="hint">@T["The times on the board, the visit pages and the notices, such as America/New_York."]</span>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="AtRiskMinutes" class="ocat-label">@T["At risk after (minutes)"]</label>
            <div class="ocat-end">
                <input asp-for="AtRiskMinutes" class="form-control" type="number" min="0" max="240" />
                <span asp-validation-for="AtRiskMinutes" class="text-danger"></span>
                <span class="hint">@T["A visit not started, or running over, by this much is flagged on the board."]</span>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">@T["Choosing technicians"]</div>
    <div class="card-body">
        <div class="ocat-wrapper">
            <div class="ocat-end-offset">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" asp-for="StrictTerritory" />
                    <label class="form-check-label" asp-for="StrictTerritory">@T["Only technicians who serve the visit's territory"]</label>
                    <span class="hint dashed">@T["When off, others are still offered, with a note. A territory with nobody listed takes anyone."]</span>
                </div>
            </div>
        </div>
        <div class="ocat-wrapper">
            <div class="ocat-end-offset">
                <p class="hint mb-0">@T["How much each thing counts when technicians are ranked, from 0 (not at all) to 10."]</p>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="TravelWeight" class="ocat-label">@T["Short trip"]</label>
            <div class="ocat-end">
                <input asp-for="TravelWeight" class="form-control" type="number" min="0" max="10" />
                <span asp-validation-for="TravelWeight" class="text-danger"></span>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="UrgencyWeight" class="ocat-label">@T["Soonest start"]</label>
            <div class="ocat-end">
                <input asp-for="UrgencyWeight" class="form-control" type="number" min="0" max="10" />
                <span asp-validation-for="UrgencyWeight" class="text-danger"></span>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="ProficiencyWeight" class="ocat-label">@T["Skill level"]</label>
            <div class="ocat-end">
                <input asp-for="ProficiencyWeight" class="form-control" type="number" min="0" max="10" />
                <span asp-validation-for="ProficiencyWeight" class="text-danger"></span>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="PreferredWeight" class="ocat-label">@T["Preferred technician"]</label>
            <div class="ocat-end">
                <input asp-for="PreferredWeight" class="form-control" type="number" min="0" max="10" />
                <span asp-validation-for="PreferredWeight" class="text-danger"></span>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="BalanceWeight" class="ocat-label">@T["Even workload"]</label>
            <div class="ocat-end">
                <input asp-for="BalanceWeight" class="form-control" type="number" min="0" max="10" />
                <span asp-validation-for="BalanceWeight" class="text-danger"></span>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="OptimizerSeconds" class="ocat-label">@T["Optimizer time (seconds)"]</label>
            <div class="ocat-end">
                <input asp-for="OptimizerSeconds" class="form-control" type="number" min="1" max="120" />
                <span asp-validation-for="OptimizerSeconds" class="text-danger"></span>
                <span class="hint">@T["How long Optimize on the board looks for a better day."]</span>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">@T["Customer notices"]</div>
    <div class="card-body">
        @if (!Model.CanSendNotices)
        {
            <div class="alert alert-info">@T["Turn on SMS or Email to send notices; they go to the work order's contact."]</div>
        }
        <div class="ocat-wrapper">
            <div class="ocat-end-offset">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" asp-for="NoticesEnabled" />
                    <label class="form-check-label" asp-for="NoticesEnabled">@T["Tell customers about their visit"]</label>
                    <span class="hint dashed">@T["By text when the contact has a phone, else by email."]</span>
                </div>
            </div>
        </div>
        <div class="ocat-wrapper">
            <div class="ocat-end-offset">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" asp-for="TrackingEnabled" />
                    <label class="form-check-label" asp-for="TrackingEnabled">@T["Send a link to follow the technician"]</label>
                    <span class="hint dashed">@T["The link shows the arrival window and, once on the way, the expected time. It stops working when the visit is over."]</span>
                </div>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="ReminderHour" class="ocat-label">@T["Reminder hour"]</label>
            <div class="ocat-end">
                <input asp-for="ReminderHour" class="form-control" type="number" min="0" max="23" />
                <span asp-validation-for="ReminderHour" class="text-danger"></span>
                <span class="hint">@T["Reminders go out the day before, from this hour."]</span>
            </div>
        </div>
        <div class="ocat-wrapper">
            <div class="ocat-end-offset">
                <p class="hint mb-0">@T["Words in braces are filled in: {0}.", "{Company}, {Number}, {Date}, {Window}, {Technician}, {Eta}, {TrackingUrl}"]</p>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="ScheduledText" class="ocat-label">@T["Scheduled"]</label>
            <div class="ocat-end">
                <textarea asp-for="ScheduledText" class="form-control" rows="2"></textarea>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="ReminderText" class="ocat-label">@T["Reminder"]</label>
            <div class="ocat-end">
                <textarea asp-for="ReminderText" class="form-control" rows="2"></textarea>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="EnRouteText" class="ocat-label">@T["On the way"]</label>
            <div class="ocat-end">
                <textarea asp-for="EnRouteText" class="form-control" rows="2"></textarea>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="CompletedText" class="ocat-label">@T["Done"]</label>
            <div class="ocat-end">
                <textarea asp-for="CompletedText" class="form-control" rows="2"></textarea>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="CanceledText" class="ocat-label">@T["Canceled"]</label>
            <div class="ocat-end">
                <textarea asp-for="CanceledText" class="form-control" rows="2"></textarea>
            </div>
        </div>
    </div>
</div>
