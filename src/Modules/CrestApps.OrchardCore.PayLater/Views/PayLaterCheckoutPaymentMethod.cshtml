@using System.Globalization
@using CrestApps.OrchardCore.PayLater.ViewModels

@model PayLaterCheckoutPaymentMethodViewModel

<div class="d-flex align-items-start gap-3">
    <i class="fa-solid fa-file-invoice-dollar fa-lg text-body-secondary mt-1" aria-hidden="true"></i>
    <div>
        <p class="mb-1">
            @if (Model.DueDate is { } due && Model.StartsLater)
            {
                @T["Nothing is due today. Your first payment is due by {0}.", due.ToString("D", CultureInfo.CurrentCulture)]
            }
            else if (Model.DueDate is { } dueDate)
            {
                @T["Place your order now and pay later. Payment is due by {0}.", dueDate.ToString("D", CultureInfo.CurrentCulture)]
            }
            else
            {
                @T["Place your order now and pay later."]
            }
        </p>
        <p class="mb-0 text-body-secondary small">
            @T["We'll send you an invoice and remind you before it's due. You can pay it from your account."]
            @if (Model.Recurring)
            {
                @T["Each renewal is invoiced the same way when its period starts."]
            }
        </p>
    </div>
</div>
