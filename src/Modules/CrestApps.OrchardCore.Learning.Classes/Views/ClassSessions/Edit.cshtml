@model ClassSessionEditViewModel

@{
    var isNew = string.IsNullOrEmpty(Model.SessionId);
    var classItemId = Model.ClassItem.ContentItemId;
}

<zone Name="Title">
    <breadcrumb name="LearningClassSessionsEdit" title="@(isNew ? T["New Session"] : T["Edit Session"])">
        <breadcrumb-item id="LearningClassItem" url="@Url.Action("Edit", "Admin", new { area = "OrchardCore.Contents", contentItemId = classItemId })">@Model.ClassItem.DisplayText</breadcrumb-item>
        <breadcrumb-item id="LearningClassSessions" action="Index" controller="ClassSessions" area="CrestApps.OrchardCore.Learning.Classes" route-classItemId="@classItemId">@T["Sessions"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form asp-action="@(isNew ? "Create" : "Edit")" asp-route-classItemId="@(isNew ? classItemId : null)" asp-route-id="@Model.SessionId" method="post" class="no-multisubmit">
    @Html.ValidationSummary()

    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <button class="btn btn-primary" type="submit">@T["Save"]</button>
        <a class="btn btn-secondary cancel" role="button" asp-action="Index" asp-route-classItemId="@classItemId">@T["Cancel"]</a>
    </div>
</form>
