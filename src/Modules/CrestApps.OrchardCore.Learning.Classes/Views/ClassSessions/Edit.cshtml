@model ClassSessionEditViewModel

@{
    var isNew = string.IsNullOrEmpty(Model.SessionId);
    var classItemId = Model.ClassItem.ContentItemId;
}

<zone Name="Title">
    <breadcrumb name="LearningClassSessionsEdit" title="@(isNew ? T["New session"] : T["Edit session"])">
        <breadcrumb-item id="LearningClassItem" url="@Url.Action("Edit", "Admin", new { area = "OrchardCore.Contents", contentItemId = classItemId })">@Model.ClassItem.DisplayText</breadcrumb-item>
        <breadcrumb-item id="LearningClassSessions" action="Index" controller="ClassSessions" area="CrestApps.OrchardCore.Learning.Classes" route-classItemId="@classItemId">@T["Sessions"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form asp-action="@(isNew ? "Create" : "Edit")" asp-route-classItemId="@(isNew ? classItemId : null)" asp-route-id="@Model.SessionId" method="post" class="no-multisubmit">
    @Html.ValidationSummary()

    <div class="card text-bg-theme mb-3">
        <div class="card-header">@T["Session"]</div>
        <div class="card-body">
            <div class="ocat-wrapper" asp-validation-class-for="Title">
                <label asp-for="Title" class="ocat-label">@T["Name"]</label>
                <div class="ocat-end">
                    <input asp-for="Title" class="form-control" maxlength="255" />
                    <span class="hint">@T["The name learners see, such as the class name with its month. Empty uses the class name."]</span>
                </div>
            </div>

            <div class="ocat-wrapper" asp-validation-class-for="Meetings">
                <span class="ocat-label">@T["Meetings"]</span>
                <div class="ocat-end">
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-1">
                            <thead>
                                <tr>
                                    <th scope="col">@T["Date"]</th>
                                    <th scope="col">@T["Starts"]</th>
                                    <th scope="col">@T["Ends"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < Model.Meetings.Count; i++)
                                {
                                    var meeting = Model.Meetings[i];

                                    <tr>
                                        <td><input type="date" name="Meetings[@i].Date" value="@(meeting.Date?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" aria-label="@T["Date of meeting {0}", i + 1]" /></td>
                                        <td><input type="time" name="Meetings[@i].Start" value="@(meeting.Start?.ToString(@"hh\:mm"))" class="form-control form-control-sm" aria-label="@T["Start of meeting {0}", i + 1]" /></td>
                                        <td>
                                            <input type="time" name="Meetings[@i].End" value="@(meeting.End?.ToString(@"hh\:mm"))" class="form-control form-control-sm" aria-label="@T["End of meeting {0}", i + 1]" />
                                            <span asp-validation-for="Meetings[i].End"></span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <span asp-validation-for="Meetings"></span>
                    <button type="submit" name="addMeeting" value="true" formnovalidate class="btn btn-sm btn-secondary"><i class="fa-solid fa-plus me-1" aria-hidden="true"></i>@T["Add a meeting"]</button>
                    <span class="hint d-block">@T["One registration covers every meeting. Times are in your time zone. Clear a meeting's date to remove it."]</span>
                </div>
            </div>

            <div class="ocat-wrapper" asp-validation-class-for="Capacity">
                <label asp-for="Capacity" class="ocat-label">@T["Capacity"]</label>
                <div class="ocat-end">
                    <input asp-for="Capacity" type="number" min="1" class="form-control" />
                    <span asp-validation-for="Capacity"></span>
                    <span class="hint">@T["How many learners can register."]</span>
                </div>
            </div>
        </div>
    </div>

    <div class="card text-bg-theme mb-3">
        <div class="card-header">@T["Where"]</div>
        <div class="card-body">
            <div class="ocat-wrapper" asp-validation-class-for="Location">
                <label asp-for="Location" class="ocat-label">@T["Location"]</label>
                <div class="ocat-end">
                    <input asp-for="Location" class="form-control" maxlength="500" />
                </div>
            </div>

            <div class="ocat-wrapper" asp-validation-class-for="MeetingUrl">
                <label asp-for="MeetingUrl" class="ocat-label">@T["Meeting link"]</label>
                <div class="ocat-end">
                    <input asp-for="MeetingUrl" type="url" class="form-control" maxlength="2000" />
                    <span asp-validation-for="MeetingUrl"></span>
                    <span class="hint">@T["Only learners with a place see it."]</span>
                </div>
            </div>
        </div>
    </div>

    <div class="card text-bg-theme mb-3">
        <div class="card-header">@T["Registration"]</div>
        <div class="card-body">
            <div class="ocat-wrapper" asp-validation-class-for="RegistrationOpens">
                <label asp-for="RegistrationOpens" class="ocat-label">@T["Opens"]</label>
                <div class="ocat-end">
                    <input asp-for="RegistrationOpens" type="datetime-local" class="form-control" />
                    <span class="hint">@T["Empty opens registration at once."]</span>
                </div>
            </div>

            <div class="ocat-wrapper" asp-validation-class-for="RegistrationCloses">
                <label asp-for="RegistrationCloses" class="ocat-label">@T["Closes"]</label>
                <div class="ocat-end">
                    <input asp-for="RegistrationCloses" type="datetime-local" class="form-control" />
                    <span asp-validation-for="RegistrationCloses"></span>
                    <span class="hint">@T["Empty closes registration when the first meeting starts."]</span>
                </div>
            </div>

            <div class="ocat-wrapper" asp-validation-class-for="WaitlistMode">
                <label asp-for="WaitlistMode" class="ocat-label">@T["When it is full"]</label>
                <div class="ocat-end">
                    <select asp-for="WaitlistMode" asp-items="Model.WaitlistModeOptions" class="form-select"></select>
                </div>
            </div>

            <div class="ocat-wrapper" asp-validation-class-for="OfferHours">
                <label asp-for="OfferHours" class="ocat-label">@T["Offer held for (hours)"]</label>
                <div class="ocat-end">
                    <input asp-for="OfferHours" type="number" min="1" class="form-control" />
                    <span class="hint">@T["How long a place offered from the waitlist is held before it passes to the next person."]</span>
                </div>
            </div>
        </div>
    </div>

    <div class="action-bar-bottom">
        <button class="btn btn-primary" type="submit">@T["Save"]</button>
        <a class="btn btn-secondary cancel" role="button" asp-action="Index" asp-route-classItemId="@classItemId">@T["Cancel"]</a>
    </div>
</form>
