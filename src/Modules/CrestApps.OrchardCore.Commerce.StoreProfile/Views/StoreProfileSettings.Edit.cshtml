@using CrestApps.OrchardCore.Commerce.StoreProfile.ViewModels

@model StoreProfileSettingsViewModel

<div class="card mb-3">
    <div class="card-header">@T["The store"]</div>
    <div class="card-body">
        <p class="text-body-secondary">@T["Who the store is. Receipts, the address parcels ship from and the tax origin use these when their own settings are empty."]</p>
        <div class="ocat-wrapper" asp-validation-class-for="Name">
            <label asp-for="Name" class="ocat-label">@T["Name"]</label>
            <div class="ocat-end">
                <input asp-for="Name" class="form-control" maxlength="200" placeholder="@Model.SiteName" />
                <span asp-validation-for="Name" class="text-danger"></span>
                <span class="hint">@T["The business's legal or trading name. Empty uses the site's name."]</span>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="LogoUrl">
            <label asp-for="LogoUrl" class="ocat-label">@T["Logo"]</label>
            <div class="ocat-end">
                <input asp-for="LogoUrl" class="form-control" maxlength="1000" placeholder="/media/logo.png" />
                <span asp-validation-for="LogoUrl" class="text-danger"></span>
                <span class="hint">@T["The logo's address, such as a media library path or a full URL."]</span>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="TaxId">
            <label asp-for="TaxId" class="ocat-label">@T["Tax ID"]</label>
            <div class="ocat-end">
                <input asp-for="TaxId" class="form-control" maxlength="100" />
                <span asp-validation-for="TaxId" class="text-danger"></span>
                <span class="hint">@T["Such as a VAT, GST or EIN number."]</span>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">@T["How customers reach the store"]</div>
    <div class="card-body">
        <div class="ocat-wrapper" asp-validation-class-for="Email">
            <label asp-for="Email" class="ocat-label">@T["Email"]</label>
            <div class="ocat-end">
                <input asp-for="Email" type="email" class="form-control" maxlength="254" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="Phone">
            <label asp-for="Phone" class="ocat-label">@T["Phone"]</label>
            <div class="ocat-end">
                <input asp-for="Phone" type="tel" class="form-control" maxlength="50" />
                <span asp-validation-for="Phone" class="text-danger"></span>
                <span class="hint">@T["Kept in international form when it can be read, in the country of the address below."]</span>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">@T["Website and policies"]</div>
    <div class="card-body">
        <p class="text-body-secondary">@T["Checkouts, product feeds and AI agents link buyers to these pages. Enter a full address, or a path on this site such as /terms. Google and OpenAI ask for the terms of service and the privacy policy before agents can check out."]</p>
        <div class="ocat-wrapper" asp-validation-class-for="Website">
            <label asp-for="Website" class="ocat-label">@T["Website"]</label>
            <div class="ocat-end">
                <input asp-for="Website" class="form-control" maxlength="1000" placeholder="https://www.example.com" />
                <span asp-validation-for="Website" class="text-danger"></span>
                <span class="hint">@T["The store's own website, when it is not this site."]</span>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="TermsOfService">
            <label asp-for="TermsOfService" class="ocat-label">@T["Terms of service"]</label>
            <div class="ocat-end">
                <input asp-for="TermsOfService" class="form-control" maxlength="1000" placeholder="/terms" />
                <span asp-validation-for="TermsOfService" class="text-danger"></span>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="PrivacyPolicy">
            <label asp-for="PrivacyPolicy" class="ocat-label">@T["Privacy policy"]</label>
            <div class="ocat-end">
                <input asp-for="PrivacyPolicy" class="form-control" maxlength="1000" placeholder="/privacy" />
                <span asp-validation-for="PrivacyPolicy" class="text-danger"></span>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="ReturnPolicy">
            <label asp-for="ReturnPolicy" class="ocat-label">@T["Return policy"]</label>
            <div class="ocat-end">
                <input asp-for="ReturnPolicy" class="form-control" maxlength="1000" placeholder="/returns" />
                <span asp-validation-for="ReturnPolicy" class="text-danger"></span>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="ShippingPolicy">
            <label asp-for="ShippingPolicy" class="ocat-label">@T["Shipping policy"]</label>
            <div class="ocat-end">
                <input asp-for="ShippingPolicy" class="form-control" maxlength="1000" placeholder="/shipping" />
                <span asp-validation-for="ShippingPolicy" class="text-danger"></span>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="Faq">
            <label asp-for="Faq" class="ocat-label">@T["Frequently asked questions"]</label>
            <div class="ocat-end">
                <input asp-for="Faq" class="form-control" maxlength="1000" placeholder="/faq" />
                <span asp-validation-for="Faq" class="text-danger"></span>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="Contact">
            <label asp-for="Contact" class="ocat-label">@T["Contact page"]</label>
            <div class="ocat-end">
                <input asp-for="Contact" class="form-control" maxlength="1000" placeholder="/contact" />
                <span asp-validation-for="Contact" class="text-danger"></span>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="About">
            <label asp-for="About" class="ocat-label">@T["About page"]</label>
            <div class="ocat-end">
                <input asp-for="About" class="form-control" maxlength="1000" placeholder="/about" />
                <span asp-validation-for="About" class="text-danger"></span>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">@T["Address"]</div>
    <div class="card-body">
        @await DisplayAsync(Model.AddressEditor)
        <span class="hint">@T["Optional. Where the store is: parcels ship from it and taxes are worked out from it unless the shipping and tax settings name another address. Leave it blank to remove it."]</span>
    </div>
</div>
