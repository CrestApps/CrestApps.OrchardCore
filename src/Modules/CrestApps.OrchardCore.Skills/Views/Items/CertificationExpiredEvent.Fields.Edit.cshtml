@using CrestApps.OrchardCore.Skills.Workflows

@model SkillsEventActivityViewModel

<style asp-name="bootstrap-select"></style>
<script asp-name="bootstrap-select" depends-on="bootstrap" at="Foot"></script>
@if (Model.HasCertificationFilter)
{
    <div class="ocat-wrapper" asp-validation-class-for="CertificationIds">
        <label asp-for="CertificationIds" class="ocat-label">@T["Certification types"]</label>
        <div class="ocat-end">
            <select asp-for="CertificationIds" asp-items="Model.CertificationOptions" class="selectpicker show-tick" multiple data-live-search="true" data-actions-box="true" data-width="100%" data-selected-text-format="count > 3"></select>
            <span class="hint">@T["Leave empty for every certification. The workflow input holds CertificationRecordId, CertificationId, CertificationName, SubjectKind, SubjectId, SubjectName, Number, ExpiresOn and, for a reminder, DaysBefore."]</span>
        </div>
    </div>
}
else
{
    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <span class="hint">@T["The workflow input holds SubjectKind, SubjectId, SkillIds (every skill they hold), ChangedSkillIds, RemovedSkillIds, EffectiveDatesOnly and Actor."]</span>
        </div>
    </div>
}
