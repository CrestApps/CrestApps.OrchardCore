@using CrestApps.OrchardCore.Skills.Workflows

@model AssignSkillTaskViewModel

<div class="mb-3">
    <label asp-for="SubjectKind" class="form-label">@T["Held by"]</label>
    <input asp-for="SubjectKind" class="form-control code" />
    <span class="hint">@T["User or Worker. Liquid is allowed."]</span>
</div>
<div class="mb-3">
    <label asp-for="SubjectId" class="form-label">@T["User or worker id"]</label>
    <input asp-for="SubjectId" class="form-control code" />
</div>
<div class="mb-3">
    <label asp-for="Skill" class="form-label">@T["Skill"]</label>
    <input asp-for="Skill" class="form-control code" />
    <span class="hint">@T["The skill name or id."]</span>
</div>
<div class="mb-3">
    <label asp-for="Proficiency" class="form-label">@T["Proficiency"]</label>
    <input asp-for="Proficiency" class="form-control code" />
    <span class="hint">@T["From 1 (trainee) to 5 (expert). 0 takes the skill away."]</span>
</div>
