@model QuizPanelViewModel

@{
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var published = Model.Survey is { Status: CrestApps.OrchardCore.Surveys.Models.SurveyStatus.Open } && Model.Definition is not null;
    var timeLimit = Model.Definition?.Timing?.TimeLimitMinutes;
    var passMark = Model.Definition?.Scoring?.PassMarkPercent;
}

<div class="card mb-3 learning-quiz" data-learning-quiz>
    <div class="card-body">
        <ul class="list-inline text-secondary small mb-3">
            @if (timeLimit is > 0)
            {
                <li class="list-inline-item"><i class="fa-solid fa-stopwatch me-1" aria-hidden="true"></i>@T["{0} minutes", timeLimit.Value]</li>
            }
            @if (passMark is not null)
            {
                <li class="list-inline-item"><i class="fa-solid fa-flag-checkered me-1" aria-hidden="true"></i>@T["Pass mark {0}%", passMark.Value.ToString("0.#")]</li>
            }
            @if (Model.AttemptsLeft is { } left)
            {
                <li class="list-inline-item"><i class="fa-solid fa-rotate me-1" aria-hidden="true"></i>@T["{0} attempts left", left]</li>
            }
        </ul>

        @if (!published)
        {
            <p class="text-secondary small mb-0" data-learning-quiz-reason><i class="fa-solid fa-lock me-1" aria-hidden="true"></i>@T["This quiz is not open."]</p>
        }
        else if (!Model.SignedIn)
        {
            <p class="mb-0">@T["Sign in to attempt the quiz."]</p>
        }
        else if (!Model.Enrolled)
        {
            <p class="text-secondary small mb-0" data-learning-quiz-reason>@T["You cannot attempt this quiz now."]</p>
        }

        @if (Model.Attempts.Count > 0)
        {
            <table class="table table-sm mb-3">
                <thead>
                    <tr>
                        <th scope="col">@T["Attempt"]</th>
                        <th scope="col">@T["Ended"]</th>
                        <th scope="col">@T["Score"]</th>
                        <th scope="col"><span class="visually-hidden">@T["Review"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var attempt in Model.Attempts)
                    {
                        <tr>
                            <td>@attempt.AttemptNumber</td>
                            <td>
                                @if (attempt.CompletedUtc is { } completed)
                                {
                                    @await DisplayAsync(await New.DateTime(Utc: DateTime.SpecifyKind(completed, DateTimeKind.Utc), Format: "g"))
                                }
                                else if (attempt.Status == CrestApps.OrchardCore.Surveys.Models.SurveyResponseStatus.InProgress)
                                {
                                    @T["In progress"]
                                }
                            </td>
                            <td>
                                @if (attempt.Grading == CrestApps.OrchardCore.Surveys.Models.GradingStatus.Pending && attempt.Status == CrestApps.OrchardCore.Surveys.Models.SurveyResponseStatus.Completed)
                                {
                                    @T["Waiting for a grader"]
                                }
                                else if (attempt.Percent is { } percent && Model.ShowsFor(attempt).HasFlag(CrestApps.OrchardCore.Surveys.Models.ReviewShows.Score))
                                {
                                    @T["{0}%", percent.ToString("0.#")]
                                    @if (attempt.Passed is true)
                                    {
                                        <span class="badge text-bg-success ms-1">@T["Passed"]</span>
                                    }
                                    else if (attempt.Passed is false)
                                    {
                                        <span class="badge text-bg-danger ms-1">@T["Not passed"]</span>
                                    }
                                }
                                else if (attempt.Status == CrestApps.OrchardCore.Surveys.Models.SurveyResponseStatus.Completed)
                                {
                                    <span data-learning-quiz-score-hidden>@T["Submitted"]</span>
                                }
                            </td>
                            <td>
                                @if (attempt.Status == CrestApps.OrchardCore.Surveys.Models.SurveyResponseStatus.Completed && Model.ShowsFor(attempt) != CrestApps.OrchardCore.Surveys.Models.ReviewShows.None)
                                {
                                    <a href="@Url.Content("~/s/r/" + attempt.ItemId + "/review")">@T["Review"]</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (published && Model.Enrolled && (Model.Open is not null || Model.CanStart))
        {
            <form method="post" action="@Url.Content("~/learning/quizzes/" + Model.QuizId + "/start")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <button type="submit" class="btn btn-primary">@(Model.Open is not null ? T["Continue Your Attempt"] : Model.Attempts.Count > 0 ? T["Attempt Again"] : T["Start the Quiz"])</button>
            </form>
        }
    </div>
</div>
