@model AttemptQuestionViewModel

@{
    var item = Model.Item;
    var readOnly = Model.ReadOnly;
    var shows = Model.Shows;
    var showScore = shows.HasFlag(ReviewShows.Score);
    var showRight = shows.HasFlag(ReviewShows.RightAnswers);
    var showFeedback = shows.HasFlag(ReviewShows.Feedback);
    var showGeneral = shows.HasFlag(ReviewShows.GeneralFeedback);
    var name = "a" + item.Index;
    var response = item.Response;
    var chosen = response?.ChoiceIds ?? [];
    var key = item.Key;
}

@if (item.QuestionType == AssessmentsConstants.QuestionTypes.Description)
{
    <div class="card mb-3 learning-description border-0 bg-body-tertiary">
        <div class="card-body">@Html.Raw(item.Prompt)</div>
    </div>
    return;
}

<fieldset class="card mb-3 learning-question" data-question="@item.Index" data-locked="@(item.CheckedUtc is not null ? "true" : null)">
    <div class="card-body">
        <legend class="h6 d-flex justify-content-between gap-2">
            <span>@T["Question {0}", Model.Number ?? item.Index + 1]</span>
            <span class="text-secondary small fw-normal">@(item.Points > 0 ? T["Points: {0}", item.Points.ToString("0.##")] : T["Not graded"])</span>
        </legend>
        <div class="mb-3">@Html.Raw(item.Prompt)</div>

        @switch (item.QuestionType)
        {
            case AssessmentsConstants.QuestionTypes.SingleChoice:
            case AssessmentsConstants.QuestionTypes.TrueFalse:
            case AssessmentsConstants.QuestionTypes.MultipleChoice:
            case AssessmentsConstants.QuestionTypes.Survey:
                var multiple = item.QuestionType == AssessmentsConstants.QuestionTypes.MultipleChoice || (item.QuestionType == AssessmentsConstants.QuestionTypes.Survey && item.Multiple);
                foreach (var choice in item.Choices)
                {
                    var id = name + "-" + choice.Id;
                    var right = showRight && key.ChoiceIds.Contains(choice.Id);
                    <div class="form-check @(right ? "text-success fw-semibold" : null)">
                        <input class="form-check-input" type="@(multiple ? "checkbox" : "radio")" name="@name" value="@choice.Id" id="@id" checked="@chosen.Contains(choice.Id)" disabled="@readOnly" />
                        <label class="form-check-label" for="@id">
                            @(choice.Id == "true" && item.QuestionType == AssessmentsConstants.QuestionTypes.TrueFalse ? T["True"] : choice.Id == "false" && item.QuestionType == AssessmentsConstants.QuestionTypes.TrueFalse ? T["False"] : (object)choice.Text)
                            @if (right)
                            {
                                <span class="visually-hidden">@T["(right answer)"]</span><i class="fa-solid fa-check ms-1" aria-hidden="true"></i>
                            }
                        </label>
                        @if (showFeedback && chosen.Contains(choice.Id) && !string.IsNullOrEmpty(choice.Feedback))
                        {
                            <div class="hint">@choice.Feedback</div>
                        }
                    </div>
                }
                break;

            case AssessmentsConstants.QuestionTypes.Numeric:
                <input class="form-control learning-answer-sm" type="text" inputmode="decimal" name="@name" value="@response?.Number" aria-label="@T["Your answer"]" disabled="@readOnly" />
                @if (showRight)
                {
                    <p class="text-success mt-2 mb-0">@T["Right answer: {0} (within {1})", key.Number?.ToString("0.####"), key.Tolerance.ToString("0.####")]</p>
                }
                break;

            case AssessmentsConstants.QuestionTypes.FillInBlanks:
                <p class="mb-0">
                    @for (var i = 0; i < item.Segments.Count; i++)
                    {
                        @item.Segments[i]
                        if (i < item.BlankCount)
                        {
                            <input class="form-control d-inline-block w-auto mx-1 my-1" type="text" name="@(name + "_b" + i)" value="@(response?.Texts.ElementAtOrDefault(i))" aria-label="@T["Blank {0}", i + 1]" disabled="@readOnly" />
                            if (showRight)
                            {
                                <span class="text-success small">(@key.Texts[i].Replace("|", " / "))</span>
                            }
                        }
                    }
                </p>
                break;

            case AssessmentsConstants.QuestionTypes.DragIntoText:
            case AssessmentsConstants.QuestionTypes.GapSelect:
                var drag = item.QuestionType == AssessmentsConstants.QuestionTypes.DragIntoText;
                if (drag && !readOnly)
                {
                    <div class="d-flex flex-wrap gap-2 mb-2" aria-label="@T["Words to drag into the blanks"]">
                        @foreach (var choice in item.Choices)
                        {
                            <span class="badge text-bg-secondary fs-6 fw-normal user-select-none" data-blank-word data-choice="@choice.Id" style="cursor: grab;">@choice.Text</span>
                        }
                    </div>
                    <span class="hint d-block mb-2">@T["Drag each word onto its blank, or pick it in the blank's list."]</span>
                }
                <p class="mb-0 lh-lg">
                    @for (var i = 0; i < item.Segments.Count; i++)
                    {
                        @item.Segments[i]
                        if (i < item.BlankCount)
                        {
                            var selected = chosen.ElementAtOrDefault(i);
                            <select class="form-select d-inline-block w-auto mx-1 my-1" name="@(name + "_b" + i)" aria-label="@T["Blank {0}", i + 1]" disabled="@readOnly" data-blank-choices>
                                <option value="">@T["Choose"]</option>
                                @foreach (var choice in item.Choices)
                                {
                                    <option value="@choice.Id" selected="@(choice.Id == selected)">@choice.Text</option>
                                }
                            </select>
                            if (showRight)
                            {
                                <span class="text-success small">(@T["Right answer: {0}", item.Choices.FirstOrDefault(choice => choice.Id == key.ChoiceIds.ElementAtOrDefault(i))?.Text ?? string.Empty])</span>
                            }
                        }
                    }
                </p>
                break;

            case AssessmentsConstants.QuestionTypes.Matching:
                foreach (var prompt in item.Choices)
                {
                    var selected = response?.Pairs.TryGetValue(prompt.Id, out var value) == true ? value : null;
                    <div class="row g-2 align-items-center mb-2">
                        <label class="col-sm-5 col-form-label" for="@(name + "-" + prompt.Id)">@prompt.Text</label>
                        <div class="col-sm-7">
                            <select class="form-select" id="@(name + "-" + prompt.Id)" name="@(name + "_p" + prompt.Id)" disabled="@readOnly">
                                <option value="">@T["Choose"]</option>
                                @foreach (var answer in item.Answers)
                                {
                                    <option value="@answer.Id" selected="@(answer.Id == selected)">@answer.Text</option>
                                }
                            </select>
                            @if (showRight && key.Pairs.TryGetValue(prompt.Id, out var rightId))
                            {
                                <span class="text-success small">@item.Answers.FirstOrDefault(answer => answer.Id == rightId)?.Text</span>
                            }
                        </div>
                    </div>
                }
                break;

            case AssessmentsConstants.QuestionTypes.Ordering:
                for (var position = 0; position < item.Choices.Count; position++)
                {
                    var selected = chosen.ElementAtOrDefault(position);
                    <div class="row g-2 align-items-center mb-2">
                        <label class="col-sm-2 col-form-label" for="@(name + "-o" + position)">@(position + 1).</label>
                        <div class="col-sm-10">
                            <select class="form-select" id="@(name + "-o" + position)" name="@(name + "_o" + position)" disabled="@readOnly">
                                <option value="">@T["Choose"]</option>
                                @foreach (var choice in item.Choices)
                                {
                                    <option value="@choice.Id" selected="@(choice.Id == selected)">@choice.Text</option>
                                }
                            </select>
                            @if (showRight)
                            {
                                <span class="text-success small">@item.Choices.FirstOrDefault(choice => choice.Id == key.ChoiceIds.ElementAtOrDefault(position))?.Text</span>
                            }
                        </div>
                    </div>
                }
                break;

            case AssessmentsConstants.QuestionTypes.Essay:
                <textarea class="form-control" name="@name" rows="8" aria-label="@T["Your answer"]" disabled="@readOnly">@(response?.Texts.FirstOrDefault())</textarea>
                @if (item.MaxWords > 0 || item.MinWords > 0)
                {
                    <span class="hint">@T["Between {0} and {1} words.", item.MinWords, item.MaxWords > 0 ? item.MaxWords : (object)T["any number of"]]</span>
                }
                break;

            default:
                <input class="form-control" type="text" name="@name" value="@(response?.Texts.FirstOrDefault())" aria-label="@T["Your answer"]" disabled="@readOnly" maxlength="500" />
                @if (showRight && key.Texts.Count > 0)
                {
                    <p class="text-success mt-2 mb-0">@T["Accepted: {0}", string.Join(" / ", key.Texts)]</p>
                }
                break;
        }

        @if (showScore && item.Points > 0)
        {
            <p class="mt-3 mb-0 small">
                <strong>@T["Score"]:</strong> @(item.Score?.ToString("0.##") ?? T["Waiting for a grader"].Value) / @item.Points.ToString("0.##")
            </p>
        }
        @if (showFeedback && !string.IsNullOrEmpty(item.GraderComment))
        {
            <p class="mb-0 small"><strong>@T["Grader"]:</strong> @item.GraderComment</p>
        }
        @if (showGeneral && !string.IsNullOrEmpty(item.Feedback))
        {
            <div class="alert alert-info mt-2 mb-0 small">@Html.Raw(item.Feedback)</div>
        }

        @if (Model.CanCheck)
        {
            <div class="mt-3 d-flex align-items-center gap-2">
                <button type="submit" class="btn btn-sm btn-outline-primary" formaction="@Model.CheckUrl" data-learning-check>@T["Check"]</button>
                <span class="hint">@T["You cannot change the answer once it is checked."]</span>
                <span class="learning-saved small text-secondary d-none ms-auto" data-saved>@T["Saved"]</span>
            </div>
        }
        else if (!readOnly)
        {
            <span class="learning-saved small text-secondary d-none" data-saved>@T["Saved"]</span>
        }
        else if (item.CheckedUtc is not null && Model.Item.Response is not null && shows == ReviewShows.None)
        {
            <p class="mt-3 mb-0 small text-secondary">@T["Checked. Your answer is saved."]</p>
        }
    </div>
</fieldset>
