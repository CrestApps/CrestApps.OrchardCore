@model SimpleQuestionViewModel

<div class="card text-bg-theme mb-3">
    <div class="card-header">@T["Answer"]</div>
    <div class="card-body">
        <div class="ocat-wrapper">
            <label asp-for="NumberAnswer" class="ocat-label">@T["Answer"]</label>
            <div class="ocat-end ocat-end-sm">
                <input asp-for="NumberAnswer" type="number" step="any" class="form-control" />
            </div>
        </div>

        <div class="ocat-wrapper">
            <label asp-for="Tolerance" class="ocat-label">@T["Tolerance"]</label>
            <div class="ocat-end ocat-end-sm">
                <input asp-for="Tolerance" type="number" step="any" min="0" class="form-control" />
                <span class="hint">@T["How far from the answer a response may be and still count, such as 0.05."]</span>
            </div>
        </div>
    </div>
</div>
