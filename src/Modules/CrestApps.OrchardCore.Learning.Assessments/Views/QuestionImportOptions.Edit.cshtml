@model QuestionImportOptionsViewModel

<div class="ocat-wrapper" asp-validation-class-for="QuestionBankId">
    <label asp-for="QuestionBankId" class="ocat-label">@T["Question bank"]</label>
    <div class="ocat-end">
        <select asp-for="QuestionBankId" asp-items="Model.Banks" class="form-select">
            <option value="">@T["No question bank"]</option>
        </select>
        <span asp-validation-for="QuestionBankId"></span>
        <span class="hint">@T["The imported questions go into this bank. A row with a source identifier, such as a QTI item, updates the question imported before with it into the same bank instead of adding it again."]</span>
    </div>
</div>
