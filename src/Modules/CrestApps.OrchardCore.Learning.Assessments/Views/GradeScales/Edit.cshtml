@model GradeScaleEditViewModel

<zone Name="Title">
    <breadcrumb name="LearningGradeScalesEdit" title="@(string.IsNullOrEmpty(Model.Id) ? T["New grade scale"] : new Microsoft.AspNetCore.Html.HtmlString(System.Net.WebUtility.HtmlEncode(Model.Name)))">
        <breadcrumb-item id="LearningGradeScales" action="Index" controller="GradeScales" area="CrestApps.OrchardCore.Learning.Assessments">@T["Grade scales"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form method="post" asp-action="Save">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly"></div>

    <div class="card text-bg-theme mb-3">
        <div class="card-body">
            <div class="ocat-wrapper" asp-validation-class-for="Name">
                <label asp-for="Name" class="ocat-label">@T["Name"]</label>
                <div class="ocat-end">
                    <input asp-for="Name" class="form-control" maxlength="255" required />
                    <span asp-validation-for="Name"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="card text-bg-theme mb-3">
        <div class="card-header">@T["Bands"]</div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th scope="col">@T["From (%)"]</th>
                            <th scope="col">@T["Grade"]</th>
                            <th scope="col" class="text-center">@T["Passes"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.Bands.Count; i++)
                        {
                            <tr>
                                <td><input asp-for="Bands[i].MinPercent" type="number" min="0" max="100" step="0.01" class="form-control form-control-sm" aria-label="@T["From (%)"]" /></td>
                                <td><input asp-for="Bands[i].Label" class="form-control form-control-sm" maxlength="50" aria-label="@T["Grade"]" /></td>
                                <td class="text-center"><input asp-for="Bands[i].Passing" type="checkbox" class="form-check-input" aria-label="@T["Passes"]" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <span class="hint">@T["Each band runs from its percentage up to the next band. The lowest band starts at 0%. Leave a row empty to remove it."]</span>
        </div>
    </div>

    <div class="action-bar-bottom">
        <button type="submit" class="btn btn-primary">@T["Save"]</button>
        <a class="btn btn-secondary action-bar-secondary" asp-action="Index">@T["Cancel"]</a>
    </div>
</form>
