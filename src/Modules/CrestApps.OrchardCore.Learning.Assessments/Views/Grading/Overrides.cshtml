@model QuizOverridesViewModel

<zone Name="Title">
    <breadcrumb name="LearningQuizOverrides" title="@(new Microsoft.AspNetCore.Html.HtmlString(System.Net.WebUtility.HtmlEncode(Model.QuizTitle + " · " + T["Overrides"].Value)))">
        <breadcrumb-item id="LearningGrading" action="Index" controller="Grading" area="CrestApps.OrchardCore.Learning.Assessments">@T["Grading"]</breadcrumb-item>
    </breadcrumb>
</zone>

<div class="card mb-3">
    <div class="card-header">@T["Overrides given"]</div>
    <div class="card-body">
        @if (Model.Overrides.Count == 0)
        {
            <p class="mb-0">@T["No override yet."]</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th scope="col">@T["Learner"]</th>
                            <th scope="col">@T["Extra minutes"]</th>
                            <th scope="col">@T["Extra attempts"]</th>
                            <th scope="col">@T["Window"]</th>
                            <th scope="col">@T["Reason"]</th>
                            <th scope="col">@T["Given"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.Overrides)
                        {
                            <tr>
                                <td>@(Model.Names.TryGetValue(entry.UserId, out var learner) ? learner : entry.UserId)</td>
                                <td>@entry.ExtraMinutes</td>
                                <td>@entry.ExtraAttempts</td>
                                <td>
                                    @if (entry.OpensUtc is { } opens)
                                    {
                                        @await DisplayAsync(await New.DateTime(Utc: DateTime.SpecifyKind(opens, DateTimeKind.Utc), Format: "g"))
                                    }
                                    –
                                    @if (entry.ClosesUtc is { } closes)
                                    {
                                        @await DisplayAsync(await New.DateTime(Utc: DateTime.SpecifyKind(closes, DateTimeKind.Utc), Format: "g"))
                                    }
                                </td>
                                <td>@entry.Reason</td>
                                <td>@await DisplayAsync(await New.DateTime(Utc: DateTime.SpecifyKind(entry.CreatedUtc, DateTimeKind.Utc), Format: "g")) · @(Model.Names.TryGetValue(entry.Actor ?? string.Empty, out var actor) ? actor : entry.Actor)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<form method="post" asp-action="AddOverride" asp-route-quizId="@Model.QuizId">
    <div asp-validation-summary="ModelOnly"></div>

    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <button type="submit" class="btn btn-primary">@T["Give the Override"]</button>
        <a class="btn btn-secondary action-bar-secondary" asp-action="Index">@T["Back to Grading"]</a>
    </div>
</form>
