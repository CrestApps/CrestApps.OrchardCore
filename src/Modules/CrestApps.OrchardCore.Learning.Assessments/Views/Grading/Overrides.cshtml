@model QuizOverridesViewModel

<zone Name="Title">
    <breadcrumb name="LearningQuizOverrides" title="@(new Microsoft.AspNetCore.Html.HtmlString(System.Net.WebUtility.HtmlEncode(Model.QuizTitle + " · " + T["Overrides"].Value)))">
        <breadcrumb-item id="LearningGrading" action="Index" controller="Grading" area="CrestApps.OrchardCore.Learning.Assessments">@T["Grading"]</breadcrumb-item>
    </breadcrumb>
</zone>

<div class="card mb-3">
    <div class="card-header">@T["Overrides given"]</div>
    <div class="card-body">
        @if (Model.Overrides.Count == 0)
        {
            <p class="mb-0">@T["No override yet."]</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th scope="col">@T["Learner"]</th>
                            <th scope="col">@T["Extra minutes"]</th>
                            <th scope="col">@T["Extra attempts"]</th>
                            <th scope="col">@T["Window"]</th>
                            <th scope="col">@T["Reason"]</th>
                            <th scope="col">@T["Given"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.Overrides)
                        {
                            <tr>
                                <td>@(Model.Names.TryGetValue(entry.UserId, out var learner) ? learner : entry.UserId)</td>
                                <td>@entry.ExtraMinutes</td>
                                <td>@entry.ExtraAttempts</td>
                                <td>
                                    @if (entry.OpensUtc is { } opens)
                                    {
                                        @await DisplayAsync(await New.DateTime(Utc: DateTime.SpecifyKind(opens, DateTimeKind.Utc), Format: "g"))
                                    }
                                    –
                                    @if (entry.ClosesUtc is { } closes)
                                    {
                                        @await DisplayAsync(await New.DateTime(Utc: DateTime.SpecifyKind(closes, DateTimeKind.Utc), Format: "g"))
                                    }
                                </td>
                                <td>@entry.Reason</td>
                                <td>@await DisplayAsync(await New.DateTime(Utc: DateTime.SpecifyKind(entry.CreatedUtc, DateTimeKind.Utc), Format: "g")) · @(Model.Names.TryGetValue(entry.Actor ?? string.Empty, out var actor) ? actor : entry.Actor)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<form method="post" asp-action="AddOverride" asp-route-quizId="@Model.QuizId">
    <div class="card mb-3">
        <div class="card-header">@T["Give an override"]</div>
        <div class="card-body">
            <div asp-validation-summary="ModelOnly"></div>
            <div class="ocat-wrapper" asp-validation-class-for="UserName">
                <label asp-for="UserName" class="ocat-label">@T["Learner (user name)"]</label>
                <div class="ocat-end">
                    <input asp-for="UserName" class="form-control" required />
                    <span asp-validation-for="UserName"></span>
                </div>
            </div>
            <div class="ocat-wrapper" asp-validation-class-for="ExtraMinutes">
                <label asp-for="ExtraMinutes" class="ocat-label">@T["Extra minutes"]</label>
                <div class="ocat-end ocat-end-sm">
                    <input asp-for="ExtraMinutes" type="number" min="0" class="form-control" />
                    <span asp-validation-for="ExtraMinutes"></span>
                </div>
            </div>
            <div class="ocat-wrapper">
                <label asp-for="ExtraAttempts" class="ocat-label">@T["Extra attempts"]</label>
                <div class="ocat-end ocat-end-sm">
                    <input asp-for="ExtraAttempts" type="number" min="0" class="form-control" />
                </div>
            </div>
            <div class="ocat-wrapper">
                <label asp-for="Opens" class="ocat-label">@T["Opens instead"]</label>
                <div class="ocat-end">
                    <input asp-for="Opens" type="datetime-local" class="form-control" />
                </div>
            </div>
            <div class="ocat-wrapper">
                <label asp-for="Closes" class="ocat-label">@T["Closes instead"]</label>
                <div class="ocat-end">
                    <input asp-for="Closes" type="datetime-local" class="form-control" />
                    <span class="hint">@T["In your time zone. Leave empty to keep the quiz window."]</span>
                </div>
            </div>
            <div class="ocat-wrapper" asp-validation-class-for="Reason">
                <label asp-for="Reason" class="ocat-label">@T["Reason"]</label>
                <div class="ocat-end">
                    <input asp-for="Reason" class="form-control" required maxlength="500" />
                    <span asp-validation-for="Reason"></span>
                    <span class="hint">@T["Such as an accessibility accommodation or an illness. It is kept with the override."]</span>
                </div>
            </div>
        </div>
    </div>

    <div class="action-bar-bottom">
        <button type="submit" class="btn btn-primary">@T["Give the override"]</button>
        <a class="btn btn-secondary action-bar-secondary" asp-action="Index">@T["Back to grading"]</a>
    </div>
</form>
