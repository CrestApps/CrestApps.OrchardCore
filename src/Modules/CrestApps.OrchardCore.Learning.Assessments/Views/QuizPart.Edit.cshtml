@model QuizPartViewModel

<div class="card text-bg-theme mb-3">
    <div class="card-header">@T["Questions"]</div>
    <div class="card-body">
        <div class="ocat-wrapper" asp-validation-class-for="QuestionIds">
            <label asp-for="QuestionIds" class="ocat-label">@T["Every attempt includes"]</label>
            <div class="ocat-end">
                <select asp-for="QuestionIds" asp-items="Model.QuestionOptions" class="form-select" multiple size="8"></select>
                <span asp-validation-for="QuestionIds"></span>
                <span class="hint">@T["Published questions, in the order chosen. Hold Ctrl to choose several."]</span>
            </div>
        </div>

        <h3 class="h6 mt-3">@T["Draw at random"]</h3>
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th scope="col">@T["Question bank"]</th>
                        <th scope="col">@T["With the tag"]</th>
                        <th scope="col">@T["Difficulty"]</th>
                        <th scope="col">@T["How many"]</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model.DrawRules.Count; i++)
                    {
                        <tr>
                            <td>
                                <select asp-for="DrawRules[i].BankId" class="form-select form-select-sm" aria-label="@T["Question bank"]">
                                    <option value="">@T["No rule"]</option>
                                    @foreach (var bank in Model.BankOptions)
                                    {
                                        <option value="@bank.Value" selected="@(bank.Value == Model.DrawRules[i].BankId)">@bank.Text</option>
                                    }
                                </select>
                            </td>
                            <td><input asp-for="DrawRules[i].Tag" class="form-control form-control-sm" maxlength="100" aria-label="@T["With the tag"]" /></td>
                            <td><input asp-for="DrawRules[i].Difficulty" type="number" min="1" max="5" class="form-control form-control-sm" aria-label="@T["Difficulty"]" /></td>
                            <td><input asp-for="DrawRules[i].Count" type="number" min="0" class="form-control form-control-sm" aria-label="@T["How many"]" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <span class="hint">@T["Each attempt draws its own questions. A question is never drawn twice in one attempt."]</span>

        <div class="form-check mt-3">
            <input asp-for="ShuffleQuestions" type="checkbox" class="form-check-input" />
            <label asp-for="ShuffleQuestions" class="form-check-label">@T["Shuffle the questions in each attempt"]</label>
        </div>
    </div>
</div>

<div class="card text-bg-theme mb-3">
    <div class="card-header">@T["Attempts and timing"]</div>
    <div class="card-body">
        <div class="ocat-wrapper">
            <label asp-for="TimeLimitMinutes" class="ocat-label">@T["Time limit (minutes)"]</label>
            <div class="ocat-end ocat-end-sm">
                <input asp-for="TimeLimitMinutes" type="number" min="1" class="form-control" />
                <span class="hint">@T["The server submits the attempt when the time is up. Leave empty for no limit."]</span>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="MaxAttempts" class="ocat-label">@T["Attempts allowed"]</label>
            <div class="ocat-end ocat-end-sm">
                <input asp-for="MaxAttempts" type="number" min="1" class="form-control" />
                <span class="hint">@T["Leave empty for no limit."]</span>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="DelayMinutes" class="ocat-label">@T["Wait between attempts (minutes)"]</label>
            <div class="ocat-end ocat-end-sm">
                <input asp-for="DelayMinutes" type="number" min="0" class="form-control" />
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="GradingMethod" class="ocat-label">@T["Score from"]</label>
            <div class="ocat-end">
                <select asp-for="GradingMethod" class="form-select">
                    <option value="Highest">@T["The best attempt"]</option>
                    <option value="Latest">@T["The last attempt"]</option>
                    <option value="Average">@T["The average of the attempts"]</option>
                    <option value="First">@T["The first attempt"]</option>
                </select>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="PassMark" class="ocat-label">@T["Pass mark (%)"]</label>
            <div class="ocat-end ocat-end-sm">
                <input asp-for="PassMark" type="number" min="0" max="100" step="0.01" class="form-control" />
                <span class="hint">@T["Leave empty to use the pass mark of the course item."]</span>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="Navigation" class="ocat-label">@T["Navigation"]</label>
            <div class="ocat-end">
                <select asp-for="Navigation" class="form-select">
                    <option value="Free">@T["Any order, and come back to any question"]</option>
                    <option value="Sequential">@T["One after another, without going back"]</option>
                </select>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="Opens" class="ocat-label">@T["Opens"]</label>
            <div class="ocat-end">
                <input asp-for="Opens" type="datetime-local" class="form-control" />
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="Closes">
            <label asp-for="Closes" class="ocat-label">@T["Closes"]</label>
            <div class="ocat-end">
                <input asp-for="Closes" type="datetime-local" class="form-control" />
                <span asp-validation-for="Closes"></span>
                <span class="hint">@T["In your time zone. An attempt in progress ends when the quiz closes."]</span>
            </div>
        </div>
    </div>
</div>

<div class="card text-bg-theme mb-3">
    <div class="card-header">@T["Integrity and review"]</div>
    <div class="card-body">
        <div class="ocat-wrapper">
            <label asp-for="NewAccessCode" class="ocat-label">@T["Access code"]</label>
            <div class="ocat-end">
                <input asp-for="NewAccessCode" type="password" class="form-control" autocomplete="new-password" data-1p-ignore data-lpignore="true" data-bwignore />
                <span class="hint">@(Model.HasAccessCode ? T["A code is set. Type a new one to replace it; it is stored only as a hash."] : T["The learner types it to start, such as a code given in the exam room."])</span>
                @if (Model.HasAccessCode)
                {
                    <div class="form-check mt-1">
                        <input asp-for="ClearAccessCode" type="checkbox" class="form-check-input" />
                        <label asp-for="ClearAccessCode" class="form-check-label">@T["Remove the access code"]</label>
                    </div>
                }
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="HonorStatement" class="ocat-label">@T["Honor statement"]</label>
            <div class="ocat-end">
                <textarea asp-for="HonorStatement" class="form-control" rows="2" maxlength="1000"></textarea>
                <span class="hint">@T["The learner confirms it before starting. It is kept on the attempt."]</span>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="ReviewPolicy" class="ocat-label">@T["After an attempt, learners see"]</label>
            <div class="ocat-end">
                <select asp-for="ReviewPolicy" class="form-select">
                    <option value="AfterGraded">@T["Their answers, the right answers and the feedback, once graded"]</option>
                    <option value="AfterClose">@T["Their answers and the right answers once the quiz closes"]</option>
                    <option value="ScoreOnly">@T["Their score only"]</option>
                    <option value="Hidden">@T["Nothing"]</option>
                </select>
            </div>
        </div>
    </div>
</div>
