@model QuizPartViewModel

@{
    var survey = Model.Survey;
}

<div class="card text-bg-theme mb-3">
    <div class="card-header">@T["Quiz"]</div>
    <div class="card-body">
        @if (survey is null)
        {
            <div class="ocat-wrapper">
                <div class="ocat-end-offset">
                    <span class="hint">@T["Save the quiz first: saving creates its survey, where you add the questions, the time limit, the attempts and the pass mark."]</span>
                </div>
            </div>
        }
        else
        {
            <div class="ocat-wrapper">
                <span class="ocat-label">@T["Questions"]</span>
                <div class="ocat-end">
                    <span class="badge ta-badge fw-normal" title="@T["Status"]"><i class="fa-solid fa-circle-info me-1" aria-hidden="true"></i>@survey.Status</span>
                    <span class="badge ta-badge fw-normal" title="@T["Questions each attempt shows"]"><i class="fa-solid fa-list-ol me-1" aria-hidden="true"></i>@T["{0} questions", Model.QuestionCount]</span>
                    @if (survey.PublishedVersionNumber > 0)
                    {
                        <span class="badge ta-badge fw-normal" title="@T["Published version"]"><i class="fa-solid fa-code-branch me-1" aria-hidden="true"></i>@T["Version {0}", survey.PublishedVersionNumber]</span>
                    }
                    @if (survey.HasUnpublishedChanges)
                    {
                        <span class="badge text-bg-warning fw-normal">@T["Unpublished changes"]</span>
                    }
                </div>
            </div>
            @if (survey.PublishedVersionNumber == 0)
            {
                <div class="ocat-wrapper">
                    <div class="ocat-end-offset">
                        <div class="alert alert-warning mb-0">@T["Learners can attempt the quiz once its survey is published. Add the questions, then publish them in the designer."]</div>
                    </div>
                </div>
            }
            <div class="ocat-wrapper">
                <div class="ocat-end-offset">
                    <a class="btn btn-secondary btn-sm" href="@Url.Content("~/Admin/surveys/" + survey.ItemId + "/design")"><i class="fa-solid fa-pen-ruler me-1" aria-hidden="true"></i>@T["Edit questions"]</a>
                    <a class="btn btn-outline-secondary btn-sm" href="@Url.Content("~/Admin/surveys/" + survey.ItemId + "/access")"><i class="fa-solid fa-sliders me-1" aria-hidden="true"></i>@T["Attempts and window"]</a>
                    <a class="btn btn-outline-secondary btn-sm" href="@Url.Content("~/Admin/surveys/" + survey.ItemId + "/overrides")"><i class="fa-solid fa-user-clock me-1" aria-hidden="true"></i>@T["Accommodations"]</a>
                    <a class="btn btn-outline-secondary btn-sm" href="@Url.Content("~/Admin/surveys/" + survey.ItemId + "/responses")"><i class="fa-solid fa-list-check me-1" aria-hidden="true"></i>@T["Attempts"]</a>
                    <span class="hint">@T["The time limit, pass mark, review options and question pools are the survey's own settings; the attempt limit and window are on its access page."]</span>
                </div>
            </div>
        }

        <div class="ocat-wrapper" asp-validation-class-for="GradingMethod">
            <label asp-for="GradingMethod" class="ocat-label">@T["The quiz grade is"]</label>
            <div class="ocat-end">
                <select asp-for="GradingMethod" asp-items="Model.GradingMethods" class="form-select"></select>
                <span class="hint">@T["How the scores of a learner's attempts combine into their grade for the quiz."]</span>
            </div>
        </div>
    </div>
</div>
