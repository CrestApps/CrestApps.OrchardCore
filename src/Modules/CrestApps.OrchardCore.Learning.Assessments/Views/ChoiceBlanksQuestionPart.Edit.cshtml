@model ChoiceBlanksQuestionViewModel

<div class="card text-bg-theme mb-3">
    <div class="card-header">@T["Text and words"]</div>
    <div class="card-body">
        <div class="ocat-wrapper" asp-validation-class-for="Text">
            <label asp-for="Text" class="ocat-label">@T["Text with blanks"]</label>
            <div class="ocat-end">
                <textarea asp-for="Text" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Text"></span>
                <span class="hint">@(Model.DragIntoText ? T["Write the right word of each blank as [[word]]. Learners drag the words into the blanks, or pick them in each blank's list. Each blank earns its share of the points."] : T["Write the right word of each blank as [[word]]. Each blank is a drop-down list of the words. Each blank earns its share of the points."])</span>
            </div>
        </div>

        <div class="ocat-wrapper">
            <label asp-for="Distractors" class="ocat-label">@T["Wrong words"]</label>
            <div class="ocat-end">
                <textarea asp-for="Distractors" class="form-control" rows="3"></textarea>
                <span class="hint">@T["One a line. They are offered with the right words, and no blank takes them."]</span>
            </div>
        </div>

        <div class="ocat-wrapper">
            <div class="ocat-end ocat-start-offset">
                <div class="form-check">
                    <input asp-for="ShuffleChoices" type="checkbox" class="form-check-input" />
                    <label asp-for="ShuffleChoices" class="form-check-label">@T["Shuffle the words in each attempt"]</label>
                </div>
            </div>
        </div>
    </div>
</div>
