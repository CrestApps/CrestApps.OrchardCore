@using CrestApps.OrchardCore.Learning.Assessments.Workflows

@model AttemptEventActivityViewModel

<div class="mb-3">
    <label asp-for="QuizIds" class="form-label">@T["Quizzes"]</label>
    <select asp-for="QuizIds" asp-items="Model.QuizOptions" class="form-select" multiple size="6"></select>
    <span class="hint">@T["The quizzes that start the workflow. Choose none for every quiz."]</span>
</div>

<div class="mb-3">
    <div class="form-check">
        <input asp-for="IncludeWorkflowChanges" type="checkbox" class="form-check-input" />
        <label asp-for="IncludeWorkflowChanges" class="form-check-label">@T["Also start for changes a workflow made"]</label>
        <span class="hint dashed">@T["Off by default, so a workflow that voids or regrades an attempt does not start itself again."]</span>
    </div>
</div>
