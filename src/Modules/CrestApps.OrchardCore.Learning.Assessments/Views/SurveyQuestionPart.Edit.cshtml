@model SurveyQuestionViewModel

<div class="card text-bg-theme mb-3">
    <div class="card-header">@T["Options"]</div>
    <div class="card-body">
        <span asp-validation-for="Options"></span>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-2">
                <thead>
                    <tr>
                        <th scope="col">@T["Text"]</th>
                        <th scope="col">@T["Feedback when chosen"]</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model.Options.Count; i++)
                    {
                        <tr>
                            <td>
                                <input type="hidden" asp-for="Options[i].Id" />
                                <input asp-for="Options[i].Text" class="form-control form-control-sm" maxlength="1000" aria-label="@T["Text"]" />
                            </td>
                            <td><input asp-for="Options[i].Feedback" class="form-control form-control-sm" maxlength="1000" aria-label="@T["Feedback when chosen"]" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <span class="hint">@T["Every answer is accepted. Leave a row empty to remove it; save to get more empty rows. With zero points the question is not graded; with points, any answer earns them."]</span>

        <div class="form-check mt-3">
            <input asp-for="Multiple" type="checkbox" class="form-check-input" />
            <label asp-for="Multiple" class="form-check-label">@T["Learners may choose several options"]</label>
        </div>
    </div>
</div>
