@model SimpleQuestionViewModel

<div class="card text-bg-theme mb-3">
    <div class="card-header">@T["Answer"]</div>
    <div class="card-body">
        <div class="ocat-wrapper">
            <span class="ocat-label">@T["The statement is"]</span>
            <div class="ocat-end">
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" asp-for="Answer" value="true" id="@Html.IdFor(m => m.Answer)-true" />
                    <label class="form-check-label" for="@Html.IdFor(m => m.Answer)-true">@T["True"]</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" asp-for="Answer" value="false" id="@Html.IdFor(m => m.Answer)-false" />
                    <label class="form-check-label" for="@Html.IdFor(m => m.Answer)-false">@T["False"]</label>
                </div>
            </div>
        </div>
    </div>
</div>
