@model AttemptRowViewModel

@if (Model.Attempt.SubmittedUtc is { } submitted)
{
    <span class="badge ta-badge fw-normal"><i class="fa-regular fa-clock text-secondary me-1" aria-hidden="true"></i>@await DisplayAsync(await New.DateTime(Utc: DateTime.SpecifyKind(submitted, DateTimeKind.Utc), Format: "g"))</span>
}
