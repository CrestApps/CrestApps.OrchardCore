@using CrestApps.OrchardCore.Learning.Assessments.Workflows

@model AttemptTaskViewModel

<div class="mb-3">
    <label asp-for="AttemptId" class="form-label">@T["Attempt id"]</label>
    <input asp-for="AttemptId" class="form-control code" />
    <span class="hint">@T["The id of the attempt, a Liquid expression such as Workflow.Input.AttemptId between double braces."]</span>
</div>

<div class="mb-3">
    <label asp-for="Reason" class="form-label">@T["Reason"]</label>
    <input asp-for="Reason" class="form-control code" />
    <span class="hint">@T["Why. Required; kept in the attempt's score history."]</span>
</div>

<div class="mb-3">
    <label asp-for="OutputName" class="form-label">@T["Output name"]</label>
    <input asp-for="OutputName" class="form-control code" />
    <span class="hint">@T["The workflow output that holds the result. Defaults to Attempt."]</span>
</div>
