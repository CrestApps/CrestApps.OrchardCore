@model GradeScaleRowViewModel

<a asp-controller="GradeScales" asp-action="Edit" asp-route-id="@Model.Scale.ItemId" class="btn btn-primary btn-sm">@T["Edit"]</a>
<a asp-controller="GradeScales" asp-action="Delete" asp-route-id="@Model.Scale.ItemId" class="btn btn-danger btn-sm" data-url-af="RemoveUrl UnsafeUrl" data-title="@T["Delete"]" data-message="@T["Delete this grade scale?"]">@T["Delete"]</a>
