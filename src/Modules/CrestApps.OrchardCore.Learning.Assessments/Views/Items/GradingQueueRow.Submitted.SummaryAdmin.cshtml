@model ShapeViewModel<GradingQueueRow>

<span class="badge ta-badge fw-normal"><i class="fa-regular fa-clock text-secondary me-1" aria-hidden="true"></i>@if (Model.Value.Item.SubmittedDay is { } day) { @day } else { @await DisplayAsync(await New.DateTime(Utc: DateTime.SpecifyKind(Model.Value.Item.SubmittedUtc, DateTimeKind.Utc), Format: "g")) }</span>
