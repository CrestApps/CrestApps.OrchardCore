<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
    <Title>CrestApps OrchardCore Learning Assessments</Title>
    <Description>
      $(CrestAppsDescription)

      Assessments for CrestApps Learning: question banks of nine question types, the quiz course item with fixed and
      random questions, self-contained attempts with server deadlines, grading of essays, regrades, overrides, grade
      scales and the gradebook, item analysis, and the exam player.
    </Description>
    <PackageTags>$(PackageTags) CrestApps OrchardCoreCMS Learning LMS Assessments Quiz Exam Gradebook</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
