@model ListLocalDncListsViewModel

@{
    var emptyMessage = T["No local DNC lists have been uploaded yet. Click \"Upload new list\" to add phone numbers."];
}

@* The action bar holds the Create zone of the options editor; its Summary zone is rendered by the AdminList shape
   above the rows. *@
<div class="card text-bg-theme mb-3 position-sticky action-bar">
    <div class="card-body">
        <div class="row gx-2 justify-content-end">
            @if (Model.Header?.Create != null)
            {
                <div class="col-auto">
                    @await DisplayAsync(Model.Header.Create)
                </div>
            }
        </div>
    </div>
</div>

@* The lists, the header summary and the pager are rendered by the AdminList shape, in the layout (List or Grid) the site or the user picked. *@
<admin-list name="LocalDncLists" context="Model.List"
            show-select-all="false"
            empty-message="@emptyMessage">
    <admin-list-list item-css-class="list-group-item" />
    <admin-list-grid>
        <admin-list-column name="Name" position="20" title="@T["Name"]" />
        <admin-list-column name="Status" position="30" title="@T["Status"]" />
        <admin-list-column type="Actions" title="@T["Actions"]" />
    </admin-list-grid>
</admin-list>
