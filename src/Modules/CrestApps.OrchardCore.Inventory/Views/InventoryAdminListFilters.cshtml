@*
    The "Show" filter of the inventory list, passed to the admin list as its 'ToolbarActions' so they render at the end of the list's
    toolbar. The selects name the filter form, so they submit it wherever the list is rendered; the
    commerce-admin-list script submits it when one changes.
*@
@{
    var options = (InventoryIndexOptions)Model.Options;
}

<div class="btn-group filter">
    <select name="Options.Filter" asp-items="options.Filters" form="inventory-filter" class="selectpicker show-tick" data-style="btn-sm" data-width="fit" data-header="@T["Show"]" data-dropdown-align-right="auto" data-commerce-list-filter aria-label="@T["Show"]"></select>
</div>
