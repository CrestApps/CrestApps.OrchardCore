@model InventorySettingsViewModel

<div class="ocat-wrapper" asp-validation-class-for="DefaultLowStockThreshold">
    <label asp-for="DefaultLowStockThreshold" class="ocat-label">@T["Low-stock threshold"]</label>
    <div class="ocat-end">
        <input asp-for="DefaultLowStockThreshold" type="number" min="0" class="form-control" />
        <span asp-validation-for="DefaultLowStockThreshold"></span>
        <span class="hint">@T["Stock counts as low at this many available units or fewer, for products without their own threshold. Low stock is flagged under Commerce > Inventory."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="HoldMinutes">
    <label asp-for="HoldMinutes" class="ocat-label ocat-label-required">@T["Hold stock for (minutes)"]</label>
    <div class="ocat-end">
        <input asp-for="HoldMinutes" type="number" min="1" class="form-control" />
        <span asp-validation-for="HoldMinutes"></span>
        <span class="hint">@T["When a buyer starts checkout, the units they're buying are held for them this long. A payment that arrives later still sells them."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <div class="ocat-label">@T["Notify about low stock"]</div>
    <div class="ocat-end">
        @foreach (var role in Model.Roles)
        {
            var id = Html.IdFor(m => m.LowStockNotificationRoles) + "_" + role.Replace(' ', '_');

            <div class="form-check">
                <input type="checkbox" class="form-check-input" id="@id" name="@Html.NameFor(m => m.LowStockNotificationRoles)" value="@role" checked="@Model.LowStockNotificationRoles.Contains(role, StringComparer.OrdinalIgnoreCase)" />
                <label class="form-check-label" for="@id">@role</label>
            </div>
        }
        <span class="hint">@T["Users in these roles get a notification when a product or variant runs low or sells out. Notifications need the Notifications feature. A Low Stock workflow event fires too, when Workflows is on."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <h4 class="mt-4">@T["Locations"]</h4>
        <p class="text-body-secondary">@T["The places you keep stock, such as warehouses and shops. Orders take their units from one location that has them all, trying the locations from the top; an order picked up at a shop takes them from that shop's stock location first. Leave the blank location empty to add none."]</p>
    </div>
</div>

@for (var i = 0; i < Model.Locations.Count; i++)
{
    var location = Model.Locations[i];
    var isNew = string.IsNullOrEmpty(location.LocationId);

    <fieldset class="border rounded p-3 mb-3">
        <legend class="float-none w-auto fs-6 px-1 mb-0">
            @(isNew ? T["Add a location"] : location.IsDefault ? T["Default location"] : T["Location"])
        </legend>
        <input type="hidden" asp-for="Locations[i].LocationId" />
        <div class="ocat-wrapper" asp-validation-class-for="Locations[i].Name">
            <label asp-for="Locations[i].Name" class="ocat-label @(location.IsDefault ? "ocat-label-required" : "")">@T["Name"]</label>
            <div class="ocat-end">
                <input asp-for="Locations[i].Name" class="form-control" placeholder="@T["Main warehouse"]" />
                <span asp-validation-for="Locations[i].Name"></span>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="Locations[i].Address" class="ocat-label">@T["Address"]</label>
            <div class="ocat-end">
                <input asp-for="Locations[i].Address" class="form-control" autocomplete="off" />
                <span class="hint">@T["Optional, for your staff."]</span>
            </div>
        </div>
        @if (location.IsDefault)
        {
            <div class="ocat-wrapper">
                <div class="ocat-end-offset">
                    <span class="hint">@T["Stock counted before there were locations is here, and so is stock imported without a location. It can't be removed."]</span>
                </div>
            </div>
        }
        else if (!isNew)
        {
            <div class="ocat-wrapper">
                <div class="ocat-end-offset">
                    <div class="form-check">
                        <input asp-for="Locations[i].Remove" type="checkbox" class="form-check-input" />
                        <label asp-for="Locations[i].Remove" class="form-check-label">@T["Remove this location"]</label>
                    </div>
                    <span class="hint dashed">@T["Units still there stay on their items and can be moved to another location."]</span>
                </div>
            </div>
        }
    </fieldset>
}
