@using Microsoft.AspNetCore.Mvc.Rendering
@*
    The status filter of the memberships list, passed to the admin list as its 'ToolbarActions' so it renders at the end
    of the list's toolbar. The select names the filter form, so it submits it wherever the list is rendered; the
    commerce-admin-list script submits it when it changes.
*@
@{
    var statuses = (IEnumerable<SelectListItem>)Model.Statuses;
}

<div class="btn-group filter">
    <select name="status" asp-items="statuses" form="memberships-filter" class="selectpicker show-tick" data-style="btn-sm" data-width="fit" data-header="@T["Filter by status"]" data-dropdown-align-right="auto" data-commerce-list-filter aria-label="@T["Status"]"></select>
</div>
