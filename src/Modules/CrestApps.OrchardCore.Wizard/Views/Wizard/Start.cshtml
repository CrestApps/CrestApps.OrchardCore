@using CrestApps.OrchardCore.Wizard.ViewModels

@model WizardViewModel

<form id="wizard-form" method="post" asp-route="@CrestApps.OrchardCore.Wizard.WizardConstants.RouteNames.Start" asp-route-wizardType="@Model.WizardType">

    <input type="hidden" name="wizardType" value="@Model.WizardType" />
    <input type="hidden" name="definitionId" value="@Model.DefinitionId" />
    <input type="hidden" name="step" value="@Model.Step" />
    <input type="hidden" name="sessionId" value="@Model.SessionId" />

    @await DisplayAsync(Model.Content)
</form>
