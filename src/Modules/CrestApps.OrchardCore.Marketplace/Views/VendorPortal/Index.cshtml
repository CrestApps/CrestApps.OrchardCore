@model IShape

@{
    // The shape is made from the dashboard's model, so it is one.
    var canConnect = (Model as VendorDashboardViewModel)?.CanConnectStripe == true;
}

<zone Name="Title">
    <breadcrumb name="VendorPortal" title="@T["Vendor"]">
        <breadcrumb-item id="CommerceAccount" title="@T["Your account"]" href="@Url.RouteUrl(CommerceConstants.Account.HomeRouteName)" />
    </breadcrumb>
</zone>

<div class="container my-4">
    <div class="row g-4">
        <div class="col-lg-3">
            @await DisplayAsync(await New.CommerceAccountNavigation())
        </div>
        <div class="col-lg-9">
            <h1 class="h3 mb-3">@T["Your sales"]</h1>

            @if (canConnect)
            {
                <div class="alert alert-info d-flex flex-wrap align-items-center gap-2">
                    <span class="flex-grow-1">@T["Set up your payouts with Stripe to be paid for your sales."]</span>
                    <form method="post" action="@Url.Action("SetUpPayouts", "VendorPortal", new { area = MarketplaceConstants.Feature })">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary btn-sm">@T["Set up payouts"]</button>
                    </form>
                </div>
            }

            @await DisplayAsync(Model)
        </div>
    </div>
</div>
