@using Microsoft.AspNetCore.Html
@model IShape

@{
    // The shape is made from the dashboard's model, so it is one.
    var canConnect = (Model as VendorDashboardViewModel)?.CanConnectStripe == true;
}

<zone Name="Title">
    <breadcrumb name="VendorPortal" title="@T["Vendor"]">
        <breadcrumb-item id="CommerceAccount" url="@Url.RouteUrl(CommerceConstants.Account.HomeRouteName)">@T["Your account"]</breadcrumb-item>
    </breadcrumb>
</zone>

@{
    Func<object, IHtmlContent> payoutsNotice = @<div class="alert alert-info d-flex flex-wrap align-items-center gap-2">
        <span class="flex-grow-1">@T["Set up your payouts with Stripe to be paid for your sales."]</span>
        <form method="post" action="@Url.Action("SetUpPayouts", "VendorPortal", new { area = MarketplaceConstants.Feature })">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary btn-sm">@T["Set up payouts"]</button>
        </form>
    </div>;

    var content = new HtmlContentBuilder();

    if (canConnect)
    {
        content.AppendHtml(payoutsNotice(null));
    }

    content.AppendHtml(await DisplayAsync(Model));
}

@await DisplayAsync(await New.CommerceAccountPage(Title: T["Your sales"], Content: content))
