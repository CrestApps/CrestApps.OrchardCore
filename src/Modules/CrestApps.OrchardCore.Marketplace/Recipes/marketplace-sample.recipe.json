{
  "name": "MarketplaceSample",
  "displayName": "Marketplace sample",
  "description": "Turns on the marketplace with Stripe Connect payouts at a 10% commission, and adds a Vendor Product type with the Vendor part and a Handmade Ceramic Mug at $30. Add a vendor under Commerce > Vendors, then choose it on the mug.",
  "author": "CrestApps",
  "website": "https://crestapps.com",
  "version": "1.0.0",
  "issetuprecipe": false,
  "categories": [
    "commerce"
  ],
  "tags": [
    "commerce",
    "products",
    "marketplace",
    "vendors",
    "sample"
  ],
  "steps": [
    {
      "name": "feature",
      "enable": [
        "OrchardCore.Contents",
        "OrchardCore.Title",
        "OrchardCore.Autoroute",
        "OrchardCore.Html",
        "CrestApps.OrchardCore.Products",
        "CrestApps.OrchardCore.Carts",
        "CrestApps.OrchardCore.Orders",
        "CrestApps.OrchardCore.Checkout",
        "CrestApps.OrchardCore.Marketplace",
        "CrestApps.OrchardCore.Marketplace.StripeConnect"
      ]
    },
    {
      "name": "ContentDefinition",
      "ContentTypes": [
        {
          "Name": "VendorProduct",
          "DisplayName": "Vendor Product",
          "Settings": {
            "ContentTypeSettings": {
              "Creatable": true,
              "Listable": true,
              "Draftable": true,
              "Versionable": true,
              "Securable": false
            }
          },
          "ContentTypePartDefinitionRecords": [
            { "PartName": "TitlePart", "Name": "TitlePart", "Settings": { "ContentTypePartSettings": { "Position": "0" } } },
            { "PartName": "AutoroutePart", "Name": "AutoroutePart", "Settings": { "ContentTypePartSettings": { "Position": "1" }, "AutoroutePartSettings": { "AllowCustomPath": true, "Pattern": "makers/{{ ContentItem | display_text | slugify }}" } } },
            { "PartName": "ProductPart", "Name": "ProductPart", "Settings": { "ContentTypePartSettings": { "Position": "2" }, "ProductPartSettings": { "Type": "Service", "DefaultCurrency": "USD", "SalesMode": "Purchasable", "PriceDisplay": "Show" }, "ProductPageSettings": { "ShowDetails": true } } },
            { "PartName": "HtmlBodyPart", "Name": "HtmlBodyPart", "Settings": { "ContentTypePartSettings": { "Position": "3", "DisplayName": "Description" } } },
            { "PartName": "VendorPart", "Name": "VendorPart", "Settings": { "ContentTypePartSettings": { "Position": "4" } } }
          ]
        }
      ]
    },
    {
      "name": "content",
      "data": [
        {
          "ContentItemId": "4mrktprod0ceramicmug00000a",
          "ContentItemVersionId": "4mrktprod0ceramicmug00000b",
          "ContentType": "VendorProduct",
          "DisplayText": "Handmade Ceramic Mug",
          "Latest": true,
          "Published": true,
          "ModifiedUtc": "2026-10-20T12:00:00Z",
          "PublishedUtc": "2026-10-20T12:00:00Z",
          "CreatedUtc": "2026-10-20T12:00:00Z",
          "Owner": null,
          "Author": "admin",
          "TitlePart": { "Title": "Handmade Ceramic Mug" },
          "AutoroutePart": { "Path": "makers/handmade-ceramic-mug", "SetHomepage": false, "Disabled": false, "RouteContainedItems": false, "Absolute": false },
          "ProductPart": { "Price": 30, "Currency": "USD", "Sku": "MAKER-MUG", "IsPurchasable": true },
          "HtmlBodyPart": { "Html": "<p>A stoneware mug thrown and glazed by hand, sold for one of our makers.</p>" },
          "VendorPart": { "VendorId": null }
        }
      ]
    }
  ]
}
