@model CrestApps.OrchardCore.Accounts.ViewModels.AccountInvitationViewModel

<div class="container my-4" style="max-width: 40rem">
    <div class="product-breadcrumb">
        <breadcrumb name="AccountInvitation" title="@T["Invitation"]">
            <breadcrumb-item id="Home" url="@Url.Content("~/")">@T["Home"]</breadcrumb-item>
        </breadcrumb>
    </div>
    <h1 class="h3 mb-3">@T["Invitation"]</h1>
    @if (Model.IsExpired)
    {
        <p class="text-muted">@T["This invitation has expired. Ask the account for a new one."]</p>
    }
    else if (!Model.IsValid)
    {
        <p class="text-muted">@T["This invitation is not valid any more. It was accepted, taken back, or the link is wrong. Ask the account for a new one."]</p>
    }
    else
    {
        <p>@T["You are invited to join {0}.", Model.AccountName ?? string.Empty]</p>
        @if (!string.IsNullOrWhiteSpace(Model.Invitation.Message))
        {
            <blockquote class="border-start ps-3 text-muted">@Model.Invitation.Message</blockquote>
        }
        <p class="small text-muted">@T["The invitation was sent to {0}. Sign in, or create an account, with that address to accept it.", Model.Invitation.Email]</p>
        @if (Model.NeedsEmailConfirmation)
        {
            <div class="alert alert-info">
                <p class="mb-2">@T["Confirm your e-mail address before you accept: open the link in the confirmation e-mail we sent you."]</p>
                <form method="post" asp-area="OrchardCore.Users" asp-controller="EmailConfirmation" asp-action="SendVerificationEmail" asp-route-returnUrl="@Context.Request.Path">
                    <button type="submit" class="btn btn-sm btn-outline-primary">@T["Send the Confirmation E-mail Again"]</button>
                </form>
            </div>
        }
        @if (User.Identity?.IsAuthenticated == true)
        {
            <form method="post" action="~/account/invitations/@Uri.EscapeDataString(Model.Token)">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary">@T["Accept the Invitation"]</button>
            </form>
        }
        else
        {
            <a class="btn btn-primary" href="~/Login?returnUrl=@Uri.EscapeDataString(Context.Request.Path)">@T["Sign In to Accept"]</a>
        }
    }
</div>
