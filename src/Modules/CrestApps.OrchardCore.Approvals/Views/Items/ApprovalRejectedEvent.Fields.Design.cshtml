@using CrestApps.OrchardCore.Approvals.Workflows
@using OrchardCore.Workflows.Helpers
@using OrchardCore.Workflows.ViewModels

@model ActivityViewModel<ApprovalRejectedEvent>

<header><h4><i class="fa-solid fa-circle-xmark" aria-hidden="true"></i> @Model.Activity.GetTitleOrDefault(() => T["Approval Rejected"])</h4></header>
<p class="hint">@T["Starts when an approver rejects a request. Input: RequestId, SubjectKind, SubjectId, Title, PolicyId, PolicyTitle, Status, Change, RequesterName, ApproverUserNames (comma separated, for Notify User Task), Decider, Note and DueUtc."]</p>
