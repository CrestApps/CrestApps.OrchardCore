@using CrestApps.OrchardCore.Currencies
@model ApprovalDecideViewModel

@{
    var request = Model.Request;
    var stages = request.GetStages();
}

<zone Name="Title">
    <breadcrumb name="ApprovalRequestsDecide" title="@(string.IsNullOrEmpty(request.Title) ? T["Approval request"] : T["Request: {0}", request.Title])">
        <breadcrumb-item id="ApprovalRequests" action="Index" controller="ApprovalRequests" area="CrestApps.OrchardCore.Approvals">@T["Approvals"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form method="post" class="no-multisubmit">
    @Html.ValidationSummary()

    <div class="card mb-3">
        <div class="card-header">@T["The request"]</div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">@T["Type"]</dt>
                <dd class="col-sm-9">@Model.TypeDisplayName</dd>
                <dt class="col-sm-3">@T["Asked"]</dt>
                <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.SubjectDisplay) ? request.Title : Model.SubjectDisplay)</dd>
                <dt class="col-sm-3">@T["Policy"]</dt>
                <dd class="col-sm-9">@request.PolicyTitle</dd>
                <dt class="col-sm-3">@T["Requested by"]</dt>
                <dd class="col-sm-9">
                    @if (string.IsNullOrEmpty(request.RequesterName))
                    {
                        @T["A workflow"]
                    }
                    else
                    {
                        @request.RequesterName
                    }
                    · @Model.CreatedLocal.ToString("g")
                </dd>
                @if (request.Amount is { } amount && !string.IsNullOrEmpty(request.Currency))
                {
                    <dt class="col-sm-3">@T["Amount"]</dt>
                    <dd class="col-sm-9">@CurrencyScale.FormatForDisplay(amount, request.Currency) @request.Currency</dd>
                }
                @if (Model.DueLocal is { } due)
                {
                    <dt class="col-sm-3">@T["Due"]</dt>
                    <dd class="col-sm-9">@due.ToString("g")</dd>
                }
                <dt class="col-sm-3">@T["Status"]</dt>
                <dd class="col-sm-9">
                    @(request.Status switch
                    {
                        ApprovalStatus.Approved => T["Approved"],
                        ApprovalStatus.Rejected => T["Rejected"],
                        ApprovalStatus.Canceled => string.IsNullOrEmpty(request.CancelReason) ? T["Withdrawn"] : T["Withdrawn: {0}", request.CancelReason],
                        _ => stages.Count > 1
                            ? T["Waiting at stage {0} of {1}: {2} of {3} approvals", request.CurrentStage + 1, stages.Count, request.StageApprovalCount, request.GetCurrentStage().RequiredApprovals]
                            : T["Waiting: {0} of {1} approvals", request.StageApprovalCount, request.GetCurrentStage().RequiredApprovals],
                    })
                </dd>
                @if (!string.IsNullOrEmpty(Model.SubjectUrl))
                {
                    <dt class="col-sm-3">@T["Subject"]</dt>
                    <dd class="col-sm-9"><a href="@Url.Content(Model.SubjectUrl)">@T["Open what this is about"]</a></dd>
                }
            </dl>
        </div>
    </div>

    @if (stages.Count > 1)
    {
        <div class="card mb-3">
            <div class="card-header">@T["Stages"]</div>
            <ul class="list-group list-group-flush">
                @for (var i = 0; i < stages.Count; i++)
                {
                    var stage = stages[i];
                    var approvals = request.Decisions.Count(decision => decision.Stage == i && decision.Kind == ApprovalDecisionKind.Approve);
                    var state = request.Status == ApprovalStatus.Approved || i < request.CurrentStage
                        ? T["Approved"]
                        : i == request.CurrentStage && request.Status == ApprovalStatus.Pending
                            ? T["{0} of {1} approvals", approvals, stage.RequiredApprovals]
                            : i == request.CurrentStage ? T["Closed"] : T["Not started"];
                    <li class="list-group-item @(i == request.CurrentStage && request.Status == ApprovalStatus.Pending ? "fw-semibold" : null)">
                        @T["Stage {0}", i + 1]@(string.IsNullOrEmpty(stage.Title) ? null : ": " + stage.Title) <span class="text-muted small">· @state</span>
                    </li>
                }
            </ul>
        </div>
    }

    @if (Model.Display is not null)
    {
        @await DisplayAsync(Model.Display)
    }

    @if (request.Decisions.Count > 0)
    {
        <div class="card mb-3">
            <div class="card-header">@T["Decisions"]</div>
            <ul class="list-group list-group-flush">
                @for (var i = 0; i < request.Decisions.Count; i++)
                {
                    var decision = request.Decisions[i];
                    <li class="list-group-item">
                        <i class="fa-solid @(decision.Kind == ApprovalDecisionKind.Approve ? "fa-circle-check text-success" : "fa-circle-xmark text-danger") me-1" aria-hidden="true"></i>
                        @(decision.Kind == ApprovalDecisionKind.Approve ? T["{0} approved", decision.UserName] : T["{0} rejected", decision.UserName])
                        @if (stages.Count > 1)
                        {
                            <span class="text-muted small">· @(stages[Math.Clamp(decision.Stage, 0, stages.Count - 1)].Title ?? T.GetString("Stage {0}", decision.Stage + 1).Value)</span>
                        }
                        <span class="text-muted small">· @Model.DecisionTimes[i].ToString("g")</span>
                        @if (!string.IsNullOrEmpty(decision.Note))
                        {
                            <div class="small">@decision.Note</div>
                        }
                    </li>
                }
            </ul>
        </div>
    }

    @if (request.Status == ApprovalStatus.Pending)
    {
        @if (Model.Eligibility.CanDecide)
        {
            @await DisplayAsync(Model.Editor)
        }
        else if (!string.IsNullOrEmpty(Model.Eligibility.Reason))
        {
            <div class="alert alert-info">@Model.Eligibility.Reason</div>
        }
    }

    <div class="action-bar-bottom">
        @if (request.Status == ApprovalStatus.Pending && Model.Eligibility.CanDecide)
        {
            <button class="btn btn-success" type="submit" name="decision" value="Approve">@T["Approve"]</button>
            <button class="btn btn-danger" type="submit" name="decision" value="Reject">@T["Reject"]</button>
        }
        @if (Model.CanCancel)
        {
            <button class="btn btn-outline-secondary action-bar-secondary" type="submit" asp-action="Cancel" asp-route-id="@request.ItemId" data-confirm-title="@T["Withdraw"]" data-confirm="@T["Withdraw this request? Its approvers are no longer asked."]" data-confirm-ok="@T["Withdraw"]">@T["Withdraw"]</button>
        }
        <a class="btn btn-secondary cancel" role="button" asp-action="Index">@T["Back"]</a>
    </div>
</form>
<script asp-name="crestapps-browser" at="Foot"></script>
