@model ApprovalRequestsIndexViewModel

<zone Name="Title">
    <breadcrumb name="ApprovalRequests" title="@T["Approvals"]" />
</zone>

<form asp-action="Index" method="get" id="approval-requests-filter" class="no-multisubmit">
    <input type="hidden" asp-for="View" />
    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <ul class="nav nav-pills">
                <li class="nav-item">
                    <a class="nav-link @(Model.View == ApprovalRequestsIndexViewModel.WaitingView ? "active" : null)" asp-action="Index" asp-route-view="@ApprovalRequestsIndexViewModel.WaitingView" asp-route-type="@Model.Type">@T["Waiting for me"]</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(Model.View == ApprovalRequestsIndexViewModel.MineView ? "active" : null)" asp-action="Index" asp-route-view="@ApprovalRequestsIndexViewModel.MineView" asp-route-type="@Model.Type">@T["My requests"]</a>
                </li>
                @if (Model.CanSeeAll)
                {
                    <li class="nav-item">
                        <a class="nav-link @(Model.View == ApprovalRequestsIndexViewModel.AllView ? "active" : null)" asp-action="Index" asp-route-view="@ApprovalRequestsIndexViewModel.AllView" asp-route-type="@Model.Type">@T["All requests"]</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</form>

@{
    Model.List.ToolbarActions = await New.ApprovalRequestsFilter(ViewModel: Model, FormId: "approval-requests-filter");
}

<admin-list name="ApprovalRequests" context="Model.List"
            show-select-all="false"
            empty-message="@(Model.View == ApprovalRequestsIndexViewModel.WaitingView ? T["<strong>Nothing here!</strong> No request is waiting for your decision."] : T["<strong>Nothing here!</strong> No approval request matches."])">
    <admin-list-list item-css-class="list-group-item" />
    <admin-list-grid>
        <admin-list-column name="Request" position="10" title="@T["Request"]" />
        <admin-list-column name="Details" position="20" title="@T["Details"]" />
        <admin-list-column name="Status" position="30" title="@T["Status"]" width="auto" />
        <admin-list-column type="Actions" title="@T["Actions"]" />
    </admin-list-grid>
</admin-list>
