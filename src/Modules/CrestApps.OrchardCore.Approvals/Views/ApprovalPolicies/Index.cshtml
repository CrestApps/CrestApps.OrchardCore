@using CrestApps.OrchardCore.Approvals.Controllers
@using CrestApps.OrchardCore.Approvals.Services
@model ListCatalogEntryViewModel<CatalogEntryViewModel<ApprovalPolicy>>

@{
    var types = ViewData[ApprovalPoliciesController.TypesViewDataKey] as IReadOnlyList<ApprovalType> ?? [];
}

<zone Name="Title">
    <breadcrumb name="ApprovalPolicies" title="@T["Approval Policies"]">
        <breadcrumb-item id="ApprovalRequests" action="Index" controller="ApprovalRequests" area="CrestApps.OrchardCore.Approvals" permission="@ApprovalsPermissions.ViewApprovalRequests.Name">@T["Approvals"]</breadcrumb-item>
    </breadcrumb>
</zone>

@* The form is necessary to generate an antiforgery token for delete actions. *@
<form asp-action="Index" method="post" class="no-multisubmit" data-list-management data-client-side-search="true">
    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <div class="input-group">
                        <input id="search-box" class="form-control" placeholder="@T["Search"]" type="search" autofocus autocomplete="off" />
                        <button type="button" class="btn btn-outline-secondary" title="@T["Search"]" aria-label="@T["Search"]"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
                    </div>
                </div>
                <div class="col-auto">
                    <button type="button" class="btn btn-secondary create" data-bs-toggle="modal" data-bs-target="#modalAddApprovalPolicy">@T["Add Approval Policy"]</button>
                </div>
            </div>
        </div>
    </div>

    <admin-list name="ApprovalPolicies" context="Model.List"
                show-select-all="false"
                empty-message="@T["<strong>Nothing here!</strong> No approval policy has been added yet. A policy says who may decide a kind of approval and how many must."]">
        <admin-list-list item-css-class="list-group-item" />
        <admin-list-grid>
            <admin-list-column name="Name" position="20" title="@T["Name"]" />
            <admin-list-column name="Details" position="30" title="@T["Details"]" width="auto" />
            <admin-list-column type="Actions" title="@T["Actions"]" />
        </admin-list-grid>
    </admin-list>

    <div id="list-alert" class="alert alert-info my-3 d-none text-center" role="alert">@T["Your search returned no results."]</div>
</form>

<div class="modal fade" id="modalAddApprovalPolicy" tabindex="-1" aria-labelledby="approval-policy-types-title" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="approval-policy-types-title">@T["What does the policy approve?"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Close"]"></button>
            </div>
            <div class="modal-body">
                @if (types.Count == 0)
                {
                    <p class="alert alert-warning mb-0">@T["No approval type is available. A feature that asks for approvals, such as Payroll, adds its type."]</p>
                }
                else
                {
                    <div class="row row-cols-1 row-cols-md-2 g-3">
                        @foreach (var type in types)
                        {
                            IShape shape = await New.ApprovalPolicyType_Link(Type: type);
                            shape.Metadata.Alternates.Add("ApprovalPolicyType_Link__" + type.Name);

                            @await DisplayAsync(shape)
                        }
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@T["Cancel"]</button>
            </div>
        </div>
    </div>
</div>

<script asp-name="list-management-ui" at="Foot"></script>
