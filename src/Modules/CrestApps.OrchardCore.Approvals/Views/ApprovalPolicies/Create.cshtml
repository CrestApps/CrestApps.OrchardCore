@model EditCatalogEntryViewModel

<zone Name="Title">
    <breadcrumb name="ApprovalPoliciesCreate" title="@T["New approval policy"]">
        <breadcrumb-item id="ApprovalRequests" action="Index" controller="ApprovalRequests" area="CrestApps.OrchardCore.Approvals" permission="@ApprovalsPermissions.ViewApprovalRequests.Name">@T["Approvals"]</breadcrumb-item>
        <breadcrumb-item id="ApprovalPolicies" action="Index" controller="ApprovalPolicies" area="CrestApps.OrchardCore.Approvals" permission="@ApprovalsPermissions.ManageApprovalPolicies.Name">@T["Policies"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form method="post" class="no-multisubmit">
    @Html.ValidationSummary()
    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <button class="btn btn-primary" type="submit">@T["Save"]</button>
        <a class="btn btn-secondary cancel" role="button" asp-route-action="Index">@T["Cancel"]</a>
    </div>
</form>
