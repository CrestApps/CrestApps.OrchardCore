@using OrchardCore.DisplayManagement
@model ApprovalPolicyViewModel

<div class="card mb-3">
    <div class="card-header">@T["The policy"]</div>
    <div class="card-body">
        <div class="ocat-wrapper" asp-validation-class-for="Title">
            <label asp-for="Title" class="ocat-label ocat-label-required">@T["Title"]</label>
            <div class="ocat-end">
                <input asp-for="Title" class="form-control" maxlength="255" />
                <span asp-validation-for="Title" class="text-danger"></span>
                <span class="hint">@T["What approvers see, such as Pay run approval."]</span>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="Name">
            <label asp-for="Name" class="ocat-label ocat-label-required">@T["Technical name"]</label>
            <div class="ocat-end">
                <input asp-for="Name" class="form-control code" maxlength="255" />
                <span asp-validation-for="Name" class="text-danger"></span>
                <span class="hint">@T["What modules and workflows ask for, such as PayRunApproval. Letters, digits and underscores."]</span>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="Description">
            <label asp-for="Description" class="ocat-label">@T["Description"]</label>
            <div class="ocat-end">
                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">@T["When it is used"]</div>
    <div class="card-body">
        <div class="ocat-wrapper">
            <label asp-for="Types" class="ocat-label">@T["Approval types"]</label>
            <div class="ocat-end">
                <select asp-for="Types" asp-items="Model.TypeOptions" class="form-select" multiple size="@Math.Clamp(Model.TypeOptions.Count, 2, 6)"></select>
                <span class="hint">@T["What the policy approves, such as pay runs or tickets. None chosen serves every type."]</span>
            </div>
        </div>
        <div class="ocat-wrapper">
            <div class="ocat-end">
                <div class="form-check">
                    <input asp-for="Enabled" type="checkbox" class="form-check-input" />
                    <label asp-for="Enabled" class="form-check-label">@T["Choose this policy for requests that name none"]</label>
                    <span class="hint dashed">@T["A request that names the policy uses it either way. Among the policies whose types and conditions match, the first by order is used."]</span>
                </div>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="Order">
            <label asp-for="Order" class="ocat-label">@T["Order"]</label>
            <div class="ocat-end ocat-limited-wrapper">
                <input asp-for="Order" class="form-control" inputmode="numeric" placeholder="0" />
                <span asp-validation-for="Order" class="text-danger"></span>
                <span class="hint">@T["Lower comes first, such as a policy for large amounts before the general one."]</span>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="MinimumAmount">
            <label asp-for="MinimumAmount" class="ocat-label">@T["Amount"]</label>
            <div class="ocat-end">
                <div class="input-group" style="max-width: 32rem">
                    <span class="input-group-text">@T["from"]</span>
                    <input asp-for="MinimumAmount" class="form-control" inputmode="decimal" aria-label="@T["Least amount"]" />
                    <span class="input-group-text">@T["to"]</span>
                    <input asp-for="MaximumAmount" class="form-control" inputmode="decimal" aria-label="@T["Most amount"]" />
                    <input asp-for="Currency" class="form-control text-uppercase" style="max-width: 6rem" maxlength="3" placeholder="USD" aria-label="@T["Currency"]" />
                </div>
                <span asp-validation-for="MinimumAmount" class="text-danger"></span>
                <span asp-validation-for="MaximumAmount" class="text-danger"></span>
                <span class="hint">@T["Only requests with an amount in this range, and in this currency when one is given. Empty for any amount."]</span>
            </div>
        </div>
        <div class="ocat-wrapper">
            <label asp-for="AccessScope" class="ocat-label">@T["Scope"]</label>
            <div class="ocat-end">
                <input asp-for="AccessScope" class="form-control code" style="max-width: 24rem" />
                <span class="hint">@T["Only requests of this scope, such as one employer's id for pay runs. Empty for any scope."]</span>
            </div>
        </div>
    </div>
</div>

@for (var s = 0; s < Model.Stages.Count; s++)
{
    var stageIndex = s;
    <div class="card mb-3">
        <div class="card-header">@(stageIndex == 0 ? T["Stage 1: who decides first"] : T["Stage {0}: who decides next", stageIndex + 1])</div>
        <div class="card-body">
            @if (stageIndex == 0)
            {
                <p class="hint">@T["Stages are decided one after the other, such as the manager, then finance. A person any rule of the stage names may approve or reject; one rejection at any stage rejects the request. A stage without rules isn't used."]</p>
                <span asp-validation-for="Stages" class="text-danger"></span>
            }
            <div class="ocat-wrapper">
                <label asp-for="Stages[stageIndex].Title" class="ocat-label">@T["Title"]</label>
                <div class="ocat-end">
                    <input asp-for="Stages[stageIndex].Title" class="form-control" style="max-width: 24rem" placeholder="@(stageIndex == 0 ? T["Manager"] : T["Finance"])" />
                </div>
            </div>
            @for (var r = 0; r < Model.Stages[stageIndex].Approvers.Count; r++)
            {
                var ruleIndex = r;
                var rule = Model.Stages[stageIndex].Approvers[ruleIndex];
                var kindId = Html.IdFor(m => m.Stages[stageIndex].Approvers[ruleIndex].Kind);
                <div class="ocat-wrapper" data-approver-rule>
                    <label class="ocat-label" for="@kindId">@T["Rule {0}", ruleIndex + 1]</label>
                    <div class="ocat-end">
                        <div class="row g-2">
                            <div class="col-md-5">
                                <select asp-for="Stages[stageIndex].Approvers[ruleIndex].Kind" asp-items="Model.KindOptions" class="form-select" data-approver-rule-kind aria-label="@T["Who"]"></select>
                            </div>
                            <div class="col-md-7">
                                @foreach (var option in Model.KindOptions.Where(option => !string.IsNullOrEmpty(option.Value)))
                                {
                                    var editor = new ApproverRuleValueEditorViewModel
                                    {
                                        Kind = option.Value,
                                        FieldName = Html.NameFor(m => m.Stages[stageIndex].Approvers[ruleIndex].Values) + "[" + option.Value + "]",
                                        FieldId = kindId + "_" + option.Value,
                                        Value = string.Equals(rule.Kind, option.Value, StringComparison.OrdinalIgnoreCase) ? rule.Values?.GetValueOrDefault(option.Value)?.FirstOrDefault() : null,
                                    };
                                    IShape shape = await New.ApproverRuleValue_Edit(Editor: editor);
                                    shape.Metadata.Alternates.Add("ApproverRuleValue_Edit__" + option.Value);
                                    <div data-approver-rule-value="@option.Value" class="@(string.Equals(rule.Kind, option.Value, StringComparison.OrdinalIgnoreCase) ? null : "d-none")">
                                        @await DisplayAsync(shape)
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
            <div class="ocat-wrapper">
                <label asp-for="Stages[stageIndex].RequiredApprovals" class="ocat-label">@T["Approvals needed"]</label>
                <div class="ocat-end ocat-limited-wrapper">
                    <input asp-for="Stages[stageIndex].RequiredApprovals" type="number" min="1" max="10" class="form-control" />
                    <span class="hint">@T["How many different approvers must approve this stage."]</span>
                </div>
            </div>
        </div>
    </div>
}

<div class="card mb-3">
    <div class="card-header">@T["Built-in rules"]</div>
    <div class="card-body">
        <div class="ocat-wrapper" asp-validation-class-for="DueAfterHours">
            <label asp-for="DueAfterHours" class="ocat-label">@T["Due after (hours)"]</label>
            <div class="ocat-end ocat-limited-wrapper">
                <input asp-for="DueAfterHours" class="form-control" inputmode="numeric" />
                <span asp-validation-for="DueAfterHours" class="text-danger"></span>
                <span class="hint">@T["Leave empty for no due time. A reminder workflow can use it."]</span>
            </div>
        </div>
        <div class="ocat-wrapper">
            <div class="ocat-end">
                <div class="form-check">
                    <input asp-for="AllowRequesterToApprove" type="checkbox" class="form-check-input" />
                    <label asp-for="AllowRequesterToApprove" class="form-check-label">@T["Let the person who asked approve their own request"]</label>
                    <span class="hint dashed">@T["Off by default: nobody approves what they asked for, at any stage."]</span>
                </div>
            </div>
        </div>
        <div class="ocat-wrapper">
            <div class="ocat-end">
                <div class="form-check">
                    <input asp-for="AllowSubjectToDecide" type="checkbox" class="form-check-input" />
                    <label asp-for="AllowSubjectToDecide" class="form-check-label">@T["Let a person decide a request about themselves"]</label>
                    <span class="hint dashed">@T["Off by default: nobody approves their own pay, time or expenses, at any stage."]</span>
                </div>
            </div>
        </div>
    </div>
</div>

<script at="Foot">
    // Shows the value editor of the approver rule kind chosen in each row.
    document.addEventListener('change', function (event) {
        const select = event.target.closest('[data-approver-rule-kind]');

        if (!select) {
            return;
        }

        const row = select.closest('[data-approver-rule]');

        row.querySelectorAll('[data-approver-rule-value]').forEach(function (editor) {
            editor.classList.toggle('d-none', editor.getAttribute('data-approver-rule-value') !== select.value);
        });
    });
</script>
