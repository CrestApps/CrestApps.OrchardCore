@model ShapeViewModel<TerritoryRow>

<a asp-controller="Territories" asp-action="Edit" asp-route-id="@Model.Value.Territory.ItemId" class="btn btn-primary btn-sm">@T["Edit"]</a>
<a asp-controller="Territories" asp-action="Delete" asp-route-id="@Model.Value.Territory.ItemId" class="btn btn-danger btn-sm" data-title="@T["Delete"]" data-message="@T["Delete this territory? Territories inside it move up to its parent."]" data-url-af="RemoveUrl UnsafeUrl">@T["Delete"]</a>
