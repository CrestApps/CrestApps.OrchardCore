@model TerritoryEditViewModel
@using System.Text.Json

<style asp-name="bootstrap-select"></style>
<script asp-name="bootstrap-select" depends-on="bootstrap" at="Foot"></script>
<zone Name="Title"><breadcrumb name="GeoTerritoriesEdit" title="@(string.IsNullOrEmpty(Model.Id) ? T["Add a Territory"] : T["Edit {0}", Model.Name])" /></zone>

<style asp-name="leaflet-geoman"></style>
<script asp-name="leaflet-geoman" at="Foot"></script>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="no-multisubmit">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <div class="card text-bg-theme mb-3">
        <div class="card-header">@T["Details"]</div>
        <div class="card-body">
            <div class="ocat-wrapper">
                <label asp-for="Name" class="ocat-label">@T["Name"]</label>
                <div class="ocat-end">
                    <input asp-for="Name" class="form-control" required />
                </div>
            </div>
            <div class="ocat-wrapper">
                <label asp-for="ParentId" class="ocat-label">@T["Part of"]</label>
                <div class="ocat-end">
                    <select asp-for="ParentId" asp-items="Model.ParentOptions" class="form-select">
                        <option value="">@T["No larger territory"]</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="card text-bg-theme mb-3">
        <div class="card-header">@T["Area"]</div>
        <div class="card-body">
            <p class="hint">@T["Draw the area with the tools on the left of the map: a polygon or a rectangle, more than one if needed. Drag a corner to change it, or cut a hole. Other territories show in grey."]</p>
            @{
                ViewData["MapId"] = "territory-map";
                ViewData["MapHeight"] = "26rem";
                ViewData["MapLabel"] = T["Map to draw the territory on"].Value;
            }
            <partial name="_GeoMap" model="Model.Map" />
            <details class="mb-3" @(ViewData.ModelState.ContainsKey(nameof(Model.Shape)) && ViewData.ModelState[nameof(Model.Shape)].Errors.Count > 0 ? "open" : null)>
                <summary class="small">@T["The shape as GeoJSON"]</summary>
                <textarea asp-for="Shape" class="form-control font-monospace mt-2" rows="5" spellcheck="false"></textarea>
                <span class="hint">@T["Paste a Polygon, MultiPolygon, Feature or FeatureCollection to load it on the map. Positions are longitude, then latitude."]</span>
            </details>
            <div class="ocat-wrapper">
                <label asp-for="PostalCodes" class="ocat-label">@T["Postal codes"]</label>
                <div class="ocat-end">
                    <textarea asp-for="PostalCodes" class="form-control" rows="2"></textarea>
                    <span class="hint">@T["Separated by commas. End a code with * to take every code that starts with it, such as 021*. Places without coordinates are matched by these."]</span>
                </div>
            </div>
            <div class="ocat-wrapper">
                <label asp-for="TimeZoneId" class="ocat-label">@T["Time zone"]</label>
                <div class="ocat-end">
                    <select asp-for="TimeZoneId" asp-items="Model.TimeZoneOptions" class="form-select">
                        <option value="">@T["The site's time zone"]</option>
                    </select>
                </div>
            </div>
            <div class="ocat-wrapper">
                <label asp-for="TravelSpeedKmh" class="ocat-label">@T["Average travel speed (km/h)"]</label>
                <div class="ocat-end">
                    <input asp-for="TravelSpeedKmh" type="number" min="1" max="200" step="any" class="form-control" style="max-width: 12rem" />
                    <span class="hint">@T["Leave empty for the site's. Travel inside a dense city is slower than in the countryside."]</span>
                </div>
            </div>
            @if (Model.MemberGroups.Count > 0)
            {
                <h2 class="h5 mt-4">@T["Who serves it"]</h2>
                <p class="hint">@T["Dispatch offers these first for work in the territory. Leave them empty for anyone."]</p>
                @foreach (var group in Model.MemberGroups)
                {
                var id = "territory-members-" + group.Kind;
                <div class="ocat-wrapper">
                    <label for="@id" class="ocat-label">@group.DisplayName</label>
                    <div class="ocat-end">
                        <select id="@id" name="Members[@group.Kind]" class="selectpicker show-tick" multiple data-live-search="true" data-actions-box="true" data-width="100%" data-selected-text-format="count > 3">
                            @foreach (var option in group.Options)
                            {
                                <option value="@option.Value" selected="@option.Selected">@option.Text</option>
                            }
                        </select>
                    </div>
                </div>
                }
            }
        </div>
    </div>
    <div class="action-bar-bottom">
        <button type="submit" class="btn btn-primary save">@T["Save"]</button>
        <a asp-action="Index" class="btn btn-secondary">@T["Cancel"]</a>
    </div>
</form>

<script at="Foot">
    (function () {
        const map = window.crestappsMap.create('territory-map');

        window.crestappsMap.showShapes(map, @Html.Raw(JsonSerializer.Serialize(Model.OtherShapes.Select(shape => new { label = shape.Label, geoJson = shape.GeoJson }))), { color: '#6c757d', fillOpacity: 0.08, weight: 1 });
        window.crestappsMap.editShapes(map, document.getElementById('@Html.IdFor(m => m.Shape)'));
    })();
</script>
