@model TerritoryEditViewModel

<div class="ocat-wrapper" asp-validation-class-for="Name">
    <label asp-for="Name" class="ocat-label ocat-label-required">@T["Name"]</label>
    <div class="ocat-end">
        <input asp-for="Name" class="form-control" required />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
</div>
<div class="ocat-wrapper" asp-validation-class-for="ParentId">
    <label asp-for="ParentId" class="ocat-label">@T["Part of"]</label>
    <div class="ocat-end">
        <select asp-for="ParentId" asp-items="Model.ParentOptions" class="form-select">
            <option value="">@T["No larger territory"]</option>
        </select>
    </div>
</div>
