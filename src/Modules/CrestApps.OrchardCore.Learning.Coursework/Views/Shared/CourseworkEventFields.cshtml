@using CrestApps.OrchardCore.Learning.Coursework.Workflows

@model CourseworkEventViewModel

<style asp-name="bootstrap-select"></style>
<script asp-name="bootstrap-select" depends-on="bootstrap" at="Foot"></script>
<div class="mb-3">
    <label asp-for="CourseworkIds" class="form-label">@T["Coursework"]</label>
    <select asp-for="CourseworkIds" asp-items="Model.CourseworkOptions" class="selectpicker show-tick" multiple data-live-search="true" data-actions-box="true" data-width="100%" data-selected-text-format="count > 3"></select>
    <span class="hint">@T["Leave empty for every coursework item. The workflow input holds SubmissionId, UserId, CourseworkId, CourseId, EnrollmentId, Attempt, Status, Late, Score, Points, MaxPoints, SubmittedUtc and Actor; Coursework Graded adds Regraded, PreviousScore and Reason."]</span>
</div>
