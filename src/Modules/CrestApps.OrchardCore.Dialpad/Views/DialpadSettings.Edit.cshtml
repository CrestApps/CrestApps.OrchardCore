@using System.Text.Json
@model DialpadSettingsViewModel

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" asp-for="IsEnabled" checked="@Model.IsEnabled" />
            <label class="form-check-label" asp-for="IsEnabled">@T["Enable Dialpad provider"]</label>
        </div>
    </div>
</div>

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <h4 class="mb-0">@T["Dialpad account info"]</h4>
    </div>
</div>

<div class="alert alert-info" role="alert">
    @T["Configure the Production and Sandbox environments independently, then choose which one the provider connects to using the Active environment selector below."]
    @T["Use API key authentication for simple integrations where one Dialpad account places calls for the tenant. Use OAuth 2.0 for multiuser integrations and production deployments where each user connects their own Dialpad account."]
    @T["API keys and OAuth client secrets are encrypted before they are stored."]
    @T["To obtain OAuth 2.0 access, visit"]
    <a href="https://developers.dialpad.com/" target="_blank" rel="noopener noreferrer">developers.dialpad.com</a>
    @T["for Dialpad developer instructions."]
</div>

<div class="ocat-wrapper" asp-validation-class-for="Environment">
    <label asp-for="Environment" class="ocat-label">@T["Active environment"]</label>
    <div class="ocat-end">
        <select asp-for="Environment" class="form-select">
            <option value="@DialpadEnvironment.Production">@T["Production"]</option>
            <option value="@DialpadEnvironment.Sandbox">@T["Sandbox"]</option>
        </select>
        <span asp-validation-for="Environment"></span>
        <span class="hint">@T["Select which environment the provider uses to connect and place calls. Sandbox uses the sandbox.dialpad.com endpoints for development and testing; Production uses dialpad.com. This applies to both the REST API and OAuth 2.0 endpoints. Credentials for the environment that is not active are preserved."]</span>
    </div>
</div>

<script at="Foot">
    (function () {
        var messages = {
            noCrypto: @Html.Raw(JsonSerializer.Serialize(T["This browser cannot generate cryptographically secure random values. Use a different browser or generate the secret with a secure password manager."].Value)),
            copyEmpty: @Html.Raw(JsonSerializer.Serialize(T["Generate or enter a webhook signing secret before copying it."].Value)),
            copyFailed: @Html.Raw(JsonSerializer.Serialize(T["The browser could not copy the webhook signing secret. Select the field value and copy it manually."].Value)),
            copied: @Html.Raw(JsonSerializer.Serialize(T["Copied the webhook signing secret to the clipboard."].Value)),
            generatedCopied: @Html.Raw(JsonSerializer.Serialize(T["Generated a 32-byte webhook signing secret and copied it to the clipboard. Save this page, then use the same value when creating the Dialpad webhook."].Value))
        };

        var environments = Array.prototype.slice.call(document.querySelectorAll('[data-dialpad-environment-section]'));

        environments.forEach(function (environment) {
            var selector = environment.querySelector('[data-dialpad-authentication-type]');

            if (!selector) {
                return;
            }

            var sections = Array.prototype.slice.call(environment.querySelectorAll('[data-dialpad-authentication-section]'));

            function updateAuthenticationSections() {
                sections.forEach(function (section) {
                    section.hidden = section.getAttribute('data-dialpad-authentication-section') !== selector.value;
                });
            }

            selector.addEventListener('change', updateAuthenticationSections);
            updateAuthenticationSections();
        });

        function getStatusElement(container) {
            return container.parentElement.querySelector('[data-dialpad-webhook-secret-status]');
        }

        function setStatus(container, message, isError) {
            var status = getStatusElement(container);

            if (!status) {
                return;
            }

            status.textContent = message;
            status.classList.toggle('text-danger', isError);
            status.classList.toggle('text-success', !isError && !!message);
        }

        function generateSecret() {
            if (!window.crypto || !window.crypto.getRandomValues) {
                return null;
            }

            var bytes = new Uint8Array(32);
            window.crypto.getRandomValues(bytes);

            var value = '';

            bytes.forEach(function (byte) {
                value += String.fromCharCode(byte);
            });

            return window.btoa(value)
                .replace(/\+/g, '-')
                .replace(/\//g, '_')
                .replace(/=+$/g, '');
        }

        function copyToClipboard(value) {
            if (navigator.clipboard && window.isSecureContext) {
                return navigator.clipboard.writeText(value);
            }

            var textArea = document.createElement('textarea');
            textArea.value = value;
            textArea.setAttribute('readonly', 'readonly');
            textArea.style.position = 'fixed';
            textArea.style.top = '-1000px';
            document.body.appendChild(textArea);
            textArea.select();

            try {
                document.execCommand('copy');

                return Promise.resolve();
            } catch (error) {
                return Promise.reject(error);
            } finally {
                document.body.removeChild(textArea);
            }
        }

        document.addEventListener('click', function (event) {
            var generateButton = event.target.closest('[data-dialpad-generate-webhook-secret]');
            var copyButton = event.target.closest('[data-dialpad-copy-webhook-secret]');

            if (!generateButton && !copyButton) {
                return;
            }

            var container = event.target.closest('[data-dialpad-webhook-secret]');
            var input = container ? container.querySelector('[data-dialpad-webhook-secret-input]') : null;

            if (!container || !input) {
                return;
            }

            if (generateButton) {
                var secret = generateSecret();

                if (!secret) {
                    setStatus(container, messages.noCrypto, true);

                    return;
                }

                input.value = secret;
                input.dispatchEvent(new Event('input', { bubbles: true }));

                copyToClipboard(secret)
                    .then(function () {
                        setStatus(container, messages.generatedCopied, false);
                    })
                    .catch(function () {
                        setStatus(container, messages.copyFailed, true);
                    });

                return;
            }

            if (!input.value) {
                setStatus(container, messages.copyEmpty, true);

                return;
            }

            copyToClipboard(input.value)
                .then(function () {
                    setStatus(container, messages.copied, false);
                })
                .catch(function () {
                    setStatus(container, messages.copyFailed, true);
                });
        });
    })();
</script>
