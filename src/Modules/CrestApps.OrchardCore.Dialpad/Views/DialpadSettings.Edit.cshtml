@using System.Text.Json
@model DialpadSettingsViewModel

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" asp-for="IsEnabled" checked="@Model.IsEnabled" />
            <label class="form-check-label" asp-for="IsEnabled">@T["Enable Dialpad provider"]</label>
        </div>
    </div>
</div>

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <h4 class="mb-0">@T["Dialpad account info"]</h4>
    </div>
</div>

<div class="alert alert-info" role="alert">
    @T["Configure the Production and Sandbox environments independently, then choose which one the provider connects to using the Active environment selector below."]
    @T["Use API key authentication for simple integrations where one Dialpad account places calls for the tenant. Use OAuth 2.0 for multiuser integrations and production deployments where each user connects their own Dialpad account."]
    @T["API keys and OAuth client secrets are encrypted before they are stored."]
    @T["To obtain OAuth 2.0 access, visit"]
    <a href="https://developers.dialpad.com/" target="_blank" rel="noopener noreferrer">developers.dialpad.com</a>
    @T["for Dialpad developer instructions."]
</div>

<div class="ocat-wrapper" asp-validation-class-for="Environment">
    <label asp-for="Environment" class="ocat-label">@T["Active environment"]</label>
    <div class="ocat-end">
        <select asp-for="Environment" class="form-select">
            <option value="@DialpadEnvironment.Production">@T["Production"]</option>
            <option value="@DialpadEnvironment.Sandbox">@T["Sandbox"]</option>
        </select>
        <span asp-validation-for="Environment"></span>
        <span class="hint">@T["Select which environment the provider uses to connect and place calls. Sandbox uses the sandbox.dialpad.com endpoints for development and testing; Production uses dialpad.com. This applies to both the REST API and OAuth 2.0 endpoints. Credentials for the environment that is not active are preserved."]</span>
    </div>
</div>

<script at="Foot">
    (function () {
        var messages = {
            disconnectFailed: @Html.Raw(JsonSerializer.Serialize(T["Dialpad webhook disconnect failed."].Value)),
            disconnectInProgress: @Html.Raw(JsonSerializer.Serialize(T["Disconnecting the Dialpad webhook..."].Value)),
            registrationFailed: @Html.Raw(JsonSerializer.Serialize(T["Dialpad webhook registration failed."].Value)),
            registrationInProgress: @Html.Raw(JsonSerializer.Serialize(T["Registering the Dialpad webhook..."].Value)),
            saveSettingsFirst: @Html.Raw(JsonSerializer.Serialize(T["Save the Dialpad settings before registering the webhook."].Value))
        };
        var isCompletingWebhookOAuthFlow = false;

        var environments = Array.prototype.slice.call(document.querySelectorAll('[data-dialpad-environment-section]'));

        environments.forEach(function (environment) {
            var selector = environment.querySelector('[data-dialpad-authentication-type]');

            if (!selector) {
                return;
            }

            var sections = Array.prototype.slice.call(environment.querySelectorAll('[data-dialpad-authentication-section]'));

            function updateAuthenticationSections() {
                sections.forEach(function (section) {
                    section.hidden = section.getAttribute('data-dialpad-authentication-section') !== selector.value;
                });
            }

            selector.addEventListener('change', updateAuthenticationSections);
            updateAuthenticationSections();

            var webhookRegistrationSelector = environment.querySelector('[data-dialpad-webhook-registration-authentication-type]');
            var webhookRegistrationSections = Array.prototype.slice.call(environment.querySelectorAll('[data-dialpad-webhook-registration-authentication-section]'));

            function updateWebhookRegistrationSections() {
                webhookRegistrationSections.forEach(function (section) {
                    section.hidden = section.getAttribute('data-dialpad-webhook-registration-authentication-section') !== webhookRegistrationSelector.value;
                });
            }

            if (webhookRegistrationSelector) {
                webhookRegistrationSelector.addEventListener('change', updateWebhookRegistrationSections);
                updateWebhookRegistrationSections();
            }
        });

        function getStatusElement(container) {
            return container.parentElement.querySelector('[data-dialpad-webhook-registration-status]');
        }

        function setStatus(container, message, isError) {
            var status = getStatusElement(container);

            if (!status) {
                return;
            }

            status.textContent = message;
            status.classList.toggle('text-danger', isError);
            status.classList.toggle('text-success', !isError && !!message);
        }

        document.addEventListener('click', function (event) {
            var registerButton = event.target.closest('[data-dialpad-register-webhook]');

            if (!registerButton) {
                return;
            }

            var container = event.target.closest('[data-dialpad-webhook-registration]');
            var registrationUrl = container ? container.getAttribute('data-register-url') : null;
            var token = document.querySelector('input[name="__RequestVerificationToken"]');

            if (!container || !registrationUrl || !token) {
                if (container) {
                    setStatus(container, messages.saveSettingsFirst, true);
                }

                return;
            }

            registerButton.disabled = true;
            setStatus(container, messages.registrationInProgress, false);

            var headers = {
                'Accept': 'application/json',
                'RequestVerificationToken': token.value
            };

            if (isCompletingWebhookOAuthFlow) {
                headers['X-Dialpad-Webhook-OAuth-Ready'] = 'true';
            }

            fetch(registrationUrl, {
                method: 'POST',
                credentials: 'same-origin',
                headers: headers
            })
                .then(function (response) {
                    return response.json().catch(function () {
                        return {
                            message: messages.registrationFailed
                        };
                    }).then(function (body) {
                        if (body.authorizationUrl) {
                            window.location.href = body.authorizationUrl;

                            return body;
                        }

                        if (!response.ok || !body.success) {
                            throw new Error(body.message || messages.registrationFailed);
                        }

                        return body;
                    });
                })
                .then(function (body) {
                    if (body.authorizationUrl) {
                        return;
                    }

                    setStatus(container, body.message, false);
                    window.location.reload();
                })
                .catch(function (error) {
                    setStatus(container, error.message || messages.registrationFailed, true);
                })
                .finally(function () {
                    isCompletingWebhookOAuthFlow = false;
                    registerButton.disabled = false;
                });
        });

        document.addEventListener('click', function (event) {
            var disconnectButton = event.target.closest('[data-dialpad-disconnect-webhook]');

            if (!disconnectButton) {
                return;
            }

            var confirmationMessage = disconnectButton.getAttribute('data-confirm-message');

            if (confirmationMessage && !window.confirm(confirmationMessage)) {
                return;
            }

            var container = event.target.closest('[data-dialpad-webhook-registration]');
            var disconnectUrl = container ? container.getAttribute('data-disconnect-url') : null;
            var token = document.querySelector('input[name="__RequestVerificationToken"]');

            if (!container || !disconnectUrl || !token) {
                if (container) {
                    setStatus(container, messages.saveSettingsFirst, true);
                }

                return;
            }

            disconnectButton.disabled = true;
            setStatus(container, messages.disconnectInProgress, false);

            fetch(disconnectUrl, {
                method: 'POST',
                credentials: 'same-origin',
                headers: {
                    'Accept': 'application/json',
                    'RequestVerificationToken': token.value
                }
            })
                .then(function (response) {
                    return response.json().catch(function () {
                        return {
                            message: messages.disconnectFailed
                        };
                    }).then(function (body) {
                        if (body.authorizationUrl) {
                            window.location.href = body.authorizationUrl;

                            return body;
                        }

                        if (!response.ok || !body.success) {
                            throw new Error(body.message || messages.disconnectFailed);
                        }

                        return body;
                    });
                })
                .then(function (body) {
                    if (body.authorizationUrl) {
                        return;
                    }

                    setStatus(container, body.message, false);
                    window.location.reload();
                })
                .catch(function (error) {
                    setStatus(container, error.message || messages.disconnectFailed, true);
                })
                .finally(function () {
                    disconnectButton.disabled = false;
                });
        });

        var query = new URLSearchParams(window.location.search);

        if (query.get('dialpadRegisterWebhook') === '1') {
            var registerButton = document.querySelector('[data-dialpad-register-webhook]');

            isCompletingWebhookOAuthFlow = true;
            query.delete('dialpadRegisterWebhook');

            var queryString = query.toString();
            var newUrl = window.location.pathname + (queryString ? '?' + queryString : '') + window.location.hash;

            window.history.replaceState({}, document.title, newUrl);

            if (registerButton) {
                registerButton.click();
            }
        }
    })();
</script>
