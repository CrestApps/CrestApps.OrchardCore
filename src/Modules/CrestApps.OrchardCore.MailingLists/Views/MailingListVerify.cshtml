@using CrestApps.OrchardCore.MailingLists.Services
@model MailingListVerifyViewModel

@* The page of a confirmation or claim link. Nothing changes until the person clicks Confirm; no script submits it. *@

@if (Model.Busy)
{
    <div class="alert alert-warning" role="status">@T["Your sign-up is being changed right now. Please try again in a moment."]</div>
}

@if (Model.Resent)
{
    <h1 class="h4">@T["Check your inbox"]</h1>
    <p>@T["If this sign-up still waits for a confirmation, a new link is on its way. Older links no longer work."]</p>
}
else if (Model.Outcome == MailingListVerifyOutcome.Ready)
{
    <h1 class="h4">@(Model.AlreadySubscribed ? T["Confirm your e-mail address"] : T["Confirm your subscription"])</h1>
    <p>
        @if (Model.AlreadySubscribed)
        {
            @T["Confirm that {0} is your address to get what waits for you from {1}.", Model.Email, Model.ListName]
        }
        else
        {
            @T["Confirm that you want to receive {0} at {1}.", Model.ListName, Model.Email]
        }
    </p>
    <form method="post" asp-route="@MailingListsConstants.RouteNames.Verify" asp-route-token="@Model.Token" class="no-multisubmit">
        <button type="submit" class="btn btn-primary">@T["Confirm"]</button>
    </form>
}
else if (Model.Outcome == MailingListVerifyOutcome.Verified || Model.Outcome == MailingListVerifyOutcome.AlreadyVerified)
{
    <h1 class="h4">@(Model.Outcome == MailingListVerifyOutcome.Verified ? T["Thank you, you're subscribed"] : T["You're already confirmed"])</h1>
    @if (!string.IsNullOrEmpty(Model.ListName))
    {
        <p>@T["You will receive {0} at {1}.", Model.ListName, Model.Email]</p>
    }

    @if (Model.Coupon is not null)
    {
        <div class="card my-4">
            <div class="card-body text-center">
                <p class="mb-2">@T["Your welcome code"]</p>
                <p class="h3 font-monospace mb-2">@Model.Coupon.Code</p>
                @if (!string.IsNullOrWhiteSpace(Model.Coupon.Description))
                {
                    <p class="mb-2">@Model.Coupon.Description</p>
                }
                @if (Model.Coupon.ExpiresUtc is { } expires)
                {
                    <p class="text-body-secondary small mb-3">@T["The code works until {0}.", await DisplayAsync(await New.DateTime(Utc: DateTime.SpecifyKind(expires, DateTimeKind.Utc), Format: "g"))]</p>
                }
                @if (!string.IsNullOrEmpty(Model.Coupon.Url))
                {
                    <a href="@Model.Coupon.Url" class="btn btn-primary">@T["Use my code"]</a>
                }
                <p class="text-body-secondary small mt-3 mb-0">@T["We also sent the code to your e-mail address."]</p>
            </div>
        </div>
    }
}
else if (Model.Outcome == MailingListVerifyOutcome.Expired)
{
    <h1 class="h4">@T["This link doesn't work any more"]</h1>
    <p>@T["It expired, or a newer link was sent."]</p>
    @if (Model.CanResend)
    {
        <form method="post" asp-route="@MailingListsConstants.RouteNames.VerifyResend" asp-route-token="@Model.Token" class="no-multisubmit">
            <button type="submit" class="btn btn-primary">@T["Send me a new link"]</button>
        </form>
    }
}
else
{
    <h1 class="h4">@T["This link doesn't work"]</h1>
    <p>@T["Check that you copied the whole link from the e-mail, or sign up again."]</p>
}
