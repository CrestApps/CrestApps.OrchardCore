@model ShapeViewModel<MailingList>
@inject IAuthorizationService AuthorizationService

@if (await AuthorizationService.AuthorizeAsync(User, MailingListsPermissions.ManageMailingLists))
{
    <a asp-controller="MailingLists"
       asp-action="Delete"
       asp-route-id="@Model.Value.ItemId"
       class="dropdown-item text-danger"
       data-title="@T["Delete"]"
       data-message="@T["Delete this mailing list? Its members are kept until they are erased."]"
       data-url-af="RemoveUrl UnsafeUrl">@T["Delete"]</a>
}
