<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
    <Title>CrestApps OrchardCore Mailing Lists</Title>
    <Description>
      $(OCCMSDescription)

      Mailing lists and newsletter sign-up: a sign-up widget, double opt-in by e-mail, a one-time welcome coupon,
      unsubscribe links on the one e-mail preferences page, and a provider seam that keeps a list at an outside e-mail
      marketing service.
    </Description>
    <PackageTags>$(PackageTags) CrestApps OrchardCoreCMS MailingLists Newsletter Subscribers DoubleOptIn Coupons</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrestApps.OrchardCore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OrchardCore.Module.Targets" />
    <PackageReference Include="OrchardCore.Admin.Abstractions" />
    <PackageReference Include="OrchardCore.ContentManagement" />
