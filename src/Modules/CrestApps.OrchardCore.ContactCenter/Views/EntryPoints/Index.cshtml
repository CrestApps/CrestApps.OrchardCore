@using Microsoft.Extensions.Options

@model ListCatalogEntryViewModel<CatalogEntryViewModel<ContactCenterEntryPoint>>

@inject IOptions<EntryPointChannelOptions> ChannelOptions

@{
    var listModel = new CatalogListViewModel
    {
        BreadcrumbName = "ContactCenterEntryPoints",
        Title = T["Inbound entry points"],
        CreateLabel = T["Add inbound entry point"],
        ListId = "entry-points-list",
        EmptyMessage = T["<strong>Nothing here!</strong> There are no inbound entry points at the moment."],
        // One kind of entry point per channel a feature answers.
        CreateOptions = ChannelOptions.Value.Channels.Values
            .Select(channel => new CatalogCreateOption
            {
                Label = channel.DisplayName?.Value ?? channel.Name,
                RouteValues = new Dictionary<string, string> { ["channel"] = channel.Name },
            })
            .ToList(),
        Options = Model.Options,
        Pager = Model.Pager,
        Entries = Model.Models
            .Select(entry => new CatalogListEntry
            {
                Shape = entry.Shape,
                FilterValue = entry.Model.Name?.ToLowerInvariant(),
            })
            .ToList(),
    };
}

<partial name="_CatalogList" model="listModel" />
