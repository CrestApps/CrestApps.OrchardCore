@using CrestApps.OrchardCore.ContactCenter.Core.Models
@model ListCatalogEntryViewModel<CatalogEntryViewModel<VoiceMediaItem>>

@{
    var listModel = new CatalogListViewModel
    {
        Title = T["Voice media"],
        CreateLabel = T["Add Voice Media"],
        ListId = "voice-media-list",
        EmptyMessage = T["<strong>Nothing here!</strong> There are no voice media clips at the moment."],
        Options = Model.Options,
        Pager = Model.Pager,
        Entries = Model.Models
            .Select(entry => new CatalogListEntry
            {
                Shape = entry.Shape,
                FilterValue = entry.Model.Name?.ToLowerInvariant(),
            })
            .ToList(),
    };
}

<partial name="_CatalogList" model="listModel" />
