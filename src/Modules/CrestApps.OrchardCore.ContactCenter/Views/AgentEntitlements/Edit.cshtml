@using CrestApps.OrchardCore.ContactCenter.Core
@model AgentEntitlementViewModel

<zone Name="Title">
    <breadcrumb name="ContactCenterAgentEntitlementsEdit" title="@T["Edit agent entitlements"]">
        <breadcrumb-item id="ContactCenterAgentEntitlements" action="Index" controller="AgentEntitlements" area="CrestApps.OrchardCore.ContactCenter" permission="@ContactCenterPermissions.ManageAgents.Name">@T["Agent entitlements"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form method="post" class="no-multisubmit">
    @Html.ValidationSummary()

    <div class="ocat-wrapper">
        <label class="ocat-label">@T["User"]</label>
        <div class="ocat-end">
            <input class="form-control" value="@Model.UserDisplayName" readonly />
        </div>
    </div>

    @await Html.PartialAsync("_EntitlementFields", Model)

    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <button class="btn btn-primary" type="submit">@T["Save"]</button>
            <a class="btn btn-secondary cancel" role="button" asp-action="Index">@T["Cancel"]</a>
        </div>
    </div>
</form>
