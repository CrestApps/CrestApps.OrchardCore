@model AgentEntitlementListViewModel

<zone Name="Title">
    <breadcrumb name="ContactCenterAgentEntitlements" title="@T["Agent entitlements"]" />
</zone>

<div class="card text-bg-theme mb-3 position-sticky action-bar">
    <div class="card-body">
        <div class="row gx-2 justify-content-end">
            <div class="col-auto">
                <a class="btn btn-secondary create" role="button" asp-action="Create">@T["Add agent entitlements"]</a>
            </div>
        </div>
    </div>
</div>

@* The agents and the toolbar are rendered by the AdminList shape, in the layout (List or Grid) the site or the user picked. *@
<admin-list name="ContactCenterAgentEntitlements" context="Model.List"
            show-select-all="false"
            empty-message="@T["No agent entitlements are configured."]">
    <admin-list-list item-css-class="list-group-item" />
    <admin-list-grid>
        <admin-list-column name="Name" position="20" title="@T["Agent"]" />
        <admin-list-column name="Entitlements" position="30" title="@T["Entitlements"]" width="auto" />
        <admin-list-column type="Actions" title="@T["Actions"]" />
    </admin-list-grid>
</admin-list>
