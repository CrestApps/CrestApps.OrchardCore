@model EntryPointViewModel

<style asp-name="bootstrap-select"></style>
<script asp-name="bootstrap-select" depends-on="bootstrap" at="Foot"></script>

<div class="ocat-wrapper" asp-validation-class-for="Name">
    <label asp-for="Name" class="ocat-label ocat-label-required">@T["Name"]</label>
    <div class="ocat-end">
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="Description">
    <label asp-for="Description" class="ocat-label">@T["Description"]</label>
    <div class="ocat-end">
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
</div>

<div class="ocat-wrapper">
    <span class="ocat-label">@T["Answers"]</span>
    <div class="ocat-end">
        <span class="form-control-plaintext">@Model.ChannelDisplayName</span>
    </div>
</div>

@{
    // Phone channels answer numbers; an email entry point answers email addresses.
    var answersEmail = string.Equals(Model.Channel, CrestApps.OrchardCore.Omnichannel.Core.OmnichannelConstants.Channels.Email, StringComparison.OrdinalIgnoreCase);
}

<div class="ocat-wrapper" asp-validation-class-for="AddressIds">
    <label asp-for="AddressIds" class="ocat-label">@(answersEmail ? T["Addresses"] : T["Numbers"])</label>
    <div class="ocat-end">
        <select asp-for="AddressIds" asp-items="Model.AddressOptions" multiple class="selectpicker show-tick" data-live-search="true" data-show-selected-tags="true" data-actions-box="true" data-header="@(answersEmail ? T["Select addresses"] : T["Select numbers"])" title="@(answersEmail ? T["No addresses"] : T["No numbers"])"></select>
        <span asp-validation-for="AddressIds" class="text-danger"></span>
        <span class="hint">@(answersEmail
            ? T["Email sent to these addresses is answered by this entry point. Addresses come from Interaction Center > Management > Omnichannel Addresses, where they must be ticked as used for email."]
            : T["What arrives on these numbers is answered by this entry point. Numbers come from Interaction Center > Management > Omnichannel Addresses, where they must be ticked as used for this channel."])</span>
        @if (Model.LegacyDialedNumbers.Count > 0)
        {
            <div class="alert alert-warning mt-2 mb-0">@T["These numbers were typed on this entry point and still route here: {0}. Pick the address for each above so the number is managed in one place.", string.Join(", ", Model.LegacyDialedNumbers)]</div>
        }
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="Enabled">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input asp-for="Enabled" class="form-check-input" />
            <label asp-for="Enabled" class="form-check-label">@T["Enabled"]</label>
            <span class="hint dashed">@T["Disabled entry points answer nothing."]</span>
        </div>
    </div>
</div>
