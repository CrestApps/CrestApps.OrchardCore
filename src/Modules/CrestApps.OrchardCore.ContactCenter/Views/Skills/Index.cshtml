@model ListCatalogEntryViewModel<CatalogEntryViewModel<ContactCenterSkill>>

@{
    var listModel = new CatalogListViewModel
    {
        BreadcrumbName = "ContactCenterSkills",
        Title = T["Skills"],
        CreateLabel = T["Add Skill"],
        ListId = "skills-list",
        EmptyMessage = T["<strong>Nothing here!</strong> There are no skills at the moment."],
        Options = Model.Options,
        ListName = "ContactCenterSkills",
        List = Model.List,
    };
}

<partial name="_CatalogList" model="listModel" />
