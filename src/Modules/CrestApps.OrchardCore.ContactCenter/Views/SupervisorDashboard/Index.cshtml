<style asp-name="contact-center-workspace"></style>
<script asp-name="contact-center-supervisor-dashboard" at="Foot"></script>

<zone Name="Title"><h1>@RenderTitleSegments(T["Live dashboard"])</h1></zone>

<div class="cc-workspace cc-dashboard" data-cc-dashboard data-config="@JsonSerializer.Serialize(config, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase })">
    <div class="cc-dashboard__topbar">
        <span class="cc-connection" data-cc-connection role="status" aria-live="polite"></span>
    </div>

    <div class="cc-error" data-cc-error role="alert" aria-live="assertive" hidden></div>

    <div class="cc-quality-alerts" data-cc-quality-alerts role="status" aria-live="polite"></div>

    <div class="cc-dashboard__summary" data-cc-summary role="status" aria-live="polite" aria-label="@T["Contact center summary"]"></div>

    <div class="cc-panel mb-3">
        <div class="cc-panel__header" id="ccDashboardQueues">@T["Queues"]</div>
        <div class="cc-panel__body">
            <div class="cc-tiles" data-cc-tiles role="status" aria-live="polite" aria-labelledby="ccDashboardQueues"></div>
        </div>
    </div>

    @* The confirm and form panels a supervisor's intervention opens (see Assets/js/supervisor-interventions.js). *@
    <div data-cc-intervention-panel hidden></div>
    <div class="visually-hidden" data-cc-intervention-status role="status" aria-live="polite"></div>

    <div class="cc-panel">
        <div class="cc-panel__header" id="ccDashboardAgents">@T["Agents"]</div>
        <div class="cc-panel__body">
            <div class="cc-board" data-cc-board role="status" aria-live="polite" aria-labelledby="ccDashboardAgents"></div>
        </div>
    </div>
</div>
