            ["connected"] = T["Connected"].Value,
            ["reconnecting"] = T["Connection lost. Reconnecting..."].Value,
            ["disconnected"] = T["Disconnected. Live updates are paused."].Value,
            ["qualityAlert"] = T["{0}: {1} of their last {2} calls rated poor. Likely cause: {3}."].Value,
            ["dismiss"] = T["Dismiss"].Value,
            ["cause.NoAudioReceived"] = T["no audio received"].Value,
            ["cause.NoAudioSent"] = T["no audio sent from their phone"].Value,
            ["cause.PacketLoss"] = T["packet loss on their network"].Value,
