<style asp-name="contact-center-workspace"></style>
<script asp-name="contact-center-supervisor-dashboard" at="Foot"></script>

<zone Name="Title"><h1>@RenderTitleSegments(T["Live dashboard"])</h1></zone>

<div class="cc-workspace cc-dashboard" data-cc-dashboard data-config="@JsonSerializer.Serialize(config, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase })">
    <div class="cc-dashboard__topbar">
        <span class="cc-connection" data-cc-connection role="status" aria-live="polite"></span>
    </div>

    <div class="cc-error" data-cc-error role="alert" aria-live="assertive" hidden></div>

    <div class="cc-quality-alerts" data-cc-quality-alerts role="status" aria-live="polite"></div>

    <div class="cc-dashboard__summary" data-cc-summary role="status" aria-live="polite" aria-label="@T["Contact center summary"]"></div>

    <div class="cc-panel mb-3">
        <div class="cc-panel__header" id="ccDashboardQueues">@T["Queues"]</div>
        <div class="cc-panel__body">
            <div class="cc-tiles" data-cc-tiles role="status" aria-live="polite" aria-labelledby="ccDashboardQueues"></div>
        </div>
    </div>

    @* The confirm and form panels a supervisor's intervention opens (see Assets/js/supervisor-interventions.js). *@
    <div data-cc-intervention-panel hidden></div>
    <div class="visually-hidden" data-cc-intervention-status role="status" aria-live="polite"></div>

    <div class="cc-panel">
        <div class="cc-panel__header d-flex align-items-center justify-content-between gap-2">
            <span id="ccDashboardAgents">@T["Agents"]</span>
            <span class="small text-body-secondary fw-normal" data-cc-board-count role="status" aria-live="polite"></span>
        </div>
        <div class="cc-panel__body">
            @* The board filters by the queue and campaign an agent is signed in to, their status and their name (see
               Assets/js/shared/agent-board-filters.js). The queue and campaign options come with each state refresh. *@
            <div class="row g-2 align-items-end mb-3" data-cc-board-filters role="search" aria-label="@T["Filter agents"]">
                <div class="col-12 col-md-3">
                    <label class="form-label small mb-1" for="ccBoardSearch">@T["Agent"]</label>
                    <input type="search" class="form-control form-control-sm" id="ccBoardSearch" data-cc-filter="search" placeholder="@T["Search by name"]" autocomplete="off" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label small mb-1" for="ccBoardQueue">@T["Signed-in queue"]</label>
                    <select class="form-select form-select-sm" id="ccBoardQueue" data-cc-filter="queueId">
                        <option value="">@T["Any queue"]</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1" for="ccBoardCampaign">@T["Signed-in campaign"]</label>
                    <select class="form-select form-select-sm" id="ccBoardCampaign" data-cc-filter="campaignId">
                        <option value="">@T["Any campaign"]</option>
                    </select>
                </div>
                <div class="col-8 col-md-2">
                    <label class="form-label small mb-1" for="ccBoardStatus">@T["Status"]</label>
                    <select class="form-select form-select-sm" id="ccBoardStatus" data-cc-filter="status">
                        <option value="">@T["Any status"]</option>
                        <option value="available">@T["Available"]</option>
                        <option value="busy">@T["Busy"]</option>
                        <option value="onCall">@T["On a call"]</option>
                        <option value="notReady">@T["Not ready"]</option>
                        <option value="offline">@T["Offline"]</option>
                    </select>
                </div>
                <div class="col-4 col-md-2 text-end">
                    <button type="button" class="btn btn-sm btn-outline-secondary w-100" data-cc-filter-clear disabled>
                        <i class="fa-solid fa-xmark" aria-hidden="true"></i> @T["Clear"]
                    </button>
                </div>
            </div>
            <div class="cc-board" data-cc-board role="status" aria-live="polite" aria-labelledby="ccDashboardAgents"></div>
        </div>
    </div>
</div>
