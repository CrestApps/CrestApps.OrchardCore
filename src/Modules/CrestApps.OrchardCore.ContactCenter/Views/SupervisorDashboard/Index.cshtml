            ["whisperHint"] = T["Whisper: only the agent hears you."].Value,
            ["bargeHint"] = T["Barge: the agent and the customer hear you."].Value,
            ["modes"] = T["Monitoring mode"].Value,
            ["engagedAs"] = T["You: {0}"].Value,
            ["connecting"] = T["Connecting your phone…"].Value,
            ["stop"] = T["Stop"].Value,
            ["takeOver"] = T["Take over"].Value,
            ["takeOverHint"] = T["You take the call; the agent is released."].Value,
            ["takeOverJoin"] = T["Joins the call on your phone, then takes it; the agent is released."].Value,
            ["takeOverJoining"] = T["Joining the call on your phone to take it over…"].Value,
            ["more"] = T["More"].Value,
            ["moreActionsFor"] = T["More actions for {0}"].Value,
            ["onACall"] = T["On a call"].Value,
            ["endCall"] = T["End call…"].Value,
            ["transfer"] = T["Transfer…"].Value,
            ["recordOn"] = T["Start recording"].Value,
            ["recordOff"] = T["Stop recording"].Value,
            ["setAvailable"] = T["Set Available"].Value,
            ["setNotReady"] = T["Set Not ready"].Value,
            ["setBreak"] = T["Set Break"].Value,
            ["signOut"] = T["Sign out of queues"].Value,
            ["message"] = T["Message…"].Value,
            ["cannotMonitor"] = T["Cannot be monitored"].Value,
            ["panelTitle"] = T["{0}: {1}"].Value,
            ["endCallTitle"] = T["End call"].Value,
            ["signOutTitle"] = T["Sign out"].Value,
            ["transferTitle"] = T["Transfer call"].Value,
            ["messageTitle"] = T["Message"].Value,
            ["endCallConfirm"] = T["End {0}'s call for everyone on it?"].Value,
            ["endCallButton"] = T["End call"].Value,
            ["signOutConfirm"] = T["Sign {0} out of their queues?"].Value,
            ["signOutButton"] = T["Sign out"].Value,
            ["transferTo"] = T["Transfer to"].Value,
            ["transferNumber"] = T["Number (for a phone number)"].Value,
            ["transferButton"] = T["Transfer"].Value,
            ["toQueue"] = T["Queue: {0}"].Value,
            ["toAgent"] = T["Agent: {0}"].Value,
            ["toNumber"] = T["A phone number"].Value,
            ["availableAgents"] = T["Available agents"].Value,
            ["transferTargetRequired"] = T["Choose where to transfer the call."].Value,
            ["messageTo"] = T["Message to {0}"].Value,
