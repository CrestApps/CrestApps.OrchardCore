@model PhoneEndpointRoutingViewModel

<div data-address-capability="Phone">
    <div class="ocat-wrapper" asp-validation-class-for="EntryPointId">
        <label asp-for="EntryPointId" class="ocat-label">@T["Entry point"]</label>
        <div class="ocat-end">
            <select asp-for="EntryPointId" class="form-select" asp-items="Model.EntryPoints">
                <option value="">@T["None (use the entry points and queues set up for this number)"]</option>
            </select>
            <span asp-validation-for="EntryPointId" class="text-danger"></span>
            <span class="hint">@T["Calls to this number go to this entry point, which decides the queue or agent, the opening hours, the phone menu and voicemail."] <a asp-route="ContactCenterEntryPointsCreate">@T["Create an entry point"]</a></span>
            @if (Model.ListedOnEntryPoints.Count > 0)
            {
                <span class="hint d-block">@T["This number is also listed on these entry points, which answer it when none is chosen here: {0}.", string.Join(", ", Model.ListedOnEntryPoints)]</span>
            }
        </div>
    </div>
</div>
