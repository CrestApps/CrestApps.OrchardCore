@model SecureCaptureFormViewModel
@{
    Layout = null;
    var title = T["Secure information"].Value;
}
<!DOCTYPE html>
<html lang="@Orchard.CultureName()" dir="@Orchard.CultureDir()">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@title</title>
    <style>
        :root { color-scheme: light dark; }
        body { font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; margin: 0; background: #f4f5f7; color: #1b1b1f; }
        .secure-capture { max-width: 32rem; margin: 3rem auto; padding: 0 1rem; }
        .secure-capture__card { background: #fff; border-radius: 0.75rem; box-shadow: 0 1px 3px rgba(0, 0, 0, .12); padding: 1.75rem; }
        .secure-capture__badge { display: inline-flex; align-items: center; gap: .4rem; font-size: .8rem; font-weight: 600; color: #0a7d33; }
        .secure-capture__field { margin-bottom: 1.1rem; }
        .secure-capture__field label { display: block; font-weight: 600; margin-bottom: .35rem; }
        .secure-capture__field input { width: 100%; box-sizing: border-box; padding: .65rem .75rem; border: 1px solid #c4c4c8; border-radius: .5rem; font-size: 1rem; }
        .secure-capture__submit { width: 100%; padding: .75rem; border: 0; border-radius: .5rem; background: #0a5cd6; color: #fff; font-size: 1rem; font-weight: 600; cursor: pointer; }
        .secure-capture__note { font-size: .82rem; color: #55555c; margin-top: 1rem; }
        .secure-capture__error { background: #fde8e8; color: #9b1c1c; padding: .65rem .75rem; border-radius: .5rem; margin-bottom: 1rem; }
        .secure-capture__done { text-align: center; }
        .secure-capture__done h1 { color: #0a7d33; }
    </style>
</head>
<body>
    <div class="secure-capture">
        <div class="secure-capture__card">
            @if (Model.Completed)
            {
                <div class="secure-capture__done">
                    <h1>@T["Thank you"]</h1>
                    <p>@T["Your information was submitted securely. You can return to your call."]</p>
                </div>
            }
            else
            {
                <span class="secure-capture__badge">🔒 @T["Secure page"]</span>
                <h1>@title</h1>
                <p>@T["Enter the requested details below. The agent on your call cannot see what you type here."]</p>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="secure-capture__error">@Model.ErrorMessage</div>
                }

                <form method="post" action="@Url.RouteUrl(CrestApps.OrchardCore.ContactCenter.Controllers.SecureCaptureController.CaptureRouteName, new { token = Model.Token })" autocomplete="off">
                    @Html.AntiForgeryToken()
                    @foreach (var field in Model.Fields)
                    {
                        <div class="secure-capture__field">
                            <label for="field_@field">@SecureCaptureFieldLabel(field)</label>
                            <input type="text"
                                   id="field_@field"
                                   name="field_@field"
                                   inputmode="@SecureCaptureFieldInputMode(field)"
                                   autocomplete="off"
                                   required />
                        </div>
                    }
                    <button type="submit" class="secure-capture__submit">@T["Submit securely"]</button>
                </form>

                <p class="secure-capture__note">@T["This page is protected by a single-use link that expires shortly. Your details are never shown to the agent or stored in the call recording."]</p>
            }
        </div>
    </div>
</body>
</html>

@functions {
    string SecureCaptureFieldLabel(SecureCaptureField field)
    {
        return field switch
        {
            SecureCaptureField.CreditCardNumber => T["Card number"].Value,
            SecureCaptureField.CardExpiry => T["Card expiry (MM/YY)"].Value,
            SecureCaptureField.CardSecurityCode => T["Security code"].Value,
            SecureCaptureField.BankAccountNumber => T["Bank account number"].Value,
            SecureCaptureField.NationalId => T["National identification number"].Value,
            _ => T["Requested information"].Value,
        };
    }

    string SecureCaptureFieldInputMode(SecureCaptureField field)
    {
        return field switch
        {
            SecureCaptureField.CreditCardNumber => "numeric",
            SecureCaptureField.CardSecurityCode => "numeric",
            SecureCaptureField.BankAccountNumber => "numeric",
            SecureCaptureField.NationalId => "numeric",
            _ => "text",
        };
    }
}
