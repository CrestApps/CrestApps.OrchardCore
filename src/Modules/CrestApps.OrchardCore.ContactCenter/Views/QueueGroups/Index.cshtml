@model ListCatalogEntryViewModel<CatalogEntryViewModel<ActivityQueueGroup>>

@{
    var listModel = new CatalogListViewModel
    {
        Title = T["Queue groups"],
        CreateLabel = T["Add queue group"],
        ListId = "queue-groups-list",
        EmptyMessage = T["<strong>Nothing here!</strong> There are no queue groups at the moment."],
        Options = Model.Options,
        Pager = Model.Pager,
        Entries = Model.Models
            .Select(entry => new CatalogListEntry
            {
                Shape = entry.Shape,
                FilterValue = entry.Model.Name?.ToLowerInvariant(),
            })
            .ToList(),
    };
}

<partial name="_CatalogList" model="listModel" />
