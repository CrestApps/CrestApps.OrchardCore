@model EntryPointViewModel

<style asp-name="bootstrap-select"></style>
<script asp-name="bootstrap-select" depends-on="bootstrap" at="Foot"></script>

<div class="ocat-limited-wrapper" asp-validation-class-for="TargetType">
    <label asp-for="TargetType" class="ocat-label">@T["Route to"]</label>
    <div class="ocat-limited">
        <select asp-for="TargetType" class="form-select" data-entry-point-target-type>
            <option value="@EntryPointTargetType.Queue">@T["Queue"]</option>
            <option value="@EntryPointTargetType.Agent">@T["Specific agent"]</option>
        </select>
        <span asp-validation-for="TargetType" class="text-danger"></span>
        <span class="hint">@T["Route calls to a queue, or directly to a specific agent (a personal line). A specific agent rings that person directly, with no queue fallback."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="TargetAgentId" data-entry-point-agent-field>
    <label asp-for="TargetAgentId" class="ocat-label">@T["Target agent"]</label>
    <div class="ocat-end">
        <select asp-for="TargetAgentId" asp-items="Model.TargetAgentOptions" class="selectpicker show-tick" data-live-search="true" data-header="@T["Select an agent"]" data-width="100%" title="@T["No agent"]">
            <option value="">@T["No agent"]</option>
        </select>
        <span asp-validation-for="TargetAgentId" class="text-danger"></span>
        <span class="hint">@T["Used when Route to is set to Specific agent. Calls ring this agent directly."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="VoicemailEnabled" data-entry-point-agent-field>
    <div class="ocat-end-offset">
        <div class="form-check">
            <input asp-for="VoicemailEnabled" class="form-check-input" data-entry-point-voicemail-toggle />
            <label asp-for="VoicemailEnabled" class="form-check-label">@T["Send unanswered calls to voicemail"]</label>
        </div>
        <span class="hint dashed">@T["When off, the caller keeps ringing and is held for the agent until answered or they hang up."]</span>
    </div>
</div>

<div class="ocat-limited-wrapper" asp-validation-class-for="RingTimeoutSeconds" data-entry-point-agent-field data-entry-point-ringwindow-field>
    <label asp-for="RingTimeoutSeconds" class="ocat-label">@T["Ring window (seconds)"]</label>
    <div class="ocat-limited">
        <input asp-for="RingTimeoutSeconds" type="number" min="5" max="300" class="form-control" />
        <span asp-validation-for="RingTimeoutSeconds" class="text-danger"></span>
        <span class="hint">@T["How long the caller rings and is held for the agent before going to voicemail. Default 30 seconds."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="TargetQueueId" data-entry-point-queue-field>
    <label asp-for="TargetQueueId" class="ocat-label">@T["Target queue"]</label>
    <div class="ocat-end">
        <select asp-for="TargetQueueId" asp-items="Model.TargetQueueOptions" class="selectpicker show-tick" data-live-search="true" data-header="@T["Select a queue"]" data-width="100%" title="@T["No queue"]">
            <option value="">@T["No queue"]</option>
        </select>
        <span asp-validation-for="TargetQueueId" class="text-danger"></span>
        <span class="hint">@T["The queue calls route to."]</span>
    </div>
</div>

<div class="ocat-limited-wrapper" asp-validation-class-for="Priority">
    <label asp-for="Priority" class="ocat-label">@T["Priority"]</label>
    <div class="ocat-limited">
        <select asp-for="Priority" class="form-select">
            <option value="@InteractionPriority.Lowest">@T["Lowest"]</option>
            <option value="@InteractionPriority.Low">@T["Low"]</option>
            <option value="@InteractionPriority.Normal">@T["Normal"]</option>
            <option value="@InteractionPriority.High">@T["High"]</option>
            <option value="@InteractionPriority.Highest">@T["Highest"]</option>
        </select>
        <span asp-validation-for="Priority" class="text-danger"></span>
    </div>
</div>

<script at="Foot" depends-on="bootstrap-select">
    (function () {
        var typeSelect = document.querySelector('[data-entry-point-target-type]');
        var agentFields = document.querySelectorAll('[data-entry-point-agent-field]');
        var queueFields = document.querySelectorAll('[data-entry-point-queue-field]');
        var voicemailToggle = document.querySelector('[data-entry-point-voicemail-toggle]');
        var ringWindowField = document.querySelector('[data-entry-point-ringwindow-field]');

        if (!typeSelect || agentFields.length === 0 || queueFields.length === 0) {
            return;
        }

        // An entry point routes to a specific agent or a queue, never both. Show the agent-only fields only for
        // a specific-agent target and the queue field only for a queue target. The ring window is shown only
        // when routing to an agent AND voicemail is enabled.
        function apply() {
            var isAgent = typeSelect.value === '@EntryPointTargetType.Agent';
            agentFields.forEach(function (field) { field.style.display = isAgent ? '' : 'none'; });
            queueFields.forEach(function (field) { field.style.display = isAgent ? 'none' : ''; });

            if (ringWindowField) {
                var voicemailOn = !voicemailToggle || voicemailToggle.checked;
                ringWindowField.style.display = (isAgent && voicemailOn) ? '' : 'none';
            }
        }

        typeSelect.addEventListener('change', apply);

        if (voicemailToggle) {
            voicemailToggle.addEventListener('change', apply);
        }

        apply();
    })();
</script>
