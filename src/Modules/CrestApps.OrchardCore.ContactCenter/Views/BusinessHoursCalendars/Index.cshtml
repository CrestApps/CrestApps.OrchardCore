@model ListCatalogEntryViewModel<CatalogEntryViewModel<BusinessHoursCalendar>>

@{
    var listModel = new CatalogListViewModel
    {
        BreadcrumbName = "ContactCenterBusinessHoursCalendars",
        Title = T["Business hours"],
        CreateLabel = T["Add calendar"],
        ListId = "business-hours-list",
        EmptyMessage = T["<strong>Nothing here!</strong> There are no business hours calendars at the moment."],
        Options = Model.Options,
        ListName = "ContactCenterBusinessHoursCalendars",
        List = Model.List,
        Columns =
        {
            new CatalogListColumn { Name = "Schedule", Title = T["Schedule"] },
        },
    };
}

<partial name="_CatalogList" model="listModel" />
