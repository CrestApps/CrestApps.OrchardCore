@model MyVoicemailGreetingViewModel
@{
    ViewLayout = "Layout";
    var saveAudioUrl = Url.Action("SaveAudio", "MyVoicemailGreeting", new { area = "CrestApps.OrchardCore.ContactCenter" });
    var clearUrl = Url.Action("Clear", "MyVoicemailGreeting", new { area = "CrestApps.OrchardCore.ContactCenter" });
}

<h1>@T["My Voicemail Greeting"]</h1>
<p class="text-muted">@T["Record or upload the greeting callers hear before leaving you a voicemail. If you don't set one, the default greeting is used."]</p>

<div class="card mb-3" data-vm-greeting>
    <div class="card-body">
        @if (Model.HasAudioGreeting)
        {
            <p class="alert alert-info py-2">@T["You currently have a greeting. Record or upload a new one to replace it, or remove it to fall back to the default."]</p>
        }

        <div class="mb-3">
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="vm-source" id="vm-source-mic" value="mic" data-vm-source="mic" checked>
                <label class="form-check-label" for="vm-source-mic">@T["Record with microphone"]</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="vm-source" id="vm-source-file" value="file" data-vm-source="file">
                <label class="form-check-label" for="vm-source-file">@T["Upload a file"]</label>
            </div>
        </div>

        <div class="mb-3" data-vm-mic-panel>
            <button type="button" class="btn btn-danger" data-vm-record>
                <i class="fa-solid fa-microphone" data-vm-record-icon></i>
                <span data-vm-record-label>@T["Record"]</span>
            </button>
            <span class="ms-2 text-muted" data-vm-record-status></span>
        </div>

        <div class="mb-3" data-vm-file-panel hidden>
            <input type="file" class="form-control" accept="audio/*" data-vm-file style="max-width: 30rem;">
        </div>

        <div class="mb-3" data-vm-preview-wrapper hidden>
            <label class="form-label d-block">@T["Preview"]</label>
            <audio controls data-vm-preview style="max-width: 30rem;"></audio>
        </div>

        <button type="button" class="btn btn-primary" data-vm-save disabled>@T["Save greeting"]</button>
        <span class="ms-2" data-vm-save-status></span>

        @if (Model.HasAudioGreeting)
        {
            <form method="post" action="@clearUrl" class="d-inline ms-2" onsubmit="return confirm('@T["Remove your greeting?"]');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger">@T["Remove greeting"]</button>
            </form>
        }
    </div>
</div>

<script at="Foot" depends-on="jQuery">
(function () {
    var root = document.querySelector('[data-vm-greeting]');
    if (!root) { return; }

    var micPanel = root.querySelector('[data-vm-mic-panel]');
    var filePanel = root.querySelector('[data-vm-file-panel]');
    var recordBtn = root.querySelector('[data-vm-record]');
    var recordIcon = root.querySelector('[data-vm-record-icon]');
    var recordLabel = root.querySelector('[data-vm-record-label]');
    var recordStatus = root.querySelector('[data-vm-record-status]');
    var fileInput = root.querySelector('[data-vm-file]');
    var previewWrapper = root.querySelector('[data-vm-preview-wrapper]');
    var preview = root.querySelector('[data-vm-preview]');
    var saveBtn = root.querySelector('[data-vm-save]');
    var saveStatus = root.querySelector('[data-vm-save-status]');

    var saveUrl = '@Html.Raw(saveAudioUrl)';
    var token = (document.querySelector('input[name="__RequestVerificationToken"]') || {}).value;

    var pendingBlob = null;
    var mediaRecorder = null;
    var chunks = [];
    var recording = false;

    var strings = {
        record: '@T["Record"]',
        stop: '@T["Stop"]',
        recording: '@T["Recording…"]',
        recorded: '@T["Recorded. Review it below, then Save."]',
        noMic: '@T["Recording is not supported by this browser; upload a file instead."]',
        noAccess: '@T["Could not access the microphone."]',
        saving: '@T["Saving…"]',
        saved: '@T["Saved."]',
        saveFailed: '@T["The greeting could not be saved."]'
    };

    function setPreview(blob) {
        pendingBlob = blob;
        preview.src = URL.createObjectURL(blob);
        previewWrapper.hidden = false;
        saveBtn.disabled = false;
    }

    // Source toggle: microphone (default) or file upload.
    Array.prototype.forEach.call(root.querySelectorAll('[data-vm-source]'), function (radio) {
        radio.addEventListener('change', function () {
            var useMic = root.querySelector('[data-vm-source="mic"]').checked;
            micPanel.hidden = !useMic;
            filePanel.hidden = useMic;
            // Reset any pending selection when switching modes.
            pendingBlob = null;
            previewWrapper.hidden = true;
            saveBtn.disabled = true;
            saveStatus.textContent = '';
        });
    });

    if (!navigator.mediaDevices || !window.MediaRecorder) {
        recordBtn.disabled = true;
        recordStatus.textContent = strings.noMic;
    }

    function startRecording() {
        navigator.mediaDevices.getUserMedia({ audio: true }).then(function (stream) {
            chunks = [];
            mediaRecorder = new MediaRecorder(stream);
            mediaRecorder.ondataavailable = function (e) { if (e.data && e.data.size) { chunks.push(e.data); } };
            mediaRecorder.onstop = function () {
                stream.getTracks().forEach(function (t) { t.stop(); });
                setPreview(new Blob(chunks, { type: mediaRecorder.mimeType || 'audio/webm' }));
                recordStatus.textContent = strings.recorded;
            };
            mediaRecorder.start();
            recording = true;
            recordIcon.className = 'fa-solid fa-stop';
            recordLabel.textContent = strings.stop;
            recordStatus.textContent = strings.recording;
        }).catch(function () {
            recordStatus.textContent = strings.noAccess;
        });
    }

    function stopRecording() {
        if (mediaRecorder && mediaRecorder.state !== 'inactive') { mediaRecorder.stop(); }
        recording = false;
        recordIcon.className = 'fa-solid fa-microphone';
        recordLabel.textContent = strings.record;
    }

    recordBtn.addEventListener('click', function () {
        if (recording) { stopRecording(); } else { startRecording(); }
    });

    fileInput.addEventListener('change', function () {
        if (fileInput.files && fileInput.files[0]) {
            setPreview(fileInput.files[0]);
        }
    });

    saveBtn.addEventListener('click', function () {
        if (!pendingBlob) { return; }
        saveBtn.disabled = true;
        saveStatus.textContent = strings.saving;

        var form = new FormData();
        var ext = (pendingBlob.type || '').indexOf('wav') >= 0 ? 'wav' : (pendingBlob.type || '').indexOf('mpeg') >= 0 ? 'mp3' : (pendingBlob.type || '').indexOf('ogg') >= 0 ? 'ogg' : 'webm';
        var name = pendingBlob.name || ('greeting.' + ext);
        form.append('audio', pendingBlob, name);
        if (token) { form.append('__RequestVerificationToken', token); }

        fetch(saveUrl, { method: 'POST', body: form }).then(function (resp) {
            if (resp.ok) {
                saveStatus.textContent = strings.saved;
                window.location.reload();
            } else {
                return resp.text().then(function (t) {
                    saveStatus.textContent = t || strings.saveFailed;
                    saveBtn.disabled = false;
                });
            }
        }).catch(function () {
            saveStatus.textContent = strings.saveFailed;
            saveBtn.disabled = false;
        });
    });
})();
</script>
