@model SharedVoicemailListViewModel

<zone Name="Title">
    <breadcrumb name="ContactCenterSharedVoicemail" title="@T["Shared voicemail"]" />
</zone>

@* The filters render in the list's toolbar, after this form, and name it with their form attribute. *@
<form asp-action="Index" method="get" id="shared-voicemail-filter" class="no-multisubmit">
    @if (Context.Request.Query.TryGetValue("pageSize", out var selectedPageSize))
    {
        <input type="hidden" name="pageSize" value="@selectedPageSize" />
    }
</form>

@* The messages, the toolbar and the pager are rendered by the AdminList shape, in the layout (List or Grid) the site
   or the user picked. Each row carries its own forms, so the list stays outside the filter form. *@
<admin-list name="ContactCenterSharedVoicemail" context="Model.List"
            show-select-all="false"
            empty-message="@T["There is no shared voicemail here."]">
    <admin-list-list item-css-class="list-group-item" />
    <admin-list-grid>
        <admin-list-column name="Name" position="20" title="@T["Caller"]" />
        <admin-list-column name="Status" position="30" title="@T["Status"]" width="auto" />
        <admin-list-column name="Received" position="40" title="@T["Received"]" width="auto" />
        <admin-list-column name="Recording" position="50" title="@T["Recording"]" />
        <admin-list-column type="Actions" title="@T["Actions"]" />
    </admin-list-grid>
</admin-list>

<style asp-name="bootstrap-select"></style>
<script asp-name="bootstrap-select" depends-on="bootstrap" at="Foot"></script>
