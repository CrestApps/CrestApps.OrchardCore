@using CrestApps.OrchardCore.ContactCenter.Core.Models
@using OrchardCore.DisplayManagement.Views

@model ShapeViewModel<VoiceMediaItem>

@{
    var hasMasterCopy = !string.IsNullOrWhiteSpace(Model.Value.MasterStorageReference);
    var providerNames = Model.Value.ProviderReferences?.Keys.ToList() ?? new List<string>();

    if (providerNames.Count == 0 && !string.IsNullOrWhiteSpace(Model.Value.ProviderName) && !string.IsNullOrWhiteSpace(Model.Value.MediaReference))
    {
        providerNames.Add(Model.Value.ProviderName);
    }

    var hasAudio = hasMasterCopy || providerNames.Count > 0;
}

<h5>@Model.Value.Name</h5>

@if (!string.IsNullOrWhiteSpace(Model.Value.Description))
{
    <div class="text-muted">@Model.Value.Description</div>
}

<div class="mt-1">
    @if (!hasAudio)
    {
        <span class="badge text-bg-warning">@T["No audio"]</span>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(Model.Value.Format))
        {
            <span class="badge text-bg-secondary text-uppercase">@Model.Value.Format</span>
        }
        @if (hasMasterCopy)
        {
            <span class="badge text-bg-info" data-bs-toggle="tooltip" title="@T["The platform keeps a master copy and sends it to any phone provider that needs it."]">@T["Master copy"]</span>
        }
        else
        {
            <span class="badge text-bg-warning" data-bs-toggle="tooltip" title="@T["This clip exists only at the phone provider. Re-upload this clip to protect it."]">@T["Provider copy only"]</span>
        }
        @foreach (var providerName in providerNames)
        {
            <span class="badge text-bg-light">@providerName</span>
        }
    }
</div>
