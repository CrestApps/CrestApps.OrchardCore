@using CrestApps.OrchardCore.ContactCenter.Core.Models
@using OrchardCore.DisplayManagement.Views

@model ShapeViewModel<DialerProfile>

<span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Dialing mode"]">
    <i class="fa-solid fa-phone-volume text-secondary me-1" aria-hidden="true"></i>@Model.Value.Mode
</span>

@if (!string.IsNullOrWhiteSpace(Model.Value.ProviderName))
{
    <span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Provider"]">
        <i class="fa-solid fa-tower-broadcast text-secondary me-1" aria-hidden="true"></i>@Model.Value.ProviderName
    </span>
}

@if (!Model.Value.Enabled)
{
    <span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Status"]">
        <i class="fa-solid fa-ban text-warning me-1" aria-hidden="true"></i>@T["Disabled"]
    </span>
}
