@using CrestApps.OrchardCore.ContactCenter.Workflows.ViewModels

@model ContactCenterEventViewModel

<div class="ocat-wrapper">
    <label class="ocat-label" asp-for="EventType">@T["Event type"]</label>
    <div class="ocat-end">
        <select class="form-select" asp-for="EventType" asp-items="Model.EventTypes"></select>
        <span class="hint">@T["Optionally react to a single Contact Center event type. Leave set to <em>Any event type</em> to react to every event."]</span>
    </div>
</div>
