@using CrestApps.OrchardCore.ContactCenter.Models
@using OrchardCore.DisplayManagement.Views

@model ShapeViewModel<CallRecordingEntry>

<span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Length"]">
    <i class="fa-solid fa-clock text-secondary me-1" aria-hidden="true"></i><span class="visually-hidden">@T["Length"]</span>
    <span class="font-monospace">@CallRecordingFormat.Duration(Model.Value.Recording.DurationSeconds)</span>
</span>
