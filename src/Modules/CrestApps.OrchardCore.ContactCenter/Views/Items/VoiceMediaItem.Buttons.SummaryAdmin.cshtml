@using CrestApps.OrchardCore.ContactCenter.Core.Models
@using OrchardCore.DisplayManagement.Views

@model ShapeViewModel<VoiceMediaItem>

<a asp-action="Edit"
   asp-route-id="@Model.Value.ItemId"
   class="btn btn-primary btn-sm">@T["Edit"]</a>
@if (!string.IsNullOrWhiteSpace(Model.Value.MasterStorageReference))
{
    <a asp-action="Resync"
       asp-route-id="@Model.Value.ItemId"
       class="btn btn-secondary btn-sm"
       title="@T["Check that every enabled phone provider holds this clip, and send it to any that does not."]"
       data-url-af="UnsafeUrl">@T["Re-sync media"]</a>
}
<a asp-action="Delete"
   asp-route-id="@Model.Value.ItemId"
   class="btn btn-danger btn-sm"
   data-title="@T["Delete"]"
   data-message="@T["Are you sure you want to delete this voice media clip?"]"
   data-url-af="RemoveUrl UnsafeUrl">@T["Delete"]</a>
