@using CrestApps.OrchardCore.ContactCenter.Core.Models
@using CrestApps.OrchardCore.Omnichannel.Core.Services
@using Microsoft.Extensions.Options
@using OrchardCore.DisplayManagement.Views

@model ShapeViewModel<ContactCenterEntryPoint>

@inject IOmnichannelChannelEndpointManager AddressManager
@inject IOptions<EntryPointChannelOptions> ChannelOptions

@{
    var channel = Model.Value.GetChannel();
    var channelName = ChannelOptions.Value.Channels.TryGetValue(channel, out var registered) && registered.DisplayName != null
        ? registered.DisplayName.Value
        : channel;
    var addresses = await AddressManager.GetAllAsync();
    var numbers = (Model.Value.AddressIds ?? [])
        .Select(id => addresses.FirstOrDefault(address => address.IsKnownAs(id)))
        .Where(address => address is not null)
        .Select(address => address.Value)
        .Concat(Model.Value.DialedNumbers ?? [])
        .Where(number => !string.IsNullOrWhiteSpace(number))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();
}

<span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Answers"]">
    <i class="fa-solid @(channel == "SMS" ? "fa-comment-sms" : channel == "Email" ? "fa-envelope" : "fa-headset") text-secondary me-1" aria-hidden="true"></i>@channelName
</span>
@foreach (var number in numbers)
{
    <span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@(channel == "Email" ? T["Address"] : T["Number"])">
        <i class="fa-solid fa-hashtag text-secondary me-1" aria-hidden="true"></i>@number
    </span>
}
@if (numbers.Count == 0)
{
    <span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@(channel == "Email" ? T["Address"] : T["Number"])">
        <i class="fa-solid fa-triangle-exclamation text-warning me-1" aria-hidden="true"></i>@(channel == "Email" ? T["No addresses"] : T["No numbers"])
    </span>
}
@if (!Model.Value.Enabled)
{
    <span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Status"]">
        <i class="fa-solid fa-ban text-warning me-1" aria-hidden="true"></i>@T["Disabled"]
    </span>
}
