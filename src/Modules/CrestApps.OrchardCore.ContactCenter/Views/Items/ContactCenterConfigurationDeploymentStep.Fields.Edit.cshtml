@using CrestApps.OrchardCore.Core.Configuration

@model ConfigurationCatalogDeploymentStepViewModel

<div class="ocat-wrapper">
    <div class="ocat-label">@T["Contact Center configuration"]</div>
    <div class="ocat-end">
        <div class="form-check mb-3">
            <label class="form-check-label">
                <input class="form-check-input" asp-for="IncludeAll" data-bs-toggle="collapse" role="button" data-bs-target="#contact-center-catalog-list" aria-expanded="false" aria-controls="contact-center-catalog-list" />
                @T["Include all Contact Center configuration"]
            </label>
        </div>

        <div id="contact-center-catalog-list" class="collapse@(Model.IncludeAll ? string.Empty : " show")">
            <div class="hint mb-1">@T["The Contact Center configuration to export as part of the plan. Each catalog is exported as its own recipe step, in the order it must be imported."]</div>

            <div class="mb-3">
                @for (var i = 0; i < Model.Catalogs.Length; i++)
                {
                    <div class="form-check">
                        <input type="hidden" asp-for="Catalogs[i].StepName" />
                        <input asp-for="Catalogs[i].IsSelected" type="checkbox" class="form-check-input">
                        <label class="form-check-label" asp-for="Catalogs[i].IsSelected">@Model.Catalogs[i].DisplayText</label>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
