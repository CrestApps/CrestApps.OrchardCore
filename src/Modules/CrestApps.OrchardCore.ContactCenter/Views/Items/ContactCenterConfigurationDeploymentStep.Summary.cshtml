@using CrestApps.OrchardCore.ContactCenter.Deployments
@using Microsoft.AspNetCore.Mvc.Localization
@using OrchardCore.DisplayManagement.Views

@model ShapeViewModel<ContactCenterConfigurationDeploymentStep>

<h5>@T["Contact Center configuration"]</h5>

@if (Model.Value.IncludeAll)
{
    <span class="badge text-bg-success">@T["All Contact Center configuration"]</span>
}
else if (Model.Value.CatalogNames?.Length > 0)
{
    <span class="badge text-bg-warning">@T.Plural(Model.Value.CatalogNames.Length, "1 selected catalog.", "{0} selected catalogs.", Model.Value.CatalogNames.Length)</span>
}
else
{
    <span class="badge text-bg-warning">@T["No selected catalogs."]</span>
}
