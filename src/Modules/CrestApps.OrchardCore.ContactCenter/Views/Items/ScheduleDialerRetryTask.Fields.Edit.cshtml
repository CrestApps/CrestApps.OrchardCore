@using CrestApps.OrchardCore.ContactCenter.Workflows.ViewModels

@model ScheduleDialerRetryTaskViewModel

<div class="ocat-wrapper" asp-validation-class-for="ActivityItemId">
    <label class="ocat-label" asp-for="ActivityItemId">@T["Activity"]</label>
    <div class="ocat-end">
        <input class="form-control" asp-for="ActivityItemId" />
        <span asp-validation-for="ActivityItemId"></span>
        <span class="hint">@T["A Liquid expression resolving the completed dialer activity to try again. On an <code>ActivityDispositionApplied</code> event it is <code>{{ Workflow.Input.Data.ActivityItemId }}</code>."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="DelayMinutes">
    <label class="ocat-label" asp-for="DelayMinutes">@T["Delay in minutes"]</label>
    <div class="ocat-end">
        <input class="form-control" asp-for="DelayMinutes" />
        <span asp-validation-for="DelayMinutes"></span>
        <span class="hint">@T["A Liquid expression resolving how many minutes to wait before the dialer calls again. Leave it empty to use the dialer profile's retry delay; a shorter delay is raised to it. No attempt is created past the profile's attempt limit, and the task ends with the Exhausted outcome."]</span>
    </div>
</div>
