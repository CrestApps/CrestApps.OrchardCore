@model ListCatalogEntryViewModel<CatalogEntryViewModel<AgentStateReasonCode>>

@{
    var listModel = new CatalogListViewModel
    {
        BreadcrumbName = "ContactCenterAgentStateReasonCodes",
        Title = T["Agent states"],
        CreateLabel = T["Add reason code"],
        ListId = "agent-states-list",
        EmptyMessage = T["<strong>Nothing here!</strong> There are no agent state reason codes at the moment."],
        Options = Model.Options,
        ListName = "ContactCenterAgentStateReasonCodes",
        List = Model.List,
        Columns =
        {
            new CatalogListColumn { Name = "State", Title = T["Sets state"] },
        },
    };
}

<partial name="_CatalogList" model="listModel" />
