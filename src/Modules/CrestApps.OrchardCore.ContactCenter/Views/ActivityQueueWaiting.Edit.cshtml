@using CrestApps.OrchardCore.ContactCenter.Core.Models
@model QueueViewModel

<style asp-name="bootstrap-select"></style>
<script asp-name="bootstrap-select" depends-on="bootstrap" at="Foot"></script>

<div class="ocat-wrapper" asp-validation-class-for="Treatment.WelcomeMessage">
    <label asp-for="Treatment.WelcomeMessage" class="ocat-label">@T["Welcome message"]</label>
    <div class="ocat-end">
        <textarea asp-for="Treatment.WelcomeMessage" class="form-control" rows="2"></textarea>
        <span asp-validation-for="Treatment.WelcomeMessage" class="text-danger"></span>
        <span class="hint">@T["Spoken once when the caller enters the queue."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="Treatment.HoldMusicMediaId">
    <label asp-for="Treatment.HoldMusicMediaId" class="ocat-label">@T["Hold music"]</label>
    <div class="ocat-end">
        <select asp-for="Treatment.HoldMusicMediaId" asp-items="Model.HoldMusicMediaOptions" class="selectpicker show-tick" data-live-search="true" data-header="@T["Select a recording"]" data-width="100%" title="@T["The provider's default"]">
            <option value="">@T["The provider's default"]</option>
        </select>
        <span asp-validation-for="Treatment.HoldMusicMediaId" class="text-danger"></span>
        <span class="hint">@T["A voice media recording looped while the caller waits. Leave empty for the provider's default. Recordings are added under Voice media."]</span>
    </div>
</div>

<div class="ocat-limited-wrapper" asp-validation-class-for="Treatment.AnnouncementIntervalSeconds">
    <label asp-for="Treatment.AnnouncementIntervalSeconds" class="ocat-label">@T["Announcement interval (seconds)"]</label>
    <div class="ocat-limited">
        <input asp-for="Treatment.AnnouncementIntervalSeconds" class="form-control" />
        <span asp-validation-for="Treatment.AnnouncementIntervalSeconds" class="text-danger"></span>
        <span class="hint">@T["How often the position and estimated-wait announcements repeat. Set to 0 to announce nothing."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="Treatment.AnnouncePosition">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input asp-for="Treatment.AnnouncePosition" class="form-check-input" />
            <label asp-for="Treatment.AnnouncePosition" class="form-check-label">@T["Announce the caller's place in line"]</label>
        </div>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="Treatment.AnnounceEstimatedWait">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input asp-for="Treatment.AnnounceEstimatedWait" class="form-check-input" />
            <label asp-for="Treatment.AnnounceEstimatedWait" class="form-check-label">@T["Announce the estimated wait"]</label>
        </div>
        <span class="hint dashed">@T["The estimate is the caller's position times the average handle time, divided by the agents available, clamped to the bounds below."]</span>
    </div>
</div>

<div class="ocat-limited-wrapper" asp-validation-class-for="Treatment.AverageHandleTimeSeconds">
    <label asp-for="Treatment.AverageHandleTimeSeconds" class="ocat-label">@T["Average handle time (seconds)"]</label>
    <div class="ocat-limited">
        <input asp-for="Treatment.AverageHandleTimeSeconds" class="form-control" />
        <span asp-validation-for="Treatment.AverageHandleTimeSeconds" class="text-danger"></span>
        <span class="hint">@T["Used by the estimated-wait announcement. Set to 0 to use the platform default."]</span>
    </div>
</div>

<div class="ocat-limited-wrapper" asp-validation-class-for="Treatment.MinimumEstimateSeconds">
    <label asp-for="Treatment.MinimumEstimateSeconds" class="ocat-label">@T["Minimum announced estimate (seconds)"]</label>
    <div class="ocat-limited">
        <input asp-for="Treatment.MinimumEstimateSeconds" class="form-control" />
        <span asp-validation-for="Treatment.MinimumEstimateSeconds" class="text-danger"></span>
    </div>
</div>

<div class="ocat-limited-wrapper" asp-validation-class-for="Treatment.MaximumEstimateSeconds">
    <label asp-for="Treatment.MaximumEstimateSeconds" class="ocat-label">@T["Maximum announced estimate (seconds)"]</label>
    <div class="ocat-limited">
        <input asp-for="Treatment.MaximumEstimateSeconds" class="form-control" />
        <span asp-validation-for="Treatment.MaximumEstimateSeconds" class="text-danger"></span>
        <span class="hint">@T["An estimate is never announced above this, so a caller is not told to expect an hour."]</span>
    </div>
</div>
