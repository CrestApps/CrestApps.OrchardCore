@model ListCatalogEntryViewModel<CatalogEntryViewModel<DialerProfile>>

@{
    var listModel = new CatalogListViewModel
    {
        Title = T["Dialer profiles"],
        CreateLabel = T["Add Dialer Profile"],
        ListId = "dialer-profiles-list",
        EmptyMessage = T["<strong>Nothing here!</strong> There are no dialer profiles at the moment."],
        Options = Model.Options,
        Pager = Model.Pager,
        Entries = Model.Models
            .Select(entry => new CatalogListEntry
            {
                Shape = entry.Shape,
                FilterValue = entry.Model.Name?.ToLowerInvariant(),
            })
            .ToList(),
    };
}

<partial name="_CatalogList" model="listModel" />
