@model ListCatalogEntryViewModel<CatalogEntryViewModel<ActivityQueue>>

@{
    var listModel = new CatalogListViewModel
    {
        BreadcrumbName = "ContactCenterQueues",
        Title = T["Queues"],
        CreateLabel = T["Add Queue"],
        ListId = "queues-list",
        EmptyMessage = T["<strong>Nothing here!</strong> There are no queues at the moment."],
        Options = Model.Options,
        ListName = "ContactCenterQueues",
        List = Model.List,
        Columns =
        {
            new CatalogListColumn { Name = "Routing", Title = T["Routing"] },
        },
    };
}

<partial name="_CatalogList" model="listModel" />
