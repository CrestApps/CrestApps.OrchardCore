{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.Hosting.Lifetime": "Information",
      "YesSql": "Debug"
    }
  },
  "OrchardCore": {
    // Local workaround: the Azure Key Vault secret store validates that a SecretClient name is configured.
    // This fake name only lets the feature start; it does not point at a real vault.
    "Secrets": {
      "AzureKeyVault": {
        "AzureClient": "local-development-fake"
      }
    },
    "CrestApps": {
      // McpServer and A2AHost default to OpenId authentication.
      // Uncomment below to disable auth for local testing:
      // "McpServer": {
      //   "AuthenticationType": "None"
      // },
      // "A2AHost": {
      //   "AuthenticationType": "None"
      // }
    }
  }
}
