{
  "name": "crestapps.orchardcore",
  "private": true,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "workspaces": [
    "src/Modules/*",
    "src/Startup/*"
  ],
  "scripts": {
    "build": "node .scripts/assets/cli.mjs build",
    "rebuild": "node .scripts/assets/cli.mjs build --force",
    "watch": "node .scripts/assets/cli.mjs watch",
    "clean": "node .scripts/assets/cli.mjs clean",
    "dry-run": "node .scripts/assets/cli.mjs dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "cleanup": "node .scripts/cleanup.js",
    "lint": "eslint .",
    "check": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "glob": "^13.0.6",
    "globals": "^17.13.0",
    "jsdom": "30.1.3",
    "sass": "^1.106.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "3.5.13"
  },
  "overrides": {
    "brace-expansion": "^5.0.5",
    "lodash": "^4.17.24",
    "yaml": "^2.8.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "es5-ext@0.10.64": true
  }
}
