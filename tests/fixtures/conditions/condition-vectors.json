{
  "description": "Shared cases for the Conditions evaluator. The C# ConditionEvaluator (ConditionVectorTests) and the browser evaluator (tests/js/resources/conditions.test.js) both run every case, so they cannot drift apart. A source missing from 'sources' is unknown (the lookup returns nothing); a source with 'withheld': true is hidden. Every ConditionOperator must have at least one case.",
  "rules": [
    { "name": "Is matches ignoring case", "rule": { "Conditions": [ { "Source": "q", "Operator": "Is", "Values": [ "Yes" ] } ] }, "sources": { "q": { "values": [ "yes" ] } }, "expected": true },
    { "name": "Is fails on another value", "rule": { "Conditions": [ { "Source": "q", "Operator": "Is", "Values": [ "Yes" ] } ] }, "sources": { "q": { "values": [ "No" ] } }, "expected": false },
    { "name": "IsNot holds on an empty source", "rule": { "Conditions": [ { "Source": "q", "Operator": "IsNot", "Values": [ "Yes" ] } ] }, "sources": { "q": { "values": [] } }, "expected": true },
    { "name": "IsOneOf matches one of the values", "rule": { "Conditions": [ { "Source": "q", "Operator": "IsOneOf", "Values": [ "Laptop", "Printer" ] } ] }, "sources": { "q": { "values": [ "Printer" ] } }, "expected": true },
    { "name": "IsNoneOf holds when no value matches", "rule": { "Conditions": [ { "Source": "q", "Operator": "IsNoneOf", "Values": [ "Laptop", "Printer" ] } ] }, "sources": { "q": { "values": [ "Phone" ] } }, "expected": true },
    { "name": "IsEmpty treats blanks as empty", "rule": { "Conditions": [ { "Source": "q", "Operator": "IsEmpty" } ] }, "sources": { "q": { "values": [ " " ] } }, "expected": true },
    { "name": "IsNotEmpty holds on a value", "rule": { "Conditions": [ { "Source": "q", "Operator": "IsNotEmpty" } ] }, "sources": { "q": { "values": [ "x" ] } }, "expected": true },
    { "name": "Contains ignores case", "rule": { "Conditions": [ { "Source": "q", "Operator": "Contains", "Values": [ "SCREEN" ] } ] }, "sources": { "q": { "values": [ "The screen is black" ] } }, "expected": true },
    { "name": "GreaterThan compares numbers", "rule": { "Conditions": [ { "Source": "q", "Operator": "GreaterThan", "Values": [ "10" ] } ] }, "sources": { "q": { "values": [ "12.5" ] } }, "expected": true },
    { "name": "GreaterThan fails on text", "rule": { "Conditions": [ { "Source": "q", "Operator": "GreaterThan", "Values": [ "10" ] } ] }, "sources": { "q": { "values": [ "many" ] } }, "expected": false },
    { "name": "LessThan compares numbers", "rule": { "Conditions": [ { "Source": "q", "Operator": "LessThan", "Values": [ "10" ] } ] }, "sources": { "q": { "values": [ "9" ] } }, "expected": true },
    { "name": "LessThan compares ISO dates", "rule": { "Conditions": [ { "Source": "q", "Operator": "LessThan", "Values": [ "2026-03-01" ] } ] }, "sources": { "q": { "values": [ "2026-02-28" ] } }, "expected": true },
    { "name": "IsOrUnder matches an ancestor", "rule": { "Conditions": [ { "Source": "c", "Operator": "IsOrUnder", "Values": [ "hardware" ] } ] }, "sources": { "c": { "values": [ "laptop" ], "ancestors": [ "hardware" ] } }, "expected": true },
    { "name": "NotContains holds when no value contains the text", "rule": { "Conditions": [ { "Source": "q", "Operator": "NotContains", "Values": [ "refund" ] } ] }, "sources": { "q": { "values": [ "Thanks a lot" ] } }, "expected": true },
    { "name": "NotContains fails when a value contains the text", "rule": { "Conditions": [ { "Source": "q", "Operator": "NotContains", "Values": [ "REFUND" ] } ] }, "sources": { "q": { "values": [ "I want a refund" ] } }, "expected": false },
    { "name": "StartsWith ignores case", "rule": { "Conditions": [ { "Source": "q", "Operator": "StartsWith", "Values": [ "acme" ] } ] }, "sources": { "q": { "values": [ "ACME Corp" ] } }, "expected": true },
    { "name": "StartsWith fails otherwise", "rule": { "Conditions": [ { "Source": "q", "Operator": "StartsWith", "Values": [ "corp" ] } ] }, "sources": { "q": { "values": [ "ACME Corp" ] } }, "expected": false },
    { "name": "EndsWith ignores case", "rule": { "Conditions": [ { "Source": "q", "Operator": "EndsWith", "Values": [ "@EXAMPLE.COM" ] } ] }, "sources": { "q": { "values": [ "admin@example.com" ] } }, "expected": true },
    { "name": "EndsWith fails otherwise", "rule": { "Conditions": [ { "Source": "q", "Operator": "EndsWith", "Values": [ "example.org" ] } ] }, "sources": { "q": { "values": [ "admin@example.com" ] } }, "expected": false },
    { "name": "GreaterThanOrEqual holds on equal", "rule": { "Conditions": [ { "Source": "q", "Operator": "GreaterThanOrEqual", "Values": [ "9" ] } ] }, "sources": { "q": { "values": [ "9" ] } }, "expected": true },
    { "name": "GreaterThanOrEqual fails below", "rule": { "Conditions": [ { "Source": "q", "Operator": "GreaterThanOrEqual", "Values": [ "9" ] } ] }, "sources": { "q": { "values": [ "8.99" ] } }, "expected": false },
    { "name": "LessThanOrEqual holds on equal", "rule": { "Conditions": [ { "Source": "q", "Operator": "LessThanOrEqual", "Values": [ "6" ] } ] }, "sources": { "q": { "values": [ "6" ] } }, "expected": true },
    { "name": "LessThanOrEqual fails above", "rule": { "Conditions": [ { "Source": "q", "Operator": "LessThanOrEqual", "Values": [ "6" ] } ] }, "sources": { "q": { "values": [ "7" ] } }, "expected": false },
    { "name": "Between includes the low bound", "rule": { "Conditions": [ { "Source": "q", "Operator": "Between", "Values": [ "0", "6" ] } ] }, "sources": { "q": { "values": [ "0" ] } }, "expected": true },
    { "name": "Between includes the high bound", "rule": { "Conditions": [ { "Source": "q", "Operator": "Between", "Values": [ "0", "6" ] } ] }, "sources": { "q": { "values": [ "6" ] } }, "expected": true },
    { "name": "Between excludes values outside", "rule": { "Conditions": [ { "Source": "q", "Operator": "Between", "Values": [ "0", "6" ] } ] }, "sources": { "q": { "values": [ "7" ] } }, "expected": false },
    { "name": "Between accepts the bounds in either order", "rule": { "Conditions": [ { "Source": "q", "Operator": "Between", "Values": [ "6", "0" ] } ] }, "sources": { "q": { "values": [ "3" ] } }, "expected": true },
    { "name": "Between compares ISO dates", "rule": { "Conditions": [ { "Source": "q", "Operator": "Between", "Values": [ "2026-01-01", "2026-01-31" ] } ] }, "sources": { "q": { "values": [ "2026-01-15" ] } }, "expected": true },
    { "name": "Between compares ISO date-times as UTC", "rule": { "Conditions": [ { "Source": "q", "Operator": "Between", "Values": [ "2026-01-01T08:00:00Z", "2026-01-01T17:00:00Z" ] } ] }, "sources": { "q": { "values": [ "2026-01-01T09:30:00+01:00" ] } }, "expected": true },
    { "name": "Between needs two values", "rule": { "Conditions": [ { "Source": "q", "Operator": "Between", "Values": [ "0" ] } ] }, "sources": { "q": { "values": [ "0" ] } }, "expected": false },
    { "name": "Between fails on text", "rule": { "Conditions": [ { "Source": "q", "Operator": "Between", "Values": [ "0", "6" ] } ] }, "sources": { "q": { "values": [ "few" ] } }, "expected": false },
    { "name": "CountAtLeast counts the values that are not blank", "rule": { "Conditions": [ { "Source": "q", "Operator": "CountAtLeast", "Values": [ "2" ] } ] }, "sources": { "q": { "values": [ "a", "b", " " ] } }, "expected": true },
    { "name": "CountAtLeast fails below", "rule": { "Conditions": [ { "Source": "q", "Operator": "CountAtLeast", "Values": [ "3" ] } ] }, "sources": { "q": { "values": [ "a", "b", " " ] } }, "expected": false },
    { "name": "CountAtMost holds on an empty source", "rule": { "Conditions": [ { "Source": "q", "Operator": "CountAtMost", "Values": [ "1" ] } ] }, "sources": { "q": { "values": [] } }, "expected": true },
    { "name": "CountAtMost fails above", "rule": { "Conditions": [ { "Source": "q", "Operator": "CountAtMost", "Values": [ "1" ] } ] }, "sources": { "q": { "values": [ "a", "b" ] } }, "expected": false },
    { "name": "CountAtLeast needs a number", "rule": { "Conditions": [ { "Source": "q", "Operator": "CountAtLeast", "Values": [ "two" ] } ] }, "sources": { "q": { "values": [ "a", "b" ] } }, "expected": false },
    { "name": "A withheld source fails IsEmpty", "rule": { "Conditions": [ { "Source": "q", "Operator": "IsEmpty" } ] }, "sources": { "q": { "values": [], "withheld": true } }, "expected": false },
    { "name": "A withheld source fails CountAtMost", "rule": { "Conditions": [ { "Source": "q", "Operator": "CountAtMost", "Values": [ "5" ] } ] }, "sources": { "q": { "values": [], "withheld": true } }, "expected": false },
    { "name": "An unknown source is left out", "rule": { "Conditions": [ { "Source": "removed", "Operator": "Is", "Values": [ "x" ] }, { "Source": "q", "Operator": "Is", "Values": [ "Yes" ] } ] }, "sources": { "q": { "values": [ "Yes" ] } }, "expected": true },
    { "name": "A rule with nothing judged applies", "rule": { "Conditions": [ { "Source": "removed", "Operator": "Is", "Values": [ "x" ] } ] }, "sources": {}, "expected": true },
    { "name": "All with a nested Any group: both met", "rule": { "Match": "All", "Conditions": [ { "Source": "country", "Operator": "Is", "Values": [ "US" ] } ], "Groups": [ { "Match": "Any", "Conditions": [ { "Source": "score", "Operator": "LessThanOrEqual", "Values": [ "6" ] }, { "Source": "comment", "Operator": "Contains", "Values": [ "bad" ] } ] } ] }, "sources": { "country": { "values": [ "US" ] }, "score": { "values": [ "9" ] }, "comment": { "values": [ "bad service" ] } }, "expected": true },
    { "name": "All with a nested Any group: group not met", "rule": { "Match": "All", "Conditions": [ { "Source": "country", "Operator": "Is", "Values": [ "US" ] } ], "Groups": [ { "Match": "Any", "Conditions": [ { "Source": "score", "Operator": "LessThanOrEqual", "Values": [ "6" ] }, { "Source": "comment", "Operator": "Contains", "Values": [ "bad" ] } ] } ] }, "sources": { "country": { "values": [ "US" ] }, "score": { "values": [ "9" ] }, "comment": { "values": [ "great" ] } }, "expected": false },
    { "name": "Any with only a nested All group", "rule": { "Match": "Any", "Groups": [ { "Match": "All", "Conditions": [ { "Source": "a", "Operator": "Is", "Values": [ "1" ] }, { "Source": "b", "Operator": "Is", "Values": [ "2" ] } ] } ] }, "sources": { "a": { "values": [ "1" ] }, "b": { "values": [ "2" ] } }, "expected": true },
    { "name": "Any: the condition is enough when the group fails", "rule": { "Match": "Any", "Conditions": [ { "Source": "a", "Operator": "Is", "Values": [ "1" ] } ], "Groups": [ { "Conditions": [ { "Source": "b", "Operator": "Is", "Values": [ "2" ] } ] } ] }, "sources": { "a": { "values": [ "1" ] }, "b": { "values": [ "3" ] } }, "expected": true },
    { "name": "A group that cannot be judged is left out", "rule": { "Match": "All", "Conditions": [ { "Source": "a", "Operator": "Is", "Values": [ "1" ] } ], "Groups": [ { "Conditions": [ { "Source": "removed", "Operator": "Is", "Values": [ "x" ] } ] } ] }, "sources": { "a": { "values": [ "1" ] } }, "expected": true },
    { "name": "Groups nest more than one level", "rule": { "Match": "All", "Groups": [ { "Match": "Any", "Groups": [ { "Match": "All", "Conditions": [ { "Source": "a", "Operator": "Is", "Values": [ "1" ] }, { "Source": "b", "Operator": "IsNotEmpty" } ] } ], "Conditions": [ { "Source": "c", "Operator": "Is", "Values": [ "nope" ] } ] } ] }, "sources": { "a": { "values": [ "1" ] }, "b": { "values": [ "x" ] }, "c": { "values": [ "yes" ] } }, "expected": true },
    { "name": "A withheld source inside a group fails the group", "rule": { "Match": "All", "Groups": [ { "Conditions": [ { "Source": "h", "Operator": "IsEmpty" } ] } ] }, "sources": { "h": { "values": [], "withheld": true } }, "expected": false }
  ],
  "hidden": [
    { "name": "A chain closes when an early answer changes", "rules": { "b": { "Conditions": [ { "Source": "a", "Operator": "Is", "Values": [ "Yes" ] } ] }, "c": { "Conditions": [ { "Source": "b", "Operator": "IsNotEmpty" } ] } }, "sources": { "a": { "values": [ "No" ] }, "b": { "values": [ "kept" ] }, "c": { "values": [] } }, "hidden": [ "b", "c" ] },
    { "name": "A source read in a nested group hides through the chain", "rules": { "b": { "Conditions": [ { "Source": "a", "Operator": "Is", "Values": [ "Yes" ] } ] }, "c": { "Match": "All", "Groups": [ { "Match": "Any", "Conditions": [ { "Source": "b", "Operator": "IsEmpty" } ] } ] } }, "sources": { "a": { "values": [ "No" ] }, "b": { "values": [] } }, "hidden": [ "b", "c" ] },
    { "name": "Items in a cycle through a nested group show", "rules": { "x": { "Groups": [ { "Conditions": [ { "Source": "y", "Operator": "Is", "Values": [ "1" ] } ] } ] }, "y": { "Conditions": [ { "Source": "x", "Operator": "Is", "Values": [ "1" ] } ] } }, "sources": { "x": { "values": [] }, "y": { "values": [] } }, "hidden": [] }
  ]
}
